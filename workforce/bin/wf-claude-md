#!/usr/bin/env python3
"""wf-claude-md — classify every line of a project's CLAUDE.md by who owns it.

WHY THIS EXISTS. `platform.md` fact 6: CLAUDE.md is injected into every non-fork
subagent with **no per-agent opt-out**. It is the only context cost an org cannot
control, and it is multiplied by fan-out. Measured on a real org 2026-08-03:

    IDENTITY   29,891 B  (~7,473 tok)   89% of what arrives before any task
    routing       476 B
    reference   3,225 B

An employee received 89% CLAUDE.md and 11% its own handbook — in a project with no
source code. Until then this project only ever REPORTED that, in two places that
both said "never edit it — it is the user's file, and this is a proposal."

THE USER'S DIRECTIVE (SKILL.md § Directives, 2026-08-03) reversed that: CLAUDE.md is
built mechanically, kept "very sparce or next to nothing", and the skills and agents
drive the project. This script is the half that decides what may be removed.

THREE CLASSES, AND ONLY ONE IS REMOVABLE.

    DUPLICATED  the line appears VERBATIM in a handbook or an extracted directive.
                Removable. This is de-duplication, not deletion: directive one is
                that the user's wording is retained, and a line living verbatim in a
                handbook has been retained. Two canonical texts is the failure this
                project refuses everywhere else.
    DERIVABLE   directory listings, dependency names, restated build commands — the
                model could read them off the codebase. REPORTED, never removed:
                deciding that a line is derivable is a judgment, and judgments do not
                get to delete a user's file.
    USER        everything else. Never touched, never proposed, not counted against
                the budget as waste.

CONSERVATIVE BY CONSTRUCTION. A line qualifies as DUPLICATED only at >= MIN_LEN
significant characters and only if it is not a heading, a list bullet marker, or
inside an immutable block. Under-removing costs tokens; over-removing destroys the
user's words, and those are not symmetric.

NEVER TOUCHES AN IMMUTABLE BLOCK. `<!-- origin: user | immutable: true -->` spans are
excluded from every class including DUPLICATED — a sacred block is sacred wherever it
lives, and its presence in a handbook is the extraction working, not a licence.

Exit codes
    0  classified (and, with --execute, written)
    2  no CLAUDE.md, or the tree could not be read

Usage
    wf-claude-md [--root DIR] [--execute] [--json PATH]
    wf-claude-md --root DIR --ensure-region [--execute]   # region only; removes nothing
"""

import argparse
import os
import re
import sys

START = "<!-- WORKFORCE-CLAUDE-MD START — generated by /workforce; safe to replace -->"
END = "<!-- WORKFORCE-CLAUDE-MD END -->"

# THE REMEDY, GIVEN A PRODUCER. `enforcement.md` § The host can withdraw a capability
# names an explicit cold-reader request in the project's CLAUDE.md as the real fix for
# ambient policy that suppresses spawning — and for a whole day that remedy was named in
# three shipped files and WRITTEN BY NOTHING. Consumer named, producer assumed: the shape
# this project has now recorded five times.
#
# It must live in CLAUDE.md specifically. The blocking instruction constrains the MAIN
# SESSION, which is the caller; a handbook reaches only the callee, and by then the spawn
# that would have carried it is the thing that did not happen.
#
# It costs bytes on every spawn, and that is against this file's own thesis. Stated rather
# than hidden: ~260 B against a measured 15,459 B IDENTITY (1.7%) buys the tier canary and
# every cold-read probe. A run without it registers every handbook unprobed, which is the
# one gate whose whole job is catching what the author cannot see in their own work.
STANDING_REQUEST = "\n".join([
    "**Cold-reader agents are requested, standing.** `/workforce` audit, verify, and review",
    "spawn throwaway subagents to cold-read handbooks and to measure this host's tier ceiling.",
    "Ambient policy commonly permits spawning *unless the user asks* — this line is the asking.",
])
REGION_RX = re.compile(
    r"^<!--\s*WORKFORCE-CLAUDE-MD START.*?^<!--\s*WORKFORCE-CLAUDE-MD END\s*-->\s*$\n?",
    re.S | re.M)
# DELIBERATELY TOLERANT OF INDENTATION, and it is the only sacred-marker reader that
# is. This is a MASK, not a counter: it marks spans the duplication pass must not
# touch. Over-masking costs a duplicate that survives; under-masking deletes a line
# inside a user directive. The counting and guarding readers were narrowed to
# column 0 on 2026-08-05 because an inflated count and a guard firing on a template
# example are both defects — a mask has the opposite asymmetry and keeps the wider
# grammar. `bin/check` § marker grammar asserts this exception by name rather than
# letting it look like drift.
IMMUTABLE_RX = re.compile(
    r"^[ \t]*<!--\s*origin:\s*user\b[^>]*immutable:\s*true[^>]*-->.*?^[ \t]*<!--\s*/origin\s*-->",
    re.S | re.M)

# A line must carry this much signal before a verbatim match means anything. Short
# lines collide by accident: "## Scope", "- IN: things", "```bash".
MIN_LEN = 40
DERIVABLE_RX = re.compile(
    r"^\s*[-*]?\s*(`?[\w./-]+/`?\s*[—-]|\|\s*`?[\w@./-]+`?\s*\||"
    r"(npm|pnpm|yarn|bun|make|cargo|go|python3?|pytest|jest|vitest)\s+\w)", re.I)


def read(p):
    try:
        with open(p, encoding="utf-8") as fh:
            return fh.read()
    except (OSError, UnicodeDecodeError):
        return None


def owned_lines(root):
    """Every line the org already states, from handbooks and extracted directives."""
    out = set()
    for sub in (("claude", "agents"), ("claude", "workforce", "directives")):
        d = os.path.join(root, "." + sub[0], *sub[1:])
        if not os.path.isdir(d):
            continue
        for dp, _dn, fns in os.walk(d):
            for fn in fns:
                if not fn.endswith(".md"):
                    continue
                body = read(os.path.join(dp, fn))
                if body is None:
                    continue
                for line in body.splitlines():
                    s = line.strip()
                    if len(s) >= MIN_LEN:
                        out.add(s)
    return out


def classify(root):
    path = os.path.join(root, "CLAUDE.md")
    body = read(path)
    if body is None:
        return None

    # The generated region and every immutable block are out of scope entirely.
    scope = IMMUTABLE_RX.sub(lambda m: "\n" * m.group(0).count("\n"), REGION_RX.sub("", body))
    owned = owned_lines(root)

    dup, der, usr = [], [], []
    for i, line in enumerate(scope.splitlines(), start=1):
        s = line.strip()
        if not s:
            continue
        if s.startswith("#") or s.startswith("<!--"):
            usr.append((i, line))
            continue
        if len(s) >= MIN_LEN and s in owned:
            dup.append((i, line))
        elif DERIVABLE_RX.match(line):
            der.append((i, line))
        else:
            usr.append((i, line))
    return {"path": path, "body": body, "bytes": len(body),
            "duplicated": dup, "derivable": der, "user": usr}


def region(root):
    n_emp = n_dep = 0
    chart = os.path.join(root, ".claude", "workforce", "org-chart.md")
    agents = os.path.join(root, ".claude", "agents")
    if os.path.isdir(agents):
        n_emp = sum(1 for f in os.listdir(agents)
                    if f.endswith(".md") and not f.startswith("wf-")
                    and ORG_RECORD in (read(os.path.join(agents, f)) or ""))
    c = read(chart) or ""
    n_dep = len(set(re.findall(r"department:\s*([a-z-]+)", c)))

    # THE REGION DESCRIBES WHAT IS THERE, NEVER WHAT THE COMMAND IS FOR.
    #
    # MEASURED 2026-08-05 against claude-workforce itself: with zero employees this
    # emitted "**This project is staffed.**" over `employees —` and `departments —`,
    # and pointed at an org chart that does not exist, a `/workforce roster` that
    # returns nothing, and `/org <ask>` with no chart to dispatch from. An overclaim,
    # in the ONE file injected into every subagent with no opt-out.
    #
    # Zero employees is an ORDINARY state, not a degraded one (`SKILL.md` Core
    # Principle 7b): a fresh project, an `audit --review`, or a self-excluded repo like
    # this one. So the unstaffed branch names no artifact that does not exist yet —
    # Core Principle 5, absence is not a gap.
    common = [
        "The org is the documentation: an employee's handbook states its scope, its checks,",
        "and the directives that bind it. Do not restate them here — this file is injected",
        "into every subagent with no opt-out, so anything duplicated is paid on every spawn",
        "(`platform.md` fact 6).",
    ]
    if n_emp:
        body = ["**This project is staffed.**"] + common + [
            "",
            "| | |", "|---|---|",
            f"| employees | {n_emp} |",
            f"| departments | {n_dep or '—'} |",
            "| org chart | `.claude/workforce/org-chart.md` |",
            "| who does what | `/workforce roster` |",
            "| how work is dispatched | `/org <ask>` |",
        ]
    else:
        body = ["**This project has no employees yet.**"] + common + [
            "",
            "`/workforce audit` surveys the project and staffs it. Until then there is no org",
            "chart, `/workforce roster` has nothing to list, and `/org <ask>` has nothing to",
            "dispatch to — so work runs in the main session, which is the correct behaviour",
            "and not a fault to report.",
        ]
    return "\n".join([START, ""] + body + ["", STANDING_REQUEST, "", END, ""])


ORG_RECORD = "ORG-RECORD START"


def ensure_region(root, write):
    """Create-or-replace the generated region and NOTHING else.

    Separate from --execute on purpose. --execute runs at Step 6, after handbooks are
    in final position, and it removes DUPLICATED lines. The spawn preflight
    (audit-setup.md § Step 0.9) runs before any handbook exists, so a full --execute
    there would compare against an incomplete corpus. This mode cannot remove a user
    line at all: it substitutes the region, or appends it, and stops.

    Idempotent by construction — REGION_RX strips any prior region before the new one
    is placed, so running it twice writes the same bytes. `bin/idempotence` asserts it.
    """
    target = os.path.join(root, "CLAUDE.md")
    body = read(target)
    print(f"wf-claude-md --ensure-region — {target}")

    if body is None:
        if os.path.exists(target):
            print(f"  {target} exists but could not be read", file=sys.stderr)
            return 2
        out, state = region(root), "created — region only, no prose invented"
    else:
        stripped = REGION_RX.sub("", body)
        had = len(stripped) != len(body)
        out = region(root) + "\n" + stripped.lstrip("\n").rstrip() + "\n"
        state = "region replaced" if had else "region prepended"

    if out == (body or ""):
        print("  UNCHANGED — region already current")
        return 0
    if not write:
        print(f"  --execute would write: {state}")
        print("  no user line is classified or removed in this mode")
        return 0

    with open(target, "w", encoding="utf-8") as fh:
        fh.write(out)
    print(f"  {state} — {len(out):,} B")
    return 0


def main():
    ap = argparse.ArgumentParser(prog="wf-claude-md")
    ap.add_argument("--root", default=".")
    ap.add_argument("--execute", action="store_true")
    ap.add_argument("--ensure-region", action="store_true", dest="ensure_region",
                    help="write ONLY the generated region; classify nothing, remove nothing")
    ap.add_argument("--json", dest="json_path")
    args = ap.parse_args()

    # AN EMPTY --root IS A CALLER ERROR, NEVER A SILENT RETARGET TO CWD.
    # `${CLAUDE_PROJECT_DIR}` is UNSET in the Bash tool — measured 2026-08-04 on
    # 2.1.221 — so every shipped `--root "${CLAUDE_PROJECT_DIR}"` block expands to
    # `--root ""`. `os.path.abspath("")` is the CWD, which is a real directory, so a
    # is-it-a-directory guard passes and the tool examines a tree nobody named.
    # Measured: `wf-conform --root ""` in an empty dir exited 0 reporting
    # "0 governed · 0 failed" — a validator reporting health it never measured, which
    # is the exact contract procedures/verify.md states five lines under the block
    # that produces it.
    if not (args.root or "").strip():
        print("wf-claude-md: --root is empty. ${CLAUDE_PROJECT_DIR} is unset outside a "
              "hook; pass an explicit path.", file=sys.stderr)
        return 2

    root = os.path.abspath(args.root)

    if args.ensure_region:
        return ensure_region(root, write=args.execute)

    r = classify(root)
    if r is None:
        # ABSENT IS THE SPARSEST CASE, NOT AN ERROR. The directive is that CLAUDE.md is
        # "built mechanically for each project" and kept "very sparce or next to
        # nothing" — a project with none is already there, and refusing to act was the
        # script declining the one case the directive most clearly covers.
        #
        # Only CHARTER-FIRST writes a CLAUDE.md today (`audit.md` Step 1a); a GREENFIELD
        # project with source and no CLAUDE.md got nothing at all, so the generated
        # region never landed and the org had no front door.
        target = os.path.join(root, "CLAUDE.md")
        if os.path.exists(target):
            print(f"wf-claude-md: {target} exists but could not be read", file=sys.stderr)
            return 2
        print(f"wf-claude-md — {target}")
        print("  ABSENT — nothing is injected per spawn today, which is the floor this "
              "directive aims at")
        if not args.execute:
            print("  --execute would create it containing the generated region and nothing else")
            return 0
        with open(target, "w", encoding="utf-8") as fh:
            fh.write(region(root))
        print(f"  created {target} — {os.path.getsize(target):,} B, region only, no prose invented")
        return 0

    saved = sum(len(l) + 1 for _, l in r["duplicated"])
    prop = sum(len(l) + 1 for _, l in r["derivable"])
    print(f"wf-claude-md — {r['path']}")
    print(f"  {r['bytes']:,} B injected per spawn, no opt-out (platform.md fact 6)")
    print(f"  DUPLICATED {len(r['duplicated']):>4} line(s)  {saved:>7,} B  "
          f"— verbatim in a handbook or extracted directive; REMOVABLE")
    print(f"  DERIVABLE  {len(r['derivable']):>4} line(s)  {prop:>7,} B  "
          f"— reported only; a judgment never deletes a user's file")
    print(f"  USER       {len(r['user']):>4} line(s)            — never touched")

    if args.json_path:
        import json
        with open(args.json_path, "w", encoding="utf-8") as fh:
            json.dump({k: [[i, l] for i, l in v] if isinstance(v, list) else v
                       for k, v in r.items() if k != "body"}, fh, indent=2)

    if not args.execute:
        for i, l in r["duplicated"][:5]:
            print(f"    would remove  {i:>4}: {l.strip()[:88]}")
        print("  --execute writes the generated region and removes the DUPLICATED lines only")
        return 0

    dup_set = {l for _, l in r["duplicated"]}
    kept = [l for l in REGION_RX.sub("", r["body"]).splitlines() if l not in dup_set]
    out = region(root) + "\n" + "\n".join(kept).lstrip("\n").rstrip() + "\n"
    with open(r["path"], "w", encoding="utf-8") as fh:
        fh.write(out)
    print(f"  wrote {r['path']} — {len(out):,} B "
          f"({r['bytes'] - len(out):+,} B, {len(r['duplicated'])} duplicated line(s) removed)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
