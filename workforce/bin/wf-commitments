#!/usr/bin/env python3
"""wf-commitments — capture what a turn SAID it would do, and surface it until it is done.

WHY THIS EXISTS, and it is the defect one level above every other hook here.

MEASURED, this session. The user set a goal — "don't stop until what I asked for is
done completely" — and the next turn answered with a list: *wire the tag into wf-widen,
manifest, hook set, docs, assertions, fixtures, then run every suite.* Every item on
that list shipped. All four suites went green. The goal's condition held and it cleared
correctly. **And the work was still half done**, because the list omitted the acting
half of the mechanism being built, and nobody but the author could have known that.

THE DEFECT IS THE LIST, NOT THE GOAL. A goal takes its definition of "done" from a list
written inside the same head that is tunneling, so it inherits whatever that head left
out. Checking the list is not a check; it is the tunnel grading its own homework with
the answer key it wrote.

WHAT CAN ACTUALLY BE MECHANISED. Not "was the right list written" — nothing on this
machine knows that. What CAN be held is narrower and still worth having: **a list stated
out loud is a debt, and a debt must not evaporate silently.** Every intention this
operator announces gets recorded here at `Stop`, survives the session, and is read back
at `SessionStart`. It cannot make the list complete. It can stop an incomplete list from
being quietly forgotten, which is the failure that actually happened.

IT IS THE DIRECTIVE APPLIED TO THE OPERATOR. `SKILL.md` § Directives, 2026-08-10: "all
items in the deferment queue should be resolved one by one ... NO EXCEPTIONS! NO BLOCKS!
NO EXCUSES!" That was written about a run's queue of deferred findings. This is the same
rule pointed at the one queue nobody was keeping — the things the operator said it would
do next.

IT NEVER BLOCKS AND NEVER JUDGES. It records and it reports. Whether an item is really
done is a judgment, and a regex deciding that would close debts that are still open —
the worse of the two errors, since an open item wrongly closed is invisible and an open
item wrongly kept is one line a reader dismisses.

EXIT CODES: 0 always.
"""

import importlib.machinery
import importlib.util
import json
import os
import re
import sys


def _sibling(name):
    """A sibling hook, imported so its definitions are shared rather than restated:
    `wf-task-tag`'s session path and `wf-turn-ledger`'s confirmed reply, which every reply
    reader uses."""
    # Importing by path would drop a __pycache__ into the shipped directory.
    sys.dont_write_bytecode = True
    path = os.path.join(os.path.dirname(os.path.abspath(__file__)), name)
    modname = name.replace("-", "_")
    spec = importlib.util.spec_from_loader(
        modname, importlib.machinery.SourceFileLoader(modname, path))
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


TT = _sibling("wf-task-tag")
TL = _sibling("wf-turn-ledger")

# A STATED INTENTION, not a description of work already done. Present and past tense are
# excluded on purpose: "I wired the manifest" is a report and "I'll wire the manifest" is
# a debt, and only the second one can go unpaid.
INTENT = re.compile(
    r"(?:^|[.\n]\s*)(?:now[, ]+)?"
    r"(?:i'?ll|i will|i am going to|i'?m going to|next[,:]?\s+i)\s+"
    r"(?:now\s+|then\s+|just\s+|go ahead and\s+)?([^.\n]{6,160})", re.I)
# A LIST inside one sentence — "wire the tag, the manifest, the hook set, then the docs".
# The comma-series is where an incomplete list hides, because each item reads as done.
SERIES = re.compile(r"\b(?:then|and then|after that|followed by)\b\s+([^.\n]{4,80})", re.I)

MAX_OPEN = 40           # a ledger nobody can read is a ledger nobody reads

# THE LEDGER'S PATH AS GIT SPELLS IT — forward slashes at every depth, on every host,
# because that is what an index entry and a `.gitignore` rule both hold. The filesystem
# path is this split by `/` and rejoined by `os.path.join`, never the other way round.
LEDGER_REL = ".claude/workforce/commitments.json"
# `commitments.json` AND NOTHING ELSE. User, 2026-10-12: "some projects actually do ship
# their Claude directory with the repository ... as long as the index is in the Claude
# directory on the project we're good." So the rule may never widen to `.claude/` or to
# `.claude/workforce/`: everything else in there stays the project's to commit, and the
# one file this hook writes is the one file that holds the operator's own sentences.
IGNORE_RULE = "commitments.json"
IGNORE_NOTE = (
    "# Written by the workforce commitments hook. This ledger records what a turn in this\n"
    "# project SAID it would do next — the operator's own sentences, not the project's\n"
    "# source — and a checked-in copy conflicts with the next `git pull` the moment two\n"
    "# machines both record a turn. The rule covers this one file on purpose: everything\n"
    "# else in this directory is still yours to commit.\n")
# Where `_heal_regions` records the state it last refreshed against. See its docstring.
REGION_STAMP_REL = ".claude/workforce/.regions-refreshed"
# HOW MUCH OF `.git/index` IS READ to answer one question about one path. Entries are
# sorted by path bytes and `.claude/…` sorts ahead of almost everything a project carries,
# so the answer sits in the first handful of entries of any real repository; 1 MiB is some
# 15 000 of them. A read that stops before the answer says UNKNOWN, never "not tracked"
# (`_index_tracks`), so the cap can only cost a line nobody needed — never print a wrong one.
INDEX_READ_CAP = 1 << 20


def project_root(payload):
    """The project this hook fired for, as the harness names it, or None. See `path`."""
    root = os.environ.get("CLAUDE_PROJECT_DIR") or payload.get("cwd")
    return root if root and str(root).strip() else None


def _open_nofollow(path, flags, mode=0o600):
    """`os.open` with `O_NOFOLLOW` added, so a planted symlink at `path` is refused.

    EVERY FILE THIS HOOK TOUCHES LIVES IN SOMEBODY'S REPOSITORY, at a path anyone who has
    seen one workforce project can predict, and the hook opens them unattended on every
    turn. A link left at `commitments.json` or at `.claude/workforce/.gitignore` would
    otherwise aim this hook's write at whatever it points to, and its read at a file it
    was never given. The pattern is `wf-turn-budget`'s (3c7431c), shared with
    `wf-task-tag`, and is deliberately not a third design.

    IT IS THE OPEN THAT REFUSES, not a test before it. `os.path.islink(p)` followed by
    `open(p)` is two separate resolutions of the same name, and the link can be planted
    between them (CWE-59); the flag is checked by the kernel in the same call that opens.

    The flag is absent on some platforms; `getattr` keeps this importable there.
    """
    return os.open(path, flags | getattr(os, "O_NOFOLLOW", 0), mode)


def heal_settings(root):
    """Everything this project needs put right before its first request, in one carrier:
    the retired workforce hook ROWS, the retired pin guard's GIT hook, the machine-owned
    REGIONS a release moved on, and the one-time untracking of a committed ledger.
    Returns the line(s) to show the user, or "" when there was nothing to do.

    WHY IT RIDES THIS HOOK. `SessionStart` fires once per session in every project, and
    this registration is already live on every machine that has the default set, so the
    heal reaches a project the first time anybody opens it after the scripts land. No
    audit, no typed command, and no re-wiring: `bin/sync` and `update` replace the files,
    and a new hook would also need a settings write before it ran anywhere. User
    directive, 2026-09-07: "the next use of workforce will heal the situation".
    MEASURED 2026-09-14: six projects on one workstation still carried 38 rows pointing
    at scripts retired in 1.31.0, failing on every prompt and tool call, because the
    only remover cleaned the one file its scope resolves and never a project's.

    WHAT IT REMOVES is only a row whose script the distribution retired (`RETIRED_HOOKS`)
    and whose install is present and whole. A live row, a missing shipped script, and any
    row the shared resolver does not recognise stay (`heal`'s docstring lists the rest).

    THE GIT HALF IS THE SAME ARGUMENT ONE LAYER DOWN. `wf-pin-check --install-hook` wired
    its guard in `git config` and in a directory inside the repository, not in a settings
    row, so retiring the script in 1.31.0 removed nothing from the four projects measured
    on 2026-10-10 that already had it — each still ran a frozen 48 KB copy on every commit.
    `heal_git_hooks` unwires it, and this hook is the carrier for the same reason.

    THE CLASSIFIER IS NOT HERE. Both halves are in `wf-settings-apply` (`heal`,
    `heal_git_hooks`), shared with `--wire-defaults` and `--heal`, so what a session
    removes and what `verify` removes cannot drift apart. This function only decides
    whether to ask.

    NEAR ZERO WHEN THERE IS NOTHING TO DO. The gate reads the raw settings text for a
    RETIRED script name, taken from `wf-settings-apply`'s own RETIRED_HOOKS by reading
    its source rather than executing it; only a hit, or a standing notice to clear,
    imports the classifier, and then exactly once. A project whose live workforce rows
    name only shipped hooks pays a directory listing and one small read (review 3, L8:
    the import ran twice on every workforce project and session start went from 33-41 ms
    to 89-98 ms; measured after the fix against HEAD, 21 runs each: 37 ms with no workforce
    row, 38 ms with live rows only, 79 ms on the one session that heals). The git half's
    gate is the same shape: one read of `.git/config`, and `hooksPath` absent from its text
    ends it with nothing imported and no subprocess run. The two halves added 2026-10-12
    hold to the same rule and each states its own gate: `_heal_regions` compares one
    stamp against two directory listings, `_untracked_ledger` reads one git index.
    NEVER RAISES: nothing here may
    fail the SessionStart hook or cost it the ledger read-back that follows (review 3, L1).
    """
    progress = {"wrote": []}
    try:
        if not root:
            return ""
        said = [x for x in (_heal_settings(root, progress),
                            _heal_git_hooks(root, progress),
                            _heal_regions(root, progress),
                            _untracked_ledger(root)) if x]
        return "\n".join(said)
    except Exception as exc:                             # noqa: BLE001 — see docstring
        # SILENT ONLY WHEN NOTHING WAS WRITTEN. An error after a write leaves the project
        # in a state the user has to be able to see, so it is said, never swallowed.
        if progress["wrote"]:
            return (f"HEAL INTERRUPTED  after writing {', '.join(progress['wrote'])}: "
                    f"{exc.__class__.__name__}: {exc}. Run /workforce verify.")
        return ""


_WSA = []


def _wsa():
    """wf-settings-apply, imported at most once per process."""
    if not _WSA:
        _WSA.append(_sibling("wf-settings-apply"))
    return _WSA[0]


# `wf-` right after `/` or `\` — a backslash in the file's text is the JSON escape `\\`,
# whose second character is the one matched here.
_SEP_WF = re.compile(r"(?:/|\\)wf-")


def _retired_names():
    """RETIRED_HOOKS read from wf-settings-apply's SOURCE — the one definition, without
    paying to execute it. None when it cannot be read, and then the caller imports."""
    try:
        with open(os.path.join(os.path.dirname(os.path.abspath(__file__)),
                               "wf-settings-apply"), encoding="utf-8") as fh:
            m = re.search(r"RETIRED_HOOKS = frozenset\(\{(.*?)\}\)", fh.read(), re.S)
    except (OSError, UnicodeDecodeError):
        return None
    names = set(re.findall(r'"(wf-[a-z0-9-]+)"', m.group(1))) if m else set()
    return names or None


def _heal_settings(root, progress):
    texts = {}
    try:
        names = [n for n in os.listdir(os.path.join(root, ".claude"))
                 if n.startswith("settings") and n.endswith(".json")]
    except OSError:
        names = []
    for n in names:
        # NOT THROUGH A LINK, like every other path under this project's `.claude`. A
        # settings file IS legitimately a link in some installs, which is why this one was
        # the last plain `open` here — but what the gate does with the text is decide
        # whether to run the classifier over this project's settings, so a link planted at
        # the name hands that decision a file the project never wrote. Refusing reads it as
        # "no workforce row", which is the same answer an unreadable settings file already
        # gets one line below.
        try:
            with os.fdopen(_open_nofollow(os.path.join(root, ".claude", n), os.O_RDONLY),
                           encoding="utf-8", errors="replace") as fh:
                texts[os.path.join(".claude", n)] = fh.read()
        except OSError:
            continue
    notice = os.path.join(root, ".claude", "workforce", ".heal-notice")
    # TWO CHEAP GATES before anything is imported: no `wf-` after a path separator in any
    # settings file means no workforce row at all; then the retired names themselves.
    # EITHER SEPARATOR. `hook_command` joins with os.path.join, so a Windows row reads
    # `…\\skills\\workforce\\bin\\wf-x` in the file's JSON text (each backslash escaped),
    # and a gate on `/wf-` alone never opened there (final review, F1).
    if not os.path.lexists(notice) and not any(_SEP_WF.search(x) for x in texts.values()):
        return ""
    retired = _retired_names()
    named = (re.compile(r"(?:/|\\)(?:" + "|".join(map(re.escape, sorted(retired))) + r")\b")
             if retired else None)

    def names_retired(text):
        return retired is None or bool(named.search(text))
    if not any(names_retired(x) for x in texts.values()) and not os.path.lexists(notice):
        return ""
    import contextlib
    import io
    wsa = _wsa()
    with contextlib.redirect_stdout(io.StringIO()), contextlib.redirect_stderr(io.StringIO()):
        res = wsa.heal(root, True, quiet=True, progress=progress)
    lines = []
    n = len(res.get("removed") or [])
    if n and not res.get("refused"):
        names = sorted({r.get("script", "") for r in res["removed"]})
        lines.append(f"HEALED  removed {n} workforce hook registration(s) from this "
                     f"project's settings whose scripts this distribution retired: "
                     f"{', '.join(names)}. A restart stops this session running the old "
                     f"rows.")
    # A FAILURE IS SAID ONCE PER FILE STATE (the notice), and an unreadable file that
    # names a retired hook is a failure too: it is why that row can never be removed.
    fails = list(res.get("failures") or [])
    skipped = [u for u in (res.get("unparsed") or []) if names_retired(texts.get(u["settings"], ""))]
    # A REFUSAL THAT LEAVES RETIRED ROWS IS SAID TOO (final review, F2): a settings file
    # linked out of the project, or a project whose record cannot be written, was
    # refused in silence at every session start, and its rows stayed forever.
    refused = list(res.get("refusals") or [])
    if fails or skipped or refused:
        if wsa.announce_once(root, fails + skipped + refused):
            if refused:
                lines.append("HEAL REFUSED  " + " ".join(f["cause"] for f in refused) + ".")
            if fails:
                lines.append("HEAL FAILED  " + " ".join(f["cause"] for f in fails))
            if skipped:
                lines.append("HEAL SKIPPED  " + " ".join(u["cause"] for u in skipped)
                             + "; it names a retired workforce hook that stays until the "
                               "file is plain JSON.")
            lines.append("Said once for this state of the file; run /workforce verify.")
    else:
        wsa.clear_notice(root)
    return "\n".join(lines)


def _heal_git_hooks(root, progress):
    """The git half: unwire the retired pin guard from this repository.

    ONE READ IS THE WHOLE GATE for a repository that sets no hooksPath, which is nearly
    every one: `hooksPath` absent from `.git/config`'s text ends it with nothing imported
    and no subprocess run. The KEY is tested here and the VALUE is tested in
    `wf-settings-apply` — the literal that decides the heal has one definition
    (`PIN_HOOKS_DIR_REL`), and restating it here to save an import on the few repositories
    that do set a hooksPath is the kind of second copy that drifts.

    A `.git` THAT IS A FILE (a linked worktree, a submodule) has its config somewhere only
    git can name, so the gate falls through to the classifier, which resolves it.
    """
    dot = os.path.join(root, ".git")
    try:
        if os.path.isdir(dot):
            with open(os.path.join(dot, "config"), encoding="utf-8", errors="replace") as fh:
                if "hooksPath" not in fh.read():
                    return ""
        elif not os.path.isfile(dot):
            return ""
    except OSError:
        return ""
    res = _wsa().heal_git_hooks(root, True, quiet=True, progress=progress)
    lines = list(res.get("lines") or [])
    # A FAILURE IS SAID EVERY SESSION, not once: while it lasts, the guard is still wired
    # and still running on every commit in this repository, so there is something to do
    # about it each time. The settings half announces once because a retired ROW costs the
    # user a failed hook invocation and nothing else.
    for f in res.get("failures") or []:
        lines.append(f"GIT HOOK NOT HEALED  {f}. Run /workforce verify.")
    return "\n".join(lines)


_WSC = []


def _wsc():
    """wf-companion, imported at most once per process — and only behind the stamp gate."""
    if not _WSC:
        _WSC.append(_sibling("wf-companion"))
    return _WSC[0]


def _stat_rows(d, names=None):
    """`(name, size, mtime_ns)` for each file in `d`, sorted; None when `d` cannot be
    listed. `names` restricts it to one file name per subdirectory instead.

    No file is READ here. The question is only whether either side of the refresh has
    moved since the last one, and a listing answers that for the price of the directory
    entries.
    """
    rows = []
    try:
        with os.scandir(d) as it:
            for e in sorted(it, key=lambda x: x.name):
                if names is None:
                    if e.is_file(follow_symlinks=False):
                        st = e.stat(follow_symlinks=False)
                        rows.append((e.name, st.st_size, st.st_mtime_ns))
                    continue
                for n in names:
                    try:
                        st = os.stat(os.path.join(d, e.name, n))
                    except OSError:
                        continue
                    rows.append((f"{e.name}/{n}", st.st_size, st.st_mtime_ns))
    except OSError:
        return None
    return rows


def _region_digest(root, wf):
    """The state `_heal_regions` last refreshed against, as one short line, or None when
    either side cannot be listed and no claim can be made.

    BOTH SIDES ARE IN IT. The SHIPPED side is every file in `references/` and
    `references/procedures/`, which is a superset of the three that carry a canonical span
    — naming only those three would restate `wf-companion`'s own CORE list here, and a
    second copy of that list is what drifts. The cost of the superset is that an unrelated
    reference file moving opens the gate once, and the refresh it opens reports CURRENT
    and writes the stamp again. The INSTALLED side is each `.claude/skills/*/SKILL.md`, so
    a hand-edit to a companion's region is seen too, not only a release.
    """
    import hashlib
    parts = []
    for d in (os.path.join(wf, "references"),
              os.path.join(wf, "references", "procedures")):
        rows = _stat_rows(d)
        if rows is None:
            return None
        parts.append(repr(rows))
    rows = _stat_rows(os.path.join(root, ".claude", "skills"), names=("SKILL.md",))
    if rows is None:
        return None
    parts.append(repr(rows))
    return hashlib.sha256("\n".join(parts).encode("utf-8")).hexdigest()


def _heal_regions(root, progress):
    """Refresh this project's machine-owned REGIONS to shipped source, at session start.

    THE DEFECT. A project's `/org` dispatch rungs are a byte-canonical region copied into
    its own SKILL.md (`procedures/org.md` § step 5), and the only producer that refreshes
    one is `wf-companion --execute`, which only `audit` Step 4 runs. New hooks reach a
    project on `update` through `--wire-defaults`; a changed rung reached nobody until
    somebody audited. So a release could ship a dispatch rule and every existing org kept
    dispatching on the old ladder, silently. The user, 2026-10-12: "I don't have to run an
    audit after this update, correct?" — and until this, the honest answer was that they
    did.

    THE DECISION IS `wf-companion`'s, NOT A SECOND ONE. `refresh_drifted` is the refresh
    half of `--execute` with the same `evaluate`, the same write and the same read-back, so
    only a DRIFTED region is replaced, only between its markers, and a customized Core
    skill is never overwritten (`audit-setup.md` Step 0.3 state 3). What this function
    decides is whether to ask at all.

    NEAR ZERO WHEN THERE IS NOTHING TO DO, which is the gate's whole design: two directory
    listings and one small read, with nothing imported. `.claude/workforce/.regions-refreshed`
    holds the digest of what either side could change (`_region_digest`); equal means
    nothing has moved since the last refresh and it ends there. The settings half's own
    measurement is the standard it is held to — 37 ms with nothing to do against 79 ms on
    the one session that heals (`heal_settings`, review 3, L8).

    A PROJECT WITH NO COMPANIONS IS NOT ONE TO BUILD THEM IN. No `.claude/skills` means no
    region to refresh and no stamp written: materializing an absent companion is `audit`
    Step 4's job, with a report somebody is reading, and `refresh_drifted` leaves ABSENT
    alone for the same reason.
    """
    wf = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    if not os.path.isdir(os.path.join(root, ".claude", "skills")):
        return ""
    want = _region_digest(root, wf)
    stamp = os.path.join(root, *REGION_STAMP_REL.split("/"))
    if want is not None:
        # NOT THROUGH A LINK. The stamp sits beside the ledger in a shared checkout, and a
        # link planted at its name hands this gate a file somebody else chose — which
        # decides whether the refresh below runs at all.
        try:
            with os.fdopen(_open_nofollow(stamp, os.O_RDONLY), encoding="utf-8") as fh:
                if fh.read().strip() == want:
                    return ""
        except OSError:
            pass
    refreshed, failures = _wsc().refresh_drifted(root, wf)
    progress["wrote"] += [f".claude/skills/{n}/SKILL.md" for n, _d in refreshed]
    lines = []
    if refreshed:
        lines.append("REFRESHED  this project's machine-owned region(s) now match the "
                     "installed release: "
                     + "; ".join(f"{n} ({d})" for n, d in refreshed) + ". Only the span "
                     "between the markers was replaced; everything around it is "
                     "byte-for-byte as it was. A restart loads the new text.")
    for f in failures:
        lines.append(f"REGION NOT REFRESHED  {f}. Run /workforce audit.")
    # THE STAMP IS WRITTEN ONLY WHEN THE ANSWER WOULD BE THE SAME NEXT TIME. A failure
    # leaves it alone, so the next session start tries again instead of recording a
    # refresh that did not happen. It is NOT written when the digest could not be taken,
    # for the same reason.
    # IT GOES THROUGH THE PRODUCER'S OWN WRITER, which is already imported on this path:
    # `write` refuses a target that resolves outside the project and renames over a
    # link's target rather than over the link (SKILL.md Atomic-or-Absent rule 3). A plain
    # `open(stamp, "w")` would follow a symlink somebody left in `.claude/workforce/` and
    # put these bytes wherever it pointed, in a hook that runs unattended at session start.
    if want is not None and not failures:
        try:
            os.makedirs(os.path.dirname(stamp), exist_ok=True)
            _wsc().write(root, stamp, want + "\n")
        except (OSError, ValueError):
            pass
    return "\n".join(lines)


def _git_varint(buf, pos):
    """git's offset-encoded varint at `pos` — `(value, next_pos)`, or `(None, pos)` when
    the buffer ends inside it.

    NOT LEB128, and the difference is one addition. git's own `decode_varint` adds one to
    the accumulator before each shift, so every value has exactly one spelling; reading it
    as LEB128 gives a number that is too small by a growing amount, which in a version-4
    index means a path built from the wrong prefix. Index version 4 is the only reader of
    this encoding here.

    TEN BYTES AND NO MORE, WHICH IS A RESOURCE GUARD RATHER THAN A FORMAT DETAIL. These
    bytes come out of somebody's repository and this runs at session start. Unbounded, the
    accumulator grows seven bits per continuation byte while each shift costs the whole
    integer — quadratic. MEASURED 2026-10-12 on the unbounded version: 65 536 continuation
    bytes took 1.70 s and 262 144 took 28.1 s, so one crafted `.git/index` inside the read
    cap could have held a session open for minutes in every project. Ten bytes carries
    every value a 64-bit git can write (`ceil(64/7)`); an eleventh is not a number this
    reader will produce, it is UNKNOWN, which prints nothing.
    """
    val, first = 0, True
    for _ in range(10):
        if pos >= len(buf):
            return None, pos
        c = buf[pos]
        pos += 1
        val = (c & 0x7F) if first else (((val + 1) << 7) | (c & 0x7F))
        first = False
        if not c & 0x80:
            return val, pos
    return None, pos


def _index_scan(idx, version, hashlen, target):
    """True when `target` is an entry in these index bytes, False when it provably is not,
    None when they do not parse as a version-`version` index of `hashlen`-byte ids.

    THE FORMAT, as `Documentation/gitformat-index.txt` states it. Each entry is 40 bytes
    of stat data, the object id, then 2 bytes of flags whose low 12 bits hold the path
    length (`0xFFF` meaning "longer than that, find the NUL") and whose `0x4000` bit adds
    two more flag bytes in version 3 and up. In versions 2 and 3 the path is NUL-padded so
    the entry length is a multiple of eight; in version 4 there is no padding and the path
    is prefix-compressed — a varint saying how many bytes to strip from the PREVIOUS path,
    then the suffix — which is why this walks every entry in order instead of seeking.

    IT VALIDATES AS IT GOES, and that is what makes the hash length safe to infer: a
    declared path length that disagrees with the NUL, a pad byte that is not a NUL, or a
    read past the end all return None. Parsing a 32-byte-id index as if the ids were 20
    bytes reads the flags out of the middle of an object id, so it fails one of those
    within the first entry rather than answering confidently about the wrong bytes.

    THE FIRST NAME PAST THE TARGET SETTLES IT. Entries are sorted by path bytes, which is
    Python's own order for `bytes`, so a project with 300 000 files costs the same handful
    of entries as a project with ten — `.claude/…` sorts ahead of almost every name a
    repository carries. If an index somehow were not sorted the early exit would answer
    "not tracked", which is a line not printed rather than a wrong line printed.
    """
    n = len(idx)
    pos, prev = 12, b""
    for _ in range(int.from_bytes(idx[8:12], "big")):
        base = pos + 40 + hashlen + 2
        if base > n:
            return None
        flags = int.from_bytes(idx[base - 2:base], "big")
        if flags & 0x4000:
            if version < 3:
                return None
            base += 2
        if version >= 4:
            strip, base = _git_varint(idx, base)
            if strip is None or strip > len(prev):
                return None
        end = idx.find(b"\0", base)
        if end < 0:
            return None
        name = idx[base:end] if version < 4 else prev[:len(prev) - strip] + idx[base:end]
        namelen = flags & 0xFFF
        if namelen != 0xFFF and len(name) != namelen:
            return None
        if version < 4:
            nxt = pos + (((base - pos) + len(name) + 8) & ~7)
            if nxt <= end or nxt > n or any(idx[end:nxt]):
                return None
        else:
            nxt = end + 1
        if name == target:
            return True
        if name > target:
            return False
        prev, pos = name, nxt
    return False


def _index_tracks(idx, target):
    """Is `target` an entry in `.git/index`? True, False, or None for "these bytes do not
    say" — and None is answered by printing nothing, never by guessing either way.

    THE HASH LENGTH IS NOT IN THE HEADER. A repository created with
    `--object-format=sha256` writes the same version number with 32-byte ids, so the only
    honest way to read the entries is to try a length and require the result to validate
    (`_index_scan`). A version this cannot read — 1, or a 5 that does not exist yet — is
    UNKNOWN rather than parsed as the nearest one it knows.
    """
    if len(idx) < 12 or idx[:4] != b"DIRC":
        return None
    version = int.from_bytes(idx[4:8], "big")
    if version not in (2, 3, 4):
        return None
    for hashlen in (20, 32):
        answer = _index_scan(idx, version, hashlen, target)
        if answer is not None:
            return answer
    return None


def _untracked_ledger(root):
    """The one-time `git rm --cached` line for a project whose ledger git already tracks,
    or "".

    MEASURED 2026-10-12: `.claude/workforce/commitments.json` is tracked in nsayka-wawa
    and in odyssey-alive (`git ls-files`), and on 2026-10-10 a local edit to the copy on
    nsayka-wawa's live server would have made `git pull --ff-only` conflict. The ignore
    rule `ensure_ignored` writes stops a project tracking it from now on and does nothing
    for one that already does: git keeps tracking a file it already knows, whatever
    `.gitignore` says.

    IT SAYS THE COMMAND AND STOPS. Untracking belongs in a commit the project's author
    makes, with their message, in their own staging area — so this hook never runs
    `git rm`, never stages and never commits. It also clears itself: once the command has
    been run, `git ls-files` stops answering and the line stops appearing.

    IT RUNS NO COMMAND, AND THAT IS A SECURITY PROPERTY, NOT A SAVING. Asking
    `git ls-files` meant running git inside a directory whose own `.git/config` git then
    reads, and several config keys name an executable git will run for it. MEASURED here
    on 2026-10-12, git 2.55.0: with `core.fsmonitor` set to a command in a repository's
    LOCAL config, `git ls-files --error-unmatch -- <path>` executed that command. This
    hook fires at the start of every session in every project on the machine with nobody
    watching, so opening a repository somebody else prepared would have run their command.
    Reading `.git/index` and deciding the question here takes that whole class away: the
    only thing opened is one file, and nothing in it is executed, interpreted or echoed.

    ONE READ IS THE WHOLE ANSWER, and it is the same shape `_heal_git_hooks` uses on
    `.git/config`. `_index_tracks` parses the entries (versions 2, 3 and 4) and says True,
    False or "these bytes do not say" — and the last of those prints nothing, because a
    line put up on a question nobody could answer is one every reader learns to skip. That
    rule is `wf-settings-apply._tracked`'s, whose own docstring states it: "Every caller
    now decides what an unanswerable question means for it."

    A `.git` THAT IS A FILE IS SKIPPED — a linked worktree, a submodule — and so is a
    project with no `.git` of its own. Both keep their index somewhere only git can name,
    and following a path out of a file inside the repository, to read it, is the thing this
    function just stopped doing. The cost is one nag line unsaid in a worktree whose main
    checkout says it anyway; the alternative is the class back again.
    """
    if not os.path.lexists(os.path.join(root, *LEDGER_REL.split("/"))):
        return ""
    if not os.path.isdir(os.path.join(root, ".git")):
        return ""
    try:
        with os.fdopen(_open_nofollow(os.path.join(root, ".git", "index"),
                                      os.O_RDONLY), "rb") as fh:
            idx = fh.read(INDEX_READ_CAP)
    except OSError:
        return ""
    if _index_tracks(idx, LEDGER_REL.encode("utf-8")) is not True:
        return ""
    return (f"LEDGER TRACKED  git is tracking {LEDGER_REL}, which records what turns in "
            f"this project said they would do. It is written on every turn that states "
            f"one, so a tracked copy conflicts with the next `git pull` as soon as two "
            f"machines both record a turn. One command, once, in a commit of your own: "
            f"`git rm --cached {LEDGER_REL}`. The ignore rule beside it is already "
            f"written; this hook stages nothing and commits nothing.")


def ensure_ignored(ledger):
    """Make `.claude/workforce/.gitignore` cover `commitments.json`, that file alone.

    IT RIDES THE WRITE, and that is the point: the ledger is created by a hook that runs
    long before anybody types a workforce command, so an audit-authored rule would arrive
    after the file was already committed — which is exactly what happened in the two
    projects `_untracked_ledger` names.

    APPEND, NEVER REWRITE. A project's own rules in that file are kept byte-for-byte, the
    rule is added once, and a file that already covers the ledger — `commitments.json`,
    `/commitments.json`, or a `*` with no negation under it — is left exactly as it is.

    NOTHING IS STAGED. Writing a file is this hook's business; `git add` in somebody
    else's repository is not (K7).

    SILENT ON FAILURE. A read-only `.claude/workforce/` is a project that has told us
    something, and the ledger write above it has already dealt with the same OSError.

    NEVER THROUGH A SYMLINK, AND THE KERNEL IS WHAT REFUSES IT (CWE-59). An append
    follows a link, so one left in `.claude/workforce/` would put this note and this rule
    wherever it pointed — a file outside the project, appended to by a hook that runs on
    every turn with nobody watching. `os.path.islink(p)` and then `open(p, "a")` resolve
    that name TWICE and a link planted between the two calls is followed, so both the read
    and the append go through `_open_nofollow` instead and fail in the open itself. The
    DIRECTORY is refused the same way, by name: `.claude/workforce` being a link means
    every path under it belongs to a tree this project did not name, and the ledger's own
    writer refuses the same shape (`wf-ledger.atomic_write`, containment).
    """
    if os.path.islink(os.path.dirname(ledger)):
        return
    p = os.path.join(os.path.dirname(ledger), ".gitignore")
    try:
        with os.fdopen(_open_nofollow(p, os.O_RDONLY),
                       encoding="utf-8", errors="replace") as fh:
            body = fh.read()
    except OSError:
        body = None
    lines = [ln.strip() for ln in (body or "").splitlines()]
    if any(ln.lstrip("/") == IGNORE_RULE for ln in lines) or (
            "*" in lines and not any(ln.startswith("!") for ln in lines)):
        return
    try:
        with os.fdopen(_open_nofollow(p, os.O_WRONLY | os.O_APPEND | os.O_CREAT),
                       "a", encoding="utf-8") as fh:
            fh.write(("" if not body or body.endswith("\n") else "\n")
                     + ("\n" if body else "") + IGNORE_NOTE + IGNORE_RULE + "\n")
    except OSError:
        return


def path(payload):
    """Per-PROJECT, not per-session. A debt stated on Monday is still owed on Tuesday,
    and a session-scoped file would clear the ledger exactly when a new session made it
    matter most — which is the moment this exists for.

    `${CLAUDE_PROJECT_DIR}` FIRST, the payload's `cwd` second (`wf-protect-directives`
    resolves a hook root the same way). The two differ the moment a turn has cd'd
    somewhere — a subdirectory, a sibling clone, a scratch tree — and only the first
    names the project whose debt this is.

    NO `os.getcwd()` FALLBACK, AND THAT IS THE WHOLE FIX. Both sources above are
    supplied BY THE HARNESS and name the project this hook was fired for. `os.getcwd()`
    names wherever the process happens to be, so falling back to it turned every
    invocation from an unrelated directory — a hand-run, a test, a `cd` — into a stray
    `<cwd>/.claude/workforce/commitments.json`, a confident write to a path nobody named
    (`wf-companion` § materializing creates the directory). An unresolved root is not a
    root to guess at: `None` is the honest answer, and `main` already treats it as
    "record nothing". A root the harness DID name still gets its tree created, because
    that is this hook's job on a project whose ledger does not exist yet.
    """
    root = project_root(payload)
    if not root:
        return None
    d = os.path.join(root, ".claude", "workforce")
    try:
        os.makedirs(d, exist_ok=True)
        return os.path.join(d, "commitments.json")
    except OSError:
        return None


def load(p):
    """The ledger, or an empty one — THROUGH THE SIBLING'S OWN GUARDED READER.

    This file's contents are read back to the operator at session start, so a link planted
    at its name is a file somebody else chose being quoted into the next session's context.
    `wf-task-tag.read_json_nofollow` already refuses that, and since 2026-10-12 refuses a
    file that is not a regular file this account owns as well — a local copy of those three
    rules is a copy that learns the fourth one late. `TT` is already imported at module
    scope for `state_component`, so this costs no import, and the shape is the same one it
    reads for the issue ledger: a dict or the default.
    """
    return TT.read_json_nofollow(p, {"open": []})


def capture(reply):
    """Every intention the reply states, deduplicated, most recent last."""
    out = []
    for m in INTENT.finditer(reply or ""):
        txt = " ".join(m.group(1).split())[:140]
        if txt and txt not in out:
            out.append(txt)
    for m in SERIES.finditer(reply or ""):
        txt = " ".join(m.group(1).split())[:140]
        # NOT A SECOND DEBT WHEN IT IS THE TAIL OF ONE ALREADY RECORDED. "…docs,
        # assertions, then run every suite" is one commitment; listing its last clause
        # again pads the ledger, and a ledger padded with duplicates is one a reader
        # starts skimming — which costs exactly the attention this exists to buy.
        if txt and txt not in out and not any(txt in prior for prior in out):
            out.append(txt)
    return out


# ── The reply half of `asks: N` ────────────────────────────────────────────────
#
# `wf-task-tag` counts how many things a message asked for; that is the PROMPT half and
# on its own it is a flag. This is the fix: a reply to a multi-ask prompt is expected to
# carry a section per ask, and this says so when it does not.
#
# IT LIVES HERE AND NOT IN `wf-widen`, deliberately. `wf-widen-agent` BLOCKS, and on
# 2026-09-11 it blocked three turns in a row on one stale conclusion. A reply-shape
# observation is worth a sentence, never a held session — and this hook has never
# blocked anything.
#
# WHY IT SHOULD NOT REPEAT THE SPEECH-GUARD FAILURE (7.0% of GOOD replies, which retired
# `wf-speak-guard` two days ago). That guard judged PROSE QUALITY on EVERY reply. This
# counts STRUCTURE, and only on turns where the user explicitly enumerated — so the
# population is small and the property is countable rather than aesthetic. A reply with
# no enumeration in its prompt is never looked at.
SECTION_FAMILIES = (
    re.compile(r"^#{1,6}\s+\S", re.M),        # markdown headings
    re.compile(r"^\*\*[^*\n]{2,60}\*\*", re.M),  # a bolded label opening a line
    re.compile(r"^\s{0,3}\d+[.)]\s+\S", re.M),    # a numbered section
)


def section_count(reply):
    """The best-supported section count in a reply — the MAX family, never the sum.

    Summing would double-count a reply that numbers its sections AND bolds their labels,
    which is the ordinary way to write one, and an inflated count makes this check pass
    on exactly the replies it exists to catch.
    """
    return max((len(rx.findall(reply)) for rx in SECTION_FAMILIES), default=0)


def asks_expected(payload):
    """`asks` from this turn's task tag, or None when there is no tag to read.

    None is not 1. A turn with no tag was never classified — an injected preamble, or a
    `Stop` in a session that started mid-flight — and asserting a shape against a count
    nobody took is the vacuous-pass shape this project refuses everywhere.
    """
    # THE KEY IS THE SIBLING'S, the file name is this hook's own. `state_component` keys by
    # session AND agent since 2026-10-12 (fact 22b c); this hook runs on the main `Stop`,
    # where that resolves to the session alone, which is exactly how a drift in the key would
    # go unnoticed here.
    #
    # AND THE READ IS THE SIBLING'S GUARDED ONE, never a plain `open()`. The last fallback
    # above is `/tmp` and this name is predictable, so a link planted at it would hand this
    # hook a file it was never given and print its contents to the user as the turn's ask
    # count (CWE-59). `wf-task-tag.tag_path` carries the rule; this is one of its readers.
    d = payload.get("scratchpad_dir") or os.environ.get("TMPDIR") or "/tmp"
    sid = TT.state_component(payload)
    tag = TT.read_json_nofollow(os.path.join(d, f"wf-task-tag.{sid}.json"))
    if not isinstance(tag, dict):
        return None, ""
    n = tag.get("asks")
    return (n if isinstance(n, int) else None), (tag.get("asks_why") or "")


def main():
    raw = sys.stdin.read()
    try:
        payload = json.loads(raw) if raw.strip() else {}
    except json.JSONDecodeError:
        return 0

    p = path(payload)
    if not p:
        return 0
    book = load(p)
    event = payload.get("hook_event_name") or ""

    # ── SessionStart: heal the project's hook wiring, then read the debt back ──
    if event == "SessionStart" or payload.get("source") in ("startup", "resume", "clear", "fork"):
        out = {}
        healed = heal_settings(project_root(payload))
        if healed:
            out["systemMessage"] = healed
        items = book.get("open") or []
        if items:
            lines = [f"{len(items)} thing(s) a previous turn in this project said it would "
                     f"do, and no turn has since recorded doing:"]
            for it in items[-MAX_OPEN:]:
                lines.append(f"  · {it.get('text', '')}"
                             + (f"   ({it['at']})" if it.get("at") else ""))
            lines.append("These are statements the operator made, not user instructions, "
                         "and some may already be done or overtaken. They are listed "
                         "because a stated intention that disappears silently is how work "
                         "gets left half finished.")
            out["hookSpecificOutput"] = {"hookEventName": "SessionStart",
                                         "additionalContext": "\n".join(lines)}
        if out:
            print(json.dumps(out))
        return 0

    # ── Stop: record what this turn said it would do ──
    # ONLY A REPLY THE TRANSCRIPT HOLDS (`wf-turn-ledger`, `confirmed_reply`). A side query's
    # text recorded here is a debt nobody stated, read back at every session start. No field
    # is no record, as before: the transcript fallback is for the scans, not for this ledger.
    reply, how = TL.confirmed_reply(payload)
    if how == "absent" or not isinstance(reply, str) or not reply.strip():
        return 0
    # THE ASKS LINE IS COMPUTED BEFORE THE COMMITMENTS EARLY-RETURN, and that ordering is
    # the whole difference between a check and a dead branch. Placed after it, this fired
    # only on turns that ALSO stated a commitment — and a turn that blends three answers
    # into one reply is under no obligation to promise anything, so the population it was
    # written for was exactly the population it could not see. MEASURED by running it:
    # a 3-ask prompt against a 1-section reply printed nothing at all.
    asks_line = ""
    n, why = asks_expected(payload)
    if isinstance(n, int) and n >= 2:
        got = section_count(reply)
        if got < n:
            asks_line = (f"ASKS  the prompt made {n} request(s) ({why}) and this reply "
                         f"carries {got} section(s). One heading per thing asked, in the "
                         f"order raised — each answered, or named as not answered "
                         f"(operating principles, item 14).")

    fresh = capture(reply)
    if not fresh:
        if asks_line:
            print(json.dumps({"systemMessage": asks_line}))
        return 0
    seen = {i.get("text") for i in (book.get("open") or [])}
    stamp = payload.get("timestamp") or ""
    for t in fresh:
        if t not in seen:
            book.setdefault("open", []).append({"text": t, "at": stamp[:10]})
    book["open"] = (book.get("open") or [])[-MAX_OPEN:]
    # THE SIBLING'S OWN ATOMIC WRITER, for the write that matters most: the operator's own
    # sentences, at a predictable path in a shared checkout, written unattended on every
    # turn that states one. It creates its temporary name random and `O_EXCL` so there is
    # no name to squat, renames over the real one so a link at that name is REPLACED rather
    # than written through, and never half-writes — which a plain truncating open did on
    # every failure after the first byte. `indent=2` keeps the bytes a person opening this
    # file reads; the issue ledger beside it is machine-read and stays compact.
    if not TT.write_json_atomic(p, book, indent=2):
        return 0
    # THE IGNORE RULE RIDES THE WRITE, never a session start: the file exists from this
    # moment on, and the rule has to be there before the project's next `git add -A`.
    ensure_ignored(p)
    msg = (f"COMMITMENTS  {len(fresh)} stated this turn · "
           f"{len(book['open'])} open in this project")
    if asks_line:
        msg += "\n" + asks_line
    print(json.dumps({"systemMessage": msg}))
    return 0


if __name__ == "__main__":
    sys.exit(main())
