#!/usr/bin/env python3
"""wf-census — the registry, marker, and hook census `audit` runs on a host.

Why a script and not a checklist. This project's own CLAUDE.md records the ledger
count being wrong THREE TIMES — 24-vs-20, 27-vs-23, and an "index claims 0" that a
wrong root manufactured — and every time the hand count was the thing that was
wrong, not the target. A census that can be re-run is the only kind that can be
compared, and `conversion-taxonomy.md` already ships the rule to users:

    "No count in this project is hand-derived."

Until 2026-08-03 that sentence named `bin/baseline`, which does not ship. This is
the shipped half: the counts `audit` Step 1b needs, computed rather than read.

REPORTS; NEVER REPAIRS. It writes exactly one artifact — the manifest it is asked
for — and never edits an agent, a skill, or a settings file. Same rule
`data-skills.md` § Maintainers puts on every maintainer.

Exit codes
    0  census complete, no blocking condition
    2  a blocking condition: an unresolved name collision, or a path it could not
       read. NEVER 0 on an unreadable tree — a validator exiting 0 on a file it
       could not open reports health it did not measure.

Usage
    wf-census [--root DIR] [--json PATH] [--manifest PATH] [--quiet]
"""

import argparse
import json
import os
import fnmatch
import hashlib
import re
import shlex
import sys

# Anchored for the same reason MARKER_RX is: a file DOCUMENTING the marker
# convention mentions it in prose and inside backticks. Unanchored, this reported
# 10 of 21 immutable blocks "unpaired" on a real project — and an unpaired sacred
# block is the most alarming thing this census can say, because the extraction gate
# blocks every deletion on it. Also tolerant of the `| added: <date> |` field that
# real blocks carry, which the old pattern silently refused to match.
# PAIRING IS OVER ALL ORIGIN BLOCKS; the user-immutable count is a SUBSET of them.
#
# `<!-- /origin -->` closes ANY origin block — user, skill-builder, workforce — so
# pairing user-immutable OPENS against every CLOSE compares two different
# populations. Measured 2026-08-03: that arithmetic reported 30 of 59 sacred blocks
# "unpaired" on a real project where the true figure is 0, because a typical file
# holds one user block and two generator blocks and closes all three the same way.
#
# An unpaired sacred block is the most alarming thing this census can say — the
# extraction gate blocks every deletion on it — so a false one is expensive twice.
ORIGIN_OPEN = re.compile(r"^\s*<!--\s*origin:\s*[^>]*-->\s*$", re.M)
ORIGIN_CLOSE = re.compile(r"^\s*<!--\s*/origin\s*-->\s*$", re.M)
# LINE-ANCHORED AT COLUMN 0, and the indent is the discriminator. In markdown a line
# indented four spaces IS a code block, so an indented marker is documentation ABOUT
# the format, never a span opener. `bin/baseline` established this and measured it:
# 68 naive against 37 anchored on the first sweep — 31 mentions, 46% inflation — and
# the extraction gate blocked a completable sweep because the census it asserted
# against was counting prose.
#
# Measured here 2026-08-05 on odyssey-alive: this pattern reported 118 sacred blocks
# and TWO of them were not sacred blocks. Both were the same line inside an indented
# example — `origin: user | added: YYYY-MM-DD | immutable: true`, where `YYYY-MM-DD`
# is literal. A directive-protection hook firing on a date format string is a false
# positive that trains a reader to ignore it.
IMMUTABLE_OPEN = re.compile(
    r"^<!--\s*origin:\s*user\b[^>]*immutable:\s*true[^>]*-->$", re.M)
# Reported, never silently dropped — `bin/baseline`: "a number that shrank without
# explanation is its own defect."
IMMUTABLE_MENTION = re.compile(
    r"^[ \t]+<!--\s*origin:\s*user\b[^>]*immutable:\s*true[^>]*-->[ \t]*$", re.M)
NAME_RX = re.compile(r"^name:\s*['\"]?([^'\"\n]+?)['\"]?\s*$", re.M)
# `FOO=bar cmd` — a command prefixed by environment assignments. The VALUE very often
# contains a slash (`CLAUDE_PROJECT_DIR=/home/…`), which is exactly what makes an
# assignment mistakable for the path being run. See Census._resolve_segment.
ENV_ASSIGN_RX = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*=")

# Marker families are open-ended by design: a foreign generator invents its own.
# Report unknown families rather than dropping them — four unknown families on the
# first real target is what taught this project that an allowlist here silently
# under-counts (references/legacy-markers.md).
# A REAL marker is a standalone HTML comment on its own line. A marker NAMED inside
# prose or backticks is documentation about markers, not one.
#
# Measured 2026-08-03: the unanchored form reported 11 unpaired "sweep hazards"
# against a real project, ALL FALSE. The cause was sentences like
#   - The `<!-- ROUTE-DISPATCH-CHECKPOINT START -->` marker is present exactly once
#     and is paired with exactly one END marker
# where START matches and the English "one END marker" does not. Five more were
# inside workforce's OWN installed skill, so every host would see them on every
# audit — and `procedures/audit.md` § Step 3b excludes an unpaired file from
# extraction AND from the sweep until a human resolves it. A false hazard here
# silently freezes a correct file.
MARKER_RX = re.compile(
    r"^\s*<!--\s*/?([A-Za-z][\w-]*(?:-[A-Za-z][\w-]*)*)\s+(START|END)\b[^>]*-->\s*$",
    re.I | re.M,
)


class Census:
    def __init__(self, root):
        self.root = os.path.abspath(root)
        self.unreadable = []
        self.agents = []
        self.skill_agents = []
        self.markers = {}
        self.unpaired = []
        self.hooks = []
        self.immutable_blocks = []
        self.skills = []
        self.ignore_patterns = []
        self.ignore_hits = {}
        self.ignored_files = 0

    # ── reading ──────────────────────────────────────────────────────────────
    def read(self, path):
        try:
            with open(path, encoding="utf-8", errors="strict") as fh:
                return fh.read()
        except (OSError, UnicodeDecodeError) as exc:
            # Absent, empty, unreadable and malformed are four distinct states and
            # each is answered. "Nothing to check" is not one of them.
            self.unreadable.append((path, type(exc).__name__))
            return None

    # ── agents ───────────────────────────────────────────────────────────────
    def census_agents(self):
        """Both resolving locations, plus AGENT.md under skills.

        Identity comes solely from `name:`; subfolders do NOT namespace, and a
        duplicate resolves by filesystem read order with no documented precedence
        — the loser simply never loads and nothing reports it. So a name occupied
        ANYWHERE in the union is occupied.
        """
        locations = [
            (os.path.join(self.root, ".claude", "agents"), "project"),
            (os.path.expanduser("~/.claude/agents"), "personal"),
        ]
        for base, scope in locations:
            if not os.path.isdir(base):
                continue
            for dirpath, _dirnames, filenames in os.walk(base):
                for fn in filenames:
                    if not fn.endswith(".md"):
                        continue
                    p = os.path.join(dirpath, fn)
                    self.agents.append(self._agent_row(p, scope))

        skills = os.path.join(self.root, ".claude", "skills")
        if os.path.isdir(skills):
            for dirpath, _dirnames, filenames in os.walk(skills):
                for fn in filenames:
                    if fn == "AGENT.md":
                        p = os.path.join(dirpath, fn)
                        self.skill_agents.append(self._agent_row(p, "in-skill"))

    def _agent_row(self, path, scope):
        row = {
            "path": path,
            "scope": scope,
            "is_symlink": os.path.islink(path),
            "link_target": None,
            "resolved": None,
            "dangling": False,
            "name": None,
        }
        if row["is_symlink"]:
            row["link_target"] = os.readlink(path)
            resolved = os.path.realpath(path)
            row["resolved"] = resolved
            row["dangling"] = not os.path.exists(resolved)
        body = self.read(path)
        if body is not None:
            m = NAME_RX.search(body)
            row["name"] = m.group(1).strip() if m else None
        return row

    def collisions(self):
        """A name occupied anywhere in the union is occupied.

        DEDUPE BY REAL PATH FIRST. A symlink in `.claude/agents/` pointing at an
        in-skill `AGENT.md` is the SAME FILE reached two ways — it is the standard
        install pattern for skills that ship agents, not a name conflict. Counting
        both ends produced three false collisions on the first real target, and a
        collision is BLOCKING (exit 2, and precondition 1(b) of the Atomic-or-Absent
        gate), so the false positives would have halted a correctly-configured
        project's audit.

        Found 2026-08-03 by running this against ~/lab/odyssey-alive: 5 reported,
        3 were symlink aliases, 2 were real. This repo's CLAUDE.md already records
        the pattern — a drift the census reports is a claim about the census too,
        and every previous time the target was right. That is now four for four.

        AND THEN THE REMAINING TWO WERE NOT COLLISIONS EITHER.

        RESOLVING is `.claude/agents/` and `~/.claude/agents/` — the only places the
        harness resolves an agent from (`platform.md` fact 5). Two entries there
        sharing a `name:` is a LIVE collision: one silently never loads.

        An in-skill `AGENT.md` is different. Its skill loads it BY PATH ("Read
        .claude/skills/<skill>/agents/<x>/AGENT.md"), so its `name:` is
        documentation, not an address — `staging.md` § The same constraint applies to
        workforce's own panel agents says exactly that. Two skills carrying a same-named template
        collide over nothing; they are separate files, deliberately different, and
        each caller names the one it wants.

        THESE ARE TWO QUESTIONS AND THIS METHOD USED TO ANSWER ONLY ONE:

          "safe for workforce to CLAIM for a new employee?"  -> the whole union,
            because an in-skill template may be symlinked into a resolving
            location later (`data-skills.md` § Naming). ADVISORY: it constrains
            what we may name, never whether the user's tree is broken.
          "is there a LIVE collision blocking this run?"      -> resolving
            locations only. BLOCKING.

        Conflating them made `namespace` blocking, and on the first real target
        that meant halting the audit of a correctly-configured project over five
        per-skill validator templates that had never collided with anything.

        AND THE THIRD INSTANCE OF THE SAME CLASS, 2026-08-05.

        `/workforce dev audit` against claude-workforce itself reported 4 live
        collisions — the four shipped canary fixtures, present in BOTH
        `~/.claude/agents/` and `./.claude/agents/` because the user-scope install and
        the project-scope install each place them in their own scope, and nothing reconciles
        the two. All four were byte-identical to each other AND to the shipped source.

        THAT IS NOT WHAT A COLLISION MEANS HERE. The gate exists because one entry
        "silently never loads" — the danger is that WHICH ONE WINS IS INVISIBLE AND
        THEY DIFFER. Two byte-identical copies resolve to the same behaviour whichever
        wins, so there is nothing to be wrong about. Blocking on it halted the audit of
        a correctly-installed tree, which is the same failure as the two above.

        So the split is by CONTENT, not only by path:

          different bytes, same name, resolving  -> COLLISION. Blocking. One shadows
                                                    the other and nobody can see which.
          identical bytes, same name, resolving  -> DUPLICATE. Advisory, with the
                                                    remedy named. It is still residue
                                                    under the user's directive, and it
                                                    is still not a reason to halt.

        SELF-CORRECTING BY CONSTRUCTION: the moment one copy is updated and the other
        is not, they differ, and it becomes a blocking collision again — which is
        exactly when it starts to matter.
        """
        return self._by_name(self.agents)[0]

    def duplicates(self):
        """Same name, resolving locations, BYTE-IDENTICAL. Advisory — see collisions()."""
        return self._by_name(self.agents)[1]

    def _by_name(self, rows):
        """(collisions, duplicates) — split by whether the copies actually differ."""
        seen = {}
        for row in rows:
            if not row["name"]:
                continue
            try:
                key = os.path.realpath(row["path"])
            except OSError:
                key = row["path"]
            seen.setdefault(row["name"], {})[key] = row["path"]

        collisions, duplicates = {}, {}
        for name, paths in seen.items():
            if len(paths) < 2:
                continue
            found = sorted(paths.values())
            digests = set()
            for p in found:
                try:
                    with open(p, "rb") as fh:
                        digests.add(hashlib.sha256(fh.read()).hexdigest())
                except OSError:
                    # Unreadable is NOT identical. Fall back to the blocking side:
                    # a copy nobody can read is a copy nobody can prove harmless.
                    digests.add(f"unreadable:{p}")
            (duplicates if len(digests) == 1 else collisions)[name] = found
        return collisions, duplicates

    def namespace(self):
        """Same-named in-skill templates. ADVISORY — reported, never blocking.

        These constrain what workforce may name a new employee. They do not mean
        anything is wrong with the tree.
        """
        live = set(self.collisions())
        return {
            n: paths
            for n, paths in self._dedupe_all().items()
            if n not in live
        }

    def _dedupe_all(self):
        seen = {}
        for row in self.agents + self.skill_agents:
            if not row["name"]:
                continue
            try:
                key = os.path.realpath(row["path"])
            except OSError:
                key = row["path"]
            seen.setdefault(row["name"], {})[key] = row["path"]
        return {n: sorted(p.values()) for n, p in seen.items() if len(p) > 1}

    def aliases(self):
        """Distinct paths resolving to one file — reported, never a collision."""
        by_real = {}
        for row in self.agents + self.skill_agents:
            try:
                by_real.setdefault(os.path.realpath(row["path"]), []).append(row["path"])
            except OSError:
                pass
        return {r: p for r, p in by_real.items() if len(p) > 1}

    # ── skills ───────────────────────────────────────────────────────────────
    def census_skills(self):
        """Every installed skill, by directory holding a SKILL.md.

        Added 2026-08-03. The first real audit's opening banner said "46 skills
        present" against an actual 45 — hand-counted in Step 1, five minutes before
        Step 1b ran the census that exists so counts are not hand-derived. The count
        was never wrong because anyone was careless; it was wrong because nothing
        produced it. `conversion-taxonomy.md` already ships the rule to users:
        "No count in this project is hand-derived."
        """
        base = os.path.join(self.root, ".claude", "skills")
        if not os.path.isdir(base):
            return
        for entry in sorted(os.listdir(base)):
            d = os.path.join(base, entry)
            if os.path.isdir(d) and os.path.exists(os.path.join(d, "SKILL.md")):
                self.skills.append(entry)

    # ── markers ──────────────────────────────────────────────────────────────
    def load_ignore(self):
        """Declared corpus exclusions from `.censusignore`. Absent is the normal case.

        WHY THIS EXISTS. MEASURED 2026-08-05 by the first `dev audit` against
        claude-workforce itself: BOTH "unpaired markers (sweep hazards)" were
        `fixtures/f9-half-migrated` and `fixtures/scripts/census-inverted` — corpora
        BUILT TO BE MALFORMED so that this census can detect malformation. And of the
        files carrying sacred blocks, 21 were in `fixtures/` against 21 outside it:
        half the "user directives" in the tree were test data.

        A test corpus is not project content. Extracting a fixture's sacred block as
        though it were the user's own words, or freezing a deliberately-broken fixture
        as a sweep hazard, is the census reporting on itself.

        DECLARED, NEVER INFERRED. There is no heuristic here — no `fixtures/` default,
        no guess from directory names. A project says what its corpus is, or says
        nothing and everything is surveyed, which stays the normal case (Core Principle
        5: absence is not a gap).

        AND THE DANGEROUS DIRECTION IS UNDER-REPORTING, so every exclusion is COUNTED
        and every pattern that matched nothing is NAMED. A silent exclusion is how a
        census reports health it did not measure — the failure this script's own exit
        codes were written against. A dead pattern is reported for the same reason a
        dead check is: it looks like coverage and is not.
        """
        path = os.path.join(self.root, ".censusignore")
        body = None
        if os.path.isfile(path):
            body = self.read(path)
        if not body:
            return
        for raw in body.splitlines():
            s = raw.split("#", 1)[0].strip()
            if s:
                self.ignore_patterns.append(s)

    def ignored(self, path):
        """True if `path` matches a declared pattern. Records which pattern hit.

        PUBLIC, because it has consumers outside this file. `wf-conform` reads the
        same declaration through it so that "what counts as project content" is
        answered once; when it was private, that file grew its own directory-name
        guess instead and the two disagreed.
        """
        if not self.ignore_patterns:
            return False
        rel = os.path.relpath(path, self.root).replace(os.sep, "/")
        for pat in self.ignore_patterns:
            p = pat.rstrip("/")
            if (fnmatch.fnmatch(rel, p) or fnmatch.fnmatch(rel, p + "/*")
                    or rel == p or rel.startswith(p + "/")):
                self.ignore_hits[pat] = self.ignore_hits.get(pat, 0) + 1
                return True
        return False

    def census_markers(self):
        """Every marker family, and pairing.

        An unpaired marker is a sweep hazard: a lone START means a removal pass has
        no end boundary and takes the rest of the file with it. Report, never repair.
        """
        for dirpath, dirnames, filenames in os.walk(self.root):
            dirnames[:] = [d for d in dirnames if d not in (".git", "node_modules", ".venv")]
            for fn in filenames:
                if not fn.endswith(".md"):
                    continue
                p = os.path.join(dirpath, fn)
                if self.ignored(p):
                    self.ignored_files += 1
                    continue
                body = self.read(p)
                if body is None:
                    continue
                # ORDER MATTERS, so this walks rather than sums. `END … START`
                # balances to 0 under +1/-1 arithmetic and is a REAL hazard: a sweep
                # keyed on the opener finds no boundary and takes the rest of the file.
                depth, opened = {}, {}
                for m in MARKER_RX.finditer(body):
                    fam, side = m.group(1).upper(), m.group(2).upper()
                    self.markers[fam] = self.markers.get(fam, 0) + 1
                    if side == "START":
                        opened[fam] = opened.get(fam, 0) + 1
                        depth[fam] = depth.get(fam, 0) + 1
                    else:
                        if opened.get(fam, 0) == 0:
                            self.unpaired.append(
                                {"file": p, "family": fam, "imbalance": "END before START"})
                        else:
                            opened[fam] -= 1
                        depth[fam] = depth.get(fam, 0) - 1
                for fam, d in depth.items():
                    if d > 0:
                        self.unpaired.append(
                            {"file": p, "family": fam, "imbalance": f"{d} unclosed"}
                        )
                # WALK, do not count. Two constructs share the `origin:` prefix:
                # a PAIRED block closed by `<!-- /origin -->`, and a SINGLE-LINE
                # annotation with no close (skill-builder uses both — see
                # `manifest.txt` § Vendored evaluator catalogs). Counting opens
                # against closes cannot tell them apart and over-reports every
                # annotation as a hazard.
                #
                # The only question that gates the sweep: does a SACRED block have
                # a close before the next origin marker? An unterminated sacred
                # span is where extraction takes the wrong bytes. A generator's
                # annotation is not a hazard and is not counted as one.
                sacred = unterminated = mentions = 0
                sacred_lines = []
                pending = False
                for lineno, line in enumerate(body.splitlines(), 1):
                    ls = line.strip()
                    if ORIGIN_CLOSE.match(line):
                        pending = False
                    # BEFORE ORIGIN_OPEN, which is whitespace-tolerant and would
                    # otherwise claim the line and report 0 mentions forever.
                    elif IMMUTABLE_MENTION.match(line):
                        mentions += 1          # indented: an example, not an opener
                    elif ORIGIN_OPEN.match(line):
                        if pending:
                            unterminated += 1      # a sacred open, then another open
                        is_sacred = bool(IMMUTABLE_OPEN.match(line))
                        sacred += is_sacred
                        # The LINE, not just the count. An extraction record cites
                        # `file:line`, so a coverage check that has only a total can
                        # compare two numbers and never tell WHICH span is missing.
                        if is_sacred:
                            sacred_lines.append(lineno)
                        pending = is_sacred
                if pending:
                    unterminated += 1              # sacred open, EOF, no close
                if sacred or unterminated or mentions:
                    self.immutable_blocks.append(
                        {"file": p, "sacred": sacred, "lines": sacred_lines,
                         "mentions": mentions,
                         "unterminated": unterminated, "paired": unterminated == 0}
                    )

    # ── hooks ────────────────────────────────────────────────────────────────
    @staticmethod
    def shell_segments(raw):
        """The commands in a shell line, in execution order, unwrapped.

        ONE PRODUCER FOR THE OPERATOR GRAMMAR, and it exists because `shlex.split`
        is a WORD splitter, not a shell parser. It knows nothing about `;`, `&&`,
        `||`, `|` or `&`, so it fuses a trailing separator onto the preceding word.

        MEASURED 2026-08-10, both directions, from one fixture pair:

        - FALSE DEAD. `bash bin/real.sh; echo done` tokenized to `bin/real.sh;` —
          semicolon included — which is not a path on any disk. `wf-checkrun`
          reported a live script dead and exited 1 on a handbook whose check was
          fine. Surfaced by a project audit that could not fix it from its own tree.
        - SILENT MISS, and this is the worse half. `cd "$X" && bash bin/real.sh`
          gave first token `cd`, no slash, UNDECIDABLE — so the real script was
          never examined and a dead registration in that shape reports as nothing.
          Under-reporting is the direction `load_ignore` is written against too.

        `shlex.shlex(punctuation_chars=True)` is used rather than a regex split
        because the separator must be recognised OUTSIDE quotes only: a regex over
        the raw text severs `bash -c "a; b"` mid-string, and that inline-script
        shape is the one `resolve_hook_command` must keep whole in order to refuse
        it. Returns [] when the line does not lex — an unbalanced quote is
        undecidable, never a guess.
        """
        lex = shlex.shlex(raw, posix=True, punctuation_chars=True)
        lex.whitespace_split = True
        try:
            tokens = list(lex)
        except ValueError:
            return []
        segments, current = [], []
        for t in tokens:
            if t in (";", "&", "&&", "|", "||", "\n"):
                if current:
                    segments.append(current)
                current = []
                continue
            # Grouping and redirection are not commands. `(bash bin/y.sh)` put `(`
            # in the first position, which carries no slash and so read UNDECIDABLE.
            if t in ("(", ")", "{", "}", ">", ">>", "<", ">&", "<&"):
                continue
            current.append(t)
        if current:
            segments.append(current)
        return segments

    def resolve_hook_command(self, cmd):
        """The script a hook command would run, and whether it is on disk.

        Returns (resolved_path, exists). BOTH ARE None WHEN THE COMMAND CANNOT BE
        DECIDED -- an inline shell pipeline, a bare name found on PATH, anything
        this cannot reduce to one file. An undecidable command is never reported
        as dead: a false "dead wiring" row invites someone to delete a working
        registration, which is worse than the silence this replaces.

        Written 2026-08-04. This method's absence is why three dead registrations
        in a real project survived a full audit unremarked -- `procedures/hooks.md`
        declares a `dead wiring - command not on disk` count in its report block
        and nothing computed it. The docstring below already promised "the
        resolved command path" and no code resolved anything.
        """
        raw = (cmd or "").strip()
        if not raw:
            return None, None

        # THE FIRST DECIDABLE SEGMENT WINS, and the loop is the point. A line's
        # leading segment is very often a `cd`, a `test -f`, or a `mkdir -p` — bare
        # names on PATH, undecidable by design — and stopping there is what made the
        # real script behind `&&` invisible. Later segments were never examined
        # before this loop existed, so nothing that used to resolve stops resolving.
        for tokens in self.shell_segments(raw):
            resolved = self._resolve_segment(tokens)
            if resolved is not None:
                return resolved, os.path.exists(resolved)
        return None, None

    def _resolve_segment(self, tokens):
        """The one file a single command runs, or None when it cannot be decided.

        AN ENVIRONMENT PREFIX IS NOT THE COMMAND. `FOO=bar cmd` and `env FOO=bar cmd`
        both run `cmd`; the assignments are shell grammar sitting in front of it.
        MEASURED 2026-08-10 against a real project the moment segment-walking landed:
        `printf '%s' '{...}' | CLAUDE_PROJECT_DIR=/home/… bash .claude/…/hook.sh`
        reached segment two, whose first token was the ASSIGNMENT — and it carries a
        slash, so it read as a path, resolved to nothing, and reported a live hook
        dead. The pre-existing behaviour hid this by never reaching segment two at
        all, which is why walking the segments had to bring the grammar with it.
        """
        while tokens and (ENV_ASSIGN_RX.match(tokens[0])
                          or (tokens[0] == "env" and len(tokens) > 1)):
            tokens = tokens[1:]
        if not tokens:
            return None
        first = tokens[0]
        # An interpreter invocation runs its script argument, not itself.
        if os.path.basename(first) in ("sh", "bash", "zsh", "python", "python3", "node", "pwsh"):
            args = [t for t in tokens[1:] if not t.startswith("-")]
            if len(tokens) > 1 and tokens[1] in ("-c", "-Command"):
                return None                # inline script: nothing to stat
            if not args:
                return None
            first = args[0]

        if "/" not in first:
            return None                    # resolved via PATH; not ours to judge

        path = first
        for var in ("${CLAUDE_PROJECT_DIR}", "$CLAUDE_PROJECT_DIR"):
            path = path.replace(var, self.root)
        path = os.path.expandvars(os.path.expanduser(path))
        if "$" in path:
            return None                    # an env var this process cannot know
        if not os.path.isabs(path):
            path = os.path.join(self.root, path)
        return os.path.normpath(path)

    def owning_skill(self, resolved):
        """Which skill directory this hook's script lives in, exactly.

        `sweep` step 5 must relocate the hooks belonging to THE TARGET it is about
        to unlink, and that is a per-skill question. The `in_skill_dir` flag beside
        it is a global boolean derived from a substring of the command text, which
        answers "some skill, probably" and cannot answer "this one."

        Returns the skill NAME, or None when the path is outside `.claude/skills/`
        or the command was undecidable. Compares real paths, so a symlinked skill
        directory still reports its true owner.
        """
        if not resolved:
            return None
        base = os.path.realpath(os.path.join(self.root, ".claude", "skills"))
        target = os.path.realpath(resolved)
        if not target.startswith(base + os.sep):
            return None
        rest = target[len(base) + 1:].split(os.sep)
        return rest[0] if rest and rest[0] else None

    def census_hooks(self):
        """Wired hooks from both settings scopes, with the resolved command path.

        A hook whose command lands inside a skill directory is the case that
        matters: removing that skill takes a live safety mechanism with it.
        """
        scopes = [(os.path.join(self.root, r), r) for r in
                  (".claude/settings.json", ".claude/settings.local.json")]
        scopes.append((os.path.expanduser("~/.claude/settings.json"), "~/.claude/settings.json"))
        for p, rel in scopes:
            if not os.path.exists(p):
                continue
            body = self.read(p)
            if body is None:
                continue
            try:
                cfg = json.loads(body)
            except json.JSONDecodeError as exc:
                self.unreadable.append((p, f"JSONDecodeError: {exc.msg}"))
                continue
            for event, entries in (cfg.get("hooks") or {}).items():
                for entry in entries if isinstance(entries, list) else []:
                    for h in entry.get("hooks", []) if isinstance(entry, dict) else []:
                        cmd = h.get("command", "")
                        resolved, exists = self.resolve_hook_command(cmd)
                        owner = self.owning_skill(resolved)
                        self.hooks.append(
                            {
                                "settings": rel,
                                "event": event,
                                "matcher": entry.get("matcher"),
                                "command": cmd,
                                # Resolution-based when the command is decidable;
                                # the substring is a fallback for the rest and is
                                # advisory only.
                                "in_skill_dir": (owner is not None if resolved
                                                 else ".claude/skills/" in cmd),
                                "skill": owner,
                                "resolved": resolved,
                                "exists": exists,
                            }
                        )

    # ── report ───────────────────────────────────────────────────────────────
    def summary(self):
        col = self.collisions()
        return {
            "root": self.root,
            "skills": {"count": len(self.skills), "names": self.skills},
            "agents": {
                "project": sum(1 for a in self.agents if a["scope"] == "project"),
                "personal": sum(1 for a in self.agents if a["scope"] == "personal"),
                "in_skill": len(self.skill_agents),
                "symlinks": sum(1 for a in self.agents if a["is_symlink"]),
                "dangling": sum(1 for a in self.agents if a["dangling"]),
            },
            "collisions": col,
            "duplicates": self.duplicates(),
            "ignored": {
                "patterns": list(self.ignore_patterns),
                "files": self.ignored_files,
                "dead": [p for p in self.ignore_patterns if p not in self.ignore_hits],
            },
            "aliases": self.aliases(),
            "namespace": self.namespace(),
            "marker_families": dict(sorted(self.markers.items())),
            "unpaired_markers": self.unpaired,
            "immutable_blocks": {
                "files": len([b for b in self.immutable_blocks if b["sacred"]]),
                "blocks": sum(b["sacred"] for b in self.immutable_blocks),
                "mentions": sum(b.get("mentions", 0) for b in self.immutable_blocks),
                "unterminated": sum(b["unterminated"] for b in self.immutable_blocks),
                "unpaired": [b for b in self.immutable_blocks if not b["paired"]],
                # PER-FILE, WITH LINE NUMBERS, BECAUSE THE AGGREGATE ANSWERS THE WRONG
                # QUESTION. The extraction gate is tree-wide (`N of N spans`) and one
                # consumer is not: T2 for a removal target asks whether every sacred
                # span INSIDE ONE DIRECTORY was extracted before that directory is
                # unlinked. These records existed and were discarded here, so the only
                # way to scope the count was a hand grep — which over-counted
                # `skill-builder` 37 against the true 6 by matching indented examples
                # and markers quoted mid-line, and left a real gate unsettled for a
                # day. A census whose scope cannot be narrowed is re-derived by hand,
                # and `bin/baseline`'s own docstring says what hand counts are worth.
                "by_file": sorted(
                    ({"file": b["file"], "sacred": b["sacred"],
                      "lines": b.get("lines", []), "mentions": b["mentions"],
                      "unterminated": b["unterminated"]}
                     for b in self.immutable_blocks if b["sacred"]),
                    key=lambda b: b["file"]),
            },
            "hooks": self.hooks,
            "unreadable": self.unreadable,
        }


def main():
    ap = argparse.ArgumentParser(prog="wf-census")
    ap.add_argument("--root", default=".")
    ap.add_argument("--json", dest="json_path")
    ap.add_argument("--manifest", dest="manifest_path")
    ap.add_argument("--quiet", action="store_true")
    args = ap.parse_args()

    # AN EMPTY --root IS A CALLER ERROR, NEVER A SILENT RETARGET TO CWD.
    # `${CLAUDE_PROJECT_DIR}` is UNSET in the Bash tool — measured 2026-08-04 on
    # 2.1.221 — so every shipped `--root "${CLAUDE_PROJECT_DIR}"` block expands to
    # `--root ""`. `os.path.abspath("")` is the CWD, which is a real directory, so a
    # is-it-a-directory guard passes and the tool examines a tree nobody named.
    # Measured: `wf-conform --root ""` in an empty dir exited 0 reporting
    # "0 governed · 0 failed" — a validator reporting health it never measured, which
    # is the exact contract procedures/verify.md states five lines under the block
    # that produces it.
    if not (args.root or "").strip():
        print("wf-census: --root is empty. ${CLAUDE_PROJECT_DIR} is unset outside a "
              "hook; pass an explicit path.", file=sys.stderr)
        return 2

    if not os.path.isdir(args.root):
        print(f"wf-census: not a directory: {args.root}", file=sys.stderr)
        return 2

    c = Census(args.root)
    c.load_ignore()
    c.census_agents()
    c.census_skills()
    c.census_markers()
    c.census_hooks()
    s = c.summary()

    if args.json_path:
        with open(args.json_path, "w", encoding="utf-8") as fh:
            json.dump(s, fh, indent=2, sort_keys=True)

    if args.manifest_path:
        with open(args.manifest_path, "w", encoding="utf-8") as fh:
            fh.write("# agent registry census — kind, link, resolved, owner, dangling\n")
            for a in c.agents + c.skill_agents:
                fh.write(
                    "\t".join(
                        [
                            "symlink" if a["is_symlink"] else "file",
                            a["path"],
                            a["link_target"] or "-",
                            a["resolved"] or "-",
                            a["scope"],
                            a["name"] or "(no name:)",
                            "DANGLING" if a["dangling"] else "ok",
                        ]
                    )
                    + "\n"
                )

    if not args.quiet:
        ag = s["agents"]
        # THE TITLE LINE FIRST, and every body row under it. A row printed above the
        # header names no tree: `skills 4 installed` with the root on the NEXT line
        # reads as a count of something the reader has not been told the scope of.
        # Introduced by appending a row at the wrong offset (26ec383) and invisible in
        # a diff, because both lines are correct in isolation and only their ORDER is
        # wrong — the class of defect a fixture catches and a review does not.
        print(f"wf-census — {s['root']}")
        # Always all counts, including the zeroes. A zero is a measurement;
        # silence is not.
        print(f"  skills      {s['skills']['count']} installed")
        print(
            f"  agents      {ag['project']} project · {ag['personal']} personal · "
            f"{ag['in_skill']} in-skill · {ag['symlinks']} symlinks · {ag['dangling']} dangling"
        )
        print(
            f"  markers     {len(s['marker_families'])} families · "
            f"{sum(s['marker_families'].values())} markers · "
            f"{len(s['unpaired_markers'])} unpaired (sweep hazards)"
        )
        ib = s["immutable_blocks"]
        print(
            f"  immutable   {ib['blocks']} sacred blocks in {ib['files']} files · "
            f"{ib['unterminated']} unterminated (extraction hazards) · "
            f"{ib['mentions']} indented mention(s) not counted"
        )
        _dead = [h for h in s['hooks'] if h.get('exists') is False]
        _unknown = sum(1 for h in s['hooks'] if h.get('exists') is None)
        print(f"  hooks       {len(s['hooks'])} wired · "
              f"{sum(1 for h in s['hooks'] if h['in_skill_dir'])} inside a skill dir · "
              f"{len(_dead)} dead · {_unknown} undecidable")
        # A dead registration is named, never just counted: the whole point is
        # that someone can act on it, and `3 dead` is not actionable.
        for h in _dead:
            print(f"                DEAD  {h['event']:<14} {h['resolved']}")
        print(f"  aliases     {len(s['aliases'])} file(s) reachable by >1 path (symlinks — not collisions)")
        print(f"  namespace   {len(s['namespace'])} in-skill template name(s) shared "
              f"(advisory — loaded by path, not resolved by name)")
        _ig = s["ignored"]
        if _ig["patterns"]:
            print(f"  excluded    {_ig['files']} file(s) by {len(_ig['patterns'])} declared "
                  f"pattern(s) in .censusignore")
            for _p in _ig["patterns"]:
                print(f"    · {_p}")
            # A pattern matching nothing looks like coverage and is not — the same
            # reason a dead check is reported rather than counted as one.
            for _p in _ig["dead"]:
                print(f"    ! DEAD pattern (matched nothing): {_p}")
        print(f"  duplicates  {len(s['duplicates'])} name(s) installed in BOTH scopes, "
              f"byte-identical (advisory — same behaviour whichever resolves)")
        for name, paths in s["duplicates"].items():
            print(f"    · {name}: {', '.join(paths)}")
        print(f"  collisions  {len(s['collisions'])} live (resolving locations only)")
        for name, paths in s["collisions"].items():
            print(f"    ! {name}: {', '.join(paths)}")
        for name, paths in s["namespace"].items():
            print(f"    · {name}: {len(paths)} in-skill copies — advisory; workforce "
                  f"may not claim this name")
        for f in s["unpaired_markers"]:
            print(f"    ! unpaired {f['family']} in {f['file']} (imbalance {f['imbalance']})")
        for p, why in s["unreadable"]:
            print(f"    ! unreadable {p}: {why}")

    # A collision is blocking: it resolves silently by read order, so a run that
    # continues past one has registered an employee that may never load.
    return 2 if (s["collisions"] or s["unreadable"]) else 0


if __name__ == "__main__":
    sys.exit(main())
