#!/usr/bin/env python3
"""wf-ledger-open — say once, at the top of a session, what is waiting to be accepted.

WHY THIS EXISTS. `wf-ledger-capture` drafts records automatically and every one of them
lands `proposed`, which means none of them is served to anybody until the user accepts
it. A draft nobody is told about is a draft nobody accepts, and the store fills with
evidence that never becomes usable. This is the other half of that design: the drafts
surface exactly once, where the user is already looking.

WHY A `UserPromptSubmit` HOOK. It is the only event that fires with the user's own turn
and can put text in front of the model without a tool call. `SessionStart` would be the
obvious home and is not available to this distribution's wiring; keying on the payload's
session id gives the same once-per-session behaviour on an event that fires every turn.

WHAT IT DOES. Reads the session id, and on the FIRST turn of that session only, asks
`wf-ledger pending --json` what is waiting and emits `additionalContext` naming each
draft and the command that accepts it. That is all it can do — the whole surface is one
context string; it cannot block, edit, or decide.

  * SILENT WHEN THERE IS NOTHING. No pending drafts, no output at all. A hook that
    announces its own emptiness every session teaches the reader to skip it, and then
    it is not there when it matters.
  * SILENT ON EVERY LATER TURN of the same session, whether or not it spoke on the
    first. The session is marked as seen the first time it is inspected, so a draft
    captured mid-session is announced at the head of the NEXT session rather than
    interrupting this one. Announcing on capture would put a list the user did not ask
    for in the middle of unrelated work.
  * NEVER READS THE STORE ITSELF. `wf-ledger` is the gateway; this hook shells out to
    it. A hook with its own copy of the record format is a second implementation that
    drifts, and the one rule that must not drift — a `proposed` record is never served
    — lives on the other side of that door.

THE STATE FILE is `.claude/workforce/.ledger-open.json`, a list of session ids capped
at the most recent `MAX_SESSIONS`. It is written every time a new session id is seen,
including when nothing is pending. Unreadable or corrupt state is treated as "no
sessions seen": the worst case is one extra announcement, and the alternative — failing shut — makes a
corrupt file permanently silence the hook.

WHAT IT DOES NOT DO. It does not touch `wf-standing-request`, which inspects nothing
today and keeps that property. It does not accept, rank, or summarize a draft; the ids
and their subjects are the whole message, because a summary of a record the user has
not read yet is a second unagreed claim about it.

EXIT CODES: 0 always. A session-opening hook that fails a turn over its own bookkeeping
is worse than the list it is trying to show.
"""

import json
import os
import subprocess
import sys

MAX_SESSIONS = 50
STATE = os.path.join(".claude", "workforce", ".ledger-open.json")
MAX_LISTED = 10


def _note(msg):
    sys.stderr.write("wf-ledger-open: " + msg + "\n")


def state_path(root):
    return os.path.join(root, STATE)


def seen_sessions(root):
    """The session ids already announced to. A corrupt file reads as empty — failing
    shut would let one bad write silence this hook forever."""
    try:
        with open(state_path(root), encoding="utf-8") as fh:
            data = json.load(fh)
    except (OSError, ValueError):
        return []
    sessions = data.get("sessions") if isinstance(data, dict) else None
    return [s for s in sessions if isinstance(s, str)] if isinstance(sessions, list) else []


def mark_seen(root, session_id, sessions):
    sessions = [s for s in sessions if s != session_id] + [session_id]
    sessions = sessions[-MAX_SESSIONS:]
    try:
        os.makedirs(os.path.dirname(state_path(root)), exist_ok=True)
        with open(state_path(root), "w", encoding="utf-8") as fh:
            json.dump({"sessions": sessions}, fh, indent=2)
    except OSError as exc:
        # NOT fatal, and NOT silent. Without the mark the announcement repeats every
        # turn, which is the noisy failure rather than the silent one.
        _note("could not record this session (%s); the list may repeat" % exc)


def pending(root):
    """Whatever the gateway says is proposed. [] on any failure — this hook never
    guesses at the store's contents."""
    gateway = os.path.join(os.path.dirname(os.path.abspath(__file__)), "wf-ledger")
    if not os.path.exists(gateway):
        return []
    try:
        proc = subprocess.run([sys.executable, gateway, "--root", root,
                               "pending", "--json"],
                              capture_output=True, text=True, timeout=20)
    except (OSError, subprocess.SubprocessError) as exc:
        _note("gateway did not run (%s)" % exc)
        return []
    if proc.returncode != 0:
        return []
    try:
        rows = json.loads(proc.stdout or "[]")
    except ValueError:
        return []
    return rows if isinstance(rows, list) else []


def context(rows):
    lines = ["**%d project record(s) are waiting for you to accept or reject.** They "
             "were drafted automatically from earlier turns and NONE of them is served "
             "to any agent until accepted." % len(rows)]
    for row in rows[:MAX_LISTED]:
        lines.append("- `%s` — %s — subjects: %s"
                     % (row.get("id", "(no id)"), row.get("recorded", "(no date)"),
                        row.get("subjects", "(unclassified)")))
    if len(rows) > MAX_LISTED:
        lines.append("- …and %d more; `wf-ledger pending` lists them all."
                     % (len(rows) - MAX_LISTED))
    lines.append("Accept one with `wf-ledger accept <id> --execute`. Reject one by "
                 "deleting its file. Do not act on a draft as though it were accepted.")
    return "\n".join(lines)


def main():
    try:
        payload = json.loads(sys.stdin.read() or "{}")
    except (ValueError, OSError):
        return 0
    if not isinstance(payload, dict):
        return 0

    session_id = payload.get("session_id") or payload.get("sessionId") or ""
    root = payload.get("cwd") or os.environ.get("CLAUDE_PROJECT_DIR") or os.getcwd()
    root = os.path.abspath(root)
    if not session_id:
        # No id means no way to fire once. Silence is the safe answer: the alternative
        # is a list re-injected on every turn of every session.
        return 0

    sessions = seen_sessions(root)
    if session_id in sessions:
        return 0
    mark_seen(root, session_id, sessions)

    rows = pending(root)
    if not rows:
        return 0
    print(json.dumps({
        "hookSpecificOutput": {
            "hookEventName": "UserPromptSubmit",
            "additionalContext": context(rows),
        }
    }))
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception as exc:  # never cost the user a turn over a listing
        _note("could not list pending records — %s: %s" % (type(exc).__name__, exc))
        sys.exit(0)
