#!/usr/bin/env python3
"""wf-heal — put a project right at `SessionStart`, before its first request.

WHAT IT HEALS (`heal_settings`): the retired workforce hook ROWS in the project's
settings, the retired pin guard's GIT hook, the machine-owned REGIONS a release moved on,
and the retired commitments ledger (`_retired_ledger`).

WHERE IT CAME FROM. This is the `SessionStart` half of `wf-commitments`, which kept a
per-project list of what a turn said it would do and read it back at the next session.
User, 2026-10-14: "Retire it, fold in". The list never closed an item and filled with
fragments, while the issue ledger already tracks the work and closes it. So the capture
moved to `wf-widen`, where a stated intention lands on its issue as a `noted` line that is
never judged, and the ASKS reply-shape check moved with it. What was left here is the heal,
which rode that registration only because it fires once per session in every project.

EXIT CODES: 0 always.
"""

import importlib.machinery
import importlib.util
import json
import os
import re
import sys


def _sibling(name):
    """A sibling hook, imported so its definitions are shared rather than restated:
    `wf-task-tag`'s guarded reader, and the classifiers in `wf-settings-apply` and
    `wf-companion`."""
    # Importing by path would drop a __pycache__ into the shipped directory.
    sys.dont_write_bytecode = True
    path = os.path.join(os.path.dirname(os.path.abspath(__file__)), name)
    modname = name.replace("-", "_")
    spec = importlib.util.spec_from_loader(
        modname, importlib.machinery.SourceFileLoader(modname, path))
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


TT = _sibling("wf-task-tag")

# THE RETIRED LEDGER'S PATH AS GIT SPELLS IT — forward slashes at every depth, on every
# host, because that is what an index entry holds. The filesystem path is this split by
# `/` and rejoined by `os.path.join`, never the other way round.
LEDGER_REL = ".claude/workforce/commitments.json"
# Where `_heal_regions` records the state it last refreshed against. See its docstring.
REGION_STAMP_REL = ".claude/workforce/.regions-refreshed"
# HOW MUCH OF `.git/index` IS READ to answer one question about one path. Entries are
# sorted by path bytes and `.claude/…` sorts ahead of almost everything a project carries,
# so the answer sits in the first handful of entries of any real repository; 1 MiB is some
# 15 000 of them. A read that stops before the answer says UNKNOWN, never "not tracked"
# (`_index_tracks`), so the cap can only cost a line nobody needed — never print a wrong one.
INDEX_READ_CAP = 1 << 20


def project_root(payload):
    """The project this hook fired for, as the harness names it, or None.

    `${CLAUDE_PROJECT_DIR}` first, the payload's `cwd` second, and NO `os.getcwd()`
    fallback: both sources are supplied by the harness and name the project this hook was
    fired for, while `os.getcwd()` names wherever a hand-run happens to be, and a heal that
    writes would then write into a project nobody named."""
    root = os.environ.get("CLAUDE_PROJECT_DIR") or payload.get("cwd")
    return root if root and str(root).strip() else None


def _open_nofollow(path, flags, mode=0o600):
    """`os.open` with `O_NOFOLLOW` added, so a planted symlink at `path` is refused.

    EVERY FILE THIS HOOK TOUCHES LIVES IN SOMEBODY'S REPOSITORY, at a path anyone who has
    seen one workforce project can predict, and the hook opens them unattended at every
    session start. A link left at a settings file, the region stamp or `.git/index` would
    otherwise hand this hook a file it was never given. The pattern is `wf-turn-budget`'s
    (3c7431c), shared with `wf-task-tag`, and is deliberately not a third design.

    IT IS THE OPEN THAT REFUSES, not a test before it. `os.path.islink(p)` followed by
    `open(p)` is two separate resolutions of the same name, and the link can be planted
    between them (CWE-59); the flag is checked by the kernel in the same call that opens.

    The flag is absent on some platforms; `getattr` keeps this importable there.
    """
    return os.open(path, flags | getattr(os, "O_NOFOLLOW", 0), mode)


def heal_settings(root):
    """Everything this project needs put right before its first request, in one carrier:
    the retired workforce hook ROWS, the retired pin guard's GIT hook, the machine-owned
    REGIONS a release moved on, and the retired commitments ledger.
    Returns the line(s) to show the user, or "" when there was nothing to do.

    WHY IT IS A HOOK. `SessionStart` fires once per session in every project, and this
    registration is in the default set, so the heal reaches a project the first time
    anybody opens it after the scripts land. No audit and no typed command: `update`
    replaces the files and `--wire-defaults` registers this hook in the same run. It rode
    `wf-commitments@sessionstart` until that hook was retired (2026-10-14), and the
    `update` that delivers this file is the one that prunes that row and wires this one;
    `bin/sync` does not wire, so a synced install runs `--wire-defaults` once. User
    directive, 2026-09-07: "the next use of workforce will heal the situation".
    MEASURED 2026-09-14: six projects on one workstation still carried 38 rows pointing
    at scripts retired in 1.31.0, failing on every prompt and tool call, because the
    only remover cleaned the one file its scope resolves and never a project's.

    WHAT IT REMOVES is only a row whose script the distribution retired (`RETIRED_HOOKS`)
    and whose install is present and whole. A live row, a missing shipped script, and any
    row the shared resolver does not recognise stay (`heal`'s docstring lists the rest).

    THE GIT HALF IS THE SAME ARGUMENT ONE LAYER DOWN. `wf-pin-check --install-hook` wired
    its guard in `git config` and in a directory inside the repository, not in a settings
    row, so retiring the script in 1.31.0 removed nothing from the four projects measured
    on 2026-10-10 that already had it — each still ran a frozen 48 KB copy on every commit.
    `heal_git_hooks` unwires it, and this hook is the carrier for the same reason.

    THE CLASSIFIER IS NOT HERE. Both halves are in `wf-settings-apply` (`heal`,
    `heal_git_hooks`), shared with `--wire-defaults` and `--heal`, so what a session
    removes and what `verify` removes cannot drift apart. This function only decides
    whether to ask.

    NEAR ZERO WHEN THERE IS NOTHING TO DO. The gate reads the raw settings text for a
    RETIRED script name, taken from `wf-settings-apply`'s own RETIRED_HOOKS by reading
    its source rather than executing it; only a hit, or a standing notice to clear,
    imports the classifier, and then exactly once. A project whose live workforce rows
    name only shipped hooks pays a directory listing and one small read (review 3, L8:
    the import ran twice on every workforce project and session start went from 33-41 ms
    to 89-98 ms; measured after the fix against HEAD, 21 runs each: 37 ms with no workforce
    row, 38 ms with live rows only, 79 ms on the one session that heals). The git half's
    gate is the same shape: one read of `.git/config`, and `hooksPath` absent from its text
    ends it with nothing imported and no subprocess run. The two halves added 2026-10-12
    hold to the same rule and each states its own gate: `_heal_regions` compares one
    stamp against two directory listings, `_retired_ledger` costs one `lstat` in a
    project that never had the file.
    NEVER RAISES: nothing here may fail the SessionStart hook (review 3, L1).
    """
    progress = {"wrote": []}
    try:
        if not root:
            return ""
        said = [x for x in (_heal_settings(root, progress),
                            _heal_git_hooks(root, progress),
                            _heal_regions(root, progress),
                            _retired_ledger(root, progress)) if x]
        return "\n".join(said)
    except Exception as exc:                             # noqa: BLE001 — see docstring
        # SILENT ONLY WHEN NOTHING WAS WRITTEN. An error after a write leaves the project
        # in a state the user has to be able to see, so it is said, never swallowed.
        if progress["wrote"]:
            return (f"HEAL INTERRUPTED  after writing {', '.join(progress['wrote'])}: "
                    f"{exc.__class__.__name__}: {exc}. Run /workforce verify.")
        return ""


_WSA = []


def _wsa():
    """wf-settings-apply, imported at most once per process."""
    if not _WSA:
        _WSA.append(_sibling("wf-settings-apply"))
    return _WSA[0]


# `wf-` right after `/` or `\` — a backslash in the file's text is the JSON escape `\\`,
# whose second character is the one matched here.
_SEP_WF = re.compile(r"(?:/|\\)wf-")


def _retired_names():
    """RETIRED_HOOKS read from wf-settings-apply's SOURCE — the one definition, without
    paying to execute it. None when it cannot be read, and then the caller imports."""
    try:
        with open(os.path.join(os.path.dirname(os.path.abspath(__file__)),
                               "wf-settings-apply"), encoding="utf-8") as fh:
            m = re.search(r"RETIRED_HOOKS = frozenset\(\{(.*?)\}\)", fh.read(), re.S)
    except (OSError, UnicodeDecodeError):
        return None
    names = set(re.findall(r'"(wf-[a-z0-9-]+)"', m.group(1))) if m else set()
    return names or None


def _heal_settings(root, progress):
    texts = {}
    try:
        names = [n for n in os.listdir(os.path.join(root, ".claude"))
                 if n.startswith("settings") and n.endswith(".json")]
    except OSError:
        names = []
    for n in names:
        # NOT THROUGH A LINK, like every other path under this project's `.claude`. A
        # settings file IS legitimately a link in some installs, which is why this one was
        # the last plain `open` here — but what the gate does with the text is decide
        # whether to run the classifier over this project's settings, so a link planted at
        # the name hands that decision a file the project never wrote. Refusing reads it as
        # "no workforce row", which is the same answer an unreadable settings file already
        # gets one line below.
        try:
            with os.fdopen(_open_nofollow(os.path.join(root, ".claude", n), os.O_RDONLY),
                           encoding="utf-8", errors="replace") as fh:
                texts[os.path.join(".claude", n)] = fh.read()
        except OSError:
            continue
    notice = os.path.join(root, ".claude", "workforce", ".heal-notice")
    # TWO CHEAP GATES before anything is imported: no `wf-` after a path separator in any
    # settings file means no workforce row at all; then the retired names themselves.
    # EITHER SEPARATOR. `hook_command` joins with os.path.join, so a Windows row reads
    # `…\\skills\\workforce\\bin\\wf-x` in the file's JSON text (each backslash escaped),
    # and a gate on `/wf-` alone never opened there (final review, F1).
    if not os.path.lexists(notice) and not any(_SEP_WF.search(x) for x in texts.values()):
        return ""
    retired = _retired_names()
    named = (re.compile(r"(?:/|\\)(?:" + "|".join(map(re.escape, sorted(retired))) + r")\b")
             if retired else None)

    def names_retired(text):
        return retired is None or bool(named.search(text))
    if not any(names_retired(x) for x in texts.values()) and not os.path.lexists(notice):
        return ""
    import contextlib
    import io
    wsa = _wsa()
    with contextlib.redirect_stdout(io.StringIO()), contextlib.redirect_stderr(io.StringIO()):
        res = wsa.heal(root, True, quiet=True, progress=progress)
    lines = []
    n = len(res.get("removed") or [])
    if n and not res.get("refused"):
        names = sorted({r.get("script", "") for r in res["removed"]})
        lines.append(f"HEALED  removed {n} workforce hook registration(s) from this "
                     f"project's settings whose scripts this distribution retired: "
                     f"{', '.join(names)}. A restart stops this session running the old "
                     f"rows.")
    # A FAILURE IS SAID ONCE PER FILE STATE (the notice), and an unreadable file that
    # names a retired hook is a failure too: it is why that row can never be removed.
    fails = list(res.get("failures") or [])
    skipped = [u for u in (res.get("unparsed") or []) if names_retired(texts.get(u["settings"], ""))]
    # A REFUSAL THAT LEAVES RETIRED ROWS IS SAID TOO (final review, F2): a settings file
    # linked out of the project, or a project whose record cannot be written, was
    # refused in silence at every session start, and its rows stayed forever.
    refused = list(res.get("refusals") or [])
    if fails or skipped or refused:
        if wsa.announce_once(root, fails + skipped + refused):
            if refused:
                lines.append("HEAL REFUSED  " + " ".join(f["cause"] for f in refused) + ".")
            if fails:
                lines.append("HEAL FAILED  " + " ".join(f["cause"] for f in fails))
            if skipped:
                lines.append("HEAL SKIPPED  " + " ".join(u["cause"] for u in skipped)
                             + "; it names a retired workforce hook that stays until the "
                               "file is plain JSON.")
            lines.append("Said once for this state of the file; run /workforce verify.")
    else:
        wsa.clear_notice(root)
    return "\n".join(lines)


def _heal_git_hooks(root, progress):
    """The git half: unwire the retired pin guard from this repository.

    ONE READ IS THE WHOLE GATE for a repository that sets no hooksPath, which is nearly
    every one: `hooksPath` absent from `.git/config`'s text ends it with nothing imported
    and no subprocess run. The KEY is tested here and the VALUE is tested in
    `wf-settings-apply` — the literal that decides the heal has one definition
    (`PIN_HOOKS_DIR_REL`), and restating it here to save an import on the few repositories
    that do set a hooksPath is the kind of second copy that drifts.

    A `.git` THAT IS A FILE (a linked worktree, a submodule) has its config somewhere only
    git can name, so the gate falls through to the classifier, which resolves it.
    """
    dot = os.path.join(root, ".git")
    try:
        if os.path.isdir(dot):
            with open(os.path.join(dot, "config"), encoding="utf-8", errors="replace") as fh:
                if "hooksPath" not in fh.read():
                    return ""
        elif not os.path.isfile(dot):
            return ""
    except OSError:
        return ""
    res = _wsa().heal_git_hooks(root, True, quiet=True, progress=progress)
    lines = list(res.get("lines") or [])
    # A FAILURE IS SAID EVERY SESSION, not once: while it lasts, the guard is still wired
    # and still running on every commit in this repository, so there is something to do
    # about it each time. The settings half announces once because a retired ROW costs the
    # user a failed hook invocation and nothing else.
    for f in res.get("failures") or []:
        lines.append(f"GIT HOOK NOT HEALED  {f}. Run /workforce verify.")
    return "\n".join(lines)


_WSC = []


def _wsc():
    """wf-companion, imported at most once per process — and only behind the stamp gate."""
    if not _WSC:
        _WSC.append(_sibling("wf-companion"))
    return _WSC[0]


def _stat_rows(d, names=None):
    """`(name, size, mtime_ns)` for each file in `d`, sorted; None when `d` cannot be
    listed. `names` restricts it to one file name per subdirectory instead.

    No file is READ here. The question is only whether either side of the refresh has
    moved since the last one, and a listing answers that for the price of the directory
    entries.
    """
    rows = []
    try:
        with os.scandir(d) as it:
            for e in sorted(it, key=lambda x: x.name):
                if names is None:
                    if e.is_file(follow_symlinks=False):
                        st = e.stat(follow_symlinks=False)
                        rows.append((e.name, st.st_size, st.st_mtime_ns))
                    continue
                for n in names:
                    try:
                        st = os.stat(os.path.join(d, e.name, n))
                    except OSError:
                        continue
                    rows.append((f"{e.name}/{n}", st.st_size, st.st_mtime_ns))
    except OSError:
        return None
    return rows


def _region_digest(root, wf):
    """The state `_heal_regions` last refreshed against, as one short line, or None when
    either side cannot be listed and no claim can be made.

    BOTH SIDES ARE IN IT. The SHIPPED side is every file in `references/` and
    `references/procedures/`, which is a superset of the three that carry a canonical span
    — naming only those three would restate `wf-companion`'s own CORE list here, and a
    second copy of that list is what drifts. The cost of the superset is that an unrelated
    reference file moving opens the gate once, and the refresh it opens reports CURRENT
    and writes the stamp again. The INSTALLED side is each `.claude/skills/*/SKILL.md`, so
    a hand-edit to a companion's region is seen too, not only a release.
    """
    import hashlib
    parts = []
    for d in (os.path.join(wf, "references"),
              os.path.join(wf, "references", "procedures")):
        rows = _stat_rows(d)
        if rows is None:
            return None
        parts.append(repr(rows))
    rows = _stat_rows(os.path.join(root, ".claude", "skills"), names=("SKILL.md",))
    if rows is None:
        return None
    parts.append(repr(rows))
    return hashlib.sha256("\n".join(parts).encode("utf-8")).hexdigest()


def _heal_regions(root, progress):
    """Refresh this project's machine-owned REGIONS to shipped source, at session start.

    THE DEFECT. A project's `/org` dispatch rungs are a byte-canonical region copied into
    its own SKILL.md (`procedures/org.md` § step 5), and the only producer that refreshes
    one is `wf-companion --execute`, which only `audit` Step 4 runs. New hooks reach a
    project on `update` through `--wire-defaults`; a changed rung reached nobody until
    somebody audited. So a release could ship a dispatch rule and every existing org kept
    dispatching on the old ladder, silently. The user, 2026-10-12: "I don't have to run an
    audit after this update, correct?" — and until this, the honest answer was that they
    did.

    THE DECISION IS `wf-companion`'s, NOT A SECOND ONE. `refresh_drifted` is the refresh
    half of `--execute` with the same `evaluate`, the same write and the same read-back, so
    only a DRIFTED region is replaced, only between its markers, and a customized Core
    skill is never overwritten (`audit-setup.md` Step 0.3 state 3). What this function
    decides is whether to ask at all.

    NEAR ZERO WHEN THERE IS NOTHING TO DO, which is the gate's whole design: two directory
    listings and one small read, with nothing imported. `.claude/workforce/.regions-refreshed`
    holds the digest of what either side could change (`_region_digest`); equal means
    nothing has moved since the last refresh and it ends there. The settings half's own
    measurement is the standard it is held to — 37 ms with nothing to do against 79 ms on
    the one session that heals (`heal_settings`, review 3, L8).

    A PROJECT WITH NO COMPANIONS IS NOT ONE TO BUILD THEM IN. No `.claude/skills` means no
    region to refresh and no stamp written: materializing an absent companion is `audit`
    Step 4's job, with a report somebody is reading, and `refresh_drifted` leaves ABSENT
    alone for the same reason.
    """
    wf = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    if not os.path.isdir(os.path.join(root, ".claude", "skills")):
        return ""
    want = _region_digest(root, wf)
    stamp = os.path.join(root, *REGION_STAMP_REL.split("/"))
    if want is not None:
        # NOT THROUGH A LINK. The stamp sits in `.claude/workforce/` in a shared
        # checkout, and a link planted at its name hands this gate a file somebody else
        # chose — which decides whether the refresh below runs at all.
        try:
            with os.fdopen(_open_nofollow(stamp, os.O_RDONLY), encoding="utf-8") as fh:
                if fh.read().strip() == want:
                    return ""
        except OSError:
            pass
    refreshed, failures = _wsc().refresh_drifted(root, wf)
    progress["wrote"] += [f".claude/skills/{n}/SKILL.md" for n, _d in refreshed]
    lines = []
    if refreshed:
        lines.append("REFRESHED  this project's machine-owned region(s) now match the "
                     "installed release: "
                     + "; ".join(f"{n} ({d})" for n, d in refreshed) + ". Only the span "
                     "between the markers was replaced; everything around it is "
                     "byte-for-byte as it was. A restart loads the new text.")
    for f in failures:
        lines.append(f"REGION NOT REFRESHED  {f}. Run /workforce audit.")
    # THE STAMP IS WRITTEN ONLY WHEN THE ANSWER WOULD BE THE SAME NEXT TIME. A failure
    # leaves it alone, so the next session start tries again instead of recording a
    # refresh that did not happen. It is NOT written when the digest could not be taken,
    # for the same reason.
    # IT GOES THROUGH THE PRODUCER'S OWN WRITER, which is already imported on this path:
    # `write` refuses a target that resolves outside the project and renames over a
    # link's target rather than over the link (SKILL.md Atomic-or-Absent rule 3). A plain
    # `open(stamp, "w")` would follow a symlink somebody left in `.claude/workforce/` and
    # put these bytes wherever it pointed, in a hook that runs unattended at session start.
    if want is not None and not failures:
        try:
            os.makedirs(os.path.dirname(stamp), exist_ok=True)
            _wsc().write(root, stamp, want + "\n")
        except (OSError, ValueError):
            pass
    return "\n".join(lines)


def _git_varint(buf, pos):
    """git's offset-encoded varint at `pos` — `(value, next_pos)`, or `(None, pos)` when
    the buffer ends inside it.

    NOT LEB128, and the difference is one addition. git's own `decode_varint` adds one to
    the accumulator before each shift, so every value has exactly one spelling; reading it
    as LEB128 gives a number that is too small by a growing amount, which in a version-4
    index means a path built from the wrong prefix. Index version 4 is the only reader of
    this encoding here.

    TEN BYTES AND NO MORE, WHICH IS A RESOURCE GUARD RATHER THAN A FORMAT DETAIL. These
    bytes come out of somebody's repository and this runs at session start. Unbounded, the
    accumulator grows seven bits per continuation byte while each shift costs the whole
    integer — quadratic. MEASURED 2026-10-12 on the unbounded version: 65 536 continuation
    bytes took 1.70 s and 262 144 took 28.1 s, so one crafted `.git/index` inside the read
    cap could have held a session open for minutes in every project. Ten bytes carries
    every value a 64-bit git can write (`ceil(64/7)`); an eleventh is not a number this
    reader will produce, it is UNKNOWN, which prints nothing.
    """
    val, first = 0, True
    for _ in range(10):
        if pos >= len(buf):
            return None, pos
        c = buf[pos]
        pos += 1
        val = (c & 0x7F) if first else (((val + 1) << 7) | (c & 0x7F))
        first = False
        if not c & 0x80:
            return val, pos
    return None, pos


def _index_scan(idx, version, hashlen, target):
    """True when `target` is an entry in these index bytes, False when it provably is not,
    None when they do not parse as a version-`version` index of `hashlen`-byte ids.

    THE FORMAT, as `Documentation/gitformat-index.txt` states it. Each entry is 40 bytes
    of stat data, the object id, then 2 bytes of flags whose low 12 bits hold the path
    length (`0xFFF` meaning "longer than that, find the NUL") and whose `0x4000` bit adds
    two more flag bytes in version 3 and up. In versions 2 and 3 the path is NUL-padded so
    the entry length is a multiple of eight; in version 4 there is no padding and the path
    is prefix-compressed — a varint saying how many bytes to strip from the PREVIOUS path,
    then the suffix — which is why this walks every entry in order instead of seeking.

    IT VALIDATES AS IT GOES, and that is what makes the hash length safe to infer: a
    declared path length that disagrees with the NUL, a pad byte that is not a NUL, or a
    read past the end all return None. Parsing a 32-byte-id index as if the ids were 20
    bytes reads the flags out of the middle of an object id, so it fails one of those
    within the first entry rather than answering confidently about the wrong bytes.

    THE FIRST NAME PAST THE TARGET SETTLES IT. Entries are sorted by path bytes, which is
    Python's own order for `bytes`, so a project with 300 000 files costs the same handful
    of entries as a project with ten — `.claude/…` sorts ahead of almost every name a
    repository carries. If an index somehow were not sorted the early exit would answer
    "not tracked", which is a line not printed rather than a wrong line printed.
    """
    n = len(idx)
    pos, prev = 12, b""
    for _ in range(int.from_bytes(idx[8:12], "big")):
        base = pos + 40 + hashlen + 2
        if base > n:
            return None
        flags = int.from_bytes(idx[base - 2:base], "big")
        if flags & 0x4000:
            if version < 3:
                return None
            base += 2
        if version >= 4:
            strip, base = _git_varint(idx, base)
            if strip is None or strip > len(prev):
                return None
        end = idx.find(b"\0", base)
        if end < 0:
            return None
        name = idx[base:end] if version < 4 else prev[:len(prev) - strip] + idx[base:end]
        namelen = flags & 0xFFF
        if namelen != 0xFFF and len(name) != namelen:
            return None
        if version < 4:
            nxt = pos + (((base - pos) + len(name) + 8) & ~7)
            if nxt <= end or nxt > n or any(idx[end:nxt]):
                return None
        else:
            nxt = end + 1
        if name == target:
            return True
        if name > target:
            return False
        prev, pos = name, nxt
    return False


def _index_tracks(idx, target):
    """Is `target` an entry in `.git/index`? True, False, or None for "these bytes do not
    say" — and None is answered by printing nothing, never by guessing either way.

    THE HASH LENGTH IS NOT IN THE HEADER. A repository created with
    `--object-format=sha256` writes the same version number with 32-byte ids, so the only
    honest way to read the entries is to try a length and require the result to validate
    (`_index_scan`). A version this cannot read — 1, or a 5 that does not exist yet — is
    UNKNOWN rather than parsed as the nearest one it knows.
    """
    if len(idx) < 12 or idx[:4] != b"DIRC":
        return None
    version = int.from_bytes(idx[4:8], "big")
    if version not in (2, 3, 4):
        return None
    for hashlen in (20, 32):
        answer = _index_scan(idx, version, hashlen, target)
        if answer is not None:
            return answer
    return None


def _retired_ledger(root, progress):
    """Remove the retired commitments ledger from this project. The line to show, or "".

    THE LIST IS RETIRED (user, 2026-10-14: "Retire it, fold in"), so nothing writes or reads
    `.claude/workforce/commitments.json` any more and a copy left behind is dead state that
    holds the operator's own sentences. MEASURED 2026-10-12: it is git-TRACKED in
    nsayka-wawa and odyssey-alive (`git ls-files`), and on 2026-10-10 a local edit to the
    copy on nsayka-wawa's live server would have made `git pull --ff-only` conflict. The
    user, 2026-10-14: the next session removes it, with no manual command and no audit.

    ONLY A FILE THAT IS THE LEDGER. A regular file this account owns that parses as the
    shape `wf-commitments` wrote: an object holding an `open` list, with no key but `open`
    and `closed` (a session added `closed` by hand in nsayka-wawa). `TT.read_json_nofollow`
    refuses a link at the name and a file somebody else owns. Anything else at that name is
    not ours to delete and is left alone, silently. A `.claude/workforce` that is itself a
    link is refused too, which is `wf-task-tag.issues_dir`'s rule: every path under it then
    belongs to a tree this project did not name.

    THE WORKING-TREE FILE IS REMOVED AND GIT IS NEVER RUN, and the second half is a
    security property. MEASURED 2026-10-12, git 2.55.0: with `core.fsmonitor` set to a
    command in a repository's LOCAL config, `git ls-files --error-unmatch -- <path>` ran
    that command, and `git rm --cached` refreshes the index the same way. This hook fires at
    the start of every session in every project with nobody watching, so running git here
    would run whatever a prepared repository's config names. A tracked file's deletion
    therefore shows in `git status` for the project's author to commit with their own next
    commit: this hook stages nothing and commits nothing. Whether to say so is decided by
    reading `.git/index` (`_index_tracks`), one file, nothing in it executed or echoed.

    A `.git` THAT IS A FILE (a linked worktree, a submodule) keeps its index somewhere only
    git can name, and following a path out of a file inside the repository is the thing
    reading the index instead of running git exists to avoid. There the file is still
    removed and the tracked line is not said.

    sec-eval: the shape check and the unlink are two resolutions of one name (CWE-367).
    Swapping the file in between needs write access to `.claude/workforce`, which already
    lets the writer delete it; `unlink` removes a link rather than its target.
    """
    p = os.path.join(root, *LEDGER_REL.split("/"))
    if not os.path.lexists(p) or os.path.islink(os.path.dirname(p)):
        return ""
    book = TT.read_json_nofollow(p)
    if (not isinstance(book, dict) or not isinstance(book.get("open"), list)
            or not set(book) <= {"open", "closed"}):
        return ""
    try:
        os.unlink(p)
    except OSError:
        return ""
    progress["wrote"].append(LEDGER_REL)
    if not os.path.isdir(os.path.join(root, ".git")):
        return ""
    try:
        with os.fdopen(_open_nofollow(os.path.join(root, ".git", "index"),
                                      os.O_RDONLY), "rb") as fh:
            idx = fh.read(INDEX_READ_CAP)
    except OSError:
        return ""
    if _index_tracks(idx, LEDGER_REL.encode("utf-8")) is not True:
        return ""
    return (f"RETIRED  removed {LEDGER_REL}, the old list of what turns said they would "
            f"do; ISSUES now shows those as `noted` lines. Git tracks this file, so its "
            f"deletion is in `git status` for your next commit. This hook stages nothing "
            f"and commits nothing.")


def main():
    raw = sys.stdin.read()
    try:
        payload = json.loads(raw) if raw.strip() else {}
    except json.JSONDecodeError:
        return 0
    # SessionStart only, by the same test the hook always used: a payload from any other
    # event is not a session start, and the heal is not a per-turn cost.
    if (payload.get("hook_event_name") != "SessionStart"
            and payload.get("source") not in ("startup", "resume", "clear", "fork")):
        return 0
    healed = heal_settings(project_root(payload))
    if healed:
        print(json.dumps({"systemMessage": healed}))
    return 0


if __name__ == "__main__":
    sys.exit(main())
