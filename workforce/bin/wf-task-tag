#!/usr/bin/env python3
"""wf-task-tag — classify the ask BEFORE the work, and name the sense that closes it.

WHY THIS EXISTS, and it is the half `wf-widen` could not do.

`wf-widen` reads the finished reply and infers a claim from prose. That is reactive and
it is a guess about what the turn was doing, made from the turn's own words — which is
the same surface the tunnel is built out of. It catches a reply that asserts something
is missing. It cannot catch a reply that reasons its way to a wrong answer without ever
asserting anything of that shape.

THE MEASURED MISS, this session. Asked to decide the fate of four scripts that live
procedures still called for, the operator read `audit-setup.md` and `invariants.md`,
saw live requirements, and concluded the scripts had to be restored. Wrong: the removal
was deliberate, on the user's explicit marks, and the record that says so had not been
read. No absence claim was made and no universal claim was made, so `wf-widen` was
silent and correct to be silent. **The TASK, though, was "decide the fate of a removed
mechanism," and that task cannot be closed without HEARING — the record's own
testimony.** A tag on the ask would have said so before a word of the answer was
written. A scan of the answer could not.

SO THE TAG IS SET AT THE FRONT. `UserPromptSubmit` fires before the prompt is
processed and can inject context, which is the only point in a turn where "which sense
does this need" arrives in time to change what the turn does rather than grade it after.

IT IS DETERMINISTIC, NOT A MODEL CALL. Every classification below is a regex over the
ask. That is the input-side discipline the rest of this distribution's newer mechanisms
follow, and it costs no tokens and no latency: a classifier that spends a model call on
every prompt to say "this one needs the web" has to be right very often to be worth it,
and nothing here has measured that it would be.

IT NAMES, IT NEVER BLOCKS. `decision: "block"` on this event erases the user's prompt.
Nothing about a sense classification justifies destroying an ask, and a tagger that can
swallow a prompt on a regex is a worse failure than every tunnel it prevents.

THE TAG IS ALSO WRITTEN TO DISK, so `wf-widen` at `Stop` scores against the tag the ask
carried rather than re-guessing from the reply. One classification, set once, read by
both ends of the turn.

EXIT CODES: 0 always. An unclassifiable ask is the common case and produces silence.
"""

import json
import os
import re
import sys

# ─────────────────────────────────────────────────────────────────────────────────
# TASK KINDS. Each row is (name, pattern, sense, why that sense and not another).
#
# These are the kinds whose WRONG ANSWER this project has actually produced and paid
# for. It is not a taxonomy of asks; it is a list of the ways work here has gone wrong,
# and it stays that length until another way is measured.
# TEXT THE USER DID NOT WRITE. `UserPromptSubmit` receives whatever is injected ahead of
# the turn — a skill's preamble, a continuation summary, a cross-session message, a stop
# hook's own feedback — and none of it is the ask.
#
# MEASURED 2026-09-10 over 1,909 real user prompts from this machine's transcripts:
# 586 (30.7%) are injected preamble, and 469 of them — 24.6% OF THE WHOLE CORPUS — are
# currently tagged. Tagged as: behaviour 344, existence 320, history 280, world 43. Every
# one puts a docket on a turn whose prompt the user never wrote, and the jury then judges
# the reply against a question nobody asked. A stop hook's own feedback tagging the next
# turn is the loop closing on itself.
#
# ANCHORED AT THE START, deliberately. A user who QUOTES one of these mid-message is still
# asking something, and their ask keeps its docket.
# IS THE USER ASKING, OR TELLING? Only `world` is gated on this, and the asymmetry is
# measured rather than tidy. An IMPERATIVE is exactly when `behaviour` matters most —
# "run the baseline test now" needs touch — so gating every kind on a question mark would
# suppress the sense at the moment it is most needed; 34.9% of `behaviour` fires carry no
# question and they are correct. `world` is the opposite: it asks whether the OUTSIDE
# WORLD is a certain way, and a user who states it is not asking, they are telling.
#
# MEASURED over 1,909 real prompts, after the INJECTED filter: `world` fires 13 times, 7
# ask something and 6 do not. The 6 are two error dumps and four instructions — including
# the one that produced this fix, *"those are deprecated and any vestiges should be
# completely removed"*, which sent a turn to look up a fact the user had just supplied and
# then blocked the reply for not looking it up. The 7 kept are genuine: "aren't those
# deprecated?", "wouldn't vendor be deprecated?", "weren't we deprecating verify?".
ASKING = re.compile(
    r"\?"
    r"|^\s*(?:is|are|was|were|does|do|did|can|could|should|would|has|have"
    r"|what|which|why|when|who|where|how)\b"
    r"|\b(?:check whether|find out|look up|verify (?:whether|if)|do you know"
    r"|not sure|i think|might be|i wonder)\b", re.I)

INJECTED = re.compile(
    r"^\s*(?:Base directory for this skill"
    r"|Caveat:"
    r"|This session is being continued"
    r"|Another Claude session sent a message"
    r"|Stop hook feedback"
    r"|\d+ background agents? (?:was|were) stopped"
    r"|<[a-z-]+-message\b)", re.I)

KINDS = [
    ("history", re.compile(
        r"\b(why (?:was|were|did|is it)|when (?:was|were|did)|who (?:removed|changed|added)"
        r"|what happened to|deliberate|on purpose|intentional"
        r"|(?:should|do) (?:we|i|you) (?:restore|bring back|re-?add|revert))\b", re.I),
     "hearing",
     "the record is testimony and it is the only thing that knows INTENT. A tree shows "
     "what is there; only the record says whether its absence was a decision"),

    # `latest` ALONE WAS 46 OF THIS KIND'S 60 FIRES and almost all of them were wrong:
    # "pull down the latest master", "audit the latest article", "prepare the latest
    # release". It is an ordinary English word in an instruction, not a question about the
    # world. MEASURED over 1,909 real prompts, narrowing it to a lookup context takes this
    # kind from 60 fires to 13, drops 48, and loses no prompt that actually needed an
    # outside source. One residual false positive remains in the 13 and is named rather
    # than tuned away, the way 1.38.0 named what its trigger could not do.
    ("world", re.compile(
        r"\b(deprecat\w*"
        r"|(?:the )?(?:latest|newest|current) (?:version|release|stable|api|docs?|spec)"
        r"|current(?:ly)? (?:supported|recommended)|still (?:supported|a thing|maintained)"
        r"|best practice|state of the art|does .{0,20}still exist"
        r"|has .{0,20}changed|up to date"
        r"|what(?:'s| is) (?:the )?(?:latest|current|new))\b", re.I),
     "hearing",
     "this repository cannot know the world. Reading local documents to answer it is "
     "how `vendor` was called a live command from docs that had gone stale"),

    ("behaviour", re.compile(
        r"\b(does (?:it|this|that) (?:still |even |actually |really )*(?:work|run|fire|pass)"
        r"|why (?:does|is) .{0,30}(?:fail|break|error)"
        r"|is (?:it|this) working|what does .{0,30}(?:do|return|emit|print)"
        r"|test|verify|prove|reproduce)\b", re.I),
     "touch",
     "prose says what a script does; running it says what it did. Four scripts here were "
     "described in working detail by live procedures and existed nowhere"),

    # THE KIND THAT WAS MISSING, and it is the one the tunnels formed in. The other four
    # ask about FACTS — what the record says, what the world says, what a script does,
    # what is in a set. A design ask proposes something, and a proposal you authored
    # cannot be judged from inside: `senses.md` measures NINE OF TEN escapes from a
    # settled wrong reading arriving from OUTSIDE the turn that formed it, and zero from
    # noticing. So the sense is hearing — the record (has this been tried, what was
    # decided before) or a reader who did not write the thing.
    #
    # MEASURED THE SAME DAY IT SHIPPED, on this session's own ten asks: two carried a
    # docket. The three that did not — "why not install them where workforce is
    # installed", "should we audit workforce itself", "how close is wf-live to the
    # intuition juror" — are exactly where the readings formed that an independent
    # evaluator later broke in one move. The jury was structurally unreachable on every
    # one of them, so the gate was working and the docket was empty.
    #
    # 2.5% of 1,323 real non-injected prompts, against 1.5% and 0.5% for the two reply
    # triggers that shipped. `should be` UNHEDGED was measured and REJECTED: it doubled
    # the rate to 3.5% by catching plain instructions — "that should be in the email",
    # "no mobile and api-only items should be there". A hedge is what separates a
    # proposal from an order.
    ("judgment", re.compile(
        r"\bshould (?:we|i|you)\b"
        r"|\bwhy (?:not|don'?t we|wouldn'?t we|shouldn'?t we)\b"
        r"|\b(?:what|how) (?:do|would) you think\b|\bdo you think\b"
        r"|\byour thoughts\b|\bthoughts\?"
        r"|\bis (?:that|this) a good idea\b|\bgood idea\?"
        r"|\bdoes (?:that|this) make sense\b"
        r"|\bwould it be (?:better|worth|wise)\b"
        r"|\bi wonder (?:if|whether)\b"
        r"|\b(?:best|right|proper) (?:way|approach|shape|design)\b"
        r"|\bhow (?:would|should) (?:you|we|i)\b"
        r"|\bwouldn'?t it\b|\bcouldn'?t we\b"
        r"|\b(?:perhaps|maybe|i think|i feel like|it feels like|i'?d say)\b"
        r"[^.\n]{0,60}\bshould\b", re.I),
     "hearing",
     "a proposal you authored cannot be judged from inside — the measurement is nine of "
     "ten escapes from a settled wrong reading arriving from outside the turn that formed "
     "it, and none from noticing. Consult the record for what was already decided, or a "
     "reader who did not write it"),

    ("existence", re.compile(
        r"\b(is there (?:a|an|any)|are there|do we have|does .{0,25} exist|what(?:'s| is) in"
        r"|how many|list (?:the|all|every)|which (?:ones|files|scripts|commands)"
        r"|any (?:other|more)|anywhere else)\b", re.I),
     "taste",
     "a claim about a SET is closed by enumerating the set. Point reads sample it, and a "
     "sample cannot show what is absent"),
]

SENSE_HOW = {
    "hearing": "read the record that decided it (`git log`, `workforce/changes/`), or ask "
               "a source outside this turn's own reasoning",
    "touch": "run it and read what came back, rather than reading a description of it",
    "taste": "enumerate the set — Glob, find, ls, grep -l — before saying what is in it "
             "or missing from it",
    "sight": "read the file itself",
}


# Explicit enumeration only, and that restraint is the design. Segmenting free-flowing
# natural language into distinct requests is a judgment task, and a regex that guessed at
# it would report `asks: 3` on one long sentence and `asks: 1` on three short ones — a
# number that is wrong in both directions is worse than no number, because the reply gets
# sectioned against it. So this fires on the shapes a user uses when they MEAN to
# enumerate, and returns 1 otherwise.
#
# WHY IT EXISTS. `classify` already returns an array, deliberately — an ask can be two
# KINDS at once. But the flag carries `ask.prompt` as ONE string, so nothing anywhere
# counted how many THINGS were asked. MEASURED 2026-09-11: a user sent three numbered
# issues in one message, got one smeared answer, and had to say so — "if I'm confusing
# you and causing you to mix up the different issues, let me know that too." The
# dissection was real and ran along the wrong axis.
ENUM_PATTERNS = (
    # "there's three things", "two issues", "3 questions"
    re.compile(r"\b(two|three|four|five|\d+)\s+(things?|issues?|questions?|parts?|items?|points?)\b", re.I),
    # "number two", "second thing", "and third"
    re.compile(r"\b(number\s+(two|three|four|2|3|4)|second(ly)?\b|third(ly)?\b)", re.I),
    # a numbered or bulleted list on its own lines
    re.compile(r"^\s{0,3}(\d+[.)]|[-*])\s+\S", re.M),
)

# The count itself, when the user states it. "three things" is a better answer than any
# inference, so it is read literally and preferred over every other signal.
WORD_NUM = {"two": 2, "three": 3, "four": 4, "five": 5}
STATED_COUNT = re.compile(
    r"\b(two|three|four|five|\d+)\s+(?:things?|issues?|questions?|parts?|items?|points?)\b", re.I)


def count_asks(prompt):
    """How many DISTINCT requests this prompt makes, when it says so. 1 otherwise.

    Returns (n, how) — `how` names the evidence, because a bare number gives a reader
    nothing to check and this one drives how a reply is shaped.
    """
    text = prompt or ""
    if INJECTED.search(text):
        return (1, "injected preamble — not the user's ask")

    m = STATED_COUNT.search(text)
    if m:
        raw = m.group(1).lower()
        n = WORD_NUM.get(raw)
        if n is None:
            try:
                n = int(raw)
            except ValueError:
                n = None
        # A stated count is authority, but not an unbounded one: "a hundred things" is
        # exasperation, not a docket.
        if n and 2 <= n <= 9:
            return (n, f"the user stated it: {m.group(0)!r}")

    listed = len(ENUM_PATTERNS[2].findall(text))
    if listed >= 2:
        return (listed, f"{listed} enumerated lines")

    if ENUM_PATTERNS[1].search(text):
        return (2, "ordinal marker present; count not stated, so this is a FLOOR")

    return (1, "no explicit enumeration")


def classify(prompt):
    """Every kind the ask matches, in the order the list declares them.

    NOT first-match. An ask can be two kinds at once — "why was this removed and does it
    still work" is history AND behaviour — and answering it needs both channels. Taking
    only the first would name one and silently drop the other, which is the narrowing
    this whole mechanism exists against.
    """
    # The ask is what the USER typed. Injected preamble is not it, and tagging it puts a
    # docket on a turn whose prompt nobody wrote (see INJECTED, measured).
    if INJECTED.search(prompt or ""):
        return []

    hits = []
    for name, pat, sense, why in KINDS:
        if pat.search(prompt or ""):
            # `world` only: a statement about the world is not a question about it.
            if name == "world" and not ASKING.search(prompt or ""):
                continue
            hits.append({"kind": name, "sense": sense, "why": why})
    return hits


def tag_path(payload):
    """Where the tag waits for `Stop`. Session-scoped, so two sessions never cross."""
    d = payload.get("scratchpad_dir") or os.environ.get("TMPDIR") or "/tmp"
    sid = (payload.get("session_id") or "nosession")[:64]
    return os.path.join(d, f"wf-task-tag.{sid}.json")


def main():
    raw = sys.stdin.read()
    try:
        payload = json.loads(raw) if raw.strip() else {}
    except json.JSONDecodeError:
        return 0

    # CLEAR LAST TURN'S WIDEN FLAG FIRST, and do it before anything can return early.
    # The flag tells the widening agent to go open a sense; one left behind would send
    # a reader after a question the user has already moved past, and would do it on a
    # turn that raised no flag of its own — a widening nobody asked for, charged to
    # somebody's token budget. This event is the head of every turn, so it is the one
    # place a per-turn artifact can be guaranteed cleared.
    try:
        d = payload.get("scratchpad_dir") or os.environ.get("TMPDIR") or "/tmp"
        sid = (payload.get("session_id") or "nosession")[:64]
        os.remove(os.path.join(d, f"wf-widen-flag.{sid}.json"))
    except OSError:
        pass

    hits = classify(payload.get("prompt") or "")
    if not hits:
        # AN UNTAGGED TURN MUST NOT INHERIT THE LAST ONE'S TAG. Returning here without
        # clearing left the previous turn's tag file on disk, and `wf-widen` read it at
        # `Stop` as though it belonged to this turn.
        #
        # MEASURED 2026-09-09, on a message with no technical content at all — "tunnel
        # vision is never fun and it shouldn't be for you". It matched none of the four
        # kinds, inherited `behaviour` from the turn before, and was blocked for not
        # running a shell command to close a remark about tunnel vision. A guard that
        # fires on a turn carrying no claim is the 7.0% noise that retired
        # `wf-speak-guard`, arriving by a different route: not a bad detector, but a
        # correct detector reading last turn's input.
        # WRITE AN EMPTY TAG, NEVER DELETE. Removing the file solved the stale-tag bug
        # and created a worse one: `Stop` then has no record that this turn happened at
        # all, and no `prompt` — so an untagged turn can never be audited, because the
        # jury correctly refuses a case with no ask. A fresh, explicitly-empty tag fixes
        # the staleness just as well (it IS this turn's) and keeps the ask on disk for
        # the blind sample in `wf-widen` (§ THE BLIND SAMPLE).
        try:
            with open(tag_path(payload), "w", encoding="utf-8") as fh:
                _n, _how = count_asks(payload.get("prompt") or "")
                json.dump({"hits": [], "prompt": (payload.get("prompt") or "")[:2000],
                           "senses": [], "asks": _n, "asks_why": _how}, fh)
        except OSError:
            pass
        return 0

    try:
        with open(tag_path(payload), "w", encoding="utf-8") as fh:
            json.dump({"hits": hits,
                       # THE ASK ITSELF, carried forward because `Stop` never gets it.
                       # The Stop payload has no `prompt` field, so the judge was
                       # comparing evidence to conclusion with NO IDEA what was asked —
                       # the measure-results directive implemented with the request
                       # missing. This event is the only one that sees it.
                       "prompt": (payload.get("prompt") or "")[:2000],
                       # THE JURY DOCKET: which senses sit on this ask.
                       "senses": sorted({h["sense"] for h in hits}),
                       # HOW MANY THINGS WERE ASKED, and the evidence for the number.
                       # A reply to a multi-ask prompt carries a heading per ask; one
                       # blended answer to three questions is how a reader loses track
                       # of which were addressed, and re-reading it later is worse.
                       "asks": count_asks(payload.get("prompt") or "")[0],
                       "asks_why": count_asks(payload.get("prompt") or "")[1]}, fh)
    except OSError:
        pass        # the injection below still lands; the Stop half degrades quietly

    # STATED AS FACTS ABOUT THE ASK, NEVER AS AN INSTRUCTION. The hooks reference is
    # explicit that text framed as an out-of-band command trips the prompt-injection
    # defences and gets surfaced to the user instead of read — which would turn a tag
    # into one more thing a human has to deal with.
    lines = ["This ask is of a kind whose wrong answers are on record in this project."]
    for h in hits:
        lines.append(f"  · {h['kind']} — closed by {h['sense'].upper()}: {h['why']}. "
                     f"In practice: {SENSE_HOW[h['sense']]}.")
    lines.append("Senses are described at `references/senses.md`.")

    print(json.dumps({"hookSpecificOutput": {
        "hookEventName": "UserPromptSubmit",
        "additionalContext": "\n".join(lines),
    }}))
    return 0


if __name__ == "__main__":
    sys.exit(main())
