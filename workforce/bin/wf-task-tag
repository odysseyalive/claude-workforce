#!/usr/bin/env python3
"""wf-task-tag — classify the ask BEFORE the work, and name the sense that closes it.

WHY THIS EXISTS, and it is the half `wf-widen` could not do.

`wf-widen` reads the finished reply and infers a claim from prose. That is reactive and
it is a guess about what the turn was doing, made from the turn's own words — which is
the same surface the tunnel is built out of. It catches a reply that asserts something
is missing. It cannot catch a reply that reasons its way to a wrong answer without ever
asserting anything of that shape.

THE MEASURED MISS, this session. Asked to decide the fate of four scripts that live
procedures still called for, the operator read `audit-setup.md` and `invariants.md`,
saw live requirements, and concluded the scripts had to be restored. Wrong: the removal
was deliberate, on the user's explicit marks, and the record that says so had not been
read. No absence claim was made and no universal claim was made, so `wf-widen` was
silent and correct to be silent. **The TASK, though, was "decide the fate of a removed
mechanism," and that task cannot be closed without HEARING — the record's own
testimony.** A tag on the ask would have said so before a word of the answer was
written. A scan of the answer could not.

SO THE TAG IS SET AT THE FRONT. `UserPromptSubmit` fires before the prompt is
processed and can inject context, which is the only point in a turn where "which sense
does this need" arrives in time to change what the turn does rather than grade it after.

IT IS DETERMINISTIC, NOT A MODEL CALL. Every classification below is a regex over the
ask. That is the input-side discipline the rest of this distribution's newer mechanisms
follow, and it costs no tokens and no latency: a classifier that spends a model call on
every prompt to say "this one needs the web" has to be right very often to be worth it,
and nothing here has measured that it would be.

IT NAMES, IT NEVER BLOCKS. `decision: "block"` on this event erases the user's prompt.
Nothing about a sense classification justifies destroying an ask, and a tagger that can
swallow a prompt on a regex is a worse failure than every tunnel it prevents.

THE TAG IS ALSO WRITTEN TO DISK, so `wf-widen` at `Stop` scores against the tag the ask
carried rather than re-guessing from the reply. One classification, set once, read by
both ends of the turn.

EXIT CODES: 0 always. An unclassifiable ask is the common case and produces silence.
"""

import hashlib
import json
import os
import re
import sys

# ─────────────────────────────────────────────────────────────────────────────────
# TASK KINDS. Each row is (name, pattern, sense, why that sense and not another).
#
# These are the kinds whose WRONG ANSWER this project has actually produced and paid
# for. It is not a taxonomy of asks; it is a list of the ways work here has gone wrong,
# and it stays that length until another way is measured.
# TEXT THE USER DID NOT WRITE. `UserPromptSubmit` receives whatever is injected ahead of
# the turn — a skill's preamble, a continuation summary, a cross-session message, a stop
# hook's own feedback — and none of it is the ask.
#
# MEASURED 2026-09-10 over 1,909 real user prompts from this machine's transcripts:
# 586 (30.7%) are injected preamble, and 469 of them — 24.6% OF THE WHOLE CORPUS — are
# currently tagged. Tagged as: behaviour 344, existence 320, history 280, world 43. Every
# one puts a docket on a turn whose prompt the user never wrote, and the jury then judges
# the reply against a question nobody asked. A stop hook's own feedback tagging the next
# turn is the loop closing on itself.
#
# ANCHORED AT THE START, deliberately. A user who QUOTES one of these mid-message is still
# asking something, and their ask keeps its docket.
# IS THE USER ASKING, OR TELLING? Only `world` is gated on this, and the asymmetry is
# measured rather than tidy. An IMPERATIVE is exactly when `behaviour` matters most —
# "run the baseline test now" needs touch — so gating every kind on a question mark would
# suppress the sense at the moment it is most needed; 34.9% of `behaviour` fires carry no
# question and they are correct. `world` is the opposite: it asks whether the OUTSIDE
# WORLD is a certain way, and a user who states it is not asking, they are telling.
#
# MEASURED over 1,909 real prompts, after the INJECTED filter: `world` fires 13 times, 7
# ask something and 6 do not. The 6 are two error dumps and four instructions — including
# the one that produced this fix, *"those are deprecated and any vestiges should be
# completely removed"*, which sent a turn to look up a fact the user had just supplied and
# then blocked the reply for not looking it up. The 7 kept are genuine: "aren't those
# deprecated?", "wouldn't vendor be deprecated?", "weren't we deprecating verify?".
ASKING = re.compile(
    r"\?"
    r"|^\s*(?:is|are|was|were|does|do|did|can|could|should|would|has|have"
    r"|what|which|why|when|who|where|how)\b"
    r"|\b(?:check whether|find out|look up|verify (?:whether|if)|do you know"
    r"|not sure|i think|might be|i wonder)\b", re.I)

INJECTED = re.compile(
    r"^\s*(?:Base directory for this skill"
    r"|Caveat:"
    r"|This session is being continued"
    r"|Another Claude session sent a message"
    r"|Stop hook feedback"
    r"|\d+ background agents? (?:was|were) stopped"
    # A background task finishing arrives as a user row wrapped in these. MEASURED
    # 2026-09-13: the first live asks checklist opened on a task notification.
    r"|<(?:[a-z-]+-message|system-reminder|task-notification)\b)", re.I)

# THE ONE PREFIX THAT MAY LEAVE A CHECKLIST STANDING, and it is narrower than INJECTED on
# purpose. A background task finishing is the only harness text MEASURED firing this event in
# the middle of a turn (2026-09-13). Every other INJECTED prefix is also something a user can
# paste at the start of a real message ("Stop hook feedback: ...", "Caveat:", a copied
# reminder), and a real message must never inherit last turn's asks.
NOTIFICATION = re.compile(r"^\s*<task-notification\b", re.I)

KINDS = [
    ("history", re.compile(
        r"\b(why (?:was|were|did|is it)|when (?:was|were|did)|who (?:removed|changed|added)"
        r"|what happened to|deliberate|on purpose|intentional"
        r"|(?:should|do) (?:we|i|you) (?:restore|bring back|re-?add|revert))\b", re.I),
     "hearing",
     "the record is testimony and it is the only thing that knows INTENT. A tree shows "
     "what is there; only the record says whether its absence was a decision"),

    # `latest` ALONE WAS 46 OF THIS KIND'S 60 FIRES and almost all of them were wrong:
    # "pull down the latest master", "audit the latest article", "prepare the latest
    # release". It is an ordinary English word in an instruction, not a question about the
    # world. MEASURED over 1,909 real prompts, narrowing it to a lookup context takes this
    # kind from 60 fires to 13, drops 48, and loses no prompt that actually needed an
    # outside source. One residual false positive remains in the 13 and is named rather
    # than tuned away, the way 1.38.0 named what its trigger could not do.
    ("world", re.compile(
        r"\b(deprecat\w*"
        r"|(?:the )?(?:latest|newest|current) (?:version|release|stable|api|docs?|spec)"
        r"|current(?:ly)? (?:supported|recommended)|still (?:supported|a thing|maintained)"
        r"|best practice|state of the art|does .{0,20}still exist"
        r"|has .{0,20}changed|up to date"
        r"|what(?:'s| is) (?:the )?(?:latest|current|new))\b", re.I),
     "hearing",
     "this repository cannot know the world. Reading local documents to answer it is "
     "how `vendor` was called a live command from docs that had gone stale"),

    ("behaviour", re.compile(
        r"\b(does (?:it|this|that) (?:still |even |actually |really )*(?:work|run|fire|pass)"
        r"|why (?:does|is) .{0,30}(?:fail|break|error)"
        r"|is (?:it|this) working|what does .{0,30}(?:do|return|emit|print)"
        r"|test|verify|prove|reproduce)\b", re.I),
     "touch",
     "prose says what a script does; running it says what it did. Four scripts here were "
     "described in working detail by live procedures and existed nowhere"),

    # THE KIND THAT WAS MISSING, and it is the one the tunnels formed in. The other four
    # ask about FACTS — what the record says, what the world says, what a script does,
    # what is in a set. A design ask proposes something, and a proposal you authored
    # cannot be judged from inside: `senses.md` measures NINE OF TEN escapes from a
    # settled wrong reading arriving from OUTSIDE the turn that formed it, and zero from
    # noticing. So the sense is hearing — the record (has this been tried, what was
    # decided before) or a reader who did not write the thing.
    #
    # MEASURED THE SAME DAY IT SHIPPED, on this session's own ten asks: two carried a
    # docket. The three that did not — "why not install them where workforce is
    # installed", "should we audit workforce itself", "how close is wf-live to the
    # intuition juror" — are exactly where the readings formed that an independent
    # evaluator later broke in one move. The jury was structurally unreachable on every
    # one of them, so the gate was working and the docket was empty.
    #
    # 2.5% of 1,323 real non-injected prompts, against 1.5% and 0.5% for the two reply
    # triggers that shipped. `should be` UNHEDGED was measured and REJECTED: it doubled
    # the rate to 3.5% by catching plain instructions — "that should be in the email",
    # "no mobile and api-only items should be there". A hedge is what separates a
    # proposal from an order.
    ("judgment", re.compile(
        r"\bshould (?:we|i|you)\b"
        r"|\bwhy (?:not|don'?t we|wouldn'?t we|shouldn'?t we)\b"
        r"|\b(?:what|how) (?:do|would) you think\b|\bdo you think\b"
        r"|\byour thoughts\b|\bthoughts\?"
        r"|\bis (?:that|this) a good idea\b|\bgood idea\?"
        r"|\bdoes (?:that|this) make sense\b"
        r"|\bwould it be (?:better|worth|wise)\b"
        r"|\bi wonder (?:if|whether)\b"
        r"|\b(?:best|right|proper) (?:way|approach|shape|design)\b"
        r"|\bhow (?:would|should) (?:you|we|i)\b"
        r"|\bwouldn'?t it\b|\bcouldn'?t we\b"
        r"|\b(?:perhaps|maybe|i think|i feel like|it feels like|i'?d say)\b"
        r"[^.\n]{0,60}\bshould\b", re.I),
     "hearing",
     "a proposal you authored cannot be judged from inside — the measurement is nine of "
     "ten escapes from a settled wrong reading arriving from outside the turn that formed "
     "it, and none from noticing. Consult the record for what was already decided, or a "
     "reader who did not write it"),

    ("existence", re.compile(
        r"\b(is there (?:a|an|any)|are there|do we have|does .{0,25} exist|what(?:'s| is) in"
        r"|how many|list (?:the|all|every)|which (?:ones|files|scripts|commands)"
        r"|any (?:other|more)|anywhere else)\b", re.I),
     "taste",
     "a claim about a SET is closed by enumerating the set. Point reads sample it, and a "
     "sample cannot show what is absent"),

    # THE INCIDENT KIND, and it is the only one here whose wrong answer the user wrote out
    # in full. User directive 2026-09-24, on a session that diagnosed a hung shell: "we
    # never ever want this type of response from you when dealing with an issue, make sure
    # that is something built into the @workforce-dev jury in the proper sense."
    #
    # WHAT THE TURN DID, from the playwright-mcp record. It stated a cause — "the IC guessed
    # the command from your project's name" — without reading that IC's OUTPUT.md or its
    # transcript, and the real cause was its OWN work order naming `web_fetch` to an agent
    # whose `tools:` did not hold it. It then proposed two bans, "never reach a missing tool
    # through the shell" and "never npx an unpinned package", either of which would also have
    # blocked the `curl` and the `npx -y n lts` that WORKED in the same incident. Its own part
    # came out only after two rounds of pushback: "are we causing more problems by using some
    # drastic rule instead of actually identifying the issue you caused?" and "Those aren't
    # two choices for me. neither one is acceptable."
    #
    # THE SENSE IS HEARING, for the reason `senses.md` gives the record: an OUTPUT.md, a
    # transcript, a `git log` and a command's own output are TESTIMONY, and they are the only
    # things that know why an agent did what it did. A cause read off this turn's own
    # reasoning is the tunnel, exactly.
    #
    # MEASURED over 1,212 real non-injected prompts from this machine's transcripts: 18
    # fires, 1.49%, against the 1.5% budget the two shipped reply triggers were held to. All
    # 18 were hand-read and all 18 are genuine — "why did the sound go silent?", "please
    # diagnose why the voice chat is not working", "we also have an issue with shell items
    # staying open", the `diagnose-crash` crash reports, and the two pushbacks quoted above.
    ("incident", re.compile(
        r"\b(?:root cause|post-?mortem)\b"
        r"|\bwhat (?:went wrong|happened here)\b"
        r"|\bwhat caused\b"
        r"|\bwhy did (?:it|this|that|you|the|we)\b"
        r"|\bwhy (?:is|are|was|were) (?:it|this|that|there|the)\b[^.\n]{0,40}"
        r"\b(?:fail\w*|broke\w*|broken|error|wrong|happening|stuck|hanging)\b"
        r"|\b(?:diagnose|troubleshoot)\b"
        r"|\b(?:it|this|that|they) (?:broke|crashed|hung|is broken|are broken|stopped working)\b"
        r"|\b(?:issue|bug|error|failure|crash|problem|defect|regression)\b[^.\n]{0,40}"
        r"\b(?:you|we|i) (?:caused|created|introduced)\b"
        r"|\bwe (?:also )?have (?:an|a) (?:issue|problem|bug)\b"
        r"|\b(?:i'?m|we'?re) (?:still )?(?:running into|hitting|getting) (?:an? )?"
        r"(?:issue|error|problem)\b"
        r"|\bcrashed\b", re.I),
     "hearing",
     "a cause is testimony before it is anything else. Every stated cause — and above all "
     "every claim about WHY an agent did something — is read off the record it came from: "
     "that agent's OUTPUT.md, its transcript, `git log`, the command's own output. A cause "
     "inferred from this turn's own reasoning is the tunnel, and a rule proposed on one "
     "bans whatever it happens to reach"),
]

# THE FIRST 400 CHARACTERS ONLY, for the kinds named here.
#
# A PASTED DIFF IS NOT AN ASK, and neither is a skill's preamble, an artifact page contract,
# or a wall of log output — but each of them is long, and a long body will eventually contain
# any phrase. MEASURED over the same 1,212 prompts: `incident` fires 36 times (2.97%) unbounded
# and 18 (1.49%) on the head. Every one of the 18 dropped was a phrase buried in pasted
# material — "Errors explain what went wrong and how to fix it" inside a design brief, "don't
# cause regression" inside a quoted goal, `debug.log` inside an npm dump. None was an ask.
#
# IT IS A SET RATHER THAN A FIFTH TUPLE FIELD, so the four shipped rows keep the shape they
# were measured in and nothing has to be re-verified to add one bound.
HEAD = 400
HEAD_ONLY = frozenset({"incident"})

# THE USER'S WORDS DECIDE, NEWEST FIRST — carried on every message, in every project.
# User directive 2026-09-16 (SKILL.md § Directives). It lives HERE, in a hook the install
# wires and `update` refreshes, and not in `/org` dispatch or the operating principles,
# because those are per-project copies that only an `audit` rewrites: a rule put there
# reaches no existing org until somebody re-audits it. This hook is already wired at user
# scope, so changing this text reaches every project on the next `update`, and it arrives
# at the head of every turn rather than decaying at the head of a conversation.
# Stated as facts, never as an instruction (see the note above the injection in `main`).
USER_WORDS = (
    "What this user wants is decided by the user's own requests and notes, weighed by date "
    "with the newest first: this message, then earlier messages in this conversation, then "
    "older requests and notes. A report, plan, summary, or record written by an AI is an "
    "interpretation of those words, not the user's evidence, however recent it is; projects "
    "mark the difference with quoted user words, `origin: user` blocks, `source: user` "
    "attributions, and the user's own notes. An older decision that a newer request "
    "contradicts is superseded by the request, so \"keep it as it was\" is not one of the "
    "choices, and an option that delivers less than the request is not the recommended one. "
    "On how code is written, precedence runs: the user's newest requests and notes decide "
    "what gets built; the project's original human-written code decides how, newest first "
    "within it; AI-written code already in the project comes next, even when it is newer "
    "than the human code; the AI's own preferences come last. Precedent covers mechanisms, "
    "helpers, error handling, naming, and comment style, not bugs. Where a project has "
    "almost no human code, the user's own words are its human precedent. Before an edit, "
    "wf-code-origin reports which lines of the file are human, AI, or unknown by git history."
)


# WHEN TO STOP AND ASK, AND IN WHAT FORM. User directive 2026-09-24, after an `/agenda
# today` run put 31 items to the user as plain markdown, asked for an answer in codes,
# buried the list under six background hand-backs and sat about fifteen minutes: "You
# shouldn't be waiting on my answer, especially if it isn't absolutely evident that you
# need my input on something. ... If there is an answer that it is needed, it needs to be
# evident in a chooser situation" — "much like we choose the budget for audit" — "and this
# functionality needs baked into the workforce process itself without org."
#
# IT LIVES HERE FOR THE SAME REASON `USER_WORDS` DOES, which is the "without org" clause
# made mechanical: this hook is wired at user scope, so the rule reaches every project on
# the next `update` and arrives at the head of every turn. A copy in the operating
# principles reaches only a project somebody re-audits. `wf-chooser` enforces the same
# rule at `Stop`; this is the half that arrives in time to change what the turn does
# rather than grading it afterwards.
#
# Stated as facts, never as an instruction (see the note above the injection in `main`).
CHOOSER_RULE = (
    "Stopping to ask this user is for a decision that genuinely needs them: anything that "
    "can be decided and reversed is decided, said in one line, and the work it unblocks is "
    "finished rather than reported as pending. When a decision does need them, it is put "
    "in an AskUserQuestion chooser in that same turn, never in prose the user has to "
    "decode and type an answer back to — a question written as plain text scrolls away the "
    "moment anything else finishes."
)


# WHAT IS LEFT RUNNING WHEN THE WORK IS DONE. User report 2026-09-24, on a real run in a
# sibling project: "we also have an issue with shell items staying open after they have
# expired and agents staying open after their work is done ... the 1 shell gives the
# impression that the work isn't done here."
#
# THREE MEASURED CAUSES, ONE RULE, because the user asked for the class and not the
# instance ("so that these type of issues also don't happen in the future").
#
#   1. FOUR ICs STILL RUNNING 7-8 HOURS AFTER HANDING BACK. They had been spawned as
#      NAMED TEAMMATES. A teammate does not end when it returns its report — it waits for
#      a `shutdown_request` — and no step in this distribution's dispatch protocol sent
#      one, at any tier. **The defect is the MISSING CLOSE-OUT, not teammates**, so the
#      rule is a preference plus a shutdown, never a ban: a teammate is the right shape
#      for work you must talk to while it runs, and one-shot work simply is not that.
#
#   2. A SHELL THAT OUTLIVED ITS SUBAGENT BY NINE HOURS. The IC ran
#      `npx -y playwright-mcp@latest web_fetch '{...}' | head -200` in Bash. Name the
#      defect precisely, because the obvious reading is wrong: **the shell was not it.**
#      The same IC fetched a README with `curl` in the same run and it worked. What
#      failed was a package name GUESSED from the tool's name and fetched at `@latest`,
#      which resolved to an MCP stdio server — so it blocked on stdin, with no timeout.
#      A blanket "never use the shell" would have banned the `curl` that worked and left
#      the guess that hung.
#
#   3. THE ORDER IS WHAT SENT IT THERE. The work order told that IC to verify commands
#      "with web_fetch" while its handbook's `tools:` was `Read, Edit, Write, Bash,
#      Skill`. Its own report says so — "`web_fetch` MCP tool is not in this tier's
#      toolset" — and it improvised rather than report the gap. Both halves are addressed
#      where each one lives: the DIRECTING node checks the name against the callee's
#      grant before dispatching, and the RUNNING one says so and works with what it has.
#
# IT LIVES HERE FOR THE REASON `USER_WORDS` AND `CHOOSER_RULE` DO. This hook is wired at
# user scope, so the rule reaches every project on the next `update` with no audit, and it
# is the ONE carrier that fires on both ends: `UserPromptSubmit` for the operator who
# writes the order, `SubagentStart` for the employee that runs it. The dispatch protocol
# in `procedures/org.md` and the handbook templates carry the same rule for orgs that
# re-audit; this is the half that does not wait for one.
#
# IT STAYS SHORT. It is paid on every message and on every spawn.
#
# Stated as facts, never as an instruction (see the note above the injection in `main`).
CLEANUP_RULE = (
    "One-shot work is spawned as a plain subagent by preference: a named teammate outlives "
    "its own hand-back until something sends it a shutdown_request, so an order reported "
    "done still shows a running agent. A teammate that was spawned is sent a "
    "shutdown_request once its report has been read. A work order names only tools the "
    "agent running it holds — its `tools:` minus its `disallowedTools:`, checked before the "
    "order is sent — and an order naming a tool the runner lacks is answered by saying so in "
    "the report and doing the work with what is there. Before a package is run through npx, "
    "what that name resolves to is known: the project's own package, a pinned dependency, or "
    "a package the task names. A package name is never guessed from a tool's or a project's "
    "name, and an MCP server is reached through its tools rather than started from the "
    "shell. A command that might wait on input or on the network is worth wrapping in "
    "`timeout`, and no background shell or process is left running once the work is done."
)


SENSE_HOW = {
    "hearing": "read the record that decided it (`git log`, `workforce/changes/`), or ask "
               "a source outside this turn's own reasoning",
    "touch": "run it and read what came back, rather than reading a description of it",
    "taste": "enumerate the set — Glob, find, ls, grep -l — before saying what is in it "
             "or missing from it",
    "sight": "read the file itself",
}


# Explicit enumeration only, and that restraint is the design. Segmenting free-flowing
# natural language into distinct requests is a judgment task, and a regex that guessed at
# it would report `asks: 3` on one long sentence and `asks: 1` on three short ones — a
# number that is wrong in both directions is worse than no number, because the reply gets
# sectioned against it. So this fires on the shapes a user uses when they MEAN to
# enumerate, and returns 1 otherwise.
#
# WHY IT EXISTS. `classify` already returns an array, deliberately — an ask can be two
# KINDS at once. But the flag carries `ask.prompt` as ONE string, so nothing anywhere
# counted how many THINGS were asked. MEASURED 2026-09-11: a user sent three numbered
# issues in one message, got one smeared answer, and had to say so — "if I'm confusing
# you and causing you to mix up the different issues, let me know that too." The
# dissection was real and ran along the wrong axis.
ENUM_PATTERNS = (
    # "there's three things", "two issues", "3 questions"
    re.compile(r"\b(two|three|four|five|\d+)\s+(things?|issues?|questions?|parts?|items?|points?)\b", re.I),
    # "number two", "second thing", "and third"
    re.compile(r"\b(number\s+(two|three|four|2|3|4)|second(ly)?\b|third(ly)?\b)", re.I),
    # a numbered or bulleted list on its own lines
    re.compile(r"^\s{0,3}(\d+[.)]|[-*])\s+\S", re.M),
)

# The count itself, when the user states it. "three things" is a better answer than any
# inference, so it is read literally and preferred over every other signal.
WORD_NUM = {"two": 2, "three": 3, "four": 4, "five": 5}
STATED_COUNT = re.compile(
    r"\b(two|three|four|five|\d+)\s+(?:things?|issues?|questions?|parts?|items?|points?)\b", re.I)


def count_asks(prompt):
    """How many DISTINCT requests this prompt makes, when it says so. 1 otherwise.

    Returns (n, how) — `how` names the evidence, because a bare number gives a reader
    nothing to check and this one drives how a reply is shaped.
    """
    text = prompt or ""
    if INJECTED.search(text):
        return (1, "injected preamble — not the user's ask")

    m = STATED_COUNT.search(text)
    if m:
        raw = m.group(1).lower()
        n = WORD_NUM.get(raw)
        if n is None:
            try:
                n = int(raw)
            except ValueError:
                n = None
        # A stated count is authority, but not an unbounded one: "a hundred things" is
        # exasperation, not a docket.
        if n and 2 <= n <= 9:
            return (n, f"the user stated it: {m.group(0)!r}")

    listed = len(ENUM_PATTERNS[2].findall(text))
    if listed >= 2:
        return (listed, f"{listed} enumerated lines")

    if ENUM_PATTERNS[1].search(text):
        return (2, "ordinal marker present; count not stated, so this is a FLOOR")

    return (1, "no explicit enumeration")


def classify(prompt):
    """Every kind the ask matches, in the order the list declares them.

    NOT first-match. An ask can be two kinds at once — "why was this removed and does it
    still work" is history AND behaviour — and answering it needs both channels. Taking
    only the first would name one and silently drop the other, which is the narrowing
    this whole mechanism exists against.
    """
    # The ask is what the USER typed. Injected preamble is not it, and tagging it puts a
    # docket on a turn whose prompt nobody wrote (see INJECTED, measured).
    if INJECTED.search(prompt or ""):
        return []

    hits = []
    for name, pat, sense, why in KINDS:
        subject = (prompt or "")[:HEAD] if name in HEAD_ONLY else (prompt or "")
        if pat.search(subject):
            # `world` only: a statement about the world is not a question about it.
            if name == "world" and not ASKING.search(prompt or ""):
                continue
            hits.append({"kind": name, "sense": sense, "why": why})
    return hits


_UNSAFE_SID = re.compile(r"[^A-Za-z0-9_-]")


def session_component(payload):
    """The session id as ONE filename component, for every per-session path the hooks build.

    These paths are written and removed. A raw id of `x/../../escaped` walked out of the
    scratchpad whenever an intermediate directory existed. A real id is a UUID and passes
    through unchanged. `wf-widen` and `wf-commitments` import this rather than restate it.
    """
    sid = str(payload.get("session_id") or "")
    sid = _UNSAFE_SID.sub("_", sid)
    return sid[:64] or "nosession"


def agent_component(payload):
    """The subagent's id as ONE filename component, or "" when there is no subagent.

    MEASURED 2026-10-12 on 2.1.296 (platform.md fact 22b): `agent_id` is present only in a
    subagent's payloads — `SubagentStart`, its `PostToolUse` calls and `SubagentStop` — and
    absent from the main thread's, even in an `--agent` session. It is therefore the ONLY
    field that tells an agent apart from the session that spawned it.
    """
    aid = _UNSAFE_SID.sub("_", str(payload.get("agent_id") or ""))
    return aid[:64]


def state_component(payload):
    """The filename component EVERY per-turn hook file is keyed by: the session, and the
    agent too when one is stopping.

    WHY THE AGENT HAS TO BE IN THE NAME. Fact 22b (c): a subagent's payloads carry the
    PARENT session's `session_id`, identical on `SubagentStart`, `PostToolUse` and
    `SubagentStop`. So a file keyed by `session_id` alone is ONE slot shared by the main
    session and every concurrent agent. While agents were never judged that was harmless;
    once they are (K2, 034b5d6), it means each agent reads the tag the USER's message wrote
    and is judged against that message instead of its own work order, and two agents
    finishing at once read and write the same file. The user's ask of 2026-10-12: *"we may
    have multiple widened events that are being tracked at any one time, and so is that also
    being taken into effect?"*

    THE MAIN SESSION KEEPS TODAY'S NAMES, so a tag or checklist written before this change
    still reads, and nothing already on disk is orphaned.
    """
    aid = agent_component(payload)
    sid = session_component(payload)
    return f"{sid}.{aid}" if aid else sid


def tag_path(payload):
    """Where the tag waits for `Stop`. Keyed by session AND agent, so two sessions never
    cross and neither do two concurrent judgments inside one session.

    NOTHING HERE IS OPENED WITH A PLAIN `open()` — every reader goes through
    `read_json_nofollow` and every writer through `write_json_atomic`, for the reason the
    issue ledger uses them (see `write_json_atomic`): the LAST fallback below is `/tmp`,
    which is world-writable, and this name is predictable from a session id other accounts
    on the machine can see. A link planted at it would aim the hook's write at any file the
    user can write and hand the hook's read a file it was never given (CWE-59). The same
    rule covers `wf-asks.<sid>.json` beside it, `wf-widen`'s flag and closeout, and
    `wf-commitments`' read of this file: one pattern, `wf-turn-budget`'s (3c7431c), never a
    second design.
    """
    d = payload.get("scratchpad_dir") or os.environ.get("TMPDIR") or "/tmp"
    sid = state_component(payload)
    return os.path.join(d, f"wf-task-tag.{sid}.json")


def open_agent_tag(payload):
    """Open the starting agent's OWN tag, under its own name, and record nothing else.

    THE ASK IS EMPTY HERE AND IS NOT GUESSABLE. Fact 22b (d), measured: `SubagentStart`
    carries no `prompt`, and the agent's transcript does not exist yet at that event
    (`derived_exists: False`), so the order the agent was given cannot be read. `wf-widen`
    fills it in at `SubagentStop` from the first `isSidechain` `user` row of
    `agent_transcript_path`, the first event where that file exists.

    SO THIS EVENT'S WHOLE JOB IS TO CLAIM THE SLOT. An opened slot is what says the state
    under that name belongs to the agent: a stop with no slot is an agent this installation
    never saw start, and `wf-widen` judges it on its reply alone rather than against an ask
    reconstructed from whatever file happened to be under the session's name.

    Never without an `agent_id`: that would resolve to the session's own tag and erase the
    user's ask mid-turn.
    """
    if not agent_component(payload):
        return
    write_json_atomic(tag_path(payload),
                      {"hits": [], "prompt": "", "senses": [], "asks": None,
                       "asks_why": "", "checklist": None,
                       "agent": str(payload.get("agent_type") or "")})


# WHAT AN ITEM IS, defined beside the list it belongs to. `wf-widen` counts these toward the
# hand-off to the widening agent. The status is the session's to word; only the ask decides
# whether an entry is an item.
def checklist_items(cl):
    """The items on a checklist: JSON objects with a non-empty string `ask`. An `items` that is
    not a list holds no items, so a malformed file reads as an empty checklist."""
    items = cl.get("items") if isinstance(cl, dict) else None
    if not isinstance(items, list):
        return []
    return [i for i in items
            if isinstance(i, dict) and isinstance(i.get("ask"), str) and i["ask"].strip()]


# ─────────────────────────────────────────────────────────────────────────────────
# THE ISSUE LEDGER (K2c, K2d — user direction 2026-10-12).
#
# WHY IT EXISTS, in the user's words: *"the reason why we need to track multiple widening
# events is because you may actually be dealing with multiple issues at the same time, and
# you might have different sets of agents working on those different issues."*
#
# THE DEFECT IT REPLACES. `start_checklist` below removes last turn's checklist on every
# user message. That is correct for a per-TURN artifact and wrong for the work: MEASURED in
# this project's own session of 2026-10-12, the skul-dev fix and the turn-limit work were
# open at the same time and each new message erased the other's items. Worse, an agent
# dispatched for an issue hands back AFTER the turn that sent it has ended, so its result
# arrived with nothing left to judge it against.
#
# SO THE WIPE IS NO LONGER A LOSS, which is the whole of the fix. The outgoing checklist's
# items are ABSORBED onto their issue before the file is removed (`absorb_items`), and the
# issue stays open across every later message until its items are done and its agents are
# back. The per-turn checklist keeps its per-turn life; the ledger is what remembers.
#
# WHERE IT LIVES, and the user decided this too: *"if the issue tracker is going to be
# installed with the workforce, that's perfect, but the actual indexing of the issue tracker
# should be within the project that it's running from"*, and *"each project should have their
# own Issue Tracking Index"*. The code ships in the install; the DATA lives in the project,
# at `<project>/.claude/workforce/issues/`. One file per session, so two sessions in one
# project never share a file, plus `index.json` listing that project's open issues across
# its sessions. There is NEVER a user-level or machine-wide index, and a project's index
# never lists another project's issues: the only root this module will write under is the
# one the harness named.
ISSUES = "issues"

# THE IGNORE RULE'S WHOLE BODY: every file in the issues directory, and no path outside it.
# Named here rather than spelled at the write, so the one thing a reader has to check about
# it — that it is `*` and not a broader pattern aimed a level up — is checkable in one
# place. `bin/check` pins this constant; `issues_dir` is the only writer.
IGNORE_RULE = "*\n"

# THE THREE STATES AN AGENT ENTRY CAN BE IN, declared here because the ledger is the only
# file that carries them and a reader needs the set.
#
#   running    linked at `SubagentStart`; the issue holding one is a HOLD, never a failure.
#              A RESUMED agent returns to it at its next tool call (`agent_resumed`), which
#              is the only moment anything sees a `SendMessage` resume: a resume fires no
#              `SubagentStart`.
#   returned   it handed back HAVING DELIVERED, and `wf-widen` recorded its judgment on the
#              issue. The only two ways in are a stop that delivered the report its order
#              asked for with nothing UNMET in it, and the issue closing.
#   handoff    it stopped at its TURN CAP with work left. SET BY `wf-turn-budget` at the
#              final threshold (K8), through `agent_handoff` below — the hook knows the
#              `agent_id` and the count, so the mark does not wait on `SubagentStop`
#              firing at a cap, which is unmeasured. An agent in this state has STOPPED:
#              the main `Stop` asks for it to be RESUMED, never replaced. THE STOP THAT
#              FOLLOWS THE CUT DOES NOT CLEAR IT (`agent_returned`, measured 2026-10-13):
#              it did, and the resume line never reached one real session.
#
# SO THE CYCLE IS `running` → `handoff` → `running` → … → `returned`, and every arrow is
# written by one event: the final threshold, the first tool call after a resume, and a stop
# that delivered.
AGENT_STATES = ("running", "returned", "handoff")

# A LEDGER NOBODY CAN READ IS A LEDGER NOBODY READS, and the same bound `wf-widen` puts on
# its open-commitment list. A session that genuinely opened 200 issues has a different
# problem than this file can fix.
MAX_ISSUES = 40


def project_root(payload):
    """The project this hook fired for, as the HARNESS names it, or None.

    `${CLAUDE_PROJECT_DIR}` first, the payload's `cwd` second, and NO `os.getcwd()`
    fallback — which is `wf-commitments`' `path()` rule, restated here for the reason that
    rule exists. Both sources above are supplied by the harness and name the project this
    hook was fired for. `os.getcwd()` names wherever the process happens to be, so falling
    back to it turns a hand-run or a test from an unrelated directory into a confident
    write at `<cwd>/.claude/workforce/issues/`, a path nobody named. An unresolved root is
    not a root to guess at: None is the honest answer and every caller treats it as
    "record nothing".
    """
    root = os.environ.get("CLAUDE_PROJECT_DIR") or payload.get("cwd")
    return root if root and str(root).strip() else None


def _open_nofollow(path, flags, mode=0o600):
    """`os.open` with `O_NOFOLLOW` added, so a planted symlink at `path` is refused.

    THIS LEDGER LIVES IN A REPOSITORY, which is what makes the flag load-bearing rather
    than decorative: the path is predictable, a checkout is shared, and a link planted at
    `issues/<session>.json` would otherwise aim this hook's write at whatever it points to.
    The pattern is `wf-turn-budget`'s (3c7431c) and is deliberately not a second design.

    The flag is absent on some platforms; `getattr` keeps this importable there.
    """
    return os.open(path, flags | getattr(os, "O_NOFOLLOW", 0), mode)


def read_json_nofollow(path, default=None):
    """Parse a JSON object at `path`, never through a link. `default` on anything else.

    Unparsable state is DISCARDED rather than raised on. A hook that raised on a file
    somebody else can write would print a traceback on every message afterwards, and the
    cost of discarding is one forgotten issue against a hook that never runs again.

    A REGULAR FILE THIS ACCOUNT OWNS, OR NOTHING — asked of the OPEN FD, not of the name.
    `O_NOFOLLOW` refuses a LINK at the name and says nothing about what else can be there,
    and this reader is also pointed at the scratchpad fallback under `TMPDIR`, a directory
    every account on the host can write: a REGULAR file planted there is read and its
    contents become this session's own state — the ask count a turn is judged against.
    `os.fstat` answers about the file that was actually opened rather than about the name,
    and THE OWNER CHECK IS THE HALF THAT CARRIES THE CASE: a plausible-looking regular file
    somebody else put there first is read and believed, and nothing else here would notice.
    S_ISREG is defence in depth beside it and is not claimed as more than that — MEASURED
    2026-10-12 by deleting it, with the owner check left in place, and nothing changed. A
    FIFO IS NOT WHAT IT STOPS: `os.open` on a fifo blocks before any `fstat` can run, so
    that one is out of reach of this function entirely. A directory and a socket fail in
    `os.fdopen` on their own. What is left for S_ISREG is a device, which on this host
    needs root to create and is therefore already refused by the owner check — it is kept
    because it is free and correct, not because a test can tell it apart.

    `os.getuid` does not exist on Windows, where this ownership model does not apply, so
    its absence skips the owner half rather than failing the import.
    """
    import stat
    try:
        fd = _open_nofollow(path, os.O_RDONLY)
    except OSError:
        return default
    try:
        # `with` owns the fd from here, so the early return below closes it too.
        with os.fdopen(fd, encoding="utf-8") as fh:
            st = os.fstat(fh.fileno())
            uid = getattr(os, "getuid", None)
            if not stat.S_ISREG(st.st_mode) or (uid is not None and st.st_uid != uid()):
                return default
            d = json.load(fh)
    except (OSError, ValueError):
        return default
    return d if isinstance(d, dict) else default


def write_json_atomic(path, obj, indent=None):
    """Replace `path` atomically, and never through a link. True when it landed.

    THE TEMPORARY NAME IS RANDOM AND CREATED `O_EXCL`, which is `tempfile.mkstemp`'s whole
    contract and the same call `wf-ledger.atomic_write` makes. It was `<path>.<pid>` until
    2026-10-12, and a pid is a five-digit number anybody can enumerate: one file sitting on
    that name made every save here return False — the ledger stops recording and says
    nothing — and in a directory other accounts can write it is a name somebody else can
    create first and keep. A random name created `O_EXCL` leaves nothing to squat and
    nothing to clobber, and `mkstemp` creates it 0600.

    `os.replace` then renames over the real name: rename acts on the NAME, so a symlink
    sitting at that name is REPLACED rather than written through, and its target is never
    opened. Those two together are why no file outside this directory can be reached by
    writing here.

    ATOMIC ALSO MEANS NO HALF-LEDGER. Two concurrent agents stop at once; a plain
    open-and-write would let one read a file the other had truncated.

    `indent` IS THE CALLER'S. This ledger is machine-read and writes compact; the
    commitments ledger holds the operator's own sentences in their repository and asks for
    2, so that a person who opens that file can read it.
    """
    import tempfile
    try:
        fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path) or ".",
                                   prefix=os.path.basename(path) + ".")
    except OSError:
        return False
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            json.dump(obj, fh, indent=indent)
        os.replace(tmp, path)
        return True
    except OSError:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        return False


def issues_dir(payload, create=False):
    """`<project>/.claude/workforce/issues`, or None when the harness named no project.

    ON FIRST CREATE IT WRITES ITS OWN `.gitignore` HOLDING `*`, and the hook does that
    rather than an audit: the ledger holds the user's prompts, which do not belong in a
    repository, and a rule only an audit adds reaches no project until somebody re-audits
    it. The precedent is measured — the commitments ledger at
    `.claude/workforce/commitments.json` is git-TRACKED in nsayka-wawa and odyssey-alive,
    and on 2026-10-10 a local edit to it on a live server would have made a
    `git pull --ff-only` conflict.

    THE RULE COVERS `issues/` ONLY, never `.claude/` and never `.claude/workforce/`. The
    user, 2026-10-12: *"some projects actually do ship their Claude directory with the
    repository. I think as long as the index [widen] uses is in the [Claude] directory on
    the project we're good."* A project that commits its `.claude` keeps committing
    everything else in it; an ignore rule one level up would silently un-commit a tree
    somebody chose to ship.

    A LINKED DIRECTORY IS REFUSED OUTRIGHT, which is the half `O_NOFOLLOW` on the files
    cannot reach: `os.makedirs(d, exist_ok=True)` succeeds when `d` is a symlink to a
    directory, and every file below it is then created inside the link's TARGET under a
    name that is not a link and that no flag can object to. So the directory itself is
    checked with `os.path.islink`, for `issues/` and for the `.claude/workforce` holding
    it. `.claude` ITSELF IS NOT CHECKED, deliberately: a dotfiles install that symlinks
    `.claude` into a managed tree is an ordinary setup, and refusing it would take the
    ledger away from a project that did nothing wrong.
    """
    root = project_root(payload)
    if not root:
        return None
    wf = os.path.join(root, ".claude", "workforce")
    d = os.path.join(wf, ISSUES)
    # sec-eval: this is a check-then-use (CWE-367). A directory swapped for a link in the
    # window between this test and the write still wins; closing that window means holding
    # an `O_DIRECTORY | O_NOFOLLOW` handle and threading `dir_fd` through every path this
    # module joins, which is a redesign of the ledger's addressing rather than a guard.
    # Ceiling accepted: this refuses the PLANTED link, which is the reachable case — winning
    # the race needs write access to `.claude/workforce`, and whoever has that can plant the
    # link in advance instead. Upgrade path: `dir_fd` on every open under `issues/`.
    if os.path.islink(d) or os.path.islink(wf):
        return None
    if not create:
        return d if os.path.isdir(d) else None
    try:
        os.makedirs(d, exist_ok=True)
    except OSError:
        return None
    ignore = os.path.join(d, ".gitignore")
    if not os.path.exists(ignore):
        try:
            fd = _open_nofollow(ignore, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
        except OSError:
            return d
        try:
            with os.fdopen(fd, "w", encoding="utf-8") as fh:
                fh.write(IGNORE_RULE)
        except OSError:
            pass
    return d


def ledger_path(payload, create=False):
    """This SESSION's ledger file inside the project's issues directory, or None.

    Keyed by `session_component`, so the id arrives as ONE filename component: a raw id of
    `x/../../escaped` would otherwise walk out of the project directory, and this is a path
    the hook creates and writes.
    """
    d = issues_dir(payload, create=create)
    if not d:
        return None
    return os.path.join(d, f"{session_component(payload)}.json")


def load_ledger(payload):
    """This session's ledger, or an empty one. Never None, so no caller branches on it."""
    p = ledger_path(payload)
    led = read_json_nofollow(p) if p else None
    if not isinstance(led, dict) or not isinstance(led.get("issues"), list):
        return {"session": session_component(payload), "issues": []}
    return led


def save_ledger(payload, led):
    """Write this session's ledger and refresh the project's index. True when it landed."""
    p = ledger_path(payload, create=True)
    if not p:
        return False
    led["issues"] = [i for i in led.get("issues", []) if isinstance(i, dict)][-MAX_ISSUES:]
    if not write_json_atomic(p, led):
        return False
    refresh_index(payload, led)
    return True


def refresh_index(payload, led):
    """Rewrite THIS PROJECT's `index.json` row for this session.

    PER PROJECT AND PER SESSION, which is the user's rule made mechanical: the index is a
    map from session id to that session's open issues, it is written inside the project
    whose work those issues are, and it is only ever reached through `project_root`. No
    other project's sessions are read and none are written, so there is nothing here that
    could become a machine-wide list.
    """
    d = issues_dir(payload, create=True)
    if not d:
        return
    p = os.path.join(d, "index.json")
    idx = read_json_nofollow(p) or {}
    sessions = idx.get("sessions")
    if not isinstance(sessions, dict):
        sessions = {}
    sid = session_component(payload)
    rows = []
    for iss in open_issues(led):
        rows.append({"id": iss.get("id"),
                     # THE ASK IN SHORT, so the index is readable without opening the
                     # ledger. The full prompt stays in the session's own file.
                     "ask": (iss.get("prompt") or "")[:120],
                     "items_open": len([x for x in issue_items(iss)
                                        if not item_done(x)]),
                     "agents_running": len([a for a in issue_agents(iss)
                                            if a.get("state") == "running"])})
    if rows:
        sessions[sid] = {"file": f"{sid}.json", "open": rows}
    else:
        sessions.pop(sid, None)
    write_json_atomic(p, {"sessions": sessions})


def issue_items(iss):
    """The items on an issue: objects with a non-empty string `ask`. Same definition as
    `checklist_items`, applied to the issue the checklist was absorbed onto."""
    items = iss.get("items") if isinstance(iss, dict) else None
    if not isinstance(items, list):
        return []
    return [i for i in items
            if isinstance(i, dict) and isinstance(i.get("ask"), str) and i["ask"].strip()]


def item_done(item):
    """Whether an item is finished. The STATUS IS THE SESSION'S TO WORD, so this reads the
    words a session actually writes rather than demanding one token; anything else is open.
    An item with no status at all is open, which is the direction that keeps work visible.
    """
    s = item.get("status")
    return isinstance(s, str) and s.strip().lower() in (
        "done", "complete", "completed", "closed", "fixed", "shipped")


def issue_agents(iss):
    """The agent entries on an issue: objects carrying a non-empty string `agent_id`."""
    ags = iss.get("agents") if isinstance(iss, dict) else None
    if not isinstance(ags, list):
        return []
    return [a for a in ags
            if isinstance(a, dict) and isinstance(a.get("agent_id"), str)
            and a["agent_id"].strip()]


def open_issues(led):
    """Every issue not yet closed, oldest first. An issue with no `state` is open."""
    return [i for i in led.get("issues", [])
            if isinstance(i, dict) and i.get("state") != "closed"]


def current_issue(led):
    """The issue a newly spawned agent belongs to: the NEWEST open one.

    NEWEST, because an agent is dispatched by the turn that is running now, and that turn
    is working the issue its own message opened. Oldest-first would link a coder to work
    the user raised yesterday. When nothing is open there is no issue to link to, and
    `link_agent` records nothing rather than inventing one.
    """
    opened = open_issues(led)
    return opened[-1] if opened else None


def add_issue(payload, led):
    """Append an issue for THIS user message and return it, or None when the message opens
    no work.

    THE GATE IS `start_checklist`'S, deliberately the same one: injected text is not the
    user's ask, and under a dozen words a message is almost always one ask and not a new
    issue ("commit it", "yes"). Reusing the gate means a message either opens an issue AND
    a checklist or neither, so the two can never disagree about whether work started.

    EARLIER OPEN ISSUES STAY. That is the whole point of the file.
    """
    prompt = payload.get("prompt") or ""
    if INJECTED.search(prompt) or len(prompt.split()) < CHECKLIST_MIN_WORDS:
        return None
    n = 1
    for iss in led.get("issues", []):
        if isinstance(iss, dict) and isinstance(iss.get("id"), str):
            try:
                n = max(n, int(str(iss["id"]).lstrip("i") or 0) + 1)
            except ValueError:
                pass
    iss = {"id": "i%d" % n, "prompt": prompt[:2000], "state": "open",
           "items": [], "agents": []}
    led.setdefault("issues", []).append(iss)
    return iss


def absorb_items(led, issue_id, items):
    """Copy a finished checklist's items onto their issue, replacing what is there.

    THIS IS WHAT MAKES THE WIPE SAFE. `start_checklist` removes the checklist file on every
    message, which is right for a per-turn artifact; absorbing first means the items the
    session wrote survive on the issue and the next message cannot erase them. Replacing
    rather than appending is correct because the checklist is the live view of that one
    issue's items, statuses included: a merge would resurrect an item the session struck.
    """
    if not issue_id:
        return
    for iss in led.get("issues", []):
        if isinstance(iss, dict) and iss.get("id") == issue_id:
            iss["items"] = [{"ask": i["ask"],
                             "status": i["status"] if isinstance(i.get("status"), str)
                             else "open"}
                            for i in items]
            return


def link_agent(payload, led):
    """Link the starting agent to the issue being worked, as `running`. The issue id, or None.

    `issue → agent_ids` with a state, which is K2c's shape. NEVER WITHOUT AN `agent_id`:
    that is the only field that tells an agent apart from the session that spawned it
    (fact 22b), so without one there is nothing to key an entry by and a guessed key would
    attach one agent's result to another's name.
    """
    aid = agent_component(payload)
    if not aid:
        return None
    iss = current_issue(led)
    if iss is None:
        return None
    for a in issue_agents(iss):
        if a.get("agent_id") == aid:
            a["state"] = "running"
            return iss.get("id")
    iss.setdefault("agents", []).append(
        {"agent_id": aid, "agent_type": str(payload.get("agent_type") or ""),
         "state": "running", "judgment": None})
    return iss.get("id")


def agent_returned(payload, led, judgment, delivered=False, cut=True):
    """Record the stopping agent's judgment ON ITS OWN ISSUE, and settle its state.

    THE ISSUE IS FOUND BY THE AGENT'S ID, never by which issue is newest. That is the
    no-cross-talk rule: two issues are open, each has two agents, and the hand-backs
    interleave, so "the current issue" is the wrong answer for every stop but the luckiest.
    An agent whose id appears on no issue is an agent this session never linked, and
    nothing is recorded for it — a stop with no `agent_id` is NOT KEYABLE and is never
    given a guessed one.

    A STOP DOES NOT UNDO A `handoff`, AND THAT IS THE DEFECT A REAL END-TO-END RUN FOUND
    (2026-10-13, session `68b82f98`). A `maxTurns: 10` IC was cut at its cap three times
    and finished on the third. `wf-turn-budget` marked it `handoff` at every cut — and this
    function, called from `wf-widen`'s `SubagentStop` moments later, overwrote the mark
    with `returned` every time. The main `Stop` therefore judged the issue as "all agents
    back, items open" and printed a KICKBACK; the one line the whole K8 mechanism exists to
    print — resume THIS agent with `SendMessage` — never appeared in that session at all.
    The harness's own cut notice is what got the run resumed, which is luck, not a product.

    So the state a cut agent stops in is the state it keeps, and TWO THINGS RETIRE THE
    MARK HERE. `delivered` says this stop left the report its order asked for with nothing
    still UNMET in it (`wf-widen.report_delivered`). `cut` says this stop ended a round at
    or past its turn budget; `cut=False` is an agent that CAME BACK ON ITS OWN, and an
    agent that came back is finished with the round a previous cut marked it for, report or
    no report. The second half was missing until 2026-10-13: in session `83ab658c` a filer
    cut in rounds 1 and 2 returned normally in round 3, and the mark from round 2 survived
    its return, so the issue stayed `handoff` and the next main `Stop` would have demanded
    a resume of an agent that had finished. The third retirement is the issue closing
    (`judge_ledger`), which is the half that holds when the cut lands before this event
    fires at all.

    THE DEFAULTS ARE THE RECOVERABLE DIRECTION, which is why they are not symmetrical:
    `delivered=False` and `cut=True` both KEEP the mark, because a `handoff` kept one stop
    too long asks for one resume too many, where a `handoff` dropped once is a run nobody
    is ever told to continue. A caller that cannot tell whether the stop was a cut — a
    counter it could not verify — passes nothing and keeps the mark.

    A RESUMED AGENT IS PUT BACK TO `running` BY `agent_resumed`, at its next tool call, so
    the round logic downstream still sees `running` → `handoff` → `running` and never a
    `handoff` agent that is secretly working.

    Returns the issue id it landed on, or None.
    """
    aid = agent_component(payload)
    if not aid:
        return None
    for iss in led.get("issues", []):
        for a in issue_agents(iss):
            if a.get("agent_id") == aid:
                a["judgment"] = str(judgment or "")[:500]
                if a.get("state") != "handoff" or delivered or not cut:
                    a["state"] = "returned"
                return iss.get("id")
    return None


def agent_resumed(payload, led):
    """Put a RESUMED agent back to `running` on its own issue. Issue id, or None.

    `wf-turn-budget` calls this on the first tool call after a cut, which is the only
    moment anything observes that a `SendMessage` resume happened: a resume fires no
    `SubagentStart`, so `link_agent` never runs for it and the entry would sit at
    `handoff` while the agent is working. `judge_issue` would then ask the user to resume
    an agent that is already resumed.

    ONLY FROM `handoff`, and None otherwise, so the caller writes nothing on an ordinary
    call. An agent already `running` is the common case and must cost no ledger write.
    """
    aid = agent_component(payload)
    if not aid:
        return None
    for iss in led.get("issues", []):
        for a in issue_agents(iss):
            if a.get("agent_id") == aid and a.get("state") == "handoff":
                a["state"] = "running"
                return iss.get("id")
    return None


def unmet_asks(iss):
    """ONE issue's UNMET set — the asks the session itself has not marked done."""
    return [i["ask"] for i in issue_items(iss) if not item_done(i)]


def unmet_digest(iss):
    """A fingerprint of ONE issue's UNMET set — what is still open, in the session's words.

    EQUAL DIGESTS AT TWO HAND-OFFS MEANS NOTHING MOVED BETWEEN THEM, which is HALF of the
    loop guard: the guard is progress, never a count of resumes, because a count would
    escalate an agent that is finishing something large and let a stuck one be resumed
    twice first. The other half is the agent's own writes — see `agent_handoff`, and see
    why this one cannot carry the case alone.

    THE ITEM STATUSES ARE THE EVIDENCE THIS FILE HOLDS. The plan words the test as
    "OUTPUT.md unchanged"; that path is named in a HANDBOOK and reaches no hook — the hook
    is told an `agent_id`, not a deliverable path — so hashing the file would mean guessing
    where it is. The asks the session has not marked done are the same evidence
    `judge_issue` already kicks back on, and the only kind this project acts on.

    AN EMPTY UNMET SET DIGESTS TO sha256("") AND IS NOT EVIDENCE OF ANYTHING. Every issue
    whose checklist the session has not written yet produces that same value, which is how
    the measured false stall happened: see `agent_handoff`.
    """
    return hashlib.sha256("\n".join(unmet_asks(iss)).encode("utf-8")).hexdigest()[:16]


def agent_handoff(payload, led, writes=None):
    """Mark the agent that hit its TURN CAP `handoff` ON ITS OWN ISSUE. Issue id, or None.

    `wf-turn-budget` calls this at its final threshold, which is the moment the run is
    about to end with work left. THE ISSUE IS FOUND BY THE AGENT'S ID, for
    `agent_returned`'s reason: two issues' agents interleave, so "the newest issue" is the
    wrong answer for every mark but the luckiest. An agent whose id appears on no issue is
    one this session never linked, and nothing is recorded rather than guessed.

    THE SECOND MARK IS THE ONE THAT MATTERS, AND STALLED IS NOW MEASURED FROM TWO THINGS.
    `handoff_digest` is the issue's UNMET set and `handoff_writes` is how many files the
    agent had written or edited, counted from its own transcript by the caller. A mark is
    `handoff_stalled` only when ALL THREE hold:

      * there IS an unmet set — a session that has not written its checklist yet digests
        to sha256(""), and two of those in a row say nothing about the agent;
      * that set is the one the previous mark left, so nothing the session tracks moved;
      * and the agent wrote NOTHING new in the round it just spent.

    MEASURED 2026-10-13, which is why the third test exists. In session `68b82f98` a
    `maxTurns: 10` IC wrote eight files in its first round and eight more in its second,
    and was flagged `handoff_stalled` at the second cut — because the issue had no items
    recorded yet, so both marks carried the digest of the empty set, and the agent's actual
    output was measured by nothing. An absent report is not an unchanged one, and an issue
    with no checklist is not a stalled issue. `writes=None` means the caller could not
    count (no readable transcript), and then the digest decides alone, which is the
    behaviour that shipped before — never worse than it, and gated on a non-empty set.
    """
    aid = agent_component(payload)
    if not aid:
        return None
    for iss in led.get("issues", []):
        for a in issue_agents(iss):
            if a.get("agent_id") == aid:
                digest = unmet_digest(iss)
                measured = isinstance(writes, int) and writes >= 0
                # THE STORED COUNT IS VALIDATED WHERE IT IS READ, which is this file's rule
                # for everything that comes off the ledger: the file lives in a repository
                # and a string or null on this key would make the comparison below raise
                # inside the hook's own try/except — and a mark that silently does not get
                # written is the whole silence this mechanism exists to remove.
                prev = a.get("handoff_writes")
                prev = prev if isinstance(prev, int) and prev >= 0 else 0
                moved = measured and writes > prev
                if (measured and unmet_asks(iss) and not moved
                        and a.get("handoff_digest") == digest):
                    a["handoff_stalled"] = True
                a["state"] = "handoff"
                a["handoff_digest"] = digest
                if writes is not None:
                    a["handoff_writes"] = writes
                return iss.get("id")
    return None


def judge_issue(iss):
    """One issue's verdict at the main `Stop`, as one of:
    ("hold"|"handoff"|"escalate"|"kickback"|"closed"|"open", why).

    IN THE ORDER THEY ARE DECIDED:

      hold      an agent is still RUNNING. Not a failure and never a kickback: the work is
                in flight, and judging it unfinished would be judging an agent that has not
                spoken.
      handoff   nothing is running, an agent STOPPED AT ITS TURN CAP (`handoff`, written by
                `wf-turn-budget`) and items are still open. The issue is not finished and
                the one action is to RESUME that agent — its context is already paid for.
                This was a `hold` until K8, because nothing set the state; holding on it now
                would wait forever for a run the harness has already ended, which is the
                silence the whole turn-budget line of work exists to remove.
      escalate  that agent was marked `handoff` a SECOND time with the same unmet set AND
                nothing newly written (`handoff_stalled`), so resuming it again is not
                progress. The user decides.
      kickback  every agent is back and ITEMS THE SESSION ITSELF RECORDED ARE STILL OPEN.
      closed    every item done. A `handoff` agent does not block this: an agent that
                stopped at a cap having finished the work has nothing left to be resumed
                for, and `judge_ledger` flips it to `returned` as the issue closes. AN
                ISSUE WITH NO ITEMS AT ALL IS NOT CLOSED OVER A CUT AGENT (2026-10-13):
                see the `handoff` row above.
      open      an issue with no recorded items and no agent is nothing to judge. It is the
                shape a one-line message leaves behind, and a hook that kicked back on it
                would fire on almost every turn.

    IT NEVER INFERS AN UNDONE ITEM. The only evidence it will act on is an item the session
    wrote with a status it did not mark done — this project's rule that a blocking surface
    ships with no known wrong fire, applied to the verdicts that can reach the user.
    """
    agents = issue_agents(iss)
    waiting = [a for a in agents if a.get("state") == "running"]
    if waiting:
        return "hold", "%d of %d agents still out: %s" % (
            len(waiting), len(agents),
            ", ".join("%s (%s)" % (a["agent_id"], a.get("state")) for a in waiting))
    items = issue_items(iss)
    undone = [i for i in items if not item_done(i)]
    cut = [a for a in agents if a.get("state") == "handoff"]
    # AN ISSUE WITH NO ITEMS AT ALL AND A CUT AGENT IS NOT A FINISHED ISSUE, and that is
    # the second half of the defect the 2026-10-13 run measured. The session had written
    # no checklist when its IC was cut, so `undone` was empty, so this fell through to
    # `closed` — and `judge_ledger` then retired the `handoff` mark as it closed. An issue
    # closed on no recorded items is a completion nobody observed; the agent stopping at
    # its cap is itself the evidence that work is left, which is what the mark MEANS.
    if cut and (undone or not items):
        stalled = [a for a in cut if a.get("handoff_stalled")]
        who = ", ".join("%s (%s)" % (a["agent_id"], a.get("agent_type") or "?")
                        for a in (stalled or cut))
        asks = "; ".join(i["ask"][:80] for i in undone)
        if stalled:
            return "escalate", "%s stopped at its turn cap twice with the same unmet " \
                               "set — %d of %d items still open: %s" % (
                                   who, len(undone), len(items), asks)
        if not items:
            return "handoff", "%s stopped at its turn cap and this issue records no " \
                              "items, so nothing here says its work is done" % who
        return "handoff", "%s stopped at its turn cap with %d of %d items still open: " \
                          "%s" % (who, len(undone), len(items), asks)
    if undone:
        return "kickback", "%d of %d items unaddressed: %s" % (
            len(undone), len(items), "; ".join(i["ask"][:80] for i in undone))
    if items or agents:
        return "closed", "%d items done, %d agents returned" % (len(items), len(agents))
    return "open", "nothing recorded against it"


def judge_ledger(payload, led):
    """Judge EVERY open issue, close the finished ones, and return the verdict rows.

    EVERY OPEN ISSUE, NOT JUST THIS MESSAGE'S, which is K2c's correction: an agent
    dispatched three messages ago hands back after that turn ended, so the only Stop that
    can judge its issue is one that looks at all of them.

    A CLOSING ISSUE RETIRES ITS `handoff` MARKS. An agent that stopped at a cap with
    everything MET has nothing left to be resumed for, so it is `returned` like any other
    hand-back — and leaving the mark behind would make the NEXT message's Stop ask for a
    resume of an agent whose work is done. `SubagentStop` does this too, through
    `agent_returned` AND ONLY WHEN THAT STOP DELIVERED; this is the half that holds when a
    cap stops the run before that event fires, which is unmeasured on this host, and the
    half that holds when the agent stopped with the work still unfinished.

    THE ISSUE ITSELF RIDES ALONG IN THE ROW, so `wf-widen` can name the agents a verdict
    is about without parsing them back out of the sentence it was given.
    """
    rows = []
    for iss in open_issues(led):
        verdict, why = judge_issue(iss)
        if verdict == "closed":
            iss["state"] = "closed"
            for a in issue_agents(iss):
                if a.get("state") == "handoff":
                    a["state"] = "returned"
        rows.append((iss.get("id"), verdict, why, (iss.get("prompt") or "")[:120], iss))
    return rows


# THE ASKS CHECKLIST. `count_asks` stays regex-only and numbered-only, for the reason given
# above it: splitting free prose into requests is a judgment task. So the split is not done
# here. The operating session is already a model reading the message, and it writes the
# asks into this file itself, before it starts, then updates each item as the work goes.
# At the end of the turn `wf-widen` hands the list and the reply to the widening agent, which
# checks both against the message, so a bad split is caught by a reader that did not write it.
#
# WHY NOT A MODEL CALL HERE. MEASURED 2026-09-12: a headless Haiku split through `claude -p`
# was accurate on real messages and took 9.6-11.7s per call, a wait in front of every
# message before the turn even starts. The session reading the message costs nothing.
#
# Under a dozen words a message is almost always one ask, and a checklist for "commit it"
# or "yes" is a chore the reader pays for on every short reply. Over 1,012 real prompts on
# this machine, 275 are under eight words.
CHECKLIST_MIN_WORDS = 12


def checklist_path(payload):
    """Where this turn's asks checklist lives. Keyed exactly like the tag, so a concurrent
    agent's stop can never read or rewrite the main session's list."""
    d = payload.get("scratchpad_dir") or os.environ.get("TMPDIR") or "/tmp"
    sid = state_component(payload)
    return os.path.join(d, f"wf-asks.{sid}.json")


def previous_checklist(payload):
    """The checklist record the last tag carried, or None. The record is this hook's, kept in
    the tag file, because the checklist file is the session's to rewrite and cannot be trusted
    to hold the user's prompt or whether a `Stop` has ended the turn it belongs to."""
    tag = read_json_nofollow(tag_path(payload))
    rec = tag.get("checklist") if isinstance(tag, dict) else None
    return rec if isinstance(rec, dict) else None


def start_checklist(payload, prev=None):
    """Replace last turn's checklist with an empty one for this ask. Returns the context line
    naming it ("" when this message gets none) and the record the tag carries (None when none).

    Last turn's file is removed first, so a short reply never inherits a list of asks it was
    never given.
    """
    prompt = payload.get("prompt") or ""
    p = checklist_path(payload)
    # A NOTIFICATION MID-TURN LEAVES THE CHECKLIST ALONE. MEASURED 2026-09-13: a background task
    # finished mid-turn, its notification fired this event, and the remove below erased the
    # checklist for the user's real message.
    #
    # BOTH CONDITIONS, and each closes a measured stale case. The prefix is NOTIFICATION, not
    # INJECTED, so a real message that starts "Stop hook feedback:" gets a clean slate. The
    # list's turn must not have ended: once a `Stop` has ended it, a notification that opens a
    # NEW turn afterwards must not keep the list, or the widening agent is handed it twice.
    if (NOTIFICATION.search(prompt) and prev is not None and not prev.get("ended")
            and os.path.exists(p)):
        return "", prev
    # THE LEDGER TURN, AND IT HAPPENS BEFORE THE REMOVE BELOW (K2c). The outgoing list's
    # items are absorbed onto their issue first, so the wipe forgets nothing, and then this
    # message's own issue is opened. It is one block in one place because it is gated on the
    # SAME condition as the wipe: a second copy of that condition is the copy that drifts.
    #
    # THE ABSORB RUNS EVEN WHEN THIS MESSAGE OPENS NO ISSUE. "yes" after a long turn is
    # short and injected text is not an ask, so neither opens one — but both end the turn
    # whose items are still on disk, and losing them there is the defect this replaces.
    issue_id = None
    try:
        led = load_ledger(payload)
        if prev is not None:
            absorb_items(led, prev.get("issue"), checklist_items(
                read_json_nofollow(p) or {}))
        iss = add_issue(payload, led)
        issue_id = iss.get("id") if iss else None
        if iss is not None or prev is not None:
            save_ledger(payload, led)
    except OSError:
        pass
    try:
        os.remove(p)
    except OSError:
        pass
    # Injected text opens no list of its own: it is not the user's ask.
    if INJECTED.search(prompt) or len(prompt.split()) < CHECKLIST_MIN_WORDS:
        return "", None
    if not write_json_atomic(p, {"prompt": prompt[:2000], "items": []}):
        return "", None
    # `issue` PAIRS THE LIST WITH THE ISSUE IT BELONGS TO, and it is what the next
    # message's absorb reads. Without it the items would have no issue to land on.
    record = {"prompt": prompt[:2000], "ended": False, "issue": issue_id}
    # Stated as facts about the file, never as an out-of-band command (see the note above
    # the injection in `main`).
    return (f"Asks checklist for this message: {p}. It holds {{\"prompt\", \"items\"}} and "
            "starts empty. Each separate ask is one item, {\"ask\": <in the user's words>, "
            "\"status\": \"open\"}, written before the work starts; statuses are updated as the "
            "work goes, and an ask found along the way is added. The reply gives each item its "
            "own section. At Stop the widening agent checks the list and the reply against the "
            "message."
            + (f" These items belong to issue {issue_id} in this project's issue ledger, "
               "which keeps them after this turn ends and keeps every earlier open issue "
               "beside them; an agent spawned now is linked to that issue and its result is "
               "recorded there." if issue_id else "")), record


# ─────────────────────────────────────────────────────────────────────────────────
# THE DIRECTIVE CHECK, MOVED OFF THE AGENT AND ONTO THIS EVENT (K6).
#
# Every handbook this distribution writes makes the EMPLOYEE hash its own bound directive
# files and STOP on a mismatch (`handbook-templates.md`, `## Directives`). That is a
# correct rule paid for on every order: the agent spends calls reading a file and running
# a hash before it can begin, and it spends them again on the next order, and the answer
# is the same every time until somebody edits the file.
#
# IT ALSO FAILED IN THE DIRECTION THAT COSTS MOST. An audit wrote a WRONG sha into
# `business-analyst`'s handbook and every order that employee was given from 2026-08-06 to
# 2026-09-04 stopped on arrival — through 13 audits, because a self-check can only report
# the drift to the one agent that is already halted by it
# (`DEF-2026-09-04-business-analyst-directive-sha-drift.md`).
#
# SO THE HASH HAPPENS HERE, ONCE PER SPAWN, AND THE ANSWER IS INJECTED. `SubagentStart` is
# the only user-scope carrier that reaches an employee (a subagent runs its own system
# prompt), and it fires before the agent's first turn, so a verdict stated here arrives in
# time to save the reads rather than grade them. A drift therefore surfaces on the FIRST
# spawn in any project, in the context of whoever reads the spawn, without an audit.
#
# IT NEVER BLOCKS AND IT NEVER GUESSES. No handbook, no readable handbook, no declared
# directive, or a file too large to hash under the caps below → NOTHING is injected and the
# employee's own self-check runs exactly as it does today. That is the whole compatibility
# story for projects whose handbooks predate this: the line makes the check cheap, never
# wrong.

# THE AGENT TYPE IS HARNESS-SUPPLIED TEXT AND IT NAMES A FILE, so it is narrowed to ONE
# filename component by ALLOWLIST rather than by stripping what looks dangerous —
# `session_component`'s rule one directory over. `..`, `a/b`, `/etc/passwd` and a leading
# dot all fail to match, and a real agent type (`engineering-coder`) passes unchanged.
_AGENT_TYPE_OK = re.compile(r"\A[A-Za-z0-9][A-Za-z0-9._-]{0,63}\Z")


def bare_name(name):
    """True when `name` is safe to join into a path as ONE component.

    `wf-turn-budget.bare`'s rule, which also takes an `agent_type` out of a hook payload
    and also builds a path from it. It is restated here rather than imported because these
    two hooks are separate programs with no import edge between them, and the one edge in
    this family (`wf-widen` importing this file) exists because the two halves share STATE.
    The `..` test is redundant against the pattern and is kept for the reason it is kept
    there: a path component is the one input where two independent refusals are cheaper
    than one subtle argument about whether the pattern covers every spelling.
    """
    return (isinstance(name, str) and ".." not in name
            and bool(_AGENT_TYPE_OK.match(name)))

# THE DECLARED FORM, as `handbook-templates.md` writes it into `## Directives`:
#
#     - `.claude/workforce/directives/<skill>.md` — sha `<64 hex>` — <N> block(s)
#
# The sha is accepted bare or `sha256:`-prefixed, because the ORG-RECORD comment carries
# the prefix and the section bullet does not. A handbook that says `(none bound)`, or the
# TEMPLATE itself with its `<directives-sha>` placeholder, matches nothing — which is the
# correct reading of both: there is no declared sha to verify.
_DECLARED_RX = re.compile(r"^-\s+`([^`\n]+)`[^`\n]*`(?:sha256:)?([0-9a-fA-F]{64})`", re.M)

# CAPS, because this runs on EVERY spawn. Only the files the handbook DECLARES are hashed,
# at most MAX_DIRECTIVES of them, and a file over its cap is not read at all rather than
# read in part — a partial read would hash to a mismatch and report a drift that is not
# there. A handbook is ~12 KB and a directive file ~2 KB; both caps are far above the real
# sizes and exist to bound the worst case, not to classify the normal one.
MAX_HANDBOOK_BYTES = 256 * 1024
MAX_DIRECTIVE_BYTES = 1024 * 1024
MAX_DIRECTIVES = 8
# AND THE DECLARED PATH IS BOUNDED BEFORE IT IS ECHOED, because the drift line quotes it
# back into the spawn context: the path is text out of a repository file, and a 10,000-
# character one would be a spawn-context flood written by editing a handbook. A real one is
# ~45 characters, and a truncated one stops resolving — which reports as a drift, the
# correct direction for a pointer nobody can follow (security review 2026-10-12).
MAX_PATH_CHARS = 200

# THE TWO LINES. `directives verified` is the literal the handbook template names, so the
# employee can match on it; keep the two in step or the template's skip clause stops
# resolving.
DIRECTIVES_VERIFIED = (
    "Your handbook's bound directive files were hashed at this spawn and every declared "
    "sha matched: directives verified — the `## Directives` self-check is already done, "
    "so skip it rather than re-reading and re-hashing those files."
)


def _read_capped(path, cap):
    """The bytes at `path`, never through a symlink, or None.

    None covers every refusal there is — absent, unreadable, a planted link, or larger
    than `cap` — because the caller treats them identically: it does not know the file's
    content, so it does not claim to. `_open_nofollow` is the ledger's helper and the
    reason a link planted AT the name is refused instead of followed (CWE-59).
    """
    try:
        fd = _open_nofollow(path, os.O_RDONLY)
    except OSError:
        return None
    try:
        with os.fdopen(fd, "rb") as fh:
            data = fh.read(cap + 1)
    except OSError:
        return None
    return None if len(data) > cap else data


def _inside(root, path):
    """True when `path` RESOLVES inside `root`. Both sides are resolved, never compared as
    text.

    This is the half `O_NOFOLLOW` cannot do. The flag refuses a link at the final
    component; it says nothing about a link at an intermediate directory, and nothing at
    all about a handbook that spells `../../../etc/shadow` as its directive path. A
    declared directive is the HANDBOOK's text, so it is the one input here that an edit to
    a repository file can aim anywhere on the filesystem — and a hook that hashed whatever
    it was pointed at would report the contents of files outside the project through the
    sha it printed.
    """
    try:
        r = os.path.realpath(root)
        p = os.path.realpath(path)
    except OSError:
        return False
    return p == r or p.startswith(r + os.sep)


def handbook_path(root, payload):
    """`<root>/.claude/agents/<agent_type>.md`, or None when that is not one safe name.

    THE MAPPING IS THE HARNESS'S, not this file's invention: a subagent definition lives at
    `.claude/agents/<name>.md` and its frontmatter `name:` is the `agent_type` the payload
    carries, which is how `engineering-coder` resolves to
    `.claude/agents/engineering-coder.md`.
    """
    at = str(payload.get("agent_type") or "").strip()
    if not bare_name(at):
        return None
    p = os.path.join(root, ".claude", "agents", at + ".md")
    return p if _inside(root, p) else None


def declared_directives(body):
    """The `(path, declared-sha)` pairs the handbook's `## Directives` section declares.

    Scoped to that section rather than to the whole file, so a sha quoted in a procedure
    table or in a cold-read probe elsewhere in the handbook is not verified as though the
    role were bound by it.
    """
    i = body.find("\n## Directives")
    if i < 0:
        return []
    j = body.find("\n## ", i + 1)
    seg = body[i:j if j > 0 else len(body)]
    return [(p.strip()[:MAX_PATH_CHARS], s.lower())
            for p, s in _DECLARED_RX.findall(seg)][:MAX_DIRECTIVES]


def directive_line(payload):
    """ONE line for the starting employee about its bound directives, or "" for silence.

    Verified, or `DRIFT:` naming the file, the declared sha and the actual one. Silence is
    the answer whenever this event cannot KNOW — see the section note above — and silence
    leaves the employee's own self-check in charge.
    """
    root = project_root(payload)
    if not root:
        return ""
    hb = handbook_path(root, payload)
    if not hb:
        return ""
    body = _read_capped(hb, MAX_HANDBOOK_BYTES)
    if body is None:
        return ""
    declared = declared_directives(body.decode("utf-8", "replace"))
    if not declared:
        return ""

    drift = []
    for rel, want in declared:
        path = os.path.join(root, rel)
        if not _inside(root, path):
            # REFUSED, AND REPORTED AS A DRIFT RATHER THAN AS SILENCE. A handbook pointing
            # its directive outside the project is not a file this hook failed to read; it
            # is a handbook nobody should act on.
            drift.append(f"DRIFT: {rel} declared {want} actual (outside project)")
            continue
        data = _read_capped(path, MAX_DIRECTIVE_BYTES)
        if data is None:
            drift.append(f"DRIFT: {rel} declared {want} actual (missing)")
            continue
        got = hashlib.sha256(data).hexdigest()
        if got != want:
            drift.append(f"DRIFT: {rel} declared {want} actual {got}")
    if not drift:
        return DIRECTIVES_VERIFIED
    # STATED AS A FACT ABOUT THE FILES, with the STOP named as the handbook's own rule —
    # which is what makes this line work in a project whose handbooks predate it.
    return (" ".join(drift) + " — the declared sha is not what this spawn found, which is the "
            "`## Directives` STOP: report `DIRECTIVE-DRIFT: <path>` and act on no directive "
            "until the operator settles which of the two is wrong.")


def main():
    raw = sys.stdin.read()
    try:
        payload = json.loads(raw) if raw.strip() else {}
    except json.JSONDecodeError:
        return 0

    # A SPAWNED AGENT GETS THE USER-WORDS RULE AND THE CLEANUP RULE. Returned before the
    # widen flag is cleared: a subagent starting mid-turn is not the head of a turn, and
    # clearing there would drop a flag the main session's `Stop` still needs.
    #
    # NOT `CHOOSER_RULE`, and the asymmetry is deliberate: a subagent has no user to ask
    # and no `AskUserQuestion`. `CLEANUP_RULE` is the opposite case — the employee is
    # exactly where the shell hangs and the missing-tool workaround happen, and it is the
    # only text that reaches it, because a subagent runs its own system prompt.
    #
    # IT ALSO GETS ITS OWN SLOT, which is the one thing this event can do that no later one
    # can: see `open_agent_tag`. The main session's tag is NOT touched here — this branch
    # returns before the widen flag is cleared and before `start_checklist`, because a
    # subagent starting mid-turn is not the head of a turn.
    if payload.get("hook_event_name") == "SubagentStart":
        open_agent_tag(payload)
        # AND IT IS LINKED TO THE ISSUE BEING WORKED (K2c), under its own `agent_id`, with
        # state `running`. This is the one event that knows an agent started in this
        # session, so it is the only place the link can be made before the agent's
        # hand-back needs somewhere to land. A failure here is silent: the ledger is a
        # record, and no record is worth erasing a spawn over.
        try:
            _led = load_ledger(payload)
            if link_agent(payload, _led):
                save_ledger(payload, _led)
        except OSError:
            pass
        # AND ITS DIRECTIVES ARE HASHED HERE RATHER THAN BY THE AGENT (K6). Never fatal:
        # a raising verdict would be a hook that erases a spawn over a file it could not
        # read, and silence already means "the employee's own self-check stands".
        try:
            _dir_line = directive_line(payload)
        except OSError:
            _dir_line = ""
        print(json.dumps({"hookSpecificOutput": {
            "hookEventName": "SubagentStart",
            "additionalContext": "\n\n".join(
                x for x in (USER_WORDS, CLEANUP_RULE, _dir_line) if x),
        }}))
        return 0

    # CLEAR LAST TURN'S WIDEN FLAG FIRST, and do it before anything can return early.
    # The flag tells the widening agent to go open a sense; one left behind would send
    # a reader after a question the user has already moved past, and would do it on a
    # turn that raised no flag of its own — a widening nobody asked for, charged to
    # somebody's token budget. This event is the head of every turn, so it is the one
    # place a per-turn artifact can be guaranteed cleared.
    try:
        d = payload.get("scratchpad_dir") or os.environ.get("TMPDIR") or "/tmp"
        sid = session_component(payload)
        os.remove(os.path.join(d, f"wf-widen-flag.{sid}.json"))
    except OSError:
        pass

    # Read before either write below replaces the tag that holds it.
    checklist_line, checklist_record = start_checklist(payload, previous_checklist(payload))

    hits = classify(payload.get("prompt") or "")
    if not hits:
        # AN UNTAGGED TURN MUST NOT INHERIT THE LAST ONE'S TAG. Returning here without
        # clearing left the previous turn's tag file on disk, and `wf-widen` read it at
        # `Stop` as though it belonged to this turn.
        #
        # MEASURED 2026-09-09, on a message with no technical content at all — "tunnel
        # vision is never fun and it shouldn't be for you". It matched none of the four
        # kinds, inherited `behaviour` from the turn before, and was blocked for not
        # running a shell command to close a remark about tunnel vision. A guard that
        # fires on a turn carrying no claim is the 7.0% noise that retired
        # `wf-speak-guard`, arriving by a different route: not a bad detector, but a
        # correct detector reading last turn's input.
        # WRITE AN EMPTY TAG, NEVER DELETE. Removing the file solved the stale-tag bug
        # and created a worse one: `Stop` then has no record that this turn happened at
        # all, and no `prompt` — so an untagged turn can never be audited, because the
        # jury correctly refuses a case with no ask. A fresh, explicitly-empty tag fixes
        # the staleness just as well (it IS this turn's) and keeps the ask on disk for
        # the blind sample in `wf-widen` (§ THE BLIND SAMPLE).
        _n, _how = count_asks(payload.get("prompt") or "")
        write_json_atomic(tag_path(payload),
                          {"hits": [], "prompt": (payload.get("prompt") or "")[:2000],
                           "senses": [], "asks": _n, "asks_why": _how,
                           "checklist": checklist_record})
        print(json.dumps({"hookSpecificOutput": {
            "hookEventName": "UserPromptSubmit",
            "additionalContext": "\n\n".join(
                x for x in (USER_WORDS, CHOOSER_RULE, CLEANUP_RULE, checklist_line) if x),
        }}))
        return 0

    # Never fatal: the injection below still lands, and the Stop half degrades quietly.
    write_json_atomic(tag_path(payload),
                      {"hits": hits,
                       # THE ASK ITSELF, carried forward because `Stop` never gets it.
                       # The Stop payload has no `prompt` field, so the judge was
                       # comparing evidence to conclusion with NO IDEA what was asked —
                       # the measure-results directive implemented with the request
                       # missing. This event is the only one that sees it.
                       "prompt": (payload.get("prompt") or "")[:2000],
                       # THE JURY DOCKET: which senses sit on this ask.
                       "senses": sorted({h["sense"] for h in hits}),
                       # HOW MANY THINGS WERE ASKED, and the evidence for the number.
                       # A reply to a multi-ask prompt carries a heading per ask; one
                       # blended answer to three questions is how a reader loses track
                       # of which were addressed, and re-reading it later is worse.
                       "asks": count_asks(payload.get("prompt") or "")[0],
                       "asks_why": count_asks(payload.get("prompt") or "")[1],
                       # THE CHECKLIST RECORD: the user's prompt and whether a `Stop` has
                       # ended its turn. Kept here, in a file this hook writes, and never in
                       # the checklist file the session edits.
                       "checklist": checklist_record})

    # STATED AS FACTS ABOUT THE ASK, NEVER AS AN INSTRUCTION. The hooks reference is
    # explicit that text framed as an out-of-band command trips the prompt-injection
    # defences and gets surfaced to the user instead of read — which would turn a tag
    # into one more thing a human has to deal with.
    lines = [USER_WORDS, "", CHOOSER_RULE, "", CLEANUP_RULE, "",
             "This ask is of a kind whose wrong answers are on record in this project."]
    for h in hits:
        lines.append(f"  · {h['kind']} — closed by {h['sense'].upper()}: {h['why']}. "
                     f"In practice: {SENSE_HOW[h['sense']]}.")
    lines.append("Senses are described at `references/senses.md`.")
    if checklist_line:
        lines += ["", checklist_line]

    print(json.dumps({"hookSpecificOutput": {
        "hookEventName": "UserPromptSubmit",
        "additionalContext": "\n".join(lines),
    }}))
    return 0


if __name__ == "__main__":
    sys.exit(main())
