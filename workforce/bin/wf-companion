#!/usr/bin/env python3
"""wf-companion — the producer for the Core-skill force-refresh, which had a rule and none.

    wf-companion --root <dir>              report every Core skill's refresh state, write nothing
    wf-companion --root <dir> --execute    refresh the machine-owned regions that can be refreshed
    wf-companion --root <dir> --objective  the Strategic Objective's state: PLACEHOLDER |
                                           DRAFTED | FILLED | ABSENT — exit 1 while unfilled
    wf-companion --root <dir> --draft-objective <file|-> [--by TEXT] [--execute]
                                           draft over the placeholder; never overwrites

THE DEFECT THIS CLOSES. `procedures/audit.md` Step 4 says, in prose: "Force-refresh
the Core skills to current shipped source, every run — never skipped, never offered,
never a question", and names the report block it owes. Nothing performed it. The
evaluator half of the same idea — § Forcible propagation, the house-rules refresh —
has a producer, a counted line (`INV-HOUSERULES`, invariants row 22) and a check; the
Core half had a paragraph. That asymmetry is the bug, and it is invisible from inside
the text because the paragraph reads exactly like a step that runs.

MEASURED 2026-09-08 on this repository, which has been audited three times:
`.claude/skills/org` carried 11 dispatch rungs against the shipped 15 — rungs 12-15
(verify escalations, plain output, finish-not-hedge, say-the-state) never reached the
dispatcher of the project that authored them. `personnel-ledger` listed 4 record types
against the shipped 10. A rule that has not fired across three audits of its own
repository is not a rule, it is a description.

WHAT IT WILL AND WILL NOT OVERWRITE. `audit-setup.md` § Step 0.3 defines three states,
and the third is the common one: a Core skill is routinely CUSTOMIZED, and "the shipped
version is the newcomer; the customization is the requirement." So this script refreshes
a MACHINE-OWNED REGION and nothing else. Where a skill has such a region, the region is
replaced byte-for-byte from shipped source and everything around it is untouched. Where
a skill has no region, the skill is reported UNMANAGED with the drift signal that would
matter, and it is counted in `unrefreshed` naming that precondition — which is the
outcome Step 4's own prose already sanctions. It is NEVER silently overwritten.

Measured on the same repository: `operating-principles` carries 18 numbered items
against 13 shipped. That is not staleness, it is five project-specific principles this
project added, and a force-refresh that "won" would delete them. The three-state rule is
why this script reports rather than writes there.

EXIT CODE. 0 when every Core skill is either present-and-current or present-and-naming
its precondition. 1 when a refresh or a materialization was owed, attempted and failed —
and 1 in REPORT mode for a Core companion that is simply ABSENT, because the companion is
owed and not there — `invariants.md` row 23 requires that "every core companion skill
exists after the run, or names the rule that refused it", and an absence with a producer
standing ready names no rule.
That second case is the 2026-09-11 measurement this release closed: an absence printed at
exit 0 let `/org` go missing through a two-hour audit with nothing in the run's exit codes
to say so. An UNMANAGED or NO-REGION skill is NOT a failure — it is a reported state with
a named reason, it exits 0, and `INV-CORE` prints it either way.
"""
import argparse
import os
import re
import sys

# The Core set, per `references/audit-setup.md` § Step 0.3 — Companion skills. The
# evaluators are deliberately NOT here: their refresh is § Forcible propagation and it
# already has a producer and `INV-HOUSERULES`. Two mechanisms for one idea is how the
# rules drift apart, so this one stops where that one starts.
#
# `region` is the marker PAIR that delimits the machine-owned span, and `source` is the
# shipped file carrying the canonical span between the SAME markers. Reading the
# canonical from between its own markers is what makes this a copy rather than a
# re-composition — `procedures/org.md` § step 5: "COPY THE BLOCK. DO NOT WRITE ONE."
CHECKPOINT_MARKERS = ("<!-- ORG-DISPATCH-CHECKPOINT START",
                      "<!-- ORG-DISPATCH-CHECKPOINT END -->")

CORE = [
    {
        "name": "org",
        "materialize": "materialize_org",
        "region": CHECKPOINT_MARKERS,
        "source": ("references", "procedures", "org.md"),
        # A rung is a numbered top-level item inside the span. Counted only to make the
        # report legible ("11 rungs vs 15"); the REFRESH decision is byte equality, never
        # the count, because two spans can agree on rung count and differ in every rail.
        "unit": "rung",
    },
    {
        "name": "operating-principles",
        "materialize": "materialize_operating_principles",
        # A REGION AT LAST, AND IT IS WHAT MAKES THE HEAL PATH EXIST. This read `None`
        # until 2026-09-11, with the reasoning that a constitution is customized per
        # project and "a force-refresh that won would delete them" — true of the FILE and
        # false of the shipped HALF of it. `templates.md` now seams the two: the shipped
        # items sit inside `WF-PRINCIPLES`, the project's own ratified items sit below the
        # END marker inside an `origin: user` span, and only the region is replaced. So
        # `90fb341`'s deletion of items 11-13 is repaired in every org on its next audit
        # rather than in new orgs only — the 2026-09-07 propagation directive's second
        # clause, which a restoration to the template alone does not satisfy.
        "region": ("<!-- WF-PRINCIPLES START", "<!-- WF-PRINCIPLES END -->"),
        "source": ("references", "templates.md"),
        "unit": "item",
    },
    {
        "name": "personnel-ledger",
        "materialize": "materialize_personnel_ledger",
        "region": None,
        "source": ("references", "personnel-templates.md"),
        "unit": "record type",
        # A data skill (personnel-templates.md § personnel-ledger). A customized copy is
        # never overwritten, but a required contract section it lacks is appended.
        "contract": "data-skill",
    },
]


def wf_source_root():
    """The shipped tree this script runs from — `<install>/`, parent of `bin/`."""
    return os.path.dirname(os.path.dirname(os.path.abspath(__file__)))


def installed_version():
    """WORKFORCE-VERSION from the anchor, or None. Never the SKILL.md mirror.

    Same rule as `wf-conform.installed_version`: `references/version.md` is where the
    number is AUTHORED (SKILL.md Core Principle 9a), and a literal written here would be
    a restated constant in a script whose whole job is detecting drift.
    """
    path = os.path.join(wf_source_root(), "references", "version.md")
    try:
        with open(path, encoding="utf-8", errors="replace") as fh:
            m = re.search(r"^WORKFORCE-VERSION:\s*(\d+(?:\.\d+)*)\s*$", fh.read(), re.M)
    except OSError:
        return None
    return m.group(1) if m else None


def read(path):
    try:
        with open(path, encoding="utf-8", errors="replace") as fh:
            return fh.read()
    except OSError:
        return None


def span(text, markers):
    """(start_index, end_index) of the machine-owned span INCLUDING both markers.

    None when either marker is missing. A lone marker is NOT treated as a span: that is
    `procedures/org.md` step 5's "one marker without its pair -> REPORT and SKIP", and
    guessing where the missing half belongs is how a partial hand-edit gets overwritten.
    """
    if not markers:
        return None
    start_tag, end_tag = markers
    # ANCHORED TO THE START OF A LINE, and that is not fussiness. `procedures/org.md`
    # DOCUMENTS its own markers in prose one paragraph above the real block —
    # "`<!-- ORG-DISPATCH-CHECKPOINT START -->` / `<!-- ORG-DISPATCH-CHECKPOINT END -->`"
    # on a single backticked line. A bare `str.find` matches that line for both markers
    # and returns a span of a few characters containing zero rungs, which the caller then
    # reports as "0 shipped" and would happily write over a project's dispatcher.
    # MEASURED 2026-09-08: that is exactly what the first run of this script did.
    m = re.search(r"^" + re.escape(start_tag), text, re.M)
    if not m:
        return None
    i = m.start()
    m2 = re.search(r"^" + re.escape(end_tag), text[i:], re.M)
    if not m2:
        return None
    return (i, i + m2.end())


def count_units(text):
    """Numbered top-level items in a block — the legibility figure, never the verdict."""
    return len(re.findall(r"^\s{0,3}(\d+)\.\s", text, re.M))


def template_frontmatter(wf, heading):
    """The literal ```yaml block under a `templates.md` section heading.

    COPIED, never composed. `templates.md` § `/org` states the frontmatter as a fenced
    yaml block and the rest of that section as points the body must carry; the block is
    the only part that is byte-canonical, so it is the only part taken verbatim.
    """
    src = read(os.path.join(wf, "references", "templates.md"))
    if src is None:
        return None
    i = src.find(heading)
    if i < 0:
        return None
    m = re.search(r"^```ya?ml\n(.*?)^```\n", src[i:], re.S | re.M)
    if not m:
        return None
    # THE FENCED BLOCK ALREADY CARRIES ITS OWN `---` DELIMITERS, because it is shown in
    # `templates.md` as a complete frontmatter block. Returning it raw and wrapping it in
    # a second pair produced a file opening `---\n---\nname: org`, which no host parses as
    # frontmatter. Caught by reading the first generated `/org`, not by the read-back —
    # which is why `frontmatter_ok` below now exists.
    body = m.group(1).strip("\n")
    lines = body.split("\n")
    if lines and lines[0].strip() == "---":
        lines = lines[1:]
    while lines and lines[-1].strip() == "---":
        lines = lines[:-1]
    return "\n".join(lines)


def materialize_org(wf):
    """The full body of an ABSENT `/org`, assembled from shipped source only.

    THIS IS THE PRODUCER THE RULE NEVER HAD. `audit-setup.md` Step 0.3 deferred `/org`
    to `org index`, `audit.md` Step 6 said `org index` "runs UNCONDITIONALLY", and
    `procedures/org.md` step 2 said "Missing -> bootstrap it there from templates.md".
    Three files stated it and nothing performed it: `/org` is GENERATED, so no installer
    fetches it, and the only mechanism that touched the path refused the absent case and
    exited 0. MEASURED on a fresh project on a remote host, 2026-09-11: a two-hour audit
    finished and `.claude/skills/org/SKILL.md` did not exist.

    Every span below is copied from a shipped file. The frontmatter comes from
    `templates.md` § `/org`; the dispatch ladder is the canonical CHECKPOINT lifted
    byte-for-byte from between its own markers in `procedures/org.md`
    (§ Canonical Dispatch CHECKPOINT: "COPY THE BLOCK. DO NOT WRITE ONE."). Returns None
    when either source is unreadable, because a receptionist assembled from half its
    doctrine is worse than an absence somebody can see.
    """
    fm = template_frontmatter(wf, "## `/org` — the receptionist")
    if fm is None:
        return None
    src = read(os.path.join(wf, "references", "procedures", "org.md"))
    if src is None:
        return None
    sp = span(src, CHECKPOINT_MARKERS)
    if sp is None:
        return None
    checkpoint = src[sp[0]:sp[1]]

    return f"""---
{fm.strip()}
---

# org — hand a task to the right employee

Read the org chart at `.claude/workforce/org-chart.md` and dispatch to the **lowest competent
node**, ties resolving downward. Announcing a dispatch without issuing it is the failure this
skill exists to prevent, so the ladder below is the procedure, not a summary of one.

{checkpoint}

## What this receptionist never does

- **Never asks the user to switch models.** Every employee is model-pinned by its own handbook
  frontmatter, so there is no lane preflight to run here and none is to be added.
- **Never sets `context: fork`.** A forked skill runs inside a subagent and consumes a delegation
  tier, flattening the chain of command by one level.
- **Never re-specifies the steps** of the work it hands off. The handbook owns the procedure; a
  work order that restates it has two procedures that can disagree.

## Modes

```
/org <ask>        dispatch the ask down the ladder above
/org status [emp] read-only — why routing would choose what it chooses
/org log <ask>    dispatch with run telemetry ON
/org log          read-only — summarize this project's telemetry, write nothing
```

`log` appends one JSON object per line to `.claude/workforce/telemetry/<run-id>.jsonl`, in the
project and never under `~/.claude`. **The emitter records; it never assesses** — every field is
copied from the `.spawn` edge, the harness's own completion notification, or the returned
`OUTPUT.md`, and a field that cannot be read is written `null` rather than guessed.

<!-- Generated by `wf-companion` from shipped doctrine: frontmatter from
     `references/templates.md` § `/org`, dispatch ladder from
     `references/procedures/org.md` § Canonical Dispatch CHECKPOINT. Hand-written content
     outside the CHECKPOINT markers is preserved by every later refresh. -->
"""


def materialize_operating_principles(wf):
    """The constitution SCAFFOLD — the shipped items verbatim, the project's own blank.

    `templates.md` § `operating-principles` is half literal and half placeholder by
    design: the numbered General Operating Principles are shipped text, and the Strategic
    Objective is one page the CEO drafts and the user ratifies. So this produces the
    shipped half byte-for-byte and leaves the project's half as the template's own
    placeholder, wrapped in the `origin: user | immutable: true` spans the template
    specifies. **A scaffold is not a finished constitution and does not pretend to be** —
    the placeholder is the audit's own instruction to fill it, and it is visible rather
    than absent, which is the difference between a step that still has to run and a step
    nothing will ever notice was skipped.
    """
    fm = template_frontmatter(wf, "## `operating-principles` — the Strategic Objective")
    if fm is None:
        return None
    src = read(os.path.join(wf, "references", "templates.md"))
    if src is None:
        return None
    # The structure block is the ```markdown fence inside that same section. Bounded to
    # the section, never to the file: `templates.md` carries several such fences and a
    # bare search would lift whichever came first.
    i = src.find("## `operating-principles` — the Strategic Objective")
    j = src.find("\n## The CLAUDE.md Constitution Gate", i)
    m = re.search(r"^```markdown\n(.*?)^```\n", src[i:j if j > i else len(src)], re.S | re.M)
    if not m:
        return None
    return f"---\n{fm.strip()}\n---\n\n{m.group(1).rstrip()}\n"


def materialize_personnel_ledger(wf):
    """The personnel data skill, from the contract table `personnel-templates.md` states.

    A data skill's body IS its contract (`data-skills.md`), and that contract is a table
    in shipped doctrine with one row per required section. So the body is generated from
    those rows rather than composed: the section headings and their contents come from
    the table, and the record FORMATS stay where they are, cited rather than copied — two
    canonical copies of a record template is the failure this project refuses everywhere.
    """
    src = read(os.path.join(wf, "references", "personnel-templates.md"))
    if src is None:
        return None
    i = src.find("## `personnel-ledger` — the skill that holds these records")
    if i < 0:
        return None
    j = src.find("\n### What makes this better", i)
    rows = re.findall(r"^\| `(## [^`]+)` \| (.*?) \|\s*$",
                      src[i:j if j > i else len(src)], re.M)
    if not rows:
        return None
    body = "\n\n".join(f"{h}\n\n{cell.strip()}" for h, cell in rows)
    return f"""---
name: personnel-ledger
description: "The org's personnel records — EMP, PERF, DEF, AMD, RFI, ORG, and the project family DEC, INC, PAT, FLW."
when_to_use: "When reading or writing an employee record, a performance record, a defect, or an amendment"
---

# personnel-ledger

The personnel dataset for this org. **Record formats are not restated here** — they are shipped
doctrine at `references/personnel-templates.md`, and a second copy of a template is a second
canonical text.

{body}

<!-- Generated by `wf-companion` from `references/personnel-templates.md`
     § `personnel-ledger`. Hand-written content added below is preserved. -->
"""


APPEND_NOTE = ("<!-- Appended by `wf-companion` from `references/personnel-templates.md`: "
               "required data-skill contract section(s) this copy lacked (data-skills.md "
               "§ Required sections). Everything above is unchanged. -->")


def _conform():
    """`wf-conform`, loaded by path without bytecode. It owns `DATA_SKILL_SECTIONS`, and a
    second copy of that list here is how the heal and the check would drift apart."""
    import importlib.machinery
    import importlib.util
    prev = sys.dont_write_bytecode
    sys.dont_write_bytecode = True
    try:
        path = os.path.join(os.path.dirname(os.path.abspath(__file__)), "wf-conform")
        loader = importlib.machinery.SourceFileLoader("wf_conform", path)
        spec = importlib.util.spec_from_loader("wf_conform", loader)
        mod = importlib.util.module_from_spec(spec)
        loader.exec_module(mod)
        return mod
    finally:
        sys.dont_write_bytecode = prev


def contract_gaps(body):
    """The required data-skill sections `body` lacks, by the same test `wf-conform` uses."""
    return [s for s in _conform().DATA_SKILL_SECTIONS if ("\n" + s) not in "\n" + body]


def shipped_section(shipped, heading):
    """`heading` and its text from the materialized shipped body, or None."""
    m = re.search(r"^" + re.escape(heading) + r"[ \t]*\n(.*?)(?=^## |^<!-- Generated|\Z)",
                  shipped, re.S | re.M)
    return (heading + "\n" + m.group(1).rstrip("\n")) if m else None


def append_hazard(body):
    """Why appending at end-of-file is unsafe, or None. Text appended after an unclosed
    fence or an unclosed `origin:` span would land inside it, which would edit the user's
    words (directive one)."""
    if sum(1 for l in body.splitlines() if l.lstrip().startswith("```")) % 2:
        return "the file ends inside an unclosed code fence"
    opens = len(re.findall(r"^<!--\s*origin:[^\n]*-->\s*$", body, re.M))
    closes = len(re.findall(r"^<!--\s*/origin\s*-->\s*$", body, re.M))
    if opens > closes:
        return "the file ends inside an unclosed `origin:` span"
    return None


def frontmatter_ok(text):
    """A generated companion opens with exactly one closed frontmatter block.

    THE READ-BACK COULD NOT SEE THE ONE DEFECT THE FIRST GENERATION HAD. It compared the
    CHECKPOINT region and nothing else, so a `/org` whose frontmatter was a doubled `---`
    read back CURRENT — the region was byte-perfect and the file was unloadable. A
    verifier that only checks the part it wrote last is not verifying the file.
    """
    lines = text.split("\n")
    if not lines or lines[0].strip() != "---":
        return False, "does not open with `---`"
    for k in range(1, len(lines)):
        stripped = lines[k].strip()
        if stripped == "---":
            return (True, "") if k > 1 else (False, "empty frontmatter block (`---` twice)")
        if not stripped or ":" in stripped or stripped.startswith(("#", "-")):
            continue
        return False, f"line {k + 1} is not a frontmatter key: {lines[k]!r}"
    return False, "frontmatter block is never closed"


def evaluate(root, wf, entry):
    """One row: (state, detail, installed_path, new_body_or_None)."""
    name = entry["name"]
    inst_path = os.path.join(root, ".claude", "skills", name, "SKILL.md")
    inst = read(inst_path)
    if inst is None:
        # ABSENT IS THIS SCRIPT'S JOB NOW, AND THAT IS THE FIX, NOT AN EXPANSION OF
        # SCOPE. This branch used to read "Step 0.3 materializes companions and
        # INV-COMPANIONS counts them; a second mechanism creating them here would give
        # absence two owners that can disagree." The reasoning was sound and the premise
        # was false: Step 0.3 is PROSE, `INV-COMPANIONS` only COUNTS, and absence
        # therefore had ZERO owners rather than one. Giving it one owner is what removes
        # the disagreement — the refresh path and the create path now read the same
        # shipped source through the same `span()`, so a `/org` this script creates and a
        # `/org` it later refreshes cannot drift apart.
        #
        # MEASURED 2026-09-11: a two-hour `audit` on a fresh project on a remote host
        # finished with no `.claude/skills/org/SKILL.md`. Nothing failed — this row
        # printed its precondition and `main()` returned 0, because an absent companion
        # was "a reported state with a named reason."
        builder = globals().get(entry.get("materialize") or "")
        if builder is None:
            return ("UNPRODUCIBLE",
                    "no SKILL.md and no shipped producer for this companion — "
                    "`audit-setup.md` Step 0.3 must materialize it by hand",
                    inst_path, None)
        body = builder(wf)
        if body is None:
            return ("UNREADABLE",
                    "no SKILL.md, and the shipped doctrine it would be built from is "
                    "unreadable — a companion assembled from half its source is worse "
                    "than an absence somebody can see",
                    inst_path, None)
        return ("ABSENT", "no SKILL.md; a producer exists for it", inst_path, body)

    src_path = os.path.join(wf, *entry["source"])
    src = read(src_path)
    if src is None:
        return ("UNREADABLE", f"shipped source {os.path.join(*entry['source'])} unreadable",
                inst_path, None)

    if entry["region"] is None:
        # A DATA-SKILL COMPANION GAINS WHAT ITS CONTRACT LACKS, AND NOTHING ELSE. The file
        # is customized and is never overwritten, but a required contract section it is
        # missing can be APPENDED from shipped source without touching one byte that is
        # already there. Without this, a copy authored before a section became required
        # fails `wf-conform`'s data-skill contract on every verify, and nothing could clear
        # it. MEASURED 2026-09-15 on pythom-space: `personnel-ledger` carries `## Layout`
        # and no `## Schema`. `## Layout` is left exactly as written and is not taken as the
        # Schema: the appended `## Schema` states the flat layout the shipped contract names.
        if entry.get("contract") == "data-skill":
            gaps = contract_gaps(inst)
            if gaps:
                builder = globals().get(entry.get("materialize") or "")
                shipped = builder(wf) if builder else None
                blocks = [shipped_section(shipped or "", h) for h in gaps]
                why_not = append_hazard(inst)
                if any(b is None for b in blocks) or why_not:
                    return ("UNMANAGED",
                            f"customized, and missing contract section(s) {gaps} that cannot "
                            f"be appended: "
                            + (why_not or "the shipped template carries no text for them"),
                            inst_path, None)
                new_body = (inst.rstrip("\n") + "\n\n" + APPEND_NOTE + "\n\n"
                            + "\n\n".join(blocks) + "\n")
                return ("INCOMPLETE",
                        f"customized; missing {', '.join(gaps)} — append from shipped "
                        f"source, every existing byte kept",
                        inst_path, new_body)
        # No marker convention defined for this skill yet, so there is no span to replace
        # and no way to tell generated prose from the project's own. Report the drift
        # signal and refuse — Step 4's sanctioned `unrefreshed` outcome.
        return ("UNMANAGED",
                "no machine-owned region defined; refresh would have to overwrite the "
                "whole file, and a customized Core skill is never overwritten "
                "(audit-setup.md § Step 0.3, state 3)",
                inst_path, None)

    inst_span = span(inst, entry["region"])
    src_span = span(src, entry["region"])
    if src_span is None:
        return ("UNREADABLE",
                f"shipped {os.path.join(*entry['source'])} carries no canonical span "
                f"between {entry['region'][0]!r} and its END marker",
                inst_path, None)
    if inst_span is None:
        return ("NO-REGION",
                "installed copy carries no marker pair (or only one of the two) — "
                "REPORT and SKIP, never auto-repair (procedures/org.md step 5)",
                inst_path, None)

    canonical = src[src_span[0]:src_span[1]]
    current = inst[inst_span[0]:inst_span[1]]
    if current == canonical:
        return ("CURRENT", f"region matches shipped ({count_units(current)} "
                           f"{entry['unit']}s)", inst_path, None)

    detail = (f"region differs from shipped "
              f"({count_units(current)} {entry['unit']}s installed vs "
              f"{count_units(canonical)} shipped)")
    new_body = inst[:inst_span[0]] + canonical + inst[inst_span[1]:]
    return ("DRIFTED", detail, inst_path, new_body)


# ── the Strategic Objective: detect the placeholder, and draft over it ─────────
# `materialize_operating_principles` leaves the template's placeholder in place and
# its docstring called that "the audit's own instruction to fill it" — and no audit
# step filled it. On a customer host (1.59.1) a Lead's first cold-read probe FAILED
# against the placeholder, which the failure-attribution gate then charged to the
# handbook. `--objective` is the detector (a run PRECONDITION, `staging.md` § Phase B);
# `--draft-objective` is the heal `audit` Step 1c runs.
#
# THE DRAFT IS NEVER WRITTEN INSIDE AN `origin: user | immutable: true` SPAN. That marker
# says the user wrote the words: T2 extraction lifts such a span verbatim as a user
# directive and `wf-protect-directives` guards it as one, so a model's draft inside it
# would be frozen and later quoted back as the user's. It goes into an
# `origin: workforce | modifiable: true` span carrying `drafted-by:`, which the user
# overturns by editing and ratifies by changing that opener to the user marker.
USER_SPAN_RX = re.compile(
    r"^<!--\s*origin:\s*user\b[^>]*immutable:\s*true[^>]*-->$(.*?)^<!--\s*/origin\s*-->$",
    re.S | re.M)
DRAFTED_RX = re.compile(r"^<!--\s*origin:\s*workforce\b[^>]*\bdrafted-by:", re.M)
OBJ_HEADING = "## Strategic Objective"
OP_REL = os.path.join(".claude", "skills", "operating-principles", "SKILL.md")


def objective_placeholder(wf):
    """The template's placeholder text, read from shipped `templates.md` — never restated."""
    body = materialize_operating_principles(wf) or ""
    i = body.find(OBJ_HEADING + "\n")
    j = body.find("\n<!-- /origin -->", i)
    return body[i + len(OBJ_HEADING) + 1:j].strip() if i >= 0 and j > i else None


def _flat(text):
    return " ".join((text or "").split())


def objective_state(root, wf):
    """(state, detail, path, text, placeholder-span-match-or-None)."""
    path = os.path.join(root, OP_REL)
    text = read(path)
    ph = objective_placeholder(wf)
    if text is None:
        return "ABSENT", "no operating-principles/SKILL.md", path, None, None
    if ph is None:
        return "UNREADABLE", "the shipped templates.md placeholder cannot be read", path, text, None
    if DRAFTED_RX.search(text):
        return "DRAFTED", "a workforce-drafted objective is in place, not yet ratified", path, text, None
    if OBJ_HEADING not in text:
        return "ABSENT", f"no `{OBJ_HEADING}` section", path, text, None
    for m in USER_SPAN_RX.finditer(text):
        if _flat(ph) in _flat(m.group(1)):
            return "PLACEHOLDER", "the section still holds the template's placeholder", path, text, m
    if _flat(ph) in _flat(text):
        return "PLACEHOLDER", "the template's placeholder sits outside any span", path, text, None
    return "FILLED", "the section holds an objective", path, text, None


def draft_objective(root, wf, draft, by, execute):
    """Write `draft` over the placeholder. Exit code; never overwrites a filled objective."""
    state, detail, path, text, m = objective_state(root, wf)
    rel = os.path.relpath(path, root)
    if state in ("DRAFTED", "FILLED"):
        print(f"objective          {state} · {rel} · not overwritten — {detail}")
        return 0
    if state != "PLACEHOLDER" or m is None:
        print(f"objective          {state} · {rel} · cannot draft: {detail}", file=sys.stderr)
        return 1
    draft = (draft or "").strip()
    if (not draft or re.search(r"^<!--", draft, re.M)
            or _flat(objective_placeholder(wf)) in _flat(draft)):
        print("wf-companion --draft-objective: the draft is empty, carries a comment marker, "
              "or is the placeholder itself", file=sys.stderr)
        return 2
    # `>` in the provenance would close the comment early and leave the span unopened.
    opener = ("<!-- origin: workforce | modifiable: true | drafted-by: "
              f"{' '.join(re.sub(r'[<>]', '', by).split())} -->")
    later = len(USER_SPAN_RX.findall(text[m.end():]))
    # The placeholder is shipped template text, not the user's words, so the whole span is
    # replaced. That orphans its own `.directives.sha` row and, when sacred blocks follow
    # it (the scaffold carries one for project principles), shifts their `:directive:<N>`
    # index by one (`checksums.md` § The row grammar). Their CONTENT is untouched — the
    # read-back below proves it byte-for-byte — and audit Step 5-STAMP's
    # `wf-stamp --directives --execute --restamp` re-stamps what this run moved.
    heading = OBJ_HEADING + "\n" if OBJ_HEADING in m.group(1) else ""   # template shape
    new = text[:m.start()] + f"{opener}\n{heading}{draft}\n<!-- /origin -->" + text[m.end():]
    how = (f"placeholder span replaced; {later} later sacred block(s) keep their bytes and "
           f"shift index by one (Step 5-STAMP re-stamps)" if later else
           "placeholder span replaced; no later sacred block moved")
    if not execute:
        print(f"objective          PLACEHOLDER · {rel} · would draft — {how}")
        for line in (opener + "\n" + draft).splitlines():
            print(f"  | {line}")
        print("  write with: --execute")
        return 0
    with open(path, "w", encoding="utf-8") as fh:     # through a symlink, never over it
        fh.write(new)
    back = objective_state(root, wf)
    kept = [s for s in USER_SPAN_RX.findall(text) if _flat(objective_placeholder(wf)) not in _flat(s)]
    ok = back[0] == "DRAFTED" and all(s in USER_SPAN_RX.findall(back[3] or "") for s in kept)
    print(f"objective          {'drafted' if ok else 'FAILED'} · {rel} · {how} · read back "
          f"{back[0]}, {len(kept)} other sacred block(s) byte-identical")
    return 0 if ok else 1


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--root", default=os.environ.get("CLAUDE_PROJECT_DIR") or os.getcwd())
    ap.add_argument("--execute", action="store_true")
    ap.add_argument("--objective", action="store_true",
                    help="report the Strategic Objective's state; exit 1 while unfilled")
    ap.add_argument("--draft-objective", metavar="FILE",
                    help="draft the objective from FILE ('-' = stdin) over the placeholder")
    ap.add_argument("--by", default="/workforce audit",
                    help="provenance written into the drafted span's opener")
    args = ap.parse_args()
    if args.objective or args.draft_objective:
        root = os.path.abspath(args.root)
        if args.draft_objective:
            src = (sys.stdin.read() if args.draft_objective == "-"
                   else read(args.draft_objective))
            if src is None:
                print(f"wf-companion: cannot read {args.draft_objective}", file=sys.stderr)
                return 2
            return draft_objective(root, wf_source_root(), src, args.by, args.execute)
        state, detail, path, _t, _m = objective_state(root, wf_source_root())
        print(f"objective          {state} · {os.path.relpath(path, root)} · {detail}")
        return 1 if state in ("PLACEHOLDER", "ABSENT", "UNREADABLE") else 0

    root = os.path.abspath(args.root)
    wf = wf_source_root()
    if not os.path.isdir(os.path.join(root, ".claude")):
        # NEVER 0 ON AN UNREADABLE TARGET — a validator exiting clean on a tree it could
        # not open reports health it did not measure.
        print(f"wf-companion: no .claude under {root}", file=sys.stderr)
        return 2

    ver = installed_version()
    print(f"wf-companion — {root}")
    print(f"  shipped source: {wf}  ·  WORKFORCE-VERSION "
          f"{ver if ver else '<unreadable — no staleness claim made>'}\n")

    refreshed = unrefreshed = current = appended = 0
    materialized = absent = 0
    failed = False
    print("CORE SKILLS")
    for entry in CORE:
        state, detail, path, new_body = evaluate(root, wf, entry)
        name = entry["name"]

        if state == "CURRENT":
            current += 1
            print(f"  = {name:22s} current   {detail}")
            continue

        if state == "INCOMPLETE":
            # APPEND-ONLY, and proven so: the read-back requires the file to START with
            # every byte it had before, and to carry no contract gap afterwards.
            if not args.execute:
                unrefreshed += 1
                print(f"  ~ {name:22s} {state:10s} {detail} — would append")
                continue
            try:
                with open(path, "w", encoding="utf-8") as fh:
                    fh.write(new_body)
            except OSError as exc:
                failed = True
                unrefreshed += 1
                print(f"  ! {name:22s} FAILED    {exc.strerror}", file=sys.stderr)
                continue
            before = read(path) or ""
            inst_before = new_body[:new_body.index(APPEND_NOTE)].rstrip("\n")
            if not before.startswith(inst_before) or contract_gaps(before):
                failed = True
                unrefreshed += 1
                print(f"  ! {name:22s} FAILED    appended and read back with a contract gap "
                      f"or changed bytes — not counted", file=sys.stderr)
                continue
            appended += 1
            print(f"  + {name:22s} appended  "
                  f"{detail.split('; missing ', 1)[-1].split(' — ')[0]} "
                  f"(from shipped source; the customized text above is unchanged)")
            continue

        if state in ("DRIFTED", "ABSENT"):
            verb, past = (("refresh", "refreshed") if state == "DRIFTED"
                          else ("materialize", "materialized"))
            if not args.execute:
                unrefreshed += 1
                if state == "ABSENT":
                    absent += 1
                print(f"  ~ {name:22s} {state:9s} {detail} — would {verb}")
                continue
            try:
                # MATERIALIZING CREATES THE DIRECTORY; REFRESHING NEVER DOES. A refresh
                # whose parent is missing is a target that moved under the run, and
                # `makedirs` would turn that into a confident write to a path nobody
                # named.
                if state == "ABSENT":
                    os.makedirs(os.path.dirname(path), exist_ok=True)
                # WRITE THROUGH A SYMLINK, NEVER OVER IT. A Core skill may be symlinked
                # into a shared doctrine tree, and `open(path, "w")` truncates the TARGET
                # rather than replacing the link (SKILL.md Atomic-or-Absent rule 3).
                with open(path, "w", encoding="utf-8") as fh:
                    fh.write(new_body)
                # READ BACK WITH THIS SCRIPT'S OWN READER. A generator that cannot verify
                # its own output has not finished (`checksums.md` rule 2).
                #
                # A MATERIALIZED companion with no machine-owned region reads back
                # UNMANAGED, not CURRENT, and that is correct rather than a failure:
                # `operating-principles` and `personnel-ledger` define no marker pair, so
                # the refresh path has nothing to compare and says so. What this read-back
                # must establish for them is that the FILE IS THERE AND PARSES — anything
                # stricter would fail every successful creation, which is the
                # always-fails-so-nobody-reads-it defect this script already carries a
                # scar from.
                back_state, back_detail, _, _ = evaluate(root, wf, entry)
                ok = (back_state == "CURRENT" or
                      (verb == "materialize" and back_state in ("UNMANAGED", "NO-REGION")))
                if ok and verb == "materialize":
                    fm_ok, why = frontmatter_ok(read(path) or "")
                    if not fm_ok:
                        ok, back_state = False, f"unloadable frontmatter ({why})"
                if not ok:
                    failed = True
                    unrefreshed += 1
                    print(f"  ! {name:22s} FAILED    {past} and read back "
                          f"{back_state} — not counted", file=sys.stderr)
                    continue
                if verb == "materialize":
                    materialized += 1
                else:
                    refreshed += 1
                print(f"  + {name:22s} {past:13s} {detail}")
            except OSError as exc:
                failed = True
                unrefreshed += 1
                print(f"  ! {name:22s} FAILED    {exc.strerror}", file=sys.stderr)
            continue

        # ABSENT / UNMANAGED / NO-REGION / UNREADABLE all land here, and each one PRINTS
        # ITS PRECONDITION. `INV-CORE` is NOT UPHELD only when an unrefreshed row cites
        # nothing — the uncited-refusal shape `INV-SWEPT` and `INV-HOUSERULES` both use,
        # so a run cannot skip the refresh silently and still close clean.
        unrefreshed += 1
        if state in ("UNPRODUCIBLE", "UNREADABLE") and not os.path.exists(path):
            absent += 1
        print(f"  ~ {name:22s} {state:9s} {detail}")

    total = len(CORE)
    # MATERIALIZED AND REFRESHED ARE PRINTED APART, for `INV-REMAINDER`'s reason: a run
    # that created three companions and a run that refreshed three regions are different
    # events, and one number cannot tell a reader which happened.
    print(f"\nINV-CORE  {total} core skill(s) · current {current} · refreshed {refreshed} "
          f"· materialized {materialized} · appended {appended} · unrefreshed {unrefreshed} "
          f"· absent {absent} "
          f"· each unrefreshed names its precondition")
    if not args.execute and unrefreshed:
        print("Re-run with --execute to materialize the absent companions and refresh the "
              "machine-owned regions. A row reading UNMANAGED or NO-REGION is not "
              "refreshed by --execute either: it names the precondition instead, because "
              "a customized Core skill is never overwritten.")
    # AN ABSENT CORE COMPANION IS A NON-ZERO EXIT IN BOTH MODES, and that is the whole
    # point of this release. `invariants.md` row 23 requires that every core companion
    # "exists after the run, or names the rule that refused it" — quoted from the row,
    # which does NOT contain the "Absence of any is a FAIL, not a report" sentence this
    # comment attributed to it until 2026-09-13.
    # This script printed an absence and returned 0 for it, so `/org` could go
    # missing through a two-hour audit on a fresh project with nothing in the run's own
    # exit codes to say so (MEASURED 2026-09-11, a remote host). Report mode exits 1
    # because the companion is OWED and not there; `--execute` exits 1 only if creating
    # it then failed, which is the actionable distinction between "not done yet" and
    # "cannot be done."
    return 1 if (failed or absent) else 0


if __name__ == "__main__":
    sys.exit(main())
