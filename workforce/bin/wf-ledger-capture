#!/usr/bin/env python3
"""wf-ledger-capture — draft a project record when a turn settled something.

WHY THIS EXISTS. Decisions reached in conversation lived nowhere. The user's ask is
"a natural sustainable conversation over multiple sessions without having to be
concerned about producing the schema" — which means the schema cannot be the user's
job, and it cannot be a step somebody remembers at the end of a session either. A
`Stop` hook fires once per turn, at full strength, on turn 2 and on turn 200 alike,
and it receives the finished reply. Nothing else in the runtime is present at the
moment an exchange settles something.

WHAT IT WRITES, AND THE ONE THING IT NEVER WRITES. At most one record per turn, always
`Status: proposed`, always through `wf-ledger new --if-absent --execute` — this script
holds no second copy of the record format, and it CANNOT write an `accepted` record
because it never passes `--status`. `discovery.md` § Reliability tiers forbids a fuzzy
signal from recommending an action; drafting a `proposed` record is not an action on
the project, it is evidence placed where the user can see it, and the cost of a wrong
draft is one line to reject.

WHAT IT CHECKS — the trigger, in five clauses, all mechanical:

  1. THE USER SPOKE. A continuation summary, a `[Request interrupted]` marker, a
     command wrapper, or a tool result is not the user settling anything.
  2. THE EXCHANGE HAS BOTH HALVES, with substance: >= 40 characters of user text and
     >= 200 characters of finished reply. A one-word turn settles nothing.
  3. IT IS NOT A QUESTION BEING ANSWERED. A user message that opens with an
     interrogative and ends in a question mark is asking; so is one that asks to check
     or verify state; so is a reply that opens "Short answer". Those are the corpus's
     dominant false positive, and all three are answered by reading, never by
     recording.
  4. IT IS NOT A WORK ORDER. "please refresh X", "route that to Y", "implement Z" —
     an instruction to do a thing now is not a decision about how this project works.
  5. A SETTLING PHRASE APPEARS IN THE USER'S OWN WORDS, and its family picks the type:
     `PAT` (every time, whenever, the rule is), `INC` (broke, regression, root cause),
     `FLW` (end to end, the flow, handoff), `DEC` (from now on, instead of, no longer,
     never, always). DEC is last because it is the widest.

PRECISION IS MEASURED, NOT ASSERTED (`passes.md`).

    TUNED ON      349 turns from 66 sessions — every real user turn in
                  ~/.claude/projects/-home-francis-lab-apps-odyssey-alive/ and
                  -home-francis-lab-claude-workforce/, measured 2026-09-08.
                  FIRES ON 19. 17 of the 19 record something a reader would want
                  on file. PRECISION 89%.
    HELD OUT      the rule was FROZEN, then run against
                  363 turns from 78 sessions of six projects it had never seen —
                  odyssey-alive, nsayka-wawa, marge, krull-ai, Graft,
                  claude-watchman. FIRES ON 12, 10 genuine. PRECISION 83%.
    FIRE RATE     31 of 712 turns, 4.4%. Roughly one draft per 23 turns.

The held-out figure is the honest one: the tuned number is fitted to the corpus that
produced it, and quoting it alone would be the overclaim this project refuses
everywhere else. The two false positives that survive are a task instruction phrased
as a goal, and a mid-debug turn that had not settled yet — both cost one line to
reject, which is the trade the `proposed` state exists to make affordable.

WHAT IT DOES NOT DO.

  * It NEVER blocks and NEVER fails a turn. Exit 0 always, whatever happens: a hook
    that fails a turn because it could not classify one is worse than the gap it fills.
    Nothing is printed on stdout, so it cannot alter the reply the user is reading;
    the one-line note goes to stderr.
  * It writes NOTHING when it cannot classify, and NOTHING a second time for the same
    exchange — the slug is derived from the settling sentence, and `--if-absent` makes
    a re-fired turn a no-op rather than a duplicate.
  * It does not judge, rank, or accept. `wf-ledger accept` is the user's act.
  * It does not tag by meaning. `Subjects:` come from the PATHS the turn touched, read
    mechanically out of the transcript's tool calls; a turn that touched nothing is
    recorded `(unclassified)` and reported by the gateway rather than shown to
    everyone.

EXIT CODES: 0 always.
"""

import json
import os
import re
import subprocess
import sys

MAX_QUOTE = 600
MAX_EVIDENCE = 400
MAX_TAGS = 4
MAX_ANCHORS = 4

# ── the trigger. Every list below was measured; see the docstring. ────────────
PAT = ("every time", "each time", "whenever", "the pattern", "convention",
       "standard practice", "the rule is", "as a rule")
INC = ("broke", "broken", "regression", "went wrong", "root cause", "incident",
       "failed", "failing", "caused", "bug")
FLW = ("end to end", "end-to-end", "the flow", "pipeline", "workflow", "hand off",
       "handoff", "the steps")
DEC = ("from now on", "going forward", "from here on", "stick to", "stick with",
       "let's go with", "go with", "we'll use", "we will use", "instead of",
       "rather than", "the decision is", "decided", "make it the default",
       "by default", "no longer", "never ", "always ", "we should always",
       "let's not", "don't ", "do not ")
FAMILIES = (("PAT", PAT), ("INC", INC), ("FLW", FLW), ("DEC", DEC))

# Clause 3 — an interrogative opener plus a closing question mark is a question.
QUESTION_OPENERS = ("what", "why", "how", "does", "do you", "is ", "are ", "can ",
                    "could ", "should we", "which", "who", "when", "would ")
# Clause 3 — asking for the state of something, which is answered by reading.
ASKING_TO_CHECK = ("double check", "double-check", "can you check", "could you check",
                   "did any", "are they", "did it", "is it still", "what's the status",
                   "status of")
# Clause 3 — the reply's own idiom for answering a factual question.
ANSWERING = ("short answer", "short answers")
# Clause 4 — an imperative opener is a work order, not a decision.
WORK_ORDER = ("please ", "route ", "condense ", "refresh ", "implement ", "add ",
              "fix ", "run ", "commit ", "build ", "write ", "create ", "update ",
              "change ", "remove ", "delete ", "check ", "read ", "go ", "do ",
              "make ", "install ", "merge ", "push ", "start ", "continue",
              "proceed", "finish ")
# Clause 1 — text that arrives in the user's slot and is not the user speaking.
NOT_THE_USER = ("this session is being continued", "caveat:", "<command-",
                "<local-command", "<task-notification>", "<system-reminder>",
                "[request interrupted")

_WORD_RE = re.compile(r"[a-z0-9]+")
_SENTENCE_RE = re.compile(r"[^.!?\n]+[.!?]?")


def _note(msg):
    sys.stderr.write("wf-ledger-capture: " + msg + "\n")


def classify(user, assistant):
    """(TYPE, the settling sentence) or None. The whole trigger, in one function so
    the rule that was measured is the rule that runs."""
    u = (user or "").strip()
    a = (assistant or "").strip()
    ul, al = u.lower(), a.lower()
    if not u or not a:
        return None
    if ul.startswith(NOT_THE_USER):
        return None
    if len(u) < 40 or len(a) < 200:
        return None
    if ul.endswith("?") and ul.startswith(QUESTION_OPENERS):
        return None
    if ul.startswith(WORK_ORDER):
        return None
    if al.lstrip("*_# ").startswith(ANSWERING):
        return None
    if "?" in ul and any(p in ul for p in ASKING_TO_CHECK):
        return None
    for kind, phrases in FAMILIES:
        hits = [p for p in phrases if p in ul]
        if hits:
            return kind, settling_sentence(u, hits)
    return None


def settling_sentence(user, phrases):
    """The user's own sentence that carried the trigger, verbatim and untidied.

    THE EARLIEST SENTENCE WINS, not the first phrase in the list. The family lists are
    ordered for classification and that order is arbitrary as prose; quoting by it
    would pull the record's headline out of whichever sentence happened to hold the
    earlier list entry, which on a real turn was the aside rather than the point."""
    for sentence in _SENTENCE_RE.findall(user):
        low = sentence.lower()
        if any(p in low for p in phrases):
            return sentence.strip()
    return user.strip()[:MAX_QUOTE]


def slugify(text, words=6):
    toks = _WORD_RE.findall((text or "").lower())[:words]
    slug = "-".join(toks)[:60].strip("-")
    return slug or "untitled"


# ── the transcript ───────────────────────────────────────────────────────────

def _text_of(message):
    content = (message or {}).get("content")
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        return "\n".join(b.get("text", "") for b in content
                         if isinstance(b, dict) and b.get("type") == "text")
    return ""


def last_exchange(path):
    """(user_text, assistant_text, paths) for the turn that just finished.

    A missing or unparseable transcript returns empties, which the trigger reads as
    "cannot classify" — never as "nothing was decided". The distinction matters
    because only one of them should ever be repaired."""
    user, assistant, paths = "", [], []
    if not path or not os.path.exists(path):
        return "", "", []
    try:
        with open(path, encoding="utf-8", errors="replace") as fh:
            for line in fh:
                try:
                    rec = json.loads(line)
                except ValueError:
                    continue
                if rec.get("isSidechain"):
                    continue
                kind = rec.get("type")
                if kind == "user" and not rec.get("isMeta") and not rec.get("toolUseResult"):
                    text = _text_of(rec.get("message")).strip()
                    if not text:
                        continue
                    user, assistant, paths = text, [], []
                elif kind == "assistant" and user:
                    message = rec.get("message") or {}
                    text = _text_of(message).strip()
                    if text:
                        assistant.append(text)
                    for blk in (message.get("content") or []):
                        if isinstance(blk, dict) and blk.get("type") == "tool_use":
                            paths.extend(_paths_in(blk.get("input") or {}))
    except OSError:
        return "", "", []
    return user, "\n".join(assistant).strip(), paths


_PATH_KEYS = ("file_path", "notebook_path", "path", "filePath")


def _paths_in(tool_input):
    out = []
    if not isinstance(tool_input, dict):
        return out
    for key in _PATH_KEYS:
        value = tool_input.get(key)
        if isinstance(value, str) and value.strip():
            out.append(value.strip())
    return out


def tags_for(root, paths):
    """(subjects, anchors) — MECHANICAL, from what the turn touched.

    The tag is the first path segment, or the first two where the first has children:
    `workforce/bin` and `workforce/references` are different territories and one
    `workforce` tag would hand every reader both. A turn that touched nothing outside
    the root yields no tags, and the gateway writes `(unclassified)` and reports it."""
    tags, anchors = [], []
    for p in paths:
        try:
            rel = os.path.relpath(os.path.abspath(p), root)
        except ValueError:
            continue
        if rel.startswith("..") or os.path.isabs(rel):
            continue
        parts = [x for x in rel.split(os.sep) if x and x != "."]
        if not parts:
            continue
        tag = parts[0] if len(parts) == 1 else "%s/%s" % (parts[0], parts[1])
        if tag not in tags:
            tags.append(tag)
        if rel not in anchors:
            anchors.append(rel)
    return tags[:MAX_TAGS], anchors[:MAX_ANCHORS]


def gateway():
    """The one writer. This script never opens a record file itself — a second copy of
    the record format is the two-implementations defect the manifest exists to stop."""
    return os.path.join(os.path.dirname(os.path.abspath(__file__)), "wf-ledger")


def main():
    try:
        payload = json.loads(sys.stdin.read() or "{}")
    except (ValueError, OSError):
        _note("stdin is not a JSON payload; nothing captured")
        return 0
    if not isinstance(payload, dict):
        _note("payload is not an object; nothing captured")
        return 0

    root = payload.get("cwd") or os.environ.get("CLAUDE_PROJECT_DIR") or os.getcwd()
    root = os.path.abspath(root)

    user, assistant, paths = last_exchange(payload.get("transcript_path"))
    # The payload's own copy of the finished reply is authoritative when present: the
    # transcript may not have been flushed at the moment `Stop` fires.
    assistant = (payload.get("last_assistant_message") or assistant or "").strip()

    verdict = classify(user, assistant)
    if not verdict:
        return 0
    rec_type, sentence = verdict

    subjects, anchors = tags_for(root, paths)
    quote = sentence if len(sentence) <= MAX_QUOTE else sentence[:MAX_QUOTE] + " […]"
    evidence = assistant.strip().replace("\n", " ")
    if len(evidence) > MAX_EVIDENCE:
        evidence = evidence[:MAX_EVIDENCE] + " […]"

    slug = slugify(sentence)
    cmd = [sys.executable, gateway(), "--root", root, "new", rec_type,
           "--slug", slug,
           "--subjects", ",".join(subjects),
           "--anchors", ", ".join(anchors) if anchors else "(none)",
           "--recorded-by", "capture",
           "--quote", quote,
           "--why", "(not stated)",
           "--evidence", evidence,
           "--if-absent", "--execute"]
    if not os.path.exists(cmd[1]):
        _note("gateway missing at %s; nothing captured" % cmd[1])
        return 0
    try:
        proc = subprocess.run(cmd, capture_output=True, text=True, timeout=20)
    except (OSError, subprocess.SubprocessError) as exc:
        _note("gateway did not run (%s); nothing captured" % exc)
        return 0
    out = (proc.stdout or "") + (proc.stderr or "")
    if proc.returncode != 0:
        _note("gateway refused: %s" % out.strip().splitlines()[-1:] or "(silent)")
        return 0
    if "already recorded" in out:
        _note("already recorded: %s-%s (no second draft)" % (rec_type, slug))
        return 0
    _note("drafted %s-%s (proposed) — accept it with `wf-ledger accept %s-%s`"
          % (rec_type, slug, rec_type, slug))
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception as exc:  # a capture bug must never cost the user a turn
        _note("could not capture — %s: %s; passing through" % (type(exc).__name__, exc))
        sys.exit(0)
