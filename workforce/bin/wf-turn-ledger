#!/usr/bin/env python3
"""wf-turn-ledger — report what this turn actually looked at, before the reply lands.

WHY THIS EXISTS, and it is not the guard that died. MEASURED 2026-09-09 over one
working session: ten times the operator was in a tunnel — a conclusion settled early
and defended. NINE of the ten escapes came from OUTSIDE (six from the user, three
from a spawned panel). The tenth came from re-reading a tool's raw output. Zero came
from noticing.

That measurement kills the whole family of self-checks. Every one of them needs the
operator to DECIDE to run it, and that decision is made from inside the tunnel by the
faculty that is impaired. The literature agrees: metacognition in frontier models is
real but "limited in resolution" and "context-dependent" (arXiv 2509.21545, ICLR
2026), and reasoning is latent-state trajectory formation rather than surface
chain-of-thought (arXiv 2604.15726) — so reading one's own reasoning to check for
narrowing inspects the wrong object.

WHAT THIS DOES INSTEAD. It never reads the reply. It never judges anything. It counts
the tool calls the turn actually made and prints them, so the one reader who
demonstrably escapes tunnels — the human — can see in a glance whether the turn was
grounded. A turn that asserts a lot and read nothing is visible without anyone having
to detect anything.

WHY A COUNT AND NOT A CHECK. `wf-speak-guard` died at a MEASURED 7.0% false-positive
rate over 2,149 real replies (changes/1.30.1.md), and its removal is asserted so it
stays removed: "re-adding a substring test for this would repeat a measured failure."
A count has no false-positive rate. It cannot fire on a good reply, because it does
not fire — it reports. The judgment stays with the reader, which is where the
measurement says the working judgment already is.

WHAT IT IS NOT. It is not a claim the turn was wrong, and it must never be described
as one. A turn with zero reads is often correct — answering from context already in
hand is directive two's explicit instruction. What the count buys is that the reader
does not have to GUESS which turns those were.

EXIT CODES: 0 always. A hook that wedges a session over its own bookkeeping is worse
than the defect it watches.
"""

import json
import os
import re
import sys

# Tools that ACQUIRE information about the world. There is NO write column and no
# command classification, and that is the fix rather than an omission.
#
# MEASURED 2026-09-09, the day this shipped: the first version split Bash into
# read/write by substring, and `grep -rn foo . 2>/dev/null` scored as a WRITE because
# `>` was on the write list. So did `python3 bin/check 2>&1 | grep passed`. Those are
# the two most common recon commands in the session that built this file — it
# under-counted exactly the reads it exists to surface, silently.
#
# That is the substring-classification failure that retired `wf-speak-guard` at a
# measured 7.0% (changes/1.30.1.md), one layer down: not judging prose, but judging
# commands, with no measured error rate. A COUNT has no false-positive rate; a
# CLASSIFIER does, and this file's own header claimed the former while doing the
# latter. Counting reads needs no classifier, so there is none.
READERS = {"Read", "Grep", "Glob", "WebSearch", "WebFetch", "NotebookRead"}

# ── this distribution's OWN coined vocabulary ────────────────────────────────
# Words that mean nothing to a reader who has not read these files. Not "hard
# words" and not a style opinion: each one is a term this project invented, and a
# reply that uses one bare has asked the user to decode it first.
#
# MEASURED 2026-09-09 over 4,447 real Opus 5 replies: 7.0% carried one of these.
# That is the largest of the four defect classes measured that day — more than
# double the unsourced-causal-claim rate (2.9%) and twenty times the caving-opener
# rate (0.3%) — and it is the one the user has filed complaints about repeatedly.
#
# WHY THIS IS NOT THE GUARD THAT DIED. `wf-speak-guard` fired on 7.0% of GOOD
# replies because it matched ordinary English — "wrong", "failed", "gap"
# (changes/1.30.1.md). These words have no ordinary meaning to match; a fire means
# the term is genuinely there. And this REPORTS rather than blocks, naming the exact
# term, so the remedy is unambiguous: say it plainly.
JARGON = re.compile(
    r"\brung \d+[a-z]?\b|\bINV-[A-Z]+\b|\bvacuous\b|\bdormant\b|\bemitter\b"
    r"|\bthe pool\b|\bfan-out\b|\bORG-(?:CHAIN|RECORD)\b|\bremainder test\b"
    r"|\bT7[a-z]?\b")

# CODE SPANS ARE MASKED BEFORE MATCHING, and that is a measured correction rather
# than caution. Unmasked, the rate was 7.0% and the false positives were all one
# shape: `dormant` inside a probe FILENAME, `fan-out` inside a table cell of
# identifiers. Masking dropped it to 5.2% and removed that whole class. A backticked
# term is naming an artifact; a bare one is asking the reader to decode it.
_FENCE = re.compile(r"```.*?```", re.S)
_CODE = re.compile(r"`[^`\n]*`")


def mask_code(text):
    text = _FENCE.sub(lambda m: " " * len(m.group(0)), text)
    return _CODE.sub(lambda m: " " * len(m.group(0)), text)


def emit(message):
    """systemMessage — the channel the USER sees. That is the whole point."""
    print(json.dumps({"systemMessage": message}))


def main():
    raw = sys.stdin.read()
    try:
        payload = json.loads(raw) if raw.strip() else {}
    except json.JSONDecodeError:
        return 0
    if payload.get("stop_hook_active"):
        return 0

    tpath = payload.get("transcript_path") or ""
    if not tpath or not os.path.isfile(tpath):
        return 0

    try:
        lines = open(tpath, encoding="utf-8", errors="replace").readlines()
    except OSError:
        return 0

    # THE CURRENT TURN ONLY — everything after the last genuine user message. A
    # ledger spanning the whole session would grow monotonically and stop meaning
    # anything, which is the dormancy shape enforcement.md refuses.
    start = 0
    for i in range(len(lines) - 1, -1, -1):
        try:
            d = json.loads(lines[i])
        except Exception:
            continue
        if d.get("type") != "user":
            continue
        c = d.get("message", {}).get("content")
        # A tool RESULT is recorded as a user row; it is not a user turn.
        if isinstance(c, list) and any(
                isinstance(b, dict) and b.get("type") == "tool_result" for b in c):
            continue
        start = i
        break

    reads, targets, said = 0, [], []
    for line in lines[start:]:
        try:
            d = json.loads(line)
        except Exception:
            continue
        if d.get("type") != "assistant":
            continue
        for b in d.get("message", {}).get("content") or []:
            if isinstance(b, dict) and b.get("type") == "text":
                said.append(b.get("text", ""))
            if not (isinstance(b, dict) and b.get("type") == "tool_use"):
                continue
            name = b.get("name") or ""
            inp = b.get("input") or {}
            # Bash counts as a read WITHOUT inspecting the command. A command that
            # also mutates still looked at something, and the read is the half that
            # gets asserted later. Over-counting a read is a smaller error than the
            # classifier that produced it.
            if name in READERS or name == "Bash":
                reads += 1
                t = (inp.get("file_path") or inp.get("pattern") or inp.get("query")
                     or inp.get("command") or "")
                t = str(t).strip()
                if t:
                    targets.append(os.path.basename(t.split()[0])[:30] if "/" in t.split()[0]
                                   else t.split()[0][:30])

    # The jargon scan reads what was SAID, which is the one thing the read count
    # cannot cover: a turn can be perfectly grounded and still hand the user a
    # sentence they have to decode. Reported on the same line so it costs no extra
    # output, and folded into this hook rather than a second one — every additional
    # always-on mechanism is another thing that can go dormant.
    terms = []
    for m in JARGON.finditer(mask_code("\n".join(said))):
        t = m.group(0)
        if t not in terms:
            terms.append(t)
    tail = ("  ·  PLAIN: " + ", ".join(terms[:4]) + ("…" if len(terms) > 4 else "")) if terms else ""

    if reads == 0:
        emit("GROUNDING  0 reads this turn — answering from context already in hand."
             + tail)
        return 0

    # DISTINCT SOURCES IS THE SIGNAL, not the raw count. Reading one file four times
    # is not four pieces of evidence; it is one, looked at again. That is the shape of
    # the failure this session logged: two documents in one repo read as corroboration
    # when they were one instrument twice.
    seen, uniq = set(), []
    for t in targets:
        if t not in seen:
            seen.add(t)
            uniq.append(t)
    emit(f"GROUNDING  {reads} reads · {len(uniq)} distinct{tail}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
