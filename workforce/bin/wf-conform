#!/usr/bin/env python3
"""wf-conform — the decidable half of `/workforce verify`, on a host.

`procedures/verify.md` specifies ~48 checks; roughly 85% of them are decidable by
reading files: section presence and order, a literal frontmatter line, a resolved
path, a recomputed digest, a line count. Those were prose for a model to perform,
once per run, on every host — while the repo's own conformance ran as a script.

This is the script half. `verify` still owns the judgment half (persona quality,
whether a stated invariant is really mechanical, whether a description over-claims)
and still owns the report. THIS COMMAND DECIDES NOTHING IT CANNOT DECIDE: every
check here has a binary answer or it is not here.

REPORTS; NEVER REPAIRS. `enforcement.md` § Nothing ships dormant — a shipped script is invoked by a
procedure and returns an exit code. It is not a hook and is registered to nothing.

Exit codes
    0  every check passed
    1  at least one check failed
    2  the tree could not be read — never 0 on an unreadable target

Usage
    wf-conform [--root DIR] [--json PATH] [--quiet]
"""

import argparse
import hashlib
import json
import os
import re
import sys


def _load_census():
    """Import the sibling `wf-census` for its exclusion loader — one owner, never
    a second copy.

    `.censusignore` is a DECLARATION the project makes about what its corpus is,
    and it had three readers and one producer: `wf-census` and `wf-apply` both
    honoured it and this file did not. MEASURED 2026-08-10 by a project audit —
    the walk below pruned a directory literally named `fixtures` and read nothing
    else, so a declared exclusion was invisible here while binding everywhere else.
    Two shipped checkers measuring one tree against two different denominators.

    The hardcoded prune was also a heuristic `load_ignore` refuses BY NAME ("no
    `fixtures/` default, no guess from directory names"), so this file was not
    merely missing the rule — it was enforcing the rule's stated opposite.

    NEVER leave bytecode behind: importing a sibling writes `__pycache__/` into the
    SHIPPED bin/ directory, which `bin/check` correctly reports as an undeclared
    file the installers would never fetch.
    """
    import importlib.machinery
    import importlib.util
    _prev = sys.dont_write_bytecode
    sys.dont_write_bytecode = True
    path = os.path.join(os.path.dirname(os.path.abspath(__file__)), "wf-census")
    loader = importlib.machinery.SourceFileLoader("wf_census", path)
    spec = importlib.util.spec_from_loader("wf_census", loader)
    mod = importlib.util.module_from_spec(spec)
    try:
        loader.exec_module(mod)
    finally:
        sys.dont_write_bytecode = _prev
    return mod

# Section order is fixed and asserted (procedure-for-procedures.md § File shape).
# Leads carry no `## Procedure`; everyone else carries every row.
SECTIONS = [
    "## Role",
    "## Scope",
    "## Directives",
    "## Chain of Command",
    "## Procedure",
    "## Verification",
    "## Guardrails",
    "## Exit criteria",
    "## Escalation",
    "## Probe",
    "## Reporting",
]
DATA_SKILL_SECTIONS = [
    "## Schema",
    "## Invariants",
    "## Degradation",
    "## Owner",
    "## Git policy",
    "## Seed",
    "## Maintainers",
]
TIER_RX = re.compile(r"tier:\s*(\d)")
# The GOVERNED discriminator. Must match the MARKER, not the words: a first pass
# used `"ORG-RECORD" in body` and classified a hand-authored agent as governed
# because its prose said "No ORG-RECORD". Substring tests over prose are how this
# project's checks have gone wrong before (CLAUDE.md § Assertions match contiguous
# fragments); the marker is structure and cannot be mentioned by accident.
ORG_RECORD_RX = re.compile(r"^[ \t]*<!--\s*ORG-RECORD\s+START\b", re.I | re.M)
FM_RX = re.compile(r"\A---\n(.*?)\n---\n", re.S)
AGENT_ALLOWLIST_RX = re.compile(r"^(?:tools|disallowedTools):.*\bAgent\(", re.M)

# BODY-vs-GRANT COHERENCE. Both forms an MCP server is named in prose: the tool
# prefix (`mcp__playwright-mcp__web_fetch`) and the bare slug (`playwright-mcp`).
#
# The character class EXCLUDES `_` deliberately. Server slugs contain hyphens and
# tool names are separated by `__`, so a greedy `[A-Za-z0-9-]+` stops exactly at the
# separator and never inside the name. The first draft used `[A-Za-z0-9_-]+?` with a
# `\b` terminator, and `\b` matches at a hyphen — it read `mcp__playwright-mcp` as
# the server `playwright`, then reported it missing from a grant that contained it.
MCP_TOOL_RX = re.compile(r"mcp__([A-Za-z0-9-]+)")
# LINE-ANCHORED AT COLUMN 0, byte-identical to `wf-census`'s IMMUTABLE_OPEN and to
# every other counter in this distribution — an indented marker is a markdown code
# block and therefore documentation ABOUT the format, never a span opener.
# `bin/check` § grammar harvests this pattern and cross-tests it against the other
# readers, so a divergence here fails the build rather than producing a second
# opinion. Measured 2026-08-06: an UNANCHORED hand grep counted 37 sacred spans in
# `skill-builder` against the true 6, which left a blocking gate unsettled for a day.
IMMUTABLE_OPEN_RX = re.compile(
    r"^<!--\s*origin:\s*user\b[^>]*immutable:\s*true[^>]*-->$", re.M)
EXTRACT_CITE_RX = re.compile(r"\.claude/skills/([^/`\s]+)/([^`\s:]+):(\d+)")
MCP_SLUG_RX = re.compile(r"\b([a-z0-9][a-z0-9-]*-mcp)\b")
# A `## Sources` ACCESS CHANNEL that is a skill invocation rather than a path.
# `org-design.md` § The access channel is part of every entry: a read-write state
# store is named by its GATEWAY SKILL — `Skill(<data-skill>)` — never by the raw
# file, because naming the file invites an agent to bypass the gateway.
SOURCES_SKILL_RX = re.compile(r"\bSkill\(\s*([^()\s]+)\s*\)")
# A server named only to FORBID it is not a dependency. `procedure-for-procedures.md`
# requires guardrails to carry a literal NEVER / MUST NOT / STOP, so keying off that
# vocabulary is reading the project's own grammar rather than guessing at intent.
# Without this, `- NEVER use any mcp__claude-in-chrome__* tool` reads as a dependency
# on claude-in-chrome — measured against a real handbook, where it did exactly that.
PROHIBITION_RX = re.compile(r"\bNEVER\b|\bMUST NOT\b|\bSTOP\b|\bdo not\b|\bdon't\b|\bforbidden\b", re.I)
# ROUTING IS NOT INVOCATION — the third case of mention-is-not-use, and the one this
# script was blind to for the first four days it shipped.
#
# The spawning-skill check below names re-homing to a delegating tier as its FIRST
# remedy. An org that applies that remedy writes `ESCALATE: business-lead run /quo …`
# — the skill is named in order to route it AWAY, which is the exact opposite of
# invoking it, and it carries no prohibition keyword because it is an instruction
# rather than a ban. So the check reported the remedy it recommends as the violation
# it recommends the remedy for.
#
# MEASURED 2026-08-05 on odyssey-alive: 22 of 22 `invokes only skills that spawn
# nothing` failures were correctly re-homed steps. Not one was an IC reaching past
# its ceiling. The org had discharged the finding in full and the checker still held
# `INV-VERIFY` red, which deferred the succession sweep it gates.
#
# Generous matching is deliberate and the risk is one-sided: the true positives this
# check has earned (30 of them, DEF-2026-08-05-mechanism-partition-ic-tier) came from
# handbooks that absorbed the mechanism BY HAND and say nothing about escalating it.
# A handbook using this vocabulary about a skill has documented that it routes it up.
ROUTING_RX = re.compile(r"\bESCALATE\b|\bis run by\b|\bnot yours to run\b|\bescalates?\b", re.I)
# Harness slash-commands: real invocations that are not project files and never will
# be. Naming one is correct, so an unresolved-command check that does not know them
# reports every handbook that says `/compact` as broken.
HARNESS_COMMANDS = {
    "help", "clear", "model", "config", "init", "compact", "cost", "doctor", "login",
    "logout", "memory", "status", "vim", "agents", "hooks", "mcp", "resume", "review",
    "workforce", "org", "loop", "schedule", "run", "simplify", "security-review",
}

# CANONICAL SIDECAR GRAMMAR — identical to wf-protect-directives. Two readers of one
# artifact must share one grammar and one normalization, or they cannot both be right.
BLOCK_RX = re.compile(
    r"^<!--\s*origin:\s*user\b[^>]*immutable:\s*true[^>]*-->$(.*?)^<!--\s*/origin\s*-->$", re.S | re.M)
ROW_RX = re.compile(r"^\s*([0-9a-f]{64})\s+(\S+):directive:(\d+)\s*$", re.I)


def normalize(text):
    """Trailing whitespace and final newline. Same rule both readers apply."""
    return "\n".join(line.rstrip() for line in text.strip().splitlines())
DEFAULT_LENGTH_CEILING = 150


class Result:
    def __init__(self):
        self.rows = []
        self.unreadable = []

    def add(self, ok, name, detail=""):
        self.rows.append({"ok": bool(ok), "check": name, "detail": detail})

    def advise(self, name, detail=""):
        """A finding that is reported and does NOT set the exit code.

        Distinct from `adopted`, which must stay a count of FILES workforce did not
        author — `main()` derives `governed = len(handbooks) - len(res.adopted)`, so
        borrowing that key for an advisory row about a governed handbook would make
        the census disagree with itself.

        This channel exists for a contract that post-dates the files under it. The
        negative-test record is the first: failing every handbook authored before it
        would reproduce the run that taught this script its own hardest lesson —
        9 reported failures, all false, and "a check that always fails stops being
        read."
        """
        self.rows.append({"ok": False, "check": name, "detail": detail,
                          "advisory": True})

    @property
    def failed(self):
        """Governed rows only. An adopted agent's hazards are reported, not enforced."""
        return [r for r in self.rows
                if not r["ok"] and not r.get("adopted") and not r.get("advisory")]

    @property
    def advisory_findings(self):
        return [r for r in self.rows if r.get("advisory")]

    @property
    def adopted_findings(self):
        return [r for r in self.rows if not r["ok"] and r.get("adopted")]

    @property
    def adopted(self):
        return [r for r in self.rows if r.get("adopted")]


def section(body, heading):
    """Text under a HEADING — line-anchored, never a bare substring search.

    `body.split("## Verification", 1)[1]` splits at the FIRST occurrence anywhere,
    including a prose mention. Measured 2026-08-04 on a real handbook:

        line 58   6. Run the mechanical scan in `## Verification` — it answers …
        line 63   ## Verification

    so every check reading that section was handed the tail of `## Procedure`, and
    the section it meant to examine was never read at all. The old "Verification is
    not empty" assertion PASSED on that file — the wrong segment is also non-empty —
    which is why nothing surfaced it for as long as the check has existed. A new
    check reading the same bytes is what exposed it.

    Fixed as a class: `## Directives` and `## Procedure` are read the same way and
    carried the same defect. Fixing only the instance is the rule this project
    violated in the same week it wrote it down.

    Returns None when the heading is absent — distinct from an empty section.
    """
    # Trailing text on the heading line is tolerated, for two reasons that are both
    # measured. First, THIS FILE'S OWN presence check is `body.find("\n" + s)` — a
    # substring match — so `## Verification (mechanical)` PASSES "every required
    # section present" and then extracted nothing: the script reported the section
    # present and examined none of it. Second, `wf-checkrun` reads the same section,
    # and two readers of one artifact must share one grammar or they cannot both be
    # right — the rule this file already states for the sidecar digest.
    m = re.search(r"^" + re.escape(heading) + r"[ \t]*[^\n]*$(.*?)(?=^## |\Z)",
                  body, re.S | re.M)
    return m.group(1) if m else None


def read(path, res):
    try:
        with open(path, encoding="utf-8") as fh:
            return fh.read()
    except (OSError, UnicodeDecodeError) as exc:
        res.unreadable.append(f"{path}: {type(exc).__name__}")
        return None


def _digest(path):
    """sha256 of a file, or None if unreadable. Unreadable is not 'equal'."""
    try:
        with open(path, "rb") as fh:
            return hashlib.sha256(fh.read()).hexdigest()
    except OSError:
        return None


def frontmatter(body):
    m = FM_RX.match(body or "")
    if not m:
        return None
    fm = {}
    for line in m.group(1).splitlines():
        if ":" in line and not line.lstrip().startswith("#"):
            k, _, v = line.partition(":")
            fm[k.strip()] = v.strip()
    return fm


def check_adopted(path, body, res):
    """An agent workforce did not author. Report; never impose a shape on it.

    `conversion-taxonomy.md` ADOPT: "already a registered agent -> censused into
    the chart, ZERO BYTES CHANGED." A hand-authored agent has no `## Probe`, no
    `## Directives`, and no ORG-RECORD because nobody promised it would. Measuring
    it against the handbook template reports a dozen failures about a contract it
    was never under — which is noise that trains a reader to ignore the report.

    Found by RUNNING this against a real brownfield project (odyssey-alive, three
    hand-authored agents, six failures, every one of them wrong). Re-reading the
    script did not find it; `CLAUDE.md` says that is the normal outcome.

    Only genuine RUNTIME hazards are checked here, because those are bugs in
    anyone's file regardless of who wrote it. They are reported and counted, and
    they do NOT set the exit code: forcing a verdict on a file workforce does not
    own is the same overreach `evaluators.md` refuses when a catalog cannot be
    appended — skipped and reported, never forced.
    """
    n = os.path.basename(path)
    hazards = []
    if AGENT_ALLOWLIST_RX.search(body):
        hazards.append(
            "carries an `Agent(...)` allowlist — subagent definitions IGNORE these, "
            "so the restriction does not exist at runtime"
        )
    # `allowed-tools:` is the SKILL frontmatter key; the agent loader reads `tools:`.
    # A ceiling declared under the wrong key reads as present and grants nothing —
    # measured 2026-09-01 on a real org: two adopted reviewers declared "Read-only"
    # under `allowed-tools:`, one of them authorized to apply deletions, both
    # ceilings very likely unread by the loader.
    _afm = frontmatter(body)
    if _afm is not None and "allowed-tools" in _afm and "tools" not in _afm:
        hazards.append(
            "declares its tool ceiling under `allowed-tools:` — the agent loader "
            "reads `tools:`, so this ceiling is very likely not applied at runtime; "
            "rename the key"
        )
    res.rows.append({"ok": not hazards, "check": f"{n}: adopted (not workforce-authored)",
                     "detail": "; ".join(hazards), "adopted": True})


def check_handbook(path, body, res, ceiling):
    n = os.path.basename(path)
    fm = frontmatter(body)
    res.add(fm is not None, f"{n}: frontmatter parses")
    if fm is None:
        return

    # The dead-key ceiling. `allowed-tools:` is the SKILL key; agents are loaded from
    # `tools:`. In a governed handbook this is BLOCKING, not a hazard report: workforce
    # authored the file, so the wrong key is a defect in the generator's output, and a
    # tier ceiling under a key the loader does not read is no ceiling at all.
    res.add(not ("allowed-tools" in fm and "tools" not in fm),
            f"{n}: tool ceiling declared under the key the agent loader reads",
            "frontmatter uses `allowed-tools:` (the skill key) with no `tools:` — the "
            "ceiling is very likely not applied at runtime; rename the key to `tools:`")

    tier = None
    m = TIER_RX.search(body)
    if m:
        tier = int(m.group(1))
    res.add(tier is not None, f"{n}: ORG-RECORD states a tier",
            "no `tier: N` in the ORG-RECORD block; tier drives every other rule here")

    # Section presence and order, per procedure-for-procedures.md § File shape —
    # which marks TWO sections tier-conditional, and this checked only one.
    #
    #   ## Procedure          Lead: —   IC: yes    (a coordinator gets no script)
    #   ## Chain of Command   Lead: yes IC: —      (an IC has no subordinates)
    #
    # Measured 2026-08-03 by `/workforce verify` on a real org: 9 reported failures,
    # ALL FALSE — every IC flagged for missing a section the spec says it must not
    # have, and `handbook-templates.md` § IC correctly omits. This is the exact
    # failure class verify.md documents: a validator holding files to a contract
    # they were never under. Attribution is the DOCUMENT — this script.
    #
    # It matters more than a wrong count: a check that always fails stops being read.
    expected = [
        s for s in SECTIONS
        # tier 1 AND 2 are delegating; neither carries a `## Procedure`. Exempting
        # only tier 2 failed the shipped CEO template against this very script —
        # "a coordinator gets no script" is more true of the CEO, not less, and
        # handbook-templates.md § CEO ships none.
        if not (tier in (1, 2) and s == "## Procedure")
        and not (tier == 3 and s == "## Chain of Command")
    ]
    positions, missing = [], []
    for s in expected:
        i = body.find("\n" + s)
        if i < 0:
            missing.append(s)
        else:
            positions.append((i, s))
    res.add(not missing, f"{n}: every required section present",
            f"missing: {missing}")
    ordered = [s for _, s in sorted(positions)]
    res.add(ordered == [s for s in expected if s not in missing],
            f"{n}: sections in the fixed order",
            f"found order: {ordered}")

    # The tier ceiling. What this verifies is PRESENCE OF THE LINE — a property of
    # the text. Runtime behavior is the canary's job, established once per host and
    # never inferred per handbook from the presence of a string.
    # `tools: All tools` IS A DISPLAY STRING, NOT A VALUE — AND IT CRIPPLES THE AGENT.
    #
    # Reported 2026-08-05 by an authoring agent that DECLINED the instruction: told to
    # write `tools: All tools`, it checked the harness and refused, because that phrase
    # is what the harness GENERATES FOR DISPLAY when `tools:` is empty. Written back
    # literally it is parsed as a one-entry allowlist naming a tool that does not exist,
    # so the agent can call NOTHING — while the frontmatter reads as maximally
    # permissive. The failure presents as the opposite of what it is.
    #
    # Checked on EVERY tier, not just tier 3. A delegating tier carries no `tools:` line
    # at all (SKILL.md rule 6), so the string is wrong there too — and it is precisely
    # the tiers with no allowlist whose display output says "All tools", which is where
    # a round-trip through a human or an agent picks the phrase up.
    #
    # This project's own rule, turned on the brief that instructed it: never claim a
    # capability the runtime will not deliver.
    _tools_raw = (fm.get("tools") or "").strip()
    if _tools_raw:
        _toks = {t.strip().lower() for t in _tools_raw.split(",") if t.strip()}
        res.add(_toks != {"all tools"} and "all tools" not in _toks,
                f"{n}: `tools:` is a real allowlist, not the display string",
                "`All tools` is what the harness PRINTS when `tools:` is empty. Written "
                "literally it is a one-entry allowlist naming a tool that does not "
                "exist, so this agent can call nothing while reading as unrestricted. "
                "Omit the field to inherit the default grant")

    if tier == 3:
        # THE OTHER HALF OF RULE 3, which had no mechanical enforcement anywhere.
        # SKILL.md marks both lines BLOCKING; only the denylist was ever checked, so
        # `/workforce verify` could not see half of a blocking rule. A named-teammate
        # spawn discards `disallowedTools:` and honours `tools:` (fact 2d), so the
        # unchecked half is the one that survives that spawn form.
        _tools = (fm.get("tools") or "").strip()
        res.add(bool(_tools) and "agent" not in {t.strip().lower() for t in _tools.split(",")},
                f"{n}: IC carries a `tools:` allowlist omitting Agent",
                "SKILL.md rule 3 refuses to register an IC without it (fact 2d): as a "
                "named teammate its `disallowedTools:` is discarded and it receives "
                "`Agent`. Neither line alone is a ceiling")
        res.add("disallowedTools: Agent" in body,
                f"{n}: IC carries the literal `disallowedTools: Agent`",
                "entry depth does not cap an IC (platform.md fact 2b); the ceiling "
                "is fact 2c's mechanism and it has to be written down")

    # An Agent() allowlist inside a subagent definition is DISCARDED at runtime, so
    # its presence means the org chart is enforced by a mechanism that does nothing.
    res.add(not AGENT_ALLOWLIST_RX.search(body),
            f"{n}: no `Agent(...)` allowlist in the frontmatter",
            "subagent definitions ignore these; the restriction does not exist at runtime")

    # Directives reach the employee, or say plainly that none bind it.
    seg = section(body, "## Directives")
    if seg is not None:
        res.add("(none bound)" in seg or ".claude/workforce/directives/" in seg,
                f"{n}: Directives section resolves or declares none",
                "a blank Directives section reads as 'none bound' and is not")

    # THE SOURCES CONTRACT (v1.7.0). Two rows, both ADVISORY, for the same reason the
    # negative-test record and the version stamp below are advisory: the contract
    # post-dates every deployed handbook, and failing all of them at once reproduces
    # the run that taught this script "a check that always fails stops being read."
    #
    # DELIBERATELY NOT IN `SECTIONS`. Adding it there would make it blocking AND
    # order-checked in one move, against files authored before the section existed —
    # the exact overreach the tier-conditional section list was rewritten to end.
    #
    # ABSENT IS THE DEFECT; `(none)` IS A MEASUREMENT — the convention `## Directives`
    # already uses for `(none bound)`. A pure reviewer or mechanism role legitimately
    # produces nothing from reference material and says so (handbook-templates.md
    # § Sources), so this fires ONLY on total absence and is silent on a handbook that
    # measured itself sourceless. Otherwise the check would push every reviewer to
    # invent a source, which is the failure org-design.md § NEVER INVENT names.
    _sources = section(body, "## Sources")
    if _sources is None:
        res.advise(
            f"{n}: no ## Sources section",
            "the handbook names no authoritative reference material — add a "
            "`## Sources` section after `## Directives` (handbook-templates.md) "
            "naming each reference root or glob, or `Skill(<data-skill>)` for a "
            "read-write store, or the literal `(none)` for a pure reviewer or "
            "mechanism role. An org not wired to its own reference material is "
            "gaslit by its own project: the context an order needs is on disk and "
            "the actor reports it missing (org-design.md § Wiring the org to its "
            "reference material). ADVISORY: this row blocks nothing",
        )
    else:
        # A `Skill(X)` entry is a CHANNEL, not a name. `org-design.md` § The access
        # channel: "a Sources channel naming `Skill(X)` means the employee must be
        # able to invoke X — so its `## Procedure` grants that invocation. Sources
        # says WHERE the truth is + HOW to reach it; the Procedure EXERCISES that
        # reach." A channel no step ever reaches for is a DEAD POINTER: the handbook
        # states where its truth lives and never opens the gateway.
        #
        # Read from `## Procedure` ONLY — the section org-design names as the
        # granting one — and skipped entirely when there is no `## Procedure`, which
        # is the DELEGATING TIERS. A CEO and a Lead carry `## Sources` and no
        # Procedure by design (the same tier-conditional the section list encodes
        # above), so measuring them against a section they must not have would
        # reproduce the 9-false-failures run, one contract later.
        #
        # Prohibition lines are dropped, exactly as the tier-3 skill check below
        # drops them: "NEVER invoke X" names X in order to forbid it.
        #
        # MATCHING IS GENEROUS AND THE RISK IS ONE-SIDED — the same call ROUTING_RX
        # makes. Handbooks write the invocation three ways (`Skill(x)`, `/x`, and
        # prose: "invoke the x skill"), so any word-boundary mention of X in the
        # Procedure counts as naming it; a stricter grammar would report the third
        # form as a dead pointer. What survives is the case with no counter-argument:
        # a Sources channel whose skill the Procedure never mentions at all.
        _proc = section(body, "## Procedure")
        if _proc is not None:
            _proc = "\n".join(l for l in _proc.splitlines()
                              if not PROHIBITION_RX.search(l))
            for _sk in sorted(set(SOURCES_SKILL_RX.findall(_sources))):
                # `Skill(<data-skill>)` is the template's own unfilled slot. Reporting
                # a placeholder as a dead pointer is noise, not a finding.
                if "<" in _sk or ">" in _sk:
                    continue
                if re.search(r"(?<![\w-])" + re.escape(_sk) + r"(?![\w-])", _proc):
                    continue
                res.advise(
                    f"{n}: Sources names Skill({_sk}), which its Procedure never invokes",
                    f"`## Sources` routes this role's reference material through "
                    f"`Skill({_sk})` and `## Procedure` never names {_sk} — the "
                    f"channel is a dead pointer: the handbook says where the truth "
                    f"lives and never reaches for it. Grant the invocation in a "
                    f"numbered step (org-design.md § The access channel is part of "
                    f"every entry), or name the source by the channel it is actually "
                    f"read through. ADVISORY: this row blocks nothing",
                )

    # ADVISORY, and the message has said so since it was written. `delegation-budget.md`
    # § The handbook length ceiling: "over the ceiling is never a refusal and never
    # blocks a sweep. A number nobody measured may not block anyone's work
    # (platform.md § DOCUMENTED)." It was wired to the blocking channel anyway, two
    # functions above the advisory channel that exists for exactly this — so a row
    # declaring itself never a refusal set a non-zero exit, and `INV-VERIFY` reads that
    # exit. MEASURED 2026-08-05 on odyssey-alive: 14 such rows, gating a sweep.
    #
    # The ceiling is a CHOSEN budget (~2.5× a filled IC template), not a measurement,
    # and this project bars a DOCUMENTED fact from becoming a blocking check.
    #
    # NOT-BLOCKING IS NOT NOT-ACTING, and the message used to leak that. It said "a
    # structural finding proposing a split", which reads as a hand-back — the optional
    # "want me to split these?" offer that the no-standing-queue directive (2026-08-10)
    # forbids, and the sibling of the picker that offered "leave as-is" or "trim". The
    # run PERFORMS the split instead: relocation into the grounding library, never
    # condensation (directive one is retention — a trimmed safety example is a lost
    # one), and never a longer handbook accepted as-is.
    body_lines = len(body.splitlines())
    if body_lines <= ceiling:
        res.add(True, f"{n}: within the {ceiling}-line ceiling")
    else:
        res.advise(f"{n}: within the {ceiling}-line ceiling",
                   f"{body_lines} lines — the split is PERFORMED this run: relocate the "
                   f"heavy material (worked examples, mapping tables, reference data) into "
                   f"the grounding library or a data skill, leaving a lean core that reads "
                   f"it on demand. Never trimmed, never condensed, never handed back as a "
                   f"question. ADVISORY: this row blocks nothing")

    # A handbook that cannot say how to verify itself is not releasable.
    #
    # "not empty" was the ENTIRE mechanical coverage of the highest-leverage section
    # in the file until 2026-08-04, and it is satisfied by the word "yes". The two
    # rows below are still properties of the text — whether the check RESOLVES belongs to
    # `wf-checkrun`; whether it RUNS or can FAIL belongs to no shipped tool and is
    # established by hand at amendment time (procedures/amend.md Step 6). Naming that
    # owner here is deliberate: one defect, one verdict, or the counts disagree.
    seg = section(body, "## Verification")
    if seg is not None:
        res.add(bool(seg.strip()), f"{n}: Verification section is not empty")

        # A section that names no command at all is decoration. `verification.md`
        # § Authoring checklist rule 1: "Name the exact command or suite. Not a
        # category — the literal invocation."
        res.add(bool(re.search(r"`[^`\n]+`", seg)),
                f"{n}: Verification names at least one literal invocation",
                "no backticked command anywhere in the section — rule 1 of "
                "verification.md's authoring checklist is a literal invocation, and "
                "prose describing a category is the tier-4 row that file rejects")

        # THE NEGATIVE-TEST RECORD. `procedures/verify.md` already requires this of
        # every invariant classed `mechanical` — "a validator nobody ever saw reject
        # anything — indistinguishable from `exit 0`" — and the rule simply never
        # reached the handbooks, which is where it was needed most.
        #
        # NON-BLOCKING, and that is the GOVERNED-vs-ADOPTED precedent above: every
        # handbook authored before this contract is in this state, and failing them
        # all at once reproduces the 9-false-failures run that taught this script
        # "a check that always fails stops being read."
        if "Negative:" not in seg:
            res.advise(
                f"{n}: Verification declares no negative case",
                "no `Negative:` line — this check has never been observed failing, "
                "so it is indistinguishable from one that cannot fail. Declare a "
                "Negative: line naming a command expected to exit non-zero, and run it "
                "by hand at amendment time (procedures/amend.md Step 6). No shipped "
                "tool executes it.",
            )

    # THE ASK ECHO-BACK (2026-09-01, dispatch CHECKPOINT clauses 6c/6d). A `## Reporting`
    # that never names the REQUEST block describes a return channel where the user's
    # ask cannot be checked against the deliverable — measured on a real org: 252
    # dispatch edges, 2% carrying exit criteria, no OUTPUT.md opening with the ask.
    # ADVISORY for the same governed-vs-adopted reason as the negative-test record:
    # every handbook authored before this contract is in this state.
    seg = section(body, "## Reporting")
    if seg is not None and "REQUEST (verbatim)" not in seg:
        res.advise(
            f"{n}: Reporting does not echo the originating ask",
            "no `REQUEST (verbatim)` in ## Reporting — the OUTPUT.md contract should "
            "open with the work order's REQUEST block quoted unchanged plus a "
            "criterion → evidence table (handbook-templates.md § Reporting), or "
            "spec fidelity cannot be read back at return time.",
        )

    # THE AUTHORING-VERSION STAMP (2026-09-01). Without `workforce-version:` in the
    # ORG-RECORD, nothing can tell a handbook authored under the current doctrine from
    # one three releases stale — which is how two shipped contract releases sat
    # template-only with zero deployed handbooks carrying them and no finding anywhere.
    if "workforce-version:" not in body:
        res.advise(
            f"{n}: ORG-RECORD carries no workforce-version stamp",
            "add `workforce-version: <version>` to the ORG-RECORD `hired:` line "
            "(handbook-templates.md). A handbook that cannot state which release "
            "authored it cannot be flagged as stale when the doctrine moves.",
        )

    # BODY-vs-GRANT COHERENCE — the first check here that compares the text to the
    # capability rather than to another piece of text.
    #
    # `tools:` is a REAL CEILING FOR MCP, measured: platform.md fact 13's fixture held
    # `ToolSearch`, searched a server its grant never named, and the schema was
    # WITHHELD. Granting `ToolSearch` opens no side door. So an explicit `tools:` list
    # that omits a server the body routes work through describes an employee that
    # cannot do its job — and omitting `tools:` entirely does NOT have this problem,
    # because absence inherits every configured server (fact 14).
    #
    # Measured 2026-08-03 by `/workforce verify` against apps-odyssey-alive:
    # `design-imagery` and `research-analyst` passed all 138 checks here and could not
    # reach nanobanana-mcp / playwright-mcp. Every check was about text; none compared
    # the text to the grant. The gap was introduced by the same change that closed the
    # teammate ceiling — adding an explicit allowlist severed an inherited reach nobody
    # had written down as a dependency.
    #
    # Deliberately one-directional: a granted server the body never mentions is NOT a
    # finding. Over-granting is a budget question, and this check has a binary answer
    # or it does not belong here (verify.md § What it deliberately does not cover).
    # AN IC MAY INVOKE ONLY A SKILL THAT SPAWNS NOTHING, and until now nothing checked
    # the skill. `conversion-taxonomy.md`: "the remaining skill spawns nothing — so an
    # IC carrying `disallowedTools: Agent` can invoke it." The doctrine was right and
    # unenforced, so a handbook could instruct an IC to invoke a spawning skill while
    # ASSERTING the safety condition it violated.
    #
    # Measured 2026-08-03: `content-writer` (tier 3, `disallowedTools: Agent`) step 7
    # read "Invoke `/copy-truth check` … it spawns nothing." That skill carries `Task`
    # in `allowed-tools` and ships `agents/interface-claim-auditor/`. A tier ceiling
    # with a documented route around it is not a ceiling.
    # A handbook lives at <root>/.claude/agents/<name>.md, so the project root is three
    # levels up. Derived rather than passed: this function's signature is shared by two
    # call sites and a third for adopted agents.
    _root = os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(path))))
    # MENTION IS NOT USE — the same distinction the MCP check above needed, arrived at
    # the same way: by a first draft reporting two false positives on a real tree.
    #   `## Scope` — "OUT: truth of capability claims (`content-writer` and `/copy-truth`)"
    #                names a skill to DISCLAIM it.
    #   a prohibition — "Do NOT invoke `/copy-truth`" names one to forbid it.
    # Only `## Procedure` and `## Verification` say what the employee DOES, and within
    # them a line carrying NEVER / MUST NOT / STOP / do not is a guardrail, not a step.
    _acts_raw = ""
    for _sec in ("## Procedure", "## Verification"):
        _acts_raw += (section(body, _sec) or "") + "\n"
    _acts = "\n".join(l for l in _acts_raw.splitlines() if not PROHIBITION_RX.search(l))
    # ROUTED SKILLS — collected from the RAW text, per numbered step, before the
    # prohibition filter runs. Two orderings had to be got right and neither is obvious:
    #
    #   RAW, not filtered. The strongest routing evidence a handbook writes is commonly
    #   a prohibition — "**Any change to existing prose → `ESCALATE: /edit <file>`**,
    #   never after" and "You never invoke `/focus` or `/edit` yourself: both spawn, and
    #   you cannot." Filtering prohibitions first DELETES the sentence that proves the
    #   step was re-homed, leaving only the narrative mention that names the skill. The
    #   check then reports the one handbook that stated the ceiling most explicitly.
    #
    #   PER STEP, not per line. The marker and the skill name are routinely a line or
    #   two apart inside one numbered step — "The skill runs one tier up; the work stays
    #   here. `/promote`, `/linkedin-promote`, … each spawn a helper agent … Send
    #   `content-lead` one line — `ESCALATE: run <skill> <args> on my behalf`" names the
    #   skills two lines above an ESCALATE that carries only a `<skill>` placeholder.
    #   The numbered step is the unit of instruction, so it is the unit of scope.
    #
    # The resulting set is file-level: a skill routed in step 4 is routed in step 4a's
    # cross-reference too, which is what "the invocation moves" means.
    _routed, _step = set(), []
    def _harvest(lines):
        blob = "\n".join(lines)
        if ROUTING_RX.search(blob) or PROHIBITION_RX.search(blob):
            _routed.update(re.findall(r"(?<![\w/])/([a-z][a-z0-9-]{2,})\b", blob))
    for _l in _acts_raw.splitlines():
        if re.match(r"\s*\d+[a-z]?\.\s", _l) and _step:
            _harvest(_step)
            _step = []
        _step.append(_l)
    _harvest(_step)
    if tier == 3:
        for sk in sorted(set(re.findall(r"(?<![\w/])/([a-z][a-z0-9-]{2,})\b", _acts))):
            if sk in _routed:
                continue
            sp = os.path.join(_root, ".claude", "skills", sk, "SKILL.md")
            if not os.path.isfile(sp):
                # NOT a project skill. Three legitimate reasons before it is a defect,
                # and MEASURED 2026-08-05 every candidate on two real trees was one of
                # them — so this reports 0 rather than nothing, which are different.
                #   a PERSONAL skill      — resolves from ~/.claude/skills, invisible here
                #   a HARNESS built-in    — /help, /model, /compact … not a project file
                #   a PATH FRAGMENT       — `.../prose-evaluator/AGENT.md` and
                #                           `<run-id>/business-correspondent/OUTPUT.md`
                #                           both matched the command grammar. A trailing
                #                           hyphen or a following `/` means it is a path.
                if (sk.endswith("-") or sk in HARNESS_COMMANDS
                        or re.search(r"/" + re.escape(sk) + r"/", _acts)
                        or os.path.isfile(os.path.expanduser(
                            os.path.join("~", ".claude", "skills", sk, "SKILL.md")))):
                    continue
                # ADVISORY, not a failure: the filters above are heuristics, and this
                # project's rule is that a heuristic reports and never blocks.
                res.advise(f"{n}: /{sk} resolves to no skill in either scope",
                           f"`/{sk}` is named in ## Procedure or ## Verification and is "
                           f"not a project skill, a personal skill, or a harness command. "
                           f"The step cannot be performed as written, and nothing else "
                           f"reported it — this branch was a bare `continue` until "
                           f"2026-08-05")
                continue
            sfm = frontmatter(read(sp, res) or "") or {}
            spawns = {t.strip() for t in sfm.get("allowed-tools", "").split(",")} & {"Task", "Agent"}
            res.add(not spawns, f"{n}: invokes only skills that spawn nothing (/{sk})",
                    f"`/{sk}` carries {sorted(spawns)} in its `allowed-tools`, so invoking it is a "
                    f"spawn path around this IC's `disallowedTools: Agent`. Re-home the step to a "
                    f"delegating tier, or reduce the skill — do NOT strip its tool if it ships agents "
                    f"that need it (conversion-taxonomy.md § an IC may invoke a skill that spawns "
                    f"nothing).")

    granted = fm.get("tools")
    if granted is not None:
        wanted = set()
        for line in FM_RX.sub("", body, count=1).splitlines():
            if PROHIBITION_RX.search(line):
                continue          # named to forbid it, not to use it
            wanted |= {s.lower() for s in MCP_TOOL_RX.findall(line)}
            wanted |= {s.lower() for s in MCP_SLUG_RX.findall(line)}
        have = {s.lower() for s in MCP_TOOL_RX.findall(granted)}
        missing = sorted(wanted - have)
        res.add(
            not missing,
            f"{n}: every MCP server its body uses is named in tools:",
            "body routes work through " + ", ".join(missing)
            + f" but `tools:` grants {sorted(have) or 'no MCP server'} — an explicit "
              "allowlist is a hard ceiling for MCP (fact 13), so this employee cannot "
              "reach it. Add `mcp__<server>` at server level, and do NOT add ToolSearch "
              "alongside it: fact 13 measured that ToolSearch DEFERS tools that arrive "
              "loaded without it.",
        )


def check_defects(root, res):
    """Every DEF record names its class fix, and every record reaches the index.

    THE FIELD THAT STOPS INSTANCE-ONLY FIXING. A DEF is written at the moment
    someone is repairing an instance, so that is where the question "what stops the
    NEXT project hitting this?" has to be forced. `personnel-templates.md` § DEF makes
    `Class fix:` mandatory with exactly two legal values: a named workforce file, or
    `INSTANCE-ONLY` with a reason.

    Measured 2026-08-03: three defects found by cold readers were fixed in the target
    project and left standing in the skill that generates it. The rule already existed
    in three files. Restating it a fourth time was not the fix; a checked field was.

    AND EVERY RECORD IS INDEXED. Four DEF records sat unindexed while the project's own
    `check-personnel-index.sh` was ready to catch it and nobody ran it. A record nothing
    points at is a record the next reader does not know exists.
    """
    pdir = os.path.join(root, ".claude", "workforce", "personnel")
    ddir = os.path.join(pdir, "defects")
    if not os.path.isdir(ddir):
        return                      # no defects yet is legal

    names = sorted(f for f in os.listdir(ddir)
                   if f.startswith("DEF-") and f.endswith(".md"))
    if not names:
        return                      # an empty defects/ is also legal

    # Read the index only once a record exists to check against it. Reading it
    # unconditionally made a project with an empty `defects/` and no index.md report
    # `unreadable` -> exit 2 -> "the tree could not be read", which is a false alarm
    # about the whole run. Found by the fixture written for this very check.
    ipath = os.path.join(pdir, "index.md")
    index = (read(ipath, res) or "") if os.path.exists(ipath) else ""
    res.add(os.path.exists(ipath), "personnel index exists to record defects in",
            f"{len(names)} DEF record(s) on disk and no {ipath}")

    for fn in names:
        body = read(os.path.join(ddir, fn), res)
        if body is None:
            continue
        stem = fn[:-3]

        m = re.search(r"^\*\*Class fix:\*\*\s*(.+)$", body, re.M)
        val = (m.group(1).strip() if m else "")
        res.add(bool(m), f"{stem}: names a Class fix",
                "a defect in a generated org is evidence about the generator; without this "
                "field the shape recurs in the next project (personnel-templates.md § DEF)")
        if m:
            # INSTANCE-ONLY must carry a reason; anything else must name a file.
            if val.upper().startswith("INSTANCE-ONLY"):
                ok = len(val) > len("INSTANCE-ONLY") + 4
                detail = "`INSTANCE-ONLY` with no reason is not a disposition"
            else:
                ok = bool(re.search(r"[\w./-]+\.(md|py|sh)\b|`[^`]+`", val))
                detail = ("names an intention rather than a file — a class fix is a change to a "
                          "named workforce file, or it is INSTANCE-ONLY with a reason")
            res.add(ok, f"{stem}: Class fix is a file or a reasoned INSTANCE-ONLY", detail)

        res.add(stem in index, f"{stem}: appears in the personnel index",
                "a record nothing points at is one the next reader never finds")


def check_removal_set(root, body, staging, res):
    """The removal set has exactly one producer, and every decided removal reaches it.

    THE MARK IS A COMMITTED `T7c` ROW. `procedures/hire.md` § The journal, and both
    consumers — `audit.md` § Step 6c and `sweep.md` § 3 — enumerate the removal set
    from those rows and nothing else.

    This function exists because that row had a reader and no writer, twice over:

      A  `T7c` was inserted into the T-order on 2026-08-04 and made the mark
         conditional. The sentence defining the mark still said "the COMMITTED T7
         journal row", and no row shape was defined for the step the mark moved to.
      B  A skill removed by SUCCESSION is never converted, so it never enters the
         T-order at all. `conversion-taxonomy.md` decided those removals and — until
         2026-08-06 — contained the string "journal" zero times.

    Measured on odyssey-alive across three consecutive audits: `skill-builder`
    dispositioned SUPERSEDED GENERATOR / removed entirely, `.claude/skills/skill-builder/`
    on disk the whole time, ZERO journal rows naming it, 32 `T7` rows and ZERO `T7c`
    rows. Every run printed `INV-SUCCESSION  sweep NOT executed — removal set is empty`
    and every run was reporting the arithmetic of a table nothing filled in.

    Read literally instead, the old definition made the removal set all 32 T7 rows —
    every one of them a reduced, still-invocable skill that directive one requires to
    keep working. A gate in front of the only destructive command may not have two
    readings that differ by the whole library, which is why this is a failure and not
    an advisory.

    Four findings, each a different missing half:
      UNSTAGED   dispositioned for removal, no `T7c` row   -> the sweep cannot see it
      UNMARKED   `T7s` staged, no `T7c` row                -> bytes copied for nothing
      NO-UNDO    `T7c` row, no `T7` or `T7s` row           -> marked with no undo behind it
      NO-TREE    `T7s` row, no staged `tree/`              -> the surgical undo covers
                                                              SKILL.md and nothing else
    """
    marked, staged, undone, declined = set(), set(), set(), set()
    for line in body.splitlines():
        cells = [c.strip().strip("`") for c in line.strip().strip("|").split("|")]
        if len(cells) < 7:
            continue
        name, step, status = cells[1], cells[2], cells[6]
        # A REFUSAL IS A FIRST-CLASS OUTCOME AND IT IS RECORDED, NOT MISSING.
        # Failure containment (SKILL.md § Atomic-or-Absent rule 7) marks a target ✗
        # and continues — a short extraction at T2 is the common case, and it is
        # SUPPOSED to leave the target unmarked. Without this the run that correctly
        # refused a removal would be failed for refusing it, on every later verify,
        # with no edit that could ever clear it.
        if status == "✗" and step in ("T2", "T7s", "T7c"):
            declined.add(name)
            continue
        if status != "COMMITTED":
            continue
        if step == "T7c":
            marked.add(name)
        elif step == "T7s":
            staged.add(name)
            undone.add(name)
        elif step == "T7":
            undone.add(name)
    staged -= declined

    for name in sorted(marked - undone):
        res.add(False, f"removal set: {name} marked at T7c has an undo row",
                f"a COMMITTED T7c row marks {name} for the sweep and no T7 or T7s row "
                "records an `.orig` for it. The mark is what the sweep reads and the "
                "`.orig` is its only surgical undo; a mark without one authorizes a "
                "deletion whose single-file reversal was never written.")
    for name in sorted(staged - marked):
        res.add(False, f"removal set: {name} staged at T7s reached its T7c mark",
                f"{name} was staged for removal and never marked. `hire.md` § A removal "
                "target stages too: T7s never appears without its T7c — either the mark "
                "is missing, or a rule declined the removal and the run owes that rule "
                "by name.")
    for name in sorted(staged):
        tree = os.path.join(staging, name, "tree")
        res.add(os.path.isdir(tree), f"removal set: {name} staged its whole directory",
                f"{tree} is absent. A T7s target is unlinked ENTIRELY — references/, "
                "scripts/, hooks/, and every dataset go with it — so SKILL.md.orig is "
                "an undo for the least of what the sweep removes.")

    # THE DECIDED-BUT-UNSTAGED CASE. Keyed on the taxonomy's own category token so a
    # renamed generator is still caught: `conversion-taxonomy.md` § ORCHESTRATOR names
    # SUPERSEDED GENERATOR as the disposition that is "removed entirely — not retained,
    # not converted, not stubbed", and dispositions.md writes it in the disposition cell.
    dp = os.path.join(root, ".claude", "workforce", "dispositions.md")
    if not os.path.exists(dp):
        return
    disp = read(dp, res)
    if disp is None:
        return
    decided = set()
    for line in disp.splitlines():
        cells = [c.strip().strip("*").strip("`").strip() for c in
                 line.strip().strip("|").split("|")]
        if len(cells) < 3 or not cells[0]:
            continue
        blob = " ".join(cells[1:])
        if "SUPERSEDED GENERATOR" in blob or "Removed entirely" in blob:
            decided.add(cells[0].strip("*").strip("`").strip())
    for name in sorted(decided & declined):
        res.advise(f"removal set: {name} was dispositioned for removal and declined",
                   "the journal records a ✗ against it, so the run refused the removal "
                   "and said so. Reported, never enforced — refusing an act is the "
                   "design; the finding is a run that neither stages nor refuses.")
    for name in sorted(decided - marked - declined):
        res.add(False, f"removal set: {name} was dispositioned for removal and staged",
                f"dispositions.md decides {name} is removed entirely and the conversion "
                "journal holds no COMMITTED T7c row for it, so the removal set the sweep "
                "reads does not contain it. Run `/workforce audit` — Step 6-S stages it "
                "(T2 extract, T7s copy, T7c mark) and Step 6c performs the deletion. An "
                "empty removal set under a decided removal is a finding about the staging "
                "step, never a description of the tree.")
    if decided:
        res.add(True, f"removal set: {len(decided)} dispositioned · "
                      f"{len(staged)} staged · {len(marked)} marked")

    for name in sorted(decided | staged):
        check_removal_extraction(root, name, res)


def check_removal_extraction(root, name, res):
    """T2 for a removal target: every sacred span inside it is extracted first.

    THIS IS THE ONE GATE STANDING BETWEEN A DIRECTORY DELETION AND THE USER'S OWN
    WORDS. `conversion-taxonomy.md` § What succession removes: those spans "are the
    only content in a managed tree that no regeneration can reconstruct", and the
    gate is blocking BEFORE the first file is removed.

    It was specified and it was not computable. `INV-DIRECTIVES` counts `N of N`
    TREE-WIDE; T2 for a T7s target asks a DIRECTORY-scoped question, and `wf-census`
    published only the aggregate. So the only way to answer it was a hand grep —
    which, run unanchored on 2026-08-06, reported 37 sacred spans inside
    `skill-builder` against the true 6, by matching indented examples and markers
    quoted mid-line inside a file that DOCUMENTS the marker format. A gate answered
    by a hand count is a gate whose verdict changes with who runs it.

    `wf-census` now emits `immutable_blocks.by_file` with line numbers, and this
    check uses the same line-anchored grammar `bin/check` cross-tests across every
    reader. Coverage is joined on `file:line`, so a shortfall names the span rather
    than the difference between two totals.

    `.claude/workforce/directives/` is the extraction output and citations may live
    in ANY file there — the run keys them by skill, and a run that keyed them
    differently still cites the same `file:line`. Scanning the directory rather than
    one filename is what makes this robust to that.
    """
    target = os.path.join(root, ".claude", "skills", name)
    if not os.path.isdir(target):
        return                          # already swept, or never a directory

    spans = []
    for dirpath, dirnames, filenames in os.walk(target):
        dirnames[:] = [d for d in dirnames if d not in (".git", "node_modules")]
        for fn in sorted(filenames):
            if not fn.endswith(".md"):
                continue                # the census grammar is markdown-scoped
            p = os.path.join(dirpath, fn)
            try:
                body = open(p, encoding="utf-8", errors="replace").read()
            except OSError:
                continue
            rel = os.path.relpath(p, root)
            for lineno, line in enumerate(body.splitlines(), 1):
                if IMMUTABLE_OPEN_RX.match(line):
                    spans.append((rel, lineno))
    if not spans:
        res.add(True, f"removal set: {name} holds no sacred spans to extract")
        return

    ddir = os.path.join(root, ".claude", "workforce", "directives")
    cited = set()
    if os.path.isdir(ddir):
        for dirpath, _dn, filenames in os.walk(ddir):
            for fn in filenames:
                try:
                    blob = open(os.path.join(dirpath, fn),
                                encoding="utf-8", errors="replace").read()
                except OSError:
                    continue
                for skill, path, line in EXTRACT_CITE_RX.findall(blob):
                    cited.add((f".claude/skills/{skill}/{path}", int(line)))

    missing = [f"{f}:{n}" for f, n in spans if (f, n) not in cited]
    res.add(not missing,
            f"removal set: {name} extracted {len(spans) - len(missing)} of "
            f"{len(spans)} sacred span(s) before deletion",
            ("not extracted: " + ", ".join(missing[:6])
             + (f" (+{len(missing) - 6} more)" if len(missing) > 6 else "")
             + ". These are the user's own words and the sweep unlinks the directory "
               "holding them. T2 is blocking: extract them verbatim with their source "
               "`file:line`, or the target is marked ✗ and NOT swept."))


def check_journal(root, res):
    """Every T7 and T7s row's `.orig` exists on disk and hashes to its prior-sha.

    THE UNDO ARTIFACT, CHECKED AS AN ARTIFACT. `SKILL.md` § Atomic-or-Absent rule 6:
    "T7 IS COPY-THEN-MARK. Copy the live SKILL.md to `<staging>/<name>/SKILL.md.orig`
    and record its sha in the journal BEFORE marking it. `.orig` is retained after the
    run and is the single-file undo."

    `audit.md` Step 6c precondition 4 guarded this as *"every marked skill has its
    `.orig` recorded and hashed IN THE JOURNAL"* — and that is the whole defect. It
    reads the journal to check a claim the journal makes about itself. A row can say
    `prior-sha: see .orig` with no `.orig` anywhere and satisfy it.

    Measured 2026-08-03 on apps-odyssey-alive: journal row 101 marked `skill-builder`
    at T7, status COMMITTED, `prior-sha` reading `see .orig`, and ZERO `.orig` files on
    disk. The sweep is the only command that deletes and this is its only single-file
    undo; the gate in front of it could not tell the difference between an undo that
    existed and a sentence saying one did.

    Two findings, kept separate because they need different fixes:
      MISSING   no file at the staging path       -> the undo does not exist
      DRIFT     file present, sha != prior-sha    -> it exists and is not what was
                                                    recorded; restoring it would write
                                                    bytes nobody verified

    A `prior-sha` that is not 64 hex characters is itself reported: the spec says
    record the sha, and a pointer ("see .orig") is what let this hide.
    """
    jp = os.path.join(root, ".claude", "workforce", ".conversion-journal.md")
    if not os.path.exists(jp):
        return                      # no journal is not a finding; day-one is legal
    body = read(jp, res)
    if body is None:
        return

    staging = os.path.join(root, ".claude", "workforce", "staging")
    check_removal_set(root, body, staging, res)
    rows = 0
    for line in body.splitlines():
        cells = [c.strip().strip("`") for c in line.strip().strip("|").split("|")]
        if len(cells) < 7 or cells[2] not in ("T7", "T7s"):
            continue
        step = cells[2]
        name, path_cell, prior, status = cells[1], cells[3], cells[5], cells[6]
        # N/A rows are printed deliberately (a hire has no predecessor to copy).
        if "N/A" in status or "N/A" in prior or status == "✗":
            continue

        # AGGREGATE ROWS ARE NOT SKILLS. A journal may mark a class of edits in one
        # row — "(all skills) | scaffolding blocks emitted by skill-builder" — and
        # such a row has no single SKILL.md and never had an `.orig`. The path cell
        # decides it: a real conversion row names a skill directory that exists.
        # Without this the check demanded `staging/(all skills)/SKILL.md.orig`, a
        # path nothing was ever going to write, and reported its absence as the same
        # defect as a genuinely missing undo. One finding was real and one was the
        # check misreading a row; reporting them identically devalues both.
        if not os.path.isdir(os.path.join(root, path_cell)):
            res.add(True, f"journal: {name} {step} is an aggregate row (undo is the backup)")
            continue

        rows += 1
        orig = os.path.join(staging, name, "SKILL.md.orig")
        if not os.path.exists(orig):
            res.add(False, f"journal: {name} {step} `.orig` exists on disk",
                    f"row stages {name} at {step} with status {status}, and {orig} is absent. "
                    "The sweep's single-file undo does not exist. Restore it from the "
                    "pre-run backup before any deletion.")
            continue
        res.add(True, f"journal: {name} {step} `.orig` exists on disk")
        if not re.fullmatch(r"[0-9a-f]{64}", prior or "", re.I):
            res.add(False, f"journal: {name} {step} prior-sha is a sha",
                    f"prior-sha reads {prior!r}. The spec records a sha; a pointer "
                    "cannot be compared against anything, which is how a missing "
                    "`.orig` passed a gate that claimed to hash it.")
            continue
        got = hashlib.sha256(open(orig, "rb").read()).hexdigest()
        res.add(got == prior.lower(), f"journal: {name} {step} `.orig` matches prior-sha",
                f"recorded {prior[:16]}…, on disk {got[:16]}… — the undo artifact is "
                "not the file that was recorded. Do not restore from it.")
    if rows:
        res.add(True, f"journal: {rows} T7/T7s row(s) checked against disk")


def check_catalogs(root, res):
    """Every evaluator carries a catalog anchor before the sweep can remove the source.

    `evaluators.md` § Succession removes the source makes reconciliation a PRECONDITION
    of the sweep: the predecessor's catalog is readable only while it is still on disk,
    and after the sweep the comparison has no input at all.

    **`v0` and `reconciled, nothing to add` are opposite facts about the same zero**, and
    without an anchor nothing can tell them apart. Measured 2026-08-03: all three
    evaluators in a real project read `v0`, and the only genuine catalog pairing turned
    out to be 0-missing — so a sweep would have frozen three catalogs permanently while
    every visible number looked fine.
    """
    sk = os.path.join(root, ".claude", "skills")
    if not os.path.isdir(sk):
        return
    evs = sorted(d for d in os.listdir(sk)
                 if os.path.isdir(os.path.join(sk, d))
                 and ("eval" in d or "evaluator" in d))
    for e in evs:
        anchor = os.path.join(sk, e, "CATALOG-ANCHOR.md")
        ok = os.path.isfile(anchor)
        res.add(ok, f"catalogs: {e} carries a reconciliation anchor",
                "no CATALOG-ANCHOR.md — reads as v0, never reconciled. The sweep removes the "
                "predecessor and with it the only thing this could be compared against "
                "(evaluators.md § Succession removes the source).")


def check_data_skill(path, body, res):
    n = os.path.relpath(path)
    missing = [s for s in DATA_SKILL_SECTIONS if ("\n" + s) not in body]
    res.add(not missing, f"{n}: data skill carries every required section",
            f"missing: {missing}")
    if "## Invariants" in body:
        seg = section(body, "## Invariants") or ""
        res.add("may never authorize a write" in seg,
                f"{n}: carries the universal invariant",
                "degraded state may cause more work; it may never authorize a write")


def check_sidecar(root, res):
    """Verify immutable-block digests against the sidecar, in the CANONICAL format.

    `procedures/checksums.md` § The row grammar is the authority, and both readers
    now implement it: one row per BLOCK, sha over the NORMALIZED block content.

        <sha256>  <path-relative-to-project-root>:directive:<N>

    This reader and `wf-protect-directives` used to disagree on both halves — this
    one split on a double space and hashed whole FILE bytes, that one parsed
    `:directive:N` and hashed normalized BLOCK content. Neither could ever agree
    with the other, and no canonical format was written down anywhere, which is
    verbatim the incident `checksums.md` opens by citing:

        "a checksum generator wrote rows its own parser could not read. The hook
         then reported clean about blocks it never examined."

    Generators are strict; readers are liberal (checksums.md rule 1) — so a
    malformed row is REPORTED, never silently skipped. A row this reader cannot
    parse is a coverage gap, and a coverage gap is a finding.
    """
    side = os.path.join(root, ".claude", "workforce", ".directives.sha")
    if not os.path.exists(side):
        res.add(True, "sidecar: absent (no directives extracted yet)",
                "absent is a first-class state, not an error")
        return
    body = read(side, res)
    if body is None:
        return

    data = [l for l in body.splitlines() if l.strip() and not l.startswith("#")]
    rows, malformed = {}, []
    for line in data:
        m = ROW_RX.match(line)
        if m:
            rows.setdefault(m.group(2), {})[int(m.group(3))] = m.group(1).lower()
        else:
            malformed.append(line.strip()[:70])

    # A sidecar with data lines and no parseable rows is NO coverage, not clean.
    if data and not rows:
        res.add(False, "sidecar: parses",
                f"{len(data)} data line(s), none parseable — this is the state that "
                "reports clean about blocks it never examined")
        return
    for bad in malformed:
        res.add(False, f"sidecar: malformed row {bad!r}", "canonical grammar: <sha>  <path>:directive:<N>")

    for rel, blocks in sorted(rows.items()):
        p = os.path.join(root, rel)
        if not os.path.exists(p):
            res.add(False, f"sidecar: {rel} present", "a stamped row names a file that is gone")
            continue
        body_f = read(p, res)
        if body_f is None:
            continue
        found = [normalize(m.group(1)) for m in BLOCK_RX.finditer(body_f)]
        for i, want in sorted(blocks.items()):
            if i > len(found):
                res.add(False, f"sidecar: {rel}:directive:{i} present",
                        "the sidecar stamps a block the file no longer has")
                continue
            got = hashlib.sha256(found[i - 1].encode("utf-8")).hexdigest()
            res.add(got == want, f"sidecar: {rel}:directive:{i} digest matches",
                    "a sacred block changed after it was stamped — flag, never repair")

    # ── COVERAGE: the denominator comes from the TREE, never from the sidecar ──
    # Everything above iterates `rows` — the blocks the sidecar already names — so it
    # answers "do the stamped blocks still match?" and never "is every block stamped?"
    # A block absent from the sidecar was checked by nothing and reported by nothing:
    # `wf-protect-directives` would call it UNPROTECTED, and this file said `0 failed`.
    #
    # MEASURED 2026-08-07 by `/workforce dev sweep` on this repository. The tree held 13
    # sacred blocks and the sidecar stamped 12. The unstamped one was a cold reader's
    # question quoted verbatim inside an `origin: user | immutable: true` span at column
    # 0 in a `DEF` record — a real protected span, guarded by nothing, while the gate
    # `procedures/sweep.md` step 4 calls "the sacred-block gate, short by one → STOP"
    # read N of N and let a destructive command proceed.
    #
    # Same shape as the vacuous attribution guard in `bin/check` fixed the day before: a
    # check that verifies what it was TOLD about rather than what EXISTS. Both were green
    # for as long as they were wrong, which is the property that makes the class dangerous.
    #
    # Scoped to `.claude/`: the sidecar's rows are project-tree paths, and a source
    # distribution under `workforce/` carries its own stamp in `workforce/.immutable.sha`.
    #
    # THE DENOMINATOR IS THE CENSUS'S, not this file's. `.censusignore` is read
    # through `wf-census` so that what counts as project content is decided in one
    # place; the directory-name prune this loop used to carry is gone, because it
    # answered a question the project alone is allowed to answer (`_load_census`).
    unstamped = []
    census = _load_census().Census(root)
    census.load_ignore()
    claude_dir = os.path.join(root, ".claude")
    for dirpath, dirnames, filenames in os.walk(claude_dir):
        dirnames[:] = [d for d in dirnames
                       if not census.ignored(os.path.join(dirpath, d))]
        for fn in sorted(filenames):
            if not fn.endswith(".md"):
                continue
            p = os.path.join(dirpath, fn)
            if census.ignored(p):
                continue
            rel = os.path.relpath(p, root)
            try:
                with open(p, encoding="utf-8") as fh:
                    n = len(BLOCK_RX.findall(fh.read()))
            except OSError:
                continue
            for i in range(1, n + 1):
                if i not in rows.get(rel, {}):
                    unstamped.append(f"{rel}:directive:{i}")
    res.add(not unstamped,
            f"sidecar: every sacred block on disk is stamped ({len(unstamped)} unstamped)",
            f"{unstamped[:5]} — a block the sidecar does not name is guarded by nothing, and "
            "coverage counted against the sidecar's own row set reports N of N while short. "
            "Regenerate the sidecar with the `checksums` command")


# ── the canary record ────────────────────────────────────────────────────────
# A run's own report is not a record. Every INV-CANARY row that reads PASS is a claim
# that this host was measured; `platform-local.md` is the only place that measurement
# survives the run, and `audit.md` Step 4b returns `PASS (on record)` — skipping the
# spawn — solely on the strength of it.
#
# MEASURED 2026-08-06 on this repository: `org-config.md` recorded
# `INV-CANARY … attempt 1 PASS` and no `platform-local.md` existed anywhere in the
# tree. Four documents instruct a run to write that file and nothing produced it, so
# the measurement was taken, reported, and lost — and every later run has to re-take
# it while reading a record that says it already passed.
#
# THIS CHECK LIVES IN A SHIPPED SCRIPT, NOT IN `bin/check`, and the reason is
# mechanical: `.gitignore` ignores `/.claude/`, so a repo-side assertion about
# `.claude/workforce/` passes VACUOUSLY on a fresh clone — it would be an enforcement
# whose population is empty everywhere except the maintainer's own working tree. The
# state being checked belongs to a live project, so the checker has to run against one.
INV_CANARY_LINE_RX = re.compile(r"^.*INV-CANARY.*$", re.M)
RECORDED_PASS_RX = re.compile(r"\bPASS\b")
# `| harness | `claude --version` → **2.1.223** |` — the row an audit writes into
# org-config.md. Both arrow forms, and the bold markers are optional.
HARNESS_RX = re.compile(r"claude --version`?\s*(?:→|->)\s*\**([0-9]+(?:\.[0-9A-Za-z]+)+)")
MEASURED_ON_RX = re.compile(r"^MEASURED-ON:.*$", re.M)
VERSION_RX = re.compile(r"([0-9]+(?:\.[0-9A-Za-z]+)+)")
RECORD_CMD = ("wf-apply --root <tree> --record-canary --tier-limit <N> "
              "--c1 'PASS: …' --c2 'PASS: …' --by '<run>' --execute")


def check_canary_record(root, res):
    """A recorded canary PASS must have the durable record it licenses.

    Three states are clean and each says so rather than returning silently — a check
    that skips is indistinguishable from a check that passed, which is the failure
    mode this whole script is written against.
    """
    cfg_path = os.path.join(root, ".claude", "workforce", "org-config.md")
    if not os.path.exists(cfg_path):
        res.add(True, "canary record: no org-config.md — nothing has been recorded yet",
                "absent is a first-class state, not an error")
        return
    cfg = read(cfg_path, res)
    if cfg is None:
        return

    rows = INV_CANARY_LINE_RX.findall(cfg)
    if not rows:
        res.add(True, "canary record: org-config.md records no INV-CANARY row",
                "an unrun canary owes no record")
        return
    # Scoped to the INV-CANARY row's OWN text. A substring test over the whole file
    # would read the word PASS out of any neighbouring prose — the mistake this
    # project has made in three separate checkers.
    if not any(RECORDED_PASS_RX.search(r) for r in rows):
        res.add(True, "canary record: INV-CANARY records no PASS — nothing to reconcile",
                "UNAVAILABLE and FAIL record no measurement, so neither owes a file")
        return

    local_path = os.path.join(root, ".claude", "workforce", "platform-local.md")
    if not os.path.exists(local_path):
        res.add(False, "canary record: INV-CANARY records PASS and platform-local.md exists",
                f"`.claude/workforce/platform-local.md` is ABSENT while org-config.md "
                f"records {rows[0].strip()[:90]!r}. The measurement was taken and never "
                f"written down, so `audit.md` Step 4b can never return `PASS (on record)` "
                f"and every future run re-measures a host that was already measured. "
                f"Write it: {RECORD_CMD}")
        return
    local = read(local_path, res)
    if local is None:
        return

    stamp = MEASURED_ON_RX.search(local)
    if not stamp:
        res.add(False, "canary record: platform-local.md carries a MEASURED-ON stamp",
                "the record exists and names no harness version, so nothing can ever "
                "decide whether it matches the running harness — the one question "
                "`platform.md` § levels asks of it")
        return

    harness = HARNESS_RX.search(cfg)
    if not harness:
        res.add(True, "canary record: platform-local.md exists "
                      "(org-config.md records no harness version to reconcile against)",
                "the existence half is checked; the version half has no second reading "
                "to compare with, and that boundary is stated rather than assumed")
        return

    got = VERSION_RX.search(stamp.group(0))
    res.add(bool(got) and got.group(1) == harness.group(1),
            f"canary record: platform-local.md MEASURED-ON matches the recorded harness "
            f"({harness.group(1)})",
            f"org-config.md records harness `{harness.group(1)}`; platform-local.md says "
            f"`{stamp.group(0).strip()}`. A record stamped with a different harness than "
            f"the run that took it cannot answer whether it matches the running one, so "
            f"Step 4b would return `PASS (on record)` for a measurement made elsewhere. "
            f"Re-record it: {RECORD_CMD}")


# ── INV-COMPANIONS: the companion skills an audit must have materialized ─────
# The distribution ships NO companion skill DIRECTORY. `org`, `operating-principles`,
# `personnel-ledger`, `code-evaluator`, `text-eval` and `security-evaluator` are
# MATERIALIZED by an audit out of shipped doctrine, and `/org` specifically is
# GENERATED by `org index` — it exists in no tarball and no installer will ever fetch
# it. So "install the shipped version" is an unsatisfiable instruction, and a literal
# run reasoned "ships none → install none" and skipped the step.
#
# MEASURED: an audit ran TWICE on a fresh project and never created
# `.claude/skills/org/SKILL.md`. Both runs reported clean, because no `bin/` check and
# no invariant asserted companion presence after an audit — the skip cost nothing, so
# nothing distinguished "materialized six" from "materialized none". Rewording the
# doctrine alone would land a rule with no mechanism, which is this project's one
# repeating failure; this is the mechanism half.
#
# THIS CHECK LIVES IN A SHIPPED SCRIPT, NOT IN `bin/check`, for check_canary_record's
# reason verbatim: `.gitignore` ignores `/.claude/`, so a repo-side assertion about
# `.claude/skills/` passes VACUOUSLY on every clone but the maintainer's working tree.
# The state belongs to a live project, so the checker has to run against one.
#
# THE POPULATION IS A TREE AN AUDIT HAS FINISHED, and it takes BOTH signals to be in
# it: `org-config.md` — the org record an audit writes — AND at least one GOVERNED
# handbook, the employees it staffs. Either one alone is a tree mid-flight, or a
# fixture exercising one half, and asserting companions there fails trees where no
# audit ever ran. That is the "a check that always fails stops being read" failure
# this script already carries a scar from — the staged-draft comparison in `main()`
# failed 16 of 16 on the first real tree it met, and had to be demoted to advisory.
#
# THE COUNTED LINE AND THIS CHECK ARE NOT THE SAME ENFORCEMENT, and both are owed.
# `audit-setup.md` Step 0.3 prints `INV-COMPANIONS  N of 6 materialized` DURING the
# run — a procedural row, and a run that skipped the step can print whatever it likes.
# This is the structural half: it reads the disk afterwards and does not consult the
# run's own account of itself. The list below is the one restatement of
# `invariants.md` row 23 / `audit-setup.md` Step 0.3, and it is restated because an
# enforcement cannot import prose; if the six ever change, they change in both.
CORE_COMPANIONS = ("org", "operating-principles", "personnel-ledger",
                   "code-evaluator", "text-eval", "security-evaluator")


def check_companions(root, res, governed_n):
    """INV-COMPANIONS — after an audit, every core companion skill is on disk.

    Absence is a FAIL, not a report: the run that skipped them reported clean twice.
    The no-population state says so out loud rather than returning silently, because
    a check that skips is indistinguishable from a check that passed.
    """
    cfg_path = os.path.join(root, ".claude", "workforce", "org-config.md")
    if not os.path.exists(cfg_path) or governed_n == 0:
        res.add(True, "companions: no completed audit in this tree "
                      "(INV-COMPANIONS has no population)",
                f"an audit leaves BOTH `.claude/workforce/org-config.md` "
                f"({'present' if os.path.exists(cfg_path) else 'ABSENT'}) and at least "
                f"one governed handbook (found {governed_n}). With either missing, no "
                f"audit has finished here and none of the six companions is owed yet")
        return

    missing = [n for n in CORE_COMPANIONS
               if not os.path.isfile(os.path.join(root, ".claude", "skills", n, "SKILL.md"))]
    if not missing:
        res.add(True, f"INV-COMPANIONS: all {len(CORE_COMPANIONS)} core companion "
                      f"skills exist")
        return

    # NAMES EVERY MISSING ONE, not a count. "3 companions missing" sends the reader
    # back to the source to find out which, and the whole defect this is written
    # against was a step that quietly did nothing.
    detail = ("ABSENT after an audit: "
              + " · ".join(f".claude/skills/{n}/SKILL.md" for n in missing) + ". ")
    if "org" in missing:
        detail += ("`/org` is ABSENT and it is the hard failure: the receptionist is "
                   "GENERATED by `org index`, ships in no distribution, and no "
                   "installer will ever fetch it — so nothing else in the run will "
                   "notice. ")
    detail += ("The distribution ships NO companion skill directory; companions are "
               "MATERIALIZED from shipped doctrine, never copied, so 'ships none' is "
               "not a licence to install none. Generate each missing one "
               "(`audit-setup.md` Step 0.3) and re-run.")
    res.add(False, "INV-COMPANIONS: every core companion skill exists after an audit",
            detail)


def main():
    ap = argparse.ArgumentParser(prog="wf-conform")
    ap.add_argument("--root", default=".")
    ap.add_argument("--json", dest="json_path")
    ap.add_argument("--ceiling", type=int, default=DEFAULT_LENGTH_CEILING)
    ap.add_argument("--strict-adopted", action="store_true",
                    help="hold adopted agents to the full handbook contract too "
                         "(they are exempt by default: workforce did not author them)")
    ap.add_argument("--quiet", action="store_true")
    args = ap.parse_args()

    # AN EMPTY --root IS A CALLER ERROR, NEVER A SILENT RETARGET TO CWD.
    # `${CLAUDE_PROJECT_DIR}` is UNSET in the Bash tool — measured 2026-08-04 on
    # 2.1.221 — so every shipped `--root "${CLAUDE_PROJECT_DIR}"` block expands to
    # `--root ""`. `os.path.abspath("")` is the CWD, which is a real directory, so a
    # is-it-a-directory guard passes and the tool examines a tree nobody named.
    # Measured: `wf-conform --root ""` in an empty dir exited 0 reporting
    # "0 governed · 0 failed" — a validator reporting health it never measured, which
    # is the exact contract procedures/verify.md states five lines under the block
    # that produces it.
    if not (args.root or "").strip():
        print("wf-conform: --root is empty. ${CLAUDE_PROJECT_DIR} is unset outside a "
              "hook; pass an explicit path.", file=sys.stderr)
        return 2

    root = os.path.abspath(args.root)
    if not os.path.isdir(root):
        print(f"wf-conform: not a directory: {root}", file=sys.stderr)
        return 2

    res = Result()
    agents_dir = os.path.join(root, ".claude", "agents")
    handbooks = []
    if os.path.isdir(agents_dir):
        for dp, _dn, fns in os.walk(agents_dir):
            handbooks += [os.path.join(dp, f) for f in fns if f.endswith(".md")]
    # GOVERNED vs ADOPTED. The ORG-RECORD block is the discriminator because it is
    # the thing workforce writes and nothing else does — an agent without one was
    # never placed under this contract. Frontmatter cannot decide it: `name:` and
    # `description:` are universal.
    # Counted on the ORG-RECORD marker alone, NOT on `len(handbooks) - len(adopted)`
    # printed below, and not on `--strict-adopted`: INV-COMPANIONS asks whether an
    # audit staffed this tree, and only a marker workforce itself writes answers that.
    # Under `--strict-adopted` an adopted agent is held to the contract but was still
    # never staffed here, so it must not make the tree look audited.
    governed_n = 0
    for p in sorted(handbooks):
        body = read(p, res)
        if body is None:
            continue
        if ORG_RECORD_RX.search(body):
            governed_n += 1
            check_handbook(p, body, res, args.ceiling)
        elif args.strict_adopted:
            check_handbook(p, body, res, args.ceiling)
        else:
            check_adopted(p, body, res)

    # STAGING IS FROZEN AT REGISTRATION, AND THE REGISTERED BYTES ARE THE TRUTH.
    #
    # Reported 2026-08-05. An authoring agent OUTLIVED its own T5 registration and kept
    # editing the staged draft, producing a second version of a live employee:
    #
    #     live, registered   171 lines   probed PASS x2, FAIL x1   negative fixture: yes
    #     staging draft      149 lines   never probed              none — "ships none"
    #
    # T6 compares the two and passes; nothing looked again AFTER T6, so the divergence
    # was invisible. And the unprobed draft is the one a later reader PREFERS — it is
    # shorter, under the length ceiling, and reads cleaner. The released file is 21
    # lines over. **Verification that has been watched failing beats a line count**, so
    # the registered bytes win and the draft is preserved for inspection rather than
    # deleted.
    #
    # REPORTED, NEVER REPAIRED — same rule as every other finding here. Overwriting
    # staging is a decision with a preferred direction, and this script does not make
    # decisions; `audit` Step 6 does, with the divergence named.
    staging = os.path.join(root, ".claude", "workforce", "staging", "agents")
    compared = 0
    if os.path.isdir(staging):
        for p in sorted(handbooks):
            staged = os.path.join(staging, os.path.basename(p))
            if not os.path.isfile(staged):
                continue
            live_b, staged_b = _digest(p), _digest(staged)
            if live_b is None or staged_b is None:
                continue
            live_n = len((read(p, res) or "").splitlines())
            staged_n = len((read(staged, res) or "").splitlines())
            compared += 1
            if live_b == staged_b:
                res.add(True, f"{os.path.basename(p)}: staged draft matches the registered bytes")
                continue
            # ADVISORY, NOT BLOCKING — and this is a correction made by MEASUREMENT.
            #
            # The first draft of this check used res.add(), and against a real tree it
            # failed 16 of 16: every registered handbook had moved AHEAD of its staged
            # copy, because `amend` edits the released file and nothing resyncs staging.
            # Reproduced by hand before believing it (196 lines live against 172 staged,
            # the extra content real) — this project's rule that a census reporting a
            # discrepancy is a claim about the census too.
            #
            # So divergence is NORMAL on any tree that has ever amended a handbook, and
            # a check that fails on every healthy tree is the one thing this script's
            # own docstring warns about: "a check that always fails stops being read."
            # I nearly shipped exactly what `verify.md` § a failure is not discounted
            # was written against, in the same change that wrote it.
            #
            # What stays worth reporting is the HAZARD, not the difference: a stale
            # staged draft can be mistaken for authoritative, which is how a shorter
            # never-probed version of a live employee gets preferred by a later reader.
            res.advise(
                f"{os.path.basename(p)}: staged draft differs from the registered bytes "
                f"(live {live_n} lines, staged {staged_n})",
                "NORMAL after an amendment — `amend` edits the released file and nothing "
                "resyncs staging. Reported so the draft is never mistaken for "
                "authoritative: the REGISTERED file is the one that was probed. Never "
                "let a staged draft overwrite released bytes on the strength of being "
                "shorter or cleaner")

    # A COUNT NOBODY PRINTS IS HOW "NOTHING RAN" READS AS "ALL CLEAR". If staging
    # exists and nothing paired, the layout is not what this check expects and it
    # silently examined nothing — the INV-BATCH lesson one level down.
    if os.path.isdir(staging) and compared == 0:
        res.advise("staging/agents exists but no handbook paired with a staged draft",
                   "this check compared NOTHING. Either the tree uses a different "
                   "staging layout or the drafts were cleaned; either way the "
                   "divergence question went unanswered rather than answered clean")

    skills = os.path.join(root, ".claude", "skills")
    if os.path.isdir(skills):
        for entry in sorted(os.listdir(skills)):
            if not entry.startswith("records-"):
                continue
            p = os.path.join(skills, entry, "SKILL.md")
            if os.path.exists(p):
                body = read(p, res)
                if body is not None:
                    check_data_skill(p, body, res)

    check_sidecar(root, res)
    check_canary_record(root, res)
    check_companions(root, res, governed_n)
    check_journal(root, res)
    check_defects(root, res)
    check_catalogs(root, res)

    if args.json_path:
        with open(args.json_path, "w", encoding="utf-8") as fh:
            json.dump({"rows": res.rows, "unreadable": res.unreadable}, fh, indent=2)

    if not args.quiet:
        governed = len(handbooks) - len(res.adopted)
        # All counts, always, including the zeroes. A zero is a measurement.
        print(f"wf-conform — {root}")
        print(f"  {governed} governed · {len(res.adopted)} adopted (exempt) · "
              f"{len(res.rows)} checks · {len(res.failed)} failed · "
              f"{len(res.adopted_findings)} adopted-agent note(s) · "
              f"{len(res.advisory_findings)} advisory · "
              f"{len(res.unreadable)} unreadable")
        for r in res.failed:
            print(f"  ✗ {r['check']}" + (f"\n      {r['detail']}" if r["detail"] else ""))
        for r in res.advisory_findings:
            # Reported, never enforced — the contract post-dates the file.
            print(f"  ~ {r['check']}" + (f"\n      {r['detail']}" if r["detail"] else ""))
        for r in res.adopted_findings:
            # Reported, never enforced — it is not workforce's file.
            print(f"  · {r['check']}" + (f"\n      {r['detail']}" if r["detail"] else ""))
        for u in res.unreadable:
            print(f"  ! unreadable {u}")
        if res.adopted and not args.strict_adopted:
            print(f"  ({len(res.adopted)} adopted agent(s) checked for runtime hazards only — "
                  f"workforce did not author them. `--strict-adopted` to hold them to the "
                  f"full contract.)")

    if res.unreadable:
        return 2
    return 1 if res.failed else 0


if __name__ == "__main__":
    sys.exit(main())
