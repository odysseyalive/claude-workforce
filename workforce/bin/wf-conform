#!/usr/bin/env python3
"""wf-conform — the decidable half of `/workforce verify`, on a host.

`procedures/verify.md` specifies ~48 checks; roughly 85% of them are decidable by
reading files: section presence and order, a literal frontmatter line, a resolved
path, a recomputed digest, a line count. Those were prose for a model to perform,
once per run, on every host — while the repo's own conformance ran as a script.

This is the script half. `verify` still owns the judgment half (persona quality,
whether a stated invariant is really mechanical, whether a description over-claims)
and still owns the report. THIS COMMAND DECIDES NOTHING IT CANNOT DECIDE: every
check here has a binary answer or it is not here.

REPORTS; NEVER REPAIRS. `enforcement.md` § Nothing ships dormant — a shipped script is invoked by a
procedure and returns an exit code. It is not a hook and is registered to nothing.

Exit codes
    0  every check passed
    1  at least one check failed
    2  the tree could not be read — never 0 on an unreadable target

Usage
    wf-conform [--root DIR] [--json PATH] [--quiet]
"""

import argparse
import hashlib
import json
import os
import re
import sys


def _load_sibling(name):
    """Import a sibling shipped script — `wf-census` for its exclusion loader and hook
    resolver, `wf-settings-apply` for the dead-row verdict — one owner, never a second
    copy, and one loader for both.

    `.censusignore` is a DECLARATION the project makes about what its corpus is,
    and it had three readers and one producer: `wf-census` and `wf-apply` both
    honoured it and this file did not. MEASURED 2026-08-10 by a project audit —
    the walk below pruned a directory literally named `fixtures` and read nothing
    else, so a declared exclusion was invisible here while binding everywhere else.
    Two shipped checkers measuring one tree against two different denominators.

    The hardcoded prune was also a heuristic `load_ignore` refuses BY NAME ("no
    `fixtures/` default, no guess from directory names"), so this file was not
    merely missing the rule — it was enforcing the rule's stated opposite.

    NEVER leave bytecode behind: importing a sibling writes `__pycache__/` into the
    SHIPPED bin/ directory, which `bin/check` correctly reports as an undeclared
    file the installers would never fetch.
    """
    import importlib.machinery
    import importlib.util
    _prev = sys.dont_write_bytecode
    sys.dont_write_bytecode = True
    path = os.path.join(os.path.dirname(os.path.abspath(__file__)), name)
    mod_name = name.replace("-", "_")
    loader = importlib.machinery.SourceFileLoader(mod_name, path)
    spec = importlib.util.spec_from_loader(mod_name, loader)
    mod = importlib.util.module_from_spec(spec)
    try:
        loader.exec_module(mod)
    finally:
        sys.dont_write_bytecode = _prev
    return mod


def installed_version():
    """The WORKFORCE-VERSION of the install this script runs from, or None.

    `references/version.md` is the single place the number is AUTHORED (SKILL.md
    Core Principle 9a) and `SKILL.md`'s frontmatter is a mirror. Read the anchor,
    never the mirror, and never a literal written here — a restated constant is what
    turns an upgrade into a fifty-file hunt.

    None on any failure, and None means NO ROW rather than a guessed one: a script
    that cannot read its own version has no business telling a project its handbooks
    are stale.
    """
    path = os.path.join(
        os.path.dirname(os.path.dirname(os.path.abspath(__file__))),
        "references", "version.md")
    try:
        with open(path, encoding="utf-8", errors="replace") as fh:
            m = re.search(r"^WORKFORCE-VERSION:\s*(\d+(?:\.\d+)*)\s*$", fh.read(), re.M)
    except OSError:
        return None
    return m.group(1) if m else None


def version_tuple(s):
    """`1.13.0` -> (1, 13, 0); None if it is not a dotted numeric version.

    Compared as INTEGERS. `1.9.0` is older than `1.13.0` and a string compare says
    the opposite — that is the whole reason this is a function and not an inline
    `<`.  Unequal lengths compare correctly because Python pads nothing: (1, 13) <
    (1, 13, 0) is False and (1, 13) < (1, 14, 0) is True, which is the intent.
    """
    if not s:
        return None
    parts = s.strip().split(".")
    if not parts or not all(p.isdigit() for p in parts):
        return None
    return tuple(int(p) for p in parts)


# Section order is fixed and asserted (procedure-for-procedures.md § File shape).
# Leads carry no `## Procedure`; everyone else carries every row.
SECTIONS = [
    "## Role",
    "## Scope",
    "## Directives",
    "## Chain of Command",
    "## Procedure",
    "## Verification",
    "## Guardrails",
    "## Exit criteria",
    "## Escalation",
    "## Probe",
    "## Reporting",
]
DATA_SKILL_SECTIONS = [
    "## Schema",
    "## Invariants",
    "## Degradation",
    "## Owner",
    "## Git policy",
    "## Seed",
    "## Maintainers",
]
TIER_RX = re.compile(r"tier:\s*(\d)")
# The GOVERNED discriminator. Must match the MARKER, not the words: a first pass
# used `"ORG-RECORD" in body` and classified a hand-authored agent as governed
# because its prose said "No ORG-RECORD". Substring tests over prose are how this
# project's checks have gone wrong before (CLAUDE.md § Assertions match contiguous
# fragments); the marker is structure and cannot be mentioned by accident.
ORG_RECORD_RX = re.compile(r"^[ \t]*<!--\s*ORG-RECORD\s+START\b", re.I | re.M)
FM_RX = re.compile(r"\A---\n(.*?)\n---\n", re.S)
AGENT_ALLOWLIST_RX = re.compile(r"^(?:tools|disallowedTools):.*\bAgent\(", re.M)

# BODY-vs-GRANT COHERENCE. Both forms an MCP server is named in prose: the tool
# prefix (`mcp__playwright-mcp__web_fetch`) and the bare slug (`playwright-mcp`).
#
# The character class EXCLUDES `_` deliberately. Server slugs contain hyphens and
# tool names are separated by `__`, so a greedy `[A-Za-z0-9-]+` stops exactly at the
# separator and never inside the name. The first draft used `[A-Za-z0-9_-]+?` with a
# `\b` terminator, and `\b` matches at a hyphen — it read `mcp__playwright-mcp` as
# the server `playwright`, then reported it missing from a grant that contained it.
MCP_TOOL_RX = re.compile(r"mcp__([A-Za-z0-9-]+)")
# LINE-ANCHORED AT COLUMN 0, byte-identical to `wf-census`'s IMMUTABLE_OPEN and to
# every other counter in this distribution — an indented marker is a markdown code
# block and therefore documentation ABOUT the format, never a span opener.
# `bin/check` § grammar harvests this pattern and cross-tests it against the other
# readers, so a divergence here fails the build rather than producing a second
# opinion. Measured 2026-08-06: an UNANCHORED hand grep counted 37 sacred spans in
# `skill-builder` against the true 6, which left a blocking gate unsettled for a day.
IMMUTABLE_OPEN_RX = re.compile(
    r"^<!--\s*origin:\s*user\b[^>]*immutable:\s*true[^>]*-->$", re.M)
EXTRACT_CITE_RX = re.compile(r"\.claude/skills/([^/`\s]+)/([^`\s:]+):(\d+)")
MCP_SLUG_RX = re.compile(r"\b([a-z0-9][a-z0-9-]*-mcp)\b")
# A `## Sources` ACCESS CHANNEL that is a skill invocation rather than a path.
# `org-design.md` § The access channel is part of every entry: a read-write state
# store is named by its GATEWAY SKILL — `Skill(<data-skill>)` — never by the raw
# file, because naming the file invites an agent to bypass the gateway.
SOURCES_SKILL_RX = re.compile(r"\bSkill\(\s*([^()\s]+)\s*\)")
# A server named only to FORBID it is not a dependency. `procedure-for-procedures.md`
# requires guardrails to carry a literal NEVER / MUST NOT / STOP, so keying off that
# vocabulary is reading the project's own grammar rather than guessing at intent.
# Without this, `- NEVER use any mcp__claude-in-chrome__* tool` reads as a dependency
# on claude-in-chrome — measured against a real handbook, where it did exactly that.
PROHIBITION_RX = re.compile(r"\bNEVER\b|\bMUST NOT\b|\bSTOP\b|\bdo not\b|\bdon't\b|\bforbidden\b", re.I)
# ROUTING IS NOT INVOCATION — the third case of mention-is-not-use, and the one this
# script was blind to for the first four days it shipped.
#
# The spawning-skill check below names re-homing to a delegating tier as its FIRST
# remedy. An org that applies that remedy writes `ESCALATE: business-lead run /quo …`
# — the skill is named in order to route it AWAY, which is the exact opposite of
# invoking it, and it carries no prohibition keyword because it is an instruction
# rather than a ban. So the check reported the remedy it recommends as the violation
# it recommends the remedy for.
#
# MEASURED 2026-08-05 on odyssey-alive: 22 of 22 `invokes only skills that spawn
# nothing` failures were correctly re-homed steps. Not one was an IC reaching past
# its ceiling. The org had discharged the finding in full and the checker still held
# `INV-VERIFY` red, which deferred the succession sweep it gates.
#
# Generous matching is deliberate and the risk is one-sided: the true positives this
# check has earned (30 of them, DEF-2026-08-05-mechanism-partition-ic-tier) came from
# handbooks that absorbed the mechanism BY HAND and say nothing about escalating it.
# A handbook using this vocabulary about a skill has documented that it routes it up.
ROUTING_RX = re.compile(r"\bESCALATE\b|\bis run by\b|\bnot yours to run\b|\bescalates?\b", re.I)
# Harness slash-commands: real invocations that are not project files and never will
# be. Naming one is correct, so an unresolved-command check that does not know them
# reports every handbook that says `/compact` as broken.
HARNESS_COMMANDS = {
    "help", "clear", "model", "config", "init", "compact", "cost", "doctor", "login",
    "logout", "memory", "status", "vim", "agents", "hooks", "mcp", "resume", "review",
    "workforce", "org", "loop", "schedule", "run", "simplify", "security-review",
}
# FILESYSTEM ROOTS, which the command grammar cannot tell from a slash-command. A shell
# example whose LAST argument is a bare absolute path — `php tests/reconcile.php … /tmp`
# — ends with no trailing `/`, so the path-fragment filter below (which skips a token
# with a `/` on BOTH sides) never sees it, and `/tmp` was advised as a missing skill.
# MEASURED 2026-09-13 on a real IC handbook.
FS_ROOTS = {
    "tmp", "var", "etc", "usr", "home", "opt", "dev", "proc", "sys", "mnt", "srv",
    "bin", "lib", "sbin", "boot", "media", "root",
}
# TWO CONDITIONS, NEVER THE ROOT NAME ALONE. Membership in FS_ROOTS is not sufficient:
# on its own it would blind an ADVISORY whose whole job is naming a skill that does not
# resolve, and a project is free to ship `/dev`. The token must ALSO sit in a shell
# example rather than a routing position — a sibling argument carrying a `/`, a `.ext`
# or a `--flag`. `Invoke /dev` keeps being advised; `php tests/x.php --out /tmp` does not.
SHELL_ARG_RX = re.compile(r"(?:^|\s)(?:--?[A-Za-z][\w-]*|\S*[\w.]/\S+|\S+\.[A-Za-z]{1,5})(?:\s|$)")


def _is_path_argument(tok, text):
    """True when `/tok` reads as an absolute path in a shell example, not a command."""
    if tok not in FS_ROOTS:
        return False
    bare = re.compile(r"(?<![\w/])/" + re.escape(tok) + r"(?![\w-])")
    for line in text.splitlines():
        if not bare.search(line):
            continue
        if SHELL_ARG_RX.search(bare.sub(" ", line)):
            return True
    return False

# CANONICAL SIDECAR GRAMMAR — identical to wf-protect-directives. Two readers of one
# artifact must share one grammar and one normalization, or they cannot both be right.
BLOCK_RX = re.compile(
    r"^<!--\s*origin:\s*user\b[^>]*immutable:\s*true[^>]*-->$(.*?)^<!--\s*/origin\s*-->$", re.S | re.M)
ROW_RX = re.compile(r"^\s*([0-9a-f]{64})\s+(\S+):directive:(\d+)\s*$", re.I)


def normalize(text):
    """Trailing whitespace and final newline. Same rule both readers apply."""
    return "\n".join(line.rstrip() for line in text.strip().splitlines())
# MEASURED, NOT CHOSEN, and read from the one file that authors it —
# `procedure-for-procedures.md` § How the split is performed. 150 was a chosen budget with
# nothing behind it, and a live audit measured it INVALID: `engineering-site` was
# relocated block by block to a grounding library, verified verbatim, re-probed PASS,
# and reached 172 — 154 lines of irreducible binding prose plus the ~18 `ORG-*` lines
# the embed step itself appends, neither of which any author can cut. A measured floor
# outranks an unmeasured budget (Core Principle 4). Recorded 2026-08-25; this script
# still said 150 on 2026-09-07, so every org built since had been advised against a
# retired number. `bin/check` asserts the two agree, because a constant restated in a
# second file is the drift Core Principle 9a exists for.
DEFAULT_LENGTH_CEILING = 172

# THE CEILING IS A CONTEXT BUDGET EXPRESSED IN LINES, AND LINES ONLY PROXY IT.
# 172 was measured by relocating ONE IC handbook (`engineering-site`) block by
# block until it would not shrink — a document whose lines are ordinary prose:
# median 96 characters, 113 bytes per line across the file. The number bounds a
# handbook only while that density holds, and nothing was checking that it did.
#
# MEASURED 2026-09-10 on a live 9-handbook org (`apps-odyssey-alive`): every one
# of its five IC handbooks sits at 169-172 lines — right at the ceiling — while
# ranging from 30 KB to 95,832 B. The largest passes `body_lines <= ceiling` at
# 172 lines and 557 bytes per line, with one line of 14,540 characters. It is
# 4.9x the byte weight of the artifact the ceiling was measured on, and every
# byte is injected into that employee's context on every spawn. A line count
# cannot see this, and the whole reason the ceiling exists is the cost it cannot
# see.
#
# DERIVED, not invented: the budget is the measured ceiling at the measured
# density. It is stated here and in procedure-for-procedures.md § The handbook
# length ceiling, and `bin/check` asserts the two agree (Core Principle 9a).
MEASURED_BYTES_PER_LINE = 113

# A MEASURED FLOOR, RECORDED ONCE, READ ON EVERY RUN (apps-odyssey-alive DEF-Q-23, 2026-09-16).
# A relocation pass that stops at a floor it measured writes the floor down with
# `wf-stamp --floor`, and the length row reports it instead of ordering the same split
# again. MEASURED on that host: five IC handbooks at 24,132 to 34,658 B, each relocated in
# `audit-20260914T065649Z` until every remaining byte had a per-section reason, and the row
# still ordered all five on the next run. The numbers in a row are the ones the writer
# measured, never typed, and the row stops counting when the handbook grows past either
# number or its evidence is gone. `wf-stamp` imports this grammar; it keeps no copy.
LENGTH_FLOORS_REL = os.path.join(".claude", "workforce", "length-floors.md")
LENGTH_FLOORS_HEADER = (
    "# Measured handbook length floors\n\n"
    "Written by `wf-stamp --floor <handbook> --evidence <path> --execute`, which measures the\n"
    "handbook itself. Read by `wf-conform`: while a handbook is at or under its row, the length\n"
    "row reports the floor instead of ordering the split. A handbook that grows past either\n"
    "number, or whose evidence file is gone, is ordered again.\n\n"
    "| handbook | lines | bytes | evidence | measured |\n"
    "|---|---|---|---|---|\n"
)
FLOOR_ROW_RX = re.compile(
    r"^\|\s*`?([\w.-]+\.md)`?\s*\|\s*(\d+)\s*\|\s*(\d+)\s*\|\s*`?([^|`]+?)`?\s*\|"
    r"\s*(\d{4}-\d{2}-\d{2})\s*\|\s*$")


def read_length_floors(root):
    """({handbook basename: floor}, [malformed line]) from `LENGTH_FLOORS_REL`.

    A floor is {"lines", "bytes", "evidence", "measured", "evidence_ok"}. `evidence_ok` is
    whether the cited file is on disk INSIDE the project: a floor whose evidence cannot be
    read is an assertion, and it does not count. The table header, its separator, prose and
    blank lines are skipped. Any other line that starts with `|` is returned as malformed,
    so a hand-edited row that stopped parsing is reported, never silently dropped.
    """
    path = os.path.join(root, LENGTH_FLOORS_REL)
    floors, malformed = {}, []
    try:
        body = open(path, encoding="utf-8").read()
    except (OSError, UnicodeDecodeError):
        return floors, malformed
    real_root = os.path.realpath(root)
    for line in body.splitlines():
        t = line.strip()
        if not t.startswith("|") or re.match(r"^\|\s*handbook\s*\|", t) or re.match(r"^\|[-|\s:]+\|$", t):
            continue
        m = FLOOR_ROW_RX.match(t)
        if not m:
            malformed.append(t[:90])
            continue
        ev = m.group(4).strip()
        ev_abs = os.path.realpath(os.path.join(root, ev))
        floors[m.group(1)] = {
            "lines": int(m.group(2)), "bytes": int(m.group(3)), "evidence": ev,
            "measured": m.group(5),
            "evidence_ok": (not os.path.isabs(ev) and ev_abs.startswith(real_root + os.sep)
                            and os.path.isfile(ev_abs)),
        }
    return floors, malformed


# The sections `procedure-for-procedures.md` § How the split is performed relocates from:
# the heavy material lives in these, and every other section is either required by the
# contract or the role's own binding rules. The customer measurement that shaped the IC
# length row removed exactly these four (2026-09-15).
RELOCATABLE_SECTIONS = ("Scope", "Sources", "Procedure", "Verification")
_ORG_OPEN_RX = re.compile(r"^[ \t]*<!--\s*(ORG-[A-Z-]+)\s+START\b")
_ORG_LINE_RX = re.compile(r"^[ \t]*<!--\s*(?:ORG-[A-Z-]+\b|Tier ceiling:|tier-ceiling)", re.I)


def _ic_floor(body):
    """(floor, mandated, breakdown) for an IC handbook's length.

    `mandated` counts the lines this script itself requires and no author can relocate or
    condense: the frontmatter, every line of an `ORG-*` block (the `embed` step writes
    them), the tier-ceiling line, and each `## Probe` substitution-table row that cites a
    section in backticks (the rows the probe-table check demands). `floor` is the line
    count with every RELOCATABLE_SECTIONS section relocated down to its RESIDUE — the
    heading `SECTIONS` mandates plus a pointer line, and for `## Verification` the
    `Check:`/`Negative:` lines that Core Principle 3 keeps in the handbook. That is the
    shortest the handbook can get by relocation AND still pass this script.
    *Corrected 2026-09-17: it subtracted those sections ENTIRELY and called the result
    the same thing, so the figure named a body that would fail the section check above.*
    `breakdown` is every block's line count,
    heading through the line before the next heading, in file order, so an author can see
    what drives the size.
    """
    lines = body.splitlines()
    mandated = 0
    fm = FM_RX.match(body)
    fm_n = fm.group(0).count("\n") if fm else 0
    mandated += fm_n
    in_org = None
    for line in lines[fm_n:]:
        if in_org:
            mandated += 1
            if re.search(r"<!--\s*" + re.escape(in_org) + r"\s+END\b", line) or \
                    re.search(re.escape(in_org) + r"\s+END\s*-->", line):
                in_org = None
            continue
        m = _ORG_OPEN_RX.match(line)
        if m:
            mandated += 1
            if not re.search(r"END\s*-->", line):
                in_org = m.group(1)
        elif _ORG_LINE_RX.match(line):
            mandated += 1
    probe = section(body, "## Probe") or ""
    for l in probe.splitlines():
        cells = l.strip().split("|")
        if l.lstrip().startswith("|") and len(cells) > 2 and PROBE_CITE_RX.search(cells[1]):
            mandated += 1
    blocks, name, count = [], "preamble", 0
    for line in lines:
        mh = re.match(r"^## (.+?)[ \t]*$", line)
        if mh:
            blocks.append((name, count))
            name, count = mh.group(1), 0
        count += 1
    blocks.append((name, count))
    # A RELOCATED SECTION LEAVES A RESIDUE; IT DOES NOT GO TO ZERO. This used to
    # subtract every line of all four sections, and the docstring called the result
    # "the shortest the handbook can get by relocation" — a figure no handbook can
    # reach, because `SECTIONS` above MANDATES `## Scope`, `## Procedure` and
    # `## Verification`, so a body that actually hit it would fail this same script's
    # section check. It reported an unreachable target as a reachable one.
    #
    # Two consequences, and the second is the worse: an author trimming toward the
    # number cuts content the handbook is required to carry, and — because the caller
    # enters its "it cannot reach the target" branch only when the floor still exceeds
    # the ceiling — an understated floor makes that branch fire too RARELY, so a
    # handbook that cannot reach the ceiling is ordered to split anyway. Found by a
    # customer re-test, 2026-09-17, on a handbook whose reported 132 was unreachable.
    #
    # The residue is counted from what this script itself demands, never estimated:
    # the heading (mandated) plus one line pointing at where the content went, and for
    # `## Verification` the `Check:` and `Negative:` lines as the file actually carries
    # them — Core Principle 3 puts the runnable check IN the handbook, so it is the one
    # content that cannot relocate anywhere.
    _CHECK_RESIDUE_RX = re.compile(r"^\s*(?:\*\*)?(?:Check|Negative)\b\s*:", re.I)
    relocatable = 0
    for _h, _c in blocks:
        if not any(_h == s or _h.startswith(s + " ") for s in RELOCATABLE_SECTIONS):
            continue
        residue = 2                                   # heading + a pointer line
        if _h == "Verification" or _h.startswith("Verification "):
            residue += sum(1 for l in (section(body, "## " + _h) or "").splitlines()
                           if _CHECK_RESIDUE_RX.match(l))
        relocatable += max(0, _c - residue)
    breakdown = " · ".join(f"{h} {c}" for h, c in blocks if c)
    return len(lines) - relocatable, mandated, breakdown


class Result:
    def __init__(self):
        self.rows = []
        self.unreadable = []
        self.scratch_skipped = 0
        self.counts = []

    def add(self, ok, name, detail=""):
        self.rows.append({"ok": bool(ok), "check": name, "detail": detail})

    def count(self, line):
        """A population count, printed under the summary on EVERY run, zero included.

        A passing row is not printed, so a check that examined nothing and a check that
        found nothing wrong look identical in the human output. That is how the DEF check
        stayed invisible while reading an empty folder (DEF-Q-004). A count line says how
        many things a check actually saw."""
        self.counts.append(line)

    def advise(self, name, detail=""):
        """A finding that is reported and does NOT set the exit code.

        Distinct from `adopted`, which must stay a count of FILES workforce did not
        author — `main()` derives `governed = len(handbooks) - len(res.adopted)`, so
        borrowing that key for an advisory row about a governed handbook would make
        the census disagree with itself.

        This channel exists for a contract that post-dates the files under it. The
        negative-test record is the first: failing every handbook authored before it
        would reproduce the run that taught this script its own hardest lesson —
        9 reported failures, all false, and "a check that always fails stops being
        read."
        """
        self.rows.append({"ok": False, "check": name, "detail": detail,
                          "advisory": True})

    @property
    def failed(self):
        """Governed rows only. An adopted agent's hazards are reported, not enforced."""
        return [r for r in self.rows
                if not r["ok"] and not r.get("adopted") and not r.get("advisory")]

    @property
    def advisory_findings(self):
        return [r for r in self.rows if r.get("advisory")]

    @property
    def adopted_findings(self):
        return [r for r in self.rows if not r["ok"] and r.get("adopted")]

    @property
    def adopted(self):
        return [r for r in self.rows if r.get("adopted")]


def section(body, heading):
    """Text under a HEADING — line-anchored, never a bare substring search.

    `body.split("## Verification", 1)[1]` splits at the FIRST occurrence anywhere,
    including a prose mention. Measured 2026-08-04 on a real handbook:

        line 58   6. Run the mechanical scan in `## Verification` — it answers …
        line 63   ## Verification

    so every check reading that section was handed the tail of `## Procedure`, and
    the section it meant to examine was never read at all. The old "Verification is
    not empty" assertion PASSED on that file — the wrong segment is also non-empty —
    which is why nothing surfaced it for as long as the check has existed. A new
    check reading the same bytes is what exposed it.

    Fixed as a class: `## Directives` and `## Procedure` are read the same way and
    carried the same defect. Fixing only the instance is the rule this project
    violated in the same week it wrote it down.

    Returns None when the heading is absent — distinct from an empty section.
    """
    # Trailing text on the heading line is tolerated, for two reasons that are both
    # measured. First, THIS FILE'S OWN presence check is `body.find("\n" + s)` — a
    # substring match — so `## Verification (mechanical)` PASSES "every required
    # section present" and then extracted nothing: the script reported the section
    # present and examined none of it. Second, `wf-checkrun` reads the same section,
    # and two readers of one artifact must share one grammar or they cannot both be
    # right — the rule this file already states for the sidecar digest.
    m = re.search(r"^" + re.escape(heading) + r"[ \t]*[^\n]*$(.*?)(?=^## |\Z)",
                  body, re.S | re.M)
    return m.group(1) if m else None


def read(path, res):
    try:
        with open(path, encoding="utf-8") as fh:
            return fh.read()
    except (OSError, UnicodeDecodeError) as exc:
        res.unreadable.append(f"{path}: {type(exc).__name__}")
        return None


def _digest(path):
    """sha256 of a file, or None if unreadable. Unreadable is not 'equal'."""
    try:
        with open(path, "rb") as fh:
            return hashlib.sha256(fh.read()).hexdigest()
    except OSError:
        return None


def frontmatter(body):
    m = FM_RX.match(body or "")
    if not m:
        return None
    fm = {}
    for line in m.group(1).splitlines():
        if ":" in line and not line.lstrip().startswith("#"):
            k, _, v = line.partition(":")
            fm[k.strip()] = v.strip()
    return fm


def check_adopted(path, body, res):
    """An agent workforce did not author. Report; never impose a shape on it.

    `conversion-taxonomy.md` ADOPT: "already a registered agent -> censused into
    the chart, ZERO BYTES CHANGED." A hand-authored agent has no `## Probe`, no
    `## Directives`, and no ORG-RECORD because nobody promised it would. Measuring
    it against the handbook template reports a dozen failures about a contract it
    was never under — which is noise that trains a reader to ignore the report.

    Found by RUNNING this against a real brownfield project (odyssey-alive, three
    hand-authored agents, six failures, every one of them wrong). Re-reading the
    script did not find it; `CLAUDE.md` says that is the normal outcome.

    Only genuine RUNTIME hazards are checked here, because those are bugs in
    anyone's file regardless of who wrote it. They are reported and counted, and
    they do NOT set the exit code: forcing a verdict on a file workforce does not
    own is the same overreach `evaluators.md` refuses when a catalog cannot be
    appended — skipped and reported, never forced.
    """
    n = os.path.basename(path)
    hazards = []
    if AGENT_ALLOWLIST_RX.search(body):
        hazards.append(
            "carries an `Agent(...)` allowlist — subagent definitions IGNORE these, "
            "so the restriction does not exist at runtime"
        )
    # `allowed-tools:` is the SKILL frontmatter key; the agent loader reads `tools:`.
    # A ceiling declared under the wrong key reads as present and grants nothing —
    # measured 2026-09-01 on a real org: two adopted reviewers declared "Read-only"
    # under `allowed-tools:`, one of them authorized to apply deletions, both
    # ceilings very likely unread by the loader.
    _afm = frontmatter(body)
    if _afm is not None and "allowed-tools" in _afm and "tools" not in _afm:
        hazards.append(
            "declares its tool ceiling under `allowed-tools:` — the agent loader "
            "reads `tools:`, so this ceiling is very likely not applied at runtime; "
            "rename the key"
        )
    res.rows.append({"ok": not hazards, "check": f"{n}: adopted (not workforce-authored)",
                     "detail": "; ".join(hazards), "adopted": True})


def check_handbook(path, body, res, ceiling, floors=None):
    n = os.path.basename(path)
    fm = frontmatter(body)
    res.add(fm is not None, f"{n}: frontmatter parses")
    if fm is None:
        return

    # The dead-key ceiling. `allowed-tools:` is the SKILL key; agents are loaded from
    # `tools:`. In a governed handbook this is BLOCKING, not a hazard report: workforce
    # authored the file, so the wrong key is a defect in the generator's output, and a
    # tier ceiling under a key the loader does not read is no ceiling at all.
    res.add(not ("allowed-tools" in fm and "tools" not in fm),
            f"{n}: tool ceiling declared under the key the agent loader reads",
            "frontmatter uses `allowed-tools:` (the skill key) with no `tools:` — the "
            "ceiling is very likely not applied at runtime; rename the key to `tools:`")

    tier = None
    m = TIER_RX.search(body)
    if m:
        tier = int(m.group(1))
    res.add(tier is not None, f"{n}: ORG-RECORD states a tier",
            "no `tier: N` in the ORG-RECORD block; tier drives every other rule here")

    # Section presence and order, per procedure-for-procedures.md § File shape —
    # which marks TWO sections tier-conditional, and this checked only one.
    #
    #   ## Procedure          Lead: —   IC: yes    (a coordinator gets no script)
    #   ## Chain of Command   Lead: yes IC: —      (an IC has no subordinates)
    #
    # Measured 2026-08-03 by `/workforce verify` on a real org: 9 reported failures,
    # ALL FALSE — every IC flagged for missing a section the spec says it must not
    # have, and `handbook-templates.md` § IC correctly omits. This is the exact
    # failure class verify.md documents: a validator holding files to a contract
    # they were never under. Attribution is the DOCUMENT — this script.
    #
    # It matters more than a wrong count: a check that always fails stops being read.
    expected = [
        s for s in SECTIONS
        # tier 1 AND 2 are delegating; neither carries a `## Procedure`. Exempting
        # only tier 2 failed the shipped CEO template against this very script —
        # "a coordinator gets no script" is more true of the CEO, not less, and
        # handbook-templates.md § CEO ships none.
        if not (tier in (1, 2) and s == "## Procedure")
        and not (tier == 3 and s == "## Chain of Command")
    ]
    positions, missing = [], []
    for s in expected:
        i = body.find("\n" + s)
        if i < 0:
            missing.append(s)
        else:
            positions.append((i, s))
    res.add(not missing, f"{n}: every required section present",
            f"missing: {missing}")
    ordered = [s for _, s in sorted(positions)]
    res.add(ordered == [s for s in expected if s not in missing],
            f"{n}: sections in the fixed order",
            f"found order: {ordered}")

    # The tier ceiling. What this verifies is PRESENCE OF THE LINE — a property of
    # the text. Runtime behavior is the canary's job, established once per host and
    # never inferred per handbook from the presence of a string.
    # `tools: All tools` IS A DISPLAY STRING, NOT A VALUE — AND IT CRIPPLES THE AGENT.
    #
    # Reported 2026-08-05 by an authoring agent that DECLINED the instruction: told to
    # write `tools: All tools`, it checked the harness and refused, because that phrase
    # is what the harness GENERATES FOR DISPLAY when `tools:` is empty. Written back
    # literally it is parsed as a one-entry allowlist naming a tool that does not exist,
    # so the agent can call NOTHING — while the frontmatter reads as maximally
    # permissive. The failure presents as the opposite of what it is.
    #
    # Checked on EVERY tier, not just tier 3. A delegating tier carries no `tools:` line
    # at all (SKILL.md rule 6), so the string is wrong there too — and it is precisely
    # the tiers with no allowlist whose display output says "All tools", which is where
    # a round-trip through a human or an agent picks the phrase up.
    #
    # This project's own rule, turned on the brief that instructed it: never claim a
    # capability the runtime will not deliver.
    _tools_raw = (fm.get("tools") or "").strip()
    if _tools_raw:
        _toks = {t.strip().lower() for t in _tools_raw.split(",") if t.strip()}
        res.add(_toks != {"all tools"} and "all tools" not in _toks,
                f"{n}: `tools:` is a real allowlist, not the display string",
                "`All tools` is what the harness PRINTS when `tools:` is empty. Written "
                "literally it is a one-entry allowlist naming a tool that does not "
                "exist, so this agent can call nothing while reading as unrestricted. "
                "Omit the field to inherit the default grant")

        # A NAME THE HOST HAS NO REGISTRY ENTRY FOR IS DROPPED SILENTLY (fact 13b),
        # so an allowlist can promise reach the agent never receives, with no error,
        # no warning, and no degraded mode. `Grep`, `Glob` and `WebFetch` are the
        # standing cases: MEASURED absent from the subagent namespace loaded and
        # deferred alike on 2.1.220 and again on 2.1.266, and absent from the main
        # session too. Found 2026-09-10 in this distribution's OWN shipped agents —
        # three of seven granted `Grep, Glob` while four reference files told every
        # handbook author never to assume them, and nothing checked the artifacts.
        # REPORTED, never blocking: the measurement is of one host, the grant is
        # harmless where the tool does exist, and the remedy is a one-line edit —
        # do the searching through `Bash`, which is granted everywhere.
        _phantom = sorted({t.strip() for t in _tools_raw.split(",")}
                          & {"Grep", "Glob", "WebFetch"})
        if _phantom:
            res.advise(
                f"{n}: `tools:` grants {', '.join(_phantom)}",
                "measured absent from the subagent namespace (platform.md fact 4), "
                "and an unresolvable grant entry is dropped with no signal of any "
                "kind (fact 13b). This agent very likely runs with less reach than "
                "its frontmatter claims. Ground the work in `Bash` instead")

    if tier == 3:
        # THE OTHER HALF OF RULE 3, which had no mechanical enforcement anywhere.
        # SKILL.md marks both lines BLOCKING; only the denylist was ever checked, so
        # `/workforce verify` could not see half of a blocking rule. A named-teammate
        # spawn discards `disallowedTools:` and honours `tools:` (fact 2d), so the
        # unchecked half is the one that survives that spawn form.
        _tools = (fm.get("tools") or "").strip()
        res.add(bool(_tools) and "agent" not in {t.strip().lower() for t in _tools.split(",")},
                f"{n}: IC carries a `tools:` allowlist omitting Agent",
                "SKILL.md rule 3 refuses to register an IC without it (fact 2d): as a "
                "named teammate its `disallowedTools:` is discarded and it receives "
                "`Agent`. Neither line alone is a ceiling")
        res.add("disallowedTools: Agent" in body,
                f"{n}: IC carries the literal `disallowedTools: Agent`",
                "entry depth does not cap an IC (platform.md fact 2b); the ceiling "
                "is fact 2c's mechanism and it has to be written down")

    # An Agent() allowlist inside a subagent definition is DISCARDED at runtime, so
    # its presence means the org chart is enforced by a mechanism that does nothing.
    res.add(not AGENT_ALLOWLIST_RX.search(body),
            f"{n}: no `Agent(...)` allowlist in the frontmatter",
            "subagent definitions ignore these; the restriction does not exist at runtime")

    # Directives reach the employee, or say plainly that none bind it.
    seg = section(body, "## Directives")
    if seg is not None:
        res.add("(none bound)" in seg or ".claude/workforce/directives/" in seg,
                f"{n}: Directives section resolves or declares none",
                "a blank Directives section reads as 'none bound' and is not")

    # THE SOURCES CONTRACT (v1.7.0). Two rows, both ADVISORY, for the same reason the
    # negative-test record and the version stamp below are advisory: the contract
    # post-dates every deployed handbook, and failing all of them at once reproduces
    # the run that taught this script "a check that always fails stops being read."
    #
    # DELIBERATELY NOT IN `SECTIONS`. Adding it there would make it blocking AND
    # order-checked in one move, against files authored before the section existed —
    # the exact overreach the tier-conditional section list was rewritten to end.
    #
    # ABSENT IS THE DEFECT; `(none)` IS A MEASUREMENT — the convention `## Directives`
    # already uses for `(none bound)`. A pure reviewer or mechanism role legitimately
    # produces nothing from reference material and says so (handbook-templates.md
    # § Sources), so this fires ONLY on total absence and is silent on a handbook that
    # measured itself sourceless. Otherwise the check would push every reviewer to
    # invent a source, which is the failure org-design.md § NEVER INVENT names.
    _sources = section(body, "## Sources")
    if _sources is None:
        res.advise(
            f"{n}: no ## Sources section",
            "the handbook names no authoritative reference material — add a "
            "`## Sources` section after `## Directives` (handbook-templates.md) "
            "naming each reference root or glob, or `Skill(<data-skill>)` for a "
            "read-write store, or the literal `(none)` for a pure reviewer or "
            "mechanism role. An org not wired to its own reference material is "
            "gaslit by its own project: the context an order needs is on disk and "
            "the actor reports it missing (org-design.md § Wiring the org to its "
            "reference material). ADVISORY: this row blocks nothing",
        )
    else:
        # A `Skill(X)` entry is a CHANNEL, not a name. `org-design.md` § The access
        # channel: "a Sources channel naming `Skill(X)` means the employee must be
        # able to invoke X — so its `## Procedure` grants that invocation. Sources
        # says WHERE the truth is + HOW to reach it; the Procedure EXERCISES that
        # reach." A channel no step ever reaches for is a DEAD POINTER: the handbook
        # states where its truth lives and never opens the gateway.
        #
        # Read from `## Procedure` ONLY — the section org-design names as the
        # granting one — and skipped entirely when there is no `## Procedure`, which
        # is the DELEGATING TIERS. A CEO and a Lead carry `## Sources` and no
        # Procedure by design (the same tier-conditional the section list encodes
        # above), so measuring them against a section they must not have would
        # reproduce the 9-false-failures run, one contract later.
        #
        # Prohibition lines are dropped, exactly as the tier-3 skill check below
        # drops them: "NEVER invoke X" names X in order to forbid it.
        #
        # MATCHING IS GENEROUS AND THE RISK IS ONE-SIDED — the same call ROUTING_RX
        # makes. Handbooks write the invocation three ways (`Skill(x)`, `/x`, and
        # prose: "invoke the x skill"), so any word-boundary mention of X in the
        # Procedure counts as naming it; a stricter grammar would report the third
        # form as a dead pointer. What survives is the case with no counter-argument:
        # a Sources channel whose skill the Procedure never mentions at all.
        _proc = section(body, "## Procedure")
        if _proc is not None:
            _proc = "\n".join(l for l in _proc.splitlines()
                              if not PROHIBITION_RX.search(l))
            for _sk in sorted(set(SOURCES_SKILL_RX.findall(_sources))):
                # `Skill(<data-skill>)` is the template's own unfilled slot. Reporting
                # a placeholder as a dead pointer is noise, not a finding.
                if "<" in _sk or ">" in _sk:
                    continue
                if re.search(r"(?<![\w-])" + re.escape(_sk) + r"(?![\w-])", _proc):
                    continue
                res.advise(
                    f"{n}: Sources names Skill({_sk}), which its Procedure never invokes",
                    f"`## Sources` routes this role's reference material through "
                    f"`Skill({_sk})` and `## Procedure` never names {_sk} — the "
                    f"channel is a dead pointer: the handbook says where the truth "
                    f"lives and never reaches for it. Grant the invocation in a "
                    f"numbered step (org-design.md § The access channel is part of "
                    f"every entry), or name the source by the channel it is actually "
                    f"read through. ADVISORY: this row blocks nothing",
                )

    # ADVISORY, and the message has said so since it was written. `procedure-for-procedures.md`
    # § The handbook length ceiling: "over the ceiling is never a refusal and never
    # blocks a sweep. A number nobody measured may not block anyone's work
    # (platform.md § DOCUMENTED)." It was wired to the blocking channel anyway, two
    # functions above the advisory channel that exists for exactly this — so a row
    # declaring itself never a refusal set a non-zero exit, and `INV-VERIFY` reads that
    # exit. MEASURED 2026-08-05 on odyssey-alive: 14 such rows, gating a sweep.
    #
    # The ceiling is a CHOSEN budget (~2.5× a filled IC template), not a measurement,
    # and this project bars a DOCUMENTED fact from becoming a blocking check.
    #
    # NOT-BLOCKING IS NOT NOT-ACTING, and the message used to leak that. It said "a
    # structural finding proposing a split", which reads as a hand-back — the optional
    # "want me to split these?" offer that the no-standing-queue directive (2026-08-10)
    # forbids, and the sibling of the picker that offered "leave as-is" or "trim". The
    # run PERFORMS the split instead: relocation into the grounding library, never
    # condensation (directive one is retention — a trimmed safety example is a lost
    # one), and never a longer handbook accepted as-is.
    #
    # THE CEILING IS AN IC MEASUREMENT AND DOES NOT TRANSFER TO A LEAD. 172 was measured
    # once, by relocating ONE IC handbook (`engineering-site`) block by block until it
    # would not shrink further. A Lead has no `## Procedure` to relocate at all and
    # carries two sections an IC does not — a full `## Chain of Command` and a `## Probe`
    # covering its whole department — so the thing that was measured is not the thing
    # being checked. Measured 2026-09-08 across a live 22-handbook org: the smallest IC
    # is 141 lines and four sit under 172, so the number is reachable and still binding
    # there; the smallest LEAD is 233 and not one of the five is under 172, and seven
    # independent relocation passes failed to bring any of them down.
    #
    # So the Lead line count is OBSERVED, not judged. `platform.md` § DOCUMENTED bars an
    # unmeasured number from driving anyone's work, and an advisory that orders a
    # relocation which provably cannot reach its target is worse than silence: doctrine
    # says the split "is PERFORMED this run", so every audit spent effort on an
    # unreachable goal and reported the same row again next time. The measurement that
    # would make a Lead ceiling real is the `engineering-site` exercise repeated on a
    # Lead; until someone runs it, this states the count and names what is owed.
    body_lines = len(body.splitlines())
    # The byte budget is the measured ceiling at the measured density (see
    # MEASURED_BYTES_PER_LINE). Reported on EVERY row, whatever the tier, because a
    # line count that passes says nothing about what the employee is actually handed.
    body_bytes = len(body.encode("utf-8"))
    byte_budget = ceiling * MEASURED_BYTES_PER_LINE
    _over_bytes = body_bytes > byte_budget
    _density = f"{body_bytes:,} B ({body_bytes // max(body_lines, 1)} B/line)"
    _tier_m = TIER_RX.search(body)
    if _tier_m and _tier_m.group(1) == "2":
        res.advise(
            f"{n}: Lead handbook length OBSERVED, not judged",
            # The message does NOT enumerate the sections a Lead carries and an IC does
            # not. That reasoning is the doctrine's job, and naming those headings in
            # every row put their literal text into output that other checks assert
            # against — `conform-tier-sections` forbids exactly those strings, because
            # its whole point is that an IC is never asked for a Lead's sections.
            # A row should say what it measured and where the rule lives.
            f"{body_lines} lines, {_density}. The {ceiling}-line ceiling was measured "
            f"on an IC handbook; no Lead floor has ever been measured, so none is "
            f"asserted and no relocation is ordered here. Why, and what measurement is "
            f"owed: procedure-for-procedures.md § The handbook length ceiling. ADVISORY: "
            f"this row blocks nothing")
    elif body_lines <= ceiling and not _over_bytes:
        res.add(True, f"{n}: within the {ceiling}-line ceiling")
    elif body_lines > ceiling and _ic_floor(body)[0] > ceiling:
        # THE IC BRANCH OF THE SAME REASONING AS THE LEAD BRANCH ABOVE. MEASURED 2026-09-15
        # on a customer host (nc-audit, Nevada Classics): three IC handbooks at 297, 231
        # and 296 lines, still over after verbatim relocation. The 297 carries no user
        # span at all and is 181 lines with Scope, Sources, Procedure and Verification
        # removed entirely. Its size is the mandated section set plus its own Guardrails,
        # Probe and Reporting for a report-only reviewer. An order to relocate to 172 could
        # not be followed. So the row states what it measured, section by section, and
        # orders nothing it cannot reach.
        _floor, _mand, _brk = _ic_floor(body)
        res.advise(
            f"{n}: IC handbook length OBSERVED — the required content alone exceeds the "
            f"ceiling",
            f"{body_lines} lines, {_density}: {_mand} are lines this check itself requires "
            f"(frontmatter, ORG-* blocks, the tier-ceiling line, the Probe rows citing a "
            f"section), and {body_lines - _mand} are authored. With the relocatable "
            f"sections reduced to the heading, a pointer and Verification's Check/Negative "
            f"lines \u2014 the least this script will still pass \u2014 it would be {_floor} lines, over "
            f"{ceiling}, so no relocation is ordered: it cannot reach the target. By section: "
            f"{_brk}. The {ceiling}-line figure was measured on one IC; why that does not "
            f"bind this one: procedure-for-procedures.md § The handbook length ceiling. "
            f"ADVISORY: this row blocks nothing")
    else:
        # WHICH BUDGET WAS BLOWN CHANGES NOTHING ABOUT THE REMEDY — relocation is the
        # same act either way — but it changes what the author goes looking for, so the
        # row says which. A handbook under the line count and over the byte budget is
        # carrying its weight in a few enormous lines, and skimming it for "long
        # sections" will find nothing.
        if body_lines > ceiling and _over_bytes:
            _why = (f"{body_lines} lines AND {_density}, against {ceiling} lines / "
                    f"{byte_budget:,} B")
        elif body_lines > ceiling:
            _why = f"{body_lines} lines, against {ceiling}"
        else:
            # WHERE the weight sits is MEASURED, never asserted. A handbook can be
            # over the byte budget because a handful of lines are enormous, or
            # because every line is dense — and an author told to look for "a few
            # very long lines" in a uniformly dense document is sent hunting for
            # something that is not there.
            _longest = max((len(l) for l in body.splitlines()), default=0)
            _shape = (f"the weight is concentrated — longest line {_longest:,} "
                      f"characters" if _longest > 4 * MEASURED_BYTES_PER_LINE
                      else f"the prose is uniformly dense — longest line "
                           f"{_longest:,} characters")
            _why = (f"{_density} — WITHIN the {ceiling}-line count and over the "
                    f"{byte_budget:,} B the same ceiling buys at the density it was "
                    f"measured at ({MEASURED_BYTES_PER_LINE} B/line); {_shape}")
        if body_lines > ceiling:
            _f, _m, _b = _ic_floor(body)
            _why += (f" ({_m} of them required by this check, {body_lines - _m} authored; "
                     f"{_f} with the relocatable sections at their irreducible residue. By section: {_b})")
        # A RECORDED FLOOR REPLACES THE ORDER WHILE IT HOLDS (DEF-Q-23, see LENGTH_FLOORS_REL).
        _fl = (floors or {}).get(n)
        if (_fl and _fl["evidence_ok"] and body_lines <= _fl["lines"]
                and body_bytes <= _fl["bytes"]):
            res.advise(
                f"{n}: IC handbook length at its MEASURED FLOOR — no split ordered",
                f"{_why}. A relocation pass stopped at a measured floor of {_fl['lines']} "
                f"lines / {_fl['bytes']:,} B on {_fl['measured']}; evidence "
                f"{_fl['evidence']} ({LENGTH_FLOORS_REL}). This row reports that floor instead "
                f"of ordering the same split again. It stops counting the moment the handbook "
                f"grows past either number. ADVISORY: this row blocks nothing")
        else:
            _floor_note = ""
            if _fl and not _fl["evidence_ok"]:
                _floor_note = (f"The floor recorded for it cites {_fl['evidence']}, which is not "
                               f"a file inside this project, so it does not count. ")
            elif _fl:
                _floor_note = (f"A floor of {_fl['lines']} lines / {_fl['bytes']:,} B was "
                               f"recorded on {_fl['measured']}, and this handbook is now past "
                               f"it ({body_lines - _fl['lines']:+d} lines, "
                               f"{body_bytes - _fl['bytes']:+,} B), so the floor no longer "
                               f"counts. ")
            # WHO PERFORMS THE SPLIT IS NAMED, because this script runs inside read-only
            # commands too. The row said "the split is PERFORMED this run" inside `verify`,
            # which performs nothing (DEF-Q-23). `audit` Step 5d performs it.
            res.advise(f"{n}: within the {ceiling}-line ceiling",
                       f"{_why} — {_floor_note}the split is owed, and `/workforce audit` "
                       f"performs it (procedures/audit.md Step 5d): relocate the "
                       f"heavy material (worked examples, mapping tables, reference data) into "
                       f"the grounding library or a data skill, leaving a lean core that reads "
                       f"it on demand. Never trimmed, never condensed, never handed back as a "
                       f"question. This check changes nothing, so a read-only command such as "
                       f"`/workforce verify` only reports it. When a relocation pass has already "
                       f"stopped at a measured floor, record it with `wf-stamp --floor "
                       f"<handbook> --evidence <path> --execute` and this row reports the floor "
                       f"instead. ADVISORY: this row blocks nothing")

    # A handbook that cannot say how to verify itself is not releasable.
    #
    # "not empty" was the ENTIRE mechanical coverage of the highest-leverage section
    # in the file until 2026-08-04, and it is satisfied by the word "yes". The two
    # rows below are still properties of the text — whether the check RESOLVES belongs to
    # `wf-checkrun`; whether it RUNS or can FAIL belongs to no shipped tool and is
    # established by hand at amendment time (procedures/amend.md Step 6). Naming that
    # owner here is deliberate: one defect, one verdict, or the counts disagree.
    seg = section(body, "## Verification")
    if seg is not None:
        res.add(bool(seg.strip()), f"{n}: Verification section is not empty")

        # A section that names no command at all is decoration. `verification.md`
        # § Authoring checklist rule 1: "Name the exact command or suite. Not a
        # category — the literal invocation."
        res.add(bool(re.search(r"`[^`\n]+`", seg)),
                f"{n}: Verification names at least one literal invocation",
                "no backticked command anywhere in the section — rule 1 of "
                "verification.md's authoring checklist is a literal invocation, and "
                "prose describing a category is the tier-4 row that file rejects")

        # THE NEGATIVE-TEST RECORD. `procedures/verify.md` already requires this of
        # every invariant classed `mechanical` — "a validator nobody ever saw reject
        # anything — indistinguishable from `exit 0`" — and the rule simply never
        # reached the handbooks, which is where it was needed most.
        #
        # NON-BLOCKING, and that is the GOVERNED-vs-ADOPTED precedent above: every
        # handbook authored before this contract is in this state, and failing them
        # all at once reproduces the 9-false-failures run that taught this script
        # "a check that always fails stops being read."
        if "Negative:" not in seg:
            res.advise(
                f"{n}: Verification declares no negative case",
                "no `Negative:` line — this check has never been observed failing, "
                "so it is indistinguishable from one that cannot fail. Declare a "
                "Negative: line naming a command expected to exit non-zero, and run it "
                "by hand at amendment time (procedures/amend.md Step 6). No shipped "
                "tool executes it.",
            )

    # THE ASK ECHO-BACK (2026-09-01, dispatch CHECKPOINT clauses 6c/6d). A `## Reporting`
    # that never names the REQUEST block describes a return channel where the user's
    # ask cannot be checked against the deliverable — measured on a real org: 252
    # dispatch edges, 2% carrying exit criteria, no OUTPUT.md opening with the ask.
    # ADVISORY for the same governed-vs-adopted reason as the negative-test record:
    # every handbook authored before this contract is in this state.
    seg = section(body, "## Reporting")
    if seg is not None and "REQUEST (verbatim)" not in seg:
        res.advise(
            f"{n}: Reporting does not echo the originating ask",
            "no `REQUEST (verbatim)` in ## Reporting — the OUTPUT.md contract should "
            "open with the work order's REQUEST block quoted unchanged plus a "
            "criterion → evidence table (handbook-templates.md § Reporting), or "
            "spec fidelity cannot be read back at return time.",
        )

    # SAY THE STATE, NOT THE JOURNEY (2026-09-07, SKILL.md § Directives). The user
    # scoped this to "any project using workforce", and an employee is where it is
    # hardest to see: every operator-facing carrier governs the MAIN conversation
    # only, because a subagent runs its own system prompt. So this
    # row is the only reader an employee's report shape has. Without it an org can
    # return every finding as an open problem forever — with the work already done —
    # and nothing anywhere says so.
    #
    # MATCHED ON THE PHRASE, not on a paraphrase, for the same reason the ORG-RECORD
    # marker is: a clause can be mentioned by accident, and a heading cannot. ADVISORY,
    # like its two neighbours, because every handbook authored before this contract is
    # in this state and a blocking row would drown a `verify` on a healthy org.
    if seg is not None and "Say the state, not the journey" not in seg:
        res.advise(
            f"{n}: Reporting carries no say-the-state clause",
            "add the say-the-state clause to ## Reporting (handbook-templates.md "
            "§ Reporting): every finding reports its outcome in the same breath — "
            "fixed, blocked by <the named thing>, or for the manager to decide "
            "because <reason>; never hand work up the chain you could have done; "
            "never retroactively downgrade a finding to a non-finding. Accuracy is "
            "not the standard — the standard is that the reader finishes the report "
            "knowing the state. `audit` Step 5d is the fix.",
        )

    # THE REPORT MUST SURVIVE A RUN THAT DOES NOT FINISH (2026-09-24). Every clause above
    # governs what a report SAYS; this one governs whether it EXISTS. A handbook that has
    # its employee write the OUTPUT.md at the end has bet the whole deliverable on the run
    # reaching the end, and a run has three ordinary ways not to: the `maxTurns` ceiling
    # the IC template sets at 40, an interrupt, and a context limit.
    #
    # MEASURED 2026-09-24, on a real run in a sibling project: two ICs hit their turn limit
    # and stopped with NO hand-back and NO artifact. Their work was neither done nor
    # recoverable, and — the reason the user saw it at all — from the outside it was
    # indistinguishable from an agent still working. A partial file on disk would have said
    # which criteria closed. Nothing anywhere asked a handbook to produce one.
    #
    # MATCHED ON THE PHRASE, like its neighbour, and ADVISORY for the same reason: every
    # handbook authored before this contract is in this state.
    if seg is not None and "incrementally" not in seg:
        res.advise(
            f"{n}: Reporting does not ask for an incremental OUTPUT.md",
            "add the write-it-incrementally clause to ## Reporting "
            "(handbook-templates.md § Reporting): the OUTPUT.md opens with the REQUEST "
            "echo-back and the criterion table BEFORE the work starts, and rows are "
            "filled in as they are earned. A run stopped by a turn ceiling, an "
            "interrupt or a context limit loses a report that exists only in context, "
            "and takes the record of the work with it. `audit` Step 5d is the fix.",
        )

    # THE AUTHORING-VERSION STAMP (2026-09-01). Without `workforce-version:` in the
    # ORG-RECORD, nothing can tell a handbook authored under the current doctrine from
    # one three releases stale — which is how two shipped contract releases sat
    # template-only with zero deployed handbooks carrying them and no finding anywhere.
    if "workforce-version:" not in body:
        res.advise(
            f"{n}: ORG-RECORD carries no workforce-version stamp",
            "add `workforce-version: <version>` to the ORG-RECORD `hired:` line "
            "(handbook-templates.md). A handbook that cannot state which release "
            "authored it cannot be flagged as stale when the doctrine moves.",
        )
    else:
        # PRESENT AND OLDER — the half the stamp exists FOR, and it was never written.
        #
        # The clause above lands the stamp so staleness *can* be computed; nothing
        # computed it. `procedures/verify.md` § Handbook conformance has stated the
        # consumer since the stamp shipped — "where it is present and older than the
        # installed WORKFORCE-VERSION, report the handbook as authored under
        # superseded doctrine" — and `procedures/audit.md` Step 5d step 4 names this
        # script's advisory rows as "the between-audit detector" that Step 5d is the
        # fix for. Both pointed at a row that did not exist.
        #
        # MEASURED 2026-09-05 on odyssey-alive: 19 governed handbooks, every one
        # stamped 1.13.0, against an installed 1.17.0 — four minor releases, and
        # `wf-conform` reported 34 advisories, none of them this. The drift surfaced
        # only because a `/org` dispatch block was found six clauses behind BY HAND.
        # A stamp nobody compares is a stamp that records staleness without
        # reporting it.
        #
        # ADVISORY, never blocking, for the reason every other row here is: an org
        # one release behind is ordinary, and failing all of them at once reproduces
        # the run that taught this script "a check that always fails stops being read."
        inst = installed_version()
        m_stamp = re.search(r"workforce-version:\s*([0-9.]+)", body)
        have = version_tuple(m_stamp.group(1)) if m_stamp else None
        want = version_tuple(inst)
        if have is not None and want is not None and have < want:
            res.advise(
                f"{n}: authored under superseded doctrine "
                f"(stamped {m_stamp.group(1)}, installed {inst})",
                f"the contract this handbook was written against is {m_stamp.group(1)}; "
                f"the installed release is {inst}. Contract sections shipped since then "
                "have not reached it. `/workforce audit` Step 5d is the fix and applies "
                "the deltas in-run; this row is only the between-audit detector.",
            )

    # BODY-vs-GRANT COHERENCE — the first check here that compares the text to the
    # capability rather than to another piece of text.
    #
    # `tools:` is a REAL CEILING FOR MCP, measured: platform.md fact 13's fixture held
    # `ToolSearch`, searched a server its grant never named, and the schema was
    # WITHHELD. Granting `ToolSearch` opens no side door. So an explicit `tools:` list
    # that omits a server the body routes work through describes an employee that
    # cannot do its job — and omitting `tools:` entirely does NOT have this problem,
    # because absence inherits every configured server (fact 14).
    #
    # Measured 2026-08-03 by `/workforce verify` against apps-odyssey-alive:
    # `design-imagery` and `research-analyst` passed all 138 checks here and could not
    # reach nanobanana-mcp / playwright-mcp. Every check was about text; none compared
    # the text to the grant. The gap was introduced by the same change that closed the
    # teammate ceiling — adding an explicit allowlist severed an inherited reach nobody
    # had written down as a dependency.
    #
    # Deliberately one-directional: a granted server the body never mentions is NOT a
    # finding. Over-granting is a budget question, and this check has a binary answer
    # or it does not belong here (verify.md § What it deliberately does not cover).
    # AN IC MAY INVOKE ONLY A SKILL THAT SPAWNS NOTHING, and until now nothing checked
    # the skill. `conversion-taxonomy.md`: "the remaining skill spawns nothing — so an
    # IC carrying `disallowedTools: Agent` can invoke it." The doctrine was right and
    # unenforced, so a handbook could instruct an IC to invoke a spawning skill while
    # ASSERTING the safety condition it violated.
    #
    # Measured 2026-08-03: `content-writer` (tier 3, `disallowedTools: Agent`) step 7
    # read "Invoke `/copy-truth check` … it spawns nothing." That skill carries `Task`
    # in `allowed-tools` and ships `agents/interface-claim-auditor/`. A tier ceiling
    # with a documented route around it is not a ceiling.
    # A handbook lives at <root>/.claude/agents/<name>.md, so the project root is three
    # levels up. Derived rather than passed: this function's signature is shared by two
    # call sites and a third for adopted agents.
    _root = os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(path))))
    # MENTION IS NOT USE — the same distinction the MCP check above needed, arrived at
    # the same way: by a first draft reporting two false positives on a real tree.
    #   `## Scope` — "OUT: truth of capability claims (`content-writer` and `/copy-truth`)"
    #                names a skill to DISCLAIM it.
    #   a prohibition — "Do NOT invoke `/copy-truth`" names one to forbid it.
    # Only `## Procedure` and `## Verification` say what the employee DOES, and within
    # them a line carrying NEVER / MUST NOT / STOP / do not is a guardrail, not a step.
    _acts_raw = ""
    for _sec in ("## Procedure", "## Verification"):
        _acts_raw += (section(body, _sec) or "") + "\n"
    _acts = "\n".join(l for l in _acts_raw.splitlines() if not PROHIBITION_RX.search(l))
    # ROUTED SKILLS — collected from the RAW text, per numbered step, before the
    # prohibition filter runs. Two orderings had to be got right and neither is obvious:
    #
    #   RAW, not filtered. The strongest routing evidence a handbook writes is commonly
    #   a prohibition — "**Any change to existing prose → `ESCALATE: /edit <file>`**,
    #   never after" and "You never invoke `/focus` or `/edit` yourself: both spawn, and
    #   you cannot." Filtering prohibitions first DELETES the sentence that proves the
    #   step was re-homed, leaving only the narrative mention that names the skill. The
    #   check then reports the one handbook that stated the ceiling most explicitly.
    #
    #   PER STEP, not per line. The marker and the skill name are routinely a line or
    #   two apart inside one numbered step — "The skill runs one tier up; the work stays
    #   here. `/promote`, `/linkedin-promote`, … each spawn a helper agent … Send
    #   `content-lead` one line — `ESCALATE: run <skill> <args> on my behalf`" names the
    #   skills two lines above an ESCALATE that carries only a `<skill>` placeholder.
    #   The numbered step is the unit of instruction, so it is the unit of scope.
    #
    # The resulting set is file-level: a skill routed in step 4 is routed in step 4a's
    # cross-reference too, which is what "the invocation moves" means.
    _routed, _step = set(), []
    def _harvest(lines):
        blob = "\n".join(lines)
        if ROUTING_RX.search(blob) or PROHIBITION_RX.search(blob):
            _routed.update(re.findall(r"(?<![\w/])/([a-z][a-z0-9-]{2,})\b", blob))
    for _l in _acts_raw.splitlines():
        if re.match(r"\s*\d+[a-z]?\.\s", _l) and _step:
            _harvest(_step)
            _step = []
        _step.append(_l)
    _harvest(_step)
    if tier == 3:
        for sk in sorted(set(re.findall(r"(?<![\w/])/([a-z][a-z0-9-]{2,})\b", _acts))):
            if sk in _routed:
                continue
            sp = os.path.join(_root, ".claude", "skills", sk, "SKILL.md")
            if not os.path.isfile(sp):
                # NOT a project skill. Three legitimate reasons before it is a defect,
                # and MEASURED 2026-08-05 every candidate on two real trees was one of
                # them — so this reports 0 rather than nothing, which are different.
                #   a PERSONAL skill      — resolves from ~/.claude/skills, invisible here
                #   a HARNESS built-in    — /help, /model, /compact … not a project file
                #   a PATH FRAGMENT       — `.../prose-evaluator/AGENT.md` and
                #                           `<run-id>/business-correspondent/OUTPUT.md`
                #                           both matched the command grammar. A trailing
                #                           hyphen or a following `/` means it is a path.
                #   a PATH ARGUMENT       — a bare `/tmp` at the end of a shell example
                #                           has no following `/` and escaped the line
                #                           above until 2026-09-13. `_is_path_argument`.
                if (sk.endswith("-") or sk in HARNESS_COMMANDS
                        or re.search(r"/" + re.escape(sk) + r"/", _acts)
                        or _is_path_argument(sk, _acts)
                        or os.path.isfile(os.path.expanduser(
                            os.path.join("~", ".claude", "skills", sk, "SKILL.md")))):
                    continue
                # ADVISORY, not a failure: the filters above are heuristics, and this
                # project's rule is that a heuristic reports and never blocks.
                res.advise(f"{n}: /{sk} resolves to no skill in either scope",
                           f"`/{sk}` is named in ## Procedure or ## Verification and is "
                           f"not a project skill, a personal skill, or a harness command. "
                           f"The step cannot be performed as written, and nothing else "
                           f"reported it — this branch was a bare `continue` until "
                           f"2026-08-05")
                continue
            sfm = frontmatter(read(sp, res) or "") or {}
            spawns = {t.strip() for t in sfm.get("allowed-tools", "").split(",")} & {"Task", "Agent"}
            res.add(not spawns, f"{n}: invokes only skills that spawn nothing (/{sk})",
                    f"`/{sk}` carries {sorted(spawns)} in its `allowed-tools`, so invoking it is a "
                    f"spawn path around this IC's `disallowedTools: Agent`. Re-home the step to a "
                    f"delegating tier, or reduce the skill — do NOT strip its tool if it ships agents "
                    f"that need it (conversion-taxonomy.md § an IC may invoke a skill that spawns "
                    f"nothing).")

    granted = fm.get("tools")
    if granted is not None:
        # THE BARE SLUG IS THE WEAK FORM, AND IT LACKED THE MENTION-IS-NOT-USE FILTER
        # THE REST OF THIS FUNCTION ALREADY CARRIES. `mcp__<server>` is an invocation and
        # is exact. A bare `<name>-mcp` is just a WORD, and three things in an ordinary
        # tree are spelled exactly like a server and are not one:
        #   a project SKILL     — `.claude/skills/build-mcp/SKILL.md`, reached through
        #                         `Skill()`, which grants nothing and needs nothing
        #   the PROJECT ITSELF  — a repository named `playwright-mcp` puts its own name
        #                         in every absolute path its handbooks quote, and in the
        #                         sentence saying what the employee maintains
        #   a PATH SEGMENT      — `/home/u/lab/foo-mcp/src/index.ts` names a directory
        #
        # MEASURED 2026-09-05 by `/workforce verify` on playwright-mcp: 5 of 5 failures
        # were one of the three, across 5 of the 6 handbooks — `build-mcp` (a skill,
        # written as a path every time it appears) and `playwright-mcp` (the repository's
        # own name). The org was correct and the gate was red. `verify.md` § BLOCKING
        # forbids a report arguing a failure away in prose, and rightly, so the exclusion
        # has to be structural: made once here, where a fixture can prove it fires.
        #
        # ONE-SIDED, deliberately. Each exclusion drops a slug from the WEAK form only.
        # `MCP_TOOL_RX` is untouched, so an employee that actually writes
        # `mcp__foo-mcp__thing` is still caught even where the slug is also its project's
        # name. The residual miss is a project named after a server it consumes and never
        # invokes by tool name — one advisory-grade gap, traded against a BLOCKING false
        # positive on every project whose own name ends in `-mcp`.
        _project = os.path.basename(_root).lower()

        def _is_server_slug(slug, line):
            if slug == _project:
                return False      # the project's own name, not a server it reaches
            if re.search(r"/" + re.escape(slug) + r"\b|\b" + re.escape(slug) + r"/", line):
                return False      # a path segment, not an invocation
            for _base in (_root, os.path.expanduser("~")):
                if os.path.isfile(os.path.join(_base, ".claude", "skills", slug, "SKILL.md")):
                    return False  # a SKILL with a server-shaped name, reached by Skill()
            return True

        wanted = set()
        for line in FM_RX.sub("", body, count=1).splitlines():
            if PROHIBITION_RX.search(line):
                continue          # named to forbid it, not to use it
            wanted |= {s.lower() for s in MCP_TOOL_RX.findall(line)}
            wanted |= {s.lower() for s in MCP_SLUG_RX.findall(line)
                       if _is_server_slug(s.lower(), line)}
        have = {s.lower() for s in MCP_TOOL_RX.findall(granted)}
        missing = sorted(wanted - have)
        res.add(
            not missing,
            f"{n}: every MCP server its body uses is named in tools:",
            "body routes work through " + ", ".join(missing)
            + f" but `tools:` grants {sorted(have) or 'no MCP server'} — an explicit "
              "allowlist is a hard ceiling for MCP (fact 13), so this employee cannot "
              "reach it. Add `mcp__<server>` at server level, and do NOT add ToolSearch "
              "alongside it: fact 13 measured that ToolSearch DEFERS tools that arrive "
              "loaded without it.",
        )


def check_defects(root, res):
    """Every DEF record names its class fix, and every record reaches the index.

    THE FIELD THAT STOPS INSTANCE-ONLY FIXING. A DEF is written at the moment
    someone is repairing an instance, so that is where the question "what stops the
    NEXT project hitting this?" has to be forced. `personnel-templates.md` § DEF makes
    `Class fix:` mandatory with exactly two legal values: a named workforce file, or
    `INSTANCE-ONLY` with a reason.

    Measured 2026-08-03: three defects found by cold readers were fixed in the target
    project and left standing in the skill that generates it. The rule already existed
    in three files. Restating it a fourth time was not the fix; a checked field was.

    AND EVERY RECORD IS INDEXED. Four DEF records sat unindexed while the project's own
    `check-personnel-index.sh` was ready to catch it and nobody ran it. A record nothing
    points at is a record the next reader does not know exists.

    WHERE THE RECORDS ARE IS `wf-ledger`'s TO SAY, never this function's. This read
    `personnel/defects/DEF-*.md` while `personnel-templates.md` § Schema has filed every
    record flat at `personnel/<TYPE>-<subject>.md`, so on a host that followed the schema it
    checked NOTHING and passed. Customer DEF-Q-004, 2026-09-15. MEASURED the same day on six
    staffed projects on the maintainer's machine: 120 DEF records, every one flat, and none
    of them ever checked. A record in the older per-type `defects/` folder is still checked,
    not dropped, and is reported as legacy layout so it can be seen. The count prints on
    every run, zero included, because "checked nothing" and "all clean" read the same
    otherwise.
    """
    pdir = os.path.join(root, ".claude", "workforce", "personnel")
    ledger = _load_sibling("wf-ledger")
    flat = [(i, ledger.record_path(root, i)) for i in ledger.record_ids(root)
            if i.startswith("DEF-")]
    legacy = [(i, p) for i, p in ledger.legacy_records(root) if i.startswith("DEF-")]
    res.count(f"DEF records: {len(flat) + len(legacy)} checked · {len(flat)} flat · "
              f"{len(legacy)} in a legacy subfolder")
    for i, p in legacy:
        res.advise(f"{os.path.relpath(p, root)}: legacy layout — § Schema files records flat",
                   f"checked here, but `wf-ledger index` and `consult` cannot see it until it "
                   f"sits at {os.path.relpath(ledger.record_path(root, i), root)} "
                   f"(personnel-templates.md § Schema). ADVISORY: this row blocks nothing")
    names = [(i, p) for i, p in sorted(flat + legacy)]
    if not names:
        return                      # no defects yet is legal

    # ADVISORY AT VERIFY, BLOCKING WHERE A DEF IS WRITTEN (decided 2026-09-15). The field
    # exists to force the class question at the moment a DEF is AUTHORED, and that
    # moment has its own gate: `procedures/defect.md` step 5d runs `wf-conform --def
    # <path>`, which exits 1 on the rows below. At verify these records are history. This
    # check read an empty folder until DEF-Q-004, so its blocking status had never been
    # exercised, and switching it on across every staffed host would be a flag with no
    # fix: no mechanism can supply a Class fix. MEASURED 2026-09-15 on six staffed hosts:
    # 110 of 126 DEF records carry no `**Class fix:**` line. The index half is advisory
    # for the same reason. `wf-ledger index --execute` can rebuild the index, but no
    # audit step runs it, so a blocking row would have no producer.
    ipath = os.path.join(pdir, "index.md")
    index = (read(ipath, res) or "") if os.path.exists(ipath) else None
    no_fix, bad_fix, unindexed = [], [], []
    for stem, path in names:
        body = read(path, res)
        if body is None:
            continue
        for ok, name, _detail in def_record_findings(stem, body, index):
            if ok:
                continue
            if name.endswith("names a Class fix"):
                no_fix.append(stem)
            elif name.endswith("reasoned INSTANCE-ONLY"):
                bad_fix.append(stem)
            else:
                unindexed.append(stem)
    m = len(names)
    if no_fix or bad_fix:
        res.advise(f"{len(no_fix)} of {m} DEF records carry no Class fix — historical; the field "
                   f"is enforced where a DEF is authored"
                   + (f" · {len(bad_fix)} carry one naming no file" if bad_fix else ""),
                   f"{(no_fix + bad_fix)[:5]}{' …' if len(no_fix + bad_fix) > 5 else ''} — "
                   f"procedures/defect.md step 5d runs `wf-conform --def <path>` on every new "
                   f"record and fails it there. ADVISORY: this row blocks nothing")
    if index is None:
        res.advise(f"no personnel index — {m} DEF record(s) on disk and none indexed",
                   "rebuild it from the filesystem with `wf-ledger index --execute`. "
                   "ADVISORY: this row blocks nothing")
    elif unindexed:
        res.advise(f"{len(unindexed)} of {m} DEF records are not in the personnel index",
                   f"{unindexed[:5]}{' …' if len(unindexed) > 5 else ''} — rebuild it from the "
                   f"filesystem with `wf-ledger index --execute`. ADVISORY: this row blocks "
                   f"nothing")


_CLASS_FIX_LINE_RX = re.compile(r"^\*\*Class fix:\*\*[ \t]*(.*)$", re.M)


def class_fix_value(body):
    """The `Class fix` field's value, or None when the record carries none.

    Two spellings, one field: the template's `**Class fix:** <value>` line, and a
    `## Class fix` section whose first non-empty line is the value. The heading form was
    MEASURED on real records (4 of 126 across six hosts, 2026-09-15), and a reader that
    refused it would call an answered question unanswered."""
    m = _CLASS_FIX_LINE_RX.search(body)
    if m:
        return m.group(1).strip()
    seg = section(body, "## Class fix")
    if seg is not None:
        for line in seg.splitlines():
            if line.strip():
                return line.strip()
        return ""
    return None


def def_record_findings(stem, body, index):
    """[(ok, name, detail)] for one DEF record: the ONE grammar verify reads (advisory)
    and `--def` reads (blocking, at write time). `index` is the personnel index text, or
    None when there is no index."""
    out = []
    val = class_fix_value(body)
    out.append((bool(val), f"{stem}: names a Class fix",
                "a defect in a generated org is evidence about the generator; without this "
                "field the shape recurs in the next project (personnel-templates.md § DEF)"))
    if val:
        # INSTANCE-ONLY must carry a reason; anything else must name a file.
        if val.upper().startswith("INSTANCE-ONLY"):
            ok = len(val) > len("INSTANCE-ONLY") + 4
            detail = "`INSTANCE-ONLY` with no reason is not a disposition"
        else:
            ok = bool(re.search(r"[\w./-]+\.(md|py|sh)\b|`[^`]+`", val))
            detail = ("names an intention rather than a file — a class fix is a change to a "
                      "named workforce file, or it is INSTANCE-ONLY with a reason")
        out.append((ok, f"{stem}: Class fix is a file or a reasoned INSTANCE-ONLY", detail))
    # `wf-ledger.indexed_ids` is the ONE index reader: a row or a link, never a substring,
    # which counted an ID named in a narrative paragraph as indexed (DEF-Q-20).
    out.append((index is not None and stem in _load_sibling("wf-ledger").indexed_ids(index),
                f"{stem}: appears in the personnel index",
                "a record nothing points at is one the next reader never finds"))
    return out


# A path a journal row RECORDS, in the repo-relative form every journal writes it:
# optionally backticked, optionally `./`-prefixed, always under `.claude/`. An absolute
# host path is deliberately unmatched — a row naming one is naming a tree outside the
# root this run was asked about, and resolving it would check somebody else's disk.
JOURNAL_PATH_RX = re.compile(r"(?:\./)?\.claude/[A-Za-z0-9._/@+-]+")
# A T8 row that reports the DELETION, not merely the commit. `hire.md` § The order ends
# EVERY transaction at `T8 journal COMMITTED`, and § On a HIRE keeps that row for a hire
# that retired nothing (`T8 follows T6 directly`), so the row alone cannot mean "swept".
# The verb is what
# separates the sweep from the commit, and all three shapes measured on live journals
# carry one: `SWEPT — directory removed`, `swept at Step 6c`, `sweep (Step 6c): 176
# unlinked`.
SWEEP_VERB_RX = re.compile(r"\bswept\b|\bsweep\b|\bunlinked\b|directory removed", re.I)


def swept_undo_paths(body):
    """`name` -> the paths its COMMITTED T8 sweep row records, for every swept target.

    THE UNDO IS RELOCATED BY THE ACT THE ROW RECORDS. Before the sweep the staged tree
    sits at `.claude/workforce/staging/<name>/tree`; the sweep moves it under the run it
    belongs to and the T8 row writes down where, e.g. *"SWEPT — directory removed; undo
    at .claude/workforce/work/<run-id>/staging/<name>/tree (73 files)"*.

    Measured on a live host: a correctly swept `skill-builder` — undo present at the
    recorded path, absent under `staging/` — failed the whole-directory row below on
    every verify after the sweep, with no edit that could ever clear it. The sweep was
    behaving; the reader was looking at one hard-coded path and calling the other
    absent. `check_journal` already trusts the path a row records, and this is the same
    principle applied one row later.

    ROW SHAPE IS NOT ASSUMED, because three live journals write three of them (7 cells
    with a `seq` first, 5 with a `run-id` first, 4 with the name first). The step cell
    is found by value and the name is the cell in FRONT of it, which holds in all three.
    `(hire)` and other parenthesized pseudo-names are dropped: a hire retires nothing.
    """
    out = {}
    for line in body.splitlines():
        if "T8" not in line or "COMMITTED" not in line:
            continue
        cells = [c.strip().strip("*").strip("`").strip()
                 for c in line.strip().strip("|").split("|")]
        # An exact CELL, never a prose mention of T8 in a note about the journal.
        if "T8" not in cells or cells.index("T8") == 0:
            continue
        if not SWEEP_VERB_RX.search(line):
            continue
        name = cells[cells.index("T8") - 1]
        if not name or name.startswith("("):
            continue
        out.setdefault(name, []).extend(JOURNAL_PATH_RX.findall(line))
    return out


def undo_tree(root, staging, name, recorded):
    """(the staged undo tree on disk or None, every path looked at for it).

    `recorded` is None for a target this journal has not swept — then the mid-run
    staging path is the only legal home and the search is exactly what it always was.
    A swept target is looked for in the order that trusts the record first:

      1  the path its T8 row wrote down (truncated to the `tree/` component, so a row
         naming a file inside the tree still resolves the tree)
      2  `work/<run-id>/staging/<name>/tree` under the run `.current-run` names
      3  the same path under every other run directory, newest name last
      4  `staging/<name>/tree`, the mid-run home it was moved out of

    EXISTENCE IS STILL PROVEN, never assumed from the row. A T8 row is not permitted to
    stand in for the artifact: a recorded undo that is not on disk fails exactly as an
    unstaged one does, because the sweep's only whole-directory reversal is the bytes.
    """
    tried = []

    def _cand(p):
        p = os.path.normpath(p)
        # A recorded path NAMES a location inside this tree; it never escapes it.
        # `..` in a row is a row to distrust, not a directory to go read.
        if p != root and not p.startswith(root + os.sep):
            return
        if p not in tried:
            tried.append(p)

    for rec in (recorded or []):
        rel = os.path.normpath(rec)
        # AN UNDO LIVES UNDER `.claude/workforce/`, AND A ROW NAMES OTHER PATHS TOO.
        # Every sweep row also carries the target itself (`.claude/skills/<name>`), and
        # a `tree/` subdirectory inside a live skill would then answer the undo question
        # with the very directory the sweep is about to delete.
        if not rel.startswith(os.path.join(".claude", "workforce") + os.sep):
            continue
        parts = rel.split(os.sep)
        if "tree" in parts:
            _cand(os.path.join(root, *parts[:parts.index("tree") + 1]))
        elif parts[-1] == name:
            _cand(os.path.join(root, rel, "tree"))
    if recorded is not None:
        work = os.path.join(root, ".claude", "workforce", "work")
        cur = os.path.join(root, ".claude", "workforce", ".current-run")
        try:
            run = (open(cur, encoding="utf-8", errors="replace").read().strip()
                   .splitlines() or [""])[0].strip()
        except OSError:
            run = ""      # unreadable is not a finding here; the enumeration below covers it
        if run and "/" not in run and run not in (".", ".."):
            _cand(os.path.join(work, run, "staging", name, "tree"))
        if os.path.isdir(work):
            for run in sorted(os.listdir(work)):
                _cand(os.path.join(work, run, "staging", name, "tree"))
    _cand(os.path.join(staging, name, "tree"))
    for p in tried:
        if os.path.isdir(p):
            return p, tried
    return None, tried


def check_removal_set(root, body, staging, res):
    """The removal set has exactly one producer, and every decided removal reaches it.

    THE MARK IS A COMMITTED `T7c` ROW. `procedures/hire.md` § The journal, and both
    consumers — `audit.md` § Step 6c and `sweep.md` § 3 — enumerate the removal set
    from those rows and nothing else.

    This function exists because that row had a reader and no writer, twice over:

      A  `T7c` was inserted into the T-order on 2026-08-04 and made the mark
         conditional. The sentence defining the mark still said "the COMMITTED T7
         journal row", and no row shape was defined for the step the mark moved to.
      B  A skill removed by SUCCESSION is never converted, so it never enters the
         T-order at all. `conversion-taxonomy.md` decided those removals and — until
         2026-08-06 — contained the string "journal" zero times.

    Measured on odyssey-alive across three consecutive audits: `skill-builder`
    dispositioned SUPERSEDED GENERATOR / removed entirely, `.claude/skills/skill-builder/`
    on disk the whole time, ZERO journal rows naming it, 32 `T7` rows and ZERO `T7c`
    rows. Every run printed `INV-SUCCESSION  sweep NOT executed — removal set is empty`
    and every run was reporting the arithmetic of a table nothing filled in.

    Read literally instead, the old definition made the removal set all 32 T7 rows —
    every one of them a reduced, still-invocable skill that directive one requires to
    keep working. A gate in front of the only destructive command may not have two
    readings that differ by the whole library, which is why this is a failure and not
    an advisory.

    Four findings, each a different missing half:
      UNSTAGED   dispositioned for removal, no `T7c` row   -> the sweep cannot see it
      UNMARKED   `T7s` staged, no `T7c` row                -> bytes copied for nothing
      NO-UNDO    `T7c` row, no `T7` or `T7s` row           -> marked with no undo behind it
      NO-TREE    `T7s` row, no staged `tree/`              -> the surgical undo covers
                                                              SKILL.md and nothing else

    NO-TREE is answered against the path the journal RECORDS once the target has been
    swept — see `undo_tree`, which reads the relocation the sweep performs.
    """
    marked, staged, undone, declined = set(), set(), set(), set()
    for line in body.splitlines():
        cells = [c.strip().strip("`") for c in line.strip().strip("|").split("|")]
        if len(cells) < 7:
            continue
        name, step, status = cells[1], cells[2], cells[6]
        # A REFUSAL IS A FIRST-CLASS OUTCOME AND IT IS RECORDED, NOT MISSING.
        # Failure containment (SKILL.md § Atomic-or-Absent rule 7) marks a target ✗
        # and continues — a short extraction at T2 is the common case, and it is
        # SUPPOSED to leave the target unmarked. Without this the run that correctly
        # refused a removal would be failed for refusing it, on every later verify,
        # with no edit that could ever clear it.
        if status == "✗" and step in ("T2", "T7s", "T7c"):
            declined.add(name)
            continue
        if status != "COMMITTED":
            continue
        if step == "T7c":
            marked.add(name)
        elif step == "T7s":
            staged.add(name)
            undone.add(name)
        elif step == "T7":
            undone.add(name)
    staged -= declined

    for name in sorted(marked - undone):
        res.add(False, f"removal set: {name} marked at T7c has an undo row",
                f"a COMMITTED T7c row marks {name} for the sweep and no T7 or T7s row "
                "records an `.orig` for it. The mark is what the sweep reads and the "
                "`.orig` is its only surgical undo; a mark without one authorizes a "
                "deletion whose single-file reversal was never written.")
    for name in sorted(staged - marked):
        res.add(False, f"removal set: {name} staged at T7s reached its T7c mark",
                f"{name} was staged for removal and never marked. `hire.md` § A removal "
                "target stages too: T7s never appears without its T7c — either the mark "
                "is missing, or a rule declined the removal and the run owes that rule "
                "by name.")
    swept = swept_undo_paths(body)
    for name in sorted(staged):
        tree, tried = undo_tree(root, staging, name, swept.get(name))
        shown = ", ".join(os.path.relpath(t, root) for t in tried[:4])
        if len(tried) > 4:
            shown += f" (+{len(tried) - 4} more)"
        # THE DETAIL DESCRIBES THE RESULT, and `--json` writes it for passing rows too.
        # It used to say "the undo it names is at none of: <paths>" whether or not the
        # search found it. MEASURED 2026-09-16 on apps-odyssey-alive: the row for
        # `work-reap-audit-20260911T152332Z` read `"ok": true` with that sentence, the undo
        # tree on disk at the first path listed, and an audit filed the reap as having
        # lost its undo. The reap was right; this sentence was not.
        detail = ((f"its COMMITTED T8 row records the sweep, and the undo it names is at "
                   f"none of: {shown}. "
                   if name in swept else f"absent at {shown}. ")
                  + "A T7s target is unlinked ENTIRELY — references/, "
                  "scripts/, hooks/, and every dataset go with it — so SKILL.md.orig is "
                  "an undo for the least of what the sweep removes.")
        if tree:
            detail = f"undo found at {os.path.relpath(tree, root)}"
        res.add(bool(tree), f"removal set: {name} staged its whole directory", detail)

    # THE DECIDED-BUT-UNSTAGED CASE. Keyed on the taxonomy's own category token so a
    # renamed generator is still caught: `conversion-taxonomy.md` § ORCHESTRATOR names
    # SUPERSEDED GENERATOR as the disposition that is "removed entirely — not retained,
    # not converted, not stubbed", and dispositions.md writes it in the disposition cell.
    dp = os.path.join(root, ".claude", "workforce", "dispositions.md")
    if not os.path.exists(dp):
        return
    disp = read(dp, res)
    if disp is None:
        return
    decided = set()
    for line in disp.splitlines():
        cells = [c.strip().strip("*").strip("`").strip() for c in
                 line.strip().strip("|").split("|")]
        if len(cells) < 3 or not cells[0]:
            continue
        blob = " ".join(cells[1:])
        if "SUPERSEDED GENERATOR" in blob or "Removed entirely" in blob:
            decided.add(cells[0].strip("*").strip("`").strip())
    for name in sorted(decided & declined):
        res.advise(f"removal set: {name} was dispositioned for removal and declined",
                   "the journal records a ✗ against it, so the run refused the removal "
                   "and said so. Reported, never enforced — refusing an act is the "
                   "design; the finding is a run that neither stages nor refuses.")
    for name in sorted(decided - marked - declined):
        res.add(False, f"removal set: {name} was dispositioned for removal and staged",
                f"dispositions.md decides {name} is removed entirely and the conversion "
                "journal holds no COMMITTED T7c row for it, so the removal set the sweep "
                "reads does not contain it. Run `/workforce audit` — Step 6-S stages it "
                "(T2 extract, T7s copy, T7c mark) and Step 6c performs the deletion. An "
                "empty removal set under a decided removal is a finding about the staging "
                "step, never a description of the tree.")
    if decided:
        res.add(True, f"removal set: {len(decided)} dispositioned · "
                      f"{len(staged)} staged · {len(marked)} marked")

    for name in sorted(decided | staged):
        check_removal_extraction(root, name, res)


def check_removal_extraction(root, name, res):
    """T2 for a removal target: every sacred span inside it is extracted first.

    THIS IS THE ONE GATE STANDING BETWEEN A DIRECTORY DELETION AND THE USER'S OWN
    WORDS. `conversion-taxonomy.md` § What succession removes: those spans "are the
    only content in a managed tree that no regeneration can reconstruct", and the
    gate is blocking BEFORE the first file is removed.

    It was specified and it was not computable. `INV-DIRECTIVES` counts `N of N`
    TREE-WIDE; T2 for a T7s target asks a DIRECTORY-scoped question, and `wf-census`
    published only the aggregate. So the only way to answer it was a hand grep —
    which, run unanchored on 2026-08-06, reported 37 sacred spans inside
    `skill-builder` against the true 6, by matching indented examples and markers
    quoted mid-line inside a file that DOCUMENTS the marker format. A gate answered
    by a hand count is a gate whose verdict changes with who runs it.

    `wf-census` now emits `immutable_blocks.by_file` with line numbers, and this
    check uses the same line-anchored grammar `bin/check` cross-tests across every
    reader. Coverage is joined on `file:line`, so a shortfall names the span rather
    than the difference between two totals.

    `.claude/workforce/directives/` is the extraction output and citations may live
    in ANY file there — the run keys them by skill, and a run that keyed them
    differently still cites the same `file:line`. Scanning the directory rather than
    one filename is what makes this robust to that.
    """
    target = os.path.join(root, ".claude", "skills", name)
    if not os.path.isdir(target):
        return                          # already swept, or never a directory

    spans = []
    for dirpath, dirnames, filenames in os.walk(target):
        dirnames[:] = [d for d in dirnames if d not in (".git", "node_modules")]
        for fn in sorted(filenames):
            if not fn.endswith(".md"):
                continue                # the census grammar is markdown-scoped
            p = os.path.join(dirpath, fn)
            try:
                body = open(p, encoding="utf-8", errors="replace").read()
            except OSError:
                continue
            rel = os.path.relpath(p, root)
            for lineno, line in enumerate(body.splitlines(), 1):
                if IMMUTABLE_OPEN_RX.match(line):
                    spans.append((rel, lineno))
    if not spans:
        res.add(True, f"removal set: {name} holds no sacred spans to extract")
        return

    ddir = os.path.join(root, ".claude", "workforce", "directives")
    cited = set()
    if os.path.isdir(ddir):
        for dirpath, _dn, filenames in os.walk(ddir):
            for fn in filenames:
                try:
                    blob = open(os.path.join(dirpath, fn),
                                encoding="utf-8", errors="replace").read()
                except OSError:
                    continue
                for skill, path, line in EXTRACT_CITE_RX.findall(blob):
                    cited.add((f".claude/skills/{skill}/{path}", int(line)))

    missing = [f"{f}:{n}" for f, n in spans if (f, n) not in cited]
    res.add(not missing,
            f"removal set: {name} extracted {len(spans) - len(missing)} of "
            f"{len(spans)} sacred span(s) before deletion",
            ("not extracted: " + ", ".join(missing[:6])
             + (f" (+{len(missing) - 6} more)" if len(missing) > 6 else "")
             + ". These are the user's own words and the sweep unlinks the directory "
               "holding them. T2 is blocking: extract them verbatim with their source "
               "`file:line`, or the target is marked ✗ and NOT swept."))


def check_journal(root, res):
    """Every T7 and T7s row's `.orig` exists on disk and hashes to its prior-sha.

    THE UNDO ARTIFACT, CHECKED AS AN ARTIFACT. `SKILL.md` § Atomic-or-Absent rule 6:
    "T7 IS COPY-THEN-MARK. Copy the live SKILL.md to `<staging>/<name>/SKILL.md.orig`
    and record its sha in the journal BEFORE marking it. `.orig` is retained after the
    run and is the single-file undo."

    `audit.md` Step 6c precondition 4 guarded this as *"every marked skill has its
    `.orig` recorded and hashed IN THE JOURNAL"* — and that is the whole defect. It
    reads the journal to check a claim the journal makes about itself. A row can say
    `prior-sha: see .orig` with no `.orig` anywhere and satisfy it.

    Measured 2026-08-03 on apps-odyssey-alive: journal row 101 marked `skill-builder`
    at T7, status COMMITTED, `prior-sha` reading `see .orig`, and ZERO `.orig` files on
    disk. The sweep is the only command that deletes and this is its only single-file
    undo; the gate in front of it could not tell the difference between an undo that
    existed and a sentence saying one did.

    Two findings, kept separate because they need different fixes:
      MISSING   no file at the staging path       -> the undo does not exist
      DRIFT     file present, sha != prior-sha    -> it exists and is not what was
                                                    recorded; restoring it would write
                                                    bytes nobody verified

    A `prior-sha` that is not 64 hex characters is itself reported: the spec says
    record the sha, and a pointer ("see .orig") is what let this hide.
    """
    jp = os.path.join(root, ".claude", "workforce", ".conversion-journal.md")
    if not os.path.exists(jp):
        return                      # no journal is not a finding; day-one is legal
    body = read(jp, res)
    if body is None:
        return

    staging = os.path.join(root, ".claude", "workforce", "staging")
    check_removal_set(root, body, staging, res)
    rows = 0
    for line in body.splitlines():
        cells = [c.strip().strip("`") for c in line.strip().strip("|").split("|")]
        if len(cells) < 7 or cells[2] not in ("T7", "T7s"):
            continue
        step = cells[2]
        name, path_cell, prior, status = cells[1], cells[3], cells[5], cells[6]
        # N/A rows are printed deliberately (a hire has no predecessor to copy).
        if "N/A" in status or "N/A" in prior or status == "✗":
            continue

        # AGGREGATE ROWS ARE NOT SKILLS. A journal may mark a class of edits in one
        # row — "(all skills) | scaffolding blocks emitted by skill-builder" — and
        # such a row has no single SKILL.md and never had an `.orig`. The path cell
        # decides it: a real conversion row names a skill directory that exists.
        # Without this the check demanded `staging/(all skills)/SKILL.md.orig`, a
        # path nothing was ever going to write, and reported its absence as the same
        # defect as a genuinely missing undo. One finding was real and one was the
        # check misreading a row; reporting them identically devalues both.
        if not os.path.isdir(os.path.join(root, path_cell)):
            res.add(True, f"journal: {name} {step} is an aggregate row (undo is the backup)")
            continue

        rows += 1
        orig = os.path.join(staging, name, "SKILL.md.orig")
        if not os.path.exists(orig):
            res.add(False, f"journal: {name} {step} `.orig` exists on disk",
                    f"row stages {name} at {step} with status {status}, and {orig} is absent. "
                    "The sweep's single-file undo does not exist. Restore it from the "
                    "pre-run backup before any deletion.")
            continue
        res.add(True, f"journal: {name} {step} `.orig` exists on disk")
        if not re.fullmatch(r"[0-9a-f]{64}", prior or "", re.I):
            res.add(False, f"journal: {name} {step} prior-sha is a sha",
                    f"prior-sha reads {prior!r}. The spec records a sha; a pointer "
                    "cannot be compared against anything, which is how a missing "
                    "`.orig` passed a gate that claimed to hash it.")
            continue
        got = hashlib.sha256(open(orig, "rb").read()).hexdigest()
        res.add(got == prior.lower(), f"journal: {name} {step} `.orig` matches prior-sha",
                f"recorded {prior[:16]}…, on disk {got[:16]}… — the undo artifact is "
                "not the file that was recorded. Do not restore from it.")
    if rows:
        res.add(True, f"journal: {rows} T7/T7s row(s) checked against disk")


def check_catalogs(root, res):
    """Every evaluator carries a catalog anchor before the sweep can remove the source.

    `evaluators.md` § Succession removes the source makes reconciliation a PRECONDITION
    of the sweep: the predecessor's catalog is readable only while it is still on disk,
    and after the sweep the comparison has no input at all.

    **`v0` and `reconciled, nothing to add` are opposite facts about the same zero**, and
    without an anchor nothing can tell them apart. Measured 2026-08-03: all three
    evaluators in a real project read `v0`, and the only genuine catalog pairing turned
    out to be 0-missing — so a sweep would have frozen three catalogs permanently while
    every visible number looked fine.
    """
    sk = os.path.join(root, ".claude", "skills")
    if not os.path.isdir(sk):
        return
    evs = sorted(d for d in os.listdir(sk)
                 if os.path.isdir(os.path.join(sk, d))
                 and ("eval" in d or "evaluator" in d))
    for e in evs:
        anchor = os.path.join(sk, e, "CATALOG-ANCHOR.md")
        ok = os.path.isfile(anchor)
        res.add(ok, f"catalogs: {e} carries a reconciliation anchor",
                "no CATALOG-ANCHOR.md — reads as v0, never reconciled. The sweep removes the "
                "predecessor and with it the only thing this could be compared against "
                "(evaluators.md § Succession removes the source).")


# The remedy for a dead row this distribution did not write. The remedies for workforce's
# own rows are `wf-settings-apply`'s VERDICT_REMEDY, beside the classifier that decides
# them, so the text printed is always what the heal will do. A plain constant, so it names
# the command whose flags it carries (bin/check § flag lies reads string constants).
FOREIGN_REMEDY = ("not a workforce script, so the heal leaves it alone. `wf-apply --root "
                  "<tree> --execute` (PASS-DEAD-HOOK) removes it with its reversal recorded, "
                  "and refuses one under declared succession")


def _personal_root(census, cfg, root):
    """Is `cfg` really somebody's personal config root? The running one and the default
    `~/.claude` are; an install inside the project, or an ancestor's `.claude` (a
    monorepo's vendored install), is not; otherwise a root is personal only when it holds
    Claude Code's own `projects/` store. The advisory once called a monorepo root's
    vendored install "ONE account's personal install" (second review, N5)."""
    real = os.path.realpath(cfg)
    if real in {os.path.realpath(census.config_root()),
                os.path.realpath(os.path.join(os.path.expanduser("~"), ".claude"))}:
        return True
    here = os.path.realpath(root)
    if real == here or real.startswith(here + os.sep):
        return False
    up = here
    while True:
        if real == os.path.join(up, ".claude"):
            return False
        parent = os.path.dirname(up)
        if parent == up:
            break
        up = parent
    return os.path.isdir(os.path.join(real, "projects"))


def _second_copy(wsa, census, root, event, script, this_path):
    """Where ELSE this session runs the same hook on the same event, or None: the other
    project settings file, another row in this one, or the running account's user
    settings. Without a second copy nothing fires twice, and saying so would be false."""
    places, seen = [], set()
    for p in [os.path.join(root, ".claude", n) for n in ("settings.local.json", "settings.json")] \
            + [os.path.join(census.config_root(), "settings.json")]:
        if os.path.realpath(p) not in seen:
            seen.add(os.path.realpath(p))
            places.append(p)
    for p in places:
        data, _t, _e = wsa._load_strict(p)
        live = 0
        for ev, _m, h in _hook_rows(data or {}):
            ident = wsa._wf_identity(h, root) if ev == event else None
            live += bool(ident is not None and ident[0] == script and ident[1])
        if live >= (2 if os.path.realpath(p) == os.path.realpath(this_path) else 1):
            return p
    return None


def check_hook_wiring(root, res):
    """Every hook registered in this project's settings resolves to a file on disk.

    WHY IT IS IN THE COUNT. `verify` printed `N checks · 0 failed` from this script while
    the same project's settings held dead registrations, because the dead-wiring finding
    lived in a separate procedure step and never reached the headline. MEASURED
    2026-09-14: the census counted 38 dead rows across six projects on one workstation,
    each failing on every prompt and tool call, and three of those projects read
    `0 failed`. A headline that can be green over a failure on every event is the
    overclaim this script exists to refuse.

    PROJECT FILES ONLY. The personal settings file is the same for every project on the
    machine and belongs to the installer; reading it here would make this result depend
    on who runs it, which a fixture cannot pin.

    ONE RESOLVER, ONE VERDICT. A workforce row is resolved by `wf-census`'s
    `workforce_hook` and judged by `wf-settings-apply`'s `dead_row_verdict`, the same two
    functions the heal runs, so the remedy printed is the thing that happens. A live row
    into a personal install that ALSO runs from a second place is ADVISORY: it fires
    twice, and removing it is a judgement.
    REPORTS; NEVER REPAIRS.
    """
    census_mod = _load_sibling("wf-census")
    census = census_mod.Census(root)
    wsa = _load_sibling("wf-settings-apply")
    rows, dead = 0, 0
    own_install = os.path.realpath(os.path.join(root, ".claude"))
    for rel in (os.path.join(".claude", "settings.local.json"),
                os.path.join(".claude", "settings.json")):
        p = os.path.join(root, rel)
        if not os.path.isfile(p):
            continue
        try:
            with open(p, encoding="utf-8") as fh:
                cfg = json.load(fh)
        except (OSError, ValueError) as exc:
            res.advise(f"hook wiring: {rel} could not be read as JSON — not examined",
                       f"{exc.__class__.__name__}: the harness cannot read it either")
            continue
        for event, matcher, h in _hook_rows(cfg):
            rows += 1
            resolved, exists = census.resolve_hook_command(h["command"])
            wh = wsa.CENSUS.workforce_hook(h["command"], root)
            where = f"hook wiring: {rel} · {event} · {matcher or '(no matcher)'}"
            if exists is False:
                dead += 1
                verdict, _wh = wsa.dead_row_verdict(h, root)
                res.add(False, f"{where} → {resolved} is not on disk",
                        wsa.VERDICT_REMEDY.get(verdict) if verdict else FOREIGN_REMEDY)
            elif (wh is not None and wh["form"] in ("absolute", "home")
                  and os.path.realpath(wh["cfg"]) != own_install
                  and _personal_root(census_mod, wh["cfg"], root)):
                other = _second_copy(wsa, census_mod, root, event, wh["script"], p)
                if other:
                    res.advise(f"{where} → {wh['path']}",
                               f"points into the personal config root {wh['cfg']}, and this "
                               f"session also runs the same hook from {other}, so it fires "
                               f"twice here; the row also fails on any machine or account "
                               f"without {wh['cfg']}. Never removed automatically: whether "
                               f"it is redundant for every account that reads this file "
                               f"cannot be proven from one machine. Delete it by hand once "
                               f"every account that opens this project has workforce wired "
                               f"at user scope")
    if rows and not dead:
        res.add(True, f"hook wiring: {rows} registration(s) in this project's settings · "
                      f"0 dead")


def _hook_rows(cfg):
    """`(event, matcher, hook)` for every command hook in one settings object."""
    hooks = cfg.get("hooks") if isinstance(cfg, dict) else None
    for event, entries in (hooks.items() if isinstance(hooks, dict) else ()):
        for e in (entries if isinstance(entries, list) else ()):
            inner = e.get("hooks") if isinstance(e, dict) else None
            for h in (inner if isinstance(inner, list) else ()):
                if isinstance(h, dict) and isinstance(h.get("command"), str) and h["command"].strip():
                    yield event, e.get("matcher"), h


# ── what a data skill IS, and which files are its records — ONE definition ──────
# `wf-conform` (which data skills to hold to the contract) and `wf-remainder --swept-refs`
# (which mentions are history in a record, never to be rewritten) both read this. A skill
# is a data skill when it DECLARES the contract, never when its directory has a
# suggestive name. The census bars that inference (`procedures/audit.md` § .censusignore).
# There are two declarations:
#   1. its name follows workforce's own scheme, `records-<dataset>` (`data-skills.md`
#      § Naming). Workforce gave it that name, so the name is itself a declaration;
#   2. its `## Invariants` carries the universal invariant, the one clause `data-skills.md`
#      says is "always present, in every data skill, generated or hand-written". This is
#      how a converted predecessor knowledge base like `awareness-ledger` is recognized:
#      conversion writes the contract into its gateway and leaves the records in place.
# Its RECORDS are the paths its own `## Schema` declares. Real schemas measured
# 2026-09-15 on six staffed hosts name them as backticked templates:
# `ledger/<bucket>/<TYPE>-<YYYY-MM-DD>-<slug>.md`, `ledger/index.md`, `data/<slug>.json`,
# `.claude/workforce/personnel/<TYPE>-<subject>.md`. A template with an interior `/` is a
# path. A single segment (`decisions/`, `README.md`) is not taken, because schemas also
# name folders and files that are NOT records ("a bucket `README.md` is not a record").
# A schema that declares nothing recognizes nothing, so the error goes toward reporting
# a mention, never toward hiding one.
UNIVERSAL_INVARIANT = "may never authorize a write"
_SCHEMA_TOKEN_RX = re.compile(r"`([^`\s]+)`")


def is_data_skill(name, body):
    inv = section(body, "## Invariants") or ""
    return name.startswith("records-") or UNIVERSAL_INVARIANT in inv


def data_skills(root):
    """[(skill_dir, body)] for every data skill under `<root>/.claude/skills`, sorted."""
    base = os.path.join(root, ".claude", "skills")
    out = []
    try:
        entries = sorted(os.listdir(base))
    except OSError:
        return out
    for entry in entries:
        p = os.path.join(base, entry, "SKILL.md")
        try:
            with open(p, encoding="utf-8") as fh:
                body = fh.read()
        except (OSError, UnicodeDecodeError):
            continue
        if is_data_skill(entry, body):
            out.append((os.path.join(base, entry), body))
    return out


def _template_rx(tpl):
    """A schema path template as a regex. `<…>` and `*` match within one path segment,
    and `**` matches across segments."""
    out, i = [], 0
    while i < len(tpl):
        if tpl.startswith("**", i):
            out.append(".*")
            i += 2
        elif tpl[i] == "*":
            out.append("[^/]*")
            i += 1
        elif tpl[i] == "<" and tpl.find(">", i) > i:
            out.append("[^/]*")
            i = tpl.find(">", i) + 1
        else:
            out.append(re.escape(tpl[i]))
            i += 1
    return "".join(out)


def record_patterns(root):
    """[(regex over a root-relative `/`-path, skill_dir)] for every record path a data
    skill's `## Schema` declares. A template starting `.claude/` is relative to the project
    root, and any other is relative to the skill's directory."""
    out = []
    for skill_dir, body in data_skills(root):
        rel_skill = os.path.relpath(skill_dir, root).replace(os.sep, "/")
        for tok in _SCHEMA_TOKEN_RX.findall(section(body, "## Schema") or ""):
            t = tok[2:] if tok.startswith("./") else tok
            core = t.rstrip("/")
            if ("/" not in core or t.startswith(("/", "~", "$", "#"))
                    or ".." in core.split("/")):
                continue
            prefix = "" if t.startswith(".claude/") else rel_skill + "/"
            tail = "(?:/.*)?" if t.endswith("/") else ""
            out.append((re.compile("^" + re.escape(prefix) + _template_rx(core) + tail + "$"),
                        skill_dir))
    return out


def is_record(root, path, patterns=None):
    """True when `path` is a file some data skill's `## Schema` declares. A data skill's own
    `SKILL.md` never is: it is the gateway, and it stays live."""
    if os.path.basename(path) == "SKILL.md":
        return False
    rel = os.path.relpath(path, root).replace(os.sep, "/")
    return any(rx.match(rel) for rx, _d in
               (record_patterns(root) if patterns is None else patterns))


def check_data_skill(path, body, res):
    n = os.path.relpath(path)
    missing = [s for s in DATA_SKILL_SECTIONS if ("\n" + s) not in body]
    # NOT A DEAD END. Each missing section has an owner that writes it: audit Step 3b drafts
    # it from the skill's own data, and `wf-companion` appends it to workforce's own
    # `personnel-ledger` from shipped source.
    res.add(not missing, f"{n}: data skill carries every required section",
            f"missing: {missing} — the next `/workforce audit` completes it: Step 3b § Datasets "
            f"drafts each missing section from this skill's own data and appends it, every existing "
            f"byte kept (procedures/audit.md). `personnel-ledger` is completed from shipped source "
            f"by `wf-companion --execute`")
    if "## Invariants" in body:
        seg = section(body, "## Invariants") or ""
        res.add("may never authorize a write" in seg,
                f"{n}: carries the universal invariant",
                "degraded state may cause more work; it may never authorize a write")


def check_sidecar(root, res):
    """Verify immutable-block digests against the sidecar, in the CANONICAL format.

    `procedures/checksums.md` § The row grammar is the authority, and both readers
    now implement it: one row per BLOCK, sha over the NORMALIZED block content.

        <sha256>  <path-relative-to-project-root>:directive:<N>

    This reader and `wf-protect-directives` used to disagree on both halves — this
    one split on a double space and hashed whole FILE bytes, that one parsed
    `:directive:N` and hashed normalized BLOCK content. Neither could ever agree
    with the other, and no canonical format was written down anywhere, which is
    verbatim the incident `checksums.md` opens by citing:

        "a checksum generator wrote rows its own parser could not read. The hook
         then reported clean about blocks it never examined."

    Generators are strict; readers are liberal (checksums.md rule 1) — so a
    malformed row is REPORTED, never silently skipped. A row this reader cannot
    parse is a coverage gap, and a coverage gap is a finding.
    """
    side = os.path.join(root, ".claude", "workforce", ".directives.sha")
    if not os.path.exists(side):
        res.add(True, "sidecar: absent (no directives extracted yet)",
                "absent is a first-class state, not an error")
        return
    body = read(side, res)
    if body is None:
        return

    data = [l for l in body.splitlines() if l.strip() and not l.startswith("#")]
    rows, malformed = {}, []
    for line in data:
        m = ROW_RX.match(line)
        if m:
            rows.setdefault(m.group(2), {})[int(m.group(3))] = m.group(1).lower()
        else:
            malformed.append(line.strip()[:70])

    # A sidecar with data lines and no parseable rows is NO coverage, not clean.
    if data and not rows:
        res.add(False, "sidecar: parses",
                f"{len(data)} data line(s), none parseable — this is the state that "
                "reports clean about blocks it never examined")
        return
    for bad in malformed:
        res.add(False, f"sidecar: malformed row {bad!r}", "canonical grammar: <sha>  <path>:directive:<N>")

    for rel, blocks in sorted(rows.items()):
        p = os.path.join(root, rel)
        if not os.path.exists(p):
            res.add(False, f"sidecar: {rel} present", "a stamped row names a file that is gone")
            continue
        body_f = read(p, res)
        if body_f is None:
            continue
        found = [normalize(m.group(1)) for m in BLOCK_RX.finditer(body_f)]
        for i, want in sorted(blocks.items()):
            if i > len(found):
                res.add(False, f"sidecar: {rel}:directive:{i} present",
                        "the sidecar stamps a block the file no longer has")
                continue
            got = hashlib.sha256(found[i - 1].encode("utf-8")).hexdigest()
            res.add(got == want, f"sidecar: {rel}:directive:{i} digest matches",
                    "a sacred block changed after it was stamped — flag, never repair")

    # ── COVERAGE: the denominator comes from the TREE, never from the sidecar ──
    # Everything above iterates `rows` — the blocks the sidecar already names — so it
    # answers "do the stamped blocks still match?" and never "is every block stamped?"
    # A block absent from the sidecar was checked by nothing and reported by nothing:
    # `wf-protect-directives` would call it UNPROTECTED, and this file said `0 failed`.
    #
    # MEASURED 2026-08-07 by `/workforce dev sweep` on this repository. The tree held 13
    # sacred blocks and the sidecar stamped 12. The unstamped one was a cold reader's
    # question quoted verbatim inside an `origin: user | immutable: true` span at column
    # 0 in a `DEF` record — a real protected span, guarded by nothing, while the gate
    # `procedures/sweep.md` step 4 calls "the sacred-block gate, short by one → STOP"
    # read N of N and let a destructive command proceed.
    #
    # Same shape as the vacuous attribution guard in `bin/check` fixed the day before: a
    # check that verifies what it was TOLD about rather than what EXISTS. Both were green
    # for as long as they were wrong, which is the property that makes the class dangerous.
    #
    # Scoped to `.claude/`: the sidecar's rows are project-tree paths, and a source
    # distribution under `workforce/` carries its own stamp in `workforce/.immutable.sha`.
    #
    # THE DENOMINATOR IS THE CENSUS'S, not this file's. `.censusignore` is read
    # through `wf-census` so that what counts as project content is decided in one
    # place; the directory-name prune this loop used to carry is gone, because it
    # answered a question the project alone is allowed to answer (`_load_sibling`).
    # WORKFORCE DOES NOT SURVEY ITS OWN SCRATCH AS IF IT WERE PROJECT CONTENT.
    #
    # This is NOT the `fixtures/` default the census doctrine bars (procedures/audit.md
    # § .censusignore: "declared, never inferred ... no guess from directory names").
    # That rule protects the PROJECT's content from inference. These two paths are not
    # the project's — they are where this procedure itself writes, and what they hold
    # is COPIES: a run report quoting a directive, and a staged tree awaiting the
    # sweep. Both originals are guarded at their source, and Step 6-S's T2 extraction
    # is blocking precisely so a staged tree's spans are already in
    # `.claude/workforce/directives/` before it is ever staged. Stamping the copy
    # guards nothing and makes the sidecar describe bytes that exist to be deleted.
    #
    # MEASURED 2026-09-10 on apps-odyssey-alive: 846 markdown files under work/ and
    # staging/ — 236 run directories, 298 MB, none of it ever reaped — walked by every
    # verify, producing the org's ONLY hard failure: 8 unstamped blocks, 5 of them
    # inside an August run report and a staged tree already dispositioned for removal.
    # A check whose only failure is its own leftovers is the check that stops being read.
    #
    # THE SET IS `wf-census.sacred_scope`, the same function `wf-stamp` writes rows over.
    # The walk, the scratch exclusion and the `.censusignore` read all live there. Two copies
    # of this walk are what let stamp and conform disagree (customer DEF-Q-006, 2026-09-15:
    # a block under `.claude/workforce/migrated/` conform required and stamp could not
    # write). The scratch count is over the whole subtree, not at its head. A pruned walk
    # only sees the files directly inside `work/`, and it once reported 1 where the tree
    # held 846.
    unstamped = []
    _files, _scratch_skipped = _load_sibling("wf-census").sacred_scope(root)
    for p in _files:
        rel = os.path.relpath(p, root)
        try:
            with open(p, encoding="utf-8") as fh:
                n = len(BLOCK_RX.findall(fh.read()))
        except OSError:
            continue
        for i in range(1, n + 1):
            if i not in rows.get(rel, {}):
                unstamped.append(f"{rel}:directive:{i}")
    # NEVER SILENT. An exclusion that does not print is indistinguishable from a scan
    # that found nothing, and under-reporting is the direction that hurts (audit.md
    # § The dangerous direction).
    # Carried to the summary line rather than only into this row's name: a passing row
    # is not printed, so an exclusion reported only here would be invisible in exactly
    # the case it is meant to qualify — a clean scan.
    res.scratch_skipped = _scratch_skipped
    _scope = (f" · {_scratch_skipped} file(s) in run scratch not scanned"
              if _scratch_skipped else "")
    res.add(not unstamped,
            f"sidecar: every sacred block on disk is stamped "
            f"({len(unstamped)} unstamped{_scope})",
            f"{unstamped[:5]} — a block the sidecar does not name is guarded by nothing, and "
            "coverage counted against the sidecar's own row set reports N of N while short. "
            "Regenerate the sidecar with the `checksums` command")


# ── the canary record ────────────────────────────────────────────────────────
# A run's own report is not a record. Every INV-CANARY row that reads PASS is a claim
# that this host was measured; `platform-local.md` is the only place that measurement
# survives the run, and `audit.md` Step 4b returns `PASS (on record)` — skipping the
# spawn — solely on the strength of it.
#
# MEASURED 2026-08-06 on this repository: `org-config.md` recorded
# `INV-CANARY … attempt 1 PASS` and no `platform-local.md` existed anywhere in the
# tree. Four documents instruct a run to write that file and nothing produced it, so
# the measurement was taken, reported, and lost — and every later run has to re-take
# it while reading a record that says it already passed.
#
# THIS CHECK LIVES IN A SHIPPED SCRIPT, NOT IN `bin/check`, and the reason is
# mechanical: `.gitignore` ignores `/.claude/`, so a repo-side assertion about
# `.claude/workforce/` passes VACUOUSLY on a fresh clone — it would be an enforcement
# whose population is empty everywhere except the maintainer's own working tree. The
# state being checked belongs to a live project, so the checker has to run against one.
INV_CANARY_LINE_RX = re.compile(r"^.*INV-CANARY.*$", re.M)
RECORDED_PASS_RX = re.compile(r"\bPASS\b")
# `| harness | `claude --version` → **2.1.223** |` — the row an audit writes into
# org-config.md. Both arrow forms, and the bold markers are optional.
HARNESS_RX = re.compile(r"claude --version`?\s*(?:→|->)\s*\**([0-9]+(?:\.[0-9A-Za-z]+)+)")
MEASURED_ON_RX = re.compile(r"^MEASURED-ON:.*$", re.M)
VERSION_RX = re.compile(r"([0-9]+(?:\.[0-9A-Za-z]+)+)")
RECORD_CMD = ("wf-apply --root <tree> --record-canary --tier-limit <N> "
              "--c1 'PASS: …' --c2 'PASS: …' --by '<run>' --execute")


def check_canary_record(root, res):
    """A recorded canary PASS must have the durable record it licenses.

    Three states are clean and each says so rather than returning silently — a check
    that skips is indistinguishable from a check that passed, which is the failure
    mode this whole script is written against.
    """
    cfg_path = os.path.join(root, ".claude", "workforce", "org-config.md")
    if not os.path.exists(cfg_path):
        res.add(True, "canary record: no org-config.md — nothing has been recorded yet",
                "absent is a first-class state, not an error")
        return
    cfg = read(cfg_path, res)
    if cfg is None:
        return

    rows = INV_CANARY_LINE_RX.findall(cfg)
    if not rows:
        res.add(True, "canary record: org-config.md records no INV-CANARY row",
                "an unrun canary owes no record")
        return
    # Scoped to the INV-CANARY row's OWN text. A substring test over the whole file
    # would read the word PASS out of any neighbouring prose — the mistake this
    # project has made in three separate checkers.
    if not any(RECORDED_PASS_RX.search(r) for r in rows):
        res.add(True, "canary record: INV-CANARY records no PASS — nothing to reconcile",
                "UNAVAILABLE and FAIL record no measurement, so neither owes a file")
        return

    local_path = os.path.join(root, ".claude", "workforce", "platform-local.md")
    if not os.path.exists(local_path):
        res.add(False, "canary record: INV-CANARY records PASS and platform-local.md exists",
                f"`.claude/workforce/platform-local.md` is ABSENT while org-config.md "
                f"records {rows[0].strip()[:90]!r}. The measurement was taken and never "
                f"written down, so `audit.md` Step 4b can never return `PASS (on record)` "
                f"and every future run re-measures a host that was already measured. "
                f"Write it: {RECORD_CMD}")
        return
    local = read(local_path, res)
    if local is None:
        return

    stamp = MEASURED_ON_RX.search(local)
    if not stamp:
        res.add(False, "canary record: platform-local.md carries a MEASURED-ON stamp",
                "the record exists and names no harness version, so nothing can ever "
                "decide whether it matches the running harness — the one question "
                "`platform.md` § levels asks of it")
        return

    harness = HARNESS_RX.search(cfg)
    if not harness:
        res.add(True, "canary record: platform-local.md exists "
                      "(org-config.md records no harness version to reconcile against)",
                "the existence half is checked; the version half has no second reading "
                "to compare with, and that boundary is stated rather than assumed")
        return

    got = VERSION_RX.search(stamp.group(0))
    res.add(bool(got) and got.group(1) == harness.group(1),
            f"canary record: platform-local.md MEASURED-ON matches the recorded harness "
            f"({harness.group(1)})",
            f"org-config.md records harness `{harness.group(1)}`; platform-local.md says "
            f"`{stamp.group(0).strip()}`. A record stamped with a different harness than "
            f"the run that took it cannot answer whether it matches the running one, so "
            f"Step 4b would return `PASS (on record)` for a measurement made elsewhere. "
            f"Re-record it: {RECORD_CMD}")


# ── INV-COMPANIONS: the companion skills an audit must have materialized ─────
# The distribution ships NO companion skill DIRECTORY. `org`, `operating-principles`,
# `personnel-ledger`, `code-evaluator`, `text-eval` and `security-evaluator` are
# MATERIALIZED by an audit out of shipped doctrine, and `/org` specifically is
# GENERATED by `org index` — it exists in no tarball and no installer will ever fetch
# it. So "install the shipped version" is an unsatisfiable instruction, and a literal
# run reasoned "ships none → install none" and skipped the step.
#
# MEASURED: an audit ran TWICE on a fresh project and never created
# `.claude/skills/org/SKILL.md`. Both runs reported clean, because no `bin/` check and
# no invariant asserted companion presence after an audit — the skip cost nothing, so
# nothing distinguished "materialized six" from "materialized none". Rewording the
# doctrine alone would land a rule with no mechanism, which is this project's one
# repeating failure; this is the mechanism half.
#
# THIS CHECK LIVES IN A SHIPPED SCRIPT, NOT IN `bin/check`, for check_canary_record's
# reason verbatim: `.gitignore` ignores `/.claude/`, so a repo-side assertion about
# `.claude/skills/` passes VACUOUSLY on every clone but the maintainer's working tree.
# The state belongs to a live project, so the checker has to run against one.
#
# THE POPULATION IS A TREE AN AUDIT HAS FINISHED, and it takes BOTH signals to be in
# it: `org-config.md` — the org record an audit writes — AND at least one GOVERNED
# handbook, the employees it staffs. Either one alone is a tree mid-flight, or a
# fixture exercising one half, and asserting companions there fails trees where no
# audit ever ran. That is the "a check that always fails stops being read" failure
# this script already carries a scar from — the staged-draft comparison in `main()`
# failed 16 of 16 on the first real tree it met, and had to be demoted to advisory.
#
# THE COUNTED LINE AND THIS CHECK ARE NOT THE SAME ENFORCEMENT, and both are owed.
# `audit-setup.md` Step 0.3 prints `INV-COMPANIONS  N of 6 materialized` DURING the
# run — a procedural row, and a run that skipped the step can print whatever it likes.
# This is the structural half: it reads the disk afterwards and does not consult the
# run's own account of itself. The list below is the one restatement of
# `invariants.md` row 23 / `audit-setup.md` Step 0.3, and it is restated because an
# enforcement cannot import prose; if the six ever change, they change in both.
# TWO GROUPS, BECAUSE THEY LIVE IN TWO SCOPES, AND ONE LIST GOT THIS WRONG FOR A
# RELEASE. The three Core companions are PROJECT-LOCAL by design — `/org` dispatches
# against *this* project's chart and a personal copy silently shadows every project's own
# (`scopes.md` § The `/org` receptionist is project-local). The three evaluators are the
# opposite: the user directive of 2026-09-10 makes them self-contained in the USER
# install, and `audit` Step 6-F RETIRES the project's copies in the same run that Step
# 0.3 was still being read as materializing them.
#
# MEASURED 2026-09-11: this list demanded all six under `<root>/.claude/skills/`, so a
# correctly-audited project failed `INV-COMPANIONS` naming three evaluators that the same
# audit had deliberately removed. That is not a cosmetic wrong number — the row was RED ON
# EVERY HEALTHY TREE, so the one detector that names an absent `/org` had become
# indistinguishable from noise, which is the "a check that always fails stops being read"
# failure this script already carries a scar from. A `/org` absence was arriving as a
# fourth name in a row nobody had reason to read.
CORE_COMPANIONS = ("org", "operating-principles", "personnel-ledger")

# Satisfied in EITHER scope, project first, resolved the way `wf-catalog.install_dir`
# resolves the corpus itself. A project copy is not a defect here: Step 6-F retires it,
# and this check asks whether the capability is REACHABLE, not which scope won.
EVALUATOR_COMPANIONS = ("code-evaluator", "text-eval", "security-evaluator")


def companion_scopes(root):
    """Skill roots a companion may resolve from, project first.

    Mirrors `wf-catalog.install_candidates` — including the maintainer source tree, so a
    check run inside this repository resolves the evaluators it actually ships rather
    than reporting a distribution that carries them as missing them.
    """
    config_root = (os.environ.get("CLAUDE_CONFIG_DIR")
                   or os.path.join(os.path.expanduser("~"), ".claude"))
    return [
        os.path.join(root, ".claude", "skills"),
        os.path.join(root, "workforce", "skills"),
        os.path.join(config_root, "skills"),
    ]


# Bounded to a NAME, not to the next delimiter. `([^|>]+)` on
# `<!-- ... reports-to: engineering-lead -->` captured `engineering-lead -`, and every
# edge in a live org then failed as a mismatch against itself.
REPORTS_TO_RX = re.compile(r"^[ \t]*<!--.*\breports-to:\s*([A-Za-z0-9][\w.-]*)", re.M)
DIRECT_REPORTS_RX = re.compile(r"^[ \t]*<!--.*\bdirect-reports:\s*([^|>]+)", re.M)


def org_edges(name, body):
    """(parent, children) as the ORG-RECORD comment states them, or (None, set())."""
    m = REPORTS_TO_RX.search(body)
    parent = m.group(1).strip() if m else None
    if parent and parent.lower() in ("none", "(none)", "-"):
        parent = None
    m = DIRECT_REPORTS_RX.search(body)
    kids = set()
    if m:
        kids = {c.strip().rstrip("-").strip() for c in m.group(1).split(",")}
        kids = {c for c in kids if c and c.lower() not in ("none", "(none)")}
    return parent, kids


def check_org_edges(edges, res):
    """Every `reports-to` has a matching `direct-reports`, and the reverse.

    THE ORG-RECORD COMMENT IS WHAT A ROUTING CHECK READS. `## Chain of Command` prose and
    the org chart can both be right while the comment disagrees, and then a fully-staffed
    seat is routed around by a tool that never looks at the prose. Measured on a live org
    2026-09-08: two employees named a parent whose `direct-reports` did not list them, and
    every other record of the org was correct — so nothing else could have caught it.

    BOTH READINGS ARE REPORTED, never reconciled. This script does not know which side is
    stale, and a check that silently picked one would be asserting a repair it cannot
    justify. Naming the disagreement is the finding.
    """
    if not edges:
        # Said out loud: a check that skips is indistinguishable from one that passed.
        res.add(True, "org edges: no population (n=0, not a pass)")
        return
    for name, (parent, _kids) in sorted(edges.items()):
        # SELF-PARENTING IS ITS OWN DEFECT and must not be reported as a missing edge.
        # `reports-to: <self>` makes the node its own manager: an escalation from it
        # terminates at itself, so nothing it raises ever leaves it. Caught in a shipped
        # fixture 2026-09-08 by the edge diff, which described it only as "does not list
        # it" — true, and the least interesting thing wrong with it.
        if parent == name:
            res.add(False, f"{name}: reports-to itself",
                    f"`{name}` names itself as its own manager, so an escalation from "
                    f"it terminates at itself and nothing it raises ever leaves it. "
                    f"Name its real parent, or `ceo` if it is the root")
            continue
        if parent is None or parent not in edges:
            continue          # a root, or a parent outside .claude/agents/ — not ours
        if name not in edges[parent][1]:
            res.add(False, f"{name}: reports-to {parent}, which does not list it",
                    f"`{name}` names `{parent}` as its parent, but {parent}'s "
                    f"`direct-reports` does not include `{name}`. A routing check reads "
                    f"the ORG-RECORD comment, so this seat can be routed around even "
                    f"though the chart and the `## Chain of Command` prose are correct. "
                    f"Fix whichever of the two lines is stale")
    for name, (_parent, kids) in sorted(edges.items()):
        for kid in sorted(kids):
            if kid not in edges:
                res.add(False, f"{name}: direct-reports names {kid}, which has no handbook",
                        f"`{name}` claims `{kid}` as a direct report and there is no "
                        f"`.claude/agents/{kid}.md`. Either the report was retired "
                        f"without amending its manager, or the name is misspelled")
            elif edges[kid][0] != name:
                res.add(False, f"{name}: direct-reports names {kid}, which reports elsewhere",
                        f"`{name}` claims `{kid}`, but `{kid}` names "
                        f"`{edges[kid][0] or '(nobody)'}` as its parent. Two managers or "
                        f"none is the same defect: fix whichever line is stale")


ANTI_GASLIGHT_RX = re.compile(r"fabricated absence", re.I)


def check_anti_gaslight(n, body, res):
    """The 2026-09-02 directive: never report information missing before searching Sources.

    A one-line grep IS the whole detector, and it did not exist — the directive was
    mandatory and unmeasured for six days. ADVISORY, deliberately: measured on a live org
    2026-09-08, 18 of 23 handbooks predate the clause, and failing all of them at once is
    the 9-false-failures run this script cites as the lesson it must not repeat.

    Scoped to a handbook with REAL sources. One that measured itself `(none)` has nothing
    to search before it reports an absence, so the clause would be an instruction with no
    referent.
    """
    src = section(body, "## Sources")
    if src is None or not src.strip() or src.strip().lower().startswith("(none)"):
        return
    if ANTI_GASLIGHT_RX.search(body):
        return
    res.advise(
        f"{n}: no anti-gaslighting clause",
        "the handbook names sources but never says to search them before reporting "
        "something missing. Add the clause from `references/templates.md` GOP 10 — "
        "an unresolved question is a `QUESTION:` up the chain, never a fabricated "
        "absence and never a guess. ADVISORY: this row blocks nothing")


# Catalog skill directory name -> the `--kind` that resolves it. ONLY the kinds
# `wf-catalog` actually serves, and this table must never outrun `CATALOGS` there. It
# listed `image-eval` and `ui-design` for a few hours while the resolver served only three
# kinds, and 5 of 13 flagged handbooks on odyssey-alive then cited ONLY unresolvable
# catalogs — 38% false positives whose prescribed remedy was a command that exits 2.
# **A detector that fires where the fix cannot run is worse than silence.** Both were added
# back on 2026-09-10, when the catalogs themselves shipped, so every name here resolves;
# `bin/check` asserts the two tables agree, which is what stops the drift in either
# direction.
CATALOG_KIND = {
    "text-eval": "text",
    "code-evaluator": "code",
    "security-evaluator": "security",
    "image-eval": "image",
    "ui-design": "ui",
    "design-eval": "ui",          # a third spelling, measured on apps-odyssey-alive
}
CATALOG_PATH_RX = re.compile(
    r"\.claude/skills/(text-eval|code-evaluator|security-evaluator|image-eval|ui-design"
    r"|design-eval)\b")


def check_catalog_read(n, body, res, tally):
    """INV-CATREAD — a handbook still reaching its catalog by literal path.

    ADVISORY, and for the reason this file's other advisory rows exist: every org authored
    before 2026-09-10 carries the old form, so blocking would fail whole orgs at once for
    following the instruction that shipped. The fix is authorized in `audit` Step 5d item
    2c, which runs before Step 6-F migrates.

    THE EARLY-OUT IS PER LINE, NOT PER FILE. A whole-body `"wf-catalog" in body` test
    silences every literal path in a handbook that mentions the tool anywhere — one Sources
    row naming it, one migration note — and a half-healed handbook is exactly the state
    worth reporting. Zero live instances today; a blind spot is not less blind for being
    unoccupied.

    THE REMEDY DIFFERS BY WHERE THE CITATION SITS, because `## Sources` is a path
    declaration by contract and "rewrite it to a command" is ill-typed there. Measured:
    `content-drafter.md:64` declares `` `.claude/skills/text-eval/references/**` `` as a
    source glob, which is the most common match shape on a real org.
    """
    sources = section(body, "## Sources") or ""
    hits = []
    for line in body.splitlines():
        if "wf-catalog" in line:
            continue
        m = CATALOG_PATH_RX.search(line)
        if m:
            hits.append((m.group(0), m.group(1), line.strip() in sources))
    if not hits:
        tally["clean"] += 1
        return
    tally["flagged"] += 1
    cite, skill, in_sources = hits[0]
    kind = CATALOG_KIND[skill]
    where = ("a `## Sources` declaration — replace the glob with the resolver as the read "
             "mechanism, keeping the source named; a Sources row is a path by contract and "
             "a bare command is ill-typed there"
             if in_sources else
             f"a read instruction — rewrite it as a `wf-catalog` resolver read for kind "
             f"`{kind}`, keeping the pattern it already searches for")
    res.advise(
        f"{n}: catalog read grounded on a literal path ({len(hits)} citation(s))",
        f"cites `{cite}` — the migration removes the CORPUS FILES inside that directory "
        "once the install ships them byte for byte, leaving the directory standing and "
        "empty, so this read resolves and returns nothing. This is "
        f"{where}. See `references/evaluators.md` § An IC READS the catalog; the fix is "
        "`audit` Step 5d item 2c. ADVISORY: this row blocks nothing")


# ── THE PROBE SUBSTITUTION TABLE (handbook-templates.md § Probe) ──────────────
# A citation is the BACKTICKED heading, never the bare words: the right-hand cell of
# every row is prose that names sections in passing ("for the reason in the `## Procedure`
# 7 row"), and this reads the LEFT cell only for that reason.
#
# GREEDY BODY, TRIMMED IN CODE — and this is a ReDoS fix, MEASURED rather than reasoned.
# The first form was `` `##\s+([^`\n]+?)\s*` ``, and `\s` is a subset of `[^`\n]`, so the
# lazy body and the trailing `\s*` can divide the same run of spaces every way there is.
# Timed on this host against a `` `##  `` opener with no closing backtick: 0.31 s at 800
# characters, 2.65 s at 1,600, 21.1 s at 3,200 — cubic. This script's own length check
# records a REAL handbook line of 14,540 characters on a live org, so the input that hangs
# it is not hypothetical. ONE repeat operator is the fix, and half a fix is not one: a
# separate `[ \t]+` for the space after `##` is ambiguous with the body in exactly the same
# way and still measured quadratic (2.3 s at 16,000 characters, 38 s at 64,000). So the
# separator is not in the pattern at all — `[^`\n]+` against a literal closer has one way to
# match, and the whitespace comes off with `.strip()`, where it costs nothing.
PROBE_CITE_RX = re.compile(r"`##([^`\n]+)`")
# `1`, `1-2`, `1–2` (en dash, which is what a writer's editor produces). The spans a real
# table uses are `1-2`, `rows 1, 4, 5`, `steps 6 and 7` — so the connector is never parsed,
# only the numbers between the citation and the next citation in the same cell.
PROBE_SPAN_RX = re.compile(r"(\d+)\s*(?:[-–]\s*(\d+))?")
# A section the table need not carry a row for: `## Procedure` and `## Verification` are
# covered PER STEP and PER ROW below, which is strictly stronger than one row naming the
# section, and `## Probe` is the section doing the substituting.
PROBE_EXEMPT_RX = re.compile(r"^(Procedure|Verification|Probe)\b")


def _unfenced_lines(text):
    """Lines outside fenced code blocks.

    A FENCE IS QUOTED MATERIAL, never something the handbook says in its own voice: a
    heading in an example is not a section, and a worked example showing a forbidden
    command is documentation of the ban. Every reader here shares this one rule.
    """
    fenced = False
    for line in (text or "").splitlines():
        if line.lstrip().startswith("```"):
            fenced = not fenced
            continue
        if not fenced:
            yield line


def _unfenced_headings(body):
    """Every `## ` heading outside a fence — a handbook that quotes the template would
    otherwise be measured against its own illustration."""
    out = []
    for line in _unfenced_lines(body):
        m = re.match(r"^## (.+?)[ \t]*$", line)
        if m:
            out.append(m.group(1))
    return out


def _same_heading(a, b):
    """`## Verification` cites the section headed `## Verification (mechanical)`.

    The same trailing-text tolerance `section()` already applies, for the same measured
    reason: this file's own presence check is a substring match, so a heading carrying a
    parenthetical passes every other row here and must not be reported uncovered by this
    one. Compared both directions — the citation may be the longer string or the shorter.
    """
    return a == b or a.startswith(b + " ") or b.startswith(a + " ")


def _substitution_coverage(probe):
    """{cited heading -> the set of step/row numbers that citation covers}.

    LEFT CELL ONLY. Read over the whole Probe section this returns coverage from prose —
    `content-writer`'s own table says "row 2's file set under this order is the `OUTPUT.md`
    you write" in a RIGHT cell, and a whole-section scan would score `## Verification` row 2
    as covered from a sentence that is not a mapping row at all.
    """
    covered = {}
    for line in probe.splitlines():
        s = line.strip()
        if not s.startswith("|"):
            continue
        left = s.strip("|").split("|")[0].strip()
        if not left or set(left) <= set("-: "):      # the header's alignment rule
            continue
        cites = list(PROBE_CITE_RX.finditer(left))
        for i, m in enumerate(cites):
            end = cites[i + 1].start() if i + 1 < len(cites) else len(left)
            nums = covered.setdefault(m.group(1).strip(), set())
            for sm in PROBE_SPAN_RX.finditer(left[m.end():end]):
                a = int(sm.group(1))
                b = int(sm.group(2) or sm.group(1))
                # A span is a step range, and no handbook has 50 of them. An unbounded
                # `range()` off a typo (`1-9999`) would cover every step by accident,
                # which is the one failure a coverage check must never have.
                nums.update(range(a, b + 1) if 0 <= b - a <= 50 else (a, b))
    return covered


def _covered_nums(covered, label):
    nums = set()
    for cite, ns in covered.items():
        if _same_heading(cite, label):
            nums |= ns
    return nums


def check_probe_substitution(n, body, res):
    """Every section, Procedure step and Verification row has a row in the probe's
    substitution table.

    `handbook-templates.md` § Probe makes this BLOCKING — "A PROBE THAT SUBSTITUTES ITS
    CONTEXT ENUMERATES HOW EVERY OTHER SECTION READS UNDER THE SUBSTITUTION" — and closes
    the table with "No clause of any other section is left for you to interpret." The
    contract has been mandatory since 2026-08-07 and was never measured: a table missing
    one row is a promise the document breaks, and the cost lands on the cold reader as a
    burned probe cycle. Run hire-20260912T013734Z spent FOUR of them on defects this reads
    mechanically (records DEF-content-writer-001, DEF-engineering-coder-001).

    THE GATE IS THE TABLE'S EXISTENCE, and that is this script's own rule: whether a probe
    SUBSTITUTES its context is judgment, which `verify` owns, and this command decides
    nothing it cannot decide. A probe carrying a mapping table has been declared a
    substituting probe by its author; one carrying none is not classified here at all.

    ADVISORY, not blocking, for the reason every heuristic row in this file is advisory.
    The coverage parse reads FREE-FORM TABLE PROSE: a compliant table that writes "every
    step of `## Procedure`" instead of enumerating the numbers is scored uncovered, and a
    blocking row would then fail a handbook for a phrasing rather than a gap. The remedy is
    a row, the fix path is `audit` Step 5d, and both cost seconds — a reported gap converges
    and a false block does not.
    """
    probe = section(body, "## Probe")
    if probe is None:
        return
    covered = _substitution_coverage(probe)
    # Two citations, not one: a probe whose task line happens to name one section in a
    # table-shaped row has not declared a mapping.
    if len(covered) < 2:
        return

    missing = []
    for head in _unfenced_headings(body):
        if PROBE_EXEMPT_RX.match(head):
            continue
        if not any(_same_heading(head, cite) for cite in covered):
            missing.append(f"`## {head}`")
    for label, unit in (("Procedure", "step"), ("Verification", "row")):
        seg = section(body, f"## {label}")
        if seg is None:                      # a Lead carries no `## Procedure` at all
            continue
        nums = _covered_nums(covered, label)
        missing += [f"`## {label}` {unit} {m.group(1)}"
                    for m in re.finditer(r"^(\d+)\.", seg, re.M)
                    if int(m.group(1)) not in nums]
    if not missing:
        return
    res.advise(
        f"{n}: probe substitution table leaves {len(missing)} item(s) uncovered",
        "uncovered by the substitution table: " + ", ".join(missing[:8])
        + (" …" if len(missing) > 8 else "")
        + ". The table closes with \"No clause of any other section is left for you to "
        "interpret\", so an item with no row is a promise the handbook breaks — and the "
        "reader who finds it returns a QUESTION instead of the work. Give each one a row "
        "naming it on the left (handbook-templates.md § Probe, BLOCKING); the fix path for "
        "a handbook already shipped is `audit` Step 5d. ADVISORY: this row blocks nothing")


def _bullets(text):
    """Each markdown list item in `text`, joined across the lines it wraps onto.

    A WRAPPED BULLET IS ONE BULLET. Its operative clause — a deferral phrase, an owner
    attribution, `you own these` — lands on the continuation line about as often as on
    the first, and a reader that takes lines independently reports a conforming handbook
    for where its line breaks happened to fall.

    A BLANK LINE CLOSES AN ITEM AND NOTHING ELSE DOES, including a line at column 0:
    markdown's lazy continuation is legal and handbooks in the wild use it. Only a marker
    at column 0 opens the next item, so an indented `-` is read as continuation rather
    than as a new claim. This is the rule `check_exit_criteria_defers` has shipped with;
    it is lifted here verbatim rather than re-derived, because two readers of one shape
    must share one grammar or they cannot both be right.
    """
    out, cur = [], None
    for line in (text or "").splitlines():
        if re.match(r"^[-*]\s", line):
            if cur:
                out.append(cur)
            cur = line[2:].strip()
        elif cur is not None:
            if line.strip():
                cur += " " + line.strip()
            else:
                out.append(cur)
                cur = None
    if cur:
        out.append(cur)
    return out


# THE DEFERRAL FORMS. A bullet under the preamble must POINT AT the section that owns its
# condition rather than write the condition's value. These are the phrasings the contract
# itself uses; the message names them so the remedy is a literal, not a category.
EXIT_PREAMBLE_RX = re.compile(r"never restates what they mean", re.I)
EXIT_DEFER_RX = re.compile(
    r"exactly as |that section |that step |those steps |the section that owns", re.I)


def check_exit_criteria_defers(n, body, res):
    """A `## Exit criteria` that promises it never restates a value must not write one.

    ORG-exit-criteria-restates-001, opened 2026-09-11 under Off-the-Street Release Gate
    rule 5: `content-writer` failed its cold read TWICE on different clauses with this one
    section on one side of the contradiction both times, so the cause is structural. The
    template already names the hazard for a single case — "Its expected result is stated on
    the `Check:` line and nowhere else — two statements of one value drift, and a reader
    honors the first while the employee honors the second" — and the second probe is that
    sentence coming true in the handbook that quotes it (`## Verification` stated the
    Check's expectation as a printed count of `0`, `## Exit criteria` as "exits 0"; for
    `grep -c` those are mutually exclusive).

    RESTATEMENT IS NOT A SYNONYM FOR DISAGREEMENT, which is why the check is on the FORM
    and not on a diff of the two values. The measured third instance had not diverged in
    verdict, it had NARROWED: `## Procedure` 4 governs "a shipped file" and the bullet said
    "every NEW shipped file", silently exempting a file whose git tracking breaks by rename.
    Nothing comparing the two strings for equality sees that, and a reader honoring the
    bullet ships the defect.

    SCOPED TO THE PREAMBLE, so it is opt-in by construction: a handbook whose
    `## Exit criteria` makes no such promise is not under this rule and is not read here.

    ADVISORY, for the reason the coverage row above is: compliance is recognised by a
    phrase list, so a bullet that defers in a wording not on the list is a false positive on
    a conforming handbook. A detector that fires where the author already complied is the
    failure this file's own catalog table records at 38%.
    """
    ec = section(body, "## Exit criteria")
    if ec is None or not EXIT_PREAMBLE_RX.search(ec):
        return
    # A wrapped bullet is ONE bullet. Its deferral phrase lands on the continuation line
    # about as often as on the first, and reading lines independently reports a conforming
    # handbook for where its line breaks fell.
    bullets = _bullets(ec)
    # The trailing space is the phrase boundary — `that section ` must not match a bullet
    # that merely contains the word `section`. Appending one lets the phrase close a
    # bullet, which is where a deferral most often sits: "…, exactly as that step states."
    bad = [b for b in bullets if not EXIT_DEFER_RX.search(b + " ")]
    if not bad:
        return
    res.advise(
        f"{n}: exit criteria restates a value another section owns ({len(bad)} bullet(s))",
        "this section's own preamble says it never restates what a condition means, and "
        f"these bullets state one instead of citing its owner: \"{bad[0][:70]}\""
        + (f" and {len(bad) - 1} more" if len(bad) > 1 else "")
        + ". Name the condition and defer — `exactly as that section states`, `exactly as "
        "that step states` — so the value has one author. Two statements of one value "
        "drift, and the measured drift was a NARROWING the reader honored. See "
        "ORG-exit-criteria-restates-001; the fix path is `audit` Step 5d. ADVISORY: this "
        "row blocks nothing")


# THE OWNERSHIP GRAMMAR, read from the shape `handbook-templates.md` § Scope writes: an
# `IN:` bullet CLAIMS a concern, an `OUT:` bullet disclaims one and names who holds it
# instead. Both markers are matched at the head of the bullet only — a sentence mentioning
# "in" or "out" mid-line is prose, and this check may not read prose as a claim.
SCOPE_IN_RX = re.compile(r"^\*{0,2}IN\*{0,2}\s*:", re.I)
SCOPE_OUT_RX = re.compile(r"^\*{0,2}OUT\*{0,2}\s*:", re.I)
# `— `content-writer` owns these` and `owned by `content-writer``. The captured name is
# checked against the handbooks that EXIST before anything is reported, so "the operator
# owns this" or "`git` owns that" never reads as an attribution to an employee.
ATTRIBUTION_RX = re.compile(
    r"`([A-Za-z0-9][\w-]*)`\s+owns\b|\bowned by\s+`([A-Za-z0-9][\w-]*)`")
# EXCLUSIVITY, STATED. Two handbooks naming one glob is ordinary shared reading and is not
# a contradiction; a contradiction needs one of them to have claimed it to the exclusion of
# everyone else. `you own these` is the template's own wording for that.
EXCLUSIVE_RX = re.compile(
    r"\byou own (?:these|this|it)\b|\bexclusiv|\bsolely\b|\bsole owner\b|\bonly you\b"
    r"|\bnobody else\b|\bno one else\b", re.I)
BACKTICKED_RX = re.compile(r"`([^`\n]+)`")
# AN ASPECT IS NOT A TREE. Measured on a live 17-handbook org: `orthography-gate` claims
# "CW appearing anywhere under `src/**` and `content/**`" — the Chinuk Wawa STRINGS inside
# those trees, deliberately, while `platform-lead` owns the trees. That is a designed
# overlap of one aspect with one tree, not two owners of one concern, and reporting it as
# a contradiction would fail a correct org on the thing that makes it correct. A bullet
# that scopes its claim this way claims no path at all for this check's purposes.
QUALIFIED_CLAIM_RX = re.compile(
    r"\bonly\b|\banywhere under\b|\bappearing\b|\bwherever\b|\bstrings\b|\btokens\b"
    r"|\bpart of\b|\bportion\b|\baspect\b|\binside any\b", re.I)
# A TOOL A BULLET NAMES IS AN INSTRUMENT, NOT A CLAIM: "the CW text baked into `Figures/**`
# by `.claude/skills/cw-accuracy/tools/overlay.py`" claims the text, and names the script
# that bakes it. Measured on the same org, where the instrument was reported as contested.
INSTRUMENT_RX = re.compile(r"\b(?:by|via|using|through)\s+`[^`\n]+`")


def _path_tokens(text):
    """Backticked tokens that name a file or a tree, normalized for comparison.

    PATH-SHAPED ONLY, and this filter is the whole false-positive guard on both checks
    below. `Agent`, `tools:`, `## Scope` and `PASS` are backticked tokens too, and
    comparing those across two handbooks manufactures a contradiction out of two
    employees using the same vocabulary. A token qualifies only if it carries a `/`, a
    `*`, or a file extension — and never if it contains a space, which is a phrase.

    Comparison is by EXACT normalized token. `docs/**` and `docs/` are left as two
    different tokens deliberately: a glob dispute that has to be inferred is a dispute
    this check declines to report, and silence on an ambiguous case is the cheaper error.
    """
    out = set()
    for tok in BACKTICKED_RX.findall(text or ""):
        # TRAILING punctuation only. `.strip(",;.")` ate the leading dot of every
        # `.claude/...` path and reported the contested concern as `claude/skills/…`,
        # a path that exists nowhere — measured on a live 17-handbook org.
        t = tok.strip().rstrip(",;.").strip()
        if not t or " " in t:
            continue
        if "/" not in t and "*" not in t and not re.search(r"\.[A-Za-z0-9]{1,5}$", t):
            continue
        out.add(t.rstrip("/") or t)
    return out


def ownership_claims(body):
    """(claimed, attributed, exclusive) — what this handbook says about who owns what.

    `claimed`     token -> the IN bullet claiming it
    `attributed`  token -> (employee named as its owner, the bullet saying so)
    `exclusive`   tokens claimed in a bullet that also claims them exclusively
    """
    claimed, attributed, exclusive = {}, {}, set()
    for bullet in _bullets(section(body, "## Scope")):
        toks = _path_tokens(bullet)
        if SCOPE_IN_RX.match(bullet):
            if QUALIFIED_CLAIM_RX.search(bullet):
                continue
            toks -= _path_tokens(" ".join(INSTRUMENT_RX.findall(bullet)))
            for t in toks:
                claimed.setdefault(t, bullet)
            if EXCLUSIVE_RX.search(bullet):
                exclusive |= toks
        elif SCOPE_OUT_RX.match(bullet):
            m = ATTRIBUTION_RX.search(bullet)
            if m:
                for t in toks:
                    attributed.setdefault(t, (m.group(1) or m.group(2), bullet))
    # A guardrail is the other place an owner is named — "NEVER edit `x` — `y` owns it".
    for bullet in _bullets(section(body, "## Guardrails")):
        m = ATTRIBUTION_RX.search(bullet)
        if m:
            for t in _path_tokens(bullet):
                attributed.setdefault(t, (m.group(1) or m.group(2), bullet))
    return claimed, attributed, exclusive


def _quote(text, n=110):
    """One line of evidence, short enough to read in a report."""
    t = " ".join((text or "").split())
    return t if len(t) <= n else t[:n - 1] + "…"


def check_ownership_conflicts(claims, res):
    """One concern, two handbooks, two different owners — the org's routing, contradicted.

    THE ORG IS A ROUTING TABLE AND THIS IS THE ONE DEFECT THAT MAKES IT UNREADABLE.
    `handbook-templates.md` § IC writes the assignment twice over — `IN: <the specific
    work>` and `OUT: <the adjacent work that belongs to someone else, named>` — so every
    handbook states both what it holds and who holds the next thing over. Nothing until
    now compared one handbook's answer against another's. Each file is internally perfect in the failing case —
    which is why no per-handbook check can see it, and why a cold reader of either one
    alone reports nothing.

    Both halves of the contradiction are QUOTED, never summarized. A finding that says
    "ownership conflict" and names no lines is a finding the reader has to re-derive, and
    this script does not know which of the two sides is stale (`check_org_edges`, same
    rule). Naming the disagreement is the whole finding.

    TWO FIRING FORMS, and nothing else fires. They are classified differently, and the
    split was MEASURED across eight live orgs (82 handbooks) rather than chosen:

      EXCLUSIVE   FAILS. A and B both claim `p` IN, and at least one said it owns `p` to
                  the exclusion of everyone else. Shared reading of one path is normal, so
                  the stated exclusivity is what makes the pair a contradiction — and it
                  leaves no reading under which both handbooks are right. One instance in
                  82: two employees each told one skill directory was theirs alone.
      DISPUTED    ADVISORY. A's `## Scope` IN claims `p`, and B says `p` belongs to a
                  THIRD party — B's OUT bullet or guardrail reads "`x` owns these" with
                  x != A. Where B attributes it to A, the two agree and nothing is
                  reported; that is the ordinary IN/OUT pairing the template ships.

    DISPUTED IS ADVISORY BECAUSE AN ORG MAY OVERLAP A TREE WITH AN ASPECT OF IT ON
    PURPOSE. Measured: a site-copy employee owning the WORDS in `content/**` under a
    platform lead owning the TREE is a correct org, and it is not distinguishable from a
    stale attribution by any grammar this script can apply. Five of the eight live orgs
    reported zero either way; the one that reported several is a 17-handbook org built on
    exactly that aspect split. Failing it would be the nine-false-failures run this file
    already records as the lesson it must not repeat.

    The attributed owner must itself be a handbook in this tree. "the operator owns this"
    is a true sentence about a human, not a competing claim by an employee.
    """
    # Every pair of handbooks against every claimed token. Bounded by the org: the largest
    # live org measured is 23 handbooks with ~10 tokens each, which is ~5k comparisons of
    # dict lookups. code-eval: quadratic by design, index it if an org ever reaches the
    # hundreds.
    names = sorted(claims)
    contested = 0
    # ONE CONCERN, ONE FINDING. Keyed on (claimant, token) because an org states an
    # attribution in every handbook that routes around it — measured, the same contested
    # path produced five identical rows naming five different bystanders, which reads as
    # five defects and is one.
    disputed = {}
    for a in names:
        claimed_a, _att_a, excl_a = claims[a]
        for b in names:
            if b == a:
                continue
            claimed_b, att_b, excl_b = claims[b]
            for tok in sorted(claimed_a):
                owner, line_b = att_b.get(tok, (None, None))
                # A CLAIM THAT NAMES THE OTHER PARTY AGREES WITH IT. "`convex/**` — the
                # self-hosted backend, delegated to `backend-data-steward`" is a lead
                # holding a tree its report works in, and the handbooks that say the
                # report owns it are saying the same thing. Measured on a live org, where
                # this was four of the loudest findings.
                if owner and owner != a and owner in claims and owner not in claimed_a[tok]:
                    disputed.setdefault((a, tok, owner), (line_b, []))[1].append(b)
                if (a < b and tok in claimed_b
                        and (tok in excl_a or tok in excl_b)):
                    contested += 1
                    res.add(False, f"{a} and {b}: both claim `{tok}`, one of them alone",
                            f"`{a}` — \"{_quote(claimed_a[tok])}\" — and `{b}` — "
                            f"\"{_quote(claimed_b[tok])}\". One of these bullets claims "
                            f"`{tok}` to the exclusion of everyone else, and the other "
                            f"claims it too. Shared READING of a path is fine; a stated "
                            f"exclusive is a promise the other handbook breaks.")
    for (a, tok, owner), (line_b, bystanders) in sorted(disputed.items()):
        contested += 1
        said_by = ", ".join(sorted(bystanders)[:3])
        if len(bystanders) > 3:
            said_by += f" (+{len(bystanders) - 3} more)"
        res.advise(f"{a}: `{tok}` is claimed here and given to {owner} by {said_by}",
                   f"`{a}` claims it — \"{_quote(claims[a][0][tok])}\" — while `{said_by}` "
                   f"sends it elsewhere: \"{_quote(line_b)}\". One concern has two owners "
                   f"of record, so work on `{tok}` routes to whichever handbook the "
                   f"dispatcher happened to read. Each file is internally consistent and "
                   f"only the pair is wrong; fix whichever line is stale. ADVISORY: this "
                   f"row blocks nothing — an org may also overlap a tree with an ASPECT of "
                   f"it on purpose, and this check cannot always tell the two apart")
    if names:
        res.add(True, f"ownership: {len(names)} handbook(s) · {contested} contested "
                      f"concern(s) across them")


# THE ACTS A HANDBOOK CAN FORBID AND THEN ORDER. Verbs only — the object is decided by the
# path token beside them, never by the verb.
WRITE_VERB_RX = re.compile(
    r"\b(writ|edit|creat|modif|overwrit|append|delet|remov|commit|push|run|ran|invok"
    r"|stag|sync|bump|touch|regenerat|publish|install)\w*\b", re.I)
# A LITERAL PROHIBITION, in the project's own grammar: `procedure-for-procedures.md`
# requires a guardrail to carry NEVER / MUST NOT / STOP, so keying off that vocabulary
# reads the contract rather than guessing at intent. Case-sensitive on the shouted forms
# for the same reason — "it is never edited" is description, `NEVER edit` is the rule.
#
# `(?![\w-])` is not decoration: `\bNEVER\b` matches inside `the NEVER-auto-send rule`,
# and a handbook LISTING its own rules by name was reported as banning the skills named
# beside them. Measured 2026-09-13 on a live org.
PROHIBITION_STRICT_RX = re.compile(
    r"(?<![\w-])(?:NEVER|MUST NOT|STOP|do NOT)(?![\w-])")
# A CARVE-OUT INVERTS THE SENTENCE. "NEVER edit files outside your `## Scope` IN list and
# your own reporting directory under `.claude/workforce/work/`" names `work/` as the one
# place writing IS allowed, and reading its tokens as forbidden would fail every handbook
# that then writes its report there — a false integrity alarm on the correct shape.
CARVE_OUT_RX = re.compile(
    r"\boutside\b|\bexcept\b|\bunless\b|\bother than\b|\bbeyond\b|\bapart from\b"
    r"|\bwithout\b|\brather than\b|\binstead of\b|\bonly\b", re.I)
# AN INSTRUCTION AGREEING WITH THE BAN IS NOT A CONTRADICTION. A step that says "never run
# `bin/sync`" restates the guardrail; reading it as an order to run it inverts the file.
NEGATION_RX = re.compile(
    r"\bnever\b|\bnot\b|\bno\b|\bnothing\b|\bdon't\b|\bcannot\b|\bcan't\b"
    r"|\brather than\b|\binstead of\b|\bwithout\b", re.I)
# THE OBJECT OF THE ACT FOLLOWS THE VERB, and a LOCATION follows a preposition. "NEVER
# write, edit, or overwrite a `*.png.orig` under `Figures/`" bans one artifact inside a
# directory it does not ban; without this cut the directory was reported as forbidden and
# the ordinary step that writes into it as the contradiction. Measured on a live org.
# `to` and `into` are deliberately NOT cutters — "NEVER write to `~/.claude/`" is the most
# common shape a ban takes, and cutting there would drop the ban entirely.
LOCATION_RX = re.compile(r"\b(?:under|inside|within|beneath|below|across)\b", re.I)
# Markdown closers count as sentence ends. `silently.** \`install.sh\`` did not split on
# `.` because the period is followed by `**` rather than a space, which glued a NEXT
# sentence's subject onto a ban about something else — measured, one false finding.
SENTENCE_SPLIT_RX = re.compile(r"(?<=[.;:!?])[*_`)]*\s+")


def _unfenced_sentences(text):
    """Sentences outside fenced code, each as one line of readable evidence."""
    out = []
    for line in _unfenced_lines(text):
        if not line.strip():
            continue
        out += [s.strip() for s in SENTENCE_SPLIT_RX.split(line.strip()) if s.strip()]
    return out


def _banned_objects(sentence):
    """Path tokens this sentence forbids acting on, or an empty set.

    THE BAN'S OBJECT, never everything the ban mentions. Read left to right: the
    prohibition keyword, then the act it forbids, then the thing acted on — and stop at
    the first locational preposition, which introduces where the object lives rather than
    another object. A token before the keyword is the sentence's subject and a token after
    a location word is a place; both were measured producing false findings.
    """
    m = PROHIBITION_STRICT_RX.search(sentence)
    if not m or CARVE_OUT_RX.search(sentence):
        return set()
    tail = sentence[m.end():]
    verb = WRITE_VERB_RX.search(tail)
    if not verb:
        return set()
    span = tail[verb.end():]
    cut = LOCATION_RX.search(span)
    return _path_tokens(span[:cut.start()] if cut else span)


def _ordered_objects(sentence):
    """Path tokens this sentence orders an act ON, or an empty set."""
    if NEGATION_RX.search(sentence):
        return set()
    verb = WRITE_VERB_RX.search(sentence)
    if not verb:
        return set()
    # Same left-to-right reading as the ban: a token BEFORE the verb is the subject of a
    # description — "the checks in `bin/check` are run by the operator" orders nothing.
    return _path_tokens(sentence[verb.end():])


def _forbids(banned, target):
    """True when a banned token covers a target token — exact, or a `/**` prefix."""
    if banned == target:
        return True
    for suffix in ("/**", "/*", "**", "*"):
        if banned.endswith(suffix):
            prefix = banned[:-len(suffix)].rstrip("/")
            if prefix and (target == prefix or target.startswith(prefix + "/")):
                return True
    return False


def check_self_contradiction(n, body, res, tally):
    """A handbook that orders a write its own guardrail forbids.

    `DEF-relocation-does-not-reconcile`, 2026-08-06, and it is the defect a passing gate
    produces: eighteen lines were relocated verbatim into `runtime-lead` during this
    project's own audit, the ledger went 32 -> 50, and EVERY GATE PASSED — retention is a
    per-line question and coherence is not. The cold reader that passed that handbook then
    found a mock-audit write-up path ordered against a guardrail forbidding edits outside
    the reporting directory, and `bin/baseline <real project>` ordered against a `## Scope`
    OUT line reading "anything in another repository". `claude-md.md` § Reconcile the
    receiving component states the rule — "a relocated rule its host forbids has not
    arrived" — and left it to a human reading the whole file. This is the mechanical half
    of that reading.

    The employee is the one who pays: told to do a thing and told never to do it, in one
    document, it stops and returns a QUESTION — or worse, picks one and is wrong either
    way. Only the file's author can say which side is right, so both are quoted and
    neither is preferred.

    FIRES ON ONE SHAPE ONLY: a path-or-command token is the OBJECT of a shouted
    prohibition (`NEVER` / `MUST NOT` / `STOP` / `do NOT`) and the OBJECT of an act
    ordered in `## Procedure` or `## Reporting`. Five guards keep it off the ambiguous
    cases, every one of them written from a false finding measured on a live org, because
    a false integrity alarm costs more than a missed one:

      1  path-shaped tokens only, by `_path_tokens` — a shared word is not a shared object
      2  object position on BOTH sides, by `_banned_objects` and `_ordered_objects` — a
         token before the verb is a subject and a token after `under` is a place
      3  a prohibition sentence carrying a carve-out (`outside`, `except`, `only`) is
         skipped entirely: its tokens are the PERMITTED region, not the banned one
      4  an instruction sentence carrying any negation is skipped: it agrees with the ban
      5  fenced blocks are quoted material on both sides, never instructions
    """
    tally["checked"] += 1
    banned = {}
    for sentence in _unfenced_sentences(body):
        for t in _banned_objects(sentence):
            banned.setdefault(t, sentence)
    if not banned:
        return
    found = []
    for label in ("## Procedure", "## Reporting"):
        for sentence in _unfenced_sentences(section(body, label)):
            for t in sorted(_ordered_objects(sentence)):
                for b, ban_sentence in sorted(banned.items()):
                    if _forbids(b, t):
                        found.append((label, t, b, sentence, ban_sentence))
    if not found:
        return
    tally["flagged"] += 1
    label, tok, ban, step, ban_sentence = found[0]
    res.add(False, f"{n}: {label} orders a write this handbook forbids (`{tok}`)",
            f"{label} says \"{_quote(step)}\" and the same file says "
            f"\"{_quote(ban_sentence)}\"" + (f" — `{ban}` covers `{tok}`" if ban != tok else "")
            + (f", plus {len(found) - 1} more pair(s)" if len(found) > 1 else "")
            + ". One document gives an order and forbids it, so the employee holding it "
            "either stops and returns a QUESTION or picks a side and is wrong. Only the "
            "author can say which line is right; amend that one.")


def check_companions(root, res, governed_n):
    """INV-COMPANIONS — after an audit, every core companion skill is on disk.

    Absence is a FAIL, not a report: the run that skipped them reported clean twice.
    The no-population state says so out loud rather than returning silently, because
    a check that skips is indistinguishable from a check that passed.
    """
    cfg_path = os.path.join(root, ".claude", "workforce", "org-config.md")
    if not os.path.exists(cfg_path) or governed_n == 0:
        res.add(True, "companions: no completed audit in this tree "
                      "(INV-COMPANIONS has no population)",
                f"an audit leaves BOTH `.claude/workforce/org-config.md` "
                f"({'present' if os.path.exists(cfg_path) else 'ABSENT'}) and at least "
                f"one governed handbook (found {governed_n}). With either missing, no "
                f"audit has finished here and none of the six companions is owed yet")
        return

    missing = [n for n in CORE_COMPANIONS
               if not os.path.isfile(os.path.join(root, ".claude", "skills", n, "SKILL.md"))]
    scopes = companion_scopes(root)
    unreachable = [n for n in EVALUATOR_COMPANIONS
                   if not any(os.path.isfile(os.path.join(d, n, "SKILL.md"))
                              for d in scopes)]
    total = len(CORE_COMPANIONS) + len(EVALUATOR_COMPANIONS)
    if not missing and not unreachable:
        # `count()`, NOT a passing row, for the reason INV-CATREAD carries below:
        # `invariants.md` row 23 and `audit-setup.md` both print this line as a counted
        # measurement, and a passing row reaches no reader — so the healthy state of a
        # named invariant was the one state nobody could see.
        res.count(f"INV-COMPANIONS: all {total} core companion skills exist "
                  f"({len(CORE_COMPANIONS)} project-local, "
                  f"{len(EVALUATOR_COMPANIONS)} resolved in the install)")
        return

    # NAMES EVERY MISSING ONE, not a count. "3 companions missing" sends the reader
    # back to the source to find out which, and the whole defect this is written
    # against was a step that quietly did nothing.
    parts = []
    if missing:
        parts.append("ABSENT after an audit: "
                     + " · ".join(f".claude/skills/{n}/SKILL.md" for n in missing))
    if unreachable:
        # NAMES THE SCOPES IT LOOKED IN. "text-eval is missing" against an install that
        # has it one directory up sends the reader hunting; the list of roots is the
        # whole diagnosis.
        parts.append("UNREACHABLE IN EVERY SCOPE: " + " · ".join(unreachable)
                     + " — searched " + " · ".join(scopes)
                     + ". These three ship in the user install (`update` is the whole "
                       "propagation path) and `audit` Step 6-F retires the project's "
                       "copies, so an absence here means the install never placed them: "
                       "the remedy is `/workforce update`, not an audit")
    detail = ". ".join(parts) + ". "
    if "org" in missing:
        detail += ("`/org` is ABSENT and it is the hard failure: the receptionist is "
                   "GENERATED by `org index`, ships in no distribution, and no "
                   "installer will ever fetch it — so nothing else in the run will "
                   "notice. ")
    if missing:
        detail += ("The distribution ships NO companion skill directory; the three "
                   "project-local companions are MATERIALIZED from shipped doctrine, "
                   "never copied, so 'ships none' is not a licence to install none. "
                   "`wf-companion --root <tree> --execute` is the producer — it creates "
                   "each absent one from shipped source and reads it back.")
    res.add(False, "INV-COMPANIONS: every core companion skill exists after an audit",
            detail)


def main():
    ap = argparse.ArgumentParser(prog="wf-conform")
    ap.add_argument("--root", default=".")
    ap.add_argument("--json", dest="json_path")
    ap.add_argument("--ceiling", type=int, default=DEFAULT_LENGTH_CEILING)
    ap.add_argument("--strict-adopted", action="store_true",
                    help="hold adopted agents to the full handbook contract too "
                         "(they are exempt by default: workforce did not author them)")
    ap.add_argument("--quiet", action="store_true")
    ap.add_argument("--def", dest="def_path",
                    help="check ONE DEF record strictly, at the moment it is written "
                         "(procedures/defect.md step 5d): exit 1 on a missing or ill-formed "
                         "Class fix, or a record not in the personnel index")
    args = ap.parse_args()

    # AN EMPTY --root IS A CALLER ERROR, NEVER A SILENT RETARGET TO CWD.
    # `${CLAUDE_PROJECT_DIR}` is UNSET in the Bash tool — measured 2026-08-04 on
    # 2.1.221 — so every shipped `--root "${CLAUDE_PROJECT_DIR}"` block expands to
    # `--root ""`. `os.path.abspath("")` is the CWD, which is a real directory, so a
    # is-it-a-directory guard passes and the tool examines a tree nobody named.
    # Measured: `wf-conform --root ""` in an empty dir exited 0 reporting
    # "0 governed · 0 failed" — a validator reporting health it never measured, which
    # is the exact contract procedures/verify.md states five lines under the block
    # that produces it.
    if not (args.root or "").strip():
        print("wf-conform: --root is empty. ${CLAUDE_PROJECT_DIR} is unset outside a "
              "hook; pass an explicit path.", file=sys.stderr)
        return 2

    root = os.path.abspath(args.root)
    if not os.path.isdir(root):
        print(f"wf-conform: not a directory: {root}", file=sys.stderr)
        return 2

    # WRITE-TIME ENFORCEMENT OF THE DEF FIELDS. This is where the Class fix blocks: on
    # the record just written, while its author still holds the defect. At verify the
    # same grammar only advises (check_defects), because history cannot be re-asked.
    if args.def_path:
        dpath = args.def_path if os.path.isabs(args.def_path) else os.path.join(root, args.def_path)
        stem = os.path.basename(dpath)[:-3] if dpath.endswith(".md") else ""
        if not stem.startswith("DEF-"):
            print(f"wf-conform --def: {args.def_path} is not a DEF-<slug>.md record",
                  file=sys.stderr)
            return 2
        try:
            with open(dpath, encoding="utf-8") as fh:
                body = fh.read()
        except (OSError, UnicodeDecodeError) as exc:
            print(f"wf-conform --def: cannot read {dpath} ({type(exc).__name__})",
                  file=sys.stderr)
            return 2
        ipath = os.path.join(root, ".claude", "workforce", "personnel", "index.md")
        try:
            with open(ipath, encoding="utf-8") as fh:
                index = fh.read()
        except (OSError, UnicodeDecodeError):
            index = None
        rows = def_record_findings(stem, body, index)
        bad = [r for r in rows if not r[0]]
        print(f"wf-conform --def {stem}: {len(rows)} check(s) · {len(bad)} failed")
        for _ok, name, detail in bad:
            print(f"  ✗ {name}\n      {detail}")
        return 1 if bad else 0

    res = Result()
    agents_dir = os.path.join(root, ".claude", "agents")
    handbooks = []
    if os.path.isdir(agents_dir):
        for dp, _dn, fns in os.walk(agents_dir):
            handbooks += [os.path.join(dp, f) for f in fns if f.endswith(".md")]
    # GOVERNED vs ADOPTED. The ORG-RECORD block is the discriminator because it is
    # the thing workforce writes and nothing else does — an agent without one was
    # never placed under this contract. Frontmatter cannot decide it: `name:` and
    # `description:` are universal.
    # Counted on the ORG-RECORD marker alone, NOT on `len(handbooks) - len(adopted)`
    # printed below, and not on `--strict-adopted`: INV-COMPANIONS asks whether an
    # audit staffed this tree, and only a marker workforce itself writes answers that.
    # Under `--strict-adopted` an adopted agent is held to the contract but was still
    # never staffed here, so it must not make the tree look audited.
    governed_n = 0
    floors, _floor_bad = read_length_floors(root)
    for _bad in _floor_bad:
        res.advise(f"length floors: malformed row {_bad!r}",
                   f"{LENGTH_FLOORS_REL} grammar: | `<handbook>.md` | <lines> | <bytes> | "
                   f"`<evidence path>` | <YYYY-MM-DD> |. A row that does not parse records no "
                   f"floor. `wf-stamp --floor` writes it. ADVISORY: this row blocks nothing")
    _catread = {"flagged": 0, "clean": 0}
    _selfcon = {"checked": 0, "flagged": 0}
    org_edge_map = {}
    own_map = {}
    for p in sorted(handbooks):
        body = read(p, res)
        if body is None:
            continue
        if ORG_RECORD_RX.search(body):
            governed_n += 1
            check_handbook(p, body, res, args.ceiling, floors)
            _name = os.path.basename(p)[:-3]
            org_edge_map[_name] = org_edges(_name, body)
            check_anti_gaslight(_name, body, res)
            check_catalog_read(_name, body, res, _catread)
            # GOVERNED ONLY, and deliberately outside `check_handbook` for that reason:
            # `--strict-adopted` holds an adopted agent to the handbook contract, and
            # neither of these is a contract workforce can hold a file it did not author
            # to — a probe table and an exit-criteria preamble are shapes this skill
            # writes. Same placement, same reason, as the two rows above.
            check_probe_substitution(_name, body, res)
            check_exit_criteria_defers(_name, body, res)
            # A write ordered against this same file's own prohibition, and the ownership
            # claims that only mean anything next to every OTHER handbook's — collected
            # here, compared after the loop by `check_ownership_conflicts`.
            check_self_contradiction(_name, body, res, _selfcon)
            own_map[_name] = ownership_claims(body)
        elif args.strict_adopted:
            check_handbook(p, body, res, args.ceiling, floors)
        else:
            check_adopted(p, body, res)

    # STAGING IS FROZEN AT REGISTRATION, AND THE REGISTERED BYTES ARE THE TRUTH.
    #
    # Reported 2026-08-05. An authoring agent OUTLIVED its own T5 registration and kept
    # editing the staged draft, producing a second version of a live employee:
    #
    #     live, registered   171 lines   probed PASS x2, FAIL x1   negative fixture: yes
    #     staging draft      149 lines   never probed              none — "ships none"
    #
    # T6 compares the two and passes; nothing looked again AFTER T6, so the divergence
    # was invisible. And the unprobed draft is the one a later reader PREFERS — it is
    # shorter, under the length ceiling, and reads cleaner. The released file is 21
    # lines over. **Verification that has been watched failing beats a line count**, so
    # the registered bytes win and the draft is preserved for inspection rather than
    # deleted.
    #
    # REPORTED, NEVER REPAIRED — same rule as every other finding here. Overwriting
    # staging is a decision with a preferred direction, and this script does not make
    # decisions; `audit` Step 6 does, with the divergence named.
    staging = os.path.join(root, ".claude", "workforce", "staging", "agents")
    compared = 0
    if os.path.isdir(staging):
        for p in sorted(handbooks):
            staged = os.path.join(staging, os.path.basename(p))
            if not os.path.isfile(staged):
                continue
            live_b, staged_b = _digest(p), _digest(staged)
            if live_b is None or staged_b is None:
                continue
            live_n = len((read(p, res) or "").splitlines())
            staged_n = len((read(staged, res) or "").splitlines())
            compared += 1
            if live_b == staged_b:
                res.add(True, f"{os.path.basename(p)}: staged draft matches the registered bytes")
                continue
            # ADVISORY, NOT BLOCKING — and this is a correction made by MEASUREMENT.
            #
            # The first draft of this check used res.add(), and against a real tree it
            # failed 16 of 16: every registered handbook had moved AHEAD of its staged
            # copy, because `amend` edits the released file and nothing resyncs staging.
            # Reproduced by hand before believing it (196 lines live against 172 staged,
            # the extra content real) — this project's rule that a census reporting a
            # discrepancy is a claim about the census too.
            #
            # So divergence is NORMAL on any tree that has ever amended a handbook, and
            # a check that fails on every healthy tree is the one thing this script's
            # own docstring warns about: "a check that always fails stops being read."
            # I nearly shipped exactly what `verify.md` § a failure is not discounted
            # was written against, in the same change that wrote it.
            #
            # What stays worth reporting is the HAZARD, not the difference: a stale
            # staged draft can be mistaken for authoritative, which is how a shorter
            # never-probed version of a live employee gets preferred by a later reader.
            res.advise(
                f"{os.path.basename(p)}: staged draft differs from the registered bytes "
                f"(live {live_n} lines, staged {staged_n})",
                "NORMAL after an amendment — `amend` edits the released file and nothing "
                "resyncs staging. Reported so the draft is never mistaken for "
                "authoritative: the REGISTERED file is the one that was probed. Never "
                "let a staged draft overwrite released bytes on the strength of being "
                "shorter or cleaner")

    # A COUNT NOBODY PRINTS IS HOW "NOTHING RAN" READS AS "ALL CLEAR". If staging
    # exists and nothing paired, the layout is not what this check expects and it
    # silently examined nothing — the INV-BATCH lesson one level down.
    if os.path.isdir(staging) and compared == 0:
        res.advise("staging/agents exists but no handbook paired with a staged draft",
                   "this check compared NOTHING. Either the tree uses a different "
                   "staging layout or the drafts were cleaned; either way the "
                   "divergence question went unanswered rather than answered clean")

    # Which skills are data skills is `data_skills`'s to say, the same definition
    # `wf-remainder --swept-refs` reads (DEF-Q-003). It is no longer the `records-` prefix
    # alone, which never saw a converted predecessor knowledge base.
    for skill_dir, body in data_skills(root):
        check_data_skill(os.path.join(skill_dir, "SKILL.md"), body, res)

    check_sidecar(root, res)
    check_canary_record(root, res)
    check_org_edges(org_edge_map, res)
    check_ownership_conflicts(own_map, res)
    # Printed with its zero, like every other census here: a detector that reports nothing
    # and a detector that examined nothing read identically in a report until one says so.
    if governed_n:
        # `count()`, NOT a passing row. A passing row is never printed (see the output
        # block in `main`), so this line's own comment above — "Printed with its zero" —
        # described something that had never happened. `count()` is the one channel that
        # prints on every run, zero included, and it exists for exactly this.
        res.count(f"write instructions: {_selfcon['checked']} handbook(s) · "
                  f"{_selfcon['flagged']} ordering an act the same file forbids")
    # INV-CATREAD — PRINTED, including the zero. The first draft of this row named an
    # invariant in a docstring and emitted nothing, so `verify.md` and `audit` 2c both
    # instructed printing a count no tool produced. A named invariant that nothing emits is
    # the overclaim this project's own enforcement table exists to catch.
    if governed_n:
        _cr_line = (f"INV-CATREAD: {governed_n} handbook(s) · {_catread['flagged']} on a "
                    f"literal catalog path · {_catread['clean']} resolver-form or no "
                    f"citation")
        _cr_why = ("a handbook reaching its catalog by path reads a directory the "
                   "migration empties. The fix is `audit` Step 5d item 2c, which runs "
                   "before Step 6-F migrates. Rows above name each one; this is the count")
        # Clean is a PASSING row and flagged is an ADVISORY one — `advise()` is the only
        # non-blocking channel, and it has no clean state, so the two are separate calls
        # rather than one call with a flag this class does not take.
        if _catread["flagged"]:
            res.advise(_cr_line, _cr_why + ". ADVISORY: this row blocks nothing")
        else:
            # `count()`, NOT a passing row — a passing row is never printed, so on a
            # clean org this named invariant reached NO reader while its own comment
            # above, `audit.md` Step 5d item 2c and `verify.md` all said to report it
            # including the zeroes. Customer DEF-Q-011, measured on 4 governed handbooks
            # with 0 on a literal path: the line appeared nowhere in the output. Same
            # shape as the `n/a` vs `no-sections` fix in INV-STAMP — a zero has to be
            # visible to be a measurement.
            res.count(_cr_line)
    check_companions(root, res, governed_n)
    check_journal(root, res)
    check_defects(root, res)
    check_catalogs(root, res)
    check_hook_wiring(root, res)

    if args.json_path:
        with open(args.json_path, "w", encoding="utf-8") as fh:
            json.dump({"rows": res.rows, "unreadable": res.unreadable}, fh, indent=2)

    if not args.quiet:
        governed = len(handbooks) - len(res.adopted)
        # All counts, always, including the zeroes. A zero is a measurement.
        print(f"wf-conform — {root}")
        print(f"  {governed} governed · {len(res.adopted)} adopted (exempt) · "
              f"{len(res.rows)} checks · {len(res.failed)} failed · "
              f"{len(res.adopted_findings)} adopted-agent note(s) · "
              f"{len(res.advisory_findings)} advisory · "
              f"{len(res.unreadable)} unreadable")
        for c in res.counts:
            print(f"  {c}")
        if res.scratch_skipped:
            # NAMED FROM THE LIST ITSELF, so the line cannot say `{work,staging}` while
            # the scope skips a third directory (`retired/` joined it 2026-09-16).
            _dirs = ",".join(os.path.basename(d) for d in
                             _load_sibling("wf-census").SACRED_SCRATCH)
            print(f"  {res.scratch_skipped} file(s) under .claude/workforce/"
                  f"{{{_dirs}}}/ not scanned for sacred blocks — run scratch "
                  f"holds copies whose originals are guarded at source")
        for r in res.failed:
            print(f"  ✗ {r['check']}" + (f"\n      {r['detail']}" if r["detail"] else ""))
        for r in res.advisory_findings:
            # Reported, never enforced — the contract post-dates the file.
            print(f"  ~ {r['check']}" + (f"\n      {r['detail']}" if r["detail"] else ""))
        for r in res.adopted_findings:
            # Reported, never enforced — it is not workforce's file.
            print(f"  · {r['check']}" + (f"\n      {r['detail']}" if r["detail"] else ""))
        for u in res.unreadable:
            print(f"  ! unreadable {u}")
        if res.adopted and not args.strict_adopted:
            print(f"  ({len(res.adopted)} adopted agent(s) checked for runtime hazards only — "
                  f"workforce did not author them. `--strict-adopted` to hold them to the "
                  f"full contract.)")

    if res.unreadable:
        return 2
    return 1 if res.failed else 0


if __name__ == "__main__":
    sys.exit(main())
