#!/usr/bin/env python3
"""wf-settings-apply — the producer for the one write a human must run by hand.

    wf-settings-apply --root <tree>                    DISPLAY: print the exact edit, write nothing
    wf-settings-apply --root <tree> --execute --grants <file|->
    wf-settings-apply --root <tree> --execute --wire-hook <name>
    wf-settings-apply --root <tree> --execute --heal   (remove rows whose script was retired)
    wf-settings-apply           --execute --automode   (writes ~/.claude/settings.json, user scope)

WHY THIS EXISTS. Every settings-file mutation a workforce audit needs — the Step 0.8
permission ADDITION, the hook-wiring the CLAUDE.md evacuation depends on — can be
refused by the Claude Code auto-mode SELF-MODIFICATION classifier, which sits ABOVE
the permissions layer: a broad `Edit(<project>/**)` grant that covers the settings
file exactly does NOT lift it (MEASURED 2026-08-06, twice). The classifier gates the
MODEL's tool calls; it does not gate a command the HUMAN runs in their own shell.

So the remedy for a refused write is not a JSON block pasted into a report and not a
command that will re-attempt the same refused write — it is THIS script, which the
human runs OUT OF BAND via the REPL `!` prefix. `! wf-settings-apply --root <abs>
--execute --grants -` performs the exact write the classifier blocked, in ONE gesture,
with the reversal written first and the result read back off disk. `references/
audit-setup.md` § 856 said this producer "could be built"; it is built.

    --grants <file|->   add computed permission ADDITIONs (scoped rule strings) that
                        are absent from the union of all four scopes. Refuses a bare
                        `Bash`/blanket grant (audit-setup.md § Step 0.8 rule 3b).
    --wire-hook <name>  register a shipped workforce hook at its event, idempotently.
                        A PROPOSED hook (`OPT_IN_HOOKS`) is wireable only by NAME and is
                        never in the default set.
    --heal              remove, from this project's two settings files only, the
                        workforce hook rows whose script the distribution RETIRED
                        (`RETIRED_HOOKS`) and whose install is present and whole. Never a
                        live row, never a user-scope file (see `heal`). The same function
                        runs at SessionStart from `wf-commitments`, so a project heals on
                        first use without anybody typing this.
    --automode          write autoMode.environment/allow into ~/.claude/settings.json
                        so the classifier stops refusing routine workforce maintenance.
                        User scope is deliberate: the classifier reads autoMode ONLY
                        from user/managed settings and IGNORES project settings, so a
                        repo cannot grant itself autonomy (code.claude.com/docs/en/
                        auto-mode-config, verified 2026-08-08, harness 2.1.224).

CONSENT MODEL, identical to wf-apply. DISPLAY is the default: the exact bytes are
printed and nothing is written. `--execute` is the consent. The reversal (pre-edit
content) is written to `.settings-owned.json` BEFORE the edit, and the edit is
confirmed by RE-READING the file — never by echoing the string passed to write().
The heal is the one exception to the order, and `_record` says why: it removes, so
it writes the settings file, re-reads it, and records only what it verified.

OWNERSHIP. Every key this script adds is recorded in
`.claude/workforce/.settings-owned.json` so `disband` removes exactly those and
nothing the user wrote. A registration the sidecar does not name is the user's.
"""

import argparse
import errno
import json
import os
import re
import sys

OWNED_REL = os.path.join(".claude", "workforce", ".settings-owned.json")

# The two project-scope settings files, precedence order (references/scopes.md).
PROJECT_SETTINGS = ("settings.local.json", "settings.json")

def _sibling(name):
    """A sibling shipped script, imported by path. The ONE loader in this file, and it
    leaves no bytecode behind in the shipped bin/ (bin/check reports a __pycache__
    there as an undeclared file)."""
    import importlib.machinery
    import importlib.util
    prev = sys.dont_write_bytecode
    sys.dont_write_bytecode = True
    try:
        mod_name = name.replace("-", "_")
        loader = importlib.machinery.SourceFileLoader(
            mod_name, os.path.join(os.path.dirname(os.path.abspath(__file__)), name))
        mod = importlib.util.module_from_spec(importlib.util.spec_from_loader(mod_name, loader))
        loader.exec_module(mod)
        return mod
    finally:
        sys.dont_write_bytecode = prev


# THE ONE WORKFORCE-ROW RESOLVER lives in wf-census (`workforce_hook`), and the wiring,
# the heal and wf-conform all read it, so no two of them can disagree about which rows
# are workforce's or where they resolve. PER_SESSION_ROOT is the canonical resolver's
# personal root (scopes.md § Resolving the shipped scripts). Claude Code runs a hook
# command that has no `args` through a shell (`spawn(command, [], {shell: true})`, read
# out of the 2.1.268 binary on 2026-09-14) with the session's environment, so this form
# expands to the config root of whichever account is running.
CENSUS = _sibling("wf-census")
PER_SESSION_ROOT = CENSUS.PER_SESSION_ROOT


# Shipped hooks, by name -> (event, matcher-or-None). references/procedures/hooks.md
# § What is wired. A matcher of None omits the key, which is correct for
# UserPromptSubmit (it has no tool to match against).
SHIPPED_HOOKS = {
    "wf-protect-directives": ("PostToolUse", "Edit|Write"),
    # A COUNT, NOT A CHECK — see wf-turn-ledger's header. It reports what the turn
    # read; it never reads the reply and never judges one, so it has no
    # false-positive rate to tune and cannot repeat the 7.0% failure that retired
    # the speech guards (changes/1.30.1.md).
    "wf-turn-ledger": ("Stop", None),
    # THE SAME LEDGER ON SUBAGENTS. Registered a second time on `SubagentStop`,
    # which fires when a spawned agent finishes and carries `agent_type`,
    # `agent_transcript_path` and `last_assistant_message` for that agent.
    #
    # This distribution's whole argument is that a spawned employee has ZERO
    # residency — fresh context, no history, one shot — so it is the node MOST
    # exposed to authoring from the thin surface in front of it. Covering the main
    # loop and not the spawns inverted that.
    #
    # *Added 2026-09-09 after reading the hooks reference. The gap was reported
    # twice as a structural limit — "main-loop only, it will not cover spawned
    # agents" — which was never true: `SubagentStart` and `SubagentStop` are both
    # documented events. A limit asserted from memory and never checked.*
    "wf-turn-ledger@subagent": ("SubagentStop", None),
    # THE ACTING HALF. The ledger reports and the operator has to decide to act on the
    # report — a decision made from inside the tunnel, by the faculty the measurement
    # found impaired. This one blocks the stop instead, and its `reason` becomes the
    # next instruction. Same two events for the same reason the ledger has both: a
    # spawned employee has zero residency and is the node most exposed to authoring
    # from the thin surface in front of it.
    "wf-widen": ("Stop", None),
    "wf-widen@subagent": ("SubagentStop", None),
    # THE OTHER WAY A TURN STOPS WHEN IT SHOULD NOT: parked on the user, in prose. Where
    # `wf-widen` catches a turn that announced it was continuing and then ended, this
    # catches one that ends on a decision the user has to decode out of markdown and
    # type back — an answer in codes, a numbered list to choose from, "still waiting on
    # your decisions" — with no `AskUserQuestion` call anywhere in the turn. `Stop` only:
    # a subagent has no user to ask and no AskUserQuestion in its tool set. Reported
    # 2026-09-24 against an `/agenda today` run that put 31 items to the user in
    # markdown, buried the list under six background hand-backs, and sat about fifteen
    # minutes. Triggers measured at 1.29% of 3,634 real turns before wiring.
    "wf-chooser": ("Stop", None),
    # THE FRONT HALF. `UserPromptSubmit` fires before the prompt is processed, which is
    # the only point in a turn where "which sense does this need" arrives in time to
    # change what the turn does instead of grading it afterwards. It names and never
    # blocks: `decision: "block"` on this event ERASES the user's prompt, and nothing
    # about a regex classification justifies destroying an ask.
    "wf-task-tag": ("UserPromptSubmit", None),
    # THE SAME RULE FOR EMPLOYEES. A spawned agent never sees UserPromptSubmit context,
    # so `wf-task-tag` is registered again on `SubagentStart` and there emits only
    # USER_WORDS — the user-words-newest-first rule (SKILL.md § Directives, 2026-09-16) —
    # into every spawned agent, org or no org. Checked in the 2.1.268 binary: the
    # SubagentStart branch reads `hookSpecificOutput.additionalContext`.
    "wf-task-tag@subagent": ("SubagentStart", None),
    # WHO WROTE THE CODE BEING EDITED, at the edit. Human code outranks AI code on how
    # new code is written (SKILL.md § Directives, 2026-09-16); the split comes from git,
    # per file, so the look-up cannot be skipped. Context only, never a denial.
    "wf-code-origin": ("PreToolUse", "Edit|Write|MultiEdit|NotebookEdit"),
    # THE ONLY HOOK HERE THAT ACTS. Everything else in this table reports or decides;
    # this one spawns a reader and opens the channel the turn left shut. Config shape is
    # in AGENT_HOOKS below — it is registered as `type: "agent"`, not `command`.
    "wf-widen-agent": ("Stop", None),
    # THE DEBT LEDGER, ON BOTH ENDS OF A SESSION. `Stop` records what a turn said it
    # would do next; `SessionStart` reads it back before the first request of the next
    # session. Registered twice for the same reason the ledger is: a stated intention
    # that disappears between sessions is how work gets left half finished, and the
    # gap it closes is measured — a goal whose condition held while the work was still
    # half done, because the list it checked was written by the head that was tunneling.
    "wf-commitments": ("Stop", None),
    "wf-commitments@sessionstart": ("SessionStart", None),
}

# AGENT-HOOK CONFIG, keyed by the same names SHIPPED_HOOKS uses.
#
# WHY THE PROMPT IS THREE SENTENCES. An agent hook's prompt is inlined into
# `settings.json`, which is a file no reader of this repository would think to check and
# which no check here can reach on someone else's machine. Instructions carried there
# are a second copy of a procedure, and the second copy is the one that drifts. So this
# says only: read the flag, read the reference, act. The procedure lives in
# `references/senses.md` where it is shipped, versioned and asserted.
#
# `$ARGUMENTS` is the hook's JSON input — it carries `session_id` and `scratchpad_dir`,
# which is how the agent finds the flag `wf-widen` wrote for it.
#
# IT RETURNS `ok: true` AND EXITS IMMEDIATELY WHEN THERE IS NO FLAG. That is the cost
# control and it is load-bearing: `wf-widen` decides for free on every turn, and this
# spawns only on the turns that earned it — the evidence triggers measured 0.5% and 1.5%
# of 1,495 turns (wf-widen § WHAT KEEPS IT FROM CRYING WOLF), plus the sampled audit of
# passing turns. This read "~10%", a round figure nothing measured. An agent hook that analysed every Stop would
# spend a subagent per turn to conclude there was nothing to do.
AGENT_HOOKS = {
    "wf-widen-agent": {
        "type": "agent",
        "timeout": 120,
        "prompt": (
            "Hook input: $ARGUMENTS. IF it carries `stop_hook_active: true`, respond "
            "{\"ok\": true} and do nothing else — this Stop is the continuation of a "
            "turn already judged.\n"
            "Otherwise read "
            "<scratchpad_dir>/wf-widen-flag.<session_id>.json. If it does not exist, "
            "respond {\"ok\": true} and do nothing else.\n"
            "It carries `ask` (what the user requested, and `ask.senses`, the jurors "
            "this kind of ask summons), `evidence` (what the turn's tool calls "
            "returned), and `conclusion` (what the turn told the user).\n"
            "If `ask.prompt` is empty, or `ask.senses` is empty and the flag carries no "
            "`ask.checklist`, NO JUROR IS SEATED and there is no case: respond "
            "{\"ok\": true} and stop. Never infer a docket from the other fields.\n"
            "If the flag carries `ask.checklist`, even an empty one, also "
            "sit as the asks juror: does the conclusion address each separate request in "
            "`ask.prompt` in its own section, and when the list has items, is each request "
            "one of them? A request the conclusion does not address, or one missing from a "
            "list that has items, is a no.\n"
            "YOU ARE A JURY, NOT A SCORER. Return no numbers. For each sense in "
            "`ask.senses`, sit as that juror and answer one question, verifying against "
            "this repository with Read and Bash (`grep`, `git log`) rather than taking "
            "the turn's word:\n"
            "  sight     does the source say what the conclusion says it says?\n"
            "  hearing   did an outside voice — the record, the web, a spawned reader — "
            "actually address this question, and was it read?\n"
            "  touch     was the behaviour claimed demonstrated by something RUN?\n"
            "  taste     was the set the conclusion speaks about actually enumerated?\n"
            "  smell     is something off in the conclusion itself — overclaimed, or "
            "resting on a word the evidence does not support?\n"
            "  intuition what did this turn assume without evidence, and does anything "
            "support it? You did not form this prior, so you can read it.\n"
            "Judge the conclusion against `ask.prompt` only. An offer, option or question "
            "the conclusion puts to the user is not work it claimed or promised, and is "
            "never grounds for a no.\n"
            "A juror votes no only on something it VERIFIED. A juror that cannot verify "
            "either way abstains and says why.\n"
            "EVERY VERDICT CARRIES A REASON — yes, no and abstain alike. A bare yes "
            "says nothing and is not an acceptable answer: a juror that acquits must "
            "say what it checked and what it saw, with file:line or a commit SHA.\n"
            "Respond with JSON only:\n"
            "  {\"ok\": true, \"reason\": \"<juror>: <what you verified and what it "
            "showed>; <juror>: <...>\", \"notes\": [\"<anything else worth looking at>\"]}\n"
            "  {\"ok\": false, \"reason\": \"<juror>: <what you verified, with file:line "
            "or a commit SHA, and what the conclusion got wrong or left unchecked>\"}\n"
            "Unanimity is NOT required — one verified no is a no. The REASON is the "
            "deliverable, not the verdict: a place worth looking is worth more than a "
            "yes or a no, and it is the context that makes the next step obvious "
            "without anyone having to be told. Report findings only. Do not edit."
        ),
    },
}

# WIREABLE, NEVER DEFAULT. A hook named here is registered only when a human types
# `--wire-hook <name>` — so membership in SHIPPED_HOOKS means
# "`--wire-hook <name>` will register it", and nothing more. DEFAULT_HOOKS is the set
# any "wire the shipped hooks" gesture iterates; a name here is excluded from it and
# reaches a settings file only when a human types it. Two sets rather than one flag
# because the unknown-hook error prints BOTH, which is what makes the distinction
# observable — and therefore fixture-checkable — instead of a comment nobody executes.
# Empty since the simplification release. It held `wf-loop-guard`, which shipped
# unwired and therefore never fired for anyone — an unwired detector, which
# `enforcement.md` forbids shipping. The set stays because the two-set shape is what
# makes the unknown-hook error print both, and a future opt-in hook needs somewhere
# to go; an empty frozenset is the honest expression of "none right now".
OPT_IN_HOOKS = frozenset()
DEFAULT_HOOKS = tuple(n for n in sorted(SHIPPED_HOOKS) if n not in OPT_IN_HOOKS)

# RETIRED BY THE DISTRIBUTION, NEVER BY A MISSING FILE. A row is removable as dead only
# when its script is named here: every script this repository has deleted from
# workforce/bin/ and does not ship now. bin/check derives the same set from `git log`
# and the manifest and fails when the two disagree, so a name cannot be retired here by
# accident, and a currently shipped name can never be.
#
# WHY A LIST AND NOT `os.path.exists`. "The file is not there right now" is also true on
# a branch checked out without its vendored install, inside `bin/sync`'s delete-then-copy
# window, on a slow network mount, under EACCES, and whenever the install is simply gone.
# The first version of the heal read absence as retirement and would have unwired a live
# shipped hook in every one of those cases, with nothing to put it back (independent
# review, 2026-09-14).
RETIRED_HOOKS = frozenset({
    "wf-budget-guard", "wf-effort-budget", "wf-handoff", "wf-ledger-capture",
    "wf-ledger-open", "wf-loop-guard", "wf-model-budget", "wf-pin-check",
    "wf-plain-guard", "wf-speak-guard", "wf-standing-request", "wf-turn-brief",
    "wf-unique-persona",
})
# The scripts a complete, current install holds. A missing retired script proves
# retirement only when the install it would live in is present and whole.
CURRENT_HOOK_SCRIPTS = frozenset(n.split("@", 1)[0] for n in SHIPPED_HOOKS
                                 if n not in AGENT_HOOKS)

# The autoMode entries recommended into ~/.claude/settings.json. Prose, not patterns —
# the classifier reads them as natural-language rules (auto-mode-config docs). Each is
# spliced beside "$defaults" so the built-in rules are kept and updates still arrive.
AUTOMODE_ENVIRONMENT = (
    "Editing a project's own .claude/ configuration — its settings files, agent "
    "handbooks under .claude/agents/, and hook registrations — is trusted maintenance "
    "when performed by a claude-workforce audit of that same project."
)
AUTOMODE_ALLOW = (
    "Adding permission-allow grants, wiring a shipped workforce hook, or rewriting an "
    "agent handbook's frontmatter inside the working project during a claude-workforce "
    "audit is routine maintenance, not autonomy-widening: the writes are scoped to the "
    "project's own .claude/ tree and recorded in .claude/workforce/.settings-owned.json."
)


def read(path):
    try:
        with open(path, encoding="utf-8") as fh:
            return fh.read()
    except (OSError, ValueError):
        return ""


def load(path):
    """(data, error). A tool that writes settings must not die on the JSON it edits."""
    try:
        with open(path, encoding="utf-8") as fh:
            return json.load(fh), None
    except FileNotFoundError:
        return None, None
    except (OSError, ValueError) as exc:
        return None, f"{path}: {exc}"


def dump(path, data):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="utf-8") as fh:
        json.dump(data, fh, indent=2)
        fh.write("\n")


def has_workforce_keys(data):
    """True if this settings file already carries workforce-owned keys — the marker
    that it is the file a run has been writing to."""
    if not isinstance(data, dict):
        return False
    perms = data.get("permissions")
    allow = perms.get("allow") if isinstance(perms, dict) else []
    if isinstance(allow, list) and any(
        isinstance(e, str) and (e == "Agent" or e.startswith("Bash(")) for e in allow
    ):
        return True
    hooks = data.get("hooks")
    if isinstance(hooks, dict) and hooks:
        return True
    return False


def resolve_project_settings(root):
    """The project settings file to write. Prefer the one already carrying workforce
    keys; absent all, default to settings.local.json. NEVER managed settings."""
    candidates = []
    for name in PROJECT_SETTINGS:
        spath = os.path.join(root, ".claude", name)
        data, _ = load(spath)
        candidates.append((spath, data))
    for spath, data in candidates:
        if has_workforce_keys(data):
            return spath
    for spath, data in candidates:
        if isinstance(data, dict):
            return spath
    # Absent all four, default to settings.local.json (audit-setup.md § Step 0.8).
    return os.path.join(root, ".claude", "settings.local.json")


def config_root():
    """Personal config root. $CLAUDE_CONFIG_DIR relocates the whole ~/.claude tree
    (scopes.md § Installing into a specific CLAUDE_CONFIG_DIR); the installer exports it
    when a --config-dir install writes the auto-mode grant, so the grant lands in the
    same tree as the skill. Unset, it is exactly ~/.claude."""
    return os.environ.get("CLAUDE_CONFIG_DIR") or os.path.join(os.path.expanduser("~"), ".claude")


def user_settings_path():
    return os.path.join(config_root(), "settings.json")


def scopes_collapse(root):
    """Are `<root>/.claude` and the personal config root the SAME directory?

    They are whenever the project IS `$HOME` — a real configuration, and the one this
    distribution is most often installed into — and whenever `$CLAUDE_CONFIG_DIR` or a
    symlink points one at the other. There is then no such thing as wiring "at project
    scope on top of" user scope: the two files sit side by side in one directory and the
    harness reads both for the same session, so a hook wired at user scope is already
    live for this project and adding the project-scope one DOUBLE-FIRES it.
    """
    return os.path.realpath(os.path.join(root, ".claude")) == os.path.realpath(config_root())


def union_settings_paths(root):
    """Every settings file in force for `root`, deduped by realpath, project first.

    THE SAME ARGUMENT `union_allow` MAKES FOR GRANTS, MADE FOR HOOKS. Registrations
    concatenate across scopes exactly as grants do (platform.md fact 17): a hook in
    `~/.claude/settings.json` fires for every project on the machine, this one included.
    A presence check that reads only the file its own scope writes therefore asks
    "is it wired HERE", reports no, and offers a registration that is already live —
    and at `root == $HOME` the two files are siblings in one directory, so the offer
    lands a second copy of a hook the user can see in the same `ls`.

    Deduped by realpath because the same file reached through two spellings must not be
    read twice, and ordered project-first so the path REPORTED is the one whose scope
    was asked about.
    """
    seen, out = set(), []
    for cand in [os.path.join(root, ".claude", n) for n in PROJECT_SETTINGS] + [user_settings_path()]:
        key = os.path.realpath(cand)
        if key in seen:
            continue
        seen.add(key)
        out.append(cand)
    return out


def union_allow(root):
    """Every permissions.allow entry across the two project scopes and the user scope.
    Grants concatenate across scopes (platform.md fact 17), so a grant already in force
    anywhere is not re-added — a second copy is a redundant write into a file the user
    owns."""
    seen = set()
    paths = [os.path.join(root, ".claude", n) for n in PROJECT_SETTINGS]
    paths.append(user_settings_path())
    for spath in paths:
        data, _ = load(spath)
        if isinstance(data, dict):
            perms = data.get("permissions")
            allow = perms.get("allow") if isinstance(perms, dict) else None
            if isinstance(allow, list):
                seen.update(e for e in allow if isinstance(e, str))
    return seen


def owned_root(root, scope):
    """Where the reversal record lives, by scope.

    A user-scope write has no project tree to record into, and putting its record in
    whatever directory the installer happened to run from would make `disband` in a
    DIFFERENT project the only thing that could reverse it. Under the config root the
    record sits beside the settings file it describes."""
    return config_root() if scope == "user" else os.path.join(root, ".claude")


def load_owned(root, scope="project"):
    owned_path = (os.path.join(owned_root(root, scope), "workforce", ".settings-owned.json")
                  if scope == "user" else os.path.join(root, OWNED_REL))
    data, _ = load(owned_path)
    if not isinstance(data, dict):
        data = {}
    return owned_path, data


# ---------------------------------------------------------------------------- grants

def is_blanket_bash(rule):
    """A bare `Bash` or wildcard `Bash(*)` supersedes the user's scoped grants — never
    added (audit-setup.md § Step 0.8 rule 3b). Not overwriting a preference is not the
    same as not defeating it."""
    r = rule.strip()
    return r == "Bash" or r in ("Bash(*)", "Bash(:*)")


def do_grants(root, spec_arg, execute):
    # Accept `-` (stdin), inline JSON (`[...]`), or a file path — inline is the form a
    # human types by hand and the form a fixture can pass through argv.
    if spec_arg == "-":
        raw = sys.stdin.read()
    elif spec_arg.lstrip().startswith("["):
        raw = spec_arg
    else:
        raw = read(spec_arg)
    try:
        wanted = json.loads(raw)
    except ValueError as exc:
        print(f"wf-settings-apply: --grants is not valid JSON: {exc}", file=sys.stderr)
        return 2
    if not isinstance(wanted, list) or not all(isinstance(e, str) for e in wanted):
        print("wf-settings-apply: --grants must be a JSON array of rule strings, e.g. "
              '["Agent","Bash(./bin/check:*)"]', file=sys.stderr)
        return 2

    blanket = [r for r in wanted if is_blanket_bash(r)]
    if blanket:
        print("wf-settings-apply: refusing to add a blanket grant — it would supersede "
              f"the user's scoped rules: {blanket}. Scope it (audit-setup.md § Step 0.8 "
              "rule 3b) or report it and add nothing.", file=sys.stderr)
        return 2

    spath = resolve_project_settings(root)
    print(f"PERMISSIONS  {spath}          <- resolved, not assumed")
    in_force = union_allow(root)
    to_add = [r for r in wanted if r not in in_force]
    already = [r for r in wanted if r in in_force]

    for r in already:
        print(f"  . {r}                already present (some scope) — not re-added")
    for r in to_add:
        print(f"  {'+' if execute else '~'} {r}                "
              f"{'added' if execute else 'would add'}")
    print(f"\n{len(to_add)} {'added' if execute else 'to add'} · {len(already)} present "
          f"· 0 removed          <- always all three, including zeros")

    if not execute:
        if to_add:
            print("  apply with: --execute   (run it yourself via `!` if the classifier "
                  "refused the agent's write)")
        return 0
    if not to_add:
        return 0

    data, err = load(spath)
    if err:
        print(f"wf-settings-apply: {err}", file=sys.stderr)
        return 1
    if not isinstance(data, dict):
        data = {}
    perms = data.setdefault("permissions", {})
    if not isinstance(perms, dict):
        print(f"wf-settings-apply: {spath} has a non-object permissions key; refusing "
              "to overwrite it.", file=sys.stderr)
        return 1
    allow = perms.setdefault("allow", [])
    if not isinstance(allow, list):
        print(f"wf-settings-apply: {spath} permissions.allow is not a list; refusing.",
              file=sys.stderr)
        return 1

    # Sidecar reversal FIRST — the exact grants added, so `disband` removes those and
    # nothing else. Written before the edit: a repaired sidecar that never got its edit
    # is recoverable; an edit whose ownership was never recorded is not.
    owned_path, owned = load_owned(root)
    added_key = owned.setdefault("permissions_allow_added", [])
    if not isinstance(added_key, list):
        added_key = owned["permissions_allow_added"] = []
    for r in to_add:
        if r not in added_key:
            added_key.append(r)
    dump(owned_path, owned)

    for r in to_add:
        if r not in allow:
            allow.append(r)
    dump(spath, data)

    # RE-READ. The defect this closes is a write believed and never made.
    back, err = load(spath)
    landed = []
    if isinstance(back, dict):
        ba = back.get("permissions", {}).get("allow", [])
        landed = [r for r in to_add if isinstance(ba, list) and ba.count(r) == 1]
    if len(landed) != len(to_add):
        print("wf-settings-apply: PERMISSIONS UNVERIFIED — re-read did not confirm every "
              f"grant present exactly once. landed={landed}", file=sys.stderr)
        return 1
    print(f"  verified on disk: {len(landed)} grant(s) present exactly once in {spath}")
    return 0


# ------------------------------------------------------------------------- wire-hook

def hook_script(name):
    """The SCRIPT a hook key names, stripping any `@event` suffix.

    One script may be registered on more than one event — `wf-turn-ledger` runs on
    both `Stop` and `SubagentStop`, because a spawned employee has zero residency and
    is the node most exposed to authoring from a thin surface. SHIPPED_HOOKS is keyed
    by registration, not by file, so `wf-turn-ledger@subagent` is a second
    registration of the SAME script. Without this split the key was used as a
    filename and resolved to a script that does not exist — caught by running
    `--wire-defaults` and reading its output rather than trusting the edit.
    """
    return name.split("@", 1)[0]


def hook_command(name, scope="user", root=None):
    """The shell-quoted command string for a shipped hook, and the path it names.

    USER SCOPE gets the absolute personal path: that file belongs to one config root, so
    naming that root's install is exact.

    PROJECT SCOPE NEVER GETS A PATH UNDER A PERSONAL CONFIG ROOT. A project settings file
    is read by every account and every machine that opens the tree, and an absolute
    `~/.claude-work/...` in it is right for one of them. MEASURED 2026-09-14: seven
    projects on one workstation carried 48 rows written this way, from two config roots,
    38 of them dead by the census (six projects). Every
    session in them fired both installs' hooks, and when either install retired a script
    its rows failed on every prompt for every account. So project scope takes the
    project install when there is one (`${CLAUDE_PROJECT_DIR}`, which travels with the
    repo), and otherwise `PER_SESSION_ROOT`, which each session's shell resolves to its
    own install.

    Expanding `~` here is still right. A hook command DOES run through a shell (see
    PER_SESSION_ROOT), but `~` inside double quotes is not expanded by one.
    """
    script = hook_script(name)
    personal = os.path.join(config_root(), "skills", "workforce", "bin", script)
    project_rel = os.path.join(".claude", "skills", "workforce", "bin", script)
    project = os.path.join("${CLAUDE_PROJECT_DIR}", project_rel)
    if scope == "project":
        if root and os.path.exists(os.path.join(root, project_rel)):
            resolved = project
        elif os.path.exists(personal):
            resolved = f"{PER_SESSION_ROOT}/skills/workforce/bin/{script}"
        else:
            resolved = project
    else:
        resolved = personal if os.path.exists(personal) else project
    return f'"{resolved}"', resolved


def _norm_command(cmd, root=None):
    """A hook command reduced to the one form two spellings of the same script share.

    `hook_command` emits an absolute path today, but a registration written by an older
    version, by hand, or by another scope may spell the SAME script as
    `"$HOME/.claude/skills/workforce/bin/wf-protect-directives"` or with
    `${CLAUDE_PROJECT_DIR}` unexpanded. A raw `==` cannot see through any of that, so the
    tool could not recognise its own past work: measured on a live project 2026-09-08,
    `--wire-defaults` reported `would register` for three hooks that were ALREADY wired,
    and `--execute` would have written each a second time. The three-paths directive has
    `audit` re-wire on every run, so that is one duplicate per audit, forever.

    The unwire path (`do_unwire_defaults`) is the worse half and the reason this is not
    cosmetic: an unwire that cannot match its own record leaves the hook wired while
    reporting it removed.
    """
    if not isinstance(cmd, str):
        return cmd
    out = cmd.strip().strip('"').strip("'")
    if root:
        for var in ("${CLAUDE_PROJECT_DIR}", "$CLAUDE_PROJECT_DIR"):
            out = out.replace(var, root)
    # `os.path.expandvars` does not know the `:-` default, so the per-session form would
    # survive it unexpanded and never match the row this script itself wrote.
    out = out.replace(PER_SESSION_ROOT, config_root())
    out = os.path.expandvars(os.path.expanduser(out))
    return os.path.normpath(out) if os.path.isabs(out) else out


def _same_command(h, command, root=None):
    """Does this registered hook entry name the same command as `command`?"""
    return (isinstance(h, dict)
            and _norm_command(h.get("command"), root) == _norm_command(command, root))


def _wf_identity(h, root=None):
    """`(script, live)` when this entry names a workforce hook in any form workforce
    writes, else None — read from the shared resolver (`CENSUS.workforce_hook`).

    Identity is the SCRIPT, not the path: the same hook reached through two installs is
    one hook firing twice, and a presence check keyed on the path offered a second copy
    of every hook already live from another install.
    """
    wh = CENSUS.workforce_hook(h.get("command"), root) if isinstance(h, dict) else None
    return None if wh is None else (wh["script"], wh["exists"])


def _same_agent(h, inner):
    """Is this registered entry the SAME agent hook as `inner`?

    AGENT HOOKS CARRY NO `command`, so `_same_command` compares None against a resolved
    path and answers False forever — which would re-register the hook on every
    `--wire-defaults` and leave a duplicate per run, each one spawning its own subagent
    at every Stop. Identity here is the type plus a distinctive substring of the prompt,
    because the prompt is the hook: two agent hooks on one event differ by nothing else.
    """
    if not isinstance(h, dict) or h.get("type") != "agent":
        return False
    mine, theirs = inner.get("prompt") or "", h.get("prompt") or ""
    marker = "wf-widen-flag"
    return marker in mine and marker in theirs


def _scan_hook(data, event, agent_cfg, command, root):
    """Is this hook registered in `data`, and does it carry a stale agent prompt?

    Returns `(present, stale_agent)`, where `stale_agent` is the list of
    `(entry, inner)` pairs that ARE this hook but hold a prompt that is no longer the
    shipped one. Lifted out of `do_wire_hook` unchanged when the presence check learned
    to read more than one settings file: one scan written twice is a restated constant
    (Core Principle 9a), and the copy that drifts is the one that reads the file nobody
    is looking at.
    """
    hooks = data.get("hooks") if isinstance(data, dict) else None
    existing = hooks.get(event) if isinstance(hooks, dict) else None
    present, stale_agent = False, []
    if not isinstance(existing, list):
        return present, stale_agent
    # THE SAME SCRIPT FROM ANOTHER INSTALL IS THE SAME HOOK — unless it is provably dead.
    # A row naming `~/.claude-work/.../wf-protect-directives` fires that hook in this
    # project exactly as the path this run resolved would, so writing ours beside it
    # double-fires every edit. A dead one fires nothing and must not suppress the write.
    want = _wf_identity({"command": command}, root) if agent_cfg is None else None
    for e in existing:
        for h in (e.get("hooks", []) if isinstance(e, dict) else []):
            if agent_cfg is not None:
                if _same_agent(h, agent_cfg):
                    # OURS — BUT IS IT THE CURRENT PROMPT? An agent hook IS its
                    # prompt: change the prompt and you have changed what the hook
                    # does, entirely. Identity is deliberately coarse (a marker, so
                    # a rename does not orphan a live registration), which means
                    # equality has to be checked separately or a rewritten prompt
                    # reports NOOP forever and the machine keeps running the old one.
                    #
                    # MEASURED 2026-09-09: the widening agent was rewritten from
                    # "open the named channel" to "judge whether the evidence
                    # supports the conclusion" — the entire point of the release —
                    # and `--wire-defaults --execute` said "already registered,
                    # NOOP". The old prompt stayed live and the redesign reached
                    # nothing. Found by reading settings.json instead of trusting
                    # the word NOOP.
                    if (h.get("prompt") or "") == (agent_cfg.get("prompt") or ""):
                        present = True
                    else:
                        stale_agent.append((e, h))
            elif _same_command(h, command, root):
                present = True
            elif want is not None:
                have = _wf_identity(h, root)
                if have is not None and have[0] == want[0] and have[1] is not False:
                    present = True
    return present, stale_agent


def settings_for_scope(root, scope):
    """The settings file the two wiring writers target, by scope.

    A `--user` install has no project root at all, so the project resolver cannot be
    the only path: an installer that could wire a hook only into the tree it was run
    from would leave every OTHER project on that machine unwired, which is the manual
    per-project step this scope exists to remove."""
    return user_settings_path() if scope == "user" else resolve_project_settings(root)


def count_registrations(root, name):
    """How many times `name` is registered on its event, per scope.

    Returns {scope: count}. Counted by `_wf_identity`, so the same script reached through
    any install and any spelling is one hook, and a row that is provably dead is not
    counted as firing.
    """
    event, _matcher = SHIPPED_HOOKS[name]
    script = hook_script(name)
    out = {}
    for scope in ("user", "project"):
        spath = settings_for_scope(root, scope)
        data, _ = load(spath)
        n = 0
        if isinstance(data, dict):
            hooks = data.get("hooks")
            entries = hooks.get(event) if isinstance(hooks, dict) else None
            for e in (entries if isinstance(entries, list) else []):
                for h in (e.get("hooks", []) if isinstance(e, dict) else []):
                    ident = _wf_identity(h, root)
                    if ident is not None and ident[0] == script and ident[1] is not False:
                        n += 1
        out[scope] = n
    return out


def report_duplicate_firing(root):
    """Say out loud when a hook is registered in BOTH scopes, or twice in one.

    NOBODY REPORTED THIS AND IT IS VISIBLE IN A TRANSCRIPT. The installer wires user
    scope so `/workforce` reaches every project on the machine; the three-paths
    directive has `audit` wire project scope so a fix propagates with the repo. Both
    are wanted, and neither knows about the other, so the hook fires twice per turn (it
    showed as the since-removed standing-request context injected twice). Measured
    2026-09-08: five of the six defaults were doubled on a live machine.

    REPORTS, NEVER REPAIRS. Which scope should keep a registration is the user's call,
    and a tool that silently unwired one of them would be deciding it — the same move
    `--unwire`'s conservatism exists to refuse. Duplication is harmless for a guard
    that is idempotent and wasteful for every hook, and the defect was that nothing
    said so.

    A LIVE ROW INTO A PERSONAL INSTALL IS REPORTED HERE TOO, NEVER HEALED. It double-
    fires, but whether it is redundant for every account and machine that reads the
    project file cannot be proven from this one, so removing it would be the same
    decision this function refuses. `heal` removes only rows whose script is retired;
    wf-conform names the live ones as advisory.
    """
    both, twice = [], []
    for hook in DEFAULT_HOOKS:
        name, counts = hook, count_registrations(root, hook)
        if counts["user"] and counts["project"]:
            both.append((name, counts))
        for scope, n in counts.items():
            if n > 1:
                twice.append((name, scope, n))
    if not both and not twice:
        return 0
    print()
    print("  DOUBLE-FIRING — reported, not repaired:")
    for name, c in both:
        event = SHIPPED_HOOKS[name][0]
        print(f"    ! {name} is registered at BOTH user and project scope "
              f"(user {c['user']}, project {c['project']}) — it runs twice per "
              f"{event}")
    for name, scope, n in twice:
        print(f"    ! {name} is registered {n} times in {scope} scope alone")
    print("    Both scopes are wired on purpose — the installer does user scope so "
          "/workforce")
    print("    reaches every project, and audit does project scope so a fix travels "
          "with the")
    print("    repo. Neither knows about the other. Removing one is your call: "
          "`--unwire-defaults")
    print("    --scope user` or `--scope project`, whichever you want to keep.")
    return 0


def do_wire_defaults(root, scope, execute):
    """Wire every DEFAULT hook, in one call.

    WHY THIS EXISTS. Wiring was one `--wire-hook` invocation per hook, typed by a human
    per machine and per project. On a single workstation that is a chore; across
    servers it is a mechanism that does not propagate, and a mechanism that does not
    propagate is dormant everywhere it was not typed — the exact failure four inherited
    hooks died of, arriving through the gesture rather than through the file. The
    installer calls this, and so does `audit`, so a fresh machine is wired by the
    install and an already-installed machine is HEALED by the next audit.

    IT IS NOT A NEW DECISION SURFACE. The set is `DEFAULT_HOOKS` — exactly what
    `/workforce hooks --execute` wires, no more — and `OPT_IN_HOOKS` stays out of it.
    Each write is the same idempotent NOOP-if-present write `--wire-hook` performs, so
    running it twice registers nothing twice and reverses through the same
    `.settings-owned.json` record."""
    spath = settings_for_scope(root, scope)
    print(f"WIRE   {spath}          <- resolved, not assumed")
    print(f"  {len(DEFAULT_HOOKS)} default hook(s)"
          f"{'' if execute else '  (nothing written — add --execute)'}")
    # PRUNE FIRST. A dead row is not a registration, and a presence check that ran over
    # it before it was gone would read the file in a state this run is about to change.
    rc = prune_dead_hooks(root, scope, execute)
    if scope == "user":
        rc = max(rc, clear_retired_style(root, execute))
    for name in DEFAULT_HOOKS:
        rc = max(rc, do_wire_hook(root, name, execute, scope=scope, quiet=True))
    report_duplicate_firing(root)
    if not execute:
        print("  apply with: --execute   (run it yourself via `!` if the classifier "
              "refused the agent's write)")
    return rc


def prune_dead_hooks(root, scope, execute):
    """Remove the retired workforce rows from the file `--wire-defaults` is about to wire.

    WHY THIS EXISTS: the missing half of "three paths, or it does not propagate"
    (SKILL.md § Directives, 2026-09-07). A release that deletes a hook script leaves its
    registration behind on every machine that had it. MEASURED 2026-09-09: updating to
    1.31.0 removed eight scripts and left all eight rows in `~/.claude/settings.json`.

    PROJECT SCOPE is `heal`, the same function every session start runs. USER SCOPE is
    the installer's own file — the one writer that already owns it — pruned by the same
    classifier over that one file. `heal` itself never writes a user-scope file.

    A FAILURE HERE NEVER STOPS THE WIRING. The prune runs first, and it used to raise out
    of this function on a read-only user settings file, so the installer wired nothing and
    — its pipe swallowing the exit status — reported success (second review, N3).

    This docstring once claimed `verify` called this function. It never did: `verify`
    only reported `DEAD WIRING`, and a personal `update` never looked at a project, so
    the census counted 38 dead rows across six projects on the author's machine.
    """
    if scope != "user":
        return heal(root, execute, quiet=True)["rc"]
    cfg = config_root()
    if not os.path.isdir(cfg):
        return 0
    out = _new_result()
    owned_path = os.path.join(cfg, "workforce", ".settings-owned.json")
    out["refused"] = _record_refusal(owned_path, os.path.join(os.path.realpath(cfg), "workforce"))
    _run_heal(out, [user_settings_path()], "", owned_path, cfg,
              execute and not out["refused"], None)
    _print_result(out, execute and not out["refused"], quiet=True)
    return out["rc"]


# OUTPUT STYLES THE DISTRIBUTION RETIRED, by the `name:` a settings `outputStyle` selects them by,
# with the file each shipped as. `Plain Speak` shipped as `output-styles/plain-speak.md` and went
# in 1.31.0 (manifest.txt § Retired external paths). Only these names are ever cleared: a
# selection of any other style, however broken, is the user's and is left alone.
RETIRED_OUTPUT_STYLES = {"Plain Speak": "plain-speak.md"}
STYLE_HEAD_CHARS = 64 * 1024


def _style_file_present(name, dirs):
    """Does any output-styles directory still hold a style called `name`?"""
    for d in dirs:
        if not os.path.isdir(d):
            continue
        if os.path.isfile(os.path.join(d, RETIRED_OUTPUT_STYLES.get(name, ""))):
            return True
        try:
            names = os.listdir(d)
        except OSError:
            return True     # unreadable: the style may be there, and a clear must not guess
        for f in names:
            # A REGULAR FILE, READ TO A CAP. The project's own `output-styles/` is read at every
            # install, and a `.md` linked to `/dev/zero` was read without end until the installer
            # ran out of memory (review of the 1.63.0 fix batch, finding 7). A style's `name:`
            # sits in its frontmatter, so the head is the whole question.
            p = os.path.realpath(os.path.join(d, f))
            if f.endswith(".md") and os.path.isfile(p):
                try:
                    with open(p, encoding="utf-8", errors="replace") as fh:
                        head = fh.read(STYLE_HEAD_CHARS)
                except OSError:
                    head = ""
                m = re.search(r"^name:\s*(.+?)\s*$", head, re.M)
                if m and m.group(1).strip("'\"") == name:
                    return True
    return False


def clear_retired_style(root, execute):
    """Clear a USER-SCOPE `outputStyle` that selects a style workforce retired and whose file is gone.

    DEF-Q-16, 2026-09-16. The installer's prune removes the retired `plain-speak.md` from
    `<config-root>/output-styles/` (the `retired` rows of manifest.txt), and nothing cleared the
    `outputStyle: "Plain Speak"` that 1.20.0 through 1.30.x wrote beside it. So every host that
    had it kept a selection naming a style that no longer exists. `audit` Step 5h clears a project's
    selection, and a user-scope file is written by nobody but this installer path.

    THREE CONDITIONS, all required: the value is a name in RETIRED_OUTPUT_STYLES, exactly; no
    output-styles directory the session reads (the config root's, and the working project's) holds a
    style by that name; and the reversal record can be written. The edit removes the one key,
    character by character, re-reads the file, and only then appends `output_style_cleared` to
    `.settings-owned.json`, the same record `hooks_removed` lives in.
    """
    spath = user_settings_path()
    if not os.path.lexists(spath):
        return 0
    data, text, err = _load_strict(spath)
    value = data.get("outputStyle") if isinstance(data, dict) else None
    if err or not isinstance(value, str) or value not in RETIRED_OUTPUT_STYLES:
        return 0
    project = root or os.getcwd()
    dirs = [os.path.join(config_root(), "output-styles"), os.path.join(project, ".claude", "output-styles")]
    if _style_file_present(value, dirs):
        print(f"  . outputStyle {value!r} kept — a style file by that name is still on disk")
        return 0
    cfg = config_root()
    owned_path = os.path.join(cfg, "workforce", ".settings-owned.json")
    if not execute:
        print(f"  ~ outputStyle {value!r} would be cleared from {spath} (a style workforce retired; "
              f"no file for it remains)")
        return 0
    refusal = _record_refusal(owned_path, os.path.join(os.path.realpath(cfg), "workforce"))
    if refusal:
        print(f"  ! outputStyle {value!r} NOT cleared from {spath}: {refusal}")
        return 1
    try:
        top = _spans(text)
        idx, _node = _member(top, "outputStyle")
        start, end = _cut(top["c"], idx)
        new = text[:start] + text[end:]
        want = {k: v for k, v in data.items() if k != "outputStyle"}
        if json.loads(new) != want:
            raise RuntimeError("the character-level edit did not reproduce the intended settings")
        _atomic_write(os.path.realpath(spath), new, text)
        back, _t, _e = _load_strict(spath)
        if not isinstance(back, dict) or "outputStyle" in back:
            raise RuntimeError(f"re-read of {spath} still selects an output style")
    except (OSError, ValueError, RuntimeError) as exc:
        print(f"  ! outputStyle {value!r} NOT cleared from {spath}: {exc.__class__.__name__}: {exc}")
        return 1
    # THE KEY IS GONE FROM HERE ON, so a failure below is a removal nobody recorded, never "NOT
    # cleared". One except branch used to cover both halves, and a full disk on the record
    # printed "NOT cleared" for a key the re-read had just proven removed (review of the 1.63.0
    # fix batch, finding 3). Said the way `_heal_one` says it.
    try:
        rec, rtext, rerr = (_load_strict(owned_path) if os.path.lexists(owned_path)
                            else ({}, "", None))
        if rerr or not isinstance(rec, dict):
            raise ValueError(f"{owned_path} is not a JSON object: {rerr}")
        if not isinstance(rec.get("output_style_cleared"), list):
            rec["output_style_cleared"] = []
        rec["output_style_cleared"].append({
            "settings": spath, "previous": value,
            "reason": f"retired by workforce — {RETIRED_OUTPUT_STYLES[value]} is on no "
                      f"output-styles path"})
        os.makedirs(os.path.dirname(owned_path), exist_ok=True)
        _atomic_write(owned_path, _render(rec, rtext or "{\n  }\n"))
    except (OSError, ValueError, RuntimeError) as exc:
        print(f"  ! outputStyle {value!r} REMOVED from {spath} but the record could not be written "
              f"to {owned_path} — {exc.__class__.__name__}: {exc}. The previous value was {value!r}")
        return 1
    print(f"  - outputStyle {value!r} cleared from {spath} (a style workforce retired; no file "
          f"for it remains) — recorded in {owned_path} § output_style_cleared")
    return 0


def known_roots(root):
    """Every personal config root this machine can name for the project: the running one,
    the default `~/.claude`, and every install the project's own rows point into.

    A per-session row sits in a SHARED file and resolves to a different install for each
    account, so "retired" is only true for it when no install anyone here can name still
    ships the script (second review, N4). Accounts this machine cannot name are the stated
    limit, in `hooks.md` § Healing."""
    roots = {config_root(), os.path.join(os.path.expanduser("~"), ".claude")}
    # AT USER SCOPE THERE IS NO PROJECT, and `""` joined to `.claude` is the CURRENT
    # directory's, a tree nobody named (review 3, L4).
    for n in (PROJECT_SETTINGS if root else ()):
        data, _text, _err = _load_strict(os.path.join(root, ".claude", n))
        for _ev, _mt, h in _command_rows(data):
            wh = CENSUS.workforce_hook(h.get("command"), root)
            if wh is not None and wh["form"] != "session":
                roots.add(wh["cfg"])
    # ONLY A COMPLETE INSTALL IS EVIDENCE. An abandoned `~/.claude` holding one stale
    # script, or a directory some row happens to name, kept a dead row forever and made
    # "update that install" a remedy with nothing to update (review 3, L4).
    return {r for r in roots if _complete_install(r)}


def _complete_install(cfg):
    """Does `cfg` hold every currently shipped hook script? The one completeness test,
    for the install a row points into and for every root that could keep a row live."""
    return all(os.path.isfile(os.path.join(cfg, "skills", "workforce", "bin", s))
               for s in CURRENT_HOOK_SCRIPTS)


def dead_row_verdict(h, root):
    """What a missing workforce row IS, decided by the distribution. `(verdict, wh)`.

    THE ONE RULE FOR REMOVING A WORKFORCE ROW. The heal, the user-scope prune and
    `wf-apply`'s PASS-DEAD-HOOK all remove a workforce row only on "retired", and
    wf-conform prints VERDICT_REMEDY for the verdict, so the remedy printed is always
    what happens. PASS-DEAD-HOOK once removed whatever the census called missing and
    deleted a live shipped hook on every audit (second review, N1).

      None       not a command row the shared resolver recognises, or its script is on
                 disk (live rows are never this function's business)
      retired    REMOVABLE: the name is in RETIRED_HOOKS, the file is missing, the
                 install it points into holds every CURRENT_HOOK_SCRIPTS file, and — for
                 a per-session row — no install this machine can name still ships it
      shipped    a name this release ships, file missing: a broken or half-synced
                 install. Never removed — the hook is live, the install is not
      unknown    a name this release neither ships nor retired
      skew       a retired name in a per-session row that another known install still
                 ships, so the row is live for that account
      install    a retired name, but the install is absent or incomplete, so the
                 missing file proves nothing

    The type/args guard: an exec-form row (`args`) or any non-command type runs
    something other than the path this reads, so it is not decidable here.
    """
    if not isinstance(h, dict) or h.get("type", "command") != "command" or "args" in h:
        return None, None
    wh = CENSUS.workforce_hook(h.get("command"), root)
    if wh is None or wh["exists"]:
        return None, wh
    here = os.path.dirname(os.path.abspath(__file__))
    if wh["script"] in CURRENT_HOOK_SCRIPTS or os.path.exists(os.path.join(here, wh["script"])):
        return "shipped", wh
    if wh["script"] not in RETIRED_HOOKS:
        return "unknown", wh
    if wh["form"] == "session" and any(
            os.path.exists(os.path.join(r, "skills", "workforce", "bin", wh["script"]))
            for r in known_roots(root)):
        return "skew", wh
    if not _complete_install(wh["cfg"]):
        return "install", wh
    return "retired", wh


# What each verdict means for the person reading `verify`. Stated beside the classifier
# so the remedy is true by construction; wf-conform prints these and composes none.
VERDICT_REMEDY = {
    "retired": ("a hook this distribution retired. `wf-settings-apply --root <tree> --heal "
                "--execute` removes it and records it in .settings-owned.json § "
                "hooks_removed. Every session start runs the same heal, so a row still here "
                "means the heal refused this project; run that command to see the reason"),
    "shipped": ("a hook this release still SHIPS, and its script is missing from the "
                "install the row points into: that install is broken, absent or mid-update. "
                "Re-run the installer for that config root. Nothing in workforce removes "
                "this row — the heal and PASS-DEAD-HOOK both leave a shipped hook alone"),
    "install": ("a retired hook, but the install the row points into is absent or "
                "incomplete, so the missing file proves nothing about it. If that install "
                "is gone for good, delete the row by hand"),
    "unknown": ("a script this release neither ships nor retired, most likely from a "
                "newer release. Update the install that runs here; nothing removes it"),
    "skew": ("a retired hook in a per-session row, and another COMPLETE workforce install "
             "on this machine still holds the script, so the row is live for that account. "
             "Updating that install removes the script (the installer prunes what the "
             "manifest no longer ships); the next heal then removes the row"),
}


def _load_strict(path):
    """`(data, text, err)`. A DUPLICATE KEY IS AN ERROR: the harness keeps one of the
    two, and a rewrite would silently drop the other, so such a file is never written."""
    # newline="": the text is the file's exact characters, CRLF included, so a file is
    # never rewritten with different line endings (review 3, L2).
    try:
        with open(path, encoding="utf-8", newline="") as fh:
            text = fh.read()
    except (OSError, UnicodeDecodeError) as exc:
        return None, None, f"{exc.__class__.__name__}: {getattr(exc, 'strerror', None) or exc}"

    def pairs(kv):
        d = {}
        for k, v in kv:
            if k in d:
                raise ValueError(f"duplicate key {k!r}")
            d[k] = v
        return d
    try:
        return json.loads(text, object_pairs_hook=pairs), text, None
    except ValueError as exc:
        return None, text, str(exc)


def _command_rows(data):
    """`(event, matcher, hook)` for every inner hook of a settings object."""
    hooks = data.get("hooks") if isinstance(data, dict) else None
    for event, entries in (hooks.items() if isinstance(hooks, dict) else ()):
        for e in (entries if isinstance(entries, list) else ()):
            inner = e.get("hooks") if isinstance(e, dict) else None
            for h in (inner if isinstance(inner, list) else ()):
                yield event, e.get("matcher"), h


def _render(data, original):
    """Serialise the reversal RECORD in its own style. Settings files never come through
    here: they are edited by `_strip_rows`, character by character."""
    m = re.search(r"^([ \t]+)\S", original or "", re.M)
    text = json.dumps(data, indent=m.group(1) if m else 2, ensure_ascii=False)
    return text + ("\n" if (original or "\n").endswith("\n") else "")


def _spans(text):
    """Parse JSON text into nodes that carry their character offsets, so a row can be cut
    out without re-serialising anything around it. Raises ValueError on anything that
    is not strict JSON. Node: {"k": "{" | "[" | "v", "s": start, "e": end, "c": kids},
    each kid `(key or None, start of the key or value, node)`."""
    n = len(text)

    def ws(i):
        while i < n and text[i] in " \t\r\n":
            i += 1
        return i

    def string(i):
        if i >= n or text[i] != '"':
            raise ValueError(f"string expected at {i}")
        j = i + 1
        while j < n and text[j] != '"':
            j += 2 if text[j] == "\\" else 1
        if j >= n:
            raise ValueError("unterminated string")
        return json.loads(text[i:j + 1]), j + 1

    def value(i):
        i = ws(i)
        if i >= n:
            raise ValueError("unexpected end")
        if text[i] in "{[":
            return container(i)
        if text[i] == '"':
            end = string(i)[1]
            return {"k": "v", "s": i, "e": end}, end
        j = i
        while j < n and text[j] not in ",]} \t\r\n":
            j += 1
        json.loads(text[i:j])
        return {"k": "v", "s": i, "e": j}, j

    def container(i):
        kind, close, kids = text[i], "}" if text[i] == "{" else "]", []
        j = ws(i + 1)
        if j < n and text[j] == close:
            return {"k": kind, "s": i, "e": j + 1, "c": kids}, j + 1
        while True:
            if kind == "{":
                ks = ws(j)
                key, j = string(ks)
                j = ws(j)
                if j >= n or text[j] != ":":
                    raise ValueError(f"':' expected at {j}")
                v, j = value(j + 1)
                kids.append((key, ks, v))
            else:
                v, j = value(j)
                kids.append((None, v["s"], v))
            j = ws(j)
            if j < n and text[j] == ",":
                j += 1
                continue
            if j < n and text[j] == close:
                return {"k": kind, "s": i, "e": j + 1, "c": kids}, j + 1
            raise ValueError(f"',' or '{close}' expected at {j}")

    node, end = value(0)
    if ws(end) != n:
        raise ValueError("trailing data")
    return node


def _cut(kids, k):
    """The characters to delete to remove kid `k`: it and the separator on one side."""
    if k + 1 < len(kids):
        return kids[k][1], kids[k + 1][1]
    if k > 0:
        return kids[k - 1][2]["e"], kids[k][2]["e"]
    return kids[k][1], kids[k][2]["e"]


def _member(node, key):
    for idx, (k, _s, v) in enumerate(node.get("c", ()) if node["k"] == "{" else ()):
        if k == key:
            return idx, v
    return None, None


def _next_cut(text, root):
    """The span to delete for the first retired row in `text`, or None. Removing a row
    that empties its entry removes the entry; an emptied event goes, and an emptied
    `hooks` object goes — the same shape `_without` produces, and verified against it."""
    top = _spans(text)
    hi, hooks = _member(top, "hooks")
    if hooks is None or hooks["k"] != "{":
        return None
    for ei, (_ev, _s, arr) in enumerate(hooks["c"]):
        for ni, (_n, _s2, entry) in enumerate(arr["c"] if arr["k"] == "[" else ()):
            _ii, inner = _member(entry, "hooks") if entry["k"] == "{" else (None, None)
            for hj, (_h, _s3, hn) in enumerate(inner["c"] if inner and inner["k"] == "[" else ()):
                if dead_row_verdict(json.loads(text[hn["s"]:hn["e"]]), root)[0] != "retired":
                    continue
                if len(inner["c"]) > 1:
                    return _cut(inner["c"], hj)
                if len(arr["c"]) > 1:
                    return _cut(arr["c"], ni)
                if len(hooks["c"]) > 1:
                    return _cut(hooks["c"], ei)
                return _cut(top["c"], hi)
    return None


def _strip_rows(text, root):
    """`text` minus the retired rows' characters and NOTHING else — every other byte of a
    file the user owns stays as it was (second review, #10: a re-serialise expanded the
    user's compact `{"allow": [...]}`). The result must parse to exactly what `_without`
    computes from the same file, or nothing is written."""
    out = text
    for _ in range(10000):
        span = _next_cut(out, root)
        if span is None:
            break
        out = out[:span[0]] + out[span[1]:]
    data = json.loads(text)
    want = _without(data, {id(h) for _e, _m, h in _command_rows(data)
                           if dead_row_verdict(h, root)[0] == "retired"})
    if json.loads(out) != want:
        raise RuntimeError("the character-level edit did not reproduce the intended "
                           "settings; nothing was written")
    return out


def _atomic_write(real, text, before=None):
    """Replace `real`'s content. Returns a note when the write had to be made in place.

    Temp file plus rename in `real`'s own directory, never a truncate in place — EXCEPT
    when the file has other hard links or another owner: a rename would split the links
    (the other name keeping the old row) or hand the file to this user. Those are written
    in place, under the caller's lock and after the re-check below, and said so.
    `before` is the text this run read: when the file no longer holds it, another writer
    got there first and the write is abandoned.
    """
    import stat
    import tempfile
    if before is not None:
        with open(real, encoding="utf-8", newline="") as fh:
            stale = fh.read() != before
        if stale:
            raise RuntimeError(f"{real} changed while it was being healed; left alone")
        if not os.access(real, os.W_OK):
            raise PermissionError(13, "the file is not writable", real)
    st = os.stat(real) if os.path.exists(real) else None
    if st is not None and (st.st_nlink > 1 or (hasattr(os, "getuid") and st.st_uid != os.getuid())):
        # BYTES, not text: no newline translation exists to go wrong on any OS (review 3,
        # L2 — text mode turned CRLF into LF here, and would do the reverse on Windows).
        with open(real, "r+b") as fh:
            fh.write(text.encode("utf-8"))
            fh.truncate()
        return (f"{real} written in place: it has {st.st_nlink} hard link(s) and owner "
                f"uid {st.st_uid}, which a rename would break")
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(real), prefix=".wf-heal.")
    try:
        with os.fdopen(fd, "wb") as fh:
            fh.write(text.encode("utf-8"))
        os.chmod(tmp, stat.S_IMODE(st.st_mode) if st else 0o644)
        os.replace(tmp, real)
    except BaseException:
        if os.path.exists(tmp):
            os.unlink(tmp)
        raise
    return None


# THE LONGEST A SESSION START WAITS FOR ANOTHER HEAL, in seconds. MEASURED 2026-09-14: one
# heal holds the lock for 9 to 29 ms (ten runs of the sa-heal-execute tree: fresh read,
# edit, write, re-read, record) on a local disk, so eight session starts opening at once in one project finish inside a
# quarter of a second. One second covers that with room, and it is short enough that a
# stuck holder costs the user one second once — after which the rows are left for the
# holder or the next session, and the count left is reported.
LOCK_WAIT_S = 1.0
# flock(2) errors that mean "this filesystem cannot lock here" rather than "somebody holds
# it" — NFS refuses LOCK_EX on a read-only descriptor, and a directory cannot be opened
# for writing. The heal then runs unlocked; `_atomic_write`'s content re-check still
# abandons a write whose file changed underneath it.
LOCK_UNSUPPORTED = {errno.EBADF, errno.ENOLCK, errno.EOPNOTSUPP, errno.EINVAL}


class _Lock:
    """An exclusive flock on a DIRECTORY, so concurrent session starts in one project heal
    one at a time and the second finds nothing left to remove. MEASURED before it: 19 of
    40 concurrent starts appended duplicate `hooks_removed` records. Taken only when there
    is something to remove. Falls back to no lock where the filesystem cannot give one
    (LOCK_UNSUPPORTED) or flock does not exist (Windows)."""

    def __init__(self, dirpath):
        self.dirpath, self.fd, self.unlocked = dirpath, None, None

    def __enter__(self):
        try:
            import fcntl
        except ImportError:
            self.unlocked = "no flock on this platform"
            return self
        import time
        self.fd = os.open(self.dirpath, os.O_RDONLY)
        deadline = time.monotonic() + LOCK_WAIT_S
        while True:
            try:
                fcntl.flock(self.fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                return self
            except BlockingIOError:
                if time.monotonic() >= deadline:
                    break
                time.sleep(0.05)
            except OSError as exc:
                if exc.errno not in LOCK_UNSUPPORTED:
                    raise
                self.unlocked = f"this filesystem cannot lock ({errno.errorcode.get(exc.errno)})"
                os.close(self.fd)
                self.fd = None
                return self
        os.close(self.fd)
        self.fd = None
        raise TimeoutError(f"another heal held {self.dirpath} for {LOCK_WAIT_S:g} s")

    def __exit__(self, *exc):
        if self.fd is not None:
            os.close(self.fd)
        return False


def _record_refusal(owned_path, expect_dir):
    """Why the reversal record must not be written, or None. Checked BEFORE anything is
    removed, so no removal can ever go unrecorded (second review, N8).

    A SYMLINK IS NEVER WRITTEN THROUGH (CWE-59): a repository shipping
    `.settings-owned.json -> ~/.bashrc` would otherwise have that target replaced with
    JSON at the next session start. A record that is not a JSON object is never
    replaced — it is the only thing `disband` can replay. And a record that cannot be
    written means the removal could not be recorded, so nothing is removed.
    """
    side_dir = os.path.dirname(owned_path)
    # `expect_dir` is the resolved parent plus the literal name, so a link AT that name
    # shows up here as a difference instead of being resolved on both sides.
    if os.path.lexists(side_dir) and os.path.realpath(side_dir) != expect_dir:
        return f"{side_dir} resolves outside the project; the record is never written through a link"
    if os.path.islink(owned_path):
        return f"{owned_path} is a symlink; the record is never written through one"
    if os.path.lexists(owned_path):
        data, _text, err = _load_strict(owned_path)
        if err or not isinstance(data, dict):
            return (f"{owned_path} is not a JSON object ({err or 'wrong type'}); rewriting "
                    f"it would destroy the record disband replays, so nothing is written")
        if not os.access(owned_path, os.W_OK):
            return f"{owned_path} is not writable, so a removal could not be recorded"
    probe = side_dir if os.path.isdir(side_dir) else os.path.dirname(side_dir)
    if not os.access(probe, os.W_OK):
        return f"{probe} is not writable, so a removal could not be recorded"
    return None


def _inside_project(root, path):
    """Does `path` resolve INSIDE the project? The one test every write the heal makes
    passes — settings files, the reversal record, the notice. A link anywhere on the way
    (`.claude` itself included) is followed to where the write would really land."""
    here, real = os.path.realpath(root), os.path.realpath(path)
    return real == here or real.startswith(here + os.sep)


def write_refusal(root, path):
    """Why a shipped script must not write `path` for the project at `root`, or None.

    THE ONE CWE-59 TEST FOR A PROJECT FILE ANY SHIPPED SCRIPT WRITES. `wf-stamp --floor` and
    `wf-code-eval --active on` / `--stamp` import it, so the refusal below cannot drift
    between writers. Before this they wrote through whatever the name resolved to: a
    `length-floors.md` linked out of the project got a row appended to the outside file, and
    a linked `.code-eval-active` truncated its target to 0 B (review of the 1.63.0 fix batch,
    finding 1). Three refusals, none of them a list:
      - the name is a symlink, which is never written through, even to a target inside;
      - the path resolves outside the project, through a link anywhere on the way;
      - the file has a second hard link, a name that may live anywhere (`_file_refusal`).
    """
    if os.path.islink(path):
        return f"{path} is a symlink; a write is never made through one"
    if not _inside_project(root, path):
        return (f"{path} resolves outside the project ({os.path.realpath(path)}); a shipped "
                f"script only writes inside its tree")
    try:
        links = os.stat(path).st_nlink if os.path.exists(path) else 1
    except OSError:
        links = 1
    if links > 1:
        return f"{path} has {links} hard links, and the other names may live outside the project"
    return None


def _project_refusal(root, owned_path):
    """Why NOTHING in this project may be written, or None: its `.claude` is a personal
    config root (the project is $HOME, or CLAUDE_CONFIG_DIR points at it) or resolves
    outside the project, or the one reversal record every removal needs cannot be written
    safely."""
    claude = os.path.realpath(os.path.join(root, ".claude"))
    # A `.claude` THAT IS A LINK OUT OF THE PROJECT: the record, the notice and every
    # settings file would land outside it (last review, 1: the notice was written into
    # the link's target).
    if not _inside_project(root, os.path.join(root, ".claude")):
        return (f"{os.path.join(root, '.claude')} resolves outside the project ({claude}); a "
                f"project heal only writes inside its tree")
    home_root = os.path.join(os.path.expanduser("~"), ".claude")
    if claude in {os.path.realpath(config_root()), os.path.realpath(home_root)}:
        return (f"{claude} is a personal config root (the project is $HOME), so its "
                f"settings.json is user scope, which the heal never writes")
    return _record_refusal(owned_path, os.path.join(claude, "workforce"))


def _file_refusal(root, p):
    """Why THIS settings file may not be written, or None. Per file, so one link out of the
    tree no longer blocks the file beside it (final review, F2: a settings.json linked
    into a dotfiles repo left the in-tree settings.local.json's retired row in place)."""
    if not os.path.lexists(p):
        return None
    real = os.path.realpath(p)
    # A SECOND HARD LINK IS A NAME SOMEWHERE ELSE. The heal cannot know where, so it treats
    # the file as it treats a symlink out: refused and counted. It used to edit in place,
    # and a copy outside the project lost its row too (last review, 2).
    try:
        links = os.stat(real).st_nlink
    except OSError:
        links = 1
    if links > 1:
        return (f"it has {links} hard links, and the other names may live outside the "
                f"project, where the heal never writes")
    home_root = os.path.join(os.path.expanduser("~"), ".claude")
    users = {os.path.realpath(os.path.join(config_root(), "settings.json")),
             os.path.realpath(os.path.join(home_root, "settings.json"))}
    if real in users:
        return f"it resolves to the user-scope file {real}, which the heal never writes"
    # THE GENERAL RULE (review 3, L7): a project heals only files that live inside the
    # project. A link out of the tree points at another account's settings, a dotfiles
    # checkout or another project, none of which this heal was asked about — naming every
    # user settings file on the machine is a list that is never complete, and "inside the
    # project" needs no list.
    here = os.path.realpath(root)
    if real != here and not real.startswith(here + os.sep):
        return f"it resolves outside the project ({real}); a project heal only writes inside its tree"
    return None


def _retired_rows(data, root):
    """`[(event, matcher, h, wh, verdict)]` for every missing workforce row, retired or not."""
    out = []
    for event, matcher, h in _command_rows(data):
        verdict, wh = dead_row_verdict(h, root)
        if verdict:
            out.append((event, matcher, h, wh, verdict))
    return out


def _without(data, doomed):
    """`data` minus the inner hooks whose id() is in `doomed`. An entry that held the
    user's hooks beside ours keeps them; only an entry this removal emptied goes."""
    hooks = data["hooks"]
    for event in list(hooks):
        entries = hooks[event]
        if not isinstance(entries, list):
            continue
        keep = []
        for e in entries:
            inner = e.get("hooks") if isinstance(e, dict) else None
            if isinstance(inner, list) and any(id(h) in doomed for h in inner):
                left = [h for h in inner if id(h) not in doomed]
                if not left:
                    continue
                e = dict(e, hooks=left)
            keep.append(e)
        if keep:
            hooks[event] = keep
        else:
            hooks.pop(event)
    if not hooks:
        data.pop("hooks")
    return data


def _record(owned_path, recs, root):
    """Append the removals to the reversal record, AFTER the settings file is verified.

    The order is the fix for a measured defect: the record was written first, so a
    settings file that could not be written (read-only) left `hooks_removed` growing by
    the same rows at every session start. The record's writability is checked before
    anything is removed (`_record_refusal`), so what is left is a crash or a full disk
    between the two, which the caller reports as an unrecorded removal.
    """
    data, text, err = _load_strict(owned_path) if os.path.lexists(owned_path) else ({}, "", None)
    if err or not isinstance(data, dict):
        raise ValueError(f"{owned_path} stopped parsing as a JSON object: {err}")
    added = data.get("hooks_added") if isinstance(data.get("hooks_added"), list) else []
    data["hooks_added"] = [
        r for r in added
        if not (isinstance(r, dict) and any(
            r.get("event") == x["event"] and r.get("matcher") == x["matcher"]
            and _same_command({"command": r.get("command")}, x["command"], root) for x in recs))]
    if not isinstance(data.get("hooks_removed"), list):
        data["hooks_removed"] = []
    data["hooks_removed"].extend(recs)
    os.makedirs(os.path.dirname(owned_path), exist_ok=True)
    _atomic_write(owned_path, _render(data, text or "{\n  }\n"))


def _scan(spath, root, out):
    """Read one settings file and classify it. Returns `(text, recs)` or None."""
    if not os.path.lexists(spath):
        return None
    data, text, err = _load_strict(spath)
    rel = os.path.relpath(spath, root) if root else spath
    if err or not isinstance(data, dict):
        out["skipped"].append(f"{spath}: {err or 'not a JSON object'} — not written")
        # Kept apart so a session start can SAY it once per file state: a BOM or a comment
        # makes the file unreadable here, and silence meant a retired row in it stayed
        # forever with nothing ever mentioning why (review 3, L8).
        out["unparsed"].append({"settings": rel, "cause": f"{rel} is not strict JSON "
                                f"({err or 'not a JSON object'}), so the heal cannot read it"})
        return None
    rows = _retired_rows(data, root)
    recs = [{"event": ev, "matcher": mt, "command": h.get("command"), "settings": rel,
             "hook": dict(h), "script": wh["script"],
             "reason": f"retired — {wh['path']} is not on disk"}
            for ev, mt, h, wh, v in rows if v == "retired"]
    return text, recs, [(spath, r) for r in rows if r[4] != "retired"]


def _heal_one(spath, root, owned_path, out, progress):
    """Under the lock: re-read, cut the retired rows out, write, verify, then record."""
    scanned = _scan(spath, root, {"skipped": []})
    if not scanned or not scanned[1]:
        return
    text, recs, _kept = scanned
    note = _atomic_write(os.path.realpath(spath), _strip_rows(text, root), text)
    if progress is not None:
        progress["wrote"].append(spath)
    if note:
        out["notes"].append(note)
    back, _t, _e = _load_strict(spath)
    if any(r[4] == "retired" for r in _retired_rows(back or {}, root)):
        raise RuntimeError(f"re-read of {spath} still holds a retired row")
    out["removed"] += recs
    try:
        _record(owned_path, recs, root)
    except (OSError, ValueError) as exc:
        out["rc"] = 1
        out["failures"].append({"settings": recs[0]["settings"], "unrecorded": True,
                                "cause": f"{len(recs)} row(s) REMOVED from {spath} but the "
                                         f"record could not be written — {exc}"})
        return
    if progress is not None:
        progress["wrote"].append(owned_path)


def _run_heal(out, files, root, owned_path, lock_dir, execute, progress):
    """Classify without a lock; lock and apply only when something is retired. Every
    failure is reported per file into `out`, never raised: a caller at session start or
    ahead of the installer's wiring must go on."""
    pending = []
    for spath in files:
        scanned = _scan(spath, root, out)
        if scanned is None:
            continue
        out["files"] += 1
        out["kept"] += scanned[2]
        if scanned[1]:
            pending.append((spath, scanned[1]))
    if not execute:
        out["removed"] = [r for _p, recs in pending for r in recs]
        return
    if not pending:
        return
    try:
        with _Lock(lock_dir) as lk:
            if lk.unlocked:
                out["notes"].append(f"healed without a lock: {lk.unlocked}")
            for spath, recs in pending:
                try:
                    _heal_one(spath, root, owned_path, out, progress)
                except (OSError, ValueError, RuntimeError) as exc:
                    out["rc"] = 1
                    out["failures"].append({
                        "settings": recs[0]["settings"],
                        "cause": f"{len(recs)} retired row(s) still in {spath} — "
                                 f"{exc.__class__.__name__}: {exc}"})
    except (OSError, TimeoutError) as exc:
        out["rc"] = 1
        n = sum(len(recs) for _p, recs in pending)
        out["failures"].append({"settings": pending[0][1][0]["settings"], "lock": True,
                                "cause": f"{n} retired row(s) left for another session — "
                                         f"{exc.__class__.__name__}: {exc}"})


def _new_result():
    return {"rc": 0, "removed": [], "kept": [], "skipped": [], "files": 0, "refused": None,
            "failures": [], "notes": [], "unparsed": [], "refused_rows": [], "refusals": []}


def _print_result(out, execute, quiet):
    """Every count, including the zeroes, unless `quiet` and there is nothing to say."""
    for r in out["removed"]:
        print(f"  {'-' if execute else '~'} {r['event']}  {r['matcher'] or '(no matcher)'}  "
              f"{r['script']}  {r['reason']}")
    for _spath, (ev, _mt, _h, wh, verdict) in out["kept"]:
        print(f"  . kept  {ev}  {wh['script']}  {verdict} — {VERDICT_REMEDY[verdict]}")
    for s in out["skipped"] + out["notes"]:
        print(f"  . {s}")
    for f in out["failures"]:
        print(f"  NOT HEALED — {f['cause']}")
    if out["refused"]:
        print(f"  REFUSED  {out['refused']}")
    for f in out["refusals"]:
        print(f"  REFUSED  {f['cause']}")
    if (not quiet or out["removed"] or out["kept"] or out["refused"] or out["failures"]
            or out["refusals"]):
        print(f"  {len(out['removed'])} {'removed' if execute else 'to remove'} · "
              f"{len(out['kept'])} kept · {len(out['refused_rows'])} refused · "
              f"{out['files']} settings file(s) read")
    if execute and out["removed"]:
        print(f"  verified on disk: {len(out['removed'])} registration(s) gone"
              + ("" if any(f.get("unrecorded") for f in out["failures"])
                 else ", then recorded in .settings-owned.json § hooks_removed"))


def heal(root, execute, quiet=False, progress=None):
    """Remove the project's workforce hook rows whose script the distribution RETIRED.

    WHY IT EXISTS. A registration outlives its script, and the only remover was
    `--wire-defaults`, which cleans the ONE file its scope resolves: `update` at personal
    scope never touched a project, and `verify` only reported. MEASURED 2026-09-14: the
    census counted 38 dead rows across six projects on one workstation, from two config
    roots, each failing on every prompt and tool call.

    THREE CALLERS, ONE RULE: `wf-commitments` at SessionStart (every project, first
    use), `--heal` (`verify` § Hook wiring), and `--wire-defaults` (installer, `audit`).
    `wf-apply`'s PASS-DEAD-HOOK decides workforce rows through the same verdict.

    WHAT IT NEVER DOES, each enforced below and each pinned by a fixture:
      - remove a row the verdict does not call "retired" (`dead_row_verdict`);
      - delete a LIVE row, even a double-firing one: redundancy for every account and
        machine that reads a shared file cannot be proven from one of them;
      - write a user-scope settings file, write through a symlinked record, replace a
        malformed or unwritable record, or write a settings file that does not parse as
        a JSON object or carries duplicate keys (`_project_refusal`, `_file_refusal` —
        a file-level refusal skips that file only, and every refusal that leaves retired
        rows is counted and announced);
      - take the lock when nothing is retired, or block longer than LOCK_WAIT_S;
      - change any byte of a settings file but the removed rows' (`_strip_rows`);
      - record a removal before the settings file is written and re-read.
    A project with no `.claude` has nothing to heal: silent, rc 0.
    """
    out = _new_result()
    if not os.path.isdir(os.path.join(root, ".claude")):
        return out
    owned_path = os.path.join(root, OWNED_REL)
    out["refused"] = _project_refusal(root, owned_path)
    files, blocked = [], []
    for n in PROJECT_SETTINGS:
        p = os.path.join(root, ".claude", n)
        why = _file_refusal(root, p)
        (blocked if why else files).append((p, why))
    # A REFUSAL STILL COUNTS WHAT IT LEAVES. The rows a refused file (or a refused
    # project) holds are read, never written, so the summary and the session-start notice
    # can say how many retired rows stay and why (final review, F2).
    probe = _new_result()
    _run_heal(probe, [p for p, _w in blocked] + ([p for p, _w in files] if out["refused"] else []),
              root, owned_path, "", False, None)
    for k in ("kept", "skipped", "unparsed"):
        out[k] += probe[k]
    out["files"] += probe["files"]
    for r in probe["removed"]:
        why = next((w for p, w in blocked if os.path.relpath(p, root) == r["settings"]), None)
        out["refused_rows"].append(dict(r, why=why or out["refused"]))
    for rel in sorted({r["settings"] for r in out["refused_rows"]}):
        rows = [r for r in out["refused_rows"] if r["settings"] == rel]
        out["refusals"].append({"settings": rel, "cause": f"{rel}: {rows[0]['why']}; "
                                f"{len(rows)} retired row(s) left in it"})
    if not out["refused"]:
        _run_heal(out, [p for p, _w in files], root, owned_path,
                  os.path.realpath(os.path.join(root, ".claude")), execute, progress)
    _print_result(out, execute and not out["refused"], quiet)
    return out


def failure_state(root, rel):
    """A key for one settings file's CURRENT state — path, bytes and mode — so a failure
    that nothing has changed is announced once, not at every session start (second
    review, #4). Relative path, so the key survives the tree being copied or moved."""
    import hashlib
    p = os.path.join(root, rel)
    try:
        with open(p, "rb") as fh:
            body = fh.read()
        mode = oct(os.stat(p).st_mode & 0o7777)
    except OSError:
        body, mode = b"", "absent"
    return hashlib.sha256(rel.encode() + b"\0" + body + b"\0" + mode.encode()).hexdigest()


NOTICE_REL = os.path.join(".claude", "workforce", ".heal-notice")


def announce_once(root, failures):
    """True when at least one failure is in a state not announced before, and remember
    it. The notice lives beside the reversal record and is written by the same rules:
    never through a link, and its absence only means the message repeats."""
    keys = {failure_state(root, f["settings"]) for f in failures}
    path = os.path.join(root, NOTICE_REL)
    # OUTSIDE THE PROJECT, NOTHING IS WRITTEN (last review, 1). A `.claude` linked out would
    # carry the notice into the link's target, so there is no notice file: the message is
    # said at every session start while the state lasts, which writes nothing anywhere.
    if not _inside_project(root, os.path.dirname(path)):
        return True
    # AN UNREADABLE NOTICE IS AN ABSENT ONE. A non-UTF-8 file here raised out of the
    # SessionStart hook and took the commitment ledger's read-back with it (review 3, L1).
    try:
        with open(path, encoding="utf-8") as fh:
            seen = set(fh.read().split())
    except (OSError, UnicodeDecodeError, ValueError):
        seen = set()
    if keys <= seen:
        return False
    try:
        if not (os.path.islink(path) or os.path.islink(os.path.dirname(path))):
            os.makedirs(os.path.dirname(path), exist_ok=True)
            _atomic_write(path, "\n".join(sorted(keys)) + "\n")
    except OSError:
        pass
    return True


def clear_notice(root):
    """Remove the notice once nothing is failing, so it is never residue (review 3, L6).
    Never through a link, like every other write here."""
    path = os.path.join(root, NOTICE_REL)
    if not _inside_project(root, os.path.dirname(path)):
        return
    if os.path.isfile(path) and not os.path.islink(path) \
            and not os.path.islink(os.path.dirname(path)):
        try:
            os.remove(path)
        except OSError:
            pass


def do_heal(root, execute):
    """`--heal`: the CLI face of `heal`, printing every count including the zeroes."""
    if not os.path.isdir(os.path.join(root, ".claude")):
        print(f"HEAL   {os.path.join(root, '.claude')} is absent — nothing to heal")
        return 0
    print(f"HEAL   {os.path.join(root, '.claude')}          <- resolved, not assumed")
    rc = heal(root, execute)["rc"]
    if not execute:
        print("  apply with: --execute")
    return rc


def do_unwire_defaults(root, scope, execute):
    """Reverse exactly what `--wire-defaults` wrote, and nothing else.

    WHY THIS EXISTS. `--wire-defaults` recorded every registration in
    `.settings-owned.json` and set `output_style_previous` -- and NOTHING READ EITHER.
    `hooks.md` § Unwiring describes an agent reading the sidecar and editing the
    settings by hand, which covers the hooks and never mentioned the style at all. So
    the record was the right shape with no reader, which is this project's own
    "a flag is not a fix" wearing a different hat: a reversal you cannot execute is a
    reversal you do not have. Found 2026-09-07 when a peer session flagged the
    user-scope write as reaching every session on the machine and called the record
    sound. The record was sound. Nothing could run it.

    EXACTNESS IS THE WHOLE CONTRACT. A registration is removed only when its event,
    matcher AND command all match a recorded row, so a hook the user wired themselves
    with the same command but a different matcher survives. The style is restored to
    `output_style_previous` -- which may be None, and None means the key was absent
    before and is DELETED rather than set to a default this script invented.

    AN ABSENT SIDECAR MEANS WORKFORCE OWNS NOTHING HERE. Remove nothing and say so,
    exactly as `hooks.md` § Unwiring requires."""
    spath = settings_for_scope(root, scope)
    owned_path, owned = load_owned(root, scope)
    print(f"UNWIRE {spath}          <- resolved, not assumed")
    print(f"  record: {owned_path}")

    recorded = owned.get("hooks_added") or []
    has_style = "output_style_set" in owned
    if not recorded and not has_style:
        print("  . the record names nothing — workforce owns no setting here. "
              "Removing nothing.")
        return 0

    data, err = load(spath)
    if err:
        print(f"wf-settings-apply: {err}", file=sys.stderr)
        return 1
    if not isinstance(data, dict):
        print(f"  . {spath} holds no object — nothing to remove.")
        return 0

    removed, absent = [], []
    hooks = data.get("hooks")
    for row in recorded:
        if not isinstance(row, dict):
            continue
        event, matcher, command = row.get("event"), row.get("matcher"), row.get("command")
        entries = hooks.get(event) if isinstance(hooks, dict) else None
        if not isinstance(entries, list):
            absent.append(f"{event}:{command}")
            continue
        keep, hit = [], False
        for e in entries:
            if not isinstance(e, dict):
                keep.append(e)
                continue
            if e.get("matcher") != matcher:
                keep.append(e)
                continue
            inner = [h for h in (e.get("hooks") or [])
                     if not _same_command(h, command, root)]
            if len(inner) == len(e.get("hooks") or []):
                keep.append(e)
                continue
            hit = True
            # An entry that held OTHER hooks keeps them; only an entry emptied by this
            # removal goes. Dropping a whole entry to remove one command would take a
            # registration the user added beside ours.
            if inner:
                e = dict(e, hooks=inner)
                keep.append(e)
        if hit:
            removed.append(f"{event}:{os.path.basename(command.strip(chr(34)))}")
            if execute:
                if keep:
                    hooks[event] = keep
                else:
                    hooks.pop(event, None)
        else:
            absent.append(f"{event}:{os.path.basename(command.strip(chr(34)))}")

    prev = owned.get("output_style_previous")
    style_now = data.get("outputStyle")
    style_action = None
    if has_style:
        if style_now != owned.get("output_style_set"):
            style_action = (f"outputStyle is {style_now!r}, not the {owned['output_style_set']!r} "
                            f"this record set — leaving it alone")
        elif prev is None:
            style_action = "outputStyle removed (it was absent before)"
            if execute:
                data.pop("outputStyle", None)
        else:
            style_action = f"outputStyle restored to {prev!r}"
            if execute:
                data["outputStyle"] = prev

    mark = "-" if execute else "~"
    for r in removed:
        print(f"  {mark} {r}  {'removed' if execute else 'would remove'}")
    for a in absent:
        print(f"  . {a}  already absent — NOOP")
    if style_action:
        print(f"  {mark} {style_action}")
    if not execute:
        print("  apply with: --execute   (run it yourself via `!` if the classifier "
              "refused the agent's write)")
        return 0

    dump(spath, data)
    # The record is cleared ONLY for what was actually reversed, so a second run is a
    # reported NOOP rather than a second attempt at rows that are already gone.
    owned["hooks_added"] = []
    owned.pop("output_style_set", None)
    owned.pop("output_style_previous", None)
    dump(owned_path, owned)

    back, err = load(spath)
    if err or not isinstance(back, dict):
        print(f"wf-settings-apply: re-read of {spath} failed; the write may not have "
              f"landed.", file=sys.stderr)
        return 1
    print(f"  verified on disk: outputStyle = {back.get('outputStyle')!r}, "
          f"{len(recorded)} recorded registration(s) processed")
    return 0


def do_wire_hook(root, name, execute, scope="project", quiet=False):
    if name not in SHIPPED_HOOKS:
        print(f"wf-settings-apply: {name} is not a shipped hook. "
              f"Default set: {', '.join(DEFAULT_HOOKS)}. "
              f"Opt-in only, PROPOSED and never wired by the default set: "
              f"{', '.join(sorted(OPT_IN_HOOKS))}", file=sys.stderr)
        return 2
    event, matcher = SHIPPED_HOOKS[name]
    agent_cfg = AGENT_HOOKS.get(name)
    # AN AGENT HOOK HAS NO SCRIPT, so there is no path to resolve and no path note to
    # print. Running the command resolver on one produced "no personal install found;
    # registering the project-scope path" for a hook that is not a file — a true
    # sentence about a resolution that never mattered, which is the kind of correct
    # noise that teaches a reader to skim the output that does matter.
    if agent_cfg is not None:
        command, resolved = "", ""
    else:
        command, resolved = hook_command(name, scope=scope, root=root)

    spath = settings_for_scope(root, scope)
    if not quiet:
        print(f"HOOKS  {spath}          <- resolved, not assumed")
    if resolved.startswith(PER_SESSION_ROOT):
        print(f"  note: {name} resolves only to a personal install, so the project file "
              f"gets the per-session form — each session's shell expands it to its own "
              f"config root. This file is shared by every account that opens the tree.")
    if name in OPT_IN_HOOKS:
        print(f"  note: {name} is PROPOSED and opt-in — wired only when you name it; "
              f"the default set is {', '.join(DEFAULT_HOOKS)} and never includes it.")

    # AGENT HOOKS ARE A DIFFERENT ENTRY SHAPE, and they are the only hook type in this
    # distribution that can ACT rather than report. A command hook has no model: it can
    # decide that a sense went unopened and it cannot open one. `type: "agent"` spawns a
    # reader with Read and Bash and none of the turn's context — which is the whole
    # argument, since nine of ten recorded escapes here came from outside the turn.
    #
    # The prompt is deliberately SHORT and points at a shipped file rather than carrying
    # the instructions inline. A long prompt inlined into settings.json is a second copy
    # of a procedure that drifts from the first, in a file no reader of this repository
    # would think to check.
    inner = agent_cfg or {"type": "command", "command": command}
    entry = {"hooks": [inner]}
    if matcher is not None:
        entry = {"matcher": matcher, "hooks": [inner]}

    data, err = load(spath)
    if err:
        print(f"wf-settings-apply: {err}", file=sys.stderr)
        return 1
    if not isinstance(data, dict):
        data = {}
    present, stale_agent = _scan_hook(data, event, agent_cfg, command, root)

    # THE OFFER IS MADE AGAINST EVERY FILE IN FORCE, NOT ONLY THE ONE THIS SCOPE WRITES.
    # See union_settings_paths: a user-scope registration fires for this project too, so
    # asking only `settings_for_scope` reports "not wired" about a hook that is running.
    # At `root == $HOME` the two files are siblings in one directory and the second copy
    # double-fires every hook in the default set. Nothing is REMOVED on this evidence —
    # `--unwire-defaults` owns removal, and it removes only what the sidecar records.
    also_in = []
    for other in union_settings_paths(root):
        if os.path.realpath(other) == os.path.realpath(spath):
            continue
        odata, _oerr = load(other)
        if not isinstance(odata, dict):
            continue
        if _scan_hook(odata, event, agent_cfg, command, root)[0]:
            also_in.append(other)

    if stale_agent and not present:
        for _e, _h in stale_agent:
            _h.clear()
            _h.update(agent_cfg)
        if not execute:
            print(f"  ~ {name}  {event}  prompt CHANGED — would update in place")
            return 0
        try:
            dump(spath, data)
        except OSError as exc:
            print(f"  ! {name}  {event}  NOT WRITTEN — {exc.__class__.__name__}: {exc}")
            return 1
        back, _ = load(spath)
        ok = any(_same_agent(h, agent_cfg)
                 and (h.get("prompt") or "") == (agent_cfg.get("prompt") or "")
                 for e in (back.get("hooks", {}).get(event, []) if isinstance(back, dict) else [])
                 for h in (e.get("hooks", []) if isinstance(e, dict) else []))
        print(f"  * {name}  {event}  prompt updated in place"
              if ok else
              f"wf-settings-apply: HOOK UNVERIFIED — {name} prompt did not update")
        return 0 if ok else 1

    if present or also_in:
        if present:
            print(f"  . {name} already registered on {event} — NOOP")
        else:
            # NAME THE FILE. "Already registered" about a file the caller did not ask
            # for reads like a refusal to do the work, and the operator's next move is
            # to go and look — so the output says where, and why that file counts.
            print(f"  . {name} already registered on {event} in {also_in[0]} — NOOP")
            print("  note: registrations concatenate across scopes, so this hook "
                  "already fires for this project"
                  + (" (the project and personal config roots are the SAME directory "
                     "here)" if scopes_collapse(root) else "")
                  + ". A second copy would double-fire it.")
        return 0
    # NEVER REGISTER A SCRIPT THAT IS NOT THERE. `hooks.md` § Procedure step 2 has always
    # said so and nothing enforced it: with no install found this wrote a
    # `${CLAUDE_PROJECT_DIR}` row for a missing file, and the prune in the same call took
    # it straight back out. Once the prune moved ahead of the wiring, that became a dead
    # row written by one run and removed by the next, forever.
    target = _norm_command(resolved, root) if agent_cfg is None else None
    if agent_cfg is None and not (isinstance(target, str) and os.path.exists(target)):
        print(f"  ! {name}  {event}  NOT registered — {target} is not on disk, and a "
              f"registration pointing at nothing is dead wiring (hooks.md § Procedure "
              f"step 2). Install workforce, then wire again.")
        return 0
    # ONE ACCURATE LINE. `+ registered` used to print before the write, so a write that
    # then failed printed `+ registered` and `! NOT WRITTEN` for one hook (review 3, L8).
    if not execute:
        print(f"  ~ {name}  {event}"
              f"{('  matcher ' + matcher) if matcher else ''}  would register")
        if not quiet:
            print("  apply with: --execute   (run it yourself via `!` if the classifier "
                  "refused the agent's write)")
        return 0

    # Sidecar reversal FIRST — the exact event/matcher/command, so `disband`/`hooks
    # --remove` removes those and nothing else.
    if os.path.exists(spath) and not os.access(spath, os.W_OK):
        print(f"  ! {name}  {event}  NOT WRITTEN — {spath} is not writable")
        return 1
    # A WRITE THAT FAILS IS REPORTED PER HOOK, NEVER RAISED. The installer runs this for
    # every default hook in turn, and one traceback used to end the loop with nothing
    # after it wired (second review, N3).
    try:
        owned_path, owned = load_owned(root, scope)
        added = owned.setdefault("hooks_added", [])
        if not isinstance(added, list):
            added = owned["hooks_added"] = []
        added.append({"event": event, "matcher": matcher, "command": command})
        dump(owned_path, owned)
    except OSError as exc:
        print(f"  ! {name}  {event}  NOT WRITTEN — {exc.__class__.__name__}: {exc}")
        return 1

    hooks = data.setdefault("hooks", {})
    if not isinstance(hooks, dict):
        print(f"wf-settings-apply: {spath} has a non-object hooks key; refusing.",
              file=sys.stderr)
        return 1
    hooks.setdefault(event, [])
    if not isinstance(hooks[event], list):
        print(f"wf-settings-apply: {spath} hooks.{event} is not a list; refusing.",
              file=sys.stderr)
        return 1
    hooks[event].append(entry)
    try:
        dump(spath, data)
    except OSError as exc:
        print(f"  ! {name}  {event}  NOT WRITTEN — {exc.__class__.__name__}: {exc}")
        return 1

    # THE RE-READ MUST USE THE SAME IDENTITY TEST THE WRITE DID. It did not: presence
    # detection learned about agent hooks and this verifier did not, so a correct write
    # of a `type: "agent"` hook came back "UNVERIFIED — re-read found 0", because
    # `_same_command` compares a `command` key an agent hook does not have. The write
    # was fine and the instrument was wrong, which is the worse of the two — a verifier
    # that cries failure on a good write teaches its reader to ignore it, and this one
    # exists precisely so a settings write is never believed without being re-read.
    back, _ = load(spath)
    count = 0
    if isinstance(back, dict):
        for e in back.get("hooks", {}).get(event, []):
            for h in (e.get("hooks", []) if isinstance(e, dict) else []):
                if agent_cfg is not None:
                    if _same_agent(h, agent_cfg):
                        count += 1
                elif _same_command(h, command, root):
                    count += 1
    if count != 1:
        print(f"wf-settings-apply: HOOK UNVERIFIED — re-read found {count} registrations "
              f"of {name} on {event}, expected 1.", file=sys.stderr)
        return 1
    print(f"  + {name}  {event}{('  matcher ' + matcher) if matcher else ''}  registered")
    print(f"  verified on disk: {name} registered once on {event} in {spath}")
    return 0


# -------------------------------------------------------------------------- automode

def splice_defaults(existing, entries):
    """Keep the "$defaults" splice and add entries that are not already present."""
    out = list(existing) if isinstance(existing, list) else []
    if "$defaults" not in out:
        out.insert(0, "$defaults")
    for e in entries:
        if e not in out:
            out.append(e)
    return out


def do_automode(execute):
    spath = user_settings_path()
    print(f"AUTOMODE  {spath}          <- user scope (the classifier ignores project "
          "settings; a repo cannot grant itself auto mode)")
    data, err = load(spath)
    if err:
        print(f"wf-settings-apply: {err}", file=sys.stderr)
        return 1
    if not isinstance(data, dict):
        data = {}
    am = data.get("autoMode") if isinstance(data.get("autoMode"), dict) else {}
    new_env = splice_defaults(am.get("environment"), [AUTOMODE_ENVIRONMENT])
    new_allow = splice_defaults(am.get("allow"), [AUTOMODE_ALLOW])

    env_changed = new_env != (am.get("environment") or [])
    allow_changed = new_allow != (am.get("allow") or [])
    print(f"  {'+' if execute else '~'} autoMode.environment  "
          f"{'set' if env_changed else 'unchanged'}")
    print(f"  {'+' if execute else '~'} autoMode.allow        "
          f"{'set' if allow_changed else 'unchanged'}")

    if not execute:
        print("  apply with: --execute   (run it yourself via `!` — this is a "
              "self-modification write; the classifier will refuse the agent)")
        print("  confirm after:  claude auto-mode config")
        return 0
    if not (env_changed or allow_changed):
        print("  nothing to change.")
        return 0

    data.setdefault("autoMode", {})
    data["autoMode"]["environment"] = new_env
    data["autoMode"]["allow"] = new_allow
    dump(spath, data)
    back, _ = load(spath)
    ok = (isinstance(back, dict)
          and AUTOMODE_ENVIRONMENT in back.get("autoMode", {}).get("environment", [])
          and AUTOMODE_ALLOW in back.get("autoMode", {}).get("allow", []))
    if not ok:
        print("wf-settings-apply: AUTOMODE UNVERIFIED — re-read did not confirm the "
              "entries.", file=sys.stderr)
        return 1
    print(f"  verified on disk: autoMode entries present in {spath}")
    print("  confirm the classifier picked them up:  claude auto-mode config")
    return 0


# NO OUTPUT STYLE IS SELECTED ANY MORE.
#
# `OUTPUT_STYLE` and `do_output_style` lived here and wrote `outputStyle: "Plain Speak"`
# into a settings file. The user removed the style and everything around it in the
# simplification release, so selecting it is gone — but the REVERSAL is not, and the
# distinction is the whole point of this comment.
#
# `--unwire-defaults` still reads `output_style_set` and `output_style_previous` from
# `.settings-owned.json` and restores whatever was there before. That path is how a
# machine which ALREADY has the style selected gets it cleared, and six settings files
# on the author's own workstation were in exactly that state when this was written.
# Deleting the reverser along with the setter would have left every one of them styled
# with no tool able to unstyle them — a removal that reaches new installs and strands
# existing ones, which is the failure the user's 2026-09-07 propagation directive names.
#
# So: nothing selects a style, and the code that un-selects one stays until no install
# in the world still carries the record. A selection with NO record behind it is cleared
# too: `clear_retired_style` at user scope on every install and update, and `audit` Step 5h
# for a project's own settings.


def main(argv=None):
    ap = argparse.ArgumentParser(add_help=True, description=__doc__.splitlines()[0])
    ap.add_argument("--root", default="")
    ap.add_argument("--execute", action="store_true")
    ap.add_argument("--grants", metavar="FILE", help="JSON array of scoped rule strings, or -")
    ap.add_argument("--wire-hook", metavar="NAME", help="a shipped workforce hook name")
    ap.add_argument("--automode", action="store_true",
                    help="write autoMode entries into ~/.claude/settings.json (user scope)")
    ap.add_argument("--wire-defaults", action="store_true",
                    help="wire every default hook, in one call")
    ap.add_argument("--unwire-defaults", action="store_true",
                    help="reverse exactly what --wire-defaults wrote, per the record")
    ap.add_argument("--heal", action="store_true",
                    help="remove project rows whose workforce script was retired (see heal())")
    ap.add_argument("--scope", choices=("project", "user"), default="project",
                    help="which settings file to write (user scope needs no --root)")
    args = ap.parse_args(argv)

    modes = [bool(args.grants), bool(args.wire_hook), bool(args.automode),
             bool(args.wire_defaults),
             bool(args.unwire_defaults), bool(args.heal)]
    if sum(modes) != 1:
        print("wf-settings-apply: pick exactly one of --grants, --wire-hook, "
              "--automode, --wire-defaults, --unwire-defaults, --heal.",
              file=sys.stderr)
        return 2
    if args.scope == "user" and (args.grants or args.wire_hook or args.heal):
        print("wf-settings-apply: --scope user applies to --wire-defaults and "
              "--unwire-defaults only. The heal never writes a user-scope file.",
              file=sys.stderr)
        return 2

    # --automode writes only the user file and needs no --root, and neither does any
    # user-scope write. Every other mode does.
    root = ""
    if not args.automode and args.scope != "user":
        # ${CLAUDE_PROJECT_DIR} is unset in the Bash tool, so a shipped `--root
        # "${CLAUDE_PROJECT_DIR}"` expands to `--root ""`; abspath("") is the CWD, a
        # tree nobody named. This script WRITES, so refuse rather than retarget.
        if not (args.root or "").strip():
            print("wf-settings-apply: --root is empty. ${CLAUDE_PROJECT_DIR} is unset "
                  "outside a hook; pass an explicit path.", file=sys.stderr)
            return 2
        root = os.path.abspath(args.root)
        if not os.path.isdir(root):
            print(f"wf-settings-apply: not a directory: {root}", file=sys.stderr)
            return 2

    if args.grants:
        return do_grants(root, args.grants, args.execute)
    if args.wire_hook:
        return do_wire_hook(root, args.wire_hook, args.execute)
    if args.wire_defaults:
        return do_wire_defaults(root, args.scope, args.execute)
    if args.unwire_defaults:
        return do_unwire_defaults(root, args.scope, args.execute)
    if args.heal:
        return do_heal(root, args.execute)
    return do_automode(args.execute)


if __name__ == "__main__":
    sys.exit(main())
