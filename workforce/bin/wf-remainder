#!/usr/bin/env python3
"""wf-remainder — the invocation manifest that makes a reduction a transform.

    wf-remainder --manifest <SKILL.md>          print the invocable surface, sorted
    wf-remainder --diff <before> <after>        exit 1 on ANY surface change
    wf-remainder --diff-manifest <a.txt> <b.txt>  same, for saved manifests
    wf-remainder --root <tree> --dead-scripts   script: tokens that do not resolve

WHY THIS EXISTS. The user's directive (`SKILL.md` § Directives) makes skills the
mechanism layer: conversion SEPARATES a skill rather than absorbing it. Judgment
moves into a handbook; mechanism stays and keeps working. `conversion-taxonomy.md`
has said PROMOTE reduces a `SKILL.md` "to its mechanical remainder" since the
beginning — and NOTHING CHECKED WHAT SURVIVED. On the one real audit, 31 skills
were classified PROMOTE and 0 were reduced, so the gap had never been exercised.

Directive one makes preservation the floor: a converted system must work BETTER in
the new format, never merely still exist. So reduction is a transform with a
verification, not a deletion with a rationale:

    manifest A  =  surface before
    reduce
    manifest B  =  surface after
    REQUIRE A == B, exactly. Any difference aborts and restores from .orig.

WHAT IT DOES NOT PROVE, and this is stated because a check that oversells itself is
worse than none. `A == B` proves nothing was dropped from the INVOCABLE SURFACE. It
cannot prove the right prose moved — a section can be correctly retained and wrongly
classified. The partition is a judgment the audit makes per skill; this is the floor
under that judgment, and the cold-read probe is what covers the rest.

AND `A == B` CANNOT SEE A MARKER. Measured 2026-08-04 on a real 32-skill reduction:
TEN cuts broke marker integrity while passing the manifest check, and one removed a
`<!-- origin: user | immutable: true -->` block outright — the user's own words, whose
retention is the FIRST directive of this project. All ten were restored from `.orig`,
which is why `.orig` is taken first. Filed as DEF-2026-08-04-heading-drop-eats-markers.

The cause is structural, not incidental: a cut is a SECTION-SHAPED span and a marker
block is a DIFFERENT span, so a heading boundary crossing a marker boundary removes an
opener while leaving its closer — or swallows a sacred block whole. Neither is visible
to a surface manifest, because neither is invocable. So there is a SECOND floor under
the same transform, checked in the same gesture and refusing on the same terms:

    markers before  =  sacred blocks + pairing counts
    reduce
    markers after   =  the same sacred blocks, still paired
    REQUIRE no sacred block lost AND no family left unpaired.

The grammar is `bin/check`'s, deliberately: two readers of one marker that disagree
about what a marker IS is this project's recorded failure, not a hypothetical.

BIASED TOWARD OVER-CAPTURE, DELIBERATELY. A token captured that is not really an
invocation causes a false abort: the skill is marked ✗ with its path:line and the
batch continues (`SKILL.md` § Atomic-or-Absent, rule 7). A token MISSED means a
gutted skill that verifies clean. The failure modes are not symmetric, so ambiguity
resolves toward capturing.
"""

import glob
import hashlib
import os
import re
import sys

# ── Marker integrity ──────────────────────────────────────────────────────────
# These four patterns are COPIED FROM bin/check, not re-derived. A marker that one
# reader treats as paired and another does not is how a section gets reported present
# and examined not at all — recorded in CLAUDE.md against `wf-conform` and
# `wf-checkrun`, which disagreed about `## Verification (mechanical)`. One grammar.
#
# MEASURED 2026-08-05: the copy was faithful and the SOURCE was the outlier. Eight
# readers of this grammar ship. Three required `immutable: true` to be the LAST field
# before `-->` — `bin/check --stamp`, `bin/check` § immutable blocks, and this file —
# and five did not. `fixtures/scripts/census-sacred-orders`, registered in
# expectations.json, exists to assert that field ORDER inside the marker does not
# matter: the project had already ruled, and the three readers deciding whether a
# directive is checksummed, guarded, and preserved could not see the fixture saying so.
# Widened here and at both bin/check sites in the same change.
# `workforce/.immutable.sha` was unchanged: the hole was latent and would have opened
# the first time a user wrote the fields in the other order.
#
# INDENTATION IS DELIBERATELY STILL REJECTED, and the readers still split on it. An
# indented marker lives inside a fenced template, where it is a MENTION of the syntax
# rather than a marker — bin/check line 501 records 8 false failures from counting
# exactly that. Widening here would import them. The split is real and is reported
# rather than silently resolved; see plan/marker-grammar-2026-08-05.md.
ORIGIN_OPEN_RX = re.compile(r"^<!--\s*origin:.*-->\s*$", re.M)
ORIGIN_CLOSE_RX = re.compile(r"^<!--\s*/origin\s*-->\s*$", re.M)
SACRED_RX = re.compile(
    r"^<!--\s*origin:\s*user\b[^>]*immutable:\s*true[^>]*-->$"
    r"(.*?)^<!--\s*/origin\s*-->$",
    re.S | re.M)
ENF_OPEN = "<!-- ENFORCEMENT ANNOTATION"
ENF_CLOSE = "<!-- END ENFORCEMENT ANNOTATION -->"

# ── What counts as surface ────────────────────────────────────────────────────
# Headings that CARRY mechanism. A reduction may not remove one; judgment headings
# (## When to use, ## Choosing, …) are exactly what is expected to disappear, so
# they are deliberately absent from this set.
MECHANISM_HEADINGS = {
    "commands", "command surface", "quick commands", "usage", "invocation",
    "schema", "invariants", "degradation", "owner", "git policy", "seed",
    "maintainers", "connection", "scripts", "files", "layout", "data",
}

# A slash command in backticks: `/workforce sweep`, `/foo`
CMD_RX = re.compile(r"`(/[a-z][\w-]*(?:\s+[a-z][\w-]*)*)`")
# A script-ish path in backticks: `scripts/x.sh`, `./bin/y`, `bin/z.py`
SCRIPT_RX = re.compile(
    r"`((?:\./)?(?:[\w.-]+/)*[\w.-]+\.(?:sh|py|js|ts|rb|ps1|pl)|(?:\./)?(?:scripts|bin|hooks)/[\w.-]+)`"
)
HEADING_RX = re.compile(r"^(#{1,6})[ \t]+(.+?)[ \t]*#*[ \t]*$", re.M)
# Inside a ## Connection block, a backticked bare word is a declared verb.
VERB_RX = re.compile(r"`([a-z][a-z0-9_]{2,})`")
# A fenced code block. EVERY executable line inside one is surface.
#
# Added 2026-08-04, and it is the reason the mock audit is in the loop. Measured
# against `odyssey-alive`'s 48 real skills, `browser` reported a surface of ZERO
# and would therefore have been marked for deletion by T7c — while consisting
# ENTIRELY of live diagnostics (`ps aux | grep …`, `kill $(pgrep -f …)`) in fenced
# bash blocks under headings this file does not list as mechanism. A skill made of
# nothing but commands scored as having no commands. That is the gutting the
# manifest exists to prevent, produced by the manifest, and no fixture caught it
# because every fixture was written by the same hand as the extractor.
FENCE_RX = re.compile(r"^[ \t]*(?:```|~~~)[^\n]*\n(.*?)^[ \t]*(?:```|~~~)[ \t]*$", re.S | re.M)


def _section_span(text, heading):
    """(start, end) of a section by heading text, or None. Case-insensitive."""
    want = heading.strip().lower().lstrip("#").strip()
    heads = list(HEADING_RX.finditer(text))
    for i, m in enumerate(heads):
        h = re.sub(r"[`*_]", "", m.group(2).strip().lower().rstrip(":")).strip()
        if h != want:
            continue
        level, end = len(m.group(1)), len(text)
        for nxt in heads[i + 1:]:
            if len(nxt.group(1)) <= level:
                end = nxt.start()
                break
        return m.start(), end
    return None


def apply_cut(text, drops):
    """Remove each named section. Returns (new_text, removed, missing)."""
    removed, missing, out = [], [], text
    for h in drops:
        span = _section_span(out, h)
        if not span:
            missing.append(h)
            continue
        start, end = span
        removed.append((h, out[start:end].count("\n")))
        out = out[:start] + out[end:]
    out = re.sub(r"\n{4,}", "\n\n\n", out)
    return out, removed, missing


def marker_state(text):
    """(sacred, counts) — what a reduction must not disturb.

    `sacred` is keyed by a digest of the WHOLE block including its delimiters, so a
    block that survives with one word changed reads as lost rather than as present.
    That is the conservative direction and it is chosen deliberately: this cut is not
    supposed to edit a sacred block at all, so "changed" and "gone" deserve the same
    refusal. The value is the block's first non-blank line, which is what a human
    needs to find it again.
    """
    sacred = {}
    for m in SACRED_RX.finditer(text):
        digest = hashlib.sha256(m.group(0).encode("utf-8")).hexdigest()[:12]
        first = next((ln.strip() for ln in m.group(1).splitlines() if ln.strip()), "(empty)")
        sacred[digest] = first[:72]
    counts = {
        "origin-open": len(ORIGIN_OPEN_RX.findall(text)),
        "origin-close": len(ORIGIN_CLOSE_RX.findall(text)),
        "enforcement-open": text.count(ENF_OPEN),
        "enforcement-close": text.count(ENF_CLOSE),
    }
    return sacred, counts


def _connection_spans(text):
    """Character ranges covered by a `## Connection` section."""
    spans, heads = [], list(HEADING_RX.finditer(text))
    for i, m in enumerate(heads):
        if m.group(2).strip().lower().rstrip(":") != "connection":
            continue
        level = len(m.group(1))
        end = len(text)
        for nxt in heads[i + 1:]:
            if len(nxt.group(1)) <= level:
                end = nxt.start()
                break
        spans.append((m.end(), end))
    return spans


def manifest(text):
    """The invocable surface, as a sorted list of typed tokens."""
    out = set()

    for m in CMD_RX.finditer(text):
        out.add("cmd:" + " ".join(m.group(1).split()))

    for m in SCRIPT_RX.finditer(text):
        p = m.group(1)
        out.add("script:" + (p[2:] if p.startswith("./") else p))

    for m in HEADING_RX.finditer(text):
        h = m.group(2).strip().lower().rstrip(":")
        # Strip inline code/emphasis so `## \`Schema\`` matches "schema".
        h = re.sub(r"[`*_]", "", h).strip()
        if h in MECHANISM_HEADINGS:
            out.add("section:" + h)

    for start, end in _connection_spans(text):
        for m in VERB_RX.finditer(text[start:end]):
            out.add("verb:" + m.group(1))

    for m in FENCE_RX.finditer(text):
        for line in m.group(1).splitlines():
            s = line.strip()
            if not s or s.startswith("#"):
                continue  # blank, or a comment explaining the next line
            out.add("run:" + " ".join(s.split()))

    return sorted(out)


def read(path):
    with open(path, encoding="utf-8") as fh:
        return fh.read()


def _emit_diff(before, after, label_a, label_b):
    lost = [t for t in before if t not in set(after)]
    gained = [t for t in after if t not in set(before)]
    if not lost and not gained:
        print(f"surface identical — {len(before)} token(s)")
        return 0
    print(f"SURFACE CHANGED  {label_a} -> {label_b}")
    for t in lost:
        print(f"  LOST    {t}")
    for t in gained:
        print(f"  GAINED  {t}")
    print(
        f"\n{len(lost)} lost, {len(gained)} gained. A reduction may not change the invocable\n"
        f"surface: directive one makes preservation the floor. Abort the reduction and\n"
        f"restore from the T7 `.orig`."
    )
    return 1


# ── PASS-DEAD-SCRIPT ─────────────────────────────────────────────────────────
# `manifest()` emits `script:<path>` tokens and NEVER stats one — A and B are
# compared string to string, so a SKILL.md naming a script that is not on disk
# passes the T7b reduction gate clean, on both sides. This reuses the SAME
# SCRIPT_RX rather than a second extractor: the tuned part is the extraction, and
# a fresh regex would re-earn the false positives that one already paid for.
#
# TWO FILTERS, both measured against odyssey-alive's 48 skills on 2026-08-05:
#
#   1. A BARE FILENAME IS A MENTION, NOT A REFERENCE. Requiring a `/` cut the
#      candidate set from 184 tokens to 79 and removed every false positive of the
#      "prose names a script" kind (`run ma.py`, `app.js`). 105 skipped.
#   2. MISROUTED vs UNRESOLVED. Of the 3 survivors, hand-checking split them:
#      `agenda` names `scripts/ma.py`, which exists — at `invest/scripts/ma.py`.
#      `invest` names `src/stealth.ts`, which belongs to the playwright-mcp SERVER
#      and is not this project's file at all. Same detector, opposite verdicts, and
#      the discriminator is whether the BASENAME resolves anywhere in the tree.
#      MISROUTED is a finding; UNRESOLVED is a candidate that may be external.
#
# REPORTS, NEVER REPAIRS. Measured precision on unique references was 1 true of 2,
# and the false one names a real file in someone else's repository. Rewriting a
# path on that evidence would edit a correct sentence.
def dead_scripts(root):
    """[(skill_path, token, verdict)] for path-shaped script tokens that do not resolve."""
    skills_dir = os.path.join(root, ".claude", "skills")
    basenames = {}
    for dp, _dn, fn in os.walk(root):
        if os.sep + ".git" in dp:
            continue
        for f in fn:
            basenames.setdefault(f, os.path.relpath(os.path.join(dp, f), root))
    out = []
    for sk in sorted(glob.glob(os.path.join(skills_dir, "*", "SKILL.md"))):
        here = os.path.dirname(sk)
        seen = set()
        for m in SCRIPT_RX.finditer(read(sk)):
            tok = m.group(1)
            tok = tok[2:] if tok.startswith("./") else tok
            if "/" not in tok or tok in seen:
                continue          # filter 1: a bare filename is a mention
            seen.add(tok)
            if any(os.path.exists(p) for p in
                   (os.path.join(here, tok), os.path.join(root, tok),
                    os.path.join(skills_dir, tok))):
                continue
            elsewhere = basenames.get(os.path.basename(tok))
            out.append((os.path.relpath(sk, root), tok,
                        "MISROUTED  -> " + elsewhere if elsewhere else "UNRESOLVED"))
    return out


def main(argv):
    argv = list(argv)
    root = ""
    if len(argv) >= 3 and argv[1] == "--root":
        root = argv[2]
        del argv[1:3]

    def rel(p):
        return os.path.join(root, p) if root and not os.path.isabs(p) else p

    if len(argv) >= 2 and argv[1] == "--dead-scripts":
        rows = dead_scripts(root or ".")
        mis = sum(1 for _s, _t, v in rows if v.startswith("MISROUTED"))
        # Counted line ALWAYS, including the zeroes: a detector that prints nothing
        # on a clean tree is indistinguishable from one that did not run.
        print(f"dead scripts   {len(rows)} unresolved · {mis} misrouted "
              f"· {len(rows) - mis} not found in this tree")
        for s, t, v in rows:
            print(f"  {v.split()[0]:<10} {s}  ->  {t}"
                  + ("" if v == "UNRESOLVED" else "   (" + v.split("-> ")[1] + ")"))
        return 0
    if len(argv) >= 3 and argv[1] == "--manifest":
        for t in manifest(read(rel(argv[2]))):
            print(t)
        return 0
    if len(argv) >= 4 and argv[1] == "--diff":
        return _emit_diff(manifest(read(rel(argv[2]))), manifest(read(rel(argv[3]))),
                          argv[2], argv[3])
    if len(argv) >= 4 and argv[1] == "--diff-manifest":
        a = [l.strip() for l in read(rel(argv[2])).splitlines() if l.strip()]
        b = [l.strip() for l in read(rel(argv[3])).splitlines() if l.strip()]
        return _emit_diff(a, b, argv[2], argv[3])

    if len(argv) >= 3 and argv[1] == "--apply":
        path = rel(argv[2])
        drops = [argv[i + 1] for i, a in enumerate(argv) if a == "--drop" and i + 1 < len(argv)]
        if not drops:
            print("--apply needs at least one --drop <heading>", file=sys.stderr)
            return 2
        before = read(path)
        after, removed, missing = apply_cut(before, drops)
        ma, mb = manifest(before), manifest(after)

        sac_b, _cnt_b = marker_state(before)
        sac_a, cnt_a = marker_state(after)
        lost_sacred = [v for k, v in sac_b.items() if k not in sac_a]
        unpaired = [f"{fam}: {cnt_a[fam + '-open']} open vs {cnt_a[fam + '-close']} close"
                    for fam in ("origin", "enforcement")
                    if cnt_a[fam + "-open"] != cnt_a[fam + "-close"]]

        for h in missing:
            print(f"NOT FOUND  {h!r} — no such heading; nothing removed for it")

        # EVERY reason is printed before returning, never the first one found. A cut
        # that loses a sacred block usually also unbalances a marker, and reporting one
        # reason per invocation turns a single re-cut into a guessing loop.
        refused = False
        if set(ma) != set(mb):
            refused = True
            print(f"REFUSED — reducing {path} would change its invocable surface:")
            _emit_diff(ma, mb, "before", "after")
            print("The named sections carry mechanism, not judgment.")
        if lost_sacred:
            refused = True
            print(f"REFUSED — reducing {path} would remove {len(lost_sacred)} immutable "
                  f"block(s). These are the user's own words and no regeneration "
                  f"reconstructs them:")
            for s in lost_sacred:
                print(f"  lost  <!-- origin: user | immutable: true -->  {s}")
        if unpaired:
            refused = True
            print(f"REFUSED — reducing {path} would leave an unpaired marker, which the "
                  f"sweep reads as a malformed region:")
            for u in unpaired:
                print(f"  {u}")
        if refused:
            print("\nNothing was written. Re-cut with the sections that actually moved "
                  "into the handbook — a refused cut is a re-cut, never a stop.")
            return 1
        if not removed:
            print(f"no-op — nothing removed from {path} ({len(ma)} token(s) unchanged)")
            return 0
        with open(path, "w", encoding="utf-8") as fh:
            fh.write(after)
        total = sum(n for _, n in removed)
        print(f"reduced {path} — {len(removed)} section(s), {total} line(s) removed, "
              f"surface identical ({len(ma)} token(s))")
        for h, n in removed:
            print(f"  dropped  {h}  ({n} lines)")
        return 0
    print(__doc__.strip().splitlines()[0], file=sys.stderr)
    print("usage: wf-remainder --manifest <file> | --diff <before> <after> | "
          "--diff-manifest <a> <b> | --root <tree> --dead-scripts", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
