#!/usr/bin/env python3
"""wf-live — the liveness registry: what this distribution ships, read from the tree.

WHY THIS EXISTS, and it is the one mechanism class this project had none of.

MEASURED (Freeman & Kicklighter, arXiv 2603.10047): five hallucination-reduction
strategies, 100 runs each, against a common baseline. The sort is the finding:

    M4  Enhanced Data Registry     100/100     input data
    M3  Agent Specialization        80/100     architecture
    M5  Glossary Injection          77/100     input data
    M1  Iterative Convergence       75/100     reasoning
    M2  Decomposed Prompting        34/100     reasoning — NET NEGATIVE

The two input-side methods took first and third; the two reasoning-side methods took
last and worst. Every mechanism this distribution had built was reasoning-side (a guard
watching what the model says) or architecture-side (add a reviewer). This is the first
input-side one.

M4 IS NOT A RETRIEVAL INDEX. It is an enrichment layer: bare records get readable
metadata attached before the model reasons over them. The paper's own framing — without
a physical meaning map the model hallucinates component relationships — names this
repository's failure mode exactly.

WHAT WENT WRONG WITHOUT IT. `vendor` was documented as a live command with no procedure.
`INV-HANDOFF` was a live invariant whose producer had been deleted. `audit` told every
run to execute `wf-handoff`, which does not exist. Three shipped files stated three
different hook counts. In every case the map said live, the tree said gone, and a human
caught it. Stale metadata does not make context engineering fail loudly; it delivers bad
context faster.

WHY IT IS DERIVED AND NEVER AUTHORED. A hand-kept list of what is live is the same
artifact that was wrong four times above. This reads the tree — `workforce/bin/`,
`references/procedures/`, `agents/`, `SKILL.md`, and `wf-settings-apply`'s own
`SHIPPED_HOOKS` — and reports what it finds. It cannot go stale, because it is not
stored.

WHAT IT IS NOT. It reports what SHIPS, never what is correct, and never whether a live
thing works. `bin/check` (maintainer) and `/workforce verify` (host) judge conformance.
This answers the narrower question nothing answered before: *is this thing there?*
"""

import ast
import json
import os
import re
import sys

# `<...>/skills/workforce/bin/wf-live` on a host, `<repo>/workforce/bin/wf-live` here.
# Either way the parent of bin/ is the shipped root, and nothing above it is assumed to
# exist: `manifest.txt` lives in the repo and is NOT installed on a host.
WF = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
REPO = os.path.dirname(WF)


def _root(argv):
    """`--root <dir>` points the registry at another install; default is this one.

    Needed for two readers that are not this checkout: a fixture, which must run the
    registry against a tree it controls rather than against whatever the working copy
    happens to hold, and `audit`, which asks the question of the project it is
    auditing. A registry that can only describe its own directory answers the question
    for the one tree that least needs asking.
    """
    global WF, REPO
    if "--root" in argv:
        i = argv.index("--root")
        if i + 1 < len(argv):
            WF = os.path.abspath(argv[i + 1])
            REPO = os.path.dirname(WF)
            del argv[i:i + 2]
    return argv

# A phantom is a `wf-` name that no file backs. The trailing lookahead rejects a
# FRAGMENT: prose writes `wf-canary-*` and `wf-mcp-…`, and matching the stem alone
# invents a name nobody claimed. `wf-<digits>` is a run id, not a name.
NAME = re.compile(r"\bwf-[a-z][a-z0-9]*(?:-[a-z0-9]+)*\b(?![-\w])")

# A citation of OUR references/ tree. The leading boundary is load-bearing: without it
# `text-eval/references/ai-patterns.md` — a path inside a PROJECT's own evaluator skill,
# quoted in an example table — reads as a workforce reference and is reported missing.
# Two such false positives appeared on the first sweep and neither was a defect.
REFCITE = re.compile(r"(?:^|[\s`(\[])references/([A-Za-z0-9_./-]+\.md)")

# ATTRIBUTION, for the citations the leading boundary cannot reach. The rule above
# resolves `skills/text-eval/references/additions.md` because the path carries its own
# skill root. It cannot help when the prose carries the ownership and the path is
# written bare — "the evaluator skill's own `references/additions.md`" is relative to
# THAT skill, not to ours. MEASURED 2026-09-11: four such citations (evaluators.md:526,
# :536, :658 and procedures/audit.md:1799) were reported missing while both files they
# name were present on disk. Same class as the two false positives the leading boundary
# closed in 1.48.0, different shape.
#
# BOTH CONDITIONS ARE REQUIRED, so this cannot become a phrase that hides a real defect:
# the sentence must attribute the file to a skill, AND the file must actually resolve
# under one of the shipped skills. Prose attributing a file nobody has still reports.
SKILL_OWNED = re.compile(r"skill's\s+own\s+$")
NOT_A_NAME = re.compile(r"^wf-\d")

# TWO TIERS, BECAUSE A GUARD THAT CRIES WOLF GETS IGNORED. That is not a guess: a
# speech guard firing on 7.0% of GOOD replies was retired for exactly this
# (changes/1.30.1.md). Naming a dead mechanism is often CORRECT — `platform.md` is a
# measurement log and `staging.md` says outright "they were swept" — so past-tense
# prose about a retired probe is not a defect and must not be reported as one.
#
# BROKEN is the tier that fails: the name sits where a reader is told to RUN it.
# `verify.md` says "Spawn `wf-model-canary` by its registered subagent_type" and there
# is no `wf-model-canary`. That is an instruction to run nothing, and it fires on every
# host that reaches the step.
# THE VERB MUST BE CAPITALISED AND ADJACENT. Both halves were learned by getting it
# wrong: a 40-character window with a case-insensitive verb read "in the confounded
# run `wf-canary-c` reported" as an instruction to run a probe, because `run` is a NOUN
# there. In markdown prose an imperative opens its clause and is capitalised — "Run
# `wf-model-budget --root …`", "Spawn `wf-model-canary`" — while the noun sits
# lowercase mid-sentence after an article or adjective. Requiring the capital and
# allowing at most a backtick or two of gap separates them without a word list.
RUNNABLE = re.compile(r"\b(?:Run|Spawn|Invoke|Execute|Call)s?\b[\s`*_]{0,4}$")

# A PROJECT'S AGENT FILE IS NEVER OURS TO RESOLVE, for the reason a project skill's
# `references/` path is not (REFCITE above). `.claude/agents/wf-mcp-absent-probe.md` names a
# fixture a measurement run wrote into ONE project; the distribution never shipped it, so
# "backed by nothing in bin/ or agents/" is true and says nothing.
PROJECT_AGENT = re.compile(r"(?:\.claude/)?agents/$")

# THE HISTORY TIER, AND WHY IT NEEDS TWO THINGS. MEASURED 2026-09-16 against the 1.63.0 tree:
# 19 `stale` names, and every run reported the same ones — `wf-pin-check` in "That script was
# removed", `wf-plain-guard` in "the guard was itself retired in 1.30.2". A report that says
# the same true thing about correct prose every run is the report a reader learns to skim.
#
# A mention is HISTORY, and is counted rather than listed, only when BOTH hold:
#   1. the name is one the distribution RETIRED, read from the tree's own records and never
#      from a list kept here — `RETIRED_HOOKS` in wf-settings-apply (bin/check pins it to git
#      history), `RETIRED_EXTERNAL` below (bin/check pins it to the `retired` rows of
#      `manifest.txt`), and `CANARY_RX` in wf-apply, the throwaway fixture names workforce
#      itself wrote;
#   2. the sentence it sits in speaks of the past.
# A name nobody retired still reports, whatever tense its sentence is in, so a cue word cannot
# hide a phantom. And a retired name in a present-tense sentence ("`wf-reload-probe` is left in
# `.claude/agents/`") still reports, because that sentence tells a reader the thing is there.
# THE ONE STORED SET, AND WHY IT IS NOT READ FROM THE MANIFEST. The manifest's `retired` rows
# name the canary fixtures and the output style that shipped OUTSIDE the skill directory, but
# `manifest.txt` is not installed, so a host's wf-live cannot read it. MEASURED 2026-09-16 in a
# bin/dev-sandbox install: reading the manifest classified `wf-model-canary` as history in this
# repository and as stale on the host. bin/check fails when this set and those rows disagree,
# so it cannot drift from the authority it copies.
RETIRED_EXTERNAL = frozenset({
    "plain-speak", "wf-canary-a", "wf-canary-b", "wf-canary-c", "wf-ceiling-probe",
    "wf-model-canary",
})
HISTORY_CUE = re.compile(
    r"\b(?:removed|retired|deleted|swept|deprecated|went|gone|no longer|used to|until|"
    r"had been|was|were|shipped|held|written|reported|returned|measured|attempted|"
    r"history|previously|earlier|once|said|saying|did|fired|wired|ran|read as)\b", re.I)
SENTENCE_END = re.compile(r"(?<=[.!?])[*_`)\]]*\s+|\s\|\s|^\s*\|\s*|\s*\|\s*$")


def slurp(path):
    try:
        with open(path, encoding="utf-8", errors="replace") as fh:
            return fh.read()
    except OSError:
        return ""


def names_in(d, want_dirs=False):
    if not os.path.isdir(d):
        return []
    out = []
    for n in sorted(os.listdir(d)):
        full = os.path.join(d, n)
        if os.path.isdir(full) == want_dirs:
            out.append(n)
    return out


def shipped_docs():
    """Every markdown a reader is steered to, EXCLUDING `changes/`.

    `changes/` is a historical record. It names retired mechanisms on purpose and
    correctly, so scanning it would report the changelog doing its job as a defect.
    Everything else — SKILL.md, references/, agents/ — is read as current instruction.
    """
    out = []
    skill = os.path.join(WF, "SKILL.md")
    if os.path.isfile(skill):
        out.append(skill)
    for sub in ("references", "agents"):
        for dirpath, _, files in os.walk(os.path.join(WF, sub)):
            out += [os.path.join(dirpath, f) for f in sorted(files) if f.endswith(".md")]
    return out


def registry():
    scripts = [n for n in names_in(os.path.join(WF, "bin")) if n.startswith("wf-")]
    procedures = sorted(n[:-3] for n in names_in(os.path.join(WF, "references/procedures"))
                        if n.endswith(".md"))
    agents = names_in(os.path.join(WF, "agents"), want_dirs=True)

    # ADVERTISED COMMANDS, DERIVED FROM THE PROSE A READER ACTUALLY FOLLOWS — not from
    # one hand-authored line. This read a single `Commands: a, b, c` frontmatter string,
    # which is a HAND-KEPT LIST: exactly the artifact this script's own header warns
    # about ("a stored list of what is live is the same artifact that called `vendor` a
    # live command"). MEASURED 2026-09-10: SKILL.md's § Display vs. Execute tables named
    # SEVEN commands with no procedure file — promote, transfer, ablate, reconcile,
    # vendor, budget, diagnose — and every one was invisible here, `vendor` included.
    # The frontmatter line stays as one source; the body is now read too.
    skill_src = slurp(os.path.join(WF, "SKILL.md"))
    commands = set()
    m = re.search(r"Commands: (.+?)\"", skill_src)
    if m:
        commands |= {c.strip() for c in m.group(1).split(",")}
    # `/workforce <name>` and the display-vs-execute lists, which are where a reader is
    # told what exists. A name is a command only if it is a bare lowercase word: `org
    # index` and `audit --review` are sub-forms of a command already counted.
    for chunk in re.findall(r"`/workforce ([a-z][a-z-]*)", skill_src):
        commands.add(chunk)
    for para in re.findall(r"(?:require `--execute`|run immediately):(.*?)\.\n", skill_src, re.S):
        for name in re.findall(r"`([a-z][a-z-]*)`", para):
            commands.add(name)
    commands = sorted(c for c in commands if c and c not in ("workforce", "org", "dev"))

    # The hook set comes from the one producer that wires it, never from prose. Three
    # shipped files once stated three different counts; this reads the emitter.
    sa = slurp(os.path.join(WF, "bin/wf-settings-apply"))
    block = re.search(r"SHIPPED_HOOKS = \{(.*?)\n\}", sa, re.S)
    hooks = sorted(set(re.findall(r'"(wf-[a-z0-9-]+)(?:@[a-z]+)?"', block.group(1)))) if block else []
    # AGENT HOOKS ARE LIVE AND HAVE NO FILE. A `type: "agent"` hook is a prompt declared
    # in AGENT_HOOKS, not a script in bin/ — so the phantom scan below, which asks "is
    # there a file behind this name", reports one as backed by nothing and is wrong. It
    # is exactly the kind of correct-looking false positive that teaches a reader to
    # skim this report, which is the failure a 7.0% guard was retired for.
    ablock = re.search(r"AGENT_HOOKS = \{(.*?)\n\}", sa, re.S)
    agent_hooks = sorted(set(re.findall(r'"(wf-[a-z0-9-]+)"', ablock.group(1)))) if ablock else []

    return {"scripts": scripts, "hooks": hooks, "agent_hooks": agent_hooks,
            "procedures": procedures, "agents": agents, "commands": commands}


def skill_dirs():
    """Every shipped skill directory other than workforce's own, in either layout.

    TWO LAYOUTS, AND THE FIRST VERSION KNEW ONE. In this repository the evaluators sit under
    `workforce/skills/<name>/`. On a host the installer puts them BESIDE the workforce skill,
    at `<skills-root>/<name>/`, because a skill is only discoverable there (manifest.txt §
    sibling). Reading only the first, every "the evaluator skill's own `references/…`"
    citation resolved here and reported stale on every installed host. MEASURED 2026-09-16 in
    a bin/dev-sandbox install of 1.63.0: four `references/additions.md` rows, all four files
    present on disk.
    """
    out = []
    for base in (os.path.join(WF, "skills"), os.path.dirname(WF)):
        for s in names_in(base, want_dirs=True):
            full = os.path.join(base, s)
            if os.path.abspath(full) != os.path.abspath(WF) and os.path.isfile(
                    os.path.join(full, "SKILL.md")):
                out.append(full)
    return out


def retired_names():
    """{name: source} for every name the tree's own records say the distribution retired."""
    out = {}
    sa = slurp(os.path.join(WF, "bin/wf-settings-apply"))
    block = re.search(r"RETIRED_HOOKS = frozenset\(\{(.*?)\}\)", sa, re.S)
    for n in re.findall(r'"(wf-[a-z0-9-]+)"', block.group(1) if block else ""):
        out.setdefault(n, "RETIRED_HOOKS")
    for n in RETIRED_EXTERNAL:
        out.setdefault(n, "RETIRED_EXTERNAL")
    return out


def canary_pattern():
    """wf-apply's own pattern for the throwaway fixtures workforce wrote, or None."""
    m = re.search(r'^CANARY_RX = re\.compile\(r"(.+)"\)$',
                  slurp(os.path.join(WF, "bin/wf-apply")), re.M)
    try:
        return re.compile(m.group(1)) if m else None
    except re.error:
        return None


def paragraph_spans(lines):
    """[(first, last)] per line index: the wrapped paragraph that line belongs to.

    A SENTENCE IS NOT A LINE. Markdown here wraps near column 100, so "the user's explicit
    instruction that `wf-plain-guard` and `wf-speak-guard`" ends a line and "are deprecated"
    opens the next. Reading one line at a time reported that sentence as present tense. A
    blank line, a table row, a heading, a list item and a fence each start a new paragraph.
    """
    spans = [(i, i) for i in range(len(lines))]
    start = None

    def close(last):
        for j in range(start, last + 1):
            spans[j] = (start, last)

    for i, raw in enumerate(lines):
        s = raw.strip()
        solo = not s or s.startswith(("|", "#", "```"))
        opens = re.match(r"(?:[-*>]|\d+\.)\s", s) is not None
        if start is not None and (solo or opens):
            close(i - 1)
            start = None
        if not solo and start is None:
            start = i
    if start is not None:
        close(len(lines) - 1)
    return spans


def sentence_at(text, start, end):
    """The sentence (or table cell) of `text` holding [start, end)."""
    left = 0
    for m in SENTENCE_END.finditer(text[:start]):
        left = m.end()
    right = len(text)
    m = SENTENCE_END.search(text, end)
    if m:
        right = m.start()
    return text[left:right]


# ── Per-function hand-off roles. ONE COPY: `bin/components` loads these from here. ────────
# THE SHIPPED REGISTRY HAD THE FILE-LEVEL RULE THE MAINTAINER SUITE HAD ALREADY RETIRED.
# `bin/check` moved to per-function roles on 2026-09-12, when the asks checklist landed and the
# file-level rule reported `wf-asks` "acted on by NOTHING" while `wf-widen` read it at Stop. The
# fix went into `bin/components`, which does not ship, so every host's `wf-live` kept printing
# the false DETECTOR row. MEASURED 2026-09-16 on 1.63.0: `wf-widen.checklist()` opens
# `wf-asks.<sid>.json` and loads it, and `with_checklist` hands it to the juror.
def artifact_names(src):
    """The per-session hand-off files a source composes: `f"wf-x.{sid}…"` or a `-flag`."""
    return set(re.findall(r'f"(wf-[a-z-]+)\.\{', src)) | set(re.findall(r'"(wf-[a-z-]+-flag)', src))


# CODE ONLY, NEVER PROSE. Splitting the raw source on `\n(?=def )` hung the comment block above
# a def on the function before it, and a name in a comment or docstring counted as a mention,
# so a function that opened any file became a "reader" of an artifact only its prose named.
# Found 2026-09-13 by review. Each function is re-rendered from its syntax tree with every
# docstring and bare string statement dropped, and a tree carries no comments.
def code_chunks(src):
    try:
        tree = ast.parse(src)
    except SyntaxError:
        # Not Python: fall back to the split, with whole-line and trailing comments removed.
        return re.split(r"\n(?=def )", re.sub(r"(?m)(^|\s)#.*$", r"\1", src))

    class _NoProse(ast.NodeTransformer):
        def visit_Expr(self, node):
            if isinstance(node.value, ast.Constant) and isinstance(node.value.value, str):
                return None
            return node

    tree = _NoProse().visit(tree)
    defs = (ast.FunctionDef, ast.AsyncFunctionDef)
    chunks = [ast.unparse(n) for n in tree.body if isinstance(n, defs)]
    rest = [n for n in tree.body if not isinstance(n, defs)]
    return chunks + [ast.unparse(ast.Module(body=rest, type_ignores=[]))]


def function_roles(src, art):
    """{function name, or "" for module code: {"writer", "reader", "clearer"}} for one file.

    A path helper (names the artifact, joins a path, opens nothing) is transparent: a call to
    it is a mention of the artifact in the calling function. Deleting is not acting, so a
    clearer is never a reader.
    """
    funcs = code_chunks(src)
    helpers = [m.group(1) for f in funcs
               if art in f and "os.path.join" in f and "open(" not in f
               for m in [re.match(r"def (\w+)\(", f)] if m]
    out = {}
    for f in funcs:
        m = re.match(r"def (\w+)\(", f)
        if m and m.group(1) in helpers:
            continue
        if not (art in f or any(f"{h}(" in f for h in helpers)):
            continue
        roles = set()
        if "json.dump(" in f:
            roles.add("writer")
        if "os.remove(" in f:
            roles.add("clearer")
        if "json.dump(" not in f and "os.remove(" not in f and "open(" in f:
            roles.add("reader")
        if roles:
            out[m.group(1) if m else ""] = roles
    return out


def artifact_roles(src, art):
    return set().union(*function_roles(src, art).values())


def orphan_handoffs(reg):
    """Hooks that write a hand-off file nothing reads — a detector with no actor.

    WHY THIS IS HERE AND NOT ONLY IN THE MAINTAINER'S SUITE. The rule it enforces is a
    user directive — "A DETECTOR SHIPS WITH ITS FIX. Detection alone is not a
    deliverable" (`SKILL.md` § Directives, 2026-08-05) — and it was first written into
    `bin/check`, which is maintainer-only and in no manifest. That put the enforcement
    of a shipped rule in the one place that does not ship: every host carried the
    directive and nothing on any host could check it.

    WHAT A MISSING ACTOR LEAVES BEHIND. Nothing can notice an absent component by
    looking at present ones — a four-part design with three parts built leaves no
    artifact. But a detector that records what it found, with nothing that consumes the
    record, leaves exactly one trace: a file written and never read. That is what this
    counts.

    DELETING IS NOT ACTING. A hook that only clears the artifact is housekeeping, not a
    consumer, and counting it as one is how the first version of this check passed while
    the actor was absent.
    """
    scripts = {n: slurp(os.path.join(WF, "bin", n)) for n in reg["scripts"]}
    apply_src = scripts.get("wf-settings-apply", "")
    # A `type: "agent"` reader has no file: its consumption is visible in the PROMPT region of
    # AGENT_HOOKS only. The whole file names every hook in its wiring tables, so a whole-file
    # match passed for any artifact named after a hook.
    agent_region = apply_src[apply_src.find("AGENT_HOOKS = {"):] if "AGENT_HOOKS = {" in apply_src else ""
    agent_region = agent_region[:agent_region.find("\n}\n")] if agent_region else ""
    artifacts = set()
    for src in scripts.values():
        artifacts |= artifact_names(src)
    out = []
    for a in sorted(artifacts):
        # ROLES ARE DECIDED PER FUNCTION, NOT PER FILE. The file-level rule called any script
        # that saved ANY file a writer of EVERY artifact it named, so a script that saves a
        # file of its own could never be a reader of anything.
        roles = {n: artifact_roles(src, a) for n, src in scripts.items() if a in src}
        writers = [n for n, r in roles.items() if "writer" in r]
        clearers = [n for n, r in roles.items() if "clearer" in r]
        actors = [n for n, r in roles.items() if "reader" in r]
        if a in agent_region:
            actors.append("wf-settings-apply:AGENT_HOOKS")
        if writers and not actors:
            out.append(("DETECTOR", a,
                        "written by %s%s, and acted on by NOTHING — a detector must "
                        "ship with its fix (SKILL.md § Directives)"
                        % (", ".join(writers),
                           ", cleared by " + ", ".join(clearers) if clearers else "")))
    return out


def disagreements(reg):
    """Where one part of the tree contradicts another. This is the payload."""
    out = []
    live_script = set(reg["scripts"])
    # An agent is addressed as `wf-<dir>`; that name is backed by agents/<dir>/, not bin/.
    live_agent = {"wf-" + a for a in reg["agents"]} | set(reg.get("agent_hooks") or [])

    for c in reg["commands"]:
        if c not in reg["procedures"]:
            out.append(("command", c, "advertised in SKILL.md, no references/procedures/%s.md" % c))

    # A CITED REFERENCE THAT DOES NOT EXIST IS THE SAME DEFECT AS A NAMED SCRIPT THAT DOES
    # NOT EXIST, and this script could not see it. MEASURED 2026-09-10: six were live —
    # `plain-output.md` cited eight times including four in SKILL.md, plus `evals.md`,
    # `handoff.md`, `procedures/diagnose.md`, `procedures/charter.md` and one more. Every
    # one sent a reader to a file deleted in a strip, and nothing failed.
    #
    # THE IMPERATIVE SPLIT APPLIES HERE TOO, for the reason it applies to scripts: prose
    # correctly RECORDING that a reference went with its mechanism is the record doing its
    # job, and failing on it teaches a reader to skim the report.
    for doc in shipped_docs():
        rel = os.path.relpath(doc, WF)
        fenced = False
        for lineno, line in enumerate(slurp(doc).splitlines(), 1):
            if line.lstrip().startswith("```"):
                fenced = not fenced
                continue
            for m in REFCITE.finditer(line):
                target = m.group(1)
                # Only OUR references/ tree. `.claude/skills/<x>/references/y.md` is a
                # path inside a project's own skill and is never ours to resolve — two
                # such citations read as defects on the first sweep and were not.
                if os.path.isfile(os.path.join(WF, "references", target)):
                    continue
                if SKILL_OWNED.search(line[:m.start()]) and any(
                        os.path.isfile(os.path.join(s, "references", target))
                        for s in skill_dirs()):
                    continue
                imperative = fenced or RUNNABLE.search(line[:m.start()])
                kind = "BROKEN" if imperative else "stale"
                out.append((kind, "references/" + target,
                            "cited at %s:%d and not in references/" % (rel, lineno)))

    for h in reg["hooks"]:
        if h in (reg.get("agent_hooks") or []):
            continue                       # declared as a prompt, not a file
        if h not in live_script:
            out.append(("hook", h, "registered by wf-settings-apply, not in bin/"))

    # A hand-off file a shipped script composes (`wf-asks.<session>.json`) is backed by that
    # script. Naming it is naming a live artifact, not a phantom mechanism.
    live_artifact = set()
    for n in reg["scripts"]:
        live_artifact |= artifact_names(slurp(os.path.join(WF, "bin", n)))
    retired = retired_names()
    canary_rx = canary_pattern()

    broken, stale, history = {}, {}, reg.setdefault("history", {})
    for doc in shipped_docs():
        rel = os.path.relpath(doc, WF)
        fenced = False
        lines = slurp(doc).splitlines()
        spans = paragraph_spans(lines)
        for lineno, line in enumerate(lines, 1):
            if line.lstrip().startswith("```"):
                fenced = not fenced
                continue
            first, last = spans[lineno - 1]
            para = " ".join(lines[first:last + 1])
            shift = len(" ".join(lines[first:lineno - 1])) + (1 if lineno - 1 > first else 0)
            for m in NAME.finditer(line):
                tok = m.group(0)
                if (NOT_A_NAME.search(tok) or tok in live_script or tok in live_agent
                        or tok in live_artifact or PROJECT_AGENT.search(line[:m.start()])):
                    continue
                where = f"{rel}:{lineno}"
                imperative = fenced or RUNNABLE.search(line[:m.start()])
                if imperative:
                    broken.setdefault(tok, []).append(where)
                    continue
                known = retired.get(tok) or (
                    "wf-apply CANARY_RX" if canary_rx and canary_rx.match(tok + ".md") else None)
                if known and HISTORY_CUE.search(
                        sentence_at(para, shift + m.start(), shift + m.end())):
                    history.setdefault(tok, []).append(where)
                    continue
                stale.setdefault(tok, []).append(where)

    out += orphan_handoffs(reg)

    for tok in sorted(broken):
        out.append(("BROKEN", tok, "a reader is told to run it, and it is not in bin/ or agents/ — "
                                   + ", ".join(broken[tok][:3])))
    for tok in sorted(stale):
        if tok in broken:
            continue
        out.append(("stale", tok, "named in %d place(s), backed by nothing — %s"
                    % (len(stale[tok]), ", ".join(stale[tok][:3]))))
    return out


def main():
    argv = _root(list(sys.argv[1:]))
    as_json = "--json" in argv
    reg = registry()
    bad = disagreements(reg)

    if as_json:
        hist = reg.pop("history", {})
        print(json.dumps({"live": reg, "history": hist,
                          "disagreements": [{"kind": k, "name": n, "why": w} for k, n, w in bad]},
                         indent=2))
        return 1 if bad else 0

    print("LIVE  what this distribution ships, read from the tree\n")
    for label, key in (("scripts", "scripts"), ("hooks", "hooks"), ("procedures", "procedures"),
                       ("agent hooks", "agent_hooks"),
                       ("agents", "agents"), ("commands", "commands")):
        v = reg[key]
        head = ", ".join(v[:5]) + ("…" if len(v) > 5 else "")
        print(f"  {label:12} {len(v):3}   {head}")

    print()
    hist = reg.get("history") or {}
    if hist:
        # COUNTED, NEVER SILENT. A tier that hides mentions must say how many it hid, or a
        # rule that swallowed a real defect would be indistinguishable from a clean tree.
        print(f"  history      {sum(len(v) for v in hist.values()):3}   past-tense mention(s) of "
              f"{len(hist)} retired name(s) — the record doing its job, not a disagreement "
              f"(--json lists each)\n")
    if not bad:
        print("  nothing the docs call live is missing from the tree.")
        return 0
    print(f"  {len(bad)} DISAGREEMENT(S) — the docs say live, the tree says otherwise:\n")
    for kind, name, why in bad:
        print(f"    {kind:8} {name}")
        print(f"             {why}")
    return 1


if __name__ == "__main__":
    sys.exit(main())
