#!/usr/bin/env python3
"""wf-upstream — the inbox for the rows a project cannot fix, because workforce owns them.

    wf-upstream --root <tree>                  report which deferred rows belong upstream
    wf-upstream --root <tree> --execute        write one file per row into the inbox
    wf-upstream --list [--json]                open rows in the inbox (what `dev` reads)
    wf-upstream --resolve <id> --version X     close a row, naming the release that fixed it
    wf-upstream --resolve <id> --version X --execute
    wf-upstream --recheck [--verbose]          re-apply the harvest rule to every open row
    wf-upstream --recheck --execute            mark the rows it no longer takes `withdrawn`

WHY THIS EXISTS. `references/deferred.md` keeps exactly two categories of row alive across
runs, and one of them is **a fix in another repository** — in practice, this distribution.
That carve-out is honest about its own limit: *"Nothing in this distribution reaches into
another repository, and nothing here claims to: the upstream fix is made by a human running
that command in that tree."* The closing mechanism was *"a person noticing the paragraph and
opening a session by hand"*, which the same file calls **a rule with a reader and no
producer**.

MEASURED 2026-09-25 on `university`, audit run `audit-20260925T180537Z`: seven surviving rows
(`INV-DEFERRED … remaining 7`), every one of them workforce's own defect, and **three of them
carried through three or more audits**.
Row 7 — *"No shipped script writes the WF-HOUSE-RULES region"* — was re-verified and re-filed on
2026-08-20, 2026-09-14 and 2026-09-25, and that run wrote the region by hand rather than wait a
fourth time. Rows 2 and 3 asked the install to ship catalog rows that are the project's own, so
they could never have been discharged as written. Nothing on the workforce side read any of it.

So the row leaves the downstream project and lands somewhere the maintainer's own session
looks: one file per row under `<config-root>/workforce/upstream/`, holding the row VERBATIM
with its evidence, its project, its run id and the installed version. `/workforce dev` lists
the open ones when it starts.

WHAT THIS DOES NOT CLAIM. It does not close the downstream row — `deferred.md` is explicit
that **the row is closed by the downstream run that re-runs its own reproduction and watches it
pass**, never by an upstream report asserting the fix shipped. `--resolve` records which
release a maintainer believes fixed it, which is a note for the next downstream audit to TEST,
not a discharge.

IDEMPOTENT. Re-running the same audit rewrites the same file in place, keyed on project slug
and row id; it never appends and never writes a second copy. A row already `resolved` stays
resolved while the project re-files it from the release that claimed the fix or an older one, and
is REOPENED when the project re-files it measured on a newer release: that is the downstream
reproduction failing against the fix, which is the one thing the close was waiting to learn.
"""

import argparse
import json
import os
import re
import sys
import time

MARKER = "wf-upstream: v1"
DIRNAME = "upstream"
# The marker statuses that take a row off `--list`. `resolved` is a maintainer's claim a release
# fixed it; `withdrawn` is this script's own retraction of a row its harvest rule should never have
# taken. They are kept apart because only the first is a claim the downstream audit has to test.
CLOSED_STATUSES = ("resolved", "withdrawn")


def config_root():
    """Personal config root. `$CLAUDE_CONFIG_DIR` relocates the whole `~/.claude` tree and is
    what `bin/dev-sandbox` sets, so reading it is what makes a sandboxed test a test of this
    code rather than of the live install. Same resolver as `wf-catalog.config_root`."""
    return os.environ.get("CLAUDE_CONFIG_DIR") or os.path.join(os.path.expanduser("~"), ".claude")


def inbox_dir():
    return os.path.join(config_root(), "workforce", DIRNAME)


# ── the two things a filename is built from, and why they are scrubbed ────────────────────
#
# THE FILENAME IS BUILT FROM PROJECT DATA. The slug comes from a path this process was handed
# and the row id comes from a Markdown cell in a file any process on the machine can write, so
# both are untrusted input to a path join. A row id of `../../../.claude/settings.local.json`
# would otherwise place a write outside the inbox entirely, and `deferred.md` is a file an
# agent edits — this is the same output-encoding class as `wf-catalog`'s run-id constraint,
# reached through a file rather than through a name.
#
# ALLOW-LIST, NOT A DENY-LIST. `..` stripping alone is the wrong shape: it has to be applied
# repeatedly to be correct, and it misses the separator forms (`/`, `\\`), the NUL byte, a
# leading `-` that turns the name into an option, and a name so long the write fails on
# ENAMETOOLONG. One character class answers all of them.
SAFE_RX = re.compile(r"[^A-Za-z0-9._-]+")
NAME_MAX = 72


def safe_part(text, fallback):
    """One path component, from untrusted text. Never empty, never `.`/`..`, never a switch."""
    part = SAFE_RX.sub("-", (text or "").strip())[:NAME_MAX].strip("-.")
    # A name that reduced to nothing, or to a relative-path token, is replaced rather than
    # patched: there is no repair that makes `..` into a component, and a silent empty string
    # would join to the inbox directory itself.
    if not part or part in (".", ".."):
        return fallback
    return part


def inbox_path(slug, row_id):
    """`(path, None)` or `(None, why)` — the file this row owns, verified to be INSIDE the inbox.

    The containment test is the assertion, not the scrubber. A scrubber is a claim about what
    it removed; comparing the RESOLVED parent against the resolved inbox is a measurement of
    where the write would actually land. `dirname(realpath(...)) == realpath(base)` rather than
    a prefix test, because a prefix test passes a path one directory deeper, and because
    resolving both sides is what catches an inbox entry that is a symlink out of the tree.
    """
    base = inbox_dir()
    name = "%s--%s.md" % (safe_part(slug, "project"), safe_part(row_id, "row"))
    full = os.path.join(base, name)
    try:
        real_base = os.path.realpath(base)
        real_full = os.path.realpath(full)
    except OSError as exc:
        return None, "could not resolve %s: %s" % (full, exc)
    if os.path.dirname(real_full) != real_base:
        return None, ("REFUSED — %s resolves to %s, which is not inside %s"
                      % (name, real_full, real_base))
    return full, None


# ── reading a project's queue, in either shape it is really written in ─────────────────────
#
# TWO SHAPES, AND BOTH ARE REAL. `references/deferred.md` § Location and shape specifies one:
# `| id | opened | opened by | what | discharged by | age | state |`. Every real queue this
# project has produced is written the other way — a run report with `##` sections (*Carried*,
# *Added this run*, *Discharged this run*) over tables whose columns are
# `| # | Finding | Evidence | What discharges it |`. A parser that accepted only the specified
# shape would have read `university`'s six open rows as zero, which is the failure this whole
# script is about, one layer down.
#
# So the columns are resolved BY HEADER NAME and the state by section heading, and a row is
# reported with the shape it was found in. A queue in neither shape is reported as unparsed,
# never silently as empty: `0 rows` and `could not read the rows` are different facts.
ID_COLS = ("id", "#", "row", "def")
WHAT_COLS = ("what", "finding", "was", "item")
# `resolution` is odyssey-alive's `| # | Gap | Resolution repo | Evidence |`, the header of every
# row that queue files upstream. Unmatched, the discharge cell fell back to the LAST column — the
# evidence — and two of its rows (27, BB-U5) were judged on a cell that never names a repository.
DISCHARGE_COLS = ("discharged by", "what discharges it", "discharges", "outcome",
                  "remedy", "fix", "resolution")
STATE_COLS = ("state", "status")
# A heading that says the rows under it are already closed. `audit` writes a *Discharged this
# run* section into the same file as the open ones, and recording those would re-open work the
# downstream run has already proven passing.
CLOSED_HEADING_RX = re.compile(r"\b(discharged|closed|resolved|reversal)\b", re.I)
# A CELL THAT OPENS WITH A DISPOSITION is the row recording its own close, whatever section it is
# in. odyssey-alive keeps its discharged proposals in the same file as its open rows, under a
# heading that names a run rather than a state — `| <proposal> | **DISCHARGED** — inserted into all
# 19 … |` — and fourteen such rows reached the inbox as open workforce defects. Uppercase and at
# the START of a cell, because that is the queue convention for a disposition; a finding that
# merely mentions a discharged row elsewhere in its prose is not one.
CLOSED_CELL_RX = re.compile(r"^(DISCHARGED|CLOSED|RESOLVED|WITHDRAWN)\b")
# `path:line` and `path:line,line` citations, backticked or bare. The evidence a maintainer
# needs to reproduce, carried across with the row rather than left behind in the project.
#
# THE EXTENSION IS NOT ALLOW-LISTED, and it was: `md|py|json|sh|ps1|txt|toml|yaml` — the
# languages THIS repository is written in. An upstream row is a defect measured in somebody
# else's tree, so the one thing its evidence is guaranteed not to be is a file type we ship.
# MEASURED 2026-10-02 against a real inbox: two entries of thirteen carried four `path:line`
# citations between them — `class-ajf-importer.php:166`, `class-stain-images.php:412`,
# `class-fabric-images.php:211`, `class-poly-images.php:304` — and both were written to disk
# reading "The row cites no `path:line`", with `deferred.md`'s malformed-row rule quoted
# against rows that had cited their evidence correctly. The maintainer who opens that entry to
# reproduce is told the evidence is not there while it sits in the verbatim block above.
#
# Any extension that LOOKS like one is taken: a letter first so a version number
# (`1.72:30`) is not a path, and a length bound so a sentence does not become one.
CITE_RX = re.compile(r"`?((?:[\w.@+-]+/)*[\w.@+-]+\.[A-Za-z][A-Za-z0-9]{0,9})"
                     r":(\d+(?:,\d+)*)`?")
ABS_PATH_RX = re.compile(r"(?<![\w`])(/(?:[\w.@+-]+/)*[\w.@+-]+)")
# WHAT NAMES THIS DISTRIBUTION. `deferred.md`'s BLOCKING rule says an other-repository row NAMES
# the repository's absolute path and the command that closes it there, so a path INTO this
# repository or its install is the strict signal. A path into any other repository is not a
# signal at all: it names where the fix lies, and that is somebody else's tree.
#
# THE CATEGORY IN WORDS WAS THE WRONG SIGNAL. `upstream`, `workforce` and `another repository`
# were each enough on their own, and MEASURED 2026-10-22 against the live inbox they let in rows
# that are not defects of this distribution at all — `F-6 | … a trailing comma upstream makes it
# a tuple`, a fix the project made to its own script; `7 — the phase-boundary clause | Rewritten
# upstream …`, a row the project closed itself. 45 of 68 open rows, every one matched `loose`. A
# row is now taken when it NAMES this distribution: its repository or install path, a script it
# ships, a reference file it ships, or the distribution by name.
WORKFORCE_PATH_RX = re.compile(r"claude-workforce|skills/workforce\b|"
                               r"\bworkforce/(?:bin|references|skills|agents)/", re.I)
WORKFORCE_WORDS_RX = re.compile(r"\bworkforce\s+(?:distribution|repository|repo|source)\b|"
                                r"/workforce\s+dev\b", re.I)
# The words a row uses for THIS distribution when its queue has already said which repository it
# means — `An upstream producer.`, `The install ships these rows.` Read only alongside a
# declaration that names workforce, never alone: alone, they are the category in words.
WEAK_RX = re.compile(r"\b(upstream|install(?:ed)?|shipped|ships|distribution|workforce)\b",
                     re.I)
# A file-level declaration that the whole queue is the carve-out. `university` opens with
# exactly this sentence, and it is the most reliable signal in the file — a run that wrote it
# had already classified every row it kept.
# MATCHED AGAINST WHITESPACE-COLLAPSED TEXT, because Markdown prose is hard-wrapped and this
# phrase is longer than a line. `university`'s preamble reads "a fix that lies in\nanother
# repository" — the sentence broken exactly between the two halves of the signal — and a pattern
# written over raw text missed it and left two of that project's six rows unrecorded. The period
# exclusion stays: it keeps the match inside one sentence, which is what makes it a declaration
# about this queue rather than two unrelated clauses a paragraph apart.
DECLARED_RX = re.compile(r"(fix|resolution)[^.]{0,80}\b(in|lies in)\b[^.]{0,40}"
                         r"another repositor", re.I)
# WHICH repository the declaration means, read off what follows it. `university` writes "a fix
# that lies in another repository, the `workforce` distribution" — the repository named in
# apposition — and `amishwbf.com` writes "in another repository — the plugin's own git repo, the
# production ASP host, the container image, or the workforce distribution". Only the first names
# THIS distribution as the repository its rows' fixes lie in.
DECLARED_NAMES_RX = re.compile(r"\w*\W{0,4}\s*(?:the\s+)?(?:odysseyalive/)?(?:claude-)?"
                               r"workforce\b", re.I)


def declaration(text):
    """`(declared, names_workforce)` for a whole queue file."""
    flat_text = plain(flat(text))
    found = False
    for m in DECLARED_RX.finditer(flat_text):
        found = True
        if DECLARED_NAMES_RX.match(flat_text, m.end()):
            return True, True
    return found, False


def flat(text):
    """`text` with every whitespace run collapsed to one space, for multi-word matching only."""
    return re.sub(r"\s+", " ", text or "")


def split_row(line):
    """Cells of a Markdown table row, or None. `|` inside backticks is not a separator."""
    s = line.strip()
    if not (s.startswith("|") and s.endswith("|")):
        return None
    cells, buf, tick = [], [], False
    for ch in s[1:-1]:
        if ch == "`":
            tick = not tick
        if ch == "|" and not tick:
            cells.append("".join(buf).strip())
            buf = []
        else:
            buf.append(ch)
    cells.append("".join(buf).strip())
    return cells


def _col(headers, wanted):
    """Index of the first header whose text contains one of `wanted`, or None."""
    for i, h in enumerate(headers):
        low = h.strip("* ").lower()
        for w in wanted:
            if w == low or w in low:
                return i
    return None


def plain(cell):
    """A cell with Markdown emphasis and backticks removed, for matching only. The row is
    always CARRIED verbatim — this is what the classifier reads, never what is written out."""
    return re.sub(r"[`*_]", "", cell or "")


def read_rows(root):
    """`(rows, note)` — every queue row in `deferred.md`, in either shape.

    A `row` carries its verbatim line, its id, what it says, its discharge cell, whether the
    section it sits in declares it closed, and the line number it was read from.
    """
    path = os.path.join(root, ".claude", "workforce", "deferred.md")
    if not os.path.isfile(path):
        return [], "no %s — this project has no queue" % os.path.relpath(path, root)
    try:
        with open(path, encoding="utf-8", errors="replace") as fh:
            text = fh.read()
    except OSError as exc:
        return [], "could not read %s: %s" % (path, exc)
    return parse_rows(text, os.path.relpath(path, root))


def parse_rows(text, where):
    """`(rows, note)` for the text of one queue file — `read_rows` without the read."""
    declared, declared_workforce = declaration(text)
    rows, heading, headers, tables = [], "", None, 0
    for n, line in enumerate(text.splitlines(), 1):
        if line.startswith("#"):
            heading, headers = line.lstrip("# ").strip(), None
            continue
        cells = split_row(line)
        if cells is None:
            headers = None
            continue
        if all(re.fullmatch(r":?-{2,}:?", c or "") for c in cells if c != ""):
            continue                      # the |---|---| separator
        if headers is None:
            headers, tables = cells, tables + 1
            continue
        i_id = _col(headers, ID_COLS)
        i_what = _col(headers, WHAT_COLS)
        i_dis = _col(headers, DISCHARGE_COLS)
        i_state = _col(headers, STATE_COLS)
        get = lambda i: cells[i] if i is not None and i < len(cells) else ""
        rows.append({
            "id": plain(get(i_id) if i_id is not None else cells[0]).strip(),
            "what": get(i_what) if i_what is not None else (cells[1] if len(cells) > 1 else ""),
            "discharge": get(i_dis) if i_dis is not None else cells[-1],
            "state": plain(get(i_state)).strip().upper(),
            "section": heading,
            "line": n,
            "verbatim": line.rstrip(),
            "declared": declared,
            "declared_workforce": declared_workforce,
            # `| Closed row | Fix, and how it was verified here |` — the table says what its rows
            # are in its first header cell, under a section heading that names only a run.
            "closed_table": bool(CLOSED_HEADING_RX.search(plain(headers[0]))),
        })
    if not rows:
        return [], ("%s holds no table rows in either shape `references/deferred.md` "
                    "describes (%d table header(s) seen)" % (where, tables))
    return rows, None


def shipped_scripts_named(text):
    """Scripts THIS distribution ships that `text` names, in the order it names them.

    Read off the directory this file is running from rather than a list: `wf-upstream` lives in
    the shipped `bin/`, so its siblings ARE the shipped scripts, and a list spelled here would
    be a second copy that goes stale the day a script is added or renamed.
    """
    here = os.path.dirname(os.path.abspath(__file__))
    try:
        names = sorted(n for n in os.listdir(here) if n.startswith("wf-"))
    except OSError:
        return []
    low = (text or "").lower()
    # Longest first, so `wf-code-eval` is not reported as `wf-code` by a shorter sibling.
    return [n for n in sorted(names, key=len, reverse=True) if n.lower() in low]


def shipped_files_named(text):
    """Reference files THIS distribution ships that `text` names, read off the shipped tree.

    A hyphenated name counts bare — `handbook-templates.md`, `procedure-for-procedures.md` name
    nothing else. A plain one counts only under a directory no project skill has: `audit.md`,
    `templates.md` and `references/platform.md` are names any project's own skills may carry,
    and `references/procedures/audit.md` is one only this distribution does.
    """
    base = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))),
                        "references")
    low = (text or "").lower()
    found = []
    for dirpath, _dirs, files in os.walk(base):
        for name in files:
            if not name.endswith(".md"):
                continue
            rel = os.path.relpath(os.path.join(dirpath, name), base).replace(os.sep, "/")
            # `workforce/references/<rel>` itself is WORKFORCE_PATH_RX's, read before this.
            forms = [name] if "-" in name else []
            if rel.startswith("procedures/"):
                forms.append("references/" + rel)
            if any(f.lower() in low for f in forms):
                found.append(rel)
    return sorted(found)


def names_workforce(text):
    """What in `text` names THIS distribution, described, or ''. Strongest signal first."""
    flat_text = plain(flat(text))
    m = WORKFORCE_PATH_RX.search(flat_text)
    if m:
        return "the workforce path %r" % m.group(0)
    named = shipped_scripts_named(flat_text)
    if named:
        return "the shipped script %s" % named[0]
    files = shipped_files_named(flat_text)
    if files:
        return "the shipped reference %s" % files[0]
    m = WORKFORCE_WORDS_RX.search(flat_text)
    if m:
        return "the distribution by name (%r)" % m.group(0)
    return ""


def closed_reason(row):
    """Why the project itself has already closed this row, or ''."""
    if row["state"] in ("CLOSED", "DONE", "DISCHARGED", "RESOLVED"):
        return "row state is %s" % row["state"]
    if CLOSED_HEADING_RX.search(row["section"] or ""):
        return "sits under §%s, which records rows already closed" % row["section"]
    if row.get("closed_table"):
        return "sits in a table whose first column is headed as closed rows"
    for cell in (split_row(row["verbatim"]) or [])[1:]:
        m = CLOSED_CELL_RX.match(plain(cell).strip())
        if m:
            return ("a cell records it %s — the project closed this row itself, and its close "
                    "is not a defect" % m.group(1))
    return ""


def classify(row):
    """`(is_upstream, shape, why)` for one row.

    A row is taken when it is still OPEN in its own project and it NAMES this distribution as
    where the fix lies. `shape` is `strict` when the row obeys `deferred.md`'s BLOCKING rule —
    its discharge cell carries this repository's or this install's absolute path — and `loose`
    when the row names the distribution some other way: a shipped script, a shipped reference,
    the distribution by name. The distinction is reported rather than smoothed over: a
    loosely-matched row is one whose `discharged by` cell is malformed by the spec, and the
    maintainer reading the inbox has to reconstruct the reproduction the cell should have carried.
    """
    closed = closed_reason(row)
    if closed:
        return False, None, closed
    if not row["id"] or row["id"].lower() in ("id", "#", "row"):
        return False, None, "no row id"
    cell = plain(row["discharge"])
    paths = [p for p in ABS_PATH_RX.findall(cell)
             if p.count("/") > 1 and WORKFORCE_PATH_RX.search(p)]
    if paths:
        return True, "strict", "names %s" % paths[0]
    # THE WHOLE ROW, NOT ONE CELL. `university` row 1 names `wf-conform` in its finding and says
    # only `An upstream parser fix.` where the discharge belongs; row 16 names `wf-catalog` and
    # discharges with `Scan kept files as readers.` What the row is ABOUT is where it names us.
    named = names_workforce(row["verbatim"])
    if named:
        return True, "loose", ("names %s but no repository path — malformed per deferred.md, "
                               "recorded as found" % named)
    # A DECLARATION THAT NAMES THIS DISTRIBUTION speaks for a row that says `upstream` or `the
    # install` and nothing more: `university` row 7, `No shipped script writes the region` /
    # `An upstream producer.`, under "a fix that lies in another repository, the `workforce`
    # distribution". Both halves are required. The declaration alone took a table of handbook
    # line counts; the word alone took a project's note about its own trailing comma.
    if row.get("declared_workforce"):
        weak = WEAK_RX.search(plain(row["verbatim"]))
        if weak:
            return True, "loose", ("says %r under a queue declaration naming workforce as the "
                                   "repository — malformed per deferred.md, recorded as found"
                                   % weak.group(0))
        return False, None, ("the queue names workforce as the repository, and this row says "
                             "nothing of it — no workforce path, shipped script or file, and "
                             "not `upstream`, `install` or `shipped` — so the declaration does "
                             "not speak for it")
    # AND A DECLARATION THAT DOES NOT SAY WHICH REPOSITORY cannot speak for a row that names
    # nothing of ours. MEASURED 2026-10-02 on a real inbox: TEN of the rows one project filed
    # were taken on this sentence alone and not one of them was this distribution's — a
    # credential in the project's own legacy web sources, an accessibility defect in a plugin
    # that is its own git repository, a package absent from a container image, a dev container
    # that is not running, two stale backup archives.
    if row["declared"]:
        return False, None, ("the queue declares the another-repository carve-out, and the "
                             "declaration does not say WHICH repository: this row names no "
                             "workforce path, shipped script or shipped file of its own, so "
                             "nothing here says the defect is this distribution's")
    return False, None, ("names nothing of this distribution's — no workforce path, shipped "
                         "script or shipped file")


def citations(row):
    """Evidence `path:line` citations in the row, de-duplicated, in the order they appear."""
    out = []
    for text in (row["what"], row["discharge"], row["verbatim"]):
        for p, lines in CITE_RX.findall(text or ""):
            cite = "%s:%s" % (p, lines)
            if cite not in out:
                out.append(cite)
    return out


# ASCII digits, never `\d`: `\d` admits every Unicode decimal digit, which sorts above `9` and
# would let a planted `work/` name win the comparison and reach the markup un-constrained.
AUDIT_RUN_RX = re.compile(r"audit-[0-9]{8}T[0-9]{6}Z")


def current_run(root):
    """The run id this project is inside, or ''. Constrained to what a run id is rather than
    trusted to be one — it is written into the inbox file and into an HTML comment there.

    THE ONE RESOLVER, read by `wf-catalog` (the house-rules provenance stamp) and `wf-conform`
    (the undo-tree search) as well as here. `.current-run` ALONE WENT STALE: through 1.81.0 it
    was written "before the first conversion", so a re-audit that converted nothing never moved it.
    MEASURED 2026-10-29 on a copy of apps-odyssey-alive (downstream DEF-Q-24 (c)): the pointer
    still held `audit-20260911T152332Z` and the stamp named it, while the run executing was
    `audit-20261029T184052Z`, whose `work/` directory Step 0.01 had already made. Audit ids sort
    by time, so the newer of the pointer and the newest `work/audit-*` directory is the run; only
    names of that exact shape are compared, because `work/` also holds `amend-*` and `build-*`
    directories that sort after or before by prefix, not by date. A pointer of any other shape
    cannot be dated against them and is returned as written, which is what this did before.
    """
    try:
        with open(os.path.join(root, ".claude", "workforce", ".current-run"),
                  encoding="utf-8", errors="replace") as fh:
            run = (fh.read().strip().splitlines() or [""])[0].strip()
    except OSError:
        run = ""
    if not re.fullmatch(r"[A-Za-z0-9._-]{1,80}", run or "") or run in (".", ".."):
        run = ""
    work = os.path.join(root, ".claude", "workforce", "work")
    try:
        dirs = [n for n in os.listdir(work)
                if AUDIT_RUN_RX.fullmatch(n) and os.path.isdir(os.path.join(work, n))]
    except OSError:
        dirs = []
    if dirs and (not run or AUDIT_RUN_RX.fullmatch(run)):
        return max(dirs + [run])
    return run


def installed_version():
    for cand in (os.path.join(config_root(), "skills", "workforce", "references", "version.md"),
                 os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))),
                              "references", "version.md")):
        try:
            with open(cand, encoding="utf-8") as fh:
                m = re.search(r"^WORKFORCE-VERSION:\s*(\S+)", fh.read(), re.M)
            if m:
                return m.group(1)
        except OSError:
            continue
    return "unknown"


def version_key(text):
    """The numeric release `1.77.5` → `(1, 77, 5)`, or None. A suffix (`-rc1`, `+dev`) is
    ignored: it never makes one release newer than the same number without it."""
    m = re.match(r"(\d+(?:\.\d+)*)", (text or "").strip())
    return tuple(int(x) for x in m.group(1).split(".")) if m else None


def is_newer(measured, claimed):
    """True only when both are releases and `measured` is strictly the later one. An unreadable
    version on either side is not evidence the fix failed, so it keeps the close."""
    a, b = version_key(measured), version_key(claimed)
    if a is None or b is None:
        return False
    width = max(len(a), len(b))
    return a + (0,) * (width - len(a)) > b + (0,) * (width - len(b))


def header_fields(text):
    """The `key=value` pairs of an inbox file's marker comment."""
    m = re.search(r"<!--\s*%s\s*\|([^>]*)-->" % re.escape(MARKER), text or "")
    if not m:
        return {}
    out = {}
    for part in m.group(1).split("|"):
        if "=" in part:
            k, v = part.split("=", 1)
            out[k.strip()] = v.strip()
    return out


def render(slug, root, row, shape, why, run, version, reopened=""):
    """The inbox file for one row. `reopened` names the release whose claimed fix this re-filing
    measured as failing, when the row was resolved before it."""
    cites = citations(row)
    # THE MARKER CARRIES SCRUBBED VALUES, NEVER THE RAW CELL. `row["id"]` comes from a Markdown
    # table in a file an agent edits, and this comment is MACHINE-READ — `header_fields` parses
    # it and `--list`/`--resolve` act on its `status`. A row id containing `-->` closes the
    # comment early and puts the rest of the line into the rendered document; worse, a crafted
    # id can emit a second `status=resolved` pair and make a real open row vanish from `--list`.
    # Same output-encoding class, and the same remedy, as `wf-catalog.house_write`'s constraint
    # on `.current-run`: a value written into markup is constrained to what that value may be.
    # The VERBATIM row still appears below, inside a fenced block, which is where untrusted text
    # belongs — this scrubs the INDEX, not the evidence.
    row_key = safe_part(row["id"], "row")
    return "".join([
        "<!-- %s | project=%s | row=%s | status=open -->\n" % (MARKER, slug, row_key),
        "# %s — row %s\n\n" % (slug, row_key),
        "- status: **open**\n",
        ("- reopened: %s — marked resolved in `%s`, and this project re-filed it measured on "
         "`%s`, so the claimed fix did not hold there\n"
         % (time.strftime("%Y-%m-%d", time.gmtime()), reopened, version) if reopened else ""),
        "- project root: `%s`\n" % root,
        "- source: `.claude/workforce/deferred.md:%d`%s\n"
        % (row["line"], " (§%s)" % row["section"] if row["section"] else ""),
        "- run id: `%s`\n" % (run or "not recorded"),
        "- installed workforce: `%s`\n" % version,
        "- match: %s — %s\n" % (shape, why),
        "- recorded: %s\n\n" % time.strftime("%Y-%m-%d", time.gmtime()),
        "## The row, verbatim\n\n",
        "```\n%s\n```\n\n" % row["verbatim"],
        "## Evidence\n\n",
        ("".join("- `%s`\n" % c for c in cites) if cites
         else "_The row cites no `path:line`. `deferred.md` calls a row whose `Measured` "
              "evidence cannot be re-executed malformed for the same reason a bare flag is, "
              "so reproducing this one starts from the text above._\n"),
        "\n## Closing it\n\n",
        "A fix here does NOT close the downstream row. `references/deferred.md`: the row is "
        "closed by the downstream run that RE-RUNS its own reproduction and watches it pass, "
        "never by an upstream report asserting the fix shipped. Record the release that "
        "should do it with:\n\n",
        # THE FULL ID, not the bare row. Every project numbers its rows from 1, so a bare row
        # id names one row in each of them; `resolve_targets` refuses that rather than guessing,
        # and a hint printing the ambiguous form would walk the reader into the refusal.
        "```\nwf-upstream --resolve %s--%s --version <X.Y.Z> --execute\n```\n"
        % (slug, row_key),
    ])


def record(root, args):
    """Write (or refresh) one inbox file per upstream row. Returns an exit code."""
    root = os.path.abspath(root)
    slug = safe_part(os.path.basename(os.path.realpath(root)), "project")
    rows, note = read_rows(root)
    run, version = current_run(root), installed_version()
    try:
        written = time.strftime("%Y-%m-%d", time.gmtime(os.path.getmtime(
            os.path.join(root, ".claude", "workforce", "deferred.md"))))
    except OSError:
        written = ""
    picked, skipped = [], []
    for row in rows:
        up, shape, why = classify(row)
        (picked if up else skipped).append((row, shape, why))

    print("upstream inbox — %s" % root)
    if note:
        print("  %s" % note)
    for row, shape, why in picked:
        path, refuse = inbox_path(slug, row["id"])
        if refuse:
            print("  REFUSED   row %-10s %s" % (row["id"], refuse))
            continue
        name = os.path.basename(path)
        existing = ""
        if os.path.isfile(path):
            try:
                with open(path, encoding="utf-8", errors="replace") as fh:
                    existing = fh.read()
            except OSError:
                existing = ""
        # A ROW A MAINTAINER CLOSED STAYS CLOSED UNTIL A NEWER RELEASE FAILS IT. The downstream
        # project re-files the same row on every audit until its own reproduction passes, so a
        # re-filing from the release that claimed the fix, or an older one, says nothing new and
        # reopening on it would make the status field never hold still. A re-filing MEASURED ON
        # A NEWER release is the reproduction failing against the fix — `university` row 17,
        # 2026-10-14: rows 2, 3 and 11 marked resolved in 1.72.1, re-run against 1.77.5 and still
        # failing, and every `--execute` printed "left as the maintainer closed it" and wrote
        # nothing, so the one fact the close was waiting for never reached the maintainer.
        #
        # AND THE QUEUE MUST POSTDATE THE CLOSE. The version read here is the INSTALL's, today;
        # a queue last written before the maintainer closed the row measured an older release,
        # whatever is installed now. MEASURED on this machine: `amishwbf.com`'s queue was written
        # 2026-10-02 and its rows 11-13 closed 2026-10-03 in 1.74.0 — with the install at 1.80.1
        # a version test alone reopened all three on a queue that never saw the fix.
        fields = header_fields(existing)
        reopened = ""
        if fields.get("status") == "resolved":
            claimed = fields.get("version", "")
            closed_on = re.search(r"^- status: \*\*resolved\*\* in `[^`\n]*` \((\d{4}-\d\d-\d\d)\)",
                                  existing, re.M)
            if not is_newer(version, claimed):
                print("  resolved  row %-10s %s — left as the maintainer closed it (%s; "
                      "re-filed measured on %s)"
                      % (row["id"], name, claimed or "no version", version))
                continue
            if closed_on and not (written and written > closed_on.group(1)):
                print("  resolved  row %-10s %s — left as the maintainer closed it (%s on %s; "
                      "this queue was last written %s, so it never measured that release)"
                      % (row["id"], name, claimed, closed_on.group(1), written or "?"))
                continue
            # The marker is a file anything can edit; what is carried into the body is a release.
            reopened = claimed if VERSION_RX.fullmatch(claimed) else safe_part(claimed, "?")
        body = render(slug, root, row, shape, why, run, version, reopened)
        verb = ("reopen" if reopened else "add" if not existing else "update")
        detail = (" — resolved in %s, re-filed measured on %s" % (reopened, version)
                  if reopened else "")
        if not args.execute:
            print("  %-9s row %-10s → %s · %s%s"
                  % ("would " + verb, row["id"], name, shape, detail))
            continue
        try:
            os.makedirs(os.path.dirname(path), exist_ok=True)
            with open(path, "w", encoding="utf-8") as fh:
                fh.write(body)
        except OSError as exc:
            print("  REFUSED   row %-10s could not write %s: %s" % (row["id"], name, exc))
            continue
        print("  %-9s row %-10s → %s · %s%s"
              % ({"add": "added", "update": "updated", "reopen": "reopened"}[verb],
                 row["id"], name, shape, detail))
    if args.verbose:
        for row, _shape, why in skipped:
            print("  skipped   row %-10s %s" % (row["id"] or "?", why))
    print("\nINV-UPSTREAM %d row(s) read · %d upstream (%d strict · %d loose) · %d not · %s"
          % (len(rows), len(picked),
             sum(1 for _r, s, _w in picked if s == "strict"),
             sum(1 for _r, s, _w in picked if s == "loose"),
             len(skipped), inbox_dir()))
    if picked and not args.execute:
        print("DISPLAY ONLY — nothing written. Re-run with --execute.")
    return 0


def open_rows():
    """`[(path, fields, text)]` for every inbox file, resolved and open alike."""
    d = inbox_dir()
    out = []
    if not os.path.isdir(d):
        return out
    for name in sorted(os.listdir(d)):
        if not name.endswith(".md"):
            continue
        p = os.path.join(d, name)
        if os.path.islink(p) or not os.path.isfile(p):
            continue
        try:
            with open(p, encoding="utf-8", errors="replace") as fh:
                text = fh.read()
        except OSError:
            continue
        out.append((p, header_fields(text), text))
    return out


def do_list(args):
    rows = open_rows()
    op = [(p, f, t) for p, f, t in rows if f.get("status") not in CLOSED_STATUSES]
    count = lambda status: sum(1 for _p, f, _t in rows if f.get("status") == status)
    if args.json:
        json.dump({"inbox": inbox_dir(),
                   "open": [{"file": os.path.basename(p), "project": f.get("project"),
                             "row": f.get("row"),
                             "title": next((l[2:].strip() for l in t.splitlines()
                                            if l.startswith("# ")), "")}
                            for p, f, t in op],
                   "resolved": count("resolved"),
                   "withdrawn": count("withdrawn")},
                  sys.stdout, indent=2)
        sys.stdout.write("\n")
        return 0
    if not rows:
        print("upstream inbox: empty (%s)" % inbox_dir())
        print("  Nothing downstream has filed a workforce defect here. An audit files one at "
              "Step 7, through `wf-upstream --root <project> --execute`.")
        return 0
    for p, f, t in op:
        title = next((l[2:].strip() for l in t.splitlines() if l.startswith("# ")), "")
        why = next((l[2:].strip() for l in t.splitlines()
                    if l.startswith("- match:")), "")
        print("  OPEN  %-34s %s" % (os.path.basename(p), title))
        if why:
            print("        %s" % why[7:].strip() if why.startswith("match:") else why)
    print("\nINV-UPSTREAM %d open · %d resolved · %d withdrawn · %s"
          % (len(op), count("resolved"), count("withdrawn"), inbox_dir()))
    if op:
        print("Each is a defect a real project measured in THIS distribution and could not "
              "fix there. Close one with `wf-upstream --resolve <id> --version <X.Y.Z> "
              "--execute`.")
    return 0


# A release identifier, and nothing else. `--version` is written into the machine-read marker
# comment, so it is constrained rather than trusted for the same reason the row id is: a value
# holding `-->` closes the comment early, and one holding a second `status=` pair forges a field
# `--list` reads. Deliberately wider than strict semver — a maintainer may close a row against
# `1.72.0-rc1` or `1.72.0+dev` — and deliberately narrower than free text.
VERSION_RX = re.compile(r"[A-Za-z0-9][A-Za-z0-9.+_-]{0,39}")


def resolve_targets(want):
    """`(hits, refusal)` — the inbox rows `--resolve <want>` names, or why it named none.

    THREE SPELLINGS, AND THE LAST ONE IS GUARDED. `--list` prints `university--1.md`, so that is
    the form a person copies, and it has to work with or without the extension. A bare row id is
    the convenience, and it is the dangerous one: every project's queue numbers its rows from 1,
    so a bare `1` names row 1 of EVERY project in the inbox.

    MEASURED on this machine's real inbox with seven rows filed from `university`: neither
    `--resolve university--1.md` nor `--resolve university--1` matched anything. The old matcher
    asked whether the file stem ENDED WITH the separator followed by the whole id, which
    `university--1` never does — it would have to read `university--university--1`. So the only
    form that worked was a bare `1`, and a bare `1` closed row 1 of every OTHER project too,
    silently, on behalf of an operator looking at one. A convenience that quietly edits a queue
    nobody was looking at is worse than no convenience.

    (The old expression is described rather than quoted on purpose: `bin/check` asserts that it
    is GONE from this file, and a copy of it sitting in a docstring would satisfy the grep and
    make the assertion pass over the defect.)

    So an ambiguous bare row is REFUSED with its candidates named, never resolved by picking one
    of them. The full form is always available and always unambiguous, and the refusal says so.

    THE FILE STEM IS COMPARED WHOLE, never split on `--`. A scrubbed row id can itself contain
    `--` — `x-------wf-upstream-v1` is a real one, from a row id carrying a comment terminator —
    so splitting the stem on the separator is guesswork, and comparing the whole stem is not.
    """
    key = (want or "").strip()
    if not key:
        return [], "--resolve needs a row id. `wf-upstream --list` prints one per line."
    stem = key[:-3] if key.lower().endswith(".md") else key
    rows = open_rows()
    if not rows:
        return [], "the inbox at %s is empty" % inbox_dir()
    exact = [r for r in rows if os.path.basename(r[0])[:-3] == stem]
    if exact:
        return exact, ""
    bare = safe_part(stem, "")
    cands = [r for r in rows if safe_part(r[1].get("row", ""), "") == bare]
    if len(cands) > 1:
        return [], ("%r is row %s in %d projects, so it names none of them: %s. Pass the full "
                    "id as `--list` prints it."
                    % (key, bare, len(cands),
                       ", ".join(sorted(os.path.basename(p) for p, _f, _t in cands))))
    if cands:
        return cands, ""
    return [], ("no inbox row matching %r in %s. `wf-upstream --list` prints every id, and the "
                "full `<project>--<row>` form always resolves." % (key, inbox_dir()))


def do_resolve(args):
    if not (args.version or "").strip():
        print("wf-upstream: --resolve needs --version <X.Y.Z> — a row closed without naming "
              "the release that closed it is the uncited-refusal shape this inbox exists to "
              "end", file=sys.stderr)
        return 2
    if not VERSION_RX.fullmatch(args.version.strip()):
        print("wf-upstream: --version %r is not a release identifier. It is written into the "
              "machine-read marker this inbox is indexed by, so it is constrained to "
              "[A-Za-z0-9][A-Za-z0-9.+_-]{0,39} — a value carrying `-->` or a second `status=` "
              "pair would forge a field `--list` reads." % args.version, file=sys.stderr)
        return 2
    hits, refusal = resolve_targets(args.resolve)
    if refusal:
        print("wf-upstream: %s" % refusal, file=sys.stderr)
        return 1
    for p, f, t in hits:
        if f.get("status") == "resolved":
            print("  already   %s — resolved in %s" % (os.path.basename(p),
                                                       f.get("version", "?")))
            continue
        if f.get("status") == "withdrawn":
            print("  withdrawn %s — not a workforce defect by the harvest rule, so there is no "
                  "fix to name" % os.path.basename(p))
            continue
        new = re.sub(r"(<!--\s*%s[^>]*?)status=open" % re.escape(MARKER),
                     r"\1status=resolved | version=%s" % args.version, t, count=1)
        new = new.replace("- status: **open**\n",
                          "- status: **resolved** in `%s` (%s)\n"
                          % (args.version, time.strftime("%Y-%m-%d", time.gmtime())), 1)
        if not args.execute:
            print("  would close %s → resolved in %s" % (os.path.basename(p), args.version))
            continue
        try:
            with open(p, "w", encoding="utf-8") as fh:
                fh.write(new)
        except OSError as exc:
            print("  REFUSED   %s: %s" % (os.path.basename(p), exc))
            continue
        print("  closed    %s → resolved in %s" % (os.path.basename(p), args.version))
    if not args.execute:
        print("DISPLAY ONLY — nothing written. Re-run with --execute.")
        return 0
    print("\nThe DOWNSTREAM row is still open, and that is correct: it closes when that "
          "project re-runs its own reproduction and watches it pass.")
    return 0


# ── withdrawing what the harvest should never have taken ───────────────────────────────────
#
# THE RULE CHANGED UNDER ROWS ALREADY FILED. MEASURED 2026-10-22 on the live inbox: 68 open rows,
# about 45 of them no defect of this distribution — rows their project had already DISCHARGED,
# fragments of a table of handbook line counts, secrets rotation and plugin code in other trees —
# taken by the old rule and sitting in the queue a `dev` session reads first. Tightening the
# harvest stops new ones; it does nothing for those. `--recheck` applies the CURRENT rule to every
# open row and marks the ones it no longer takes `withdrawn`, with the reason.
#
# WITHDRAWN, NOT RESOLVED AND NOT DELETED. `resolved` names a release that fixed a defect, and
# there was no defect to fix — writing one would put a false claim in front of the next downstream
# audit. Deleting would destroy the record of what the old rule took, which is this measurement.
#
# THE ROW IS RE-READ IN ITS QUEUE WHEN IT IS STILL THERE. The inbox carries the row and its section
# but not its table's header or the file's declaration, and both decide the verdict: a table headed
# `Closed row` closes every row in it, and a declaration naming workforce speaks for a row that says
# only `An upstream producer.` So the project root the file records is read, and the same line
# found in it; only a row its queue no longer holds is judged from the inbox copy alone, and the
# output says which.
SOURCE_RX = re.compile(r"^- source: `\.claude/workforce/deferred\.md:(\d+)`(?: \(§(.*)\))?$", re.M)


def inbox_row(text, fields):
    """`(root, row)` rebuilt from an inbox file's own text; `row` is None when it carries none."""
    m_root = re.search(r"^- project root: `([^`\n]*)`$", text, re.M)
    m_src = SOURCE_RX.search(text)
    m_row = re.search(r"^## The row, verbatim\n\n```\n([^\n]*)\n```", text, re.M)
    root = m_root.group(1) if m_root else ""
    if not m_row:
        return root, None
    verbatim = m_row.group(1)
    cells = split_row(verbatim) or [verbatim]
    return root, {
        "id": fields.get("row") or plain(cells[0]).strip(),
        "what": verbatim, "discharge": verbatim, "state": "",
        "section": (m_src.group(2) or "") if m_src else "",
        "line": int(m_src.group(1)) if m_src else 0,
        "verbatim": verbatim,
        "declared": False, "declared_workforce": False, "closed_table": False,
    }


def recheck_one(text, fields):
    """`(taken, shape, why, read_from)` — the harvest rule applied to one filed row.
    `taken` is None when the file carries no verbatim row to judge."""
    root, row = inbox_row(text, fields)
    if row is None:
        return None, None, "the file carries no verbatim row", "the inbox file"
    queue = os.path.join(root, ".claude", "workforce", "deferred.md") if root else ""
    if queue and os.path.isfile(queue):
        try:
            with open(queue, encoding="utf-8", errors="replace") as fh:
                rows, _note = parse_rows(fh.read(), queue)
        except OSError:
            rows = []
        same = [r for r in rows if r["verbatim"] == row["verbatim"]]
        if same:
            hit = min(same, key=lambda r: abs(r["line"] - row["line"]))
            return classify(hit) + ("%s:%d" % (queue, hit["line"]),)
    return classify(row) + ("the inbox copy alone — the row is no longer in its queue",)


def do_recheck(args):
    rows = open_rows()
    op = [(p, f, t) for p, f, t in rows if f.get("status") not in CLOSED_STATUSES]
    kept = gone = unread = 0
    today = time.strftime("%Y-%m-%d", time.gmtime())
    print("upstream inbox recheck — %s" % inbox_dir())
    for p, f, t in op:
        name = os.path.basename(p)
        taken, shape, why, read_from = recheck_one(t, f)
        if taken is None:
            unread += 1
            print("  UNREAD    %s — %s; left open, because a row nobody could judge is not "
                  "one the rule rejected" % (name, why))
            continue
        if taken:
            kept += 1
            if args.verbose:
                print("  kept      %s · %s — %s" % (name, shape, why))
            continue
        gone += 1
        new = re.sub(r"(<!--\s*%s[^>]*?)status=open" % re.escape(MARKER),
                      r"\1status=withdrawn", t, count=1)
        new = new.replace("- status: **open**\n",
                          "- status: **withdrawn** %s — the harvest rule does not take it: %s "
                          "(read from %s)\n" % (today, why, read_from), 1)
        if new == t:
            print("  REFUSED   %s — its marker carries no `status=open` to change" % name)
            continue
        if not args.execute:
            print("  would withdraw %s — %s (read from %s)" % (name, why, read_from))
            continue
        try:
            with open(p, "w", encoding="utf-8") as fh:
                fh.write(new)
        except OSError as exc:
            print("  REFUSED   %s: %s" % (name, exc))
            continue
        print("  withdrawn %s — %s (read from %s)" % (name, why, read_from))
    print("\nINV-UPSTREAM-RECHECK %d open · %d kept · %d %s · %d unread · %s"
          % (len(op), kept, gone, "withdrawn" if args.execute else "to withdraw", unread,
             inbox_dir()))
    if gone and not args.execute:
        print("DISPLAY ONLY — nothing written. Re-run with --execute.")
    return 0


def main(argv=None):
    ap = argparse.ArgumentParser(add_help=True, description=__doc__.splitlines()[0])
    ap.add_argument("--root", default="", help="project root holding .claude/")
    ap.add_argument("--execute", action="store_true", help="write; default is a report")
    ap.add_argument("--list", action="store_true", help="open rows in the inbox")
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--resolve", metavar="ID", help="close an inbox row by its row id")
    ap.add_argument("--version", metavar="X.Y.Z", help="with --resolve: the fixing release")
    ap.add_argument("--recheck", action="store_true",
                    help="re-apply the harvest rule to every open inbox row; with --execute, "
                         "mark the rows it no longer takes withdrawn")
    ap.add_argument("--verbose", action="store_true",
                    help="also name the rows NOT taken (with --recheck: the rows kept)")
    args = ap.parse_args(argv)

    if args.resolve:
        return do_resolve(args)
    if args.recheck:
        return do_recheck(args)
    if args.list:
        return do_list(args)
    if not (args.root or "").strip():
        print("wf-upstream: --root is empty. ${CLAUDE_PROJECT_DIR} is unset outside a hook; "
              "pass an explicit path, or use --list to read the inbox.", file=sys.stderr)
        return 2
    if not os.path.isdir(args.root):
        print("wf-upstream: not a directory: %s" % args.root, file=sys.stderr)
        return 2
    return record(args.root, args)


if __name__ == "__main__":
    sys.exit(main())
