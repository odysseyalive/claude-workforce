#!/usr/bin/env python3
"""wf-dispatch-guard — PreToolUse hook on Bash and the edit tools: the main session stays free.

THE ASK (user, 2026-11-19): "The reason you have agents do coding and the bulk of the work is
so that the current session is free to take on more tasks, instead of having the actual
request queued. This should work for projects that have been audited and have the org file
and ones that haven't been audited." Every earlier fix (af50325, 89c606c, 91b3b6b) was a
sentence in `wf-task-tag`'s submit context, and sentences have now demonstrably failed.

THE MEASURED CAUSE. tmux-revive `a933f135` (2026-11-19, a project with no org, Claude Code
2.1.328). The submit context said "A job in this message goes to a background plain
`general-purpose` subagent". The session made one read-only Agent call in 58 tool calls, did
every project edit itself, and ran four foreground Bash calls with `timeout` set to 920000,
600000, 600000 and 520000 ms (`timeout 900 bash test/panel.sh ...`). The user's next two
messages sat Queued behind a ten-minute test. EVERY PROJECT EDIT IN THAT SESSION WENT
THROUGH BASH, ten of them, as `python3 - <<'EOF' ... open(p,'w')` and `sed -i`; its only
`Write` calls went to the scratchpad. A guard on the edit tools alone fires zero times there,
so this one reads Bash for the same edits.

TWO DENIALS, BOTH MAIN-SESSION ONLY. A payload with an `agent_id` is a subagent (or an agent
hook's own agent) and passes untouched: long work is what a subagent is for (`platform.md`
fact 22a: `agent_id` is present inside a subagent and absent on the main thread).

  1. A FOREGROUND BASH CALL THAT ASKS FOR MORE THAN THE HOST'S DEFAULT TIMEOUT (120000 ms)
     is denied every time. The reason says to re-issue it with `run_in_background: true`,
     which the host reports on exit, or to hand the job to a background subagent. A call
     with no `timeout` is left alone: the host moves it to the background at the default.

  2. THE FIRST FILE CHANGE OF A MAIN-SESSION TURN THAT HAS SPAWNED NO AGENT is denied ONCE.
     A file change is an `Edit`, `Write`, `MultiEdit` or `NotebookEdit`, or a Bash command
     that edits in place (`sed -i`, `perl -i`), feeds a heredoc to an interpreter whose body
     writes a file, or redirects a heredoc into one. The reason names the dispatch: the
     employee in the org chart whose description fits, or, with no chart, a plain
     background `general-purpose` subagent. Re-issuing the call is allowed, and so is every
     later change in that turn, so a genuine few-line fix costs one round-trip and a
     deliberate inline turn is never stopped twice.

WHAT IS NEVER DENIED BY HALF 2. A change whose target is outside the project, inside the
config root (memory files, plans, installed skills), inside the host's session temp tree
(`<tmp>/claude-<uid>/`, where the scratchpad is) or the payload's `scratchpad_dir`, inside
`.claude/workforce/` (work orders and hand-offs, which are written BEFORE the spawn), or named
`wf-asks.*` (the asks checklist). A Bash command whose own words name a path outside the
project or one of those places (a `../` path resolved against the payload's `cwd`), or a
`mktemp` directory, or that runs with its `cwd` outside the project, is not read as a project
edit, because its target cannot be resolved from its text. That errs toward allowing: a missed edit costs
nothing that was not already the case before this hook; a wrong deny costs the user a
round-trip.

MEASURED BY REPLAY, 2026-11-19, over every main-session transcript on the maintainer's machine
(2,288 turns, 11,080 Bash calls). Half 1 denies 692 calls. Half 2 denies in 224 turns, and every
one of the 224, listed and read, is the first in-project file change of a turn with no spawn
before it: none is a write outside the project, a command that writes nothing, or an exempt
target. The first draft got 10 wrong (`~/.codex`, `~/.config/hypr`, `~/.local/state`, a
`mktemp -d`, sibling projects), and the outside-path rule above is what removed them. On
`a933f135` it denies the first project edit of both of that session's turns and all 6 of its
long foreground calls. No turn in the corpus made its first change in the same response as its
first spawn, which is the case the transcript cannot show (below). RE-REPLAYED after the
review fixes (perl argument switches, stdin and stdout-buffer writes, `..` paths; 2,287 turns,
11,081 Bash calls): 696 and 227 denials, the identical set of fired turns as before the fixes.

A TURN is everything after the newest user row in the main transcript that is not a tool
result and not a host-written meta row. An agent is spawned when an assistant row in the turn
carries an `Agent` or `Task` tool call. The transcript holds none of the CURRENT response's
calls at PreToolUse (`wf-bash-stdin` header, measured 2026-11-10), so an edit sent in the same
response as its first spawn reads as agent-less; it is denied once, and the retry passes.

FAIL-OPEN AND SILENT ON NO SIGNAL. Always exits 0. A payload it cannot read, a transcript it
cannot find, a turn it cannot delimit, a marker it cannot create: no output, so the call runs
under the host's own permission rules.
"""
import json
import os
import re
import sys

HOST_DEFAULT_TIMEOUT_MS = 120000
EDIT_TOOLS = ("Edit", "Write", "MultiEdit", "NotebookEdit")
SPAWN_TOOLS = ("Agent", "Task")
# The chart `org index` writes carries this; `wf-task-tag.ORG_MARKER` is the same literal.
ORG_CHART = os.path.join(".claude", "workforce", "org-chart.md")
ORG_MARKER = b"AUTO-GENERATED by /workforce org index"
# How far back a turn is looked for. A turn longer than this is let through, not guessed at.
TURN_SCAN_BYTES = 32 * 1024 * 1024
_UNSAFE = re.compile(r"[^A-Za-z0-9_.-]")

# ── what counts as a Bash file change ──────────────────────────────────────────────────
HEREDOC = re.compile(r"<<-?[ \t]*(['\"]?)([A-Za-z_][A-Za-z0-9_]*)\1[^\n]*\n(.*?)^[ \t]*\2[ \t]*$",
                     re.S | re.M)
QUOTED = re.compile(r"'[^']*'|\"(?:\\.|[^\"\\])*\"")
# An `i` in a switch bundle is in-place, except in a perl switch that takes the rest of its
# word as an argument: `-MDigest::MD5`, `-MList::Util`, `-Ilib`, `-d:Trace`, `-F,`, `-xdir`
# all hold an `i` and edit nothing. Reviewed 2026-11-19: each was denied as a project edit.
IN_PLACE = re.compile(r"(?:^|[\s;&|(`])(?:g?sed|perl)\s+(?:[^\s;&|]+\s+)*?"
                      r"(?:-(?![MmIdDFx])[A-Za-z]*i[^\s]*|--in-place\S*)(?=\s|$)", re.M)
INTERPRETER = re.compile(r"(?:^|[\s;&|(`/])(?:python[0-9.]*|node|ruby|perl)\b")
# A write to a standard stream or a child's stdin pipe is not a file change:
# `sys.stdout.buffer.write(`, `proc.stdin.write(` (reviewed 2026-11-19, both were denied).
WRITES = re.compile(r"(?<!stdout)(?<!stderr)(?<!stdin)(?<!stdout\.buffer)(?<!stderr\.buffer)"
                    r"\.write\(|\bwrite_(?:text|bytes)\(|writeFileSync|"
                    r"\bopen\([^)\n]*['\"][wax]b?\+?['\"]")
REDIRECT = re.compile(r"(?<![0-9&>])>>?[ \t]*(?!&|[ \t]*/dev/)[^\s;&|<>]+|\btee\s+(?!/dev/)\S")
INLINE_SCRIPT = re.compile(r"(?:python[0-9.]*|node|ruby|perl)\s+(?:-\S+\s+)*?-[ce]\s")


def bash_changes_files(command):
    """True when this command edits a file in place, has an interpreter write one from a
    heredoc or an inline `-c`/`-e` script, or redirects a heredoc into one."""
    bodies = [m.group(3) for m in HEREDOC.finditer(command)]
    code = QUOTED.sub("''", HEREDOC.sub("\n", command))
    if IN_PLACE.search(code):
        return True
    for m in HEREDOC.finditer(command):
        head = command[command.rfind("\n", 0, m.start()) + 1:command.find("\n", m.start())]
        if INTERPRETER.search(head[:head.find("<<")]) and WRITES.search(m.group(3)):
            return True
        if REDIRECT.search(QUOTED.sub("''", head)):
            return True
    return bool(not bodies and INLINE_SCRIPT.search(command) and WRITES.search(command))


# ── where a change is never stopped ────────────────────────────────────────────────────
def _real(path):
    return os.path.realpath(os.path.expanduser(path))


def _under(path, root):
    return bool(root) and (path == root or path.startswith(root.rstrip(os.sep) + os.sep))


def exempt_roots(payload, project):
    """The places a main-session change is never stopped in, as real paths."""
    import tempfile
    roots = [_real(os.environ.get("CLAUDE_CONFIG_DIR") or "~/.claude"),
             _real(os.path.join(project, ".claude", "workforce"))]
    getuid = getattr(os, "getuid", None)
    if getuid:
        for tmp in {tempfile.gettempdir(), "/tmp", "/private/tmp"}:
            roots.append(_real(os.path.join(tmp, "claude-%d" % getuid())))
    scratch = payload.get("scratchpad_dir")
    if isinstance(scratch, str) and scratch:
        roots.append(_real(scratch))
    # A ROOT THAT HOLDS THE PROJECT EXEMPTS NOTHING, or a project made under the session temp
    # tree would have every edit exempt. Measured 2026-11-19: a live `claude -p` run in a
    # throwaway project under `<tmp>/claude-<uid>/` was never denied its first edit. The
    # PreToolUse payload on 2.1.328 carries no `scratchpad_dir` (same run), so the temp tree,
    # not that key, is what keeps a scratchpad write from being denied.
    home = _real(project)
    return [r for r in roots if not _under(home, r)]


def path_exempt(path, payload, project):
    if os.path.basename(path).startswith("wf-asks."):
        return True
    full = _real(path if os.path.isabs(path) else os.path.join(project, path))
    if not _under(full, _real(project)):
        return True
    return any(_under(full, r) for r in exempt_roots(payload, project))


# An absolute or home-relative path in a command's own words (quotes and heredoc bodies
# removed), and a quoted string that is nothing but such a path, wherever it is. Not the tail
# of a URL or of a relative path, and not a path inside a `sed` expression or edited text.
PATH_TOKEN = re.compile(r"(?<![\w.:/~$}\\-])(?:~|\$HOME|\$\{HOME\})?/[\w.@%+-][\w./@%+-]*")
PATH_LITERAL = re.compile(r"['\"]((?:~|\$HOME|\$\{HOME\})?/[\w.@%+-]+(?:/[\w.@%+-]*)*)['\"]")
HOME_PREFIX = re.compile(r"\A(?:~|\$HOME|\$\{HOME\})")
# A path that climbs out of the shell's directory: `..`, `../sibling/app.sh`.
PARENT_TOKEN = re.compile(r"(?<![\w.:/~$}\\-])\.\.(?:/[\w.@%+-]*)*(?![\w.@%+-])")
# The first change of directory in a command, and its target.
CHDIR = re.compile(r"(?:^|[\s;&|(])(?:cd|pushd)(?![\w-])(?:\s+([^\s;&|)]+))?")


def parent_paths(code):
    """The `..` paths whose base is the payload's `cwd`: those before the command's first
    `cd`, and that `cd`'s own target. After it the base is unknown, and every replayed
    command that climbed after a `cd` stayed inside the project (`cd .claude/agents &&
    ... ../workforce/...`, `cd <deep dir>; ... > ../notes.txt`), so those stay project edits."""
    m = CHDIR.search(code)
    head = code[:m.start()] + " " + (m.group(1) or "") if m else code
    return PARENT_TOKEN.findall(head)


def names_elsewhere(command, payload, project):
    """True when the command names any place outside the project, or an exempt one inside
    it, or a `mktemp` directory, or runs in a shell whose directory is outside the project,
    so it is not read as a project edit. A Bash command's target cannot be resolved from its
    text, so any such mention lets it through: replayed over this machine's transcripts, the
    commands it let through were edits to `~/.codex`, `~/.config/hypr`, `~/.local/state`, a
    `mktemp -d` and sibling projects. A `..` path is resolved against the shell's own
    directory, the payload's `cwd` (`parent_paths`): a `sed -i ... ../sibling/app.sh` edits
    the sibling, not the project."""
    if "wf-asks." in command or ".claude/workforce/" in command or "mktemp" in command:
        return True
    cwd = payload.get("cwd")
    cwd = cwd if isinstance(cwd, str) and os.path.isabs(cwd) else project
    if not _under(_real(cwd), _real(project)):
        return True
    home = os.path.expanduser("~")
    code = QUOTED.sub(" ", HEREDOC.sub("\n", command))
    for token in PATH_TOKEN.findall(code) + PATH_LITERAL.findall(command):
        token = HOME_PREFIX.sub(lambda _m: home, token)
        if not token.startswith("/dev/") and path_exempt(token, payload, project):
            return True
    return any(path_exempt(os.path.join(cwd, t), payload, project)
               for t in parent_paths(code))


def file_change(payload, project):
    """True when this main-session call changes a file half 2 guards."""
    tool, ti = payload.get("tool_name"), payload.get("tool_input")
    if not isinstance(ti, dict):
        return False
    if tool in EDIT_TOOLS:
        path = ti.get("file_path") or ti.get("notebook_path")
        return isinstance(path, str) and bool(path) and not path_exempt(path, payload, project)
    command = ti.get("command")
    return (tool == "Bash" and isinstance(command, str) and bash_changes_files(command)
            and not names_elsewhere(command, payload, project))


# ── the turn ────────────────────────────────────────────────────────────────────────────
def _lines_backward(path, limit=TURN_SCAN_BYTES):
    """The file's complete lines, newest first, reading at most `limit` bytes."""
    with open(path, "rb") as fh:
        fh.seek(0, os.SEEK_END)
        pos, tail, read = fh.tell(), b"", 0
        while pos > 0 and read < limit:
            step = min(1 << 16, pos)
            pos -= step
            fh.seek(pos)
            chunk = fh.read(step) + tail
            read += step
            parts = chunk.split(b"\n")
            tail = parts[0]
            for line in reversed(parts[1:]):
                yield line
        if pos == 0 and tail:
            yield tail


def _opens_turn(row):
    """True for a user row the user (or the host on the user's behalf) opened a turn with."""
    if row.get("type") != "user" or row.get("isMeta") or row.get("isSidechain"):
        return False
    content = (row.get("message") or {}).get("content")
    if isinstance(content, str):
        return True
    return isinstance(content, list) and any(
        isinstance(c, dict) and c.get("type") != "tool_result" for c in content)


def _spawns(row):
    content = (row.get("message") or {}).get("content")
    return isinstance(content, list) and any(
        isinstance(c, dict) and c.get("type") == "tool_use" and c.get("name") in SPAWN_TOOLS
        for c in content)


def current_turn(transcript):
    """(key, spawned) for the main session's open turn, or None when it cannot be found."""
    spawned = False
    try:
        for line in _lines_backward(transcript):
            if b'"type":"user"' not in line and b'"type":"assistant"' not in line:
                continue
            try:
                row = json.loads(line)
            except ValueError:
                continue
            if not isinstance(row, dict) or row.get("isSidechain"):
                continue
            if row.get("type") == "assistant":
                spawned = spawned or _spawns(row)
            elif _opens_turn(row):
                key = row.get("uuid") or row.get("promptId")
                return (str(key), spawned) if key else None
    except OSError:
        return None
    return None


def first_in_turn(payload, key):
    """True the first time this turn is asked; False after, and False when unsure.

    The marker is created with O_EXCL and never followed, so a link planted at its name in a
    shared temp directory reads as already told and is never written through (CWE-59). Same
    shape as `wf-bash-stdin.noted_once`."""
    d = payload.get("scratchpad_dir") or os.environ.get("TMPDIR") or "/tmp"
    name = "wf-dispatch-guard.%s.%s" % (
        _UNSAFE.sub("_", str(payload.get("session_id") or ""))[:64] or "nosession",
        _UNSAFE.sub("_", key)[:64])
    try:
        fd = os.open(os.path.join(d, name),
                     os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0), 0o600)
    except OSError:
        return False
    os.close(fd)
    return True


# ── what the model is told ──────────────────────────────────────────────────────────────
def dispatch_target(project):
    try:
        with open(os.path.join(project, ORG_CHART), "rb") as fh:
            if ORG_MARKER in fh.read(4096):
                return ("the employee in `%s` whose description fits, spawned with the Agent "
                        "tool and `run_in_background: true`" % ORG_CHART)
    except OSError:
        pass
    return ("a plain `general-purpose` subagent, spawned with the Agent tool and "
            "`run_in_background: true` (this project has no workforce org, which changes who "
            "takes the job and not whether it is handed off)")


LONG_REASON = (
    "Denied: this Bash call runs in the foreground of the main session with a %d ms timeout, "
    "longer than the host's %d ms default. While it runs the turn cannot end, and every "
    "message the user sends meanwhile waits as Queued. Re-issue the same call with "
    "`run_in_background: true`: the host notifies this session when it exits, so the turn can "
    "end and queued messages get through. Or hand the job to %s. Subagents are not held to "
    "this.")
INLINE_REASON = (
    "Denied once: this is the first file change of this turn in the main session, and no "
    "agent has been spawned this turn. Building inline holds the session, and the user's next "
    "messages wait as Queued until the build ends. Decide before going on. Hand the job to "
    "%s; or, if this is a few-line fix or the user asked for it to be done here, re-issue "
    "this exact call: the retry is allowed, and no later change in this turn is stopped.")


def deny(reason):
    return {"hookSpecificOutput": {"hookEventName": "PreToolUse",
                                   "permissionDecision": "deny",
                                   "permissionDecisionReason": reason}}


def decide(payload):
    """The hook's output for one payload, or None."""
    if payload.get("agent_id") or payload.get("hook_event_name") not in (None, "PreToolUse"):
        return None
    tool, ti = payload.get("tool_name"), payload.get("tool_input")
    if tool != "Bash" and tool not in EDIT_TOOLS or not isinstance(ti, dict):
        return None
    project = os.environ.get("CLAUDE_PROJECT_DIR") or payload.get("cwd") or os.getcwd()
    timeout = ti.get("timeout")
    if (tool == "Bash" and ti.get("run_in_background") is not True
            and isinstance(timeout, (int, float)) and not isinstance(timeout, bool)
            and timeout > HOST_DEFAULT_TIMEOUT_MS):
        return deny(LONG_REASON % (timeout, HOST_DEFAULT_TIMEOUT_MS, dispatch_target(project)))
    if not file_change(payload, project):
        return None
    transcript = payload.get("transcript_path")
    turn = current_turn(transcript) if isinstance(transcript, str) else None
    if turn is None or turn[1] or not first_in_turn(payload, turn[0]):
        return None
    return deny(INLINE_REASON % dispatch_target(project))


def main():
    try:
        payload = json.load(sys.stdin)
    except ValueError:
        return 0
    try:
        out = decide(payload) if isinstance(payload, dict) else None
    except Exception:   # a guard never breaks the call it reads
        out = None
    if out:
        print(json.dumps(out))
    return 0


if __name__ == "__main__":
    sys.exit(main())
