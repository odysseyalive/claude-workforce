#!/usr/bin/env python3
"""wf-catalog — resolve an evaluator catalog, from the install rather than from a copy.

    wf-catalog --root <tree>                     every kind: where it resolved, version, size
    wf-catalog --root <tree> --kind text --path  the resolved directory, one line, for scripts
    wf-catalog --root <tree> --kind code --grep RX   grep the resolved catalog
    wf-catalog --root <tree> --json              machine-readable, for audit and verify
    wf-catalog --root <tree> --migrate           classify each project copy: residue, or local content
    wf-catalog --root <tree> --migrate --execute remove what it PROVED is residue, and nothing else
    wf-catalog --root <tree> --house-rules       what the house-rules refresh would propagate
    wf-catalog --root <tree> --house-rules --execute  propagate it (audit Step 4 / Step 6-E)

WHY THIS EXISTS, and it is a measurement rather than a preference.

The catalogs are the same corpus in every project — OWASP categories, AI text tells, a
code mistake taxonomy. Nothing in them is project-specific. They were nevertheless COPIED
into every audited project, on the stated grounds that a copy "grows from the project's
own work" (`evaluators.md` § After the import, the dependency ends).

MEASURED 2026-09-10 across thirteen projects on one machine, twenty copies. The shipped
text catalog carries `creative-scrub-ref-version: 2`. Its copies carry **2, 1, 2, 2, 1,
absent, 2, 1, absent** — three stale by a version, two with no anchor at all — and their
`additions-seeded` records sit at none, 6, 6, 7 and 7. That is six states of one corpus.
The per-project copy exists to avoid two canonical texts and has produced six.

THE CAUSE IS THE THREE-PATHS RULE FAILING ON THE CORPUS ITSELF (`enforcement.md`). A copy
is written at audit and refreshed only by a later audit OF THAT PROJECT. `update` advances
the workforce install and has no reach into twenty copies in thirteen repositories, so a
project nobody re-audits is frozen at whatever shipped the day it was staffed.

WHAT THIS CHANGES, and what it deliberately does not. The CORPUS resolves from the install:
one copy, advanced by `update`, reachable from any project — including this repository
during `workforce dev`, which today can only reach a catalog by building itself an org.
The HOUSE RULES do not move. The supersession register and the precedence clause are the
genuinely project-specific layer — the register is the sole authority that demotes a
finding (`evaluators.md` § House rules dominate) — and they stay where they are, small and
local. That seam is not invented here: `audit` already refreshes the two separately, every
run, and prints `INV-HOUSERULES` for it. This moves the half that was never local.

RESOLUTION ORDER IS PROJECT-FIRST, AND THAT IS WHAT MAKES IT SAFE TO SHIP. A project that
holds a copy keeps being answered from it, byte for byte, until a migration proves the copy
is redundant. Directive one makes preservation the floor: a corpus is not made shared by
silently answering an existing project from somewhere new.

WHAT `--migrate` WILL AND WILL NOT REMOVE. **Removal is per FILE and it is UNCONDITIONAL on
content** — the user directive of 2026-09-10, stated in `classify`: *"the audit of a project
removes the old ones of the project ... No exceptions."* What survives is a closed list, and
every entry is make-before-break rather than a content proof:

  `CATALOG-ANCHOR.md`          the house rules, the supersession register, and everything
                               lifted into them — never removed, and the skill DIRECTORY is
                               never removed either
  a symlink                    removing files through one writes somewhere nobody named
  an `agents/`, `scripts/` or  capability the shipped evaluator does not also ship; removing
  `hooks/` file the install    it leaves a named capability reachable by zero paths
  does not ship
  a file a live reader cites   kept where its readers already point, each reader named in
  by any path form             the report, until the citation is moved

And what is SAVED before the rest goes, each read back and each blocking: every `origin:
user` span, a `WF-HOUSE-RULES` region an earlier audit propagated into a corpus file, and
the catalog rows the copy carries that no shipped file does — all into `CATALOG-ANCHOR.md`.
The whole removed set is archived byte-for-byte into `.claude/workforce/retired/` first.

*This contract is the third one, and the paragraph here described the FIRST two until
2026-09-25 while the code had moved on — it claimed "the proof is byte identity ... a file
differing by a sentence stays", which `classify` stopped doing on 2026-09-10. A header that
describes a safer script than the one underneath it is worse than no header: the reader who
checks before running is the one it misleads.* **The proof moved from the removal to the
retention: nothing is removed until what was only in it has been written somewhere that
stays, and verified there.**
"""

import argparse
import json
import os
import posixpath
import re
import shutil
import subprocess
import sys
import time

# The three built catalogs. `kind` is the directory under `references/catalogs/`; `skills`
# are the installed-skill directory names a project copy may occupy, in the spelling each
# generator used. NEVER a guess from a directory name — `evaluators.md` § The evaluators
# names these three and no others, and a fourth kind arrives by editing this table.
# `additions` is workforce's OWN authored slot for this kind, a file in the evaluator skill's
# own `references/`, named exactly as `wf-seed.CATALOGS` names it where wf-seed seeds the kind.
# A kind workforce has authored nothing for carries None, which is a first-class answer and
# never an empty file.
CATALOGS = {
    "code":     {"skills": ("code-evaluator",),     "anchor": "code-eval-ref-version",
                 "additions": "additions.md", "additions_anchor": "code-additions-version"},
    "text":     {"skills": ("text-eval",),          "anchor": "creative-scrub-ref-version",
                 "additions": "additions.md", "additions_anchor": "text-additions-version"},
    "security": {"skills": ("security-evaluator",), "anchor": "security-ref-version",
                 "additions": None,            "additions_anchor": None},
    # `design-eval` is a third spelling of the same concern, measured on `apps-odyssey-alive`
    # 2026-09-10. It is listed because a catalog nobody can NAME is a catalog nobody can
    # resolve, and the alternative is a copy that drifts under a synonym.
    "image":    {"skills": ("image-eval",),         "anchor": "image-eval-ref-version",
                 "additions": None,            "additions_anchor": None},
    # THE UI SLOT IS `rendered-checks.md`, and it always was workforce's authored half: its own
    # header calls it "the seed contribution", the entries the carried catalog did not cover. It
    # was listed as None, so the report never said the ui corpus has two provenances and a
    # project anchor recording `additions-seeded: tag=design` read against no slot. DEF-Q-12,
    # reported 2026-09-11 from apps-odyssey-alive. Named in place rather than renamed, because
    # handbooks cite `rendered-checks.md` by name.
    "ui":       {"skills": ("ui-design", "design-eval"), "anchor": "ui-design-ref-version",
                 "additions": "rendered-checks.md", "additions_anchor": "ui-additions-version"},
}

# The file a project's house rules live in, beside every evaluator copy and after every
# retirement. It is never shipped, so any file by this name under a project's skills root is
# the project's own.
ANCHOR = "CATALOG-ANCHOR.md"

# A tell that a copy carries the project's own words and is never removable, whatever else
# is true of it. BYTE-IDENTICAL to wf-conform's `IMMUTABLE_OPEN_RX` (bin/check § grammar
# asserts all readers accept the same blocks, and the inventory row for this file must be
# updated in the same change that touches this line).
#
# *Written wrong first, 2026-09-10, and caught by that check rather than by review.* The
# first version spelled the interior as a single literal `|` between two fixed fields, which
# REJECTS every legal marker carrying anything else — `<!-- origin: user | added: 2026-02-03
# | immutable: true -->` among them. A blind reader here is the dangerous direction: a copy
# whose sacred block this cannot see reads as having none, and `--migrate` would offer to
# delete the user's own words. The comment beside it claimed it was byte-identical to the
# canonical grammar, which made the defect invisible to anyone reading rather than running.
# ORDER-INDEPENDENT, and that is a correction. The pattern required `origin: user` BEFORE
# `immutable: true`, so `<!-- immutable: true | origin: user -->` — both fields present,
# fields reversed — was invisible: the copy read as carrying no sacred block, the retirement
# printed no PRESERVE line, and the words were removed with nothing reporting it. Found by
# an independent review before this shipped. A reader that is blind to a legal marker is the
# one direction that costs the user's own words, so both fields are required and neither
# position is.
# Written as a LITERAL in each compile, not bound to a name and reused. `bin/check`'s
# marker-reader extractor reads `re.compile` arguments out of the AST and can only see a
# string literal — passing a Name made both readers here invisible to it, and an inventory
# that counts zero readers in this file is a grammar guard that has stopped guarding.
IMMUTABLE_OPEN_RX = re.compile(
    r"^<!--(?=[^>]*\borigin:\s*user\b)(?=[^>]*\bimmutable:\s*true\b)[^>]*-->$", re.M)

# A comparable unit of catalog content: a markdown heading, or the first cell of a table
# row. Deliberately narrow. Prose reflows between versions and would report as a
# difference on every copy; headings and row keys are what an evaluator actually greps.
HEADING_RX = re.compile(r"^\s{0,3}#{1,6}\s+(.+?)\s*#*\s*$")
ROW_KEY_RX = re.compile(r"^\s*\|\s*([^|]+?)\s*\|")


def slurp(path):
    try:
        with open(path, encoding="utf-8", errors="replace") as fh:
            return fh.read()
    except OSError:
        return ""


def config_root():
    """Personal config root. `$CLAUDE_CONFIG_DIR` relocates the whole `~/.claude` tree and
    is what `bin/dev-sandbox` sets, so reading it is what makes a sandboxed test a test of
    this code rather than of the live install (SKILL.md § Dev Path Discipline)."""
    return os.environ.get("CLAUDE_CONFIG_DIR") or os.path.join(os.path.expanduser("~"), ".claude")


def scopes_collapse(root):
    """Are `<root>/.claude` and the personal config root the SAME directory?

    They are whenever the project IS `$HOME` — a real configuration, and the one this
    distribution is most often installed into — and whenever `$CLAUDE_CONFIG_DIR` or a
    symlink points one at the other. THE PROJECT/PERSONAL DISTINCTION THEN HAS NO
    REFERENT: `<root>/.claude/skills/text-eval` is the path `install` writes AND the path
    a project copy would occupy, and no test can tell them apart because there is nothing
    to tell apart. A migration that reports `no-install` there is refusing to retire a
    copy in favour of an install that is the same directory, and the remedy it implies —
    "retire the project copy so the user install is used" — names one directory twice.
    """
    return os.path.realpath(os.path.join(root, ".claude")) == os.path.realpath(config_root())


def walk_up_to_project(start):
    """The nearest directory at or above `start` carrying a `.claude/`, or None.

    `--root` DEFAULTS TO THE CURRENT DIRECTORY, AND THE CURRENT DIRECTORY IS NOT THE
    PROJECT. `$CLAUDE_PROJECT_DIR` is unset in the Bash tool — measured 2026-08-04 on
    2.1.221, the same fact `wf-apply`'s empty-`--root` guard exists for — so every
    documented reader form (`evaluators.md` and `procedures/audit.md` Step 5d both
    cite this script with no `--root`) falls through to `os.getcwd()`. A shell that has
    `cd`ed into a subdirectory then resolves against a tree with no `.claude/` in it, and
    two of the three `install_candidates` are root-relative, so a project-scope install
    one level up is invisible: the script exits 1 saying the catalog is `unresolved`.
    That is a FALSE ABSENCE, the failure class this project treats as worse than a crash,
    and the IC that reads it concludes the catalog does not exist.

    The walk is the same one every project tool performs by hand, and it stops at the
    FIRST `.claude/` rather than the outermost: a nested project is its own project, and
    answering it from the parent would resolve the wrong corpus. Finding nothing returns
    None and the caller keeps the root it was given, so a tree with no `.claude/` anywhere
    behaves exactly as it did before.
    """
    cur = os.path.abspath(start)
    while True:
        if os.path.isdir(os.path.join(cur, ".claude")):
            return cur
        parent = os.path.dirname(cur)
        if parent == cur:
            return None
        cur = parent


def install_candidates(root):
    """Ordered places the shipped catalogs can live, in the SAME order and for the same
    reasons as `wf-seed._slot_candidates` — project install, maintainer source tree, then
    personal install. Stated twice in two scripts is a restated constant (Core Principle
    9a); it is duplicated here rather than imported because a shipped script importing a
    sibling by path breaks whenever that sibling cannot be read, and `bin/check` asserts
    the two lists agree.

    Project candidates stay FIRST: a project-scope install must never be answered from the
    home copy, whatever version happens to sit there.
    """
    return [
        os.path.join(root, ".claude", "skills"),
        os.path.join(root, "workforce", "skills"),
        os.path.join(config_root(), "skills"),
    ]


def install_dir(root, kind):
    """The shipped corpus for `kind`, or None when workforce is installed nowhere.

    THE CORPUS IS THE EVALUATOR SKILL'S OWN `references/`, not a directory inside
    workforce. The user directive of 2026-09-10 is that the five evaluators are
    self-contained in the user install and `update` is the whole propagation path
    (SKILL.md § Directives), so `manifest.txt` installs each one as a SIBLING of
    `skills/workforce/` and its `references/` is the shipped catalog. One copy per
    install, advanced by `update`, read both by the skill and by any employee that greps
    it through this resolver.

    A DIRECTORY IS NOT ACCEPTED ON ITS NAME. It must carry the `SKILL.md` the manifest
    ships and bear corpus — the same `corpus_bearing` test the project side has used since
    2026-09-10, when a hollow `security-evaluator` answered `project v1 · 2 files` after a
    migration emptied it and a grep for SSRF hit the `description:` line and exited 0. An
    install directory can be hollow the same way, and a resolver that trusts a name gives
    a tier-3 IC a plausible answer from a corpus that is not there.

    None is a first-class answer and is reported as this script's own error. A resolver
    that invents a path when it cannot find one produces the failure `wf-live` exists to
    catch: a name that reads live and is backed by nothing.
    """
    # AN UNOWNED DIRECTORY IS NOT THE INSTALL, and this cost two agents in a test run
    # before it was added. `install_candidates` lists the project skills root FIRST — it has
    # to, so a project-scope install is never answered from `$HOME` — and a project's own
    # hand-authored `text-eval` sits at exactly the path a shipped one would. Without the
    # ownership test `install_dir` returned the project's own copy, so on `odyssey-alive`
    # `shipped_agents` read the project's agents as the shipped set, concluded the shipped
    # evaluator provided `prose-evaluator` and `structure-checker`, and removed both — two
    # agents carrying the project's voice rules that ship nowhere. The copy was also
    # reported as `source: install`, which is the resolver lying about its own answer.
    #
    # The maintainer tree is the ONE exempt base. `<root>/workforce/skills` is this
    # repository's source distribution: nothing installed it, by construction, and it is
    # what `workforce dev` reads.
    maintainer = os.path.join(root, "workforce", "skills")
    personal = os.path.realpath(os.path.join(config_root(), "skills"))
    for base in install_candidates(root):
        # THE PERSONAL SKILLS ROOT IS NOT OWNERSHIP-TESTED. The test separates a PROJECT's
        # copy from the install at the one path the two share, and at the personal root there
        # is no project copy to separate: a corpus-bearing evaluator there is the one the host
        # loads in every project, whoever wrote it. Two measured states needed this.
        #   UNDER SCOPE COLLAPSE `<root>/.claude/skills` IS this directory (the project is
        #   `$HOME`), so the test rejected the personal install's own address, `install_dir`
        #   returned None, and `classify` refused with `no-install` about the only corpus on
        #   the machine. See scopes_collapse.
        #   OUTSIDE ANY PROJECT the personal root is the only candidate. MEASURED 2026-09-14
        #   at a peer host on 1.58.0 whose customized evaluators pre-dated the install, so
        #   `install` kept them and recorded none: from `/tmp` with `CLAUDE_PROJECT_DIR` unset,
        #   `--kind code|text|security|ui --path` answered `unresolved` while `image`, the one
        #   kind the installer had placed, resolved. The corpus was on disk and in use.
        at_personal = os.path.realpath(base) == personal
        for name in CATALOGS[kind]["skills"]:
            skill = os.path.join(base, name)
            d = os.path.join(skill, "references")
            if not (os.path.isdir(d) and corpus_bearing(d)):
                continue
            if base != maintainer and not at_personal and not installer_owned(root, skill):
                continue
            return d
    return None


def additions_file(root, kind):
    """The shipped additions slot for `kind`, or None.

    WHY THIS IS PART OF RESOLUTION AND NOT A SEPARATE CONCERN. The corpus a project reads
    is the concatenation of two texts — the vendored catalog and workforce's own additions
    (`evaluators.md` § Seeding step 1b) — and a project COPY holds both, because `wf-seed`
    appends the additions into the copy as a machine-owned region. So a reader answered
    from the install and a reader answered from a copy were reading different corpora: the
    install side silently dropped every authored addition, 205 lines of text tells among
    them, and reported a clean resolution while doing it. Resolving the slot here is what
    makes `install` and `project` the same corpus rather than two.

    The directory is derived from `install_candidates` rather than listed again — the slot
    dir is the catalogs dir's sibling, and a second hardcoded list is the restated constant
    Core Principle 9a forbids and `bin/check` asserts against.
    """
    slot = CATALOGS[kind]["additions"]
    if not slot:
        return None
    # SAME TREE AS THE CORPUS, never a second independent walk. Two loops over the same
    # candidate list can still land in two different installs: a project-scope install
    # carrying `catalogs/text` but no `evaluator-additions/` resolved its corpus from the
    # repo and its additions from `$HOME`, printed as a plain `+ additions v7`, with no
    # mixing visible anywhere. `bin/check` names that exact state in a failure message and
    # passed green, because it compares the two SOURCE LISTS and both loops obeyed both
    # lists. The corpus decides the tree; the slot is read from it or it is absent.
    inst = install_dir(root, kind)
    if not inst:
        return None
    # SAME DIRECTORY AS THE CORPUS, which is what the sibling-skill layout makes possible:
    # the slot is a file in the skill's own `references/`, so corpus and additions cannot
    # come from two different installs. That mixing was a real state — a project-scope
    # install carrying `catalogs/text` but no `evaluator-additions/` resolved its corpus
    # from the repo and its additions from `$HOME`, printed as a plain `+ additions v7`.
    # It is now unrepresentable rather than guarded against.
    f = os.path.join(inst, slot)
    return f if os.path.isfile(f) else None


# Files a catalog skill carries that are NOT corpus. `SKILL.md` is the skill's own
# frontmatter and `CATALOG-ANCHOR.md` is the house rules and provenance record — the two
# files § Migration guarantees survive. A directory holding only these holds no corpus.
NON_CORPUS = {"SKILL.md", "CATALOG-ANCHOR.md"}


def corpus_bearing(d):
    """Does this directory still hold catalog content, as opposed to only its shell?

    THE MIGRATION EMPTIES A COPY AND LEAVES THE DIRECTORY STANDING — by design, because the
    house rules, handbooks and hooks live in it (§ Migration, "The skill directory is never
    removed"). So `os.path.isdir` is not the question. It was, until 2026-09-10, and the
    consequence was measured on a copy of odyssey-alive's `security-evaluator`: before
    migration `project v1 · 6 files · 573 lines`, after it `project v1 · 2 files · 142
    lines`, still answering `project`, with the taxonomy gone and the install never
    consulted. `--grep SSRF` then returned ONE hit — the `description:` line of `SKILL.md` —
    and **exited 0**, so a tier-3 IC reading the resolver got a plausible-looking answer
    from a corpus that was not there. A hollow copy is more dangerous than a missing one
    precisely because it resolves.
    """
    for f in catalog_files(d):
        rel = os.path.relpath(f, d)
        if os.path.basename(f) in NON_CORPUS and os.sep not in rel:
            continue
        if rel.split(os.sep)[0] in ("agents", "hooks"):
            continue
        return True
    return False


def installer_owned(root, skill_dir):
    """Did a run of `install` write this evaluator skill, by its own record?

    THE ONE QUESTION THAT SEPARATES A SHIPPED SKILL FROM A PROJECT'S OWN, and it became
    necessary the moment the evaluators started shipping as siblings: at PROJECT scope the
    shipped `text-eval` and a project's hand-authored `text-eval` resolve to the identical
    path, `<root>/.claude/skills/text-eval`. A path test cannot tell them apart and a
    basename test never could. `install` records every sibling it writes in
    `<workforce>/.installed-external`, per-path, and that record is the authority — the same
    record the installer's own prune rule 2 trusts before it deletes anything outside the
    workforce skill directory.

    Read from BOTH possible workforce installs, because a project may be answered by a
    project-scope install or by the personal one, and the record lives with whichever wrote
    the file.
    """
    marker = os.path.join(skill_dir, "SKILL.md")
    for base in (os.path.join(root, ".claude", "skills", "workforce"),
                 os.path.join(config_root(), "skills", "workforce")):
        rec = os.path.join(base, ".installed-external")
        try:
            with open(rec, encoding="utf-8") as fh:
                if any(line.strip() == marker for line in fh):
                    return True
        except OSError:
            continue
    return False


def project_skill_dir(root, kind):
    """The project's own evaluator skill directory — corpus or not — or None.

    THE DIFFERENCE FROM `project_dir` IS THE WORD `corpus`, AND IT IS THE DIFFERENCE
    BETWEEN A READER AND A RETIREMENT. Resolution must never be answered from a hollow
    copy, which is why `project_dir` requires `corpus_bearing`; retirement must not SKIP
    one, which is why this does not.

    MEASURED 2026-09-10 on a copy of `odyssey-alive`: `code-evaluator` and
    `security-evaluator` had already had their corpus migrated away by an earlier design,
    so `corpus_bearing` was false, `project_dir` returned None, and `--migrate` reported
    `no-copy — nothing to migrate` while a stale `SKILL.md`, a `scripts/lint-delta.sh` and
    two `AGENT.md` files sat in the tree. They would have survived every future run, which
    is the residue the user directive forbids outright — *"the audit of a project removes
    the old ones of the project ... No exceptions"* — hidden behind a verdict that reads
    like success.
    """
    # UNDER SCOPE COLLAPSE THERE IS NO PROJECT COPY, because there is no project
    # directory distinct from the install directory (see scopes_collapse). Retiring
    # what this returns would delete the personal install, so the answer is None and
    # `classify` reports `no-copy` — which is true: there is nothing to migrate,
    # the one copy on the machine is already the one being read.
    if scopes_collapse(root):
        return None
    for name in CATALOGS[kind]["skills"]:
        d = os.path.join(root, ".claude", "skills", name)
        if os.path.isdir(d) and not installer_owned(root, d):
            return d
    return None


def project_dir(root, kind):
    """The project's OWN copy of this catalog — never a shipped skill — or None.

    Three conditions, all required: the directory exists, it still bears corpus, and
    `install` did not write it. The third is the addition (2026-09-10) and without it every
    shipped sibling at project scope would be reported as a project copy and offered to the
    migration for deletion — the run would remove the files it had just installed and then
    resolve the kind from nowhere.

    A migrated copy falls through to the install, which is what makes `--migrate` a
    completed act rather than a severed read.
    """
    # The same collapse ruling `project_skill_dir` carries, for the same reason: under
    # collapse this path is the install's own address, and reporting the read as
    # `source: project copy` would label the install a copy of itself and count it as a
    # migration still owed on every audit, forever.
    if scopes_collapse(root):
        return None
    for name in CATALOGS[kind]["skills"]:
        d = os.path.join(root, ".claude", "skills", name)
        if os.path.isdir(d) and corpus_bearing(d) and not installer_owned(root, d):
            return d
    return None


def project_anchors(root, kind):
    """Every project house-rules file for `kind`, as `[(label, path)]`, in skill-name order.

    THE RULES AND THE AMENDMENTS ARE PART OF WHAT A READER RESOLVES, NOT A SEPARATE LOOK-UP.
    `--migrate` leaves `CATALOG-ANCHOR.md` standing on purpose: it holds the supersession
    register, the `origin: user` spans lifted out of the copy, and the project's own catalog
    amendments. The resolver then answered every read from the install alone, so none of it
    was reachable. MEASURED 2026-09-14 on apps-odyssey-alive (DEF-Q-12): a `--kind ui --grep`
    for the anchor's own `Project catalog amendments` heading exited 1 while the heading sat at
    `.claude/skills/design-eval/CATALOG-ANCHOR.md`. Every project rule ID was invisible to
    every read that resolves one, which is the only read tier-3 is told to make.

    EVERY SPELLING, not the first. `ui` has two directory names and a project can hold an
    anchor under either; stopping at the first would hide the second the same way.

    Not ownership-tested. The file is never shipped, so one found under a skill `install`
    wrote is still the project's own, written there by an audit.
    """
    out, seen = [], set()
    for d in house_dirs(root, kind):
        f = os.path.join(d, ANCHOR)
        if os.path.isfile(f) and os.path.realpath(f) not in seen:
            seen.add(os.path.realpath(f))
            out.append(("project:%s/%s" % (os.path.basename(d), ANCHOR), f))
    return out


def catalog_files(d):
    """Markdown in a catalog directory, recursively, sorted. Used for the INSTALL side and
    for reading a version anchor; the copy side walks `all_files`, which excludes nothing.

    *This excluded `hooks/` until 2026-09-10, on the reasoning that hook scripts "are
    migration subjects in their own right and are never corpus content". Both halves were
    true and the conclusion was not: the exclusion meant nothing read them, and the verdict
    computed without them then authorised deleting them. An exclusion that is safe in the
    function that has it is one reuse away from not being — so there is no exclusion.*
    """
    out = []
    for dirpath, dirnames, filenames in os.walk(d):
        dirnames[:] = [x for x in dirnames if not os.path.islink(os.path.join(dirpath, x))]
        out += [os.path.join(dirpath, f) for f in filenames if f.endswith(".md")]
    return sorted(out)


def anchor_version(d, key):
    """The integer a catalog stamps itself with, or None when it carries no anchor.

    None is REPORTED, never defaulted to zero. Two of the nine measured copies carry no
    anchor at all, and a zero would render them as "very stale" — a number the tree does
    not support, describing copies whose real state is that nothing tracks them.
    """
    rx = re.compile(re.escape(key) + r":\s*(\d+)")
    for f in catalog_files(d):
        m = rx.search(slurp(f))
        if m:
            return int(m.group(1))
    return None


def anchor_version_in(path, key):
    """The integer a single FILE stamps itself with, or None. Separate from
    `anchor_version`, which scans a directory: the additions slot is one file and asking a
    directory scanner for it would read the whole catalog looking for the wrong anchor."""
    if not path or not key:
        return None
    m = re.search(re.escape(key) + r":\s*(\d+)", slurp(path))
    return int(m.group(1)) if m else None


# The version stamp `wf-seed` writes into the region it appends, and the record it keeps in
# CATALOG-ANCHOR.md. Either answers "how far have the additions propagated into this copy";
# the region is authoritative because it is the content itself rather than a note about it.
# LINE-ANCHORED, both of them. An unanchored marker pattern reads prose ABOUT a marker as
# the marker — the failure this project has hit six times in one session, once
# under-reporting sacred blocks 21-against-59 while the extraction gate read that count.
SEEDED_REGION_RX = re.compile(
    r"^<!--\s*WF-ADDITIONS:[A-Za-z0-9_-]+\s+BEGIN\s+version=(\d+)", re.M)
SEEDED_RECORD_RX = re.compile(r"^<!--\s*additions-seeded:[^>]*?version=(\d+)", re.M)


def seeded_version(d):
    """The additions version a project COPY carries, or None when it carries none.

    WHY A COPY NEEDS THIS AND THE INSTALL DOES NOT. An install-resolved reader gets the slot
    file itself, at whatever version the install ships. A copy gets whatever `wf-seed` last
    appended into it — and `wf-seed` runs only inside an audit OF THAT PROJECT, so the
    additions drift exactly the way the vendored corpus did before the install became the
    source. MEASURED 2026-09-10 across `~/lab`: of twelve projects holding copies, **six
    carry no region at all** and three sit at text additions v6 against the install's v7.
    Every one of them reported `0 stale · 0 unresolved`, because staleness was measured on
    the vendored anchor alone and the additions were nobody's column.
    """
    best = None
    for f in catalog_files(d):
        text = slurp(f)
        for rx in (SEEDED_REGION_RX, SEEDED_RECORD_RX):
            for m in rx.finditer(text):
                v = int(m.group(1))
                best = v if best is None else max(best, v)
    return best


def corpus_files(d, additions=None):
    """Every file a reader of this corpus reads: the catalog directory, plus the shipped
    additions slot when the answer came from the install. This is the list `--grep` walks
    and the list the report counts, so the two can never disagree about what the corpus is.
    """
    # THE SLOT SITS INSIDE `d`. Since the sibling layout (2026-09-10) `additions.md` is a file
    # of the skill's own `references/`, so `catalog_files` already lists it, and appending it
    # again read it twice: every `--grep` hit in the additions printed twice and the report
    # counted 8 code files where 7 ship. MEASURED 2026-09-14 on this repository.
    files = catalog_files(d)
    return files + ([additions] if additions and additions not in files else [])


def norm(text):
    """A corpus file reduced to the form two copies of the SAME shipped file share.

    Three things legitimately differ between the install's copy of a file and a project's,
    and none of them is content: the machine-owned `WF-ADDITIONS` region `wf-seed` appends,
    the version-anchor comment each side stamps itself with, and trailing whitespace. Every
    other byte is content, and a difference in it means the two files are not the same file.
    """
    # THE CLOSING MARKER IS `<!-- WF-ADDITIONS:<tag> END -->`, which is what `wf-seed`
    # writes (`wf-seed._REGION_END`). This pattern demanded `<!-- /WF-ADDITIONS:… -->`, a
    # spelling nothing has ever emitted, so the region was never stripped and the ONE file
    # per catalog that wf-seed seeds could never normalise equal. Measured 2026-09-10 on
    # odyssey-alive's `mistake-taxonomy.md`: 24940 normed bytes against the install's 9606,
    # classified `STAYS (differs)`; with this grammar the two are byte-identical. Both
    # spellings are accepted, because a tree seeded by some earlier hand-mirror may carry
    # either and a stripper that is wrong in one direction is how this defect started.
    text = re.sub(
        r"<!--\s*WF-ADDITIONS:(?P<tag>[A-Za-z0-9_-]+)\s+BEGIN.*?"
        r"<!--\s*/?WF-ADDITIONS:(?P=tag)(?:\s+END)?\s*-->",
        "", text, flags=re.S)
    text = re.sub(r"^<!--[^>\n]*-version:\s*\d+[^>\n]*-->\s*$", "", text, flags=re.M)
    text = re.sub(r"^<!--\s*additions-seeded:[^>\n]*-->\s*$", "", text, flags=re.M)
    return "\n".join(line.rstrip() for line in text.splitlines()).strip()


def install_index(root, kind):
    """The shipped corpus for `kind`, indexed BOTH ways: by basename, and by NORMALISED
    CONTENT.

    THE CONTENT INDEX IS THE CORRECTION, and it is why three of five kinds could never
    migrate. Removability was keyed on basename equality, so a copy holding a byte-identical
    duplicate of the shipped corpus under a different filename was unremovable FOREVER — no
    content it could ever hold would lift it, because the comparison never ran. MEASURED
    2026-09-10 on `odyssey-alive`: the install ships `text/text-tells.md`,
    `image/image-tells.md` and `ui/ui-checks.md`; the copies hold `references/ai-patterns.md`,
    `references/watercolor.md`, `references/design-quality-catalog.md` and eighteen more.
    **Zero basename overlap across three kinds**, so `--migrate` answered `keep-all — no file
    here is identical to a shipped file of the same name` on every one of them, and that
    sentence reads as a plumbing fault rather than as a verdict.

    Keying on content makes the proof STRICTER, not looser. Basename equality was never
    evidence of anything on its own — identity did all the lifting and still does. What goes
    away is a precondition that could veto identity.

    AN EMPTY NORMALISED BODY IS EXCLUDED, and that exclusion is load-bearing. A file reduced
    to nothing but its version anchor normalises to the empty string (`norm` strips anchors
    by design), and an empty key would match every other such file in the tree — turning two
    unrelated stub files into "byte-identical" and authorising a removal on no evidence at
    all. Identity between two empty bodies is true and means nothing.
    """
    inst = install_dir(root, kind)
    by_name, by_content = {}, {}
    for f in catalog_files(inst) if inst else []:
        by_name.setdefault(os.path.basename(f), f)
        body = norm(slurp(f))
        if body:
            by_content.setdefault(body, f)
    return by_name, by_content


def shipped_content_match(root, kind, proj):
    """Does ANY file in this copy carry content the install already ships for `kind`?

    The question `resolve` needs to tell two project-side states apart, and they are opposite
    in what they call for: a copy that duplicates the shipped corpus (drift — migrate it) and
    a copy that is the project's own different catalog (keep it, and say what it hides).
    """
    _by_name, by_content = install_index(root, kind)
    if not by_content:
        return False
    for f in all_files(proj):
        body = norm(slurp(f))
        if body and body in by_content:
            return True
    return False


def corpus_pairs(root, kind):
    """(project_file, install_file, identical) for every file in the copy that the install
    also ships under the same basename, plus the copy's files that match nothing.

    WHY BASENAME AND BYTE-IDENTITY, and this replaced a heading-and-row comparison that an
    independent code evaluation broke on its first attempt (2026-09-10, findings 1, 2 and 7).
    That comparison asked "is every heading and table-row key in the copy present in the
    install", which is blind to the shape project judgement is usually written in — a
    paragraph or a bullet under an existing heading. A copy carrying

        Project rule: never flag anything under `legacy/vendor-shim/` as dead

    classified as pure residue, because it introduced no new heading. It also compared the
    copy's WHOLE SKILL — `SKILL.md`, `CATALOG-ANCHOR.md`, `agents/*/AGENT.md` — against a
    directory that structurally holds only corpus files, so on three real projects it
    reported 25, 22 and 35 "missing units" that were skill frontmatter and anchor
    provenance, and printed a remedy telling a maintainer to lift `by`, `date` and
    `command` into `evaluator-additions/`.

    So the question is no longer "is the copy covered" but "is THIS FILE the shipped file".
    A file the install does not ship under that name is never comparable and is never
    removable, whatever it contains. That makes the register, the anchor, the handbooks, the
    scripts and the hooks unremovable by construction rather than by a gate that has to
    recognise each of them — the previous design's every gate was a chance to fail open.
    """
    inst = install_dir(root, kind)
    proj = project_dir(root, kind)
    if not inst or not proj:
        return [], []
    by_name, by_content = install_index(root, kind)
    pairs, unmatched = [], []
    for f in all_files(proj):
        body = norm(slurp(f))
        twin = by_content.get(body) if body else None
        if twin is not None:
            pairs.append((f, twin, True))
            continue
        # Same basename, different content. Still comparable, and still unremovable — but it
        # is reported as a DIFFERENCE rather than as "the install ships nothing like this",
        # which is the distinction a maintainer reading the verdict needs.
        twin = by_name.get(os.path.basename(f))
        if twin is None:
            unmatched.append(f)
        else:
            pairs.append((f, twin, False))
    return pairs, unmatched


def all_files(d):
    """EVERY file in a copy, not just markdown and not excluding `hooks/`.

    The earlier version walked `*.md` and skipped `hooks/` — so hook scripts, `scripts/*.sh`
    and any `.csv`, `.txt` or `.json` beside them were examined by nothing and then deleted
    by a verdict computed without them. A file that no analysis has read is a file no
    analysis can authorise removing.
    """
    out = []
    for dirpath, dirnames, filenames in os.walk(d):
        dirnames[:] = [x for x in dirnames if not os.path.islink(os.path.join(dirpath, x))]
        out += [os.path.join(dirpath, f) for f in filenames]
    return sorted(out)


def has_user_span(d):
    """The first file carrying the user's own words, by path relative to `d`.

    Relative rather than basename: two `guards.md` in different subdirectories reported
    identically before, which is a report that cannot be acted on.
    """
    for f in all_files(d):
        if IMMUTABLE_OPEN_RX.search(slurp(f)):
            return os.path.relpath(f, d)
    return None


def resolve(root, kind):
    """Where this project reads `kind` from today, and everything a report needs to say so.

    `source` is `install` whenever a shipped corpus is reachable, and `project` only when
    there is none. **THE ORDER IS INSTALL-FIRST, and that reverses what shipped in v1.48.0.**

    Project-first was the safe order while the corpus lived inside workforce and the five
    skills were per-project: answering an existing project from somewhere new would have
    changed its evaluations silently. It is the WRONG order now that the skills themselves
    ship. The user directive of 2026-09-10 states the requirement — *"the audit of a project
    removes the old ones of the project so that the one in the user space is the one that's
    being used ... No exceptions"* — and project-first inverted it: on `odyssey-alive` three
    of five kinds answered from a stale local copy while the install carried the current
    corpus, and `update` could never change that.

    Preservation is not paid for by the order, it is paid for by the MIGRATION: `--migrate`
    lifts every `origin: user` span and the house rules into `CATALOG-ANCHOR.md`, which
    stays, before it removes anything (§ classify). Directive one is retention, and a line
    living verbatim in the house-rules file has been retained.
    """
    inst, proj = install_dir(root, kind), project_dir(root, kind)
    chosen, source = (inst, "install") if inst else (proj, "project")
    # The additions slot completes an INSTALL-side answer only. A project copy carries the
    # same text already, inlined by `wf-seed` as a `WF-ADDITIONS` region, so adding the slot
    # there would grep it twice and count it twice.
    adds = additions_file(root, kind) if (chosen and source == "install") else None
    info = {
        "kind": kind,
        "source": source if chosen else "unresolved",
        "path": chosen,
        "install_path": inst,
        "project_path": proj,
        "additions_path": adds,
        "additions_version": (
            anchor_version_in(adds, CATALOGS[kind]["additions_anchor"]) if adds else None),
        "version": anchor_version(chosen, CATALOGS[kind]["anchor"]) if chosen else None,
        "install_version": anchor_version(inst, CATALOGS[kind]["anchor"]) if inst else None,
        "files": len(corpus_files(chosen, adds)) if chosen else 0,
        "lines": sum(len(slurp(f).splitlines()) for f in corpus_files(chosen, adds)) if chosen else 0,
    }
    # The project's house rules, read beside the corpus. A copy answering as `project` already
    # lists its own anchor among its files, so only anchors outside the chosen corpus count.
    in_corpus = {os.path.realpath(f) for f in corpus_files(chosen, adds)} if chosen else set()
    info["anchors"] = [f for _l, f in project_anchors(root, kind)
                       if os.path.realpath(f) not in in_corpus]
    # ADDITIONS STALENESS, project side. The install ships the slot; a copy holds a snapshot
    # of it, and until now nothing compared the two.
    info["seeded_version"] = seeded_version(chosen) if (chosen and source == "project") else None
    slot_v = anchor_version_in(
        additions_file(root, kind), CATALOGS[kind]["additions_anchor"])
    info["slot_version"] = slot_v
    info["additions_missing"] = bool(
        source == "project" and slot_v is not None and info["seeded_version"] is None)
    info["additions_stale"] = bool(
        source == "project" and slot_v is not None
        and info["seeded_version"] is not None and info["seeded_version"] < slot_v)

    iv, v = info["install_version"], info["version"]
    info["stale"] = bool(source == "project" and iv is not None and v is not None and v < iv)
    info["untracked"] = bool(source == "project" and v is None)
    return info


IMMUTABLE_SPAN_RX = re.compile(
    r"^<!--(?=[^>]*\borigin:\s*user\b)(?=[^>]*\bimmutable:\s*true\b)[^>]*-->$"
    r"(?P<body>.*?)(?=^<!--\s*/origin\s*-->$|\Z)", re.M | re.S)

PRESERVE_HEADING = "## Preserved from the retired project copy"

# ── the house rules, and the producer `audit` Step 4 and Step 6-E both require ──────
#
# THE REGION HAD NO WRITER. `audit.md` § Step 4 ("Refresh the house rules in every
# installed evaluator, every run") and Step 6-E both mandate this write "never skipped,
# never offered, never a question", both print `INV-HOUSERULES`, and no shipped script
# emitted a single byte of it: `grep -rl WF-HOUSE-RULES` over the install's `bin/`
# returned nothing on 2026-08-20, 2026-09-14 and again on 2026-09-25, three audits of
# one project apart. The 2026-09-25 run wrote `image-eval`'s region BY HAND from
# `code-evaluator`'s. A step performed by whoever remembers is the shape `wf-seed` and
# `wf-companion` were both built to end, and this is the third of the same family.
#
# THE REGION'S HOME IS `CATALOG-ANCHOR.md`, which `--migrate` leaves standing by
# construction. An earlier audit propagated the rules into `references/guards.md` and
# `references/ai-patterns.md` — corpus files — and the retirement removed the first of
# them, house rules included, after Step 6-F had promised they survive (recovered from
# `retired/` by hand). A region found in any other file of the evaluator is RELOCATED
# here, which is the same repair made once rather than every audit.
HOUSE_START = ("<!-- WF-HOUSE-RULES START — propagated by /workforce audit; "
               "machine-owned, safe to replace -->")
HOUSE_END = "<!-- WF-HOUSE-RULES END -->"
HOUSE_RX = re.compile(
    r"^<!--\s*WF-HOUSE-RULES\s+START\b[^>]*-->.*?^<!--\s*WF-HOUSE-RULES\s+END\s*-->[ \t]*$",
    re.M | re.S)
# The provenance line, rewritten on every propagation and therefore EXCLUDED from the
# comparison that decides whether a propagation is needed at all. A region whose only
# difference from the current one is the date it was written is not stale, and a writer
# that rewrites it anyway is not idempotent (`bin/idempotence`, CLASS B).
HOUSE_PROVENANCE_RX = re.compile(r"^<!--\s*origin:\s*workforce\b[^>]*-->[ \t]*$\n?", re.M)
HOUSE_REGISTER_HEADING = "### Supersession register"
# A marker recording, structurally, which shipped entry a customization supersedes.
# `evaluators.md` § A register scoped by enumeration goes stale: rows come from an
# `origin: user` span's own attributes or a `supersedes:` key, and from NOTHING else —
# a prose grep for the word returned one row and it was a fragment of an unrelated
# sentence, which is an invention with a line number attached.
SUPERSEDES_RX = re.compile(r"^<!--(?=[^>]*\bsupersedes:)[^>]*-->[ \t]*$", re.M)
HOUSE_ATTR_RX = re.compile(r"\b([A-Za-z][A-Za-z-]*):\s*([^|>]*?)\s*(?=\||-->|$)")


def house_text(rows, carried):
    """The WF-HOUSE-RULES body — the precedence clause, then the derived register.

    NO DATE IN THE BODY. The provenance comment carries when it was propagated and is
    excluded from the staleness comparison; a date inside the text would make every run
    a rewrite and every re-run a second one.
    """
    out = ["## House rules — precedence (workforce-owned)", "",
           "**House rules dominate, and the supersession register is the SOLE source of a "
           "demotion or exemption.**",
           "An evaluator APPLIES the house rules; it does not renegotiate them against the "
           "specific file in front of it.", "",
           "- The supersession register below is the only place *\"matches this file's own "
           "house style\"* is a valid",
           "  reason to demote a finding, and only inside that row's stated scope. Everywhere "
           "else a HIGH-confidence",
           "  finding is applied on its own evidence, not demoted by an appeal to local "
           "convention.",
           "- **Outside every register row's scope, a settled finding's fix is applied in the "
           "same pass, never",
           "  skipped, never offered, never surfaced to the human as a question.** A settled "
           "house rule handed to",
           "  the human as a question is a flag, and a flag is not a fix (the no-deferment-queue "
           "directive;",
           "  \"A DETECTOR SHIPS WITH ITS FIX\").",
           "- This constrains the evaluator; it widens no exemption and grants none the register "
           "never granted.", "",
           HOUSE_REGISTER_HEADING,
           "| Shipped entry | Superseded by | Where | Since |",
           "|---|---|---|---|"]
    out += [r for r in rows] + [r for r in carried]
    if not rows and not carried:
        out += ["",
                "_Empty: no shipped entry in this catalog carries a structured `supersedes:` "
                "citation. The register is",
                "derived from structure, never from a prose grep (`references/evaluators.md` "
                "§ The supersession register);",
                "0 rows._"]
    return "\n".join(out)


def house_region(text):
    """The WF-HOUSE-RULES region in `text`, or None."""
    m = HOUSE_RX.search(text or "")
    return m.group(0) if m else None


def house_wrap(body, prov):
    """The region as it sits in a file: markers, provenance line, body."""
    return "\n".join((HOUSE_START, prov, "", body, "", HOUSE_END))


def house_substance(region):
    """A region reduced to what a staleness comparison may read.

    EVERYTHING BUT THE PROVENANCE LINE, which carries the date and changes on every run
    by design, AND blank lines, so a re-flow is not mistaken for a change of rules. A
    comparison that reads either turns every run into a rewrite and the second run into
    a second one — the CLASS B defect `bin/idempotence` exists for.
    """
    text = HOUSE_PROVENANCE_RX.sub("", region or "")
    return "\n".join(l.rstrip() for l in text.splitlines() if l.strip())


def house_dirs(root, kind):
    """Every project-scope directory that can hold this kind's house rules, in spelling
    order. NOT ownership-tested, exactly as `project_anchors` is not: the anchor is never
    shipped, so one sitting under a skill `install` wrote is still the project's own."""
    return [d for d in (os.path.join(root, ".claude", "skills", n)
                        for n in CATALOGS[kind]["skills"]) if os.path.isdir(d)]


def register_rows(root, kind):
    """`([row, ...], [(path, line), ...])` — the supersession register, DERIVED.

    Structure only, per `evaluators.md`: a marker carrying a `supersedes:` attribute,
    wherever it sits in the project's own evaluator directories. Each row cites the
    customization by `path:line`, so no row is a guess about the user's intent.

    The machine-owned region is removed before the scan. A run that read its own last
    output would re-derive its rows as evidence for themselves, and the register would
    grow by one copy of itself per audit.
    """
    rows, cites = [], []
    for d in house_dirs(root, kind):
        for f in all_files(d):
            if not f.endswith(".md"):
                continue
            text = HOUSE_RX.sub("", slurp(f))
            for m in SUPERSEDES_RX.finditer(text):
                attrs = {k.lower(): v for k, v in HOUSE_ATTR_RX.findall(m.group(0))}
                entry = attrs.get("supersedes", "").strip()
                if not entry:
                    continue
                line = text[:m.start()].count("\n") + 1
                where = "`%s:%d`" % (os.path.relpath(f, root), line)
                by = (attrs.get("superseded-by") or attrs.get("by") or "").strip()
                if not by:
                    tail = [l.strip() for l in text[m.end():].splitlines() if l.strip()]
                    by = tail[0][:100] if tail else "the customization at this path"
                since = (attrs.get("since") or attrs.get("added")
                         or attrs.get("date") or "undated").strip()
                rows.append("| %s | %s | %s | %s |"
                            % (entry, by.replace("|", "\\|"), where, since))
                cites.append((os.path.relpath(f, root), line))
    return rows, cites


def carried_rows(region, derived):
    """Register rows the previous region carried that this derivation did not produce.

    KEPT, NOT DROPPED. The region is machine-owned and says so, and a row a person wrote
    into it by hand is still the project's own words — directive one is retention, and a
    silent deletion here is the one failure mode this whole file is built against. They
    are carried verbatim and COUNTED, so a register that is growing rows nothing can
    derive is visible rather than quietly permanent.
    """
    if not region:
        return []
    body = region.split(HOUSE_REGISTER_HEADING, 1)
    if len(body) < 2:
        return []
    have = {r.split("|")[1].strip() for r in derived if r.count("|") > 2}
    out = []
    for line in body[1].splitlines():
        line = line.strip()
        if not line.startswith("|") or line.count("|") < 4:
            continue
        first = line.split("|")[1].strip()
        if not first or first.startswith("---") or first == "Shipped entry":
            continue
        if first not in have:
            out.append(line)
    return out


def user_spans(d):
    """Every `origin: user | immutable: true` span in this copy, verbatim, with its source.

    Returns `[(relpath, first_line, text)]` where `text` is the span INCLUDING its opening
    marker and its `<!-- /origin -->` close when it has one — byte-for-byte as it sits on
    disk. These are the user's own words and no regeneration reconstructs them (SKILL.md
    § Atomic-or-Absent, T2: extraction is blocking and byte-exact).
    """
    out = []
    for f in all_files(d):
        text = slurp(f)
        if not text:
            continue
        for m in IMMUTABLE_SPAN_RX.finditer(text):
            span = m.group(0)
            close = "<!-- /origin -->"
            tail = text[m.end():m.end() + len(close) + 1]
            if tail.startswith(close):
                span += close
            line = text[:m.start()].count("\n") + 1
            out.append((os.path.relpath(f, d), line, span))
    return out


def preserve_spans(proj, spans):
    """Write every extracted span into `CATALOG-ANCHOR.md`, then READ IT BACK and compare.

    WHY THE HOUSE-RULES FILE IS WHERE THEY GO, resolved from the handbooks rather than asked.
    `evaluators.md` § Where a catalog resolves from already names `CATALOG-ANCHOR.md` as the
    project-specific layer — the supersession register that is *the sole authority which
    demotes a finding* — and it is the one file the migration has always left standing. A
    project rule belongs in the project's rules file.

    WHY THIS IS RETENTION AND NOT DELETION. Directive one is that the user's verbiage is
    absolutely retained, and retention means the words reach the component that is governed
    by them, never that a particular file survives (SKILL.md § Directives, 2026-08-05: *"a
    `<!-- origin: user | immutable: true -->` block is never reworded ... the file around it
    may still be freely edited or deleted once the block is extracted"*). The words land in
    the layer that outranks the catalog, which is a promotion, not a move.

    THE READBACK IS BLOCKING. A short or altered write returns False and the caller removes
    NOTHING for that kind. An extraction that was not verified may never authorise a
    deletion.
    """
    chunks = [("*Lifted verbatim from `%s:%d` when the project copy was retired in favour "
               "of the shipped evaluator. Not reworded.*\n\n%s" % (rel, line, span), span)
              for rel, line, span in spans]
    return anchor_append(proj, PRESERVE_HEADING, chunks)


def anchor_append(proj, heading, chunks):
    """Append `chunks` under `heading` in `CATALOG-ANCHOR.md`, then READ THEM BACK.

    `chunks` is `[(text_to_write, needle_that_must_read_back)]`. A chunk whose needle is
    already in the file is skipped, which is what makes a second run of the same lift a
    no-op (CLASS B). Returns False on a refused or unverified write, and the caller
    removes NOTHING on a False — an extraction that was not verified may never authorise
    a deletion.

    ONE WRITER FOR EVERY LIFT INTO THE ANCHOR. The `origin: user` spans, the house-rules
    region a migration would otherwise delete, and the project-only catalog rows a
    differing file carries are three different things to save and exactly one way to save
    them; three copies of this readback would be three chances for one of them to skip it.
    """
    if not chunks:
        return True
    anchor = os.path.join(proj, ANCHOR)
    existing = slurp(anchor)
    if os.path.islink(anchor):
        return False
    pending = [(text, needle) for text, needle in chunks if needle not in existing]
    if not pending:
        return True
    if not existing.strip():
        # A LIFT CAN BE THE FIRST THING IN THE FILE, and a file that opens on two blank
        # lines and a chunk reads like debris rather than like the layer that outranks
        # the catalog. The header says what the file is to whoever opens it next.
        existing = ("# CATALOG-ANCHOR - %s\n\nThe project-specific layer: house rules, the "
                    "supersession register, and everything a retirement lifted out of the "
                    "project's own copy. The corpus itself resolves from the workforce "
                    "install (`wf-catalog --kind <kind> --path`).\n"
                    % os.path.basename(proj))
    body = existing.rstrip("\n")
    if heading not in body:
        body += "\n\n" + heading + "\n"
    body += "\n" + "\n\n".join(t for t, _n in pending) + "\n"
    try:
        # `open(path, "w")` FOLLOWS a symlink and truncates its target, which is why the
        # link case is refused above rather than handled here (SKILL.md § Atomic-or-Absent,
        # T5: the destroyers are the rename-in-place family, and this is not one).
        with open(anchor, "w", encoding="utf-8") as fh:
            fh.write(body)
    except OSError:
        return False
    back = slurp(anchor)
    return all(needle in back for _t, needle in chunks)


LIFTED_HEADING = "## Project catalog amendments lifted from the retired copy"


def file_keys(text):
    """`{normalised key: (line number, the line verbatim)}` — the comparable units of a
    catalog file: its headings and its table-row keys, the two things an evaluator greps
    (`HEADING_RX`, `ROW_KEY_RX`). Prose is excluded for the reason those patterns exist:
    it reflows between versions and would differ on every copy."""
    out = {}
    lines = (text or "").splitlines()
    for n, line in enumerate(lines, 1):
        m = HEADING_RX.match(line)
        if not m:
            m = ROW_KEY_RX.match(line)
            if m and set(m.group(1).strip()) <= set("-: "):
                continue          # a table's separator row is not a key
            # NOR IS THE HEADER ROW ABOVE IT. `| Check | Severity |` is the table's
            # column names, identical in every project that writes a table, and lifting
            # it as a project-only row is noise sitting on top of the real ones.
            if m and n < len(lines) and set(lines[n].strip()) <= set("|-: ") and "-" in lines[n]:
                continue
        if not m:
            continue
        key = m.group(1).strip().strip("*`_ ").lower()
        if key:
            out.setdefault(key, (n, line.rstrip()))
    return out


def install_keys(root, kind):
    """Every heading and row key the SHIPPED corpus for `kind` carries."""
    inst = install_dir(root, kind)
    keys = set()
    for f in catalog_files(inst) if inst else []:
        keys |= set(file_keys(slurp(f)))
    return keys


def project_only_rows(root, kind, proj, rels):
    """`{rel: [(line, text)]}` — the catalog rows a removable file carries and the install
    does not, which are the ones a live grader can still be grading on.

    THE DELTA OF A MODIFIED SHIPPED FILE IS PROJECT CONTENT, and until now it went to
    `retired/` with nothing live holding it. MEASURED 2026-09-25 on `university`: a project
    grader cited *"Productive tangent — minimum/absent"* from `text-eval`'s copy and
    *"Consistent edge quality"* from `image-eval`'s `watercolor.md`; neither row is in any
    shipped catalog, and after the migration `wf-catalog --grep` for either answered `no
    match` because the only copy was in an archive directory the resolver never reads. They
    are PROJECT rows and they do not belong in the shipped corpus — so they are lifted into
    the house-rules layer, which the resolver does read and which survives every migration.
    """
    shipped = install_keys(root, kind)
    out = {}
    for rel in sorted(rels):
        f = os.path.join(proj, rel)
        if os.path.islink(f) or not rel.endswith(".md"):
            continue
        rows = [v for k, v in file_keys(HOUSE_RX.sub("", slurp(f))).items()
                if k not in shipped]
        if rows:
            out[rel] = sorted(rows)
    return out


def lift_rows(proj, rows_by_rel):
    """Write the project-only rows of every removed file into `CATALOG-ANCHOR.md`, verified.

    The row is copied VERBATIM with its source `path:line`, so a reader grepping the layer
    finds the same text it was grading on, and a person can see where it came from."""
    chunks = []
    for rel in sorted(rows_by_rel):
        body = "\n".join(text for _n, text in rows_by_rel[rel])
        chunks.append(("*From `%s`, lifted when the project copy was retired. These rows "
                       "are the project's own — no shipped catalog carries them.*\n\n%s"
                       % (rel, body), body))
    return anchor_append(proj, LIFTED_HEADING, chunks)


def lift_house_regions(proj, regions):
    """Move a WF-HOUSE-RULES region out of a file the retirement removes, verified.

    `audit.md` Step 6-F promises the house rules survive a retirement and, for one real
    project, they did not: an earlier audit had propagated `code-evaluator`'s region into
    `references/guards.md`, which is corpus, so the migration removed it and the 1,634-byte
    region was recovered out of `retired/` by hand. `text-eval`'s sits in
    `references/ai-patterns.md` and is latent in exactly the same way. The region is lifted
    into the anchor BEFORE anything is removed, and a file whose region could not be lifted
    is not removed at all.
    """
    return anchor_append(proj, PRESERVE_HEADING, [
        ("*The house rules were propagated into `%s` by an earlier audit. That file is "
         "corpus and the migration removes corpus, so the region is lifted here verbatim "
         "— `CATALOG-ANCHOR.md` stays (audit Step 6-F).*\n\n%s" % (rel, reg), reg)
        for rel, reg in regions])


def house_state(root, kind):
    """What this kind's house rules are, where they live, and what a refresh would do.

    Five verdicts, and each unrefreshed one NAMES ITS PRECONDITION — `audit.md` Step 4:
    `INV-HOUSERULES` is `NOT UPHELD` only when an unrefreshed evaluator cites nothing,
    which is the uncited-refusal shape `INV-SWEPT` uses. A run may not skip the refresh
    silently and still close clean.

      no-evaluator   this project holds no directory for the kind — nothing to refresh
      unappendable   the anchor is immutable end to end, or is a link out of the tree
      current        the region is present and says what this run would say
      relocate       the region is in a corpus file the migration removes; it moves here
      refresh        the region is absent, or stale
    """
    dirs = house_dirs(root, kind)
    if not dirs:
        tried = ", ".join(".claude/skills/%s" % n for n in CATALOGS[kind]["skills"])
        return {"kind": kind, "verdict": "no-evaluator", "why":
                "no %s evaluator directory at project scope (tried %s), so there is no "
                "house-rules file to refresh. Run `workforce update` to install the "
                "evaluators, then re-run." % (kind, tried)}
    anchors = [os.path.join(d, ANCHOR) for d in dirs]
    dest = next((a for a in anchors if os.path.isfile(a)), anchors[0])
    rows, cites = register_rows(root, kind)
    existing = slurp(dest) if os.path.isfile(dest) else ""
    region = house_region(existing)
    # A REGION IN A FILE THE MIGRATION REMOVES. Step 6-F guarantees the house rules
    # survive a retirement, and a region propagated into corpus by an earlier audit does
    # not: `code-evaluator`'s went with `references/guards.md` on 2026-09-11 and was
    # recovered from `retired/` by hand. Found here, it moves to the anchor.
    stray = []
    for d in dirs:
        for f in all_files(d):
            if f == dest or not f.endswith(".md") or os.path.islink(f):
                continue
            if house_region(slurp(f)):
                stray.append(f)
    source_region = region or (house_region(slurp(stray[0])) if stray else None)
    carried = carried_rows(source_region, rows)
    st = {"kind": kind, "dest": dest, "rows": rows, "cites": cites,
          "carried": carried, "stray": stray, "body": house_text(rows, carried)}
    if os.path.islink(dest):
        st.update(verdict="unappendable", why="%s is a symlink; writing through it puts "
                  "the project's house rules somewhere this run never named"
                  % os.path.relpath(dest, root))
        return st
    if existing and not IMMUTABLE_SPAN_RX.sub("", existing).strip():
        spans = ["%s:%d" % (os.path.relpath(dest, root),
                            existing[:m.start()].count("\n") + 1)
                 for m in IMMUTABLE_SPAN_RX.finditer(existing)]
        st.update(verdict="unappendable", why="%s is immutable end to end — every byte "
                  "sits inside an `origin: user | immutable: true` span (%s), so there is "
                  "no position to open a machine-owned region"
                  % (os.path.relpath(dest, root), ", ".join(spans[:4])))
        return st
    if region and not stray and house_substance(region) == house_substance(house_wrap(body, "")):
        st.update(verdict="current", why="register %d row(s)%s · precedence clause present"
                  % (len(rows), " · %d carried" % len(st["carried"]) if st["carried"] else ""))
        return st
    if stray and not region:
        st.update(verdict="relocate", why="register %d row(s) · the region sits in %s, "
                  "which the migration removes — it moves into %s"
                  % (len(rows), ", ".join(os.path.relpath(f, root) for f in stray[:3]),
                     ANCHOR))
        return st
    st.update(verdict="refresh",
              why="register %d row(s)%s · precedence clause %s"
              % (len(rows), " · %d carried" % len(st["carried"]) if st["carried"] else "",
                 "stale" if region else ("appended" if existing else "written")))
    return st


def house_write(root, st):
    """Write the region into `CATALOG-ANCHOR.md`, read it back, and clear any stray copy.

    `(ok, detail)`. THE READBACK IS BLOCKING and the stray is cleared only after it: the
    relocation must never be a removal that failed to be a move. Same rule as
    `preserve_spans`, for the same reason — an extraction that was not verified may not
    authorise a deletion.
    """
    dest, body = st["dest"], st["body"]
    run = ""
    try:
        with open(os.path.join(root, ".claude", "workforce", ".current-run"),
                  encoding="utf-8", errors="replace") as fh:
            run = (fh.read().strip().splitlines() or [""])[0].strip()
    except OSError:
        pass
    # THE RUN ID GOES INSIDE AN HTML COMMENT, so it is constrained to what a run id is
    # rather than trusted to be one. A `.current-run` holding `x -->` would close the
    # provenance comment early and put the rest of the line into the rendered document —
    # the same output-encoding class as any other untrusted value written into markup,
    # reached here through a file any process on the machine can write.
    if not re.fullmatch(r"[A-Za-z0-9._-]{1,80}", run or ""):
        run = ""
    prov = ("<!-- origin: workforce | modifiable: true | source: references/evaluators.md "
            "§ House rules dominate | propagated: %s%s -->"
            % (time.strftime("%Y-%m-%d", time.gmtime()), " run %s" % run if run else ""))
    region = house_wrap(body, prov)
    existing = slurp(dest) if os.path.isfile(dest) else ""
    if not existing:
        existing = ("# CATALOG-ANCHOR - %s\n\nWritten by `wf-catalog --house-rules` "
                    "because this project's %s evaluator carried no house-rules file. The "
                    "corpus resolves from the workforce install (`wf-catalog --kind %s "
                    "--path`); this file is the project-specific layer that outranks it "
                    "and survives every migration.\n"
                    % (os.path.basename(os.path.dirname(dest)), st["kind"], st["kind"]))
    new = HOUSE_RX.sub("", existing).rstrip("\n") + "\n\n" + region + "\n"
    try:
        _sibling("wf-ledger").atomic_write(root, dest, new.encode("utf-8"), makedirs=True)
    except OSError as exc:
        return False, "not written, the file keeps its bytes: %s" % exc
    back = house_region(slurp(dest))
    if back is None or house_substance(back) != house_substance(region):
        return False, "written and read back changed or absent — nothing else touched"
    cleared = []
    for f in st["stray"]:
        text = slurp(f)
        stripped = HOUSE_RX.sub("", text).rstrip("\n") + "\n"
        try:
            _sibling("wf-ledger").atomic_write(root, f, stripped.encode("utf-8"))
        except OSError as exc:
            return True, ("region written to %s; %s still carries its copy (%s)"
                          % (os.path.relpath(dest, root), os.path.relpath(f, root), exc))
        if house_region(slurp(f)):
            return True, ("region written to %s; %s still carries its copy after the write"
                          % (os.path.relpath(dest, root), os.path.relpath(f, root)))
        cleared.append(os.path.relpath(f, root))
    return True, ("register %d row(s)%s%s"
                  % (len(st["rows"]),
                     " · %d carried" % len(st["carried"]) if st["carried"] else "",
                     " · lifted out of %s" % ", ".join(cleared) if cleared else ""))


def house_rules(root, args):
    """`--house-rules`: the producer for the region `audit` Step 4 and 6-E both require."""
    states = [house_state(root, k) for k in sorted(CATALOGS)]
    if args.json:
        json.dump({"root": root, "house_rules": [
            {k: v for k, v in s.items() if k != "body"} for s in states]},
            sys.stdout, indent=2)
        sys.stdout.write("\n")
        return 0
    print("catalog house rules — %s" % root)
    refreshed = unrefreshed = current = failed = 0
    label = "HOUSE RULES"
    for st in states:
        name = os.path.basename(os.path.dirname(st["dest"])) if st.get("dest") else st["kind"]
        if st["verdict"] in ("no-evaluator", "unappendable"):
            unrefreshed += 1
            print("%-15s ~ %-20s UNREFRESHED %s" % (label, name, st["why"]))
            label = ""
            continue
        if st["verdict"] == "current":
            current += 1
            print("%-15s = %-20s %s" % (label, name, st["why"]))
            label = ""
            continue
        if not args.execute:
            print("%-15s ~ %-20s %s — would %s into %s"
                  % (label, name, st["why"], st["verdict"], os.path.relpath(st["dest"], root)))
            label = ""
            continue
        ok, detail = house_write(root, st)
        if not ok:
            failed += 1
            unrefreshed += 1
            print("%-15s ! %-20s FAILED %s" % (label, name, detail), file=sys.stderr)
        else:
            refreshed += 1
            print("%-15s + %-20s %s · %s"
                  % (label, name, detail, os.path.relpath(st["dest"], root)))
        label = ""
    if not args.execute:
        pending = len(states) - unrefreshed - current
        print("\nINV-HOUSERULES  %d evaluator(s) · %d current · %d would refresh · %d "
              "unrefreshed · each unrefreshed names its precondition"
              % (len(states), current, pending, unrefreshed))
        if pending:
            print("\nDISPLAY ONLY — nothing written. Re-run with --execute to propagate.")
        return 0
    print("\nINV-HOUSERULES  %d evaluator(s) · %d register(s) refreshed · %d current · "
          "precedence present · %d unrefreshed · each unrefreshed names its precondition"
          % (len(states), refreshed, current, unrefreshed))
    return 1 if failed else 0


def shipped_agents(root, kind):
    """The agent names the SHIPPED evaluator for `kind` carries, as a set.

    A bundled agent is real capability, not corpus. The shipped skill either provides one of
    the same name — in which case the project's copy is the old one and its now-dangling
    registration is removed once the shipped one is confirmed on disk — or it does not, in which case removing the project's copy would delete a
    capability nothing replaces. That is the make-before-break floor the Atomic-or-Absent
    gate states for conversions, and a retirement is subject to it for the same reason: at
    every instant the capability is reachable by one path or two, never zero.

    MEASURED 2026-09-10 on `odyssey-alive`: six bundled agents across the five copies. Four
    are project-neutral and now ship (`character-scanner`, `image-validator`,
    `code-design-advisor`, `deadcode-gardener`); `prose-evaluator` and `structure-checker`
    carry the project's own voice rules, ship nowhere, and are kept.
    """
    inst = install_dir(root, kind)
    if not inst:
        return set()
    adir = os.path.join(os.path.dirname(inst), "agents")
    try:
        return {n for n in os.listdir(adir)
                if os.path.isfile(os.path.join(adir, n, "AGENT.md"))}
    except OSError:
        return set()


def clear_registrations(root, kind):
    """Remove `.claude/agents/<name>.md` links the retirement just broke.

    A registration is a symlink into the copy, so retiring the copy dangles it — and a
    dangling registration is worse than none: the host lists the agent type and the spawn
    fails at use. It is removed only when the shipped evaluator registers an agent of the
    same name, so the capability is live at install scope before the project link goes.
    Anything else is reported and left; it is not ours to re-create.
    """
    out = []
    adir = os.path.join(root, ".claude", "agents")
    ship = shipped_agents(root, kind)
    if not os.path.isdir(adir):
        return out
    for entry in sorted(os.listdir(adir)):
        link = os.path.join(adir, entry)
        if not os.path.islink(link) or os.path.exists(link):
            continue
        name = entry[:-3] if entry.endswith(".md") else entry
        # NOT OURS TO JUDGE. A link this kind does not own is reported by the kind that does,
        # or by nobody — reporting it per kind printed one pre-existing dangling link five
        # times, each blaming an evaluator that has nothing to do with it.
        if name not in ship:
            continue
        # MAKE BEFORE BREAK, ASSERTED RATHER THAN ASSUMED. Removing the project link is only
        # safe because the install registers the same agent at its own scope; if that
        # registration is not on disk, removing this one leaves the agent reachable by zero
        # paths — the one outcome a retirement may never produce.
        live = os.path.join(config_root(), "agents", entry)
        proj_reg = os.path.join(root, ".claude", "agents", entry)
        replacement = next((p for p in (live, proj_reg)
                            if p != link and os.path.isfile(p) and not os.path.islink(p)), None)
        if not replacement:
            out.append((entry, "DANGLING — left in place: no shipped registration for `%s` "
                               "is on disk, so removing this would leave the agent "
                               "unreachable. Run `workforce update`." % name))
            continue
        try:
            os.remove(link)
            out.append((entry, "removed — registered by the install at %s" % replacement))
        except OSError as exc:
            out.append((entry, "could not remove: %s" % exc))
    return out


def archive_copy(root, kind, proj, rels):
    """Copy every file the retirement will remove into `.claude/workforce/retired/`.

    THE RETIREMENT IS NOW UNCONDITIONAL, SO THE ARCHIVE IS WHAT PAYS FOR IT. Every earlier
    design here kept a file by PROVING it redundant, and the proof was also the preservation.
    Removal by directive has no such proof, and the copy can hold a project rule written as
    ordinary prose under an ordinary heading — the exact shape an independent code evaluation
    used to break the first migration, and a shape no `origin: user` span marks.

    So: `origin: user` spans are promoted into `CATALOG-ANCHOR.md` where they keep governing,
    and the WHOLE removed set is archived byte-for-byte where it can be read back. The live
    tree ends clean — which is what the directive asks for — and nothing is unrecoverable,
    which is what directive one asks for. This is the same shape as the `.orig` copy T7 takes
    before a conversion retires a skill, for the same reason.

    Returns the archive directory, or None if nothing could be written. A failure here is
    BLOCKING for the caller: an unarchived removal is a removal with no way back.
    """
    stamp = time.strftime("%Y%m%dT%H%M%SZ", time.gmtime())
    dest = os.path.join(root, ".claude", "workforce", "retired",
                        "%s-%s" % (os.path.basename(proj), stamp))
    try:
        for rel in rels:
            src = os.path.join(proj, rel)
            out = os.path.join(dest, rel)
            os.makedirs(os.path.dirname(out), exist_ok=True)
            shutil.copy2(src, out)
    except OSError:
        return None
    return dest


def classify(root, kind):
    """What of this project's copy comes out, and what stays. The copy GOES.

    **THE VERDICT IS REMOVAL, AND IT IS NOT CONDITIONAL ON CONTENT.** The user directive of
    2026-09-10 states it: *"the audit of a project removes the old ones of the project so
    that the one in the user space is the one that's being used ... No exceptions."* Every
    earlier design here was a per-file identity proof — first headings-and-rows, then
    byte-identity by basename, then byte-identity by content — and each one was a reason a
    copy could survive forever. MEASURED on `odyssey-alive`, 2026-09-10: identity by basename
    left three of five kinds at `keep-all` with zero basename overlap between the shipped
    corpus and the copy, so no content either side could ever hold would have changed the
    verdict. A proof that cannot fire is not a safeguard.

    WHAT SURVIVES, AND IT IS EXACTLY TWO THINGS. `CATALOG-ANCHOR.md`, the house rules and
    supersession register — the genuinely project-specific layer, which is also where every
    `origin: user` span in the copy is lifted to, verbatim, BEFORE anything is removed. And
    `hooks/` plus `scripts/` a live settings entry still points at, which is an ORDERING
    requirement rather than an exception: removing what a registration names is
    make-before-break run backwards, and `hooks` unregisters it in the same audit.

    THE PRECONDITION IS THE SHIPPED CORPUS BEING REACHABLE. With no install to fall through
    to, removal would sever the read rather than complete a migration, so `no-install` is
    still a refusal — the one this script has always had.
    """
    inst, proj = install_dir(root, kind), project_skill_dir(root, kind)
    if not proj:
        return {"kind": kind, "verdict": "no-copy", "removable": [], "kept": [],
                "why": "nothing to migrate"}
    if not inst:
        return {"kind": kind, "verdict": "no-install", "path": proj, "removable": [], "kept": [],
                "why": "no shipped %s catalog is reachable from here — removing the copy "
                       "would sever the read rather than complete a migration. Run "
                       "`workforce update` first." % kind}
    if os.path.islink(proj):
        return {"kind": kind, "verdict": "keep-symlink", "path": proj, "removable": [], "kept": [],
                "why": "the copy is a symlink; removing files through it writes somewhere "
                       "this run never named"}

    spans = user_spans(proj)
    keep_rel = {"CATALOG-ANCHOR.md"}
    # MAKE BEFORE BREAK, per agent. A bundled agent the shipped evaluator also ships is the
    # old copy and goes; one it does not ship is capability with no replacement and stays.
    # Removing it would be the one thing a retirement may never do — leave a named
    # capability reachable by zero paths.
    ship = shipped_agents(root, kind)
    inst_rels = {os.path.relpath(f, os.path.dirname(inst)) for f in all_files(os.path.dirname(inst))}
    for f in all_files(proj):
        rel = os.path.relpath(f, proj)
        parts = rel.split(os.sep)
        if len(parts) >= 3 and parts[0] == "agents" and parts[1] not in ship:
            keep_rel.add(rel)
        # A SCRIPT OR HOOK THE SHIPPED SKILL DOES NOT ALSO SHIP IS CAPABILITY, NOT RESIDUE.
        # The same make-before-break rule as the agents beside it, and it was missing:
        # `scripts/lint-delta.sh` retired with no replacement on disk and nothing repointed,
        # because the only protection was the whole-kind hook-registration refusal, which
        # matches a settings hook command and sees nothing invoked from a slash command, a
        # handbook or a Makefile.
        elif parts[0] in ("scripts", "hooks") and rel not in inst_rels:
            keep_rel.add(rel)
    rels = {os.path.relpath(f, proj) for f in all_files(proj)}
    cited = cited_project_files(root, kind, proj, rels, keep_rel)
    keep_rel |= set(cited)
    if rels <= keep_rel:
        return {"kind": kind, "verdict": "retired", "path": proj, "removable": [], "kept": sorted(rels),
                "cited": cited,
                "why": "already retired — only the house rules%s remain, and the shipped "
                       "evaluator is what this project reads"
                       % (" and %d project file(s) live readers cite" % len(cited) if cited else "")}
    removable, kept = [], []
    for f in all_files(proj):
        rel = os.path.relpath(f, proj)
        if rel in keep_rel:
            kept.append(rel)
        elif os.path.islink(f):
            kept.append(rel)
        else:
            removable.append(rel)

    # WHAT IS SAVED OUT OF THE REMOVED SET BEFORE IT GOES. The house-rules region an
    # earlier audit propagated into a corpus file (Step 6-F promises it survives), and the
    # catalog rows the copy carries that no shipped file does. Both land in the anchor,
    # both are read back, and a failure of either leaves the file in place.
    house = [(rel, house_region(slurp(os.path.join(proj, rel)))) for rel in sorted(removable)]
    house = [(rel, reg) for rel, reg in house if reg]
    return {
        "kind": kind, "verdict": "retire", "path": proj,
        "removable": sorted(removable), "kept": sorted(kept), "cited": cited,
        "house": house, "rows": project_only_rows(root, kind, proj, removable),
        "spans": [(rel, line) for rel, line, _t in spans],
        "why": ("the shipped %s evaluator is installed and current, so this copy is the old "
                "one — %d file(s) go, CATALOG-ANCHOR.md stays%s%s"
                % (kind, len(removable),
                   ", %d project file(s) a live reader cites stay" % len(cited) if cited else "",
                   ", and %d `origin: user` span(s) are lifted into it verbatim first"
                   % len(spans) if spans else "")),
    }


def _sibling(name):
    """A sibling shipped script, imported by path, leaving no bytecode in the shipped `bin/`.
    Used only for constants a sibling OWNS, so one list cannot become two that disagree."""
    import importlib.machinery
    import importlib.util
    prev = sys.dont_write_bytecode
    sys.dont_write_bytecode = True
    try:
        mod_name = name.replace("-", "_")
        loader = importlib.machinery.SourceFileLoader(
            mod_name, os.path.join(os.path.dirname(os.path.abspath(__file__)), name))
        mod = importlib.util.module_from_spec(importlib.util.spec_from_loader(mod_name, loader))
        loader.exec_module(mod)
        return mod
    finally:
        sys.dont_write_bytecode = prev


# Directories whose files are records of past runs, never live readers. A run report that quotes
# a path is history; counting it would keep a file forever on the strength of a sentence about a
# run that is over. `retired/` is the archive this migration itself writes. THE LIST IS
# `wf-census.SACRED_SCRATCH`, project-relative, read from its owner: this file kept its own copy
# (review of the 1.63.0 fix batch, finding 10), and two copies of one list drift apart.
_CENSUS = _sibling("wf-census")
NOT_READERS = _CENSUS.SACRED_SCRATCH
# And the record FILES, by the same owner's rule: a queue, a manifest or a scan output
# quotes paths and reads none of them. Read from `wf-census` rather than restated here for
# the reason the line above is — two copies of one list drift apart.
IS_RECORD_FILE = _CENSUS.is_record_file
READER_MAX_BYTES = 1 << 20


def live_readers(root, proj):
    """`[(relpath_from_root, text)]` for every file that can still READ a path in this copy.

    The project's `.claude/` tree and its `CLAUDE.md`: handbooks, other skills, commands,
    maintainer scripts, ledger records. Excluded: the copy itself (its own files are asked
    separately, because only the ones that stay are live), the run-history directories above,
    and settings files, whose registrations are `hook_registrations`' question and are answered
    there by a refusal keyed on what would be removed.
    """
    out = []
    base = os.path.join(root, ".claude")
    skip = {os.path.join(root, d) for d in NOT_READERS} | {os.path.realpath(proj)}
    for dirpath, dirnames, filenames in os.walk(base):
        dirnames[:] = sorted(
            x for x in dirnames
            if not os.path.islink(os.path.join(dirpath, x))
            and os.path.join(dirpath, x) not in skip
            and os.path.realpath(os.path.join(dirpath, x)) not in skip)
        for fn in sorted(filenames):
            if fn.startswith("settings") and fn.endswith(".json"):
                continue
            # A RECORD IS NOT A READER. The deferment queue, the installer's manifest and
            # the personnel store quote the paths they are ABOUT; keeping a file because a
            # queue complains about it, or because an amendment record writes up the audit
            # that touched it, is how a retired copy stays on disk forever. The WHOLE path
            # is asked, not the basename: one of the two rules is about where a file sits.
            if IS_RECORD_FILE(os.path.join(dirpath, fn)):
                continue
            out.append(os.path.join(dirpath, fn))
    claude_md = os.path.join(root, "CLAUDE.md")
    if os.path.isfile(claude_md):
        out.append(claude_md)
    readers = []
    for f in out:
        # A REGULAR FILE, AND NEVER MORE THAN THE CAP IS READ. `getsize` alone reads 0 for a
        # device, so a reader linked to `/dev/zero` passed it and was read until memory ran out
        # (review of the 1.63.0 fix batch, finding 7). The read is capped as well as the stat,
        # because a file can grow between the two.
        real = os.path.realpath(f)
        try:
            if not os.path.isfile(real) or os.path.getsize(real) > READER_MAX_BYTES:
                continue
            with open(real, encoding="utf-8", errors="replace") as fh:
                text = fh.read(READER_MAX_BYTES + 1)
        except OSError:
            continue
        if len(text) > READER_MAX_BYTES:
            continue
        if text:
            readers.append((os.path.relpath(f, root), text))
    return readers


def _guarded(*forms):
    """Those path forms as one pattern, each stopped at a word boundary on both sides.

    THE LEFT GUARD ADMITS A SEPARATOR AND STOPS A WORD. `/` must pass, because a citation
    is routinely the short form with a longer path in front of it; what the guard is for is
    `myreferences/x.md`, and `palette.md` inside `not-palette.md`.
    """
    return re.compile("|".join(r"(?<![\w.-])" + re.escape(f) + r"(?![\w-])"
                               for f in sorted(set(forms), key=len, reverse=True)))


def _outside_citation_rx(skill, rel):
    """How a reader OUTSIDE the copy names one of its files: the skill is in the path.

    **A CITATION IS MATCHED THE WAY A PATH RESOLVES, AND FROM OUTSIDE, A BARE BASENAME
    RESOLVES TO NOTHING.** `<skill>/<rel>` is the form every longer spelling contains —
    `.claude/skills/<skill>/<rel>` and `~/.claude/skills/<skill>/<rel>` both end in it — so
    one needle covers all three and a name with no skill in it covers none.

    MEASURED 2026-09-25 on a real project, and it is why this is not the basename form the
    first fix used. `SKILL.md` matched every mention of any SKILL.md anywhere in the tree —
    *"cited by .claude/agents/bible-scholar.md:41 … (+502 more)"*. `image-eval`'s
    `references/ai-patterns.md` was held by an agent reading **text-eval's** file of the
    same name, and `references/templates.md` by `awareness-ledger` reading its own. One
    copy went from 1 removable file to 33 kept, which is not a cautious migration: it is a
    copy that can never retire, against a directive that says the old copies go.
    """
    return _guarded("%s/%s" % (skill, rel.replace(os.sep, "/")))


def _inside_citation_rx(rel):
    """How a reader INSIDE the copy names one of its files: relative to itself, or to the
    skill root. `references/x.md` and a bare `x.md` both resolve from in here, which is why
    `image-eval/references/invocation.md` citing `output-formats.md` is a real read and the
    same three words in an agent two directories away are not."""
    rel = rel.replace(os.sep, "/")
    return _guarded(rel, posixpath.basename(rel))


def _cite_lines(text, rx):
    """Line numbers where `rx` — a pattern from one of the citation builders — matches."""
    return [n for n, line in enumerate(text.splitlines(), 1) if rx.search(line)]


def cited_project_files(root, kind, proj, rels, keep_rel):
    """`{rel: ["reader:line", ...]}` for every PROJECT-ONLY file in the copy a live reader cites.

    RETIRING A FILE SOMETHING STILL READS IS A BREAK WITH NO MAKE. The copy goes because the
    install ships the same capability — true of the corpus, false of a file the install ships no
    counterpart for. MEASURED 2026-09-11 on apps-odyssey-alive (DEF-Q-13 b): `graphic-system.md`
    and `palette.md`, read by three handbooks, `/image` and `odyssey-apps`, and five text-eval
    files read by the four staying text agents, `edit-validator` and `copy-truth`, were all
    listed `retire` with nothing protecting them. The audit moved seven files and repointed 32
    lines by hand to keep those readers working.

    KEPT IN PLACE, NOT REFUSED. The 2026-09-10 directive is that the old copies go and `update`
    is the only thing a user runs, so a refusal that parks the whole kind until a human moves
    files is the wrong answer; so is a relocation that rewrites handbooks and other skills this
    script does not own. A cited project file stays where its readers already point, and the
    report names each reader so the citation can be moved deliberately. Once nothing cites it,
    the next run retires it.

    THE TEST IS CONTENT IDENTITY, AND IT USED TO BE CONTENT **OR NAME**. A copy of a shipped
    file that is byte-identical once normalised is read through the resolver — `evaluators.md`
    § tier-3, healed by audit Step 5d 2c — so a citation of it is repointed, not protected, and
    that half is unchanged. A file carrying a shipped NAME and different CONTENT is not that
    file: its delta is the project's own, and excluding it here meant a cited one was removed
    anyway. MEASURED 2026-09-25 on `university`: `human-markers.md` and `text-tells.md` both
    differ from the install by `cmp` and are read by `text-eval/SKILL.md:69,71`,
    `finishing-chain.md:63,69` and `CATALOG-ANCHOR.md:1` — all listed `retire`, their delta
    bound for `retired/` with no live reader left. A modified file is protected exactly as a
    project-only one is, and its project-only ROWS are lifted into the house-rules layer by
    `project_only_rows` when it does go.

    A CITATION IS MATCHED THE WAY THE PATH RESOLVES FOR THE READER THAT WROTE IT, and the
    two readers are not the same. From INSIDE the copy, `references/x.md` and a bare `x.md`
    both resolve — `image-eval/references/invocation.md:38,44,50` writes both, and the file
    they name was removed under them. From OUTSIDE, neither resolves to anything: only a
    citation naming the skill does, and `<skill>/<rel>` is the form that
    `.claude/skills/<skill>/<rel>` and `~/.claude/skills/<skill>/<rel>` both contain. See
    `_outside_citation_rx` for what matching a bare basename from outside cost when this
    was written the generous way — 33 kept files on a copy with one removable.

    A READER INSIDE THE COPY COUNTS ONLY IF IT STAYS. A project agent the shipped skill does not
    ship stays, and the files it cites are its grounding, so the set is closed to a fixpoint: a
    file kept because it is cited can itself cite another. A reader that is itself being retired
    reads nothing after the run.
    """
    _by_name, by_content = install_index(root, kind)
    name = os.path.basename(proj)
    candidates = []
    for rel in sorted(rels - keep_rel):
        f = os.path.join(proj, rel)
        if os.path.islink(f):
            continue
        body = norm(slurp(f))
        if body and body in by_content:
            continue
        candidates.append(rel)
    if not candidates:
        return {}
    readers = live_readers(root, proj)
    cited = {}
    for rel in candidates:
        rx = _outside_citation_rx(name, rel)
        hits = ["%s:%d" % (path, n) for path, text in readers for n in _cite_lines(text, rx)]
        if hits:
            cited[rel] = hits
    # The copy's own staying files, to a fixpoint.
    changed = True
    while changed:
        changed = False
        staying = (keep_rel | set(cited)) & rels
        for rel in candidates:
            if rel in cited:
                continue
            rx = _inside_citation_rx(rel)
            hits = []
            for reader in sorted(staying):
                if reader == rel:
                    continue
                text = slurp(os.path.join(proj, reader))
                hits += ["%s/%s:%d" % (os.path.relpath(proj, root), reader, n)
                         for n in _cite_lines(text, rx)]
            if hits:
                cited[rel] = hits
                changed = True
    return cited


def hook_registrations(root):
    """Settings hook entries whose command points inside a project evaluator copy.

    These are the other half of a copy, and the half the user named: a copy carries its own
    `hooks/` scripts and the project's settings register them by path, so removing files
    while leaving the registrations gives every later session a hook pointing at nothing.

    USER SCOPE IS READ TOO. Scoping this to the project's two settings files missed a
    registration in `~/.claude/settings.json` whose command names
    `$CLAUDE_PROJECT_DIR/.claude/skills/<evaluator>/hooks/...` — which is the exact
    make-before-break inversion the refusal exists to prevent, invisible to the refusal.

    MALFORMED SETTINGS ARE DATA, NOT A CRASH. `{"hooks": [...]}` — a list where an object
    belongs, which a hand edit produces easily — raised `AttributeError` out of this
    function and turned `--migrate` into a traceback. Every shape is guarded and an
    unreadable file is skipped, because a tool that reports on settings must not die on the
    settings it reports on.

    THE FOUR CANDIDATES ARE NOT FOUR FILES. When the project IS `$HOME`, `config_root()`
    is `$HOME/.claude` and the personal pair is the project pair spelled a second way, so
    every registration was read twice and reported as `REGISTERED 2 TIMES` — a duplicate
    that exists only in this list, against which the honest fix is to delete one of two
    entries that are the same entry. A symlinked or `$CLAUDE_CONFIG_DIR`-relocated tree
    produces the same collision under a different spelling, so identity is decided by
    `os.path.realpath` rather than by string equality. Order is preserved: the project
    spelling is seen first and is the one reported, which keeps `file:` naming the path
    the reader would edit.
    """
    out = []
    seen, paths = set(), []
    for cand in (os.path.join(root, ".claude", "settings.local.json"),
                 os.path.join(root, ".claude", "settings.json"),
                 os.path.join(config_root(), "settings.json"),
                 os.path.join(config_root(), "settings.local.json")):
        key = os.path.realpath(cand)
        if key in seen:
            continue
        seen.add(key)
        paths.append(cand)
    for path in paths:
        try:
            with open(path, encoding="utf-8") as fh:
                data = json.load(fh)
        except (OSError, ValueError):
            continue
        hooks = data.get("hooks") if isinstance(data, dict) else None
        if not isinstance(hooks, dict):
            continue
        for event, matchers in hooks.items():
            if not isinstance(matchers, list):
                continue
            for m in matchers:
                if not isinstance(m, dict):
                    continue
                entries = m.get("hooks")
                for h in entries if isinstance(entries, list) else []:
                    cmd = h.get("command") if isinstance(h, dict) else None
                    if not isinstance(cmd, str):
                        continue
                    for kind, meta in CATALOGS.items():
                        targets = [(sk, rel) for sk in meta["skills"]
                                   for rel in re.findall(
                                       r"skills/%s/([^\s\"'`;|&)<>]*)" % re.escape(sk), cmd)]
                        if targets:
                            out.append({"file": path, "event": event, "kind": kind,
                                        "command": cmd, "targets": targets})
    dupes = {}
    for r in out:
        dupes.setdefault((r["file"], r["event"], r["command"]), []).append(r)
    for group in dupes.values():
        if len(group) > 1:
            for r in group:
                r["duplicate"] = len(group)
    return out


def report(root, args):
    rows = [resolve(root, k) for k in sorted(CATALOGS)]
    unresolved_n = sum(1 for r in rows if r["source"] == "unresolved")
    if args.json:
        # `--migrate --json` is handled in migrate(); this branch once ALSO built a
        # migration payload and could never run, because main() routes on --migrate first.
        # It was dead code that made the JSON contract look wider than it was.
        json.dump({"root": root, "catalogs": rows}, sys.stdout, indent=2)
        sys.stdout.write("\n")
        # THE SAME EXIT CODE AS THE TEXT FORM. These disagreed — text exited 1 on an
        # unresolved kind and JSON exited 0 — so a wrapper reading JSON and testing $?
        # could not see the one state that is this script's own error.
        return 1 if unresolved_n else 0

    print("catalog resolution — %s" % root)
    for r in rows:
        if r["source"] == "unresolved":
            print("  %-9s UNRESOLVED — no copy here and no workforce install carrying one" % r["kind"])
            for c in install_candidates(root):
                for nm in CATALOGS[r["kind"]]["skills"]:
                    print("               tried %s" % os.path.join(c, nm, "references"))
            continue
        flags = []
        if r["stale"]:
            flags.append("STALE (install is v%s)" % r["install_version"])
        if r["untracked"]:
            flags.append("no version anchor")
        if r["additions_missing"]:
            flags.append("additions NEVER seeded (install ships v%s)" % r["slot_version"])
        if r["additions_stale"]:
            flags.append("additions v%s < install v%s"
                         % (r["seeded_version"], r["slot_version"]))
        if r["additions_path"]:
            flags.append("+ additions v%s" % (r["additions_version"]
                                              if r["additions_version"] is not None else "?"))
        elif r["source"] == "install" and CATALOGS[r["kind"]]["additions"]:
            # An install answer missing its own authored slot is this script's defect, not
            # the project's: the reader gets the vendored corpus and none of the additions,
            # which is the silent half-corpus this resolution exists to end.
            flags.append("ADDITIONS SLOT MISSING (%s)" % CATALOGS[r["kind"]]["additions"])
        if r["anchors"]:
            flags.append("+ project rules %s" % ", ".join(
                os.path.relpath(f, root) for f in r["anchors"]))
        print("  %-9s %-8s v%-5s %3d file(s) %5d line(s)  %s%s"
              % (r["kind"], r["source"],
                 r["version"] if r["version"] is not None else "?",
                 r["files"], r["lines"], r["path"],
                 ("  · " + " · ".join(flags)) if flags else ""))
    print("\nINV-CATALOG  %d kind(s) · %d from install · %d from project copy · %d stale · "
          "%d additions unseeded · %d additions stale · %d unresolved"
          % (len(rows),
             sum(1 for r in rows if r["source"] == "install"),
             sum(1 for r in rows if r["source"] == "project"),
             sum(1 for r in rows if r["stale"]),
             sum(1 for r in rows if r["additions_missing"]),
             sum(1 for r in rows if r["additions_stale"]),
             unresolved_n))
    return 1 if unresolved_n else 0


def registration_removes(hook, verdict):
    """Does this settings registration name a file the retirement of `verdict` would remove?

    THE REFUSAL IS KEYED ON WHAT GOES, NOT ON WHERE A PATH POINTS. It was keyed on the kind: any
    registration whose command contained `skills/<evaluator>/` refused the whole retirement.
    MEASURED 2026-09-11 on apps-odyssey-alive (DEF-Q-13 a): `code-evaluator`'s three enforce
    hooks were all in the STAYS set — `hooks/` files the install does not ship are kept — and
    the retirement was refused anyway, so the audit moved the hooks out by hand to get a
    migration the refusal existed to protect. A registration whose file stays is not broken by
    the retirement, and refusing on it only parks the kind.

    UNPARSEABLE FAILS CLOSED. A registration naming the skill directory itself, or a path this
    cannot read out of the command, is treated as naming something removed: the refusal is the
    safe direction and the report shows the command, so it is never silent.

    A PATH IS COMPARED NORMALISED. `hooks/../references/x.md` and `./references/x.md` name a
    removed file and compared unequal to it, so the retirement went ahead and left a hook
    pointing at a deleted file (review of the 1.63.0 fix batch, finding 6). `posixpath.normpath`
    folds both; a path still holding `..` after that leaves the skill directory, and one holding
    `$` has a variable this cannot expand, so both are treated as removed.
    """
    if verdict.get("verdict") != "retire" or not verdict.get("removable"):
        return False
    name = os.path.basename(verdict["path"])
    removable = set(r.replace(os.sep, "/") for r in verdict["removable"])
    for sk, rel in hook.get("targets", []):
        if sk != name:
            continue
        rel = rel.strip("/")
        if rel:
            rel = posixpath.normpath(rel)
            if rel == ".":
                rel = ""
        if (not rel or "$" in rel or ".." in rel.split("/")
                or rel in removable or any(r.startswith(rel + "/") for r in removable)):
            return True
    return False


# The file a code-eval commit gate compares the tree against. `wf-code-eval.MARKER` owns the name
# and this reads it from there (review of the 1.63.0 fix batch, finding 10): a gate renamed in one
# place and not the other would make every orphaned stamper read as none.
STAMP_MARKER = _sibling("wf-code-eval").MARKER


def code_eval_stamper(root):
    """The shipped stamper for a project's code-eval commit gate, or None.

    Two halves, both required: `wf-code-eval` beside this script, and the shipped
    code-evaluator's SKILL.md naming it — a script no step calls stamps nothing.
    """
    script = os.path.join(os.path.dirname(os.path.abspath(__file__)), "wf-code-eval")
    inst = install_dir(root, "code")
    skill = os.path.join(os.path.dirname(inst), "SKILL.md") if inst else ""
    calls = re.search(r"wf-code-eval\"?\s+--stamp", slurp(skill))
    return script if os.path.isfile(script) and calls else None


def code_eval_gates(root, stamper):
    """The gates `wf-code-eval` finds, or None when it cannot be asked. It owns gate discovery;
    reading settings for the same thing twice is two answers waiting to disagree."""
    if not stamper:
        return None
    try:
        p = subprocess.run([sys.executable, stamper, "--root", root, "--json"],
                           stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, timeout=60)
        return json.loads(p.stdout.decode("utf-8", "replace")).get("gates", [])
    except (OSError, ValueError, subprocess.SubprocessError):
        return None


def orphaned_stamp(root, verdict, stamper):
    """The file in this retirement that is the project's only writer of `.code-eval-reviewed`.

    DEF-Q-14: a project's commit gate compares the tree against `.code-eval-reviewed`, and the
    one writer was the copy's own SKILL.md § Enforcement coordination. Retiring that with no
    shipped stamper on disk leaves a gate that blocks every commit forever, so the retirement is
    REFUSED for this kind — the one refusal left that `update` fixes, by installing the stamper.
    """
    if stamper or verdict.get("verdict") != "retire":
        return None
    for rel in verdict["removable"]:
        if STAMP_MARKER in slurp(os.path.join(verdict["path"], rel)):
            return rel
    return None


def migrate(root, args):
    verdicts = [classify(root, k) for k in sorted(CATALOGS)]
    hooks = hook_registrations(root)
    by_kind = {v["kind"]: v for v in verdicts}
    for h in hooks:
        h["removes"] = registration_removes(h, by_kind.get(h["kind"], {}))
    blocked = {h["kind"] for h in hooks if h["removes"]}
    stamper = code_eval_stamper(root)
    gates = code_eval_gates(root, stamper)
    orphan = orphaned_stamp(root, by_kind.get("code", {}), stamper)
    if orphan:
        blocked.add("code")
    n_removable = sum(len(v["removable"]) for v in verdicts)
    n_kept = sum(len(v["kept"]) for v in verdicts)
    refused = [v for v in verdicts if v["removable"] and v["kind"] in blocked]
    n_hook_refused = sum(1 for v in refused if any(
        h["removes"] for h in hooks if h["kind"] == v["kind"]))

    if args.json:
        json.dump({"root": root, "migration": verdicts, "hooks": hooks,
                   "code_eval_gates": gates, "code_eval_stamper": stamper,
                   "orphaned_stamp": orphan,
                   "refused": [v["kind"] for v in refused]}, sys.stdout, indent=2)
        sys.stdout.write("\n")
        return 1 if refused else 0

    print("catalog migration — %s" % root)
    for v in verdicts:
        print("  %-9s %-14s %s" % (v["kind"], v["verdict"], v["why"]))
        for rel, line in v.get("spans", []):
            print("               PRESERVE   %s:%d → CATALOG-ANCHOR.md (verbatim)" % (rel, line))
        for rel, _reg in v.get("house") or []:
            print("               LIFT       %s carries the WF-HOUSE-RULES region → "
                  "CATALOG-ANCHOR.md (audit Step 6-F)" % rel)
        for rel in sorted(v.get("rows") or {}):
            rows = v["rows"][rel]
            print("               LIFT       %s — %d project-only row(s) → "
                  "CATALOG-ANCHOR.md: %s%s"
                  % (rel, len(rows), "; ".join(t.strip()[:60] for _n, t in rows[:2]),
                     " …" if len(rows) > 2 else ""))
        for f in v["removable"][:4]:
            print("               retire     %s" % f)
        if len(v["removable"]) > 4:
            print("               retire     … and %d more" % (len(v["removable"]) - 4))
        # A cited file is printed in full with its readers: it is the one STAYS a person may want
        # to act on, by moving the citation, and a truncated list would hide exactly that.
        cited = v.get("cited") or {}
        for f in sorted(cited):
            print("               STAYS      %s — cited by %s%s"
                  % (f, ", ".join(cited[f][:3]),
                     " (+%d more)" % (len(cited[f]) - 3) if len(cited[f]) > 3 else ""))
        rest = [f for f in v["kept"] if f not in cited]
        for f in rest[:4]:
            print("               STAYS      %s" % f)
        if len(rest) > 4:
            print("               STAYS      … and %d more" % (len(rest) - 4))

    if hooks:
        print("\n  hook registrations pointing into a project copy:")
        for h in hooks:
            dup = "  ** REGISTERED %d TIMES **" % h["duplicate"] if h.get("duplicate") else ""
            what = ("names a file this retirement REMOVES" if h.get("removes")
                    else "its file stays")
            print("    %-13s %s%s  · %s" % (h["event"], h["command"], dup, what))

    if gates:
        print("\n  code-eval commit gate(s) — stamped by the shipped `wf-code-eval --stamp`:")
        for g in gates:
            print("    %-13s %s%s" % (g["event"], os.path.relpath(g["script"], root),
                                     "" if g["present"] else "  · MISSING on disk"))
    if orphan:
        print("\n  ORPHANED GATE: %s/%s is this project's only writer of %s, and no shipped "
              "stamper is reachable. Run `workforce update` first."
              % (os.path.relpath(by_kind["code"]["path"], root), orphan, STAMP_MARKER))

    print("\nINV-CATMIG   %d file(s) removable · %d stay · %d cited · %d hook registration(s)%s"
          " · %d code-eval gate(s)%s"
          % (n_removable, n_kept, sum(len(v.get("cited") or {}) for v in verdicts), len(hooks),
             " · %d duplicated" % sum(1 for h in hooks if h.get("duplicate")) if hooks else "",
             len(gates or []),
             "".join((" · %d kind(s) REFUSED on hooks" % n_hook_refused if n_hook_refused else "",
                      " · code REFUSED on an orphaned gate" if orphan else ""))))

    if not args.execute:
        if n_removable:
            print("\nDISPLAY ONLY — nothing written. Re-run with --execute to retire these "
                  "copies. Every `origin: user` span is lifted into CATALOG-ANCHOR.md verbatim "
                  "first, and a file listed STAYS is never touched.")
        return 1 if refused else 0

    if not n_removable:
        print("\nNothing proven removable; nothing written.")
        return 0

    # A file is removed only after its copy's hook registrations are reported. Removing what
    # a settings entry still points at is make-before-break run backwards.
    for v in verdicts:
        if not v["removable"]:
            continue
        # PER KIND. This sat outside the loop, so the three retirements on a real tree
        # printed 9, 26 and 29 — each one the running total, and the last one naming 29
        # files removed from a directory that held 3. A count that is wrong upward is the
        # worst direction for a deletion report: it reads as collateral damage.
        removed = 0
        if v["kind"] in blocked:
            n_reg = sum(1 for h in hooks if h["kind"] == v["kind"] and h["removes"])
            if n_reg:
                print("\n  REFUSED  %s — %d settings hook registration(s) name a file this "
                      "retirement would remove. Unregister them first; this script does not "
                      "edit settings." % (v["kind"], n_reg))
            else:
                print("\n  REFUSED  %s — ORPHANED GATE: %s is the only writer of %s and no "
                      "shipped stamper is reachable. Run `workforce update` first."
                      % (v["kind"], orphan, STAMP_MARKER))
            continue
        # EXTRACTION BEFORE REMOVAL, AND IT IS BLOCKING PER KIND. The user's own words are
        # written into CATALOG-ANCHOR.md and read back before a single file goes; a failed
        # or short write removes NOTHING here. This is T2 of the Atomic-or-Absent gate
        # applied to a retirement rather than to a conversion — same rule, same reason: a
        # regeneration cannot reconstruct a sacred block.
        # ARCHIVE FIRST, and it is blocking. Nothing is removed until the whole removed set
        # exists somewhere readable.
        archive = archive_copy(root, v["kind"], v["path"], v["removable"])
        if archive is None:
            print("\n  REFUSED  %s — could not archive the copy to "
                  ".claude/workforce/retired/. Nothing removed." % v["kind"])
            continue
        spans = user_spans(v["path"])
        if not preserve_spans(v["path"], spans):
            print("\n  REFUSED  %s — could not write %d `origin: user` span(s) into "
                  "CATALOG-ANCHOR.md and verify them. Nothing removed."
                  % (v["kind"], len(spans)))
            continue
        if spans:
            print("\n  PRESERVED %d `origin: user` span(s) into %s/CATALOG-ANCHOR.md"
                  % (len(spans), v["path"]))
        # THE HOUSE RULES AND THE PROJECT'S OWN ROWS, BOTH BEFORE ANY REMOVAL AND BOTH
        # BLOCKING. Step 6-F promises the first survives and an earlier run deleted it;
        # the second is the delta of a file the install ships under the same name, which
        # went to `retired/` with no live reader.
        if not lift_house_regions(v["path"], v.get("house") or []):
            print("\n  REFUSED  %s — could not lift %d WF-HOUSE-RULES region(s) into "
                  "CATALOG-ANCHOR.md and verify them. Nothing removed."
                  % (v["kind"], len(v.get("house") or [])))
            continue
        for rel, _reg in v.get("house") or []:
            print("\n  LIFTED   the house-rules region out of %s into CATALOG-ANCHOR.md"
                  % rel)
        if not lift_rows(v["path"], v.get("rows") or {}):
            print("\n  REFUSED  %s — could not lift the project-only rows of %d file(s) "
                  "into CATALOG-ANCHOR.md and verify them. Nothing removed."
                  % (v["kind"], len(v.get("rows") or {})))
            continue
        for rel in sorted(v.get("rows") or {}):
            print("  LIFTED   %2d project-only row(s) from %s into CATALOG-ANCHOR.md"
                  % (len(v["rows"][rel]), rel))
        for rel in v["removable"]:
            target = os.path.join(v["path"], rel)
            # Re-assert against the tree AS IT STANDS NOW rather than trusting the
            # classification, and never write through a link (SKILL.md § Atomic-or-Absent,
            # T5 symlink refusal: a rename-in-place over a symlink destroys the link).
            if os.path.islink(target):
                print("  REFUSED  %s — symlink" % rel)
                continue
            try:
                os.remove(target)
                removed += 1
            except OSError as exc:
                print("  REFUSED  %s — %s" % (rel, exc))
        # The directories the removal emptied. A `references/` holding nothing is residue
        # under the same directive that retires the copy, and `corpus_bearing` already reads
        # an empty tree as no corpus — so leaving them changes no verdict and still looks
        # like a half-finished job to the next person who opens the directory.
        for dirpath, dirnames, filenames in os.walk(v["path"], topdown=False):
            if dirpath == v["path"] or os.path.islink(dirpath):
                continue
            if not os.listdir(dirpath):
                try:
                    os.rmdir(dirpath)
                except OSError:
                    pass
        print("\n  ARCHIVED %d file(s) to %s" % (len(v["removable"]), archive))
        print("  REMOVED  %d file(s) from %s — %s" % (removed, v["path"], v["why"]))
        for entry, what in clear_registrations(root, v["kind"]):
            print("  AGENT    %-34s %s" % (entry, what))
    return 1 if refused else 0


def main():
    ap = argparse.ArgumentParser(add_help=True)
    ap.add_argument("--root", default=os.environ.get("CLAUDE_PROJECT_DIR") or os.getcwd())
    ap.add_argument("--kind", choices=sorted(CATALOGS))
    ap.add_argument("--path", action="store_true", help="print the resolved directory only")
    ap.add_argument("--grep", metavar="RX", help="search the resolved catalog")
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--migrate", action="store_true")
    ap.add_argument("--house-rules", action="store_true", dest="house_rules",
                    help="refresh the WF-HOUSE-RULES region in every evaluator's "
                         "CATALOG-ANCHOR.md (audit Step 4 / Step 6-E)")
    ap.add_argument("--execute", action="store_true")
    args = ap.parse_args()
    root = os.path.abspath(args.root)

    # THE WIDENING IS NEVER SILENT. A root that already carries `.claude/` is used as
    # given and nothing is printed; only a root that does not is replaced, and then the
    # substitution is announced on stderr so `--path`'s stdout stays a single path a
    # caller can capture. See walk_up_to_project for why the default root is wrong.
    #
    # AND IT NEVER REACHES `--execute`. The walk is a repair for a READ that reported a
    # false absence; `--migrate --execute` deletes files, and inferring the tree to
    # delete from is not the same act as inferring the tree to read from. A run from
    # `~/lab/foo/bar` whose nearest `.claude/` sits at `~/lab` would otherwise retire
    # copies under a directory nobody named, on the strength of a guess this script made
    # after the operator had already consented to deletion. Naming the tree is one
    # argument and it is the operator's to give.
    if not os.path.isdir(os.path.join(root, ".claude")):
        found = walk_up_to_project(root)
        if found and args.execute:
            print("wf-catalog: %s carries no .claude/. The nearest project root is %s, "
                  "but --execute deletes files and will not act on an inferred tree. "
                  "Re-run with --root %s if that is the one you mean."
                  % (root, found, found), file=sys.stderr)
            return 2
        if found:
            print("wf-catalog: %s carries no .claude/ — resolving against %s"
                  % (root, found), file=sys.stderr)
            root = found

    if args.execute and not (args.migrate or args.house_rules):
        print("--execute is only meaningful with --migrate or --house-rules",
              file=sys.stderr)
        return 2
    if args.house_rules and args.migrate:
        print("--house-rules and --migrate are separate acts: the rules are propagated "
              "first (audit Step 6-E), the copies retired after (Step 6-F)", file=sys.stderr)
        return 2

    if args.path or args.grep:
        if not args.kind:
            print("--path and --grep need --kind", file=sys.stderr)
            return 2
        info = resolve(root, args.kind)
        if not info["path"]:
            print("%s: unresolved — no copy here and no workforce install carrying one"
                  % args.kind, file=sys.stderr)
            return 1
        if args.path:
            print(info["path"])
            return 0
        try:
            rx = re.compile(args.grep, re.I)
        except re.error as exc:
            print("bad --grep pattern: %s" % exc, file=sys.stderr)
            return 2
        hits = 0
        # The additions slot lives OUTSIDE the catalog directory, so a name relative to it
        # would climb out with `../`. A file under the corpus keeps its relative name; the
        # slot is labelled for what it is, which is also what the reader needs to see.
        # THE PROJECT'S HOUSE RULES ARE SEARCHED AFTER THE CORPUS, labelled `project:` so a
        # reader can tell a shipped rule from a project one by the prefix alone (DEF-Q-12).
        sources = [(("additions:" + os.path.basename(f)) if f == info["additions_path"]
                    else os.path.relpath(f, info["path"]), f)
                   for f in corpus_files(info["path"], info["additions_path"])]
        anchors = set(info["anchors"])
        sources += [(lbl, f) for lbl, f in project_anchors(root, args.kind) if f in anchors]
        for label, f in sources:
            for n, line in enumerate(slurp(f).splitlines(), 1):
                if rx.search(line):
                    hits += 1
                    print("%s:%d:%s" % (label, n, line.rstrip()))
        if not hits:
            print("no match in %s (%s)%s" % (
                info["path"], info["source"],
                "".join(" or %s" % f for f in info["anchors"])), file=sys.stderr)
        return 0 if hits else 1

    if args.house_rules:
        return house_rules(root, args)
    if args.migrate:
        return migrate(root, args)
    return report(root, args)


if __name__ == "__main__":
    sys.exit(main())
