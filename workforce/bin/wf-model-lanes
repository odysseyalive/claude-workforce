#!/usr/bin/env python3
"""wf-model-lanes — keep every model-pinned file on the model its lane selects.

    wf-model-lanes --root <tree>                          plan: list, resolve, report, write nothing
    wf-model-lanes --root <tree> --judge PATH LANE WHY …  plan with these lane judgments applied
    wf-model-lanes --root <tree> [--judge …] --execute    record the judgments, rewrite what drifted
    wf-model-lanes --root <tree> --check                  verify: read-only, exit 1 on any drift
    wf-model-lanes --root <tree> --lineup                 print each lane's model and effort, the
                                                          advisor, and the file they come from
    wf-model-lanes --root <tree> --heal-superseded [--execute]
                                                          move each recorded choice of a superseded
                                                          model ID to its successor, once per project

WHY THIS EXISTS. A `model:` line was rewritten only when a budget cell changed
(`procedures/model-map.md` § Model Rewrite), and a re-audit offers the recorded value as the
one-click `(current)` option, so a pin that no budget answer reached survived forever. MEASURED
2026-10-14: this repository's own `engineering-coder` spent ~57M tokens in two weeks on the
retired code pick, three weeks after the code lane had moved, and the same stale pin sat in four
more projects — one of them inside a skill-bundled agent that no audit step ever read. The user's
directive that day: audit examines the description of each file that selects a model, makes the
model match the function, and uses "the model the user already selected in the lineup". No
successor table: a file's LANE is judged, and the lane's selection is what it runs on.

THE JUDGMENT IS NOT MADE HERE. Which lane a description describes is a reading, and the audit's
main session makes it (`procedures/audit.md` Step 2), applying the floor rules in
`org-config.template.md` § Creative. This script does the four mechanical parts around it:

  enumerate  every file under the project's `.claude/` that pins a `model:` — `.claude/agents/**`
             (a symlinked file is read through its link), `.claude/skills/*/agents/*/AGENT.md`,
             and `.claude/skills/*/SKILL.md`
  resolve    each lane's model and effort from the project's `org-config.md`, in the order
             `org-config.template.md` § Resolution states — employee override, then lane, then
             the analytical tier row. With no project config the shipped template's values are
             the lineup, and the source says so
  remember   each file's judged lane beside a hash of its description, in RECORD_REL, so the
             next audit re-judges only a file whose description moved
  apply      only the `model:` and `effort:` lines that differ, written THROUGH a symlink with
             `open(path, "w")` (SKILL.md Atomic-or-Absent rule 3) and verified by re-reading

THE LINEUP BEFORE ANY AUDIT. User request 2026-11-05: "the proper model selections happen for
people building skills and agents prior to even running an audit". `--lineup` prints the lineup
`resolve` reads — the project's `org-config.md`, else the shipped template's defaults — with the
work each lane is for, and needs no `.claude/` under the root. `wf-code-origin` imports
`lineup_lines` and shows the same lines before an edit to an agent or skill definition.

A SHIPPED FILE IS REPORTED, NEVER WRITTEN. `update` overwrites anything under the workforce skill
and any path `.installed-external` records, so a rewrite there is undone by the next install; the
distribution's own pins are held to the template's lane picks at release instead. A symlink that
resolves outside the project is reported the same way: that file belongs to somebody else.

SUPERSEDED MODELS. `org-config.template.md` § Model statics › Superseded models maps a model the
pool replaced to its successor. `--heal-superseded` moves every recorded choice of one, once per
project (`heal_superseded`), and `wf-heal` runs it at session start; `--check` reports one still
recorded as `SUPERSEDED` (not yet moved: drift) or `SUPERSEDED-KEPT` (chosen again by hand after
the move: reported, not drift); `--lineup` marks one `[superseded by …]`. The user-scope
`advisorModel` moves once per config root (`heal_superseded_user`), from `wf-heal` and from
`wf-settings-apply --scope user --wire-defaults`.

EXIT  0  the plan or the lineup printed, or every write verified
      1  --check found drift; or --execute left a file unjudged or unresolved, a write failed
         to verify, or a symlink was lost or retargeted; or --heal-superseded left a value unmoved
      2  usage: no `.claude/` under the root, no lineup to resolve, an unknown lane, or a
         --judge path that names no model-pinned file
"""

import argparse
import datetime
import glob
import hashlib
import json
import os
import re
import sys

RECORD_REL = os.path.join(".claude", "workforce", "model-lanes.json")
CONFIG_REL = os.path.join(".claude", "workforce", "org-config.md")
TEMPLATE = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))),
                        "references", "org-config.template.md")

# The five employee-bearing lanes of `org-config.template.md` § The four lanes, spelled as
# one argv token each. The analytical lane carries the tier split, so it is two tokens.
LANES = ("analytical-lead", "analytical-ic", "creative-text", "creative-visual", "code")
# What each lane is for, in the words of that section's table and the budget questions'
# wording, so a reader of `--lineup` can pick a lane without opening the template.
LANE_WORK = {
    "analytical-lead": "agents that coordinate: hand work out and check what comes back",
    "analytical-ic": "agents that do the work: research, review, ops, anything not creative or code",
    "creative-text": "writing and copy: prose, docs, voice, translation",
    "creative-visual": "graphics, visual design, frontend design, image generation",
    "code": "writing, testing and refactoring software",
}
ADVISOR_WORK = "the main session's second opinion; no agent runs on it"
ADVISOR_RX = re.compile(r"\badvisorModel\s*:\s*`?([A-Za-z0-9][\w.\[\]-]*)")
RUNGS = ("max", "xhigh", "high", "medium", "low")
KEY_RX = re.compile(r"^([A-Za-z_][\w-]*)\s*:(.*)$")
MODEL_RX = re.compile(r"^[A-Za-z0-9][\w.\[\]-]*$")
BLOCK_SCALARS = ("", ">", "|", ">-", "|-", ">+", "|+")


# ── reading a file's frontmatter ─────────────────────────────────────────────

def _unquote(v):
    v = v.strip()
    if len(v) >= 2 and v[0] == v[-1] and v[0] in "\"'":
        return v[1:-1]
    return v


def frontmatter(text):
    """`(fields, line index per key, the file's lines)` or None when there is no `---` block.

    The lines keep their `\\r`, so a rewrite puts back the ending each line came with.
    `description:` may be folded over several indented lines; it is read whole, because the
    hash that decides a re-judgment must see the whole description, not its first line.
    """
    lines = text.split("\n")
    if not lines or lines[0].rstrip("\r") != "---":
        return None
    end = next((i for i in range(1, len(lines)) if lines[i].rstrip("\r") == "---"), None)
    if end is None:
        return None
    fields, index, i = {}, {}, 1
    while i < end:
        m = KEY_RX.match(lines[i].rstrip("\r"))
        if not m:
            i += 1
            continue
        key, val = m.group(1), m.group(2).strip()
        index.setdefault(key, i)
        j = i + 1
        cont = []
        while j < end and (lines[j][:1] in (" ", "\t") or not lines[j].strip()):
            cont.append(lines[j].strip())
            j += 1
        if key == "description" and cont:
            head = [] if val in BLOCK_SCALARS else [val]
            val = " ".join(head + [c for c in cont if c])
        fields.setdefault(key, _unquote(val))
        i = j
    return fields, index, lines


def description_hash(desc):
    return hashlib.sha256(" ".join((desc or "").split()).encode("utf-8")).hexdigest()[:16]


# ── the lineup ───────────────────────────────────────────────────────────────

def _model_cell(cell):
    tok = re.findall(r"`([^`]+)`", cell)
    v = (tok[0] if tok else cell).strip()
    return v if v and MODEL_RX.match(v) else None


def _effort_cell(cell):
    v = cell.replace("`", "").strip().lower()
    return v if v in RUNGS else None


def _lane_of(key):
    """The lane a row's first cell names, or None. `analytical · Lead` and `analytical / IC`
    are the receipt's spelling; `Lead (2)` and `IC (3)` are the analytical table's."""
    key = re.sub(r"[·/()]", " ", key)
    key = " ".join(key.split())
    if re.match(r"^(analytical )?lead\b", key):
        return "analytical-lead"
    if re.match(r"^(analytical )?ic\b", key):
        return "analytical-ic"
    for lane in ("creative-text", "creative-visual", "code"):
        if key.startswith(lane) or key.startswith(lane.replace("-", " ")):
            return lane
    return "creative" if key.startswith("creative") else None


SEPARATOR_RX = re.compile(r"^\|[\s:|-]+\|$")
# Headings whose tables reuse the lane words and are never a selection: the model pool and its
# Superseded map, the effort ladder, and the budget questions' wording.
NOT_A_LINEUP = ("statics", "superseded", "wording")


def _header_cols(cells):
    """`{"model", "effort", "tier"}` → column index, read off a table's header row, or None when
    the header names no Model column. A table with no Model column (`| Lane | What it covers |
    … |`, `| Department | … | Lane |`) is about the lanes, never a choice of model for one."""
    cols = {}
    for i, c in enumerate(cells):
        name = c.replace("`", "").replace("*", "").strip().lower()
        for col in ("model", "effort", "tier"):
            if col not in cols and (name == col or name.startswith(col + " ")):
                cols[col] = i
    return cols if "model" in cols else None


def parse_lineup(text):
    """`({lane: {"model", "effort"}}, {employee: {"model", "effort"}})` from an org-config.

    TOLERANT BY MEASUREMENT. Nine live configs on one workstation spell the lineup six ways:
    `| Creative-text model | … |` rows, a `| Lane | Model | Effort |` table, a pre-split
    `| Creative model |` that covers both creative lanes, `| Lead (2) | model | effort |` under a
    `| Tier | Model | Effort |` header, a `## Budget` receipt whose rows read `| analytical ·
    Lead | model | effort | source |`, and a `## The lanes` table whose header is `| Lane | Tier |
    Model | Effort |`, so its analytical rows name the tier in the SECOND cell.

    THE TABLE'S HEADER SAYS WHICH CELL IS WHICH, so the reader is not tied to one heading name.
    MEASURED 2026-11-09: laika records its whole lineup under `## The lanes`, a heading the old
    allow-list (`analytical`, `creative`, `code`) skipped, so `--lineup` printed `(none
    selected)` for all five lanes. A multi-column row is read when its table's header names a
    Model column, from the columns that header names; a Tier column is joined to the first cell
    (`analytical` + `Lead (2)`). A key-value row (`| Creative-visual model | id |`) names its own
    field. Headings only exclude and route: the pool, its Superseded map, the effort ladder and
    the question wording (NOT_A_LINEUP) are never read, `## Employee overrides` fills the
    overrides, and a budget receipt fills only what the lane tables left blank.
    """
    tables = {k: {"model": None, "effort": None} for k in LANES + ("creative",)}
    receipt = {k: {"model": None, "effort": None} for k in LANES + ("creative",)}
    overrides = {}
    section = ""
    header = None
    lines = text.splitlines()
    for i, raw in enumerate(lines):
        line = raw.strip()
        if line.startswith("#"):
            section = line.lstrip("#").strip().lower()
            header = None
            continue
        if not (line.startswith("|") and line.endswith("|")):
            header = None
            continue
        if SEPARATOR_RX.match(line):
            continue
        cells = [c.strip() for c in line.strip("|").split("|")]
        nxt = lines[i + 1].strip() if i + 1 < len(lines) else ""
        if SEPARATOR_RX.match(nxt):
            # This row heads its table. In a key-value table it is also the first value, and
            # a header such as `| Lane | Tier | … |` names no lane, so it is read on below.
            header = _header_cols(cells)
        key = cells[0].replace("`", "").replace("*", "").strip().lower()
        if section.startswith("employee overrides"):
            if len(cells) >= 3 and key and key != "employee":
                overrides[key] = {"model": _model_cell(cells[1]), "effort": _effort_cell(cells[2])}
            continue
        if any(word in section for word in NOT_A_LINEUP):
            continue
        into = receipt if section.startswith("budget") else tables
        if len(cells) < 2:
            continue
        if len(cells) >= 3 and "model" not in key and "effort" not in key:
            if header is None:
                continue
            tier = header.get("tier", 0)
            if 0 < tier < len(cells):
                key = f"{key} {cells[tier].replace('`', '').replace('*', '').strip().lower()}"
            lane = _lane_of(key)
            if lane is None:
                continue
            mi, ei = header["model"], header.get("effort")
            into[lane]["model"] = _model_cell(cells[mi]) if mi < len(cells) else None
            into[lane]["effort"] = _effort_cell(cells[ei]) if ei is not None and ei < len(cells) \
                else None
            continue
        lane = _lane_of(key)
        if lane is None:
            continue
        if "model" in key:
            into[lane]["model"] = _model_cell(cells[1])
        elif "effort" in key:
            into[lane]["effort"] = _effort_cell(cells[1])
    lanes = {}
    for lane in LANES:
        fallbacks = [tables[lane], receipt[lane]]
        if lane.startswith("creative"):
            fallbacks += [tables["creative"], receipt["creative"]]
        lanes[lane] = {f: next((c[f] for c in fallbacks if c[f]), None) for f in ("model", "effort")}
    return lanes, overrides


def parse_advisor(text):
    """The advisor model an org-config records, or None.

    TOLERANT BY MEASUREMENT, like `parse_lineup`. Live configs spell it three ways: the
    template's `| Advisor model | `id` |`, a budget receipt's `| advisor | main session | `id` |
    n/a |`, and a prose `advisorModel: id`. In a table only a backticked cell is a model, because
    the lane table's `| **Advisor** | the main session's advisor … | no |` names none. A blank
    `Advisor model` cell is a declined advisor, and reads as None.
    """
    for raw in text.splitlines():
        line = raw.strip()
        if line.startswith("|") and line.endswith("|"):
            cells = [c.strip() for c in line.strip("|").split("|")]
            key = cells[0].replace("`", "").replace("*", "").strip().lower()
            if key == "advisor model":
                return _model_cell(cells[1]) if len(cells) > 1 and "`" in cells[1] else None
            if key == "advisor":
                found = [_model_cell(c) for c in cells[1:] if "`" in c]
                if any(found):
                    return next(m for m in found if m)
            continue
        m = ADVISOR_RX.search(line)
        if m:
            return m.group(1)
    return None


def lineup_source(root):
    """`(text, source label)` of the file the lineup is read from, or None when neither can be
    read. A `root` of None reads the shipped template alone: a user-scope definition runs in
    every project, so no one project's `org-config.md` governs it."""
    places = [] if root is None else [(os.path.join(root, CONFIG_REL), CONFIG_REL)]
    places.append((TEMPLATE, "the shipped org-config.template.md (no project org-config.md)"))
    for path, label in places:
        try:
            with open(path, encoding="utf-8") as fh:
                return fh.read(), label
        except (OSError, UnicodeDecodeError):
            continue
    return None


def load_lineup(root):
    """`(lanes, overrides, source label)`, or None when neither file can be read."""
    src = lineup_source(root)
    if src is None:
        return None
    lanes, overrides = parse_lineup(src[0])
    return lanes, overrides, src[1]


def lineup_lines(root):
    """The lineup as lines — each lane's model and effort and the work it is for, then the
    advisor — or None when no lineup can be read. `--lineup` prints these and `wf-code-origin`
    imports this function, so the lineup a definition's author sees and the one the audit
    reconciles against are one reading."""
    src = lineup_source(root)
    if src is None:
        return None
    text, label = src
    lanes, _overrides = parse_lineup(text)
    smap = superseded_map()

    def note(model):
        return f"  [superseded by {smap[model][0]}]" if model in smap else ""
    out = [f"Model lineup, from {label}:"]
    for lane in LANES:
        c = lanes[lane]
        pin = f"{c['model'] or '(none selected)'} · {c['effort'] or '(none selected)'}"
        out.append(f"  {lane:<16} {pin:<24}  {LANE_WORK[lane]}{note(c['model'])}")
    adv = parse_advisor(text)
    out.append(f"  {'advisor':<16} {adv or '(none recorded)':<24}  {ADVISOR_WORK}{note(adv)}")
    return out


def resolve(lane, name, tier, lanes, overrides):
    """`(model, effort, source)` for one file, per `org-config.template.md` § Resolution.

    Model and effort fall through the levels separately: a blank cell disables its level for
    that field alone. The bottom is the analytical row for the file's tier — Lead when the
    lane is the Lead tier or the handbook's ORG-RECORD says tier 2, IC otherwise.

    A blank all the way down is `None`, and `None` is NEVER WRITTEN. A blank cell and a config
    this parser could not read look identical from here, and treating the second as "inherit"
    would strip the pin from every file in the project. So a missing model is reported
    UNRESOLVED and the file is left as it is; a missing effort leaves the `effort:` line alone.
    """
    analytical = lanes["analytical-lead" if lane == "analytical-lead" or tier == "2"
                       else "analytical-ic"]
    levels = []
    if name and name.lower() in overrides:
        levels.append(("employee override", overrides[name.lower()]))
    if lane not in ("analytical-lead", "analytical-ic"):
        levels.append((lane + " lane", lanes[lane]))
    levels.append(("analytical tier", analytical))
    out, src = {}, []
    for field in ("model", "effort"):
        out[field] = None
        for label, cells in levels:
            if cells.get(field):
                out[field] = cells[field]
                if label not in src:
                    src.append(label)
                break
    # `claude-haiku-4-5` takes no effort setting (`org-config.template.md` § Effort statics),
    # so no lane rung is written onto a file pinned to it.
    if out["model"] and out["model"].startswith("claude-haiku"):
        out["effort"] = None
    return out["model"], out["effort"], " + ".join(src) or "inherit"


# ── enumeration ──────────────────────────────────────────────────────────────

def _realpath(p):
    try:
        return os.path.realpath(p)
    except OSError:
        return p


def installer_paths(root):
    """Every path a workforce install recorded writing, from both possible records."""
    cfg = os.environ.get("CLAUDE_CONFIG_DIR") or os.path.join(os.path.expanduser("~"), ".claude")
    out = set()
    for base in (os.path.join(root, ".claude"), cfg):
        try:
            with open(os.path.join(base, "skills", "workforce", ".installed-external"),
                      encoding="utf-8") as fh:
                out.update(_realpath(l.strip()) for l in fh if l.strip())
        except (OSError, UnicodeDecodeError):
            continue
    return out


def candidates(root):
    """Every file that could pin a model, in a stable order, project-relative."""
    out = []
    agents = os.path.join(root, ".claude", "agents")
    # Recursive and NOT following directory links, the walk `wf-org-sync.project_agents` uses
    # and for the reason it records: `**` descends a symlinked directory and can loop.
    for dp, dn, fn in os.walk(agents):
        dn.sort()
        out += [os.path.join(dp, f) for f in sorted(fn) if f.endswith(".md")]
    skills = os.path.join(root, ".claude", "skills")
    out += sorted(glob.glob(os.path.join(skills, "*", "agents", "*", "AGENT.md")))
    out += sorted(glob.glob(os.path.join(skills, "*", "SKILL.md")))
    return [os.path.relpath(p, root) for p in out if os.path.isfile(p)]


def _read(path):
    try:
        with open(path, encoding="utf-8", newline="") as fh:
            return fh.read()
    except (OSError, UnicodeDecodeError):
        return None


def enumerate_files(root):
    """One row per distinct file that pins a model. A second path to the same file — the
    registration symlink beside the AGENT.md it points at — is folded into the first."""
    shipped = installer_paths(root)
    inside = _realpath(root).rstrip(os.sep) + os.sep
    rows, seen = [], {}
    for rel in candidates(root):
        path = os.path.join(root, rel)
        real = _realpath(path)
        if real in seen:
            seen[real]["aliases"].append(rel)
            continue
        text = _read(path)
        fm = frontmatter(text) if text is not None else None
        if not fm or not fm[0].get("model") or fm[0]["model"].lower() == "inherit":
            continue
        fields = fm[0]
        tier = re.search(r"<!--\s*tier:\s*(\d)", text)
        row = {
            "rel": rel, "path": path, "real": real, "aliases": [],
            "kind": "skill" if rel.endswith("SKILL.md") else "agent",
            "name": fields.get("name") or os.path.splitext(os.path.basename(rel))[0],
            "description": fields.get("description", ""),
            "model": fields.get("model"), "effort": fields.get("effort"),
            "tier": tier.group(1) if tier else None,
            "link": os.path.islink(path),
            # A link that leaves the project is somebody else's file: reported, never written.
            "outside": not real.startswith(inside),
            "shipped": real in shipped or rel.startswith(os.path.join(".claude", "skills", "workforce") + os.sep),
        }
        row["hash"] = description_hash(row["description"])
        seen[real] = row
        rows.append(row)
    return rows


# ── the record ───────────────────────────────────────────────────────────────

def load_record(root):
    try:
        with open(os.path.join(root, RECORD_REL), encoding="utf-8") as fh:
            data = json.load(fh)
        return data.get("files", {}) if isinstance(data, dict) else {}
    except (OSError, ValueError, UnicodeDecodeError):
        return {}


def save_record(root, files):
    path = os.path.join(root, RECORD_REL)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    body = {"_about": "Written by wf-model-lanes. Each model-pinned file's judged lane and the "
                      "hash of the description it was judged from; a moved hash re-judges it.",
            "files": dict(sorted(files.items()))}
    with open(path, "w", encoding="utf-8") as fh:
        json.dump(body, fh, indent=2, ensure_ascii=False)
        fh.write("\n")


# ── the rewrite ──────────────────────────────────────────────────────────────

def rewrite(row, model, effort):
    """Set `model:` and `effort:` in place and re-read; return the error, or None.

    Writes THROUGH a symlink — `open(path, "w")` truncates the target, so the link survives
    and the file that owns the registration receives the edit. Never rename-in-place.
    `None` leaves that line alone. Only an agent gains an `effort:` line it did not carry; a
    skill's is rewritten only where the skill already declares one.
    """
    text = _read(row["path"])
    fm = frontmatter(text) if text is not None else None
    if not fm:
        return "unreadable or its frontmatter moved during the run"
    _fields, index, lines = fm
    edits = {}
    for key, want in (("model", model), ("effort", effort)):
        if key in index and want is not None:
            cr = "\r" if lines[index[key]].endswith("\r") else ""
            edits[index[key]] = f"{key}: {want}{cr}"
    if effort and "effort" not in index and row["kind"] == "agent":
        at = index["model"]
        cr = "\r" if lines[at].endswith("\r") else ""
        edits[at] = [edits.get(at, lines[at]), f"effort: {effort}{cr}"]
    out = []
    for i, line in enumerate(lines):
        if i not in edits:
            out.append(line)
        elif isinstance(edits[i], list):
            out.extend(edits[i])
        else:
            out.append(edits[i])
    try:
        with open(row["path"], "w", encoding="utf-8", newline="") as fh:
            fh.write("\n".join(out))
    except OSError as exc:
        return f"write failed: {exc.strerror}"
    back = frontmatter(_read(row["path"]) or "")
    got = (back[0].get("model"), back[0].get("effort")) if back else (None, None)
    if got != (model, effort if effort is not None else row["effort"]):
        return f"re-read shows model {got[0]} · effort {got[1]}"
    return None


def _symlinks(rows):
    return {r["rel"]: r["real"] for r in rows if r["link"]}


# ── superseded models ────────────────────────────────────────────────────────
#
# WHY THIS EXISTS. A recorded model choice moved only when somebody answered the budget again,
# so a pool row's replacement reached no project that had already picked the old row. MEASURED
# 2026-11-09, the day row 1 moved from Fable 5.1 to 5.2: `--lineup` and `--check` called a
# project's recorded `claude-fable-5-1` healthy, `verify` agreed, and `update` touched nothing.
# User decision that day: "Their next workforce session moves every 5.1 choice to 5.2 and says
# so, with no audit needed … a project can still pick 5.1 by hand afterward."
#
# THE MAP IS `org-config.template.md` § Model statics › Superseded models, read from the shipped
# template and from nowhere else. The next model swap is a row there, never an edit here.

SUPERSEDED_REL = os.path.join(".claude", "workforce", ".models-superseded.json")
SUPERSEDED_HEADING = re.compile(r"^#{2,6}\s+Superseded models\b", re.I)
SETTINGS_NAMES = ("settings.json", "settings.local.json")


def superseded_map(template=TEMPLATE):
    """`{old: (successor, since)}` from the template's Superseded models table, each chain
    followed to its last successor. A row naming a cycle is dropped; {} when unreadable.
    Both ID cells must be one backticked ID, so the header row is never read as a pair."""
    try:
        with open(template, encoding="utf-8") as fh:
            text = fh.read()
    except (OSError, UnicodeDecodeError):
        return {}
    pairs, inside = {}, False
    for raw in text.splitlines():
        line = raw.strip()
        if line.startswith("#"):
            inside = bool(SUPERSEDED_HEADING.match(line))
            continue
        if not inside or not line.startswith("|"):
            continue
        cells = [c.strip() for c in line.strip("|").split("|")]
        ids = [re.findall(r"`([^`]+)`", c) for c in cells[:2]]
        if len(cells) < 3 or not all(len(t) == 1 and MODEL_RX.match(t[0]) for t in ids):
            continue
        pairs[ids[0][0]] = (ids[1][0], cells[2].replace("`", "").strip())
    out = {}
    for old, (new, since) in pairs.items():
        seen = {old}
        while new in pairs and new not in seen:
            seen.add(new)
            new = pairs[new][0]
        if new not in seen:
            out[old] = (new, since)
    return out


def _id_rx(model):
    """The ID as a whole token: `claude-fable-5-1` never matches inside `claude-fable-5-10`."""
    return re.compile(r"(?<![\w.\[\]-])" + re.escape(model) + r"(?![\w.\[\]-])")


def config_hits(text, smap):
    """`[(line index, old, label)]` — every recorded choice of a superseded ID in an org-config.

    WIDER THAN `parse_lineup`, ON PURPOSE. A recorded choice is any TABLE ROW or `advisorModel:`
    line naming the ID, not only the rows the lineup reader understands. MEASURED 2026-11-09:
    one live config recorded `| creative-visual | any | `claude-fable-5-1` | medium |` under
    `## The lanes`, a heading `parse_lineup` then read nothing under (it reads that table by its
    header now), and a heal held to the lineup's reading would have left that choice on 5.1. The
    next shape the lineup reader misses is the same risk, so do not narrow this to match it.

    WHAT IS NEVER A CHOICE, each a guard against the wider reading: prose (history, and the
    user's own sentences); every line under a heading naming `statics` until a heading of the
    same or higher level (a legacy pool copy — reported stale elsewhere, never rewritten); a row
    whose first cell is a bare number (the pool's `#` column, should a copy lose its heading);
    and anything inside a fenced block.
    """
    hits, skip_level, fence = [], None, False
    for i, raw in enumerate(text.split("\n")):
        line = raw.strip()
        if line.startswith(("```", "~~~")):
            fence = not fence
            continue
        if fence:
            continue
        if line.startswith("#"):
            level = len(line) - len(line.lstrip("#"))
            if "statics" in line.lower():
                skip_level = level
            elif skip_level is not None and level <= skip_level:
                skip_level = None
            continue
        if skip_level is not None:
            continue
        if line.startswith("|") and line.endswith("|"):
            if re.match(r"^\|[\s:|-]+\|$", line):
                continue
            first = line.strip("|").split("|")[0].replace("`", "").replace("*", "").strip()
            if first.isdigit():
                continue
            for old in smap:
                if _id_rx(old).search(line):
                    hits.append((i, old, first or "table row"))
            continue
        m = ADVISOR_RX.search(line)
        if m and m.group(1) in smap:
            hits.append((i, m.group(1), "advisorModel"))
    return hits


def _sibling(name):
    """A sibling shipped script, imported by path, leaving no bytecode in the shipped bin/."""
    import importlib.machinery
    import importlib.util
    prev = sys.dont_write_bytecode
    sys.dont_write_bytecode = True
    try:
        mod_name = name.replace("-", "_")
        loader = importlib.machinery.SourceFileLoader(
            mod_name, os.path.join(os.path.dirname(os.path.abspath(__file__)), name))
        mod = importlib.util.module_from_spec(importlib.util.spec_from_loader(mod_name, loader))
        loader.exec_module(mod)
        return mod
    finally:
        sys.dont_write_bytecode = prev


def _strict_json(text):
    """The parsed object, or None when it is not one or carries a duplicate key: the harness
    keeps one of two duplicates, and a rewrite would silently choose for it."""
    def pairs(kv):
        d = {}
        for k, v in kv:
            if k in d:
                raise ValueError(k)
            d[k] = v
        return d
    try:
        data = json.loads(text, object_pairs_hook=pairs)
    except ValueError:
        return None
    return data if isinstance(data, dict) else None


def superseded_refusal(root):
    """Why no recorded choice in this project may be moved, or None.

    A `.claude` that is the personal config root — `$CLAUDE_CONFIG_DIR` or `~/.claude`, which
    is what a project rooted at `$HOME` has — holds USER-scope agents and settings, not a
    project's records. A `.claude` or `.claude/workforce` that leads out of the project, or a
    project with no `.claude/workforce` at all, has no org that recorded a choice here.
    Restated from `wf-settings-apply._project_refusal` as two realpaths rather than imported,
    because this runs at every session start that gets past `wf-heal`'s gate.
    """
    claude = os.path.join(root, ".claude")
    wfdir = os.path.join(claude, "workforce")
    if not os.path.isdir(wfdir) or os.path.islink(wfdir):
        return "no .claude/workforce here, so no org recorded a model choice"
    here, real = _realpath(root), _realpath(claude)
    if not real.startswith(here.rstrip(os.sep) + os.sep):
        return f"{claude} resolves outside the project ({real})"
    home = os.path.join(os.path.expanduser("~"), ".claude")
    cfg = os.environ.get("CLAUDE_CONFIG_DIR") or home
    if real in {_realpath(cfg), _realpath(home)}:
        return f"{claude} is the personal config root, whose files are user scope"
    return None


def read_marker(root, path=None):
    """`{"template": digest, "moved": {old: {"to", "on"}}}` — what this project (or, given
    `path`, this config root) was moved off. A link at the name is not read (O_NOFOLLOW), and
    reads as no marker."""
    try:
        fd = os.open(path or os.path.join(root, SUPERSEDED_REL),
                     os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
        with os.fdopen(fd, encoding="utf-8") as fh:
            data = json.load(fh)
    except (OSError, ValueError, UnicodeDecodeError):
        return {"moved": {}}
    if not isinstance(data, dict) or not isinstance(data.get("moved"), dict):
        return {"moved": {}}
    return data


def template_digest(template=TEMPLATE):
    """sha256 of the shipped template's bytes. `wf-heal` compares this against the marker's
    `template` to skip the scan when nothing could have changed since the last one."""
    try:
        with open(template, "rb") as fh:
            return hashlib.sha256(fh.read()).hexdigest()
    except OSError:
        return None


def find_superseded(root, smap):
    """Every recorded choice of a superseded ID in this project, read-only. Each is a dict:
    `kind` (agent, config, settings), `rel`, `where` (what a person reads), `old`, `new`,
    `since`, `refused` (why it may not be written, or None), plus what the writer needs."""
    out = []
    if not smap:
        return out

    def hit(kind, rel, where, old, refused=None, **extra):
        new, since = smap[old]
        out.append(dict(kind=kind, rel=rel, where=where, old=old, new=new, since=since,
                        refused=refused, **extra))

    for r in enumerate_files(root):
        # A SHIPPED FILE IS NOT THIS PROJECT'S CHOICE: `update` owns it and the distribution's
        # pins are held to the template at release, so it is not listed at all.
        if r["model"] not in smap or r["shipped"]:
            continue
        where = f"{r['rel']} (model:)"
        if r["link"] and not r["outside"]:
            where = f"{r['rel']} (model:, written through its link to " \
                    f"{os.path.relpath(r['real'], _realpath(root))})"
        refused = f"it links to {r['real']}, outside this project" if r["outside"] else None
        hit("agent", r["rel"], where, r["model"], refused, row=r)

    cfg = os.path.join(root, CONFIG_REL)
    text = _read(cfg)
    if text is not None:
        refused = None if _realpath(cfg).startswith(_realpath(root).rstrip(os.sep) + os.sep) \
            else f"it resolves outside the project ({_realpath(cfg)})"
        for i, old, label in config_hits(text, smap):
            hit("config", CONFIG_REL, f"{CONFIG_REL}:{i + 1} ({label})", old, refused, line=i)

    for name in SETTINGS_NAMES:
        rel = os.path.join(".claude", name)
        text = _read(os.path.join(root, rel))
        data = _strict_json(text) if text is not None else None
        model = data.get("advisorModel") if data else None
        if isinstance(model, str) and model in smap:
            hit("settings", rel, f"{rel} (advisorModel)", model)
    return out


def _move_config(root, rel, found):
    """Rewrite the found lines of the org-config in place, through a link to a target inside
    the project, and re-read. Returns {line index: error or None}."""
    path = os.path.join(root, rel)
    text = _read(path)
    if text is None:
        return {f["line"]: "unreadable" for f in found}
    lines = text.split("\n")
    for f in found:
        lines[f["line"]] = _id_rx(f["old"]).sub(f["new"], lines[f["line"]])
    try:
        with open(path, "w", encoding="utf-8", newline="") as fh:
            fh.write("\n".join(lines))
    except OSError as exc:
        return {f["line"]: f"write failed: {exc.strerror}" for f in found}
    back = (_read(path) or "").split("\n")
    return {f["line"]: None if f["line"] < len(back) and back[f["line"]] == lines[f["line"]]
            and not _id_rx(f["old"]).search(back[f["line"]]) else "re-read shows the old line"
            for f in found}


def _move_settings(root, f, wsa):
    """A project settings file's `advisorModel`, moved by `_swap_advisor` once
    `wf-settings-apply`'s own per-file refusal lets it be written. Returns the error, or None."""
    path = os.path.join(root, f["rel"])
    why = wsa._file_refusal(root, path)
    if why:
        return why
    return _swap_advisor(path, f["old"], f["new"], wsa)


def _swap_advisor(path, old, new, wsa):
    """Change ONLY the value of the top-level `advisorModel` key — the characters of the old ID
    and nothing else, so every other byte of the file is as it was (never load-and-dump). The
    result is parsed and must differ from the original in that one key alone. Written to where
    the name resolves. Returns the error, or None. Whether `path` may be written at all is the
    caller's question: a project file and the user's own file answer it differently."""
    text = _read(path)
    before = _strict_json(text) if text is not None else None
    if not before or before.get("advisorModel") != old:
        return "the file changed since it was read"
    rx = re.compile(r'("advisorModel"\s*:\s*")' + re.escape(old) + r'"')
    if len(rx.findall(text)) != 1:
        return "`advisorModel` is spelled more than once or escaped; left for a hand edit"
    after_text = rx.sub(lambda m: m.group(1) + new + '"', text)
    after = _strict_json(after_text)
    if not after or after.get("advisorModel") != new or \
            dict(after, advisorModel=None) != dict(before, advisorModel=None):
        return "the edit would change more than the one value; left for a hand edit"
    try:
        wsa._atomic_write(_realpath(path), after_text, before=text)
    except (OSError, RuntimeError) as exc:
        return str(exc)
    back = _strict_json(_read(path) or "")
    return None if back and back.get("advisorModel") == new else "re-read shows the old value"


def _write_marker(root, marker, wsa, path=None, whose="this project was"):
    path = path or os.path.join(root, SUPERSEDED_REL)
    why = wsa.write_refusal(root, path)
    if why:
        return why
    body = {"_about": f"Written by wf-model-lanes. Each superseded model ID {whose} "
                      "moved off, once; an ID listed here is never moved again, so a choice "
                      "of it made afterward stands.",
            "template": marker.get("template"), "moved": dict(sorted(marker["moved"].items()))}
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        wsa._atomic_write(path, json.dumps(body, indent=2, ensure_ascii=False) + "\n")
    except OSError as exc:
        return exc.strerror or str(exc)
    return None


def heal_superseded(root, execute, progress=None):
    """Move every recorded choice of a superseded model ID to its successor, ONCE per project.

    Returns `{"lines", "moved", "failed", "refused", "rc"}`; `lines` is what the session or the
    CLI prints, one per value moved or left, then one closing line per ID that moved.
    Without `execute` nothing is written and the lines say "would move".

    ONCE, AND WHY: the user's decision keeps a hand re-pick ("a project can still pick 5.1 by
    hand afterward"). `.claude/workforce/.models-superseded.json` lists every ID this project
    has been moved off, and an ID listed there is never moved again. An ID is listed only when
    every value it was found in moved and re-read correctly, so a refused or failed write leaves
    it pending and the next run tries again and says so. The marker also carries the template
    digest `wf-heal` gates on; it is written only when nothing failed, so a failure is retried.

    WRITES: a model-pinned file through `rewrite` (through a symlink, never over it — SKILL.md
    Atomic-or-Absent rule 3); the org-config line by line through its link; a settings file
    through `wf-settings-apply`'s own refusal and atomic writer, changing one value only.
    """
    res = {"lines": [], "moved": 0, "failed": 0, "refused": superseded_refusal(root), "rc": 0}
    if res["refused"]:
        return res
    smap = superseded_map()
    marker = read_marker(root)
    done = marker["moved"]
    found = [f for f in find_superseded(root, smap) if f["old"] not in done]
    if progress is None:
        progress = {"wrote": []}
    links_before = _symlinks(enumerate_files(root)) if execute else {}
    errors = {}
    wsa = None
    by_line = {}
    if execute:
        cfg = [f for f in found if f["kind"] == "config" and not f["refused"]]
        if cfg:
            by_line = _move_config(root, CONFIG_REL, cfg)
            progress["wrote"].append(CONFIG_REL)
    for f in found:
        verb = "MOVED" if execute else "WOULD MOVE"
        err = f["refused"]
        if execute and not err:
            if f["kind"] == "agent":
                err = rewrite(f["row"], f["new"], None)
                progress["wrote"].append(f["rel"])
            elif f["kind"] == "config":
                err = by_line.get(f["line"])
            else:
                wsa = wsa or _sibling("wf-settings-apply")
                err = _move_settings(root, f, wsa)
                progress["wrote"].append(f["rel"])
        if err:
            errors.setdefault(f["old"], []).append(err)
            res["failed"] += 1
            res["lines"].append(f"MODEL NOT MOVED  {f['where']}: {f['old']} stays — {err}. "
                                f"Its successor is {f['new']}; run /workforce verify.")
            continue
        res["moved"] += 1
        res["lines"].append(f"MODEL {verb}  {f['where']}: {f['old']} → {f['new']}")
    for old in sorted({f["old"] for f in found if f["old"] not in errors}):
        new, since = smap[old]
        res["lines"].append(
            f"MODEL {'MOVED' if execute else 'WOULD MOVE'}  {old} was superseded by {new} on "
            f"{since}, so each choice of it above {'moved' if execute else 'would move'}, once. "
            f"Choose {old} again by hand (/workforce model-map) and it stays.")
    if not execute:
        res["rc"] = 1 if res["failed"] else 0
        return res
    after = _symlinks(enumerate_files(root))
    for k, v in links_before.items():
        if after.get(k) != v:
            res["failed"] += 1
            res["lines"].append(f"MODEL NOT MOVED  {k} was a symlink to {v} and no longer is.")
            errors.setdefault("(symlink)", []).append(k)
    today = datetime.date.today().isoformat()
    was = json.dumps(marker, sort_keys=True)
    for old, (new, _since) in smap.items():
        if old not in done and old not in errors:
            done[old] = {"to": new, "on": today}
    marker["template"] = None if errors else template_digest()
    if json.dumps(marker, sort_keys=True) == was:
        res["rc"] = 1 if res["failed"] else 0
        return res
    wsa = wsa or _sibling("wf-settings-apply")
    why = _write_marker(root, marker, wsa)
    # AN UNWRITABLE MARKER IS A FAILURE ONLY WHEN SOMETHING MOVED: then a later hand re-pick
    # is no longer protected, and that is said. With nothing moved it costs a rescan, no more,
    # and a read-only `.claude/workforce` must not fail `--heal` (`sa-heal-readonly-record-dir`).
    if why and res["moved"]:
        res["failed"] += 1
        res["lines"].append(f"MODEL MARKER NOT WRITTEN  {SUPERSEDED_REL}: {why}. Each move above "
                            f"stands; the next run re-checks and finds nothing left to move.")
    else:
        progress["wrote"].append(SUPERSEDED_REL)
    res["rc"] = 1 if res["failed"] else 0
    return res


# Under the personal config root, beside the user-scope `.settings-owned.json`.
USER_MARKER_REL = os.path.join("workforce", ".models-superseded.json")


def heal_superseded_user(execute, progress=None, wsa=None):
    """Move the USER-SCOPE `advisorModel` off a superseded model to its successor, ONCE per
    personal config root. Returns the same shape as `heal_superseded`.

    THE DEFECT. `heal_superseded` refuses user scope, so the one model choice user scope records
    never moved. MEASURED 2026-11-09: this workstation's `~/.claude/settings.json` still read
    `"advisorModel": "claude-fable-5-1"` after the project heal shipped. The user's decision that
    day covers it: "Their next workforce session moves every 5.1 choice to 5.2 and says so."

    WHAT IS MOVED: the top-level `advisorModel` of `<config root>/settings.json` and nothing
    else, by the same one-value edit a project's gets (`_swap_advisor`). It is written to where
    the name resolves, as `wf-settings-apply.clear_retired_style` writes this file: it is the
    user's own, often linked into a dotfiles repository, not a name a repository planted. An
    absent file, or one that is not a single JSON object without duplicate keys, is left with
    nothing said and nothing recorded, so a value that could not be read is never frozen.

    ONCE, SO A HAND RE-PICK STANDS: `<config root>/workforce/.models-superseded.json`, the
    project marker's format. AT A PROJECT ROOTED AT $HOME THE TWO ARE ONE FILE, ON PURPOSE:
    `heal_superseded` refuses that `.claude` (it is user scope), so this is its only writer;
    `wf-heal`'s project gate then stops at the digest stamped here instead of importing and
    refusing at every session start, and `--check` there reads a re-pick as SUPERSEDED-KEPT.
    Do not split it into two files.

    TWO CALLERS, NO COMMAND TYPED: `wf-heal` at every session start, which reaches a machine
    updated by `bin/sync` (it wires nothing), and `wf-settings-apply --scope user
    --wire-defaults`, which the installer runs at every `--user` install and update.
    """
    res = {"lines": [], "moved": 0, "failed": 0, "refused": None, "rc": 0}
    wsa = wsa or _sibling("wf-settings-apply")
    if progress is None:
        progress = {"wrote": []}
    cfg, spath = wsa.config_root(), wsa.user_settings_path()
    text = _read(spath) if os.path.isfile(spath) else None
    data = _strict_json(text) if text is not None else None
    if data is None:
        res["refused"] = f"{spath} is absent, unreadable, or not one JSON object"
        return res
    smap = superseded_map()
    mpath = os.path.join(cfg, USER_MARKER_REL)
    marker = read_marker(None, mpath)
    done = marker["moved"]
    old = data.get("advisorModel")
    failed = None
    if isinstance(old, str) and old in smap and old not in done:
        new, since = smap[old]
        where = f"{spath} (advisorModel)"
        err = _swap_advisor(spath, old, new, wsa) if execute else None
        if err and (_strict_json(_read(spath) or "") or {}).get("advisorModel") == new:
            # ANOTHER SESSION STARTED AT THE SAME MOMENT AND MOVED IT, and said so. A NOT MOVED
            # line here would be false about a value that is on its successor.
            err = None
        elif err:
            failed = old
            res["failed"] += 1
            res["lines"].append(f"MODEL NOT MOVED  {where}: {old} stays — {err}. Its successor "
                                f"is {new}; the next session start tries again.")
        else:
            verb = "MOVED" if execute else "WOULD MOVE"
            res["moved"] += 1
            if execute:
                progress["wrote"].append(spath)
            res["lines"] += [
                f"MODEL {verb}  {where}: {old} → {new}",
                f"MODEL {verb}  {old} was superseded by {new} on {since}, so your user-scope "
                f"advisorModel {'moved' if execute else 'would move'}, once. Set it to {old} "
                f"again by hand and it stays."]
    if not execute:
        return res
    was = json.dumps(marker, sort_keys=True)
    today = datetime.date.today().isoformat()
    for o, (n, _since) in smap.items():
        if o not in done and o != failed:
            done[o] = {"to": n, "on": today}
    marker["template"] = None if failed else template_digest()
    if json.dumps(marker, sort_keys=True) != was:
        why = _write_marker(cfg, marker, wsa, mpath, "this config root's user scope was")
        if why and res["moved"]:
            res["failed"] += 1
            res["lines"].append(f"MODEL MARKER NOT WRITTEN  {mpath}: {why}. The move above "
                                f"stands; the next session re-checks and finds nothing to move.")
        elif not why:
            progress["wrote"].append(mpath)
    res["rc"] = 1 if res["failed"] else 0
    return res


# ── main ─────────────────────────────────────────────────────────────────────

def main():
    ap = argparse.ArgumentParser(description="Keep every model-pinned file on its lane's model.")
    ap.add_argument("--root", required=True)
    ap.add_argument("--judge", nargs=3, action="append", default=[], metavar=("PATH", "LANE", "WHY"),
                    help="record PATH's lane (one of: %s) and the reason, read from its description"
                    % ", ".join(LANES))
    ap.add_argument("--execute", action="store_true", help="write the record and the rewrites")
    ap.add_argument("--check", action="store_true", help="read-only; exit 1 on any drift")
    ap.add_argument("--lineup", action="store_true",
                    help="print each lane's model and effort and the advisor; read-only")
    ap.add_argument("--heal-superseded", action="store_true",
                    help="move each recorded choice of a superseded model ID to its successor, "
                         "once per project; with --execute it writes")
    args = ap.parse_args()
    if args.check and (args.execute or args.judge):
        ap.error("--check is read-only; it takes neither --execute nor --judge")
    if args.lineup and (args.check or args.execute or args.judge or args.heal_superseded):
        ap.error("--lineup only prints; it takes no other mode")
    if args.heal_superseded and (args.check or args.judge):
        ap.error("--heal-superseded takes only --execute")

    root = os.path.abspath(args.root)
    if args.heal_superseded:
        res = heal_superseded(root, args.execute)
        print(f"wf-model-lanes --heal-superseded — {root}")
        if res["refused"]:
            print(f"  nothing to move: {res['refused']}")
            return 0
        for line in res["lines"]:
            print(f"  {line}")
        print(f"INV-SUPERSEDED  {res['moved']} {'moved' if args.execute else 'to move'} · "
              f"{res['failed']} not moved")
        if not args.execute and res["moved"]:
            print("  apply with: --execute")
        return res["rc"]
    if args.lineup:
        lines = lineup_lines(root)
        if lines is None:
            print(f"wf-model-lanes: no lineup — neither {CONFIG_REL} nor {TEMPLATE} is readable",
                  file=sys.stderr)
            return 2
        print("\n".join(lines))
        return 0
    if not os.path.isdir(os.path.join(root, ".claude")):
        print(f"wf-model-lanes: no .claude under {root}", file=sys.stderr)
        return 2
    lineup = load_lineup(root)
    if lineup is None:
        print(f"wf-model-lanes: no lineup — neither {CONFIG_REL} nor {TEMPLATE} is readable",
              file=sys.stderr)
        return 2
    lanes, overrides, source = lineup
    rows = enumerate_files(root)
    by_rel = {r["rel"]: r for r in rows}
    for r in rows:
        for a in r["aliases"]:
            by_rel[a] = r

    record = load_record(root)
    judged = {}
    for path, lane, why in args.judge:
        rel = os.path.relpath(os.path.abspath(os.path.join(root, path)), root)
        if lane not in LANES:
            print(f"wf-model-lanes: unknown lane {lane!r} for {rel} — one of {', '.join(LANES)}",
                  file=sys.stderr)
            return 2
        if rel not in by_rel:
            print(f"wf-model-lanes: --judge {rel}: not a model-pinned file under .claude/",
                  file=sys.stderr)
            return 2
        if by_rel[rel]["shipped"] or by_rel[rel]["outside"]:
            print(f"wf-model-lanes: --judge {rel}: a shipped file or one outside the project — "
                  f"not this project's to rewrite",
                  file=sys.stderr)
            return 2
        judged[by_rel[rel]["rel"]] = (lane, why.strip())

    print(f"wf-model-lanes — {root}")
    print(f"lineup from {source}")
    for lane in LANES:
        c = lanes[lane]
        print(f"  {lane:<16} {c['model'] or '(none selected)'} · {c['effort'] or '(none selected)'}")
    for emp, c in sorted(overrides.items()):
        print(f"  override {emp:<7} {c['model'] or '-'} · {c['effort'] or '-'}")
    # AN OVERRIDE THAT NAMES NOBODY IS THE USER'S PIN LOST SILENTLY: the lane default would be
    # written where they chose a model by hand. It is matched by the agent's `name:` or its
    # file name, and one that matches neither stops `--execute` until the row is corrected.
    known = {str(r["name"] or "").lower() for r in rows} | {
        os.path.splitext(os.path.basename(r["rel"]))[0].lower() for r in rows}
    orphans = sorted(emp for emp in overrides if emp not in known)
    for emp in orphans:
        print(f"  ! override {emp} matches no model-pinned agent here by name or file name — "
              f"correct the row in {source}; --execute will not run until it does")
    if orphans and args.execute:
        args.execute = False
        print("  nothing is written while an override names nobody — this run is the plan only")
    print()

    links_before = _symlinks(rows)
    today = datetime.date.today().isoformat()
    new_record = dict(record)
    counts = {k: 0 for k in ("ok", "drift", "judge", "shipped", "written", "failed", "unresolved")}
    lineup_models = {c["model"] for c in lanes.values() if c["model"]} | {
        c["model"] for c in overrides.values() if c["model"]}

    for r in rows:
        rel = r["rel"]
        also = f"  (also {', '.join(r['aliases'])})" if r["aliases"] else ""
        have = f"{r['model']} · {r['effort'] or '-'}"
        if r["shipped"]:
            counts["shipped"] += 1
            print(f"  = SHIPPED  {rel}  {have} — `update` owns it; never rewritten here{also}")
            continue
        if r["outside"]:
            counts["shipped"] += 1
            print(f"  = OUTSIDE  {rel}  {have} — links to {r['real']}, outside this project; "
                  f"never rewritten here{also}")
            continue
        entry = record.get(rel)
        if rel in judged:
            lane, why = judged[rel]
        elif entry and entry.get("hash") == r["hash"] and entry.get("lane") in LANES:
            lane, why = entry["lane"], entry.get("why", "")
        else:
            counts["judge"] += 1
            was = f"; was {entry.get('lane')} until its description changed" if entry else ""
            off = "" if r["model"] in lineup_models else "  OFF-LINEUP: no lane selects this model"
            print(f"  ? JUDGE    {rel}  {have}{off}{was}{also}")
            print(f"             name: {r['name']}")
            print(f"             description: {r['description'] or '(none — judge from the body)'}")
            if args.check and off:
                counts["drift"] += 1
            continue
        stem = os.path.splitext(os.path.basename(rel))[0]
        key = r["name"] if str(r["name"] or "").lower() in overrides else stem
        model, effort, src = resolve(lane, key, r["tier"], lanes, overrides)
        judged_on = today if rel in judged else (entry or {}).get("judged", today)
        new_record[rel] = {"lane": lane, "why": why, "hash": r["hash"], "judged": judged_on}
        if model is None:
            counts["unresolved"] += 1
            print(f"  ? UNRESOLVED {rel}  {have}  ({lane}): {source} selects no model for this "
                  f"lane — left as it is{also}")
            continue
        # A skill gains no `effort:` line; an agent does, because the lane sets one. With no
        # rung selected the line stays exactly as it is.
        effort_target = r["effort"] if effort is None or (
            r["effort"] is None and r["kind"] != "agent") else effort
        if (r["model"], r["effort"]) == (model, effort_target):
            counts["ok"] += 1
            print(f"  + OK       {rel}  {have}  ({lane}, {src}){also}")
            continue
        counts["drift"] += 1
        change = []
        if r["model"] != model:
            change.append(f"model {r['model']} → {model}")
        if r["effort"] != effort_target:
            change.append(f"effort {r['effort'] or '(none)'} → {effort_target}")
        line = f"{rel}: {', '.join(change)} ({lane}, {why}; {src})" if why else \
            f"{rel}: {', '.join(change)} ({lane}; {src})"
        if not args.execute:
            print(f"  ✗ DRIFT    {line}{also}")
            continue
        err = rewrite(r, model, effort_target if effort_target != r["effort"] else None)
        if err:
            counts["failed"] += 1
            print(f"  ! FAILED   {line} — {err}{also}")
        else:
            counts["written"] += 1
            print(f"  ✓ WROTE    {line}{also}")

    # A SUPERSEDED ID STILL RECORDED IS NOT HEALTHY, whichever lane it sits in. Pending — not
    # yet moved by `heal_superseded` — is drift; one the project chose again by hand after the
    # move stands, and is reported so it is never read as an oversight.
    smap = superseded_map()
    moved_off = read_marker(root)["moved"]
    sup = {"pending": 0, "kept": 0}
    for f in find_superseded(root, smap):
        if f["old"] in moved_off:
            sup["kept"] += 1
            print(f"  = SUPERSEDED-KEPT  {f['where']}: {f['old']}, chosen again after the "
                  f"{moved_off[f['old']].get('on', '?')} move to {f['new']} — stands")
            continue
        sup["pending"] += 1
        counts["drift"] += 1
        print(f"  ✗ SUPERSEDED  {f['where']}: {f['old']} → successor {f['new']} (since "
              f"{f['since']}), not yet moved — the next session start moves it, or "
              f"wf-settings-apply --root {root} --heal --execute")
    print(f"\nINV-SUPERSEDED  {sup['pending']} pending · {sup['kept']} kept by hand")

    if args.execute:
        live = {r["rel"] for r in rows}
        save_record(root, {k: v for k, v in new_record.items() if k in live})
        after = _symlinks(enumerate_files(root))
        lost = [k for k in links_before if k not in after]
        moved = [k for k in links_before if k in after and after[k] != links_before[k]]
        print(f"\nINV-SYMLINK  {len(links_before)} symlinked handbook(s) before · {len(after)} after · "
              f"lost {len(lost)} · retargeted {len(moved)}")
        if lost or moved:
            counts["failed"] += len(lost) + len(moved)

    print(f"\nINV-LANES  {len(rows)} model-pinned file(s) · {counts['ok']} on their lane · "
          f"{counts['drift']} drifted · {counts['written']} rewritten · {counts['judge']} unjudged · "
          f"{counts['shipped']} shipped or outside (report only) · {counts['unresolved']} unresolved · "
          f"{counts['failed']} failed")
    if orphans:
        return 1
    if args.check:
        return 1 if counts["drift"] else 0
    if args.execute:
        if counts["judge"]:
            print("  unjudged files were not written: judge each from its description and re-run "
                  "with --judge PATH LANE WHY", file=sys.stderr)
        return 1 if (counts["failed"] or counts["judge"] or counts["unresolved"]) else 0
    return 0


if __name__ == "__main__":
    sys.exit(main())
