# ── the canary recorder ──────────────────────────────────────────────────────
# THE PRODUCER FOR A FILE THAT HAD ONLY CONSUMERS. `staging.md` § The three outcomes,
# `passes.md` § PASS-STALE-CANARY, `platform.md` § levels and `audit.md` Step 4b all
# READ `.claude/workforce/platform-local.md`; four documents told a run to write it and
# nothing did. Every field below comes from an argument the canary returned or from
# running `claude --version` — nothing here is composed, and a field that cannot be
# obtained is exit 2 rather than a plausible default.
LOCAL_REL = os.path.join(".claude", "workforce", "platform-local.md")

C_ASSERTIONS = {
    "c1": "three-link chain A → B → C spawned from the main conversation; the deepest "
          "link lacks `Agent` and every link above it has it",
    "c2": "an agent listing `Agent` in **both** `tools:` and `disallowedTools:` does "
          "not receive it",
}


def _opt(argv, name):
    """Value of `--name V`. LAST occurrence wins, as argparse does.

    Returns None when absent and "" when the flag is present but unbound (`--c1`
    with nothing after it, or followed by another flag). Those two are different
    errors and the caller reports them differently — a flag written and left empty
    is the shape that produced `--root ""` in the first place.
    """
    val = None
    for i, tok in enumerate(argv):
        if tok == name:
            nxt = argv[i + 1] if i + 1 < len(argv) else None
            val = "" if nxt is None or nxt.startswith("--") else nxt
    return val


def _split_result(raw):
    """`PASS: evidence` → ("PASS", "evidence"). Anything else is unreadable.

    The RESULT is not inferred from the evidence text: `agent-withheld` reads like a
    pass and `C=has-agent` reads like a failure, and neither is this script's call to
    make. The canary returns its verdict; this records it.
    """
    result, _, evidence = (raw or "").partition(":")
    result = result.strip().upper()
    if result not in ("PASS", "FAIL") or not evidence.strip():
        return None, None
    return result, evidence.strip()


def measured_on(supplied):
    """The running harness version. MEASURED, never asserted (Principle 13).

    `--measured-on` exists because `claude` is not on PATH in every context a
    procedure runs in (a CI, a hook, a container), and refusing to record a
    measurement that was genuinely taken would be worse than accepting it. It is not
    a hole: `wf-conform` reconciles this line against the harness version the same
    run recorded in `org-config.md`, so a supplied value that does not match the run
    that took it is a FAILED check on the next verify, not a quiet fiction.
    """
    if supplied:
        return supplied.strip(), "supplied by the caller"
    try:
        out = subprocess.run(["claude", "--version"], stdout=subprocess.PIPE,
                             stderr=subprocess.PIPE, universal_newlines=True, timeout=30)
    except (OSError, subprocess.SubprocessError) as exc:
        return None, f"`claude --version` could not be run ({exc.__class__.__name__})"
    if out.returncode != 0:
        return None, f"`claude --version` exited {out.returncode}"
    m = re.search(r"([0-9]+(?:\.[0-9A-Za-z]+)+)", out.stdout or "")
    if not m:
        return None, f"`claude --version` printed no version: {(out.stdout or '').strip()[:60]!r}"
    return m.group(1), "`claude --version`"


def render_local(version, tier_limit, by, c1, c2, today):
    """The exact bytes. Deterministic in every field except the date."""
    def row(cid, result, evidence):
        # `|` inside a cell ends the cell. The evidence is returned verbatim by a
        # canary and routinely contains one (`A=has-agent | B=has-agent`), so it is
        # escaped rather than trusted to be table-safe.
        return (f"| {cid.upper()} | {C_ASSERTIONS[cid]} | **{result}** | "
                f"`{evidence.replace('|', chr(92) + '|')}` |")

    return f"""# platform-local — measured on THIS host

MEASURED-ON:  Claude Code {version}
MEASURED-AT:  {today}
MEASURED-BY:  {by}
TIER-LIMIT:   {tier_limit}

**This file is the durable record of a canary that passed.** `references/procedures/audit.md`
§ Step 4b reads it and returns `PASS (on record)` — skipping the spawn entirely — when its
`MEASURED-ON` matches the running harness. Without it a canary can pass on every run forever and
the next run still has to re-measure: a fact measured and not written down is a fact this project
does not have.

**It does not replace `references/platform.md`.** That file is the shipped baseline and carries the
maintainer's stamp for the whole fact table. This one is local, is never shipped, and covers only
the assertions the canary actually ran.

**Written by `wf-apply --record-canary --execute`, never by hand.** Every field above came from an
argument the canary returned or from running `claude --version`. A hand-composed record is a claim,
and this project's rule is that platform behaviour is measured and never asserted.

## Assertions run this run

| ID | Assertion | Result | Evidence |
|---|---|---|---|
{row('c1', *c1)}
{row('c2', *c2)}

**C2 is the load-bearing one.** Every IC's tier ceiling rests on `disallowedTools:`, not on depth,
because entry depth is not controllable (`platform.md` fact 2b). C1 gives the org's maximum shape;
C2 says the shape holds when someone invokes a Lead directly.

## What this does NOT cover

The canary measures these two assertions and nothing else. Every other MEASURED fact keeps
`references/platform.md`'s own stamp and its own staleness (`platform.md` § Staleness), so a run
that reads `PASS (on record)` here has the tier ceiling verified and has re-measured nothing else.
"""


def record_canary(root, argv, execute):
    """Write `platform-local.md` from the measured canary inputs. Exit code."""
    missing = [f for f in ("--tier-limit", "--c1", "--c2", "--by")
               if not (_opt(argv, f) or "").strip()]
    if missing:
        print(f"wf-apply --record-canary: missing or empty {', '.join(missing)}. "
              "Every field is a measurement; none has a default, because a default "
              "here is the hand-composed record this producer exists to replace.",
              file=sys.stderr)
        return 2

    tier_raw = _opt(argv, "--tier-limit").strip()
    if not tier_raw.isdigit() or int(tier_raw) < 1:
        print(f"wf-apply --record-canary: --tier-limit {tier_raw!r} is not a positive "
              "integer — C1 measures a depth and a depth is a number", file=sys.stderr)
        return 2

    results = {}
    for flag, cid in (("--c1", "c1"), ("--c2", "c2")):
        result, evidence = _split_result(_opt(argv, flag))
        if result is None:
            print(f"wf-apply --record-canary: {flag} must read `PASS: <evidence>` or "
                  f"`FAIL: <evidence>` — got {_opt(argv, flag)!r}. The verdict is the "
                  "canary's and is never inferred from the evidence text",
                  file=sys.stderr)
            return 2
        results[cid] = (result, evidence)

    # A FAIL IS NOT A RECORD OF A MEASUREMENT THAT PASSED. `staging.md` § The three
    # outcomes: a canary FAIL aborts before any registration, because the host's
    # delegation semantics differ from the design's. Writing the durable
    # "canary that passed" file on that result would make Step 4b return
    # `PASS (on record)` for a host that measurably failed.
    failed = [cid.upper() for cid, (r, _e) in sorted(results.items()) if r == "FAIL"]
    if failed:
        print(f"wf-apply --record-canary: refusing to record — {', '.join(failed)} "
              "FAIL. A canary that did not hold aborts registration (staging.md § The "
              "three outcomes); it is not a record of a measurement that passed.",
              file=sys.stderr)
        return 2

    version, source = measured_on(_opt(argv, "--measured-on"))
    if version is None:
        print(f"wf-apply --record-canary: MEASURED-ON could not be measured — {source}. "
              "Pass --measured-on with the version this run actually observed; this "
              "file never asserts a harness version nobody read.", file=sys.stderr)
        return 2

    body = render_local(version, tier_raw, _opt(argv, "--by").strip(),
                        results["c1"], results["c2"],
                        datetime.date.today().isoformat())
    path = os.path.join(root, LOCAL_REL)

    if not execute:
        print(f"canary-record      would write {LOCAL_REL} · TIER-LIMIT {tier_raw} · "
              f"C1 PASS · C2 PASS · MEASURED-ON from {source}")
        print(f"  ~ {LOCAL_REL}  the exact bytes follow")
        print("  " + "─" * 68)
        for line in body.splitlines():
            print(f"  | {line}")
        print("  " + "─" * 68)
        print("  write with: --execute")
        return 0

    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="utf-8") as fh:
        fh.write(body)
    # RE-READ WHAT LANDED. The whole defect this closes is a write that was believed
    # and never made, so the confirmation quotes the file on disk rather than the
    # string that was passed to write().
    back = read(path)
    stamp = next((l for l in back.splitlines() if l.startswith("MEASURED-ON:")), "")
    print(f"canary-record      wrote {LOCAL_REL} · {len(back.encode('utf-8'))} bytes · "
          f"TIER-LIMIT {tier_raw} · C1 PASS · C2 PASS")
    print(f"  verified on disk: {stamp}")
    return 0


# ── the canary runner ────────────────────────────────────────────────────────
# THE INSTRUMENT PHASE C HAD NOT HAD SINCE 1.31.0. That release removed the five
# shipped canary fixtures on the user's explicit marks, because a REGISTERED agent
# sits in every session's agent menu on the machine. The constraint binds every
# replacement: NOTHING is written into any `agents/` directory. `staging.md` Phase D
# already named what a replacement had to be — "spawnable by type without being
# menu-visible" — and nothing met it, so every audit since returned UNAVAILABLE and
# marked every handbook `Tier ceiling: unverified`.
#
# `claude -p --agents <json>` meets it. The definitions exist for ONE headless
# session, no file is written, and nothing appears in any other session. They exist
# at the child's startup, so fact 3's registration delay does not apply — a first
# audit measures the host on its first attempt. MEASURED 2026-09-15 on Claude Code
# 2.1.268: `disallowedTools` is honored for these definitions, the control proves
# the probe can see `Agent`, and the `model` field is honored
# (`measurements/2026-09-15-agents-flag-canary.md`).
#
# EVERY RUN IS READ FROM THE HARNESS'S OWN EVENT STREAM, not from a relay. The first
# chain trial asked each link to quote its child's reply upward; haiku dropped links'
# own lines in one of three runs and let the spawns go asynchronous in two. The stream
# carries each agent's text under the spawn that produced it, the spawn depth the
# harness assigned, and the model it called — so no agent has to carry another's words.
#
# VERDICTS. PASS and FAIL are observations. UNAVAILABLE is everything else — `claude`
# absent, unauthenticated, too old for a flag, timed out, or an answer that does not
# parse — and it is NEVER FAIL: a canary that fails for a reason that is not true is
# worse than no canary (`staging.md` § Phase C).
CANARY_NS = "wfcanary-"
DELEGATION_TOOLS = ("Agent", "Task")      # `Task` is the name older harnesses used
_OBSERVE = ("Report only what you actually observe; never infer from documentation, from "
            "your own definition, or from what you expect.")
_SYNC = "Wait for its reply; do not run it in the background."


def shipped_tier_limit():
    """TIER-LIMIT from the shipped `platform.md` header, or None. Never restated here."""
    here = os.path.dirname(os.path.abspath(__file__))
    m = re.search(r"^TIER-LIMIT:\s*([0-9]+)",
                  read(os.path.join(here, "..", "references", "platform.md")), re.M)
    return int(m.group(1)) if m else None


def canary_definitions(links, pin):
    """The four sessions of one attempt: name -> (main agent, --agents object).

    `ic` carries `Agent` in BOTH `tools` and `disallowedTools`, so a missing `Agent`
    proves the harness withheld it; `ic-control` is identical without the revocation,
    so it proves the probe can see `Agent` at all. The chain spawns `links` agents from
    the main thread so its deepest link sits at the measured limit, never at a
    two-link false FAIL.
    """
    ic_prompt = ("Report the exact names of every tool available to you, "
                 "comma-separated, and nothing else. " + _OBSERVE)

    def lead(ic):
        return {"description": "canary lead", "tools": ["Agent", "Read"],
                "prompt": (f"You are a canary. Use the Agent tool exactly once to spawn "
                           f"subagent_type {ic} with the prompt: list your tools. {_SYNC} "
                           f"Then output exactly: LEAD_TOOLS=<your own tool names "
                           f"comma-separated> IC_SAID=<its reply verbatim>")}

    def root(child):
        return {"description": "canary root", "tools": ["Agent"],
                "prompt": (f"You are a canary. Use the Agent tool exactly once to spawn "
                           f"subagent_type {child} with the prompt: report. {_SYNC} "
                           f"Then output its reply verbatim and nothing else.")}

    ic = CANARY_NS + "ic"
    treat = {CANARY_NS + "lead": lead(ic),
             ic: {"description": "canary IC", "prompt": ic_prompt,
                  "tools": ["Read", "Agent"], "disallowedTools": ["Agent"]}}
    ctrl = {CANARY_NS + "lead": lead(ic),
            ic: {"description": "canary IC", "prompt": ic_prompt,
                 "tools": ["Read", "Agent"]}}
    chain = {CANARY_NS + "root": root(CANARY_NS + "d1")}
    for k in range(1, links + 1):
        nxt = (f" Then, only if a tool named Agent is among them, use the Agent tool exactly "
               f"once to spawn subagent_type {CANARY_NS}d{k + 1} with the prompt: report. "
               f"{_SYNC}" if k < links else "")
        chain[f"{CANARY_NS}d{k}"] = {
            "description": f"canary chain link {k}", "tools": ["Read", "Agent"],
            "prompt": (f"You are canary link {k}. {_OBSERVE} First write exactly one line: "
                       f"D{k}_TOOLS=<the exact names of every tool available to you, "
                       f"comma-separated>.{nxt} Write nothing else.")}
    model = {CANARY_NS + "root": root(CANARY_NS + "model"),
             CANARY_NS + "model": {
                 "description": "canary model probe", "tools": ["Read"], "model": pin,
                 "prompt": ("Your final reply is exactly one line: MODEL=<the exact model ID "
                            "you are running as>. " + _OBSERVE)}}
    return {"c2-treatment": (CANARY_NS + "lead", treat),
            "c2-control": (CANARY_NS + "lead", ctrl),
            "c1-chain": (CANARY_NS + "root", chain),
            "phase-d": (CANARY_NS + "root", model)}


def parse_stream(raw):
    """One `--output-format stream-json` run -> what the harness recorded.

    Returns {"error", "result", "session_model", "spawns"}; `spawns` maps each
    delegation tool_use id to {"type", "depth", "parent", "texts", "reply", "models",
    "calls"}. Unknown event shapes are skipped, never raised on: a parse that dies on
    the input it exists to read reports nothing.
    """
    st = {"error": None, "result": None, "session_model": None, "spawns": {}}
    events = []
    for line in (raw or "").splitlines():
        line = line.strip()
        if line.startswith("{"):
            try:
                ev = json.loads(line)
            except ValueError:
                continue
            if isinstance(ev, dict):
                events.append(ev)
    if not events:
        st["error"] = "no stream-json event in the output"
        return st

    def spawn(sid):
        return st["spawns"].setdefault(sid, {
            "type": None, "depth": None, "parent": None, "texts": [], "reply": None,
            "models": [], "calls": 0})

    results = []
    for ev in events:
        kind, sub = ev.get("type"), ev.get("subtype")
        if kind == "system" and sub == "init" and st["session_model"] is None:
            st["session_model"] = ev.get("model")
        elif kind == "system" and sub == "task_started" and ev.get("tool_use_id"):
            sp = spawn(ev["tool_use_id"])
            sp["type"] = sp["type"] or ev.get("subagent_type")
            if isinstance(ev.get("spawn_depth"), int):
                sp["depth"] = ev["spawn_depth"]
        elif kind == "system" and sub == "task_notification" and ev.get("tool_use_id"):
            if ev.get("summary") and spawn(ev["tool_use_id"])["reply"] is None:
                spawn(ev["tool_use_id"])["reply"] = ev["summary"]
        elif kind in ("assistant", "user"):
            msg = ev.get("message") if isinstance(ev.get("message"), dict) else {}
            ptu = ev.get("parent_tool_use_id")
            if kind == "assistant" and ptu and msg.get("model"):
                if msg["model"] not in spawn(ptu)["models"]:
                    spawn(ptu)["models"].append(msg["model"])
            blocks = msg.get("content") if isinstance(msg.get("content"), list) else []
            for b in blocks:
                if not isinstance(b, dict):
                    continue
                if kind == "assistant" and b.get("type") == "text" and ptu:
                    spawn(ptu)["texts"].append(b.get("text") or "")
                elif (kind == "assistant" and b.get("type") == "tool_use"
                      and b.get("name") in DELEGATION_TOOLS and b.get("id")):
                    sp = spawn(b["id"])
                    inp = b.get("input") if isinstance(b.get("input"), dict) else {}
                    sp["type"] = sp["type"] or inp.get("subagent_type")
                    sp["parent"] = ptu
                    if ptu:
                        spawn(ptu)["calls"] += 1
                elif kind == "user" and b.get("type") == "tool_result" and b.get("tool_use_id"):
                    first = b.get("content")
                    if isinstance(first, list):
                        first = next((x.get("text") for x in first if isinstance(x, dict)
                                      and x.get("type") == "text"), None)
                    # A backgrounded spawn answers with a launch notice, not its reply.
                    if (isinstance(first, str) and first.strip()
                            and not first.startswith("Async agent launched")):
                        spawn(b["tool_use_id"])["reply"] = first
        elif kind == "result":
            results.append(ev)
    if not results:
        st["error"] = "the run produced no result event"
        return st
    last = results[-1]
    st["result"] = last.get("result") if isinstance(last.get("result"), str) else None
    if last.get("is_error") or last.get("subtype") not in (None, "success"):
        st["error"] = ("claude reported an error: "
                       + str(last.get("result") or last.get("subtype"))[:160])
    return st


def tool_names(text):
    """A self-reported tool list -> the set of names, or None when it is not a list.

    An item counts only if the WHOLE item is one identifier, so prose such as "I do not
    have Agent" contributes nothing rather than a false `Agent`. Every canary agent is
    granted `Read`, so a report that does not name it is not a tool list at all.
    """
    names = set()
    for item in re.split(r"[,\n;]", text or ""):
        item = item.strip().strip("`*'\".[]()").strip()
        if re.match(r"^[A-Za-z_][A-Za-z0-9_-]*$", item):
            names.add(item)
    return names if "Read" in names else None


def _by_type(st, name):
    return [sp for _sid, sp in sorted(st["spawns"].items()) if sp["type"] == name]


def _own_words(sp):
    """An agent's final words: its reply to the spawner, else its last forwarded text."""
    if sp.get("reply"):
        return sp["reply"]
    return sp["texts"][-1] if sp["texts"] else ""


def c2_verdict(treatment, control):
    """(verdict, evidence) from two parsed runs. FAIL only when the probe is proven able
    to see `Agent` (the control reports it) AND the revoked IC still reports it."""
    said = {}
    for label, st in (("treatment", treatment), ("control", control)):
        if st.get("error"):
            return "UNAVAILABLE", f"{label} run: {st['error']}"
        ics = _by_type(st, CANARY_NS + "ic")
        words = _own_words(ics[0]) if ics else ""
        if not tool_names(words):
            relay = re.search(r"IC_SAID=(.*)", st.get("result") or "", re.S)
            words = relay.group(1).strip() if relay else words
        names = tool_names(words)
        if not ics and not names:
            return "UNAVAILABLE", f"{label} run: the lead never spawned the IC"
        if names is None:
            return "UNAVAILABLE", f"{label} IC's reply is not a tool list: {words[:80]!r}"
        said[label] = (bool(names & set(DELEGATION_TOOLS)), ", ".join(sorted(names)))
    if not said["control"][0]:
        return "UNAVAILABLE", (f"control IC reported `{said['control'][1]}` without Agent, so "
                               "the probe cannot see the tool and an absence proves nothing")
    evidence = f"treatment={said['treatment'][1]} | control={said['control'][1]}"
    return ("FAIL", evidence) if said["treatment"][0] else ("PASS", evidence)


def c1_verdict(chain, links):
    """(verdict, evidence, measured limit) from the parsed chain run.

    PASS when every link above the deepest holds `Agent` and the deepest does not;
    FAIL when a SHALLOWER link already lacks it (the host's limit is below the org's
    shape). A deepest link that still holds `Agent` cannot state a limit with this
    many links, and a broken chain states nothing — both UNAVAILABLE, never FAIL.
    """
    if chain.get("error"):
        return "UNAVAILABLE", f"chain run: {chain['error']}", None
    marks = []
    for k in range(1, links + 1):
        found = _by_type(chain, f"{CANARY_NS}d{k}")
        if not found:
            return ("UNAVAILABLE", f"link {k} was never spawned — the chain broke above it"
                    + (f" ({' | '.join(marks)})" if marks else ""), None)
        sp = found[0]
        line = None
        for txt in sp["texts"] + [sp.get("reply") or "", chain.get("result") or ""]:
            m = re.search(rf"D{k}_TOOLS=([^\n]*)", txt or "")
            if m:
                line = m.group(1)
                break
        names = tool_names(line) if line is not None else None
        if names is None and not sp["calls"]:
            return "UNAVAILABLE", f"link {k} reported no parseable tool list", None
        has = bool(sp["calls"]) or bool(names & set(DELEGATION_TOOLS))
        depth = sp["depth"] if sp["depth"] is not None else k
        marks.append(f"D{depth}={'has-agent' if has else 'no-agent'}")
        if not has:
            evidence = " | ".join(marks)
            if k == links:
                return "PASS", evidence, depth
            return "FAIL", evidence + f" — limit {depth}, below the shipped {links}", depth
    return ("UNAVAILABLE", " | ".join(marks) + f" — the deepest link still holds Agent, so "
            f"this host's limit is above the shipped {links} and {links} links cannot state it",
            None)


def _same_model(a, b):
    a, b = (a or "").lower(), (b or "").lower()
    return bool(a and b) and (a in b or b in a)


def phase_d_verdict(run, pin):
    """(outcome, evidence) — ADVISORY. The model is the one the HARNESS called for the
    pinned spawn, read from the stream; the self-report rides along for a human."""
    if run.get("error"):
        return "UNAVAILABLE", f"model run: {run['error']}"
    found = _by_type(run, CANARY_NS + "model")
    if not found or not found[0]["models"]:
        return "UNAVAILABLE", "the harness recorded no model for the pinned spawn"
    seen, session = found[0]["models"], run.get("session_model")
    said = re.search(r"MODEL=(\S+)", " ".join(found[0]["texts"] + [found[0].get("reply") or ""]))
    evidence = (f"pinned {pin} · harness called {', '.join(seen)} · session {session} · "
                f"self-report {said.group(1) if said else '(none)'}")
    if _same_model(pin, session):
        return "INDETERMINATE", evidence
    return ("MATCH" if any(_same_model(pin, m) for m in seen) else "MISMATCH"), evidence


def _kill(proc):
    try:
        if os.name == "posix":
            import signal
            os.killpg(proc.pid, signal.SIGKILL)
        else:
            proc.kill()
    except OSError:
        pass


_RESIDUE_RX = re.compile(r"^(agent-[0-9a-f]+\.(meta\.json|jsonl)|[^/\\]+\.output)$")
_UUID_RX = re.compile(r"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$")


def _session_roots():
    """The two places a headless child keeps per-session state, as glob stems."""
    cfg = os.environ.get("CLAUDE_CONFIG_DIR") or os.path.join(os.path.expanduser("~"), ".claude")
    return [os.path.join(cfg, "projects"), os.path.join(tempfile.gettempdir(), "claude-*")]


def _listing(stem):
    return set(glob.glob(os.path.join(stem, "*")))


def sweep_child_sessions(sids, before):
    """Remove what the canary's OWN children left, and nothing else. Returns (removed, left).

    MEASURED 2026-09-15 on 2.1.268: `--no-session-persistence` stops the transcript but
    the harness still writes `<config>/projects/<cwd>/<session>/subagents/agent-*.meta.json`
    per spawn and an empty `<tmp>/claude-<uid>/<cwd>/<session>/tasks/`. A directory is
    removed only when it is named by a session id THIS attempt generated and holds
    nothing but those shapes; a parent is removed only if it did not exist before the
    attempt and is now empty. Anything else is left and reported.
    """
    removed, left = 0, []
    for sid in sids:
        if not _UUID_RX.match(sid):
            continue
        for stem in _session_roots():
            for d in glob.glob(os.path.join(stem, "*", sid)):
                files = [os.path.join(p, f) for p, _ds, fs in os.walk(d) for f in fs]
                if all(_RESIDUE_RX.match(os.path.basename(f)) for f in files):
                    shutil.rmtree(d, ignore_errors=True)
                    removed += len(files)
                    parent = os.path.dirname(d)
                    if parent not in before and os.path.isdir(parent) and not os.listdir(parent):
                        os.rmdir(parent)
                else:
                    left.append(d)
    return removed, left


def canary_attempt(claude, model, pin, links, timeout, cwd):
    """Launch the four sessions together and read them. This function writes nothing;
    what the harness itself leaves per child session is swept by id afterwards."""
    procs, raw, sids = {}, {}, []
    before = set()
    for stem in _session_roots():
        before |= {p for s in glob.glob(stem) for p in _listing(s)}
    try:
        for name, (main_agent, agents) in canary_definitions(links, pin).items():
            sids.append(str(uuid.uuid4()))
            cmd = [claude, "-p", "--session-id", sids[-1], "--setting-sources", "",
                   "--strict-mcp-config", "--no-session-persistence", "--model", model,
                   "--output-format", "stream-json", "--verbose", "--forward-subagent-text",
                   "--agents", json.dumps(agents), "--agent", main_agent, "run the canary"]
            kw = {"stdin": subprocess.DEVNULL, "stdout": subprocess.PIPE,
                  "stderr": subprocess.PIPE, "cwd": cwd}
            if os.name == "posix":
                kw["start_new_session"] = True    # so a timeout can end the whole tree
            try:
                procs[name] = subprocess.Popen(cmd, **kw)
            except OSError as exc:
                raw[name] = {"error": f"could not start claude ({exc.__class__.__name__})"}
        deadline = time.time() + timeout
        for name, proc in procs.items():
            try:
                out, err = proc.communicate(timeout=max(1, deadline - time.time()))
            except subprocess.TimeoutExpired:
                _kill(proc)
                proc.communicate()
                raw[name] = {"error": f"timed out after {timeout}s"}
                continue
            st = parse_stream(out.decode("utf-8", "replace"))
            err = err.decode("utf-8", "replace").strip()
            if proc.returncode and "unknown option" in err:
                st["error"] = "this harness rejects a flag the canary needs: " + err[:160]
            elif proc.returncode and not st["error"]:
                st["error"] = f"claude exited {proc.returncode}: {err[:160] or '(no stderr)'}"
            raw[name] = st
    finally:
        for proc in procs.values():
            if proc.poll() is None:
                _kill(proc)
        swept = sweep_child_sessions(sids, before)
    c2 = c2_verdict(raw["c2-treatment"], raw["c2-control"])
    c1 = c1_verdict(raw["c1-chain"], links)
    d = phase_d_verdict(raw["phase-d"], pin)
    if "FAIL" in (c1[0], c2[0]):
        verdict = "FAIL"
    elif c1[0] == c2[0] == "PASS":
        verdict = "PASS"
    else:
        verdict = "UNAVAILABLE"
    return {"verdict": verdict, "c1": c1, "c2": c2, "d": d, "swept": swept}


def run_canary(root, argv, execute):
    """Measure C1, C2 and Phase D on this host; on PASS, record through --record-canary.

    Exit 0 PASS · 1 FAIL · 3 UNAVAILABLE · 2 a caller error or a record that refused.
    """
    try:
        attempts = int(_opt(argv, "--attempts") or 2)
        timeout = int(_opt(argv, "--timeout") or 180)
    except ValueError:
        print("wf-apply --run-canary: --attempts and --timeout take integers", file=sys.stderr)
        return 2
    model = _opt(argv, "--canary-model") or "haiku"
    pin = _opt(argv, "--pin-model") or "sonnet"
    links = shipped_tier_limit()
    version, vsrc = measured_on(_opt(argv, "--measured-on"))
    claude = shutil.which("claude")
    lines = []
    for n in range(1, max(1, attempts) + 1):
        if claude is None:
            res = {"verdict": "UNAVAILABLE", "c1": ("UNAVAILABLE", "claude is not on PATH", None),
                   "c2": ("UNAVAILABLE", "claude is not on PATH"),
                   "d": ("UNAVAILABLE", "claude is not on PATH")}
        elif links is None:
            res = {"verdict": "UNAVAILABLE",
                   "c1": ("UNAVAILABLE", "the shipped platform.md states no TIER-LIMIT", None),
                   "c2": ("UNAVAILABLE", "not attempted without a chain length"),
                   "d": ("UNAVAILABLE", "not attempted")}
        else:
            res = canary_attempt(claude, model, pin, links, timeout, tempfile.gettempdir())
        cause = res["c2"] if res["c2"][0] == "UNAVAILABLE" else res["c1"]
        why = f" ({cause[1]})" if res["verdict"] == "UNAVAILABLE" else ""
        lines.append(f"attempt {n} {res['verdict']}{why}")
        print(f"canary-run         attempt {n} · {res['verdict']} · session model {model} · "
              f"timeout {timeout}s")
        print(f"  C1 {res['c1'][0]:<12} {res['c1'][1]}")
        print(f"  C2 {res['c2'][0]:<12} {res['c2'][1]}")
        print(f"  D  {res['d'][0]:<12} {res['d'][1]}  (advisory — never gates)")
        removed, left = res.get("swept") or (0, [])
        print(f"  child-session residue swept: {removed} file(s)"
              + (f" · LEFT (unexpected contents): {', '.join(left)}" if left else ""))
        if res["verdict"] != "UNAVAILABLE":
            break
    print(f"INV-CANARY   {' · '.join(lines)} · instrument wf-apply --run-canary "
          f"(--agents, no agent file written) · Claude Code {version or 'unread'} ({vsrc})")
    if res["verdict"] == "FAIL":
        return 1
    if res["verdict"] != "PASS":
        return 3
    rec = ["--tier-limit", str(res["c1"][2]), "--c1", "PASS: " + res["c1"][1],
           "--c2", "PASS: " + res["c2"][1],
           "--by", _opt(argv, "--by") or "wf-apply --run-canary"]
    if _opt(argv, "--measured-on"):
        rec += ["--measured-on", _opt(argv, "--measured-on")]
    code = record_canary(root, rec, execute)
    return 0 if code == 0 else 2


def main(argv):
    execute = "--execute" in argv
    root = _opt(argv, "--root")
    if root is None:
        root = "."

    # AN EMPTY --root IS A CALLER ERROR, NEVER A SILENT RETARGET TO CWD.
    # `${CLAUDE_PROJECT_DIR}` is UNSET in the Bash tool — measured 2026-08-04 on
    # 2.1.221 — so every shipped `--root "${CLAUDE_PROJECT_DIR}"` block expands to
    # `--root ""`. `os.path.abspath("")` is the CWD, which is a real directory, so an
    # is-it-a-directory guard passes and the tool operates on a tree nobody named.
    # THIS SCRIPT WRITES AND DELETES, so the consequence is worse here than in the
    # readers that already carry this guard: `--root ""` with `--execute` would sweep
    # canaries and rewrite settings under whatever directory the process started in.
    if not (root or "").strip():
        print("wf-apply: --root is empty. ${CLAUDE_PROJECT_DIR} is unset outside a "
              "hook; pass an explicit path.", file=sys.stderr)
        return 2
    if not os.path.isdir(root):
        print(f"wf-apply: not a directory: {root}", file=sys.stderr)
        return 2

    # `--run-canary` IS TESTED FIRST, AND THE ORDER IS THE WHOLE FIX. It already
    # chains into `record_canary` itself, handing over the values it measured
    # seconds earlier in this same process. Tested second, a run that typed BOTH
    # flags — which the usage block above invites, "on PASS, hand the result to
    # --record-canary" — dispatched to the recorder alone, which then demanded
    # --tier-limit/--c1/--c2/--by and exited 2, so the operator retyped numbers the
    # process already held. Requiring those values from a BARE `--record-canary` is
    # right and is unchanged: that form is the hand-entry path, and refusing a
    # hand-composed measurement file is why the recorder exists.
    if "--run-canary" in argv:
        return run_canary(root, argv, execute)
    if "--record-canary" in argv:
        return record_canary(root, argv, execute)

    applied = reported = refused = 0

    for p in PASSES:
        # PASS-STALE-CANARY is the one pass whose verdict depends on the RUNNING
        # harness and not only on the tree, so it takes the same `--measured-on`
        # escape hatch --record-canary does: `claude` is not on PATH in every context
        # a procedure runs in, and a caller who knows the version must be able to say
        # so rather than have the pass fall to a refusal it cannot argue out of.
        rows = (p["detect"](root, _opt(argv, "--measured-on"))
                if p.get("reads_harness") else p["detect"](root))
        if p["verdict"] == "AUTO":
            removable = [r for r in rows if r[1] == "REMOVABLE"]
            refusals = [r for r in rows if r[1] == "REFUSED"]
            edits = p["apply"](root, rows, execute) if removable else []
            applied += len(edits) if execute else 0
            refused += len(refusals)
            verb = "applied" if execute else "would apply"
            print(f"{p['token']:<18} {verb} {len(edits)} · {len(refusals)} refused "
                  f"· precision {p['precision'].split(' —')[0]}")
            for rel, where, cmd in edits:
                print(f"  {'-' if execute else '~'} {rel}  {where}")
                if cmd:
                    print(f"      {cmd}")
            # Each pass formats its OWN refusal. A shared message assumed a hook dict
            # and would raise on any other row shape — a refusal that crashes the run
            # is worse than the finding it declined.
            for row, _v in refusals:
                print("  REFUSED  " + p["refusal"](row))
            if edits and not execute:
                print(f"  reversal: {p['reversal']}")
                print("  apply with: --execute")
        else:
            reported += len(rows)
            print(f"{p['token']:<18} {len(rows)} reported, none applied")
            print(f"  REPORT because precision {p['precision']}")

    print(f"\npasses          {applied} applied · {reported} reported · {refused} refused")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
