#!/usr/bin/env python3
"""wf-org-sync — keep an org chart that already exists current with the files on disk.

User request 2026-10-08: *"when new skills, agents, etc are added into any project,
automatically the existing project org index needs updated"*.

THE GAP IT CLOSES. `org index` (`procedures/org.md` § Mode: index) is a procedure a model
follows by hand, and nothing else writes `.claude/workforce/org-chart.md`. So an agent file
landing in `.claude/agents/` — written this session, copied in, arriving on a `git pull`,
written by another session — leaves the chart stale until somebody runs a full index. `/org`
dispatch rung 8 only notices at dispatch time and then asks the user to run one. This runs on
the events where those files appear and writes the two things that can be derived
mechanically: an ADOPTED roster row for an agent the chart does not list, and a generated
`## Skills` list.

WHAT IT IS NOT. It is not an index. It computes no tier, no department, no manager, no
fan-out, no stamp, and it never rewrites the `Generated:` header — that line must keep saying
when the full index last ran, so a separate `Synced:` line records this pass. Everything a
chart carries that takes judgment stays `org index`'s and `audit`'s.

NEVER MATERIALIZES AN ORG NOBODY BUILT. No `org-chart.md` means exit 0 and no output, the
same rule `bin/sync` follows for a project install that was not there (SKILL.md § Directives,
2026-09-09). That is also the fast path: one `lstat` on every project that has no org.

SURGICAL, NEVER LOAD-AND-DUMP. It appends roster rows, replaces the cells it owns, and
rewrites one marker-delimited block. Every other byte of a model-authored chart survives
verbatim, because a chart is prose with tables in it and reformatting one destroys the
reasoning somebody wrote between them.

IDEMPOTENT BY HAVING NOTHING TO SAY. A run that finds nothing to change writes nothing and
prints nothing — including the `Synced:` line, which is written only alongside a real change.
So the second run is a byte-for-byte no-op rather than a timestamp churning on every tool
call (`bin/idempotence`).

READS THE TABLE'S OWN HEADER, NEVER A FIXED SHAPE. Measured 2026-10-08 against three real
charts on one workstation: `claude-workforce` heads its roster
`| Employee | Tier | Dept | Reports to | Model | Effort | Lane | Owns | Status |`,
`odyssey-alive` heads it `| … | Model / Effort | Owns records | Triggers | Status |`, and
`playwright-mcp` has no `## Roster` heading at all — its roster is a `| Employee | … | Check |`
table under `## Structure`, with no `Status` column. A writer keyed on column position or on a
heading name would have corrupted two of those three. The anchor is the header cell
`Employee`; every column is filled by its own name and anything this tool cannot fill
mechanically is `—` (`org-chart-format.md` § Adopted rows).

A GHOST IS NEVER GUESSED ONTO THE OPERATOR. `org.md` step 4 marks a roster row with no file
`GHOST`. Two of the three charts above carry a row for the human running the session —
`(main session)` in one, `operator` in another's chain — and neither is a file. So a row is
only ghosted when its name is a plain agent slug, is not one of the names a chart uses for
the person, and `.claude/agents/` exists and is not empty. The conservative direction here is
to miss a ghost, never to report the operator as a dead employee.

Exit codes
    0  always, from every path a hook can reach — including a chart it could not parse,
       which is REPORTED in context and left exactly as it was
    2  `--root` was passed empty (a caller error, never a silent retarget to the CWD)

Usage
    wf-org-sync                        # hook: root from the payload's `cwd`
    wf-org-sync --root <project>       # by hand
    wf-org-sync --root <project> --dry-run
"""
import argparse
import datetime
import glob
import json
import os
import re
import sys

CHART_REL = os.path.join(".claude", "workforce", "org-chart.md")
AGENTS_REL = os.path.join(".claude", "agents")
SKILLS_REL = os.path.join(".claude", "skills")

# GENERATED, SO NEVER CENSUSED AS THE PROJECT'S OWN. `workforce` and `org` are the
# dispatcher and its receptionist (SKILL.md § Self-Exclusion Rule) and `operating-principles`
# is written by the `principles` procedure; all three are workforce's own output and listing
# them would have the chart report the tool that wrote it as project capability.
GENERATED_SKILLS = frozenset({"workforce", "org", "operating-principles"})

# NAMES A CHART USES FOR THE PERSON, not for a file. See the ghost paragraph in the header.
NOT_AN_AGENT = frozenset({"operator", "ceo", "main session", "main-session", "direct",
                          "none", "unstaffed"})

SKILLS_HEADING = "## Skills"
SKILLS_START = "<!-- WF-ORG-SKILLS START — auto-generated by wf-org-sync; safe to replace -->"
SKILLS_END = "<!-- WF-ORG-SKILLS END -->"
SKILLS_HEADER = ("| Skill | Description | Placed in the chart |\n"
                 "|---|---|---|")

SYNCED_RX = re.compile(r"^<!--\s*Synced:.*-->\s*$")
GENERATED_RX = re.compile(r"^<!--\s*Generated:.*-->\s*$")

# WHAT PROVES THE FILE IS A CHART, BEFORE ANYTHING IS WRITTEN TO IT. This hook fires
# unasked at `SessionStart` in any tree somebody opens, a clone included, so the path it
# writes is attacker-reachable: `.claude/workforce/org-chart.md` planted as a symlink aims
# the write wherever the link points. Write-through for a symlink is still correct (the
# Atomic-or-Absent gate rule 3), so the refusals are placed on the TARGET instead — it must
# resolve inside the project root, and it must read as a chart.
#
# THE TEST IS THE ONE LINE THE FORMAT SPEC DECLARES MANDATORY AND VERBATIM, not the
# `AUTO-GENERATED by /workforce org index` comment. MEASURED 2026-10-08 against the three
# real charts on this workstation: `claude-workforce` and `odyssey-alive` carry that comment
# and `playwright-mcp` does not — its chart was written by `audit` and says so in prose — so
# pinning the comment would have refused a third of the charts it was built for. All three
# carry an `# Org Chart` heading and the chain-of-command honesty line
# (`org-chart-format.md` § Chart layout: "mandatory and verbatim").
CHART_H1_RX = re.compile(r"^#\s+Org Chart\b", re.M)
CHART_HONESTY = "Chain of command is enforced by prose plus permissions.deny"
AGENT_SLUG_RX = re.compile(r"^[a-z0-9][a-z0-9._-]*$")
# WHAT MAY BE WRITTEN INTO A CELL AS ITSELF. Letters, digits, `.`, `_`, `-`, bounded — so a
# `|` cannot split the row, a newline cannot end it, and `-->` cannot close the `Synced:`
# comment the name is also named in. Wider than AGENT_SLUG_RX (which gates GHOSTing and
# stays lowercase-only, the conservative direction for a destructive-looking mark).
NAME_RX = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$")
# A note is a sentence in a comment and in the hook's context line, so both are bounded.
NOTE_LABEL = 60
MAX_NOTES = 10
# Frontmatter is read with a line regex rather than a YAML parser: a handbook's `description:`
# is a long quoted sentence and `tools:` is a list, and the three scalars wanted here are
# always one line. `wf-conform` reads them the same way.
FM_RX = re.compile(r"^(name|model|effort|description)\s*:\s*(.+?)\s*$")

DASH = "—"
ADOPTED_RELEASE = "not probed (pre-existing)"
UNCLASSIFIED = "not yet classified"


def _text(path, limit=None):
    """A file's text, or None when it cannot be read as UTF-8. `limit` caps the read for a
    frontmatter scan, so a long handbook costs a few hundred bytes on a hook."""
    try:
        with open(path, encoding="utf-8", newline="") as fh:
            return fh.read(limit) if limit else fh.read()
    except (OSError, UnicodeDecodeError):
        return None


def frontmatter(path):
    """`{name, model, effort, description}` from a `---` block, values only for keys present."""
    body = _text(path, 4096)
    out = {}
    if not body:
        return out
    lines = body.replace("\r\n", "\n").split("\n")
    if not lines or lines[0].strip() != "---":
        return out
    for line in lines[1:]:
        if line.strip() == "---":
            break
        m = FM_RX.match(line)
        if m:
            # A MATCHED PAIR ONLY. `.strip('"').strip("'")` ate the apostrophe off a value
            # ending in one — `the operator's` became `the operator`s`.
            v = m.group(2).strip()
            if len(v) >= 2 and v[0] == v[-1] and v[0] in "\"'":
                v = v[1:-1]
            out[m.group(1)] = v
    return out


def project_agents(root):
    """`({name: relative path}, [unchartable])` for every agent file under `.claude/agents`.

    Recursive, matching `org.md` step 1's glob — a project may nest handbooks in
    subdirectories and an agent charted from one is still an agent on disk.

    `os.walk(followlinks=False)` RATHER THAN `glob('**/*.md', recursive=True)`, and the
    difference is a hang. MEASURED 2026-10-08: `.claude/agents/d/up -> ..` beside
    `d/self -> .` made that glob run past 20 seconds without finishing, because `**`
    descends into a symlinked directory. This hook fires at every session start and on
    every `Bash` call, so a cloned repo carrying that two-link layout stalls every session
    in it. A symlinked .md FILE is still read — that is how `odyssey-alive` registers an
    agent that lives inside a skill — only a symlinked DIRECTORY is not descended into.

    A NAME THAT CANNOT BE WRITTEN IN A TABLE CELL IS REPORTED, NEVER CHARTED. Escaping it
    instead would be the worse bug: the escaped cell no longer matches the name read back
    off disk, so the agent is adopted again on every pass and the roster grows forever.
    """
    out, unchartable = {}, []
    base = os.path.join(root, AGENTS_REL)
    for dirpath, dirnames, filenames in os.walk(base, followlinks=False):
        dirnames.sort()
        for fn in sorted(filenames):
            if not fn.endswith(".md"):
                continue
            path = os.path.join(dirpath, fn)
            if not os.path.isfile(path):
                continue
            name = (frontmatter(path).get("name")
                    or os.path.splitext(fn)[0]).strip()
            if not NAME_RX.match(name):
                unchartable.append(os.path.relpath(path, root))
                continue
            out.setdefault(name, os.path.relpath(path, root))
    return out, sorted(set(unchartable))


def safe_label(name):
    """A name on its way into a note — and a note goes into the `Synced:` HTML comment and
    into the hook's own `additionalContext`. Same defang as a cell, because a name carrying
    `-->` closes the comment it is written into, plus a tighter bound: a note is a sentence,
    not a cell."""
    out = escape_cell(name)
    return out[:NOTE_LABEL - 3] + "..." if len(out) > NOTE_LABEL else out


def summarize(notes):
    """The notes as one clause, bounded. An org gaining fifty agents at once would otherwise
    write a fifty-clause HTML comment into the chart and the same sentence into the context
    of every tool call that followed."""
    if len(notes) <= MAX_NOTES:
        return "; ".join(notes)
    return "; ".join(notes[:MAX_NOTES]) + "; and %d more" % (len(notes) - MAX_NOTES)


def project_skills(root):
    """`[(name, description)]` for each project skill, generated ones excluded."""
    out = []
    for path in sorted(glob.glob(os.path.join(root, SKILLS_REL, "*", "SKILL.md"))):
        name = os.path.basename(os.path.dirname(path))
        if name in GENERATED_SKILLS:
            continue
        out.append((name, frontmatter(path).get("description") or ""))
    return out


def _norm_header(cell):
    return cell.strip().strip("*`").strip().lower()


def _norm_name(cell):
    """A roster cell reduced to the name it states: a link's text, backticks and emphasis
    at the ends, and the `@agent-` prefix. `(main session)` keeps its parentheses, which is
    what disqualifies it from the slug test.

    EMPHASIS IS STRIPPED AT THE ENDS ONLY. A global `_` strip would rewrite `my_agent` to
    `myagent`, which matches no file — a false adoption AND a false ghost from one line.
    """
    v = re.sub(r"\[([^\]]*)\]\([^)]*\)", r"\1", cell.strip())
    v = v.replace("`", "").strip().strip("*_").strip()
    if v.startswith("@agent-"):
        v = v[len("@agent-"):]
    return v.strip()


def split_row(line):
    """A markdown table row's cells, outer pipes dropped. An escaped `\\|` is not a
    separator — a `description:` that carries a pipe is written that way."""
    body = line.strip()
    if body.startswith("|"):
        body = body[1:]
    if body.endswith("|"):
        body = body[:-1]
    return re.split(r"(?<!\\)\|", body)


def is_separator(line):
    cells = split_row(line)
    return bool(cells) and all(re.match(r"^\s*:?-{2,}:?\s*$", c) for c in cells)


def find_roster(lines):
    """`(header_cells, header_index, last_data_index)` for the roster table, or None.

    THE ANCHOR IS THE HEADER CELL `Employee`, not a heading: the three charts measured for
    this tool put that table under three different headings, one of which is not `## Roster`.
    The first such table wins — a chart with two is one `org index` has to resolve, and
    picking between them here would be the guess `org-chart-format.md` forbids.
    """
    for i, line in enumerate(lines):
        if not line.strip().startswith("|"):
            continue
        cells = split_row(line)
        if _norm_header(cells[0]) != "employee":
            continue
        j = i + 1
        if j >= len(lines) or not lines[j].strip().startswith("|"):
            continue
        last = j if is_separator(lines[j]) else i
        k = last + 1
        while k < len(lines) and lines[k].strip().startswith("|"):
            last = k
            k += 1
        return [_norm_header(c) for c in cells], i, last
    return None


def is_org_chart(text):
    """Does this file read as a workforce org chart? See CHART_H1_RX above."""
    return bool(CHART_H1_RX.search(text)) and CHART_HONESTY in text


def chart_target(root, chart):
    """`(realpath, refusal)` for the file the chart path names.

    A target outside the project root is refused outright, whatever link led there."""
    real_root = os.path.realpath(root)
    real = os.path.realpath(chart)
    try:
        inside = os.path.commonpath([real_root, real]) == real_root
    except ValueError:
        inside = False
    if not inside:
        return None, ("`%s` resolves to `%s`, outside the project root — a link pointing out "
                      "of the tree aims this write at a file nobody named, so nothing was "
                      "written" % (CHART_REL, real))
    return real, None


def cell_value(header, name, fm):
    """The one cell an adopted row may carry for a column of this name.

    `org.md` step 1a and `org-chart-format.md` § Adopted rows: the file declares no tier, no
    department and no manager, so those are `—` and index never infers one. Model and effort
    come from frontmatter; absent keys are `—`. Anything this tool cannot fill mechanically
    is `—` rather than a guess.
    """
    model = fm.get("model") or DASH
    effort = fm.get("effort") or DASH
    if header == "employee":
        return name
    if header == "status":
        return "adopted"
    if header in ("release record", "release"):
        return ADOPTED_RELEASE
    if header in ("model / effort", "model/effort"):
        return "%s / %s" % (model, effort)
    if header == "model":
        return model
    if header == "effort":
        return effort
    return DASH


def escape_cell(text):
    """One line, bounded, and unable to break out of the cell or the block it sits in.

    A skill's `description:` and a skill's directory name are not this project's text — they
    come from whoever wrote the tree, and on a clone that is not the person running the
    session. Four neutralisations, each for a thing that text could otherwise do:

    * `|` → `\\|` and whitespace collapsed, or the cell silently splits into two.
    * `<!--` and `-->` defanged, because a description carrying `-->` CLOSES the generated
      block's own HTML comment, and one carrying the END marker's bytes ends the block
      early — after which the next pass reads the markers as unbalanced, reports them as
      tampering, and the sync stops working. A written-in terminator is the markdown
      equivalent of an unescaped quote.
    * a backtick run reduced to one, so a cell cannot open a code fence.
    * 200 characters, so one description cannot take over the table.

    It does NOT try to make the text safe to READ. The chart is read by `/org` and by
    employees, so a hostile description is prose that reaches a model — but that is already
    true of every `SKILL.md` on disk, whose descriptions the harness lists into every
    session unasked. Listing one in the chart widens no trust boundary, and claiming to
    sanitise prose against a reader would be the overclaim `enforcement.md` refuses.
    """
    out = " ".join((text or "").split())
    out = out.replace("|", "\\|").replace("<!--", "<!-").replace("-->", "- >")
    out = re.sub(r"`+", "`", out)
    return out[:197] + "..." if len(out) > 200 else out


def section_body(text, heading):
    """The lines under `## heading` up to the next `## `, or "" when it is absent."""
    rx = re.compile(r"^##\s+" + re.escape(heading) + r"\s*$", re.M)
    m = rx.search(text)
    if not m:
        return ""
    rest = text[m.end():]
    nxt = re.search(r"^##\s", rest, re.M)
    return rest[:nxt.start()] if nxt else rest


def placement(chart_without_block, skill):
    """Where the chart already places this skill: `Orchestrators`, `Mechanicals`, both, or
    `not yet classified`. The generated block is removed before this runs, or every skill
    would be found in the list this tool itself wrote."""
    # BACKTICKED OR SLASH-PREFIXED, NEVER THE BARE WORD. A chart's `Covers` cells are prose,
    # and a skill called `voice` or `check` would match an English sentence in one — a cell
    # that reads "already placed" about a skill the chart never mentions. Both spellings a
    # chart uses for a skill carry a delimiter: `` `name` `` or `/name`.
    rxs = [re.compile(r"`/?%s`" % re.escape(skill)),
           re.compile(r"(?<![\w/.-])/%s(?![\w-])" % re.escape(skill))]
    found = []
    for heading in ("Orchestrators", "Mechanicals"):
        body = section_body(chart_without_block, heading)
        if any(rx.search(body) for rx in rxs):
            found.append(heading)
    return " + ".join(found) if found else UNCLASSIFIED


def skills_table(skills, chart_without_block):
    rows = [SKILLS_HEADER]
    for name, desc in skills:
        # THE NAME IS A DIRECTORY NAME, so it is no more trusted than the description —
        # a directory called ``x`|`` would otherwise close its own backticks and its cell.
        rows.append("| `%s` | %s | %s |"
                    % (escape_cell(name), escape_cell(desc) or DASH,
                       placement(chart_without_block, name)))
    if len(rows) == 1:
        rows.append("| %s | no project skills on disk | %s |" % (DASH, DASH))
    return "\n".join(rows)


def atomic_write(real, text):
    """Replace `real`'s content, temp-file-and-rename in its own directory.

    `real` is the caller's realpath, so a chart reached through a symlink is written THROUGH
    the link and the link survives (Atomic-or-Absent gate rule 3). Written in place instead
    when the file has other hard links or another owner, because a rename would split the
    links or hand the file to this user — the same trade `wf-settings-apply._atomic_write`
    makes, for the same reasons.

    THE RESOLVED PATH IS WHAT IS WRITTEN, which is also what closes the race on the check
    that cleared it: `chart_target` resolved the link once, and re-pointing that link
    afterwards cannot redirect this write, because the link is never traversed again.
    """
    import stat
    import tempfile
    st = os.stat(real) if os.path.exists(real) else None
    if st is not None and (st.st_nlink > 1
                           or (hasattr(os, "getuid") and st.st_uid != os.getuid())):
        with open(real, "r+b") as fh:
            fh.write(text.encode("utf-8"))
            fh.truncate()
        return
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(real), prefix=".wf-org-sync.")
    try:
        with os.fdopen(fd, "wb") as fh:
            fh.write(text.encode("utf-8"))
        os.chmod(tmp, stat.S_IMODE(st.st_mode) if st else 0o644)
        os.replace(tmp, real)
    except BaseException:
        if os.path.exists(tmp):
            os.remove(tmp)
        raise


def open_chart(root):
    """`(target, text, refusal)` — the file to write, its bytes, or why neither.

    THE TWO REFUSALS LIVE HERE, in front of every read and every write, because this runs
    unasked (see CHART_H1_RX): the target must resolve inside the project, and it must read
    as a chart. Absent is not a refusal — it is the fast path, and it says nothing at all.
    """
    chart = os.path.join(root, CHART_REL)
    if not os.path.lexists(chart):
        return None, None, None                  # never materialize an org nobody built
    target, refusal = chart_target(root, chart)
    if refusal:
        return None, None, refusal
    text = _text(target)
    if text is None:
        return None, None, ("`%s` could not be read as UTF-8 — left exactly as it is"
                            % CHART_REL)
    if not is_org_chart(text):
        return None, None, ("`%s` does not read as an org chart (no `# Org Chart` heading, or "
                            "the mandatory chain-of-command line is missing), so it is not "
                            "this tool's file to write and was left alone" % CHART_REL)
    return target, text, None


def apply_skills(lines, text, nl, root, notes, problems):
    """Rewrite the one marker-delimited `## Skills` block, in place in `lines`."""
    starts = [i for i, l in enumerate(lines) if l.strip() == SKILLS_START]
    ends = [i for i, l in enumerate(lines) if l.strip() == SKILLS_END]
    if len(starts) != len(ends) or len(starts) > 1:
        problems.append("the `%s` markers are unbalanced (%d start, %d end) — reported and "
                        "skipped, never auto-repaired" % (SKILLS_HEADING, len(starts), len(ends)))
        block = None
    elif starts and starts[0] > ends[0]:
        problems.append("the `%s` end marker precedes its start — reported and skipped"
                        % SKILLS_HEADING)
        block = None
    else:
        block = (starts[0], ends[0]) if starts else None

    heading_at = next((i for i, l in enumerate(lines)
                       if l.strip() == SKILLS_HEADING), None)
    if block is None and heading_at is not None and not starts and not ends:
        problems.append("`%s` exists without the generated markers, so it is hand-authored "
                        "and is left alone" % SKILLS_HEADING)
        skills_ok = False
    elif block is None and (starts or ends):
        skills_ok = False
    else:
        skills_ok = True

    # The placement lookup must not see the block this tool wrote last run.
    without = text
    if block:
        without = nl.join(lines[:block[0]] + lines[block[1] + 1:])
    # LINES, NOT A JOINED STRING. Comparing a `\n`-joined rendering against a CRLF chart's
    # own bytes differs on every run, so the write would never settle and the second pass
    # would not be a no-op — on Windows only, where nothing here runs.
    wanted = skills_table(project_skills(root), without).split("\n")

    if skills_ok:
        if block:
            if lines[block[0] + 1:block[1]] != wanted:
                lines[block[0] + 1:block[1]] = wanted
                notes.append("refreshed the generated `%s` list" % SKILLS_HEADING)
        else:
            if lines and lines[-1].strip() != "":
                lines.append("")
            lines += [SKILLS_HEADING, SKILLS_START] + wanted + [SKILLS_END, ""]
            notes.append("added the generated `%s` list" % SKILLS_HEADING)


def apply_roster(lines, root, notes, problems):
    """Adopt what is on disk and not charted; ghost what is charted and gone. In place."""
    agents, unchartable = project_agents(root)
    for rel in unchartable:
        problems.append("`%s` declares a name that cannot be written into a table cell as "
                        "itself, so it is reported rather than charted — escaping it would "
                        "stop the row matching the file and adopt it again every pass"
                        % safe_label(rel))
    roster = find_roster(lines)
    if roster is None:
        problems.append("no roster table found (no table whose first header cell is "
                        "`Employee`), so no agent could be adopted or ghosted — "
                        "`/workforce org index` owns the chart's shape")
        return
    headers, head_i, last_i = roster
    name_col = headers.index("employee")
    charted = {}
    for i in range(head_i + 1, last_i + 1):
        cells = split_row(lines[i])
        if is_separator(lines[i]) or len(cells) <= name_col:
            continue
        charted[_norm_name(cells[name_col])] = i

    # EVERY INSERT GOES AFTER THE LAST CHARTED ROW, so the indexes in `charted` — which the
    # ghost pass below still needs — stay valid.
    for name in sorted(set(agents) - set(charted)):
        fm = frontmatter(os.path.join(root, agents[name]))
        row = "| " + " | ".join(cell_value(h, name, fm) for h in headers) + " |"
        last_i += 1
        lines.insert(last_i, row)
        notes.append("adopted `%s`" % safe_label(name))
        if "status" not in headers:
            problems.append("`%s` was adopted with no `Status` cell: this roster table "
                            "has no Status column" % safe_label(name))

    if "status" not in headers:
        return
    status_col = headers.index("status")
    # AN EMPTY OR ABSENT `.claude/agents` PROVES NOTHING. A project whose handbooks moved,
    # or a checkout mid-clone, would otherwise ghost the entire roster in one pass.
    ghostable = os.path.isdir(os.path.join(root, AGENTS_REL)) and bool(agents)
    for name, i in sorted(charted.items(), key=lambda kv: kv[1]):
        if name in agents or not ghostable:
            continue
        if not AGENT_SLUG_RX.match(name) or name in NOT_AN_AGENT:
            continue
        cells = split_row(lines[i])
        if len(cells) <= status_col:
            continue
        was = cells[status_col].strip()
        if was.startswith("GHOST"):
            continue
        cells[status_col] = (" GHOST (was %s) " % was) if was else " GHOST "
        lines[i] = "|" + "|".join(cells) + "|"
        notes.append("marked `%s` GHOST — its file is gone" % safe_label(name))


def sync(root, today):
    """`(new_text_or_None, notes, problems, target)` for this project's chart.

    `new_text_or_None` is None when there is nothing to change — which is what makes a second
    run a no-op. `notes` are what changed, in plain words; `problems` are what could not be
    read or written and are reported without touching the file. `target` is the realpath the
    write lands on, already proven to sit inside the project.
    """
    target, text, refusal = open_chart(root)
    if target is None:
        return None, [], ([refusal] if refusal else []), None

    nl = "\r\n" if "\r\n" in text else "\n"
    lines = text.split(nl)
    notes, problems = [], []
    apply_skills(lines, text, nl, root, notes, problems)
    apply_roster(lines, root, notes, problems)

    if not notes:
        return None, notes, problems, target

    # ── the Synced marker, written ONLY beside a real change, so it cannot churn ──
    stamp = "<!-- Synced: %s by wf-org-sync | %s -->" % (today, summarize(notes))
    at = next((i for i, l in enumerate(lines) if SYNCED_RX.match(l.strip())), None)
    if at is not None:
        lines[at] = stamp
    else:
        after = next((i for i, l in enumerate(lines) if GENERATED_RX.match(l.strip())), 0)
        lines.insert(after + 1, stamp)

    return nl.join(lines), notes, problems, target


def emit(event, notes, problems, would=False):
    """The one output channel. Silent when nothing changed and nothing failed."""
    if not notes and not problems:
        return
    parts = []
    if notes:
        parts.append("Org chart %s: %s."
                     % ("would be updated" if would else "updated", summarize(notes)))
    for p in problems:
        parts.append("Org chart: %s." % p)
    print(json.dumps({"hookSpecificOutput": {
        "hookEventName": event or "PostToolUse",
        "additionalContext": " ".join(parts),
    }}))


def main(argv=None):
    ap = argparse.ArgumentParser(add_help=True, description=__doc__.splitlines()[0])
    ap.add_argument("--root", default=None,
                    help="the project to sync; a hook takes it from the payload instead")
    ap.add_argument("--dry-run", action="store_true",
                    help="report what would change and write nothing")
    args = ap.parse_args(argv)

    payload, event = {}, ""
    if args.root is None and not sys.stdin.isatty():
        raw = sys.stdin.read()
        try:
            payload = json.loads(raw) if raw.strip() else {}
        except ValueError:
            payload = {}
        if not isinstance(payload, dict):
            payload = {}
        event = payload.get("hook_event_name") or ""

    if args.root is not None:
        # AN EMPTY --root IS A CALLER ERROR, NEVER A SILENT RETARGET TO CWD.
        # `${CLAUDE_PROJECT_DIR}` is UNSET in the Bash tool, so every shipped
        # `--root "${CLAUDE_PROJECT_DIR}"` block expands to `--root ""`, and
        # `os.path.abspath("")` is the CWD — a real directory, so an is-it-a-directory
        # guard passes and the tool writes into a tree nobody named.
        if not args.root.strip():
            print("wf-org-sync: --root is empty. ${CLAUDE_PROJECT_DIR} is unset outside a "
                  "hook; pass an explicit path.", file=sys.stderr)
            return 2
        root = args.root
    else:
        root = os.environ.get("CLAUDE_PROJECT_DIR") or payload.get("cwd") or ""
        if not str(root).strip():
            return 0
    root = os.path.abspath(root)
    if not os.path.isdir(root):
        return 0

    try:
        new, notes, problems, target = sync(root, datetime.date.today().isoformat())
    except OSError as exc:
        # A HOOK NEVER TAKES A TURN DOWN. Whatever could not be read is said out loud and
        # the chart is left exactly as it was.
        emit(event, [], ["could not be synced (%s: %s)" % (exc.__class__.__name__, exc)])
        return 0

    if new is None or args.dry_run:
        emit(event, notes, problems, would=args.dry_run)
        return 0
    try:
        atomic_write(target, new)
    except OSError as exc:
        emit(event, [], ["NOT updated (%s: %s); nothing was written"
                         % (exc.__class__.__name__, exc)])
        return 0
    emit(event, notes, problems)
    return 0


if __name__ == "__main__":
    sys.exit(main())
