#!/usr/bin/env python3
"""wf-ledger — the one door into the project record family of the personnel store.

WHY THIS EXISTS. The store was designed and never switched on. The project family —
`INC` (something went wrong), `DEC` (a decision was reached), `PAT` (a recurring way
this project does a thing), `FLW` (how a thing moves end to end) — has been declared
in `procedures/ledger.md` since that file was written, and nothing wrote one, nothing
read one, and the schema in `personnel-templates.md` did not list the four types. The
origin is a real project where decisions reached in conversation lived nowhere: agents
hallucinated against the gap, and the repair was hand-built after the fact.

ONE STORE, TAGGED RECORDS, FILTERED READS — the user's own resolution, quoted in
`plan/project-knowledge-2026-09-08.md`. The split different agents need is real, and it
happens AT THE DOOR rather than on disk: one flat directory, every record carrying a
`Subjects:` tag line, and `consult --subjects` handing back only the slice that was
asked for. Separate stores would have to be chosen between at write time, by the thing
least able to choose — the capture hook, mid-turn.

THE LOAD-BEARING RULE, and it is one line: **a `proposed` record is never served.**
Only `accepted` records leave this gateway. That is what lets drafting be automatic
without manufacturing a history nobody agreed to — the draft exists so nothing is lost
while the user is busy, and it carries no authority until the user says so. Everything
else here is bookkeeping around that sentence.

WHAT IT DOES.

    new <TYPE> --slug <s> --subjects a,b     draft or record one, `proposed` by default
    pending                                  every `proposed` record, newest first
    accept <id>                              proposed -> accepted (the user's act)
    supersede <id> --by <id>                 accepted -> superseded, and link the heir
    consult --subjects a,b                   ACCEPTED only, index-scan then read matches
    index                                    rebuild the index FROM THE FILESYSTEM; a
                                             hand-kept index is never rebuilt, only
                                             given a block of what it does not link
    check                                    index count == file count; fields are legal

DISPLAY IS THE DEFAULT, `--execute` WRITES. Same contract as every other writing script
in this distribution: a run that would change the store prints exactly what it would
write and changes nothing until it is told to.

`index` NEVER READS ITS OWN PRIOR INDEX. `ledger.md` § Migrating them in states why:
predecessor indexes drift — a real one under-reported its own contents by three
records — and a rebuild that trusts the old index drops them silently while reporting
success. This one enumerates the directory every time.

`consult` IS THE IMPORTANT MODE. It reads the index, selects on tags and status, and
then opens ONLY the records that matched. A ledger that must be read whole to be useful
stops being consulted at exactly the point it becomes valuable. Where the index is
absent it falls back to a HEADER scan — the five field lines of each record, never the
bodies — and says so, because silently reading everything would be the failure this
mode exists to prevent. The index SELECTS; the record DECIDES: `Status` is re-read
from every candidate file, because an index row is a claim that goes stale the moment
`accept` runs without a rebuild, and a stale claim must never be what serves a draft.

WHAT IT DOES NOT DO.

  * It does not touch the ORG family (`EMP`, `PERF`, `DEF`, `AMD`, `RFI`, `ORG`). Those
    live in the same directory and are counted by `index` and `check`, and they are
    written by the procedures that own them. `new` refuses any type outside the four.
  * It does not judge a record's content, prune, or rewrite a body. Records are
    institutional memory; the only field this tool ever changes after writing is
    `Status:`, and `Supersedes:` on the heir.
  * It does not decide what is worth recording. That is the capture hook's guess and
    the user's confirmation, in that order.
  * It never serves `(unclassified)` records to a subject query. An untagged record is
    REPORTED — a count, never its contents — because quietly showing it to everyone is
    the "one big clunky source" the tagging exists to refuse.

EXIT CODES: 0 did the thing (including "nothing matched", which is an answer);
2 caller error, or a `check` finding. Never any other code — a caller distinguishing
"you asked wrong" from "the store is wrong" reads the message, not the number.
"""

import argparse
import datetime
import json
import os
import re
import sys

TYPES = ("INC", "DEC", "PAT", "FLW")
# THE ONE STATUS SET for the project family. `personnel-templates.md` states it on every
# template's `**Status:**` line and in § Invariants, and `bin/check` holds those equal to
# this tuple. `deprecated` means "no longer applicable, and nothing replaces it", which
# `superseded` cannot say because it names an heir. It was missing, and the awareness-
# ledger `DEC` template this family descends from has it: a customer's Records Owner
# retired two misfiled captures as `deprecated` under that template, and `check` called
# both ILLEGAL (DEF-Q-20, 2026-09-16). Like `superseded`, it is never served by `consult`.
STATUSES = ("proposed", "accepted", "superseded", "deprecated")
UNCLASSIFIED = "(unclassified)"
STORE = os.path.join(".claude", "workforce", "personnel")
INDEX = "index.md"

# The five field lines every project record carries, in order. Bold field lines under
# an `# ID` heading, exactly like `DEF` and `AMD` — no YAML, because the store is read
# by humans and by grep at least as often as by this script.
FIELDS = ("Status", "Subjects", "Anchors", "Recorded", "Supersedes")

# Body headings per type. The contract table in plan/project-knowledge-2026-09-08.md
# names what each type holds; these are those asks as headings.
BODIES = {
    "DEC": ("What Was Decided", "Why", "What It Rules Out", "Evidence"),
    "INC": ("What Happened", "Cause", "What Changed", "Evidence"),
    "PAT": ("The Pattern", "When It Applies", "When It Does Not", "Evidence"),
    "FLW": ("The Steps", "The Seams", "Who Owns Each", "Evidence"),
}

_SLUG_RE = re.compile(r"^[a-z0-9][a-z0-9-]*$")
_ID_RE = re.compile(r"^(INC|DEC|PAT|FLW|EMP|PERF|DEF|AMD|RFI|ORG)-([A-Za-z0-9._-]+)$")
# Field lines are LINE-ANCHORED. `**Status:**` inside a fenced example in a body is
# documentation about the format, not the record's own field, and a substring test
# would read it as one.
_FIELD_RE = {f: re.compile(r"^\*\*%s:\*\*[ \t]*(.*)$" % f, re.M) for f in FIELDS}
_INDEX_ROW_RE = re.compile(
    r"^- `(?P<id>[A-Za-z]+-[A-Za-z0-9._-]+)` — (?P<type>[A-Z]+)"
    r"(?: — (?P<status>[a-z]+) — subjects: (?P<subjects>.*?))?"
    r"(?: — anchors: (?P<anchors>.*?))?"
    # THE ORG FAMILY'S SUMMARY TAIL. `index` carries those rows through verbatim
    # (`carried_org_rows`), and a row it preserves must still PARSE — without this
    # group a `DEF` row reading "— the router dropped the tag" stops matching and
    # `check` reports it NOT INDEXED, which is the carry-forward defeating itself.
    # Captured and unread: the text belongs to the procedure that wrote it.
    r"(?P<summary> — .*?)?$", re.M)
# Any row at all, whatever follows the ID. Deliberately looser than the row grammar
# above, because carrying a row forward must not depend on being able to parse it.
_ANY_ROW_RE = re.compile(r"^- `(?P<id>[A-Za-z]+-[A-Za-z0-9._-]+)` — .*$", re.M)
# A LINK TO A RECORD FILE — the shape a Records Owner keeps by hand, `- [ID](ID.md) — …`
# under section headings. The TARGET names the record, never the link text, and a
# relative prefix (`./`, `defects/`) is allowed. A record named only in narrative prose is
# NOT indexed by this: a sentence that mentions an ID is not a row a reader can find it by.
_LINK_RE = re.compile(r"\]\(<?(?:\./)?(?:[\w.-]+/)*(?P<id>[A-Za-z]+-[A-Za-z0-9._-]+)\.md>?"
                      r"(?:#[^)\s]*)?\)")
# The marker pair `index --execute` writes into an index it did not generate.
GENERATED_MARK = "Regenerated from the filesystem by `wf-ledger index`"
UNINDEXED_BLOCK = ("<!-- WF-LEDGER-UNINDEXED START", "<!-- WF-LEDGER-UNINDEXED END -->")


def _die(msg):
    print("wf-ledger: " + msg, file=sys.stderr)
    return 2


def store_dir(root):
    return os.path.join(root, STORE)


def record_path(root, rec_id):
    return os.path.join(store_dir(root), rec_id + ".md")


def record_ids(root):
    """Every record on disk, enumerated FROM THE FILESYSTEM. Never from the index."""
    d = store_dir(root)
    out = []
    try:
        names = os.listdir(d)
    except OSError:
        return out
    for name in sorted(names):
        if not name.endswith(".md"):
            continue
        stem = name[:-3]
        if stem == INDEX[:-3]:
            continue
        if _ID_RE.match(stem):
            out.append(stem)
    return out


def legacy_records(root):
    """[(rec_id, path)] for every record filed in a SUBFOLDER of the store.

    `personnel-templates.md` § Schema puts every record flat at `personnel/<TYPE>-<subject>.md`.
    An older layout filed them per type (`defects/DEF-…`, `amendments/AMD-…`, `incidents/PERF-…`),
    and a host installed then still carries those files. `record_ids` reads the schema's flat
    layout, so a legacy record is invisible to `index`, `consult` and `check`. This function is
    how every reader finds them anyway: `check` names each one, and `wf-conform` checks a
    legacy DEF exactly as it checks a flat one. Customer DEF-Q-004 (2026-09-15) is the other
    direction of the same split: the reader looked in `defects/`, the records were flat, and
    the class-fix check read nothing and passed.
    """
    d = store_dir(root)
    out = []
    try:
        subs = sorted(e for e in os.listdir(d) if os.path.isdir(os.path.join(d, e)))
    except OSError:
        return out
    for sub in subs:
        try:
            names = sorted(os.listdir(os.path.join(d, sub)))
        except OSError:
            continue
        for name in names:
            if name.endswith(".md") and _ID_RE.match(name[:-3]):
                out.append((name[:-3], os.path.join(d, sub, name)))
    return out


def read_text(path):
    try:
        with open(path, encoding="utf-8") as fh:
            return fh.read()
    except OSError:
        return None


# ── writing a file this tool did not create ──────────────────────────────────
# `wf-companion` loads these two by path as well, so there is one reader and one writer
# for every file either script rewrites. They live here because this script loads nothing
# at import, so loading it costs a caller nothing.

def read_exact(path):
    """(text, eol, error) for a file that may be rewritten.

    Strict UTF-8 and NO newline translation. The old readers used universal newlines, and
    `wf-companion` added `errors="replace"`: a CRLF constitution came back LF everywhere,
    the untouched Strategic Objective span included, and a Latin-1 `é` became U+FFFD in
    SKILL.md and in the "verbatim" extraction, while the row said byte-identical
    (review of the 1.63.0 fix batch, finding 2). `text` keeps the file's bytes; `eol` is
    "\\r\\n" when every line ends that way, "\\n" otherwise, and None when the file mixes
    the two, so no rewrite can keep every line. `text` is None when the file is absent
    (`error` None) or cannot be read (`error` names why)."""
    try:
        with open(path, "rb") as fh:
            raw = fh.read()
    except FileNotFoundError:
        return None, None, None
    except OSError as exc:
        return None, None, "cannot be read: %s" % exc.strerror
    try:
        text = raw.decode("utf-8")
    except UnicodeDecodeError as exc:
        return None, None, ("is not valid UTF-8 (byte 0x%02x at offset %d), so no byte of it "
                            "can be kept exactly" % (raw[exc.start], exc.start))
    crlf = text.count("\r\n")
    if not crlf:
        return text, "\n", None
    return text, ("\r\n" if crlf == text.count("\n") else None), None


def inside_root(root, path):
    """True when `path`, every symlink resolved, is `root` or below it."""
    real_root = os.path.realpath(root)
    real = os.path.realpath(path)
    return os.path.commonpath([real_root, real]) == real_root


def atomic_write(root, path, data, makedirs=False):
    """Replace `path`'s bytes with `data`, or leave them exactly as they were.

    A temp file in the target's own directory, flushed and fsynced, then renamed over it.
    `open(path, "w")` truncated first: under a file-size limit a 6009-byte constitution
    became 2048 bytes and a 7459-byte hand-kept index 7168, and neither was put back
    (review of the 1.63.0 fix batch, finding 1).

    REFUSED, as an OSError naming the reason, when the path resolves outside `root`: a
    symlinked `.claude/workforce/directives` took the T2 extraction into a directory
    outside the project (finding 3). A symlink INSIDE the root is written THROUGH,
    deliberately: the rename happens in the target's directory, so the link survives and
    keeps pointing where it did. A rename in place over the link would replace it with a
    regular file, which is the hazard SKILL.md § Atomic-or-Absent rule 3 names. Refused
    too when the file has other hard links, because a rename would leave them holding the
    old bytes and an in-place write is the truncation this function exists to remove."""
    import errno
    import stat
    import tempfile
    if not inside_root(root, path):
        raise OSError(errno.EPERM, "resolves to %s, outside the project root %s; nothing "
                      "is written there" % (os.path.realpath(path), os.path.realpath(root)),
                      path)
    real = os.path.realpath(path)
    if makedirs:
        os.makedirs(os.path.dirname(real), exist_ok=True)
    try:
        st = os.stat(real)
    except FileNotFoundError:
        st = None
    if st is not None and st.st_nlink > 1:
        raise OSError(errno.EMLINK, "has %d hard links; a rename would split them and an "
                      "in-place write is not atomic, so it is left alone" % st.st_nlink, path)
    if st is not None:
        mode = stat.S_IMODE(st.st_mode)
    else:
        umask = os.umask(0)
        os.umask(umask)
        mode = 0o666 & ~umask
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(real), prefix=".wf-write.")
    try:
        with os.fdopen(fd, "wb") as fh:
            fh.write(data)
            fh.flush()
            os.fsync(fh.fileno())
        os.chmod(tmp, mode)
        os.replace(tmp, real)
    except BaseException:
        if os.path.lexists(tmp):
            os.unlink(tmp)
        raise
    try:
        dfd = os.open(os.path.dirname(real), os.O_RDONLY)
    except OSError:
        return real
    try:
        os.fsync(dfd)
    except OSError:
        pass              # a directory that cannot be fsynced here still holds the rename
    finally:
        os.close(dfd)
    return real


def header_of(root, rec_id, lines=24):
    """The field lines only — never the body. This is what makes a fallback scan of
    the whole directory cheap enough to be honest about."""
    path = record_path(root, rec_id)
    try:
        with open(path, encoding="utf-8") as fh:
            head = "".join(next(fh, "") for _ in range(lines))
    except OSError:
        return None
    return parse_fields(head, rec_id)


def parse_fields(text, rec_id):
    rec = {"id": rec_id, "type": rec_id.split("-", 1)[0]}
    for f in FIELDS:
        m = _FIELD_RE[f].search(text or "")
        rec[f.lower()] = (m.group(1).strip() if m else "")
    rec["subject_tags"] = split_tags(rec.get("subjects", ""))
    return rec


def split_tags(value):
    tags = [t.strip().lower() for t in (value or "").split(",")]
    return [t for t in tags if t and t != UNCLASSIFIED]


def is_project(rec_id):
    return rec_id.split("-", 1)[0] in TYPES


# ── the index ────────────────────────────────────────────────────────────────

def index_path(root):
    return os.path.join(store_dir(root), INDEX)


def carried_org_rows(root):
    """The ORG family's existing index rows, verbatim, keyed by ID.

    A SCOPED EXCEPTION to "never trust the old index", and the scope is the whole
    point. Enumeration still comes from the filesystem — this decides only what an
    org row SAYS, never which rows exist, so the drift this file's header warns about
    cannot come back through it: a row here that has no file on disk is never emitted,
    and a file with no row here still gets the bare fallback.

    WHY THE TEXT MUST BE CARRIED. `index --execute` is the only shipped writer of
    `index.md`, and the org rows in it are written by the procedures that own those
    records — `defect.md` step 5c says "Add it to .claude/workforce/personnel/index.md"
    in so many words. Re-emitting them as bare `- `ID` — TYPE` destroyed every summary
    a human or a procedure had put there, on a mode whose header says "Never
    hand-edited". Parsing a `Summary:` field out of the records instead was the
    alternative and it is not available: `personnel-templates.md` gives EMP, PERF, DEF,
    AMD, RFI and ORG six different field sets with no common summary line, so option
    one meant inventing a field in six templates and back-filling every record on every
    installed tree to stop a data-loss bug.
    """
    text = read_text(index_path(root)) or ""
    out = {}
    for m in _ANY_ROW_RE.finditer(text):
        if not is_project(m.group("id")):
            out[m.group("id")] = m.group(0).rstrip()
    return out


def project_row(rec):
    """The generated row for one record: rebuilt from its header for the project family,
    the bare `- `ID` — TYPE` for the org family."""
    if not is_project(rec["id"]):
        return "- `%s` — %s" % (rec["id"], rec["type"])
    row = "- `%s` — %s — %s — subjects: %s" % (
        rec["id"], rec["type"], rec["status"] or "(no status)",
        rec["subjects"] or UNCLASSIFIED)
    if rec.get("anchors") and rec["anchors"] != "(none)":
        row += " — anchors: %s" % rec["anchors"]
    return row


GENERATED_TITLE = "# Personnel index"
GENERATED_NOTE = ("Project rows are rebuilt from each record; org-family rows "
                  "(EMP, PERF, DEF, AMD, RFI, ORG) are carried through unchanged, because "
                  "the procedures that own those records write them.")
# Every other non-row line `render_index` has ever written (fa463a2 through 3e70676).
RETIRED_GENERATED_NOTES = ("Never hand-edited.",)
_GENERATED_LAYOUT_RE = re.compile(
    r"^(?:%s|%s, \d{4}-\d{2}-\d{2}\.|\*\*\d+ records\.\*\*|- `[A-Za-z]+-[A-Za-z0-9._-]+` — .*)$"
    % (re.escape(GENERATED_TITLE), re.escape(GENERATED_MARK)))


def render_index(root, records):
    today = datetime.date.today().isoformat()
    carried = carried_org_rows(root)
    out = [GENERATED_TITLE, "",
           "%s, %s." % (GENERATED_MARK, today),
           GENERATED_NOTE, "",
           "**%d records.**" % len(records), ""]
    for rec in records:
        out.append(carried.get(rec["id"]) if not is_project(rec["id"]) and rec["id"] in carried
                   else project_row(rec))
    return "\n".join(out) + "\n"


def hand_kept(text):
    """True when an index exists, holds text, and any line of it is outside the layout
    `render_index` writes.

    DECIDED BY CONTENT, never by the header phrase. The phrase test called an index
    generated when it merely STARTED with the old generated header, so a Records Owner who
    kept writing sections under that header lost "By department" and "Run narrative" on the
    next rebuild (review of the 1.63.0 fix batch, finding 5). One line a rebuild would not
    write again is enough to make the index somebody's."""
    lines = [l.rstrip("\r") for l in (text or "").split("\n") if l.strip()]
    return bool(lines) and not all(
        _GENERATED_LAYOUT_RE.match(l) or l in (GENERATED_NOTE,) + RETIRED_GENERATED_NOTES
        for l in lines)


def unindexed_block_span(text):
    """(start, end) of the WF-LEDGER-UNINDEXED block, markers included; None when there is
    none; "LONE" when only one marker is present — never guessed at, like every region."""
    starts = [m.start() for m in re.finditer(r"^" + re.escape(UNINDEXED_BLOCK[0]), text, re.M)]
    ends = [m.end() for m in re.finditer(r"^" + re.escape(UNINDEXED_BLOCK[1]), text, re.M)]
    if not starts and not ends:
        return None
    if len(starts) != 1 or len(ends) != 1 or ends[0] < starts[0]:
        return "LONE"
    return (starts[0], ends[0])


def outside_unindexed(text):
    """`text` with the WF-LEDGER-UNINDEXED block cut out: the Records Owner's own bytes."""
    sp = unindexed_block_span(text)
    return text[:sp[0]] + text[sp[1]:] if isinstance(sp, tuple) else text


def indexed_ids(text):
    """THE ONE INDEX READER: every record ID `text` indexes, as a set.

    Two row shapes, both real. The bare row `render_index` writes (`- `ID` — TYPE …`), and
    the LINK a hand-kept, sectioned index uses (`- [ID](ID.md) — …`). `wf-conform`'s DEF
    check calls this too, so the two tools cannot count one index two ways again.
    MEASURED 2026-09-16 on a customer store of 105 records: this file's row grammar alone
    read 0 of them (105 NOT INDEXED) while `wf-conform`'s substring test found every ID but
    3 DEFs, because it counted an ID named in a narrative paragraph as indexed. Both were
    wrong. The link reader gives 98, and the 7 others really are named only in prose.
    """
    # CRLF folded here, because `index` now reads a hand-kept index byte for byte and the
    # row grammar is `$`-anchored: a `\r` before the line end would unindex every row.
    text = (text or "").replace("\r\n", "\n")
    ids = {m.group("id") for m in _INDEX_ROW_RE.finditer(text) if _ID_RE.match(m.group("id"))}
    ids |= {m.group("id") for m in _LINK_RE.finditer(text) if _ID_RE.match(m.group("id"))}
    return ids


def read_index(root):
    """(rows, error). Rows carry whatever the index states — which is a CLAIM about
    the store, checked by `check` and never trusted by `index`.

    `subject_tags` is None on a row that makes no subjects claim — every link row of a
    hand-kept index — and `consult` reads that record's HEADER for its tags instead of
    treating it as untagged."""
    text = read_text(index_path(root))
    if text is None:
        return None, "no index at %s" % index_path(root)
    rows, seen = [], set()
    for m in _INDEX_ROW_RE.finditer(text):
        rec_id = m.group("id")
        if rec_id in seen or not _ID_RE.match(rec_id):
            continue
        seen.add(rec_id)
        claimed = m.group("subjects") is not None
        rows.append({
            "id": rec_id,
            "type": m.group("type"),
            "status": (m.group("status") or "").strip(),
            "subjects": (m.group("subjects") or "").strip(),
            "subject_tags": split_tags(m.group("subjects")) if claimed else None,
        })
    for rec_id in sorted(indexed_ids(text) - seen):
        rows.append({"id": rec_id, "type": rec_id.split("-", 1)[0], "status": "",
                     "subjects": "", "subject_tags": None})
    return rows, None


# ── modes ────────────────────────────────────────────────────────────────────

def do_new(root, args):
    rec_type = args.type.upper()
    if rec_type not in TYPES:
        return _die("unknown type %r — this gateway writes the project family only: %s. "
                    "The org family (EMP, PERF, DEF, AMD, RFI, ORG) is written by the "
                    "procedures that own it." % (args.type, ", ".join(TYPES)))
    slug = (args.slug or "").strip().lower()
    if not slug:
        return _die("--slug is required and was empty")
    if not _SLUG_RE.match(slug):
        return _die("--slug %r is not a legal slug (lowercase letters, digits and "
                    "hyphens, starting with a letter or digit)" % args.slug)
    status = args.status or "proposed"
    if status not in STATUSES:
        return _die("--status %r is not one of %s" % (status, ", ".join(STATUSES)))

    rec_id = "%s-%s" % (rec_type, slug)
    path = record_path(root, rec_id)
    if os.path.exists(path):
        if args.if_absent:
            # CLASS B: anything that writes is a no-op the second time. The capture
            # hook re-fires on a re-run turn and must not write a second draft of the
            # same exchange; a human typing `new` gets the refusal below instead,
            # because for them a collision is a different decision wearing a taken name.
            print("already recorded: %s (unchanged)" % rec_id)
            return 0
        return _die("%s already exists. Pick another slug, or pass --if-absent to make "
                    "this a no-op." % rec_id)

    tags = split_tags(args.subjects or "")
    subjects = ", ".join(tags) if tags else UNCLASSIFIED
    anchors = (args.anchors or "").strip() or "(none)"
    recorded_by = (args.recorded_by or "human:user").strip()
    recorded = "%s by %s" % (datetime.date.today().isoformat(), recorded_by)

    heads = BODIES[rec_type]
    body = []
    quote = (args.quote or "").strip()
    body.append("## %s" % heads[0])
    body.append("> %s" % (quote.replace("\n", "\n> ") if quote else "(not stated)"))
    for h in heads[1:-1]:
        body.append("")
        body.append("## %s" % h)
        body.append((args.why or "").strip() if h in ("Why", "Cause") else "(not stated)")
    evidence = (args.evidence or "").strip()
    body.append("")
    body.append("## Evidence")
    body.append("> %s" % (evidence.replace("\n", "\n> ") if evidence else "(not stated)"))

    text = "\n".join([
        "# %s" % rec_id, "",
        "**Status:** %s" % status,
        "**Subjects:** %s" % subjects,
        "**Anchors:** %s" % anchors,
        "**Recorded:** %s" % recorded,
        "**Supersedes:** %s" % ((args.supersedes or "").strip() or "(none)"),
        "",
    ] + body) + "\n"

    if not args.execute:
        print("would write %s" % os.path.relpath(path, root))
        print(text, end="")
        print("write with: --execute")
    else:
        atomic_write(root, path, text.encode("utf-8"), makedirs=True)
        print("wrote %s — %s, %s" % (os.path.relpath(path, root), rec_id, status))
    if subjects == UNCLASSIFIED:
        # REPORTED, never quietly shown to everyone. An untagged record is invisible
        # to `consult` by design, so the moment it is written is the only moment
        # anybody finds out it needs a tag.
        print("UNCLASSIFIED: %s carries no Subjects and will NOT be served by "
              "`consult`. Tag it." % rec_id)
    return 0


def _sort_key(rec):
    """Newest first. The `Recorded:` DATE is the key, never mtime: a fixture copy and
    a `git checkout` both rewrite mtimes, and a list that reorders itself when the
    tree is copied cannot be tested."""
    m = re.match(r"(\d{4}-\d{2}-\d{2})", rec.get("recorded", "") or "")
    return (m.group(1) if m else "0000-00-00", rec["id"])


def do_pending(root, args):
    recs = []
    for rec_id in record_ids(root):
        if not is_project(rec_id):
            continue
        rec = header_of(root, rec_id)
        if rec and rec.get("status") == "proposed":
            recs.append(rec)
    recs.sort(key=_sort_key, reverse=True)
    if args.json:
        print(json.dumps([{k: r[k] for k in ("id", "type", "status", "subjects",
                                             "anchors", "recorded")} for r in recs]))
        return 0
    if not recs:
        print("no pending records — nothing is waiting on you")
        return 0
    print("%d pending record(s), newest first:" % len(recs))
    for rec in recs:
        print("  %-28s %s  subjects: %s" % (
            rec["id"], rec["recorded"] or "(no date)", rec["subjects"] or UNCLASSIFIED))
    print("accept one with: wf-ledger accept <id> --execute")
    return 0


def _read_record_for_rewrite(rec_id):
    """(text with LF line ends, eol, error) for a record a field is about to change in.

    The field regexes are line-anchored on `\\n`, so a CRLF record is edited as LF and
    written back with CRLF: every line the edit does not touch keeps its bytes."""
    text, eol, err = read_exact(rec_id)
    if text is None:
        return None, None, err
    if eol is None:
        return None, None, "mixes CRLF and LF line ends, so a rewrite could not keep its bytes"
    return text.replace("\r\n", "\n"), eol, None


def _set_status(root, rec_id, want_from, new_status, execute, extra=None):
    path = record_path(root, rec_id)
    text, eol, err = _read_record_for_rewrite(path)
    if text is None:
        return None, ("%s %s" % (rec_id, err)) if err else "no such record: %s" % rec_id
    rec = parse_fields(text, rec_id)
    if want_from and rec["status"] not in want_from:
        return None, "%s is %s, not %s" % (rec_id, rec["status"] or "(no status)",
                                           " or ".join(want_from))
    out = _FIELD_RE["Status"].sub("**Status:** %s" % new_status, text, count=1)
    for field, value in (extra or {}).items():
        out = _FIELD_RE[field].sub("**%s:** %s" % (field, value), out, count=1)
    if execute:
        atomic_write(root, path, out.replace("\n", eol).encode("utf-8"))
    return out, None


def do_accept(root, args):
    _, err = _set_status(root, args.id, ("proposed",), "accepted", args.execute)
    if err:
        return _die(err)
    if args.execute:
        print("accepted %s — it is now served by `consult`" % args.id)
    else:
        print("would accept %s (proposed -> accepted)" % args.id)
        print("write with: --execute")
    return 0


def do_supersede(root, args):
    if not args.by:
        return _die("supersede requires --by <id>, the record that replaces this one")
    heir_path = record_path(root, args.by)
    text, eol, err = _read_record_for_rewrite(heir_path)
    if text is None:
        return _die(("%s (given to --by) %s" % (args.by, err)) if err
                    else "no such record: %s (given to --by)" % args.by)
    _, err = _set_status(root, args.id, ("accepted", "proposed"), "superseded",
                         args.execute)
    if err:
        return _die(err)
    if args.execute:
        heir = _FIELD_RE["Supersedes"].sub("**Supersedes:** %s" % args.id, text, count=1)
        atomic_write(root, heir_path, heir.replace("\n", eol).encode("utf-8"))
        print("superseded %s — %s carries Supersedes: %s" % (args.id, args.by, args.id))
    else:
        print("would supersede %s, and record Supersedes: %s on %s"
              % (args.id, args.id, args.by))
        print("write with: --execute")
    return 0


def do_consult(root, args):
    want = split_tags(args.subjects or "")
    if not want:
        return _die("consult requires --subjects a,b — an unfiltered read of the whole "
                    "store is the thing this mode exists to refuse")
    rows, err = read_index(root)
    source = "index"
    if err:
        # NOT a failure. A store whose index has not been built yet must still answer,
        # and saying which path was taken is what keeps a silent whole-store read from
        # looking like an index scan.
        source = "header scan (no index; rebuild with `wf-ledger index --execute`)"
        rows = [r for r in (header_of(root, i) for i in record_ids(root)) if r]
    candidates, unclassified, headers_read = [], 0, 0
    for row in rows:
        if not is_project(row["id"]):
            continue
        tags = row["subject_tags"]
        if tags is None:
            # A LINK ROW CLAIMS NO SUBJECTS, so its header is read for them — the five
            # field lines, never the body. Treating it as untagged would hide every
            # record a hand-kept index links from every subject query.
            hdr = header_of(root, row["id"])
            tags = hdr["subject_tags"] if hdr else []
            headers_read += 1
        if not tags:
            unclassified += 1
            continue
        if set(tags) & set(want):
            candidates.append(row["id"])
    if headers_read:
        source += " (%d row(s) claim no subjects; their headers were read)" % headers_read
    print("consult subjects: %s — via %s" % (", ".join(want), source))

    # THE INDEX SELECTS; THE RECORD DECIDES. Status is re-read from the file for every
    # candidate, never taken from the index row — an index is a CLAIM about the store
    # and it goes stale the moment `accept` runs without a rebuild. Taking the claim
    # would make a stale line the thing that serves a record nobody agreed to, which is
    # the one failure this gateway exists to make impossible. The extra reads are
    # bounded by the subject slice, so the whole store is still never read.
    matched, withheld, retired, unreadable = [], 0, 0, []
    for rec_id in candidates:
        text = read_text(record_path(root, rec_id))
        if text is None:
            unreadable.append(rec_id)
            continue
        status = parse_fields(text, rec_id)["status"]
        if status != "accepted":
            # THE LOAD-BEARING LINE. A proposed record is evidence the user has not
            # agreed to yet; it leaves this gateway as a COUNT and never as content,
            # so nothing downstream can quote a decision nobody made. A superseded one
            # is counted apart from it: "waiting on you" and "replaced" are different
            # states, and one message for both would report work where there is none.
            if status == "proposed":
                withheld += 1
            else:
                retired += 1
            continue
        matched.append((rec_id, text))
    if not matched:
        print("no accepted records match. That is an answer, not an error.")
    for rec_id, text in matched:
        print("")
        print(text.rstrip())
    for rec_id in unreadable:
        print("  %s — UNREADABLE" % rec_id)
    if withheld:
        print("")
        print("%d proposed record(s) match these subjects and were WITHHELD — a draft "
              "carries no authority until the user accepts it. Review with "
              "`wf-ledger pending`." % withheld)
    if retired:
        print("%d superseded or deprecated record(s) match and were not served." % retired)
    if unclassified:
        print("%d record(s) carry no Subjects and are served to nobody. Tag them."
              % unclassified)
    return 0


def render_unindexed(prior, records, eol="\n"):
    """(new_text, missing_ids, error) for an index this tool did NOT generate. The block is
    written with `eol`, the index's own line end, so a CRLF index stays CRLF.

    A HAND-KEPT INDEX IS NEVER REWRITTEN. A customer's Records Owner keeps a sectioned
    index whose per-run narrative and By-Department roster live in no record, and
    `render_index` would have replaced all of it with bare rows (DEF-Q-20, 2026-09-16).
    So the records it does not link are listed inside one marked block, appended once and
    replaced in place afterwards, and every byte outside that block is kept. A record the
    Records Owner later links in their own section leaves the block on the next run.
    """
    sp = unindexed_block_span(prior)
    if sp == "LONE":
        return None, [], ("the index carries one %s marker without its pair; edit it by "
                          "hand, nothing guesses where the other half belongs"
                          % UNINDEXED_BLOCK[0].split()[1])
    linked = indexed_ids(outside_unindexed(prior))
    missing = [r for r in records if r["id"] not in linked]
    if sp is None and not missing:
        return prior, [], None
    body = ["%s — rows `wf-ledger index` keeps for records on disk that this hand-kept "
            "index does not link. Everything outside these markers is left byte-for-byte. -->"
            % UNINDEXED_BLOCK[0],
            "## Not yet indexed", ""]
    body += [project_row(r) for r in missing] or [
        "(none — every record on disk is linked from this index)"]
    block = eol.join(body + [UNINDEXED_BLOCK[1]])
    if sp is None:
        sep = "" if prior.endswith("\n") else eol
        return prior + sep + eol + block + eol, [r["id"] for r in missing], None
    return prior[:sp[0]] + block + prior[sp[1]:], [r["id"] for r in missing], None


def do_index(root, args):
    recs = [r for r in (header_of(root, i) for i in record_ids(root)) if r]
    recs.sort(key=lambda r: r["id"])
    path = index_path(root)
    prior, eol, err = read_exact(path)
    if err:
        # NEVER "no index" FOR AN INDEX THAT IS THERE. Reading an undecodable index as
        # absent would rebuild over it, which is the loss the hand-kept rule exists to stop.
        return _die("%s %s; it is left alone" % (os.path.relpath(path, root), err))
    if hand_kept(prior):
        return _index_hand_kept(root, args, prior, eol or "\n", recs)
    text = render_index(root, recs)
    if args.execute:
        atomic_write(root, path, text.encode("utf-8"), makedirs=True)
        print("wrote %s — %d record(s), enumerated from the filesystem"
              % (os.path.relpath(path, root), len(recs)))
    else:
        print("would write %s — %d record(s), enumerated from the filesystem"
              % (os.path.relpath(path, root), len(recs)))
        print(text, end="")
        print("write with: --execute")
    return 0


def _index_hand_kept(root, args, prior, eol, recs):
    path = index_path(root)
    rel = os.path.relpath(path, root)
    text, missing, err = render_unindexed(prior, recs, eol)
    if err:
        return _die("%s: %s" % (rel, err))
    block = UNINDEXED_BLOCK[0].split()[1]
    print("%s is hand-kept (not generated by `wf-ledger index`), so it is never rebuilt. "
          "%d of %d record(s) on disk are not linked from it."
          % (rel, len(missing), len(recs)))
    if text == prior:
        print("nothing to write")
        return 0
    if not args.execute:
        print("would list them in the %s block; the %d byte(s) outside it stay unchanged"
              % (block, len(outside_unindexed(prior))))
        for rec_id in missing:
            print("  + %s" % rec_id)
        print("write with: --execute")
        return 0
    atomic_write(root, path, text.encode("utf-8"))
    # READ BACK, in bytes: the file is exactly what was written, the bytes outside the block
    # are the Records Owner's and are exactly what they were (a first append adds only line
    # ends after them), and every record on disk is now indexed.
    back = read_exact(path)[0] or ""
    ob, op = outside_unindexed(back), outside_unindexed(prior)
    if back != text or not (ob.startswith(op) and not ob[len(op):].strip("\r\n")) or \
            not {r["id"] for r in recs} <= indexed_ids(back):
        return _die("wrote %s and read back changed bytes outside the block, or a record "
                    "still unindexed — restore it from version control" % rel)
    print("listed them in the %s block; every byte outside it is unchanged" % block)
    return 0


def do_check(root, args):
    findings = []
    on_disk = record_ids(root)
    rows, err = read_index(root)
    if err:
        findings.append("INDEX ABSENT: %s — rebuild with `wf-ledger index --execute`"
                        % err)
    else:
        indexed = {r["id"] for r in rows}
        missing = sorted(set(on_disk) - indexed)
        extra = sorted(indexed - set(on_disk))
        if len(indexed) != len(on_disk):
            findings.append("INDEX DRIFT: index states %d record(s), the filesystem "
                            "holds %d" % (len(indexed), len(on_disk)))
        for rec_id in missing:
            findings.append("NOT INDEXED: %s is on disk and absent from the index"
                            % rec_id)
        for rec_id in extra:
            findings.append("INDEXED AND ABSENT: %s is in the index and not on disk"
                            % rec_id)
    for rec_id, path in legacy_records(root):
        findings.append("LEGACY LAYOUT: %s is filed in a subfolder; § Schema is flat, so "
                        "`index` and `consult` cannot see it until it sits at %s"
                        % (os.path.relpath(path, root),
                           os.path.relpath(record_path(root, rec_id), root)))
    for rec_id in on_disk:
        if not is_project(rec_id):
            continue          # the org family carries its own fields, checked elsewhere
        rec = header_of(root, rec_id)
        if rec is None:
            findings.append("UNREADABLE: %s" % rec_id)
            continue
        if rec["status"] not in STATUSES:
            findings.append("ILLEGAL STATUS: %s carries %r, not one of %s"
                            % (rec_id, rec["status"], ", ".join(STATUSES)))
        if not rec["subjects"]:
            findings.append("NO SUBJECTS LINE: %s — every project record carries one, "
                            "even if it reads %s" % (rec_id, UNCLASSIFIED))
    print("wf-ledger check — %d record(s) on disk, %d project record(s)"
          % (len(on_disk), sum(1 for i in on_disk if is_project(i))))
    for f in findings:
        print("  " + f)
    if findings:
        print("%d finding(s)" % len(findings))
        return 2
    print("index count equals file count; every project record has a legal Status and "
          "a Subjects line")
    return 0


def build_parser():
    ap = argparse.ArgumentParser(
        prog="wf-ledger", description="the gateway to the project record family")
    ap.add_argument("--root", default=".", help="project root (holds .claude/)")

    # `--root` IS ACCEPTED ON BOTH SIDES OF THE MODE WORD. Every shipped caller writes
    # `--root "${CLAUDE_PROJECT_DIR}"`, and where that lands relative to the mode is
    # the caller's business, not this parser's. `SUPPRESS` is what makes the second
    # copy safe: without it the sub-parser's own default would overwrite a root the
    # parent already parsed, and the tool would silently retarget to the CWD — the
    # exact failure the empty-root guard exists to refuse, reintroduced by the
    # convenience that was meant to prevent it.
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--root", default=argparse.SUPPRESS)
    sub = ap.add_subparsers(dest="mode")

    p = sub.add_parser("new", parents=[common])
    p.add_argument("type")
    p.add_argument("--slug", default="")
    p.add_argument("--subjects", default="")
    p.add_argument("--anchors", default="")
    p.add_argument("--status", default="proposed")
    p.add_argument("--recorded-by", dest="recorded_by", default="human:user")
    p.add_argument("--quote", default="", help="the words that settled it, verbatim")
    p.add_argument("--why", default="")
    p.add_argument("--evidence", default="")
    p.add_argument("--supersedes", default="")
    p.add_argument("--if-absent", dest="if_absent", action="store_true",
                   help="an existing id is a no-op success rather than a refusal")
    p.add_argument("--execute", action="store_true")

    p = sub.add_parser("pending", parents=[common])
    p.add_argument("--json", action="store_true")

    p = sub.add_parser("accept", parents=[common])
    p.add_argument("id")
    p.add_argument("--execute", action="store_true")

    p = sub.add_parser("supersede", parents=[common])
    p.add_argument("id")
    p.add_argument("--by", default="")
    p.add_argument("--execute", action="store_true")

    p = sub.add_parser("consult", parents=[common])
    p.add_argument("--subjects", default="")

    p = sub.add_parser("index", parents=[common])
    p.add_argument("--execute", action="store_true")

    sub.add_parser("check", parents=[common])
    return ap


def main(argv=None):
    args = build_parser().parse_args(argv)

    # AN EMPTY --root IS A CALLER ERROR, NEVER A SILENT RETARGET TO CWD.
    # `${CLAUDE_PROJECT_DIR}` is unset outside a hook, so every shipped
    # `--root "${CLAUDE_PROJECT_DIR}"` block expands to `--root ""`, and
    # `os.path.abspath("")` is the CWD — a real directory, so an is-it-a-directory
    # guard passes and the tool writes records into a tree nobody named.
    if not (args.root or "").strip():
        return _die("--root is empty. ${CLAUDE_PROJECT_DIR} is unset outside a hook; "
                    "pass an explicit path.")
    root = os.path.abspath(args.root)
    if not os.path.isdir(root):
        return _die("not a directory: %s" % root)
    if not args.mode:
        build_parser().print_help()
        return 2

    if args.mode != "new" and not os.path.isdir(store_dir(root)):
        return _die("no personnel store at %s — nothing has been recorded for this "
                    "project yet." % os.path.join(STORE))

    try:
        return {
            "new": do_new, "pending": do_pending, "accept": do_accept,
            "supersede": do_supersede, "consult": do_consult, "index": do_index,
            "check": do_check,
        }[args.mode](root, args)
    except OSError as exc:
        # `atomic_write` refused or failed. The file keeps the bytes it had, so this is a
        # named refusal, never a traceback over a half-written store.
        return _die("%s: not written — %s" % (
            os.path.relpath(exc.filename, root) if exc.filename else "write", exc.strerror))


if __name__ == "__main__":
    sys.exit(main())
