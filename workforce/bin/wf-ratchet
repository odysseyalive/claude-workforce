#!/usr/bin/env python3
"""wf-ratchet — monotonic improvement across audit runs, without a count.

    wf-ratchet --root <tree>              compare findings to the baseline
    wf-ratchet --root <tree> --capture    write the baseline from current findings,
                                          PRESERVING any hand-set `state` / `why`

A ratchet permits motion one way. This one is keyed on FINDINGS, never on totals,
because two integers cannot tell "fixed one, introduced one" from "nothing changed" —
and that is the only question a ratchet exists to answer. Measured on a real project:
`.claude/workforce/lint-baseline.txt` reads `errors=31 / warnings=60 / captured=<ts>`
and is compatible with all three of those histories.

FOUR VERDICTS, and the third is the one a count gets wrong:

    IMPROVED    in the baseline, gone now                      -> always allowed
    CARRIED     in both                                        -> allowed
    INHERITED   present now, and its PASS did not exist when
                the baseline was captured                      -> NOT a regression
    REGRESSION  present now, absent from the baseline, and its
                pass DID exist then                            -> the only failure

INHERITED is what makes the catalog able to grow. A pass added later flags artifacts
that were already there; the findings are new to the baseline and are not new to the
tree, and calling them regressions would mean every new pass looks like a decline.
The discriminator is the `captured-passes:` header — the token set known at capture —
never a timestamp, because a timestamp cannot say which detectors had run.

WHAT IT DOES NOT DO. It freezes; it does not drain. qntm, who named the technique:
"this technique does nothing to actively encourage the removal of these old patterns
... those remaining 67 or so calls have been kind of lingering." Draining is
`deferred.md` and `discharge`, and this file is not a substitute for either.

REPORTS AND EXITS; IT NEVER EDITS A FINDING AWAY. Exit 1 on a regression is the whole
of its enforcement.
"""

import glob
import os
import re
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

BASELINE = os.path.join(".claude", "workforce", "pass-baseline.md")
ROW_RX = re.compile(r"^\|\s*`(PASS-[A-Z-]+)`\s*\|\s*`([^`]+)`\s*\|\s*`([^`]+)`\s*\|", re.M)
HDR_RX = re.compile(r"^captured-passes:\s*(.*)$", re.M)


def read(p):
    """A diagnostic must not die on the input it exists to diagnose."""
    try:
        with open(p, encoding="utf-8") as fh:
            return fh.read()
    except OSError:
        return ""


# ── the host-side pass detectors ─────────────────────────────────────────────
# Every host-side pass in references/passes.md contributes findings here, keyed
# (token, artifact, locus). A pass whose verdict is REPORT still ratchets: the
# ratchet governs whether a finding may APPEAR, never whether it is repaired.
def findings(root):
    out = []
    wf = os.path.dirname(os.path.abspath(__file__))
    # The shipped scripts carry no `.py` extension, so spec_from_file_location
    # cannot infer a loader and returns None. Name the loader explicitly rather
    # than renaming a file six other things invoke by path.
    import importlib.util
    from importlib.machinery import SourceFileLoader
    # Never leave a __pycache__ beside a shipped script. Importing wf-remainder
    # wrote one into `workforce/bin/` on the first run and `bin/check` caught it as
    # an undeclared shipped file — in a user's install that is residue this project
    # refuses to leave, in the directory the installer owns.
    sys.dont_write_bytecode = True
    _path = os.path.join(wf, "wf-remainder")
    spec = importlib.util.spec_from_loader(
        "wf_remainder", SourceFileLoader("wf_remainder", _path))
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    for skill, token, verdict in mod.dead_scripts(root):
        out.append(("PASS-DEAD-SCRIPT", skill, token, verdict.split()[0]))
    return sorted(out)


# The tokens this build knows how to detect. A baseline captured before a token
# joined this set cannot have contained its findings — that is what makes
# INHERITED decidable without a version number.
KNOWN = ["PASS-DEAD-SCRIPT"]


def load_baseline(root):
    text = read(os.path.join(root, BASELINE))
    if not text.strip():
        return None, []
    hdr = HDR_RX.search(text)
    known = [t.strip() for t in hdr.group(1).split()] if hdr else []
    return known, [(m.group(1), m.group(2), m.group(3)) for m in ROW_RX.finditer(text)]


# A markdown table cell ends at the first UNESCAPED pipe. `\|` is markdown's escape
# for a literal one, and the two columns this file invites a human to hand-edit are
# prose — so a `why` citing `<!-- origin: user \| immutable: true -->`, or any rule
# whose text contains a pipe, is ordinary rather than exotic.
#
# MEASURED 2026-08-10 on apps-odyssey-alive, by the first run to exercise the
# annotation-preserving `capture` against a real hand-written `why`: a 634-character
# cell was rewritten to 114, SILENTLY, exit 0, dropping both rules it cited. The
# affordance the baseline header advertises — "Edit those two columns here" — carried
# an unstated character restriction, and violating it was data loss with no error.
#
# READER AND WRITER ARE ONE PAIR AND CHANGE TOGETHER. Reading unescapes, writing
# escapes, so a value round-trips unchanged through any number of `--capture` runs.
# Fixing only the reader would preserve a cell it could not then write back.
#
# The lookbehind treats a backslash as escaping whatever follows it, so a cell ending
# in a literal backslash before a pipe is not represented. That is documented rather
# than handled: these cells are prose, `\\|` has never appeared in one, and a parser
# that guesses at it would be inventing a case to be wrong about.
CELL_SPLIT_RX = re.compile(r"(?<!\\)\|")


def split_cells(row_remainder):
    """The cells of a table row, honouring `\\|` as a literal pipe."""
    return CELL_SPLIT_RX.split(row_remainder)


def unescape_cell(cell):
    """Markdown `\\|` back to the literal pipe the human meant."""
    return cell.strip().replace(r"\|", "|")


def escape_cell(value):
    """A literal pipe back to markdown `\\|`, so the row it is written into parses."""
    return value.replace("|", r"\|")


def annotations(text):
    """The `state` and `why` a human wrote into an existing baseline, keyed the same
    way a finding is.

    THE AFFORDANCE THE BASELINE DOCUMENTS HAD NO PRODUCER. Its own prose says "moving
    one to ACCEPTED requires a `why` citing a shipped rule" — and `capture` hardcoded
    every row `OPEN` with an empty `why`, so the next `--capture` destroyed the
    annotation it told the reader to write. Consumer named, producer absent.

    ONE PARSER, NOT TWO. `ROW_RX` already decides what a row is and where the key
    ends; the annotation columns are the remainder of that same line, so this slices
    from `m.end()` rather than adding a second regex that could disagree with the
    first about which lines count. It also survives a row a hand-edit has truncated:
    a stricter pattern that failed to match would silently discard the very
    annotation this exists to preserve.
    """
    out = {}
    for m in ROW_RX.finditer(text):
        eol = text.find("\n", m.end())
        cells = split_cells(text[m.end():len(text) if eol == -1 else eol])
        # verdict | state | why. The verdict is recomputed from this run's findings,
        # so only the two columns a human owns are carried forward.
        state = unescape_cell(cells[1]) if len(cells) > 1 else ""
        why = unescape_cell(cells[2]) if len(cells) > 2 else ""
        out[(m.group(1), m.group(2), m.group(3))] = (state or "OPEN", why)
    return out


def capture(root, found):
    path = os.path.join(root, BASELINE)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    # Read before write: the prior baseline is the only record of which findings a
    # human ACCEPTED and why. A row whose finding has DISAPPEARED still drops out —
    # the loop below iterates this run's findings, never the prior rows — so this
    # preserves a judgment without resurrecting a fixed defect.
    prior = annotations(read(path))
    lines = [
        "# Pass baseline",
        "",
        "Keyed on findings, never on totals. `captured-passes` is the token set known when",
        "this was written: a finding whose pass is absent from that list is INHERITED, not a",
        "regression. Written by `wf-ratchet --capture`; a row is removed only by fixing the",
        "finding, and moving one to ACCEPTED requires a `why` citing a shipped rule.",
        "",
        "`--capture` PRESERVES the `state` and `why` of any row still found, keyed on",
        "(pass, artifact, locus); a new finding is written `OPEN` with an empty `why`, and a",
        "row whose finding is gone is dropped. Edit those two columns here — nothing else,",
        "because every other column is regenerated. **A pipe is allowed in them:** write it",
        "as `\\|`, markdown's escape, and it round-trips unchanged through every --capture.",
        "",
        "**Those two columns are the ONLY durable place in this file.** `--capture` rewrites",
        "it whole from this header plus the findings, so a note added above or below the table",
        "is discarded on the next run without being mentioned. Put a rationale in the `why`",
        "cell it belongs to; put anything longer in a record that owns it.",
        "",
        "captured-passes: " + " ".join(KNOWN),
        "",
        "| pass | artifact | locus | verdict | state | why |",
        "|---|---|---|---|---|---|",
    ]
    for tok, art, loc, verdict in found:
        state, why = prior.get((tok, art, loc), ("OPEN", ""))
        # Escape on the way out, unescape on the way in (see CELL_SPLIT_RX): a `why`
        # containing a pipe survives an arbitrary number of --capture runs unchanged.
        state, why = escape_cell(state), escape_cell(why)
        lines.append(f"| `{tok}` | `{art}` | `{loc}` | {verdict} | {state} |"
                     f"{' ' + why if why else ''} |")
    with open(path, "w", encoding="utf-8") as fh:
        fh.write("\n".join(lines) + "\n")
    return path


def main(argv):
    root = "."
    if len(argv) >= 3 and argv[1] == "--root":
        root = argv[2]
        del argv[1:3]

    found = findings(root)
    keys_now = {(t, a, l) for t, a, l, _v in found}

    if "--capture" in argv:
        path = capture(root, found)
        print(f"pass baseline   {len(found)} finding(s) captured · "
              f"{len(KNOWN)} pass(es) known · {path}")
        return 0

    known_then, rows = load_baseline(root)
    if known_then is None:
        # A first run is a measurement, not a pass. Saying so is the difference
        # between "no regressions" and "nothing to compare against".
        print(f"pass ratchet    NO BASELINE — {len(found)} finding(s) present. "
              f"Capture with `wf-ratchet --root <tree> --capture`")
        return 0

    keys_then = set(rows)
    improved = keys_then - keys_now
    carried = keys_then & keys_now
    new = keys_now - keys_then
    inherited = {k for k in new if k[0] not in known_then}
    regressed = new - inherited

    print(f"pass ratchet    {len(improved)} improved · {len(carried)} carried · "
          f"{len(inherited)} inherited · {len(regressed)} REGRESSION(S)")
    for t, a, l in sorted(improved):
        print(f"  IMPROVED    {t}  {a}  {l}")
    for t, a, l in sorted(inherited):
        print(f"  INHERITED   {t}  {a}  {l}   (pass added since capture — not a regression)")
    for t, a, l in sorted(regressed):
        print(f"  REGRESSION  {t}  {a}  {l}")
    return 1 if regressed else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
