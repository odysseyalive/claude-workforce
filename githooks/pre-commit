#!/usr/bin/env bash
# Maintainer-only. Wired by bin/dev-hooks-install (sets core.hooksPath -> githooks/).
# Delegates to the tested Python logic so each rule lives in one place.
#
# Two gates, in cost order:
#   1. bin/pre-commit-version — the version-advance rule. Fails OPEN by design.
#   2. bin/check — the 1,254 conformance assertions. Fails CLOSED, because that is
#      the whole point of having them. Its own docstring called itself "the backstop
#      at verify/CI time"; there is no CI, and `verify` cannot run it (bin/ does not
#      ship), so until 2026-09-08 it ran only when a human typed it. A detector that
#      nothing triggers is dormant, and nothing ships dormant.
#
# Escape hatch: `WF_SKIP_CHECK=1 git commit ...` skips gate 2 only. `git commit
# --no-verify` skips both. Neither is the normal path.
set -uo pipefail
ROOT="$(git rev-parse --show-toplevel)"

python3 "$ROOT/bin/pre-commit-version" || exit $?

if [ "${WF_SKIP_CHECK:-}" = "1" ]; then
  echo "pre-commit: bin/check skipped (WF_SKIP_CHECK=1)" >&2
  exit 0
fi

if [ ! -x "$ROOT/bin/check" ]; then
  echo "pre-commit: bin/check missing or not executable — skipping (fail open)" >&2
  exit 0
fi

# Print only the verdict on success; the full report on failure.
out="$("$ROOT/bin/check" 2>&1)"
rc=$?
if [ $rc -ne 0 ]; then
  printf '%s\n' "$out" >&2
  echo >&2
  echo "pre-commit: bin/check FAILED — commit refused." >&2
  echo "Fix the assertions above, or bypass this gate with WF_SKIP_CHECK=1." >&2
  exit 1
fi
printf '%s\n' "$out" | tail -1 >&2
exit 0
