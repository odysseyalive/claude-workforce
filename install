#!/bin/bash
#
# Claude Workforce Installer (Linux / macOS)
# Installs the workforce skill so it is available to your projects.
#
# ONE command, whether this is a first install or an update:
#   bash -c "$(curl -fsSL https://raw.githubusercontent.com/odysseyalive/claude-workforce/main/install)"
#
# It censuses BOTH install locations first and updates whatever it finds — both,
# if both exist. Only a genuinely new install has a question to ask, and it asks
# it once. Scope can still be forced, which skips the census entirely:
#   bash -c "$(curl -fsSL .../install)" -- --project
#   WORKFORCE_SCOPE=project bash -c "$(curl -fsSL .../install)"
#
# Running more than one environment directory? Install the personal copy into a
# specific CLAUDE_CONFIG_DIR (implies --user):
#   bash -c "$(curl -fsSL .../install)" -- --config-dir ~/.claude-work
#   CLAUDE_CONFIG_DIR=~/.claude-work bash -c "$(curl -fsSL .../install)"
#
# Windows PowerShell users: use install.ps1 instead:
#   irm https://raw.githubusercontent.com/odysseyalive/claude-workforce/main/install.ps1 | iex
#
# The list of shipped files lives in manifest.txt (shared with install.ps1).
#

set -e

# OVERRIDABLE SO THE INSTALLER CAN BE TESTED AGAINST A LOCAL CHECKOUT.
#
# It was hardcoded until 2026-08-05, and that is the whole reason `install` could not be
# used during development: it always fetched the PUBLISHED tree, so re-running it to fix
# personal-install drift overwrote local changes with older code AND LOOKED LIKE A
# SUCCESSFUL REFRESH (measured: 9,881 B installed over a 14,467 B source). `bin/check`
# still names re-running the installer as a remedy for drift, and for a maintainer with
# unpushed work that remedy was actively wrong.
#
# With this, a maintainer can point it at the working tree and actually exercise the
# installer — the thing no test could reach before:
#
#   WORKFORCE_REPO_URL="file://$PWD" ./install --user
#
# The default is unchanged, so every documented curl-pipe invocation behaves exactly as
# before. This is a test seam, not a new feature.
REPO_URL="${WORKFORCE_REPO_URL:-https://raw.githubusercontent.com/odysseyalive/claude-workforce/main}"

# ── Version helpers ───────────────────────────────────────────────────────────
#
# WORKFORCE-VERSION lives in references/version.md (§ header of that file). Both the
# post-install report (echoes the version just installed to each scope) and the
# downgrade guard (compares the incoming release against what a location already has)
# read it the same way, so the parse lives in one place.
#
# Parse: the `WORKFORCE-VERSION: X.Y.Z` line, tolerating leading/trailing space and
# the code fence it sits inside. A missing file or line yields "unknown" rather than
# an error, so the report degrades to `version: unknown` and the guard becomes a no-op.
read_workforce_version() {
    _vf="$1"
    _ver=""
    if [ -f "$_vf" ]; then
        _ver="$(sed -n 's/^[[:space:]]*WORKFORCE-VERSION:[[:space:]]*\([0-9][0-9.]*\).*/\1/p' "$_vf" | head -n1)"
    fi
    [ -n "$_ver" ] || _ver="unknown"
    printf '%s' "$_ver"
}

# Is dotted version $1 strictly OLDER than $2? Compares X.Y.Z field by field in
# base 10 (so 1.10.0 > 1.9.0). Callers guard "unknown" first; a non-numeric or
# absent field counts as 0. Equal versions are NOT older.
version_is_older() {
    _va="$1"; _vb="$2"
    _a1="${_va%%.*}"; _ar="${_va#*.}"; _a2="${_ar%%.*}"; _a3="${_ar##*.}"
    _b1="${_vb%%.*}"; _br="${_vb#*.}"; _b2="${_br%%.*}"; _b3="${_br##*.}"
    for _f in "$_a1:$_b1" "$_a2:$_b2" "$_a3:$_b3"; do
        _x=$((10#0$(printf '%s' "${_f%%:*}" | tr -cd '0-9')))
        _y=$((10#0$(printf '%s' "${_f##*:}" | tr -cd '0-9')))
        [ "$_x" -lt "$_y" ] && return 0
        [ "$_x" -gt "$_y" ] && return 1
    done
    return 1
}

PROJECT_SKILL_DIR="$(pwd)/.claude/skills/workforce"
# PERSONAL_SKILL_DIR is computed after arg parsing (below), once the personal config
# root is known: `--config-dir <path>` or $CLAUDE_CONFIG_DIR can relocate the whole
# ~/.claude tree so a user with more than one environment directory installs into a
# specific one. Unset, the root is exactly $HOME/.claude and nothing changes.

# ── Scope selection ───────────────────────────────────────────────────────────
#
# PERSONAL is the default for a NEW install. The shipped skill contains no
# project-specific content — every piece of per-project state (org config, org
# chart, personnel records, employee handbooks) is written into the PROJECT by
# `/workforce audit`, never into the skill directory. So one installed copy
# serves every project, and one `/workforce update` updates them all.
#
# Cowork runs on this machine, so in CODE MODE it reads this same ~/.claude/
# setup — a personal install is fully visible there.
#
# The remaining trade-off is REMOTE sessions that only ever see a cloned repo
# (and collaborators who clone it). Those cannot read ~/.claude/. To use
# workforce on a repo that way, vendor the skill into it:
#     WORKFORCE_REPO_URL="file:///path/to/checkout" ./install --user   (no network)
# or install with --project in the first place.
#
# BUT SCOPE IS NOT GUESSED WHEN A COPY ALREADY EXISTS. Defaulting to personal on
# every run installs a SECOND copy beside a project install the user already had,
# and skill precedence (personal > project) then silently shadows the one they
# were editing. The census below is what makes one command safe to re-run: an
# update goes where the thing being updated actually is.

SCOPE_EXPLICIT=""
NO_AUTOMODE=""
CONFIG_DIR_EXPLICIT=""
FORCE=""
[ -n "$WORKFORCE_NO_AUTOMODE" ] && NO_AUTOMODE="yes"
# Wiring is ON by default: a hook that ships unwired is dormant, and the whole point of
# doing it here is that no human types a command per machine. `--no-wire` (or
# WORKFORCE_NO_WIRE, for the curl-pipe form that cannot take flags) opts out.
WANTS_WIRE="yes"
[ -n "$WORKFORCE_NO_WIRE" ] && WANTS_WIRE="no"
# WORKFORCE_FORCE is the env twin of --force, for the curl-pipe form that cannot take
# positional flags (mirrors WORKFORCE_SCOPE). Either overrides the downgrade guard.
[ -n "$WORKFORCE_FORCE" ] && FORCE="yes"
while [ $# -gt 0 ]; do
    case "$1" in
        --project|--local) SCOPE_EXPLICIT="project"; shift ;;
        --user|--personal) SCOPE_EXPLICIT="user"; shift ;;
        --no-automode) NO_AUTOMODE="yes"; shift ;;
        --no-wire) WANTS_WIRE="no"; shift ;;
        --force) FORCE="yes"; shift ;;
        # A specific CLAUDE_CONFIG_DIR to install the personal copy into. Takes a
        # path value (space- or =-separated). Guard the value: `shift` on an empty
        # stack aborts under `set -e`, so a bare trailing `--config-dir` must fail
        # with a message, not a cryptic shell error.
        --config-dir)
            [ $# -ge 2 ] || { echo "Error: --config-dir requires a path argument."; exit 1; }
            CONFIG_DIR_EXPLICIT="$2"; shift 2 ;;
        --config-dir=*) CONFIG_DIR_EXPLICIT="${1#--config-dir=}"; shift ;;
        --help|-h)
            echo "Usage: install [--user|--project] [--config-dir <path>] [--no-automode] [--no-wire] [--force]"
            echo
            echo "With no flag, existing installs are found and updated in place."
            echo "A first-time install asks where to go."
            echo
            echo "  --no-wire         install the hooks without registering them"
            echo "  --user            force the personal install"
            echo "  --project         force ./.claude/skills/workforce"
            echo "  --config-dir DIR  install the personal copy into DIR instead of ~/.claude"
            echo "                    (for running more than one environment directory on one"
            echo "                    machine); implies --user, and \$CLAUDE_CONFIG_DIR does the"
            echo "                    same if already set in your shell"
            echo "  --no-automode     skip the auto-mode grant in the config dir's settings.json"
            echo "                    that lets workforce edit its own .claude/ config unprompted"
            echo "  --force           overwrite even when the installed release is NEWER than the"
            echo "                    incoming one (bypasses the downgrade guard); \$WORKFORCE_FORCE"
            echo "                    does the same for the curl-pipe form"
            exit 0
            ;;
        *) shift ;;
    esac
done

if [ -z "$SCOPE_EXPLICIT" ] && [ -n "$WORKFORCE_SCOPE" ]; then
    case "$WORKFORCE_SCOPE" in
        user|project) SCOPE_EXPLICIT="$WORKFORCE_SCOPE" ;;
        *)
            echo "Error: unknown WORKFORCE_SCOPE '$WORKFORCE_SCOPE' (expected 'user' or 'project')."
            exit 1
            ;;
    esac
fi

# ── Personal config root ──────────────────────────────────────────────────────
#
# Claude Code reads its whole config tree from $CLAUDE_CONFIG_DIR when set (default
# ~/.claude), which is how one machine runs more than one environment directory. The
# personal install must land under the SAME root the session will resolve skills from,
# so it is derived here, highest priority first:
#     --config-dir <path>   explicit flag, wins over everything
#     $CLAUDE_CONFIG_DIR    the environment this shell already runs under
#     $HOME/.claude         the default
#
# --config-dir names a personal (user-scope) tree, so it is meaningless beside
# --project; refuse rather than guess. An explicit --config-dir also IMPLIES --user:
# the user named where the personal copy goes, so the census must not instead pick a
# project copy that happens to sit in the current directory.
# WORKFORCE_CONFIG_DIR is the env equivalent of --config-dir, for the curl-pipe form
# that cannot take positional flags (mirrors WORKFORCE_SCOPE). The flag still wins.
[ -z "$CONFIG_DIR_EXPLICIT" ] && [ -n "$WORKFORCE_CONFIG_DIR" ] && CONFIG_DIR_EXPLICIT="$WORKFORCE_CONFIG_DIR"

if [ -n "$CONFIG_DIR_EXPLICIT" ] && [ "$SCOPE_EXPLICIT" = "project" ]; then
    echo "Error: --config-dir names a personal CLAUDE_CONFIG_DIR and cannot be combined"
    echo "       with --project. A project install is anchored to the repo, not a config dir."
    exit 1
fi
[ -n "$CONFIG_DIR_EXPLICIT" ] && [ -z "$SCOPE_EXPLICIT" ] && SCOPE_EXPLICIT="user"

CONFIG_ROOT="${CONFIG_DIR_EXPLICIT:-${CLAUDE_CONFIG_DIR:-$HOME/.claude}}"
PERSONAL_SKILL_DIR="$CONFIG_ROOT/skills/workforce"

echo "Claude Workforce Installer"
echo "=========================="
echo

# ── Census both locations before deciding anything ────────────────────────────
#
# Running from $HOME makes the two paths THE SAME DIRECTORY. Counting that once
# as "both" would report a shadowing conflict against itself and install twice
# into one place.
HAVE_PERSONAL="no"
HAVE_PROJECT="no"
[ -d "$PERSONAL_SKILL_DIR" ] && HAVE_PERSONAL="yes"
if [ "$PROJECT_SKILL_DIR" != "$PERSONAL_SKILL_DIR" ] && [ -d "$PROJECT_SKILL_DIR" ]; then
    HAVE_PROJECT="yes"
fi

TARGETS=""
MODE="install"

if [ -n "$SCOPE_EXPLICIT" ]; then
    TARGETS="$SCOPE_EXPLICIT"
    if [ "$SCOPE_EXPLICIT" = "user" ] && [ "$HAVE_PERSONAL" = "yes" ]; then MODE="update"; fi
    if [ "$SCOPE_EXPLICIT" = "project" ] && [ "$HAVE_PROJECT" = "yes" ]; then MODE="update"; fi
elif [ "$HAVE_PERSONAL" = "yes" ] && [ "$HAVE_PROJECT" = "yes" ]; then
    # BOTH get updated. Updating only one leaves the other on an older release,
    # and since personal shadows project, the copy that keeps running could be
    # the one that was skipped — an update that silently changes nothing.
    TARGETS="user project"
    MODE="update"
    echo "Found workforce in BOTH locations:"
    echo "    personal  $PERSONAL_SKILL_DIR"
    echo "    project   $PROJECT_SKILL_DIR"
    echo
    echo "Updating both. Skill precedence is personal > project, so the personal"
    echo "copy is the one that runs in this project; '/workforce verify' reports"
    echo "which copy is active if you want to remove one."
    echo
elif [ "$HAVE_PERSONAL" = "yes" ]; then
    TARGETS="user"
    MODE="update"
    echo "Found an existing personal install — updating it in place."
    echo "    $PERSONAL_SKILL_DIR"
    echo
elif [ "$HAVE_PROJECT" = "yes" ]; then
    TARGETS="project"
    MODE="update"
    echo "Found an existing project install — updating it in place."
    echo "    $PROJECT_SKILL_DIR"
    echo
else
    # A genuinely new install is the ONLY case with a question in it.
    echo "No existing workforce install found."
    echo
    echo "  [1] Personal — $PERSONAL_SKILL_DIR"
    echo "      Serves every project on this machine. Recommended."
    echo
    echo "  [2] Project  — $PROJECT_SKILL_DIR"
    echo "      Travels with this repo, so collaborators and remote sessions that"
    echo "      only clone it get the skill too."
    echo
    if [ -t 0 ]; then
        printf 'Install where? [1/2, default 1] '
        read -r reply
        case "$reply" in
            2|p|P|project|Project) TARGETS="project" ;;
            *) TARGETS="user" ;;
        esac
        echo
    else
        # No terminal to ask with — a piped or CI run. Personal is the documented
        # default and the reversible choice: it touches nothing inside the repo.
        TARGETS="user"
        echo "No terminal attached — installing PERSONAL (the default)."
        echo "Re-run with --project to vendor it into this repo instead."
        echo
    fi
fi

# ── A project install BOOTSTRAPS .claude/ when it is absent ───────────────────
#
# IT USED TO DEMAND A CLAUDE.md, and offered to launch Claude Code to write one —
# 80 lines of bootstrap for a file the audit now EVACUATES and DELETES
# (`workforce/SKILL.md` § Directives, 2026-08-05). The installer was building the
# thing the tool removes, and a project with no CLAUDE.md is not unready: under
# that directive it is the GOAL STATE, reached early.
#
# IT DOES NOT DEMAND A SETTINGS FILE EITHER. Refusing on an absent `.claude/` would
# be the same mistake with a different filename — turning a thing the installer can
# simply CREATE into a precondition the user has to satisfy first. claude-enforcer
# has always done it this way: `json.load(open(p)) if os.path.exists(p) else {}`,
# create-or-merge, never refuse.
#
# So: create the directory and an empty settings file, and say so. `{}` is the
# honest starting content — `audit` Step 0.8 (`wf-permissions --apply`) and the
# Chain-of-Command deny layer populate it later, and inventing rules here would be
# writing policy the user never asked for into a file this installer does not own.
#
# NEVER CLOBBER AN EXISTING ONE. The test is `! -f` on both names, so a project
# that already has either keeps it byte-for-byte.
case " $TARGETS " in *" project "*) WANTS_PROJECT="yes" ;; *) WANTS_PROJECT="no" ;; esac
if [ "$WANTS_PROJECT" = "yes" ] \
   && [ ! -f ".claude/settings.local.json" ] && [ ! -f ".claude/settings.json" ]; then
    mkdir -p ".claude"
    printf '{}\n' > ".claude/settings.local.json"
    echo "Created .claude/settings.local.json (empty) — this directory had no Claude"
    echo "Code setup. Permissions are written later by /workforce audit, not here."
    echo
fi

# Warn about the precedence trap rather than silently shadowing. Skill precedence
# is enterprise > personal > project, so a personal copy WINS over a project copy
# of the same name. This fires only when a NEW personal copy is about to shadow an
# existing project one — the both-exist update path says its own version above.
if [ "$MODE" = "install" ] && [ "$TARGETS" = "user" ] && [ "$HAVE_PROJECT" = "yes" ]; then
    echo "Note: this project already has a vendored copy at .claude/skills/workforce."
    echo "      Skill precedence is personal > project, so the copy being installed"
    echo "      now will SHADOW it in this project. Run '/workforce verify' to see"
    echo "      which copy is active, or remove one of them."
    echo
fi

# Download the shared manifest ONCE, then install it to each target scope.
# Manifest format: optional flag ("keep" = fetch only if absent,
# "hook" = chmod +x after fetch) followed by the repo-relative path.
echo "Downloading workforce..."
MANIFEST_TMP="$(mktemp)"
trap 'rm -f "$MANIFEST_TMP"' EXIT
curl -fsSL "$REPO_URL/manifest.txt" -o "$MANIFEST_TMP"

# ── Downgrade guard ───────────────────────────────────────────────────────────
#
# Relocated here from the `update` procedure so a BARE full install is protected too,
# not only `/workforce update` (which runs this same installer). For any target that
# ALREADY has a copy, refuse to overwrite a NEWER installed release with an OLDER
# incoming one unless --force. A first-time install has nothing to compare against, so
# this is a strict no-op there.
#
# The incoming version is the source-side references/version.md — fetched the same way
# every other shipped file is (`$REPO_URL/workforce/...`), so it reflects exactly what
# the install loop below is about to write.
INCOMING_VERSION="unknown"
INCOMING_VERSION_TMP="$(mktemp)"
if curl -fsSL "$REPO_URL/workforce/references/version.md" -o "$INCOMING_VERSION_TMP" 2>/dev/null; then
    INCOMING_VERSION="$(read_workforce_version "$INCOMING_VERSION_TMP")"
fi
rm -f "$INCOMING_VERSION_TMP"

for guard_scope in $TARGETS; do
    case "$guard_scope" in
        user) guard_dir="$PERSONAL_SKILL_DIR" ;;
        project) guard_dir="$PROJECT_SKILL_DIR" ;;
        *) continue ;;
    esac
    INSTALLED_VERSION="$(read_workforce_version "$guard_dir/references/version.md")"
    # Nothing installed here, or either side unreadable: nothing to compare, no-op.
    case "$INCOMING_VERSION" in unknown|'') continue ;; esac
    case "$INSTALLED_VERSION" in unknown|'') continue ;; esac
    if [ "$FORCE" != "yes" ] && version_is_older "$INCOMING_VERSION" "$INSTALLED_VERSION"; then
        echo
        echo "REFUSING TO DOWNGRADE ($guard_scope):"
        echo "    installed: $INSTALLED_VERSION at $guard_dir"
        echo "    incoming:  $INCOMING_VERSION (older)"
        echo
        echo "  This would overwrite a newer release with an older one. Re-run with"
        echo "  --force (or set WORKFORCE_FORCE=1) to install the older release anyway."
        exit 1
    fi
done

FETCH_FAILED=""
VERIFY_FAILED=""
SETTINGS_FAILED=""

# Remove what the manifest no longer lists.
#
# `update.md` line 57 has promised "a clean full replacement, not a merge" since
# the file was written. Against this installer that sentence was FALSE: the fetch
# loop wrote the current manifest set over whatever was already there and removed
# nothing, so a file dropped from the manifest stayed on disk forever. MEASURED
# 2026-09-09: zero removal operations in this file outside failed-fetch cleanup at
# line 507, and zero comparison against the tree already installed. `bin/sync`
# rmtree's and rebuilds, so the DEV path has always been clean and the INSTALL path
# never was — the gap survived because every release from 1.8.0 to 1.30.1 mostly
# ADDED files, so it had nothing to expose. The strip-down release is the first that
# removes many, which turns a dormant gap into the largest residue event the project
# would ever have produced, shipped by the release meant to cut residue.
#
# SCOPE IS THE ENTIRE SAFETY ARGUMENT, and it is three different rules:
#
#   1. Inside the skill directory the manifest is authoritative. Anything not listed
#      is an orphan and goes.
#   2. Outside it — `agents/`, `output-styles/` — other tools' files sit beside ours
#      in shared directories. NOTHING there is removed unless a previous run of this
#      installer wrote it, recorded by exact path in `.installed-external`. A blunt
#      basename match would delete a user's own agent that happened to share a name.
#   3. `.claude/workforce/` project state is NEVER walked. `update.md` step 5 promises
#      it is byte-identical across an update. That promise cost nothing while no prune
#      existed; it is load-bearing now, so it is asserted below rather than inferred
#      from the paths merely being different.
#
# A partial install never prunes. If any fetch failed, the manifest set on disk is
# incomplete, and deleting "everything not in the set" would delete working files
# whose replacements did not arrive.
prune_scope() {
    _skill_dir="$1"
    _agents_dir="$2"
    _styles_dir="$3"

    # Rule 3, asserted. Refusing is the correct outcome — an un-pruned install is
    # untidy, and a prune pointed at the wrong root destroys a user's project state.
    case "$_skill_dir" in
        */skills/workforce) : ;;
        *)
            echo "  Prune SKIPPED: '$_skill_dir' is not a skill directory under skills/workforce."
            return 0 ;;
    esac
    case "$_skill_dir" in
        */.claude/workforce|*/.claude/workforce/*)
            echo "  Prune REFUSED: '$_skill_dir' is project state, not a skill directory."
            return 0 ;;
    esac

    if [ -n "${FETCH_FAILED:-}" ]; then
        echo "  Prune SKIPPED: a fetch failed this run, so the shipped set on disk is incomplete."
        return 0
    fi

    _expect="$(mktemp)"
    _ext_now="$(mktemp)"
    _seed="$(mktemp)"
    : > "$_expect"
    : > "$_ext_now"
    : > "$_seed"

    while IFS= read -r pline || [ -n "$pline" ]; do
        case "$pline" in ''|\#*) continue ;; esac
        pflag=""
        ppath="$pline"
        case "$pline" in
            "keep "*)   ppath="${pline#keep }" ;;
            "hook "*)   ppath="${pline#hook }" ;;
            "exec "*)   ppath="${pline#exec }" ;;
            "canary "*) pflag="canary"; ppath="${pline#canary }" ;;
            "style "*)  pflag="style";  ppath="${pline#style }" ;;
            # A retired path is NOT expected on disk and is NOT written to
            # $_ext_now — that file is "what we ship now", and shipping is exactly
            # what a retired path stopped doing. It goes to the seed list instead.
            "retired "*) pflag="retired"; ppath="${pline#retired }" ;;
        esac
        if [ "$pflag" = "canary" ]; then
            echo "$_agents_dir/$(basename "$ppath")" >> "$_ext_now"
        elif [ "$pflag" = "style" ]; then
            echo "$_styles_dir/$(basename "$ppath")" >> "$_ext_now"
        elif [ "$pflag" = "retired" ]; then
            # Destination from the source directory, the same mapping the live flags
            # use. An unrecognized prefix is NOT guessed at: seeding a wrong path
            # would point a delete at a directory nobody declared.
            case "$ppath" in
                workforce/canary/*)        echo "$_agents_dir/$(basename "$ppath")" >> "$_seed" ;;
                workforce/output-styles/*) echo "$_styles_dir/$(basename "$ppath")" >> "$_seed" ;;
                *) echo "  Prune: retired path '$ppath' has no known destination; skipped." ;;
            esac
        else
            echo "${ppath#workforce/}" >> "$_expect"
        fi
    done < "$MANIFEST_TMP"

    _record="$_skill_dir/.installed-external"
    _pruned=0

    # Rule 1 — the skill directory, where the manifest is the whole truth.
    find "$_skill_dir" -type f -print > "$_expect.found" 2>/dev/null || : > "$_expect.found"
    while IFS= read -r pf || [ -n "$pf" ]; do
        [ -n "$pf" ] || continue
        _rel="${pf#"$_skill_dir"/}"
        [ "$_rel" = ".installed-external" ] && continue
        if ! grep -Fxq "$_rel" "$_expect"; then
            rm -f "$pf" && _pruned=$((_pruned + 1))
            echo "  Pruned $_rel"
        fi
    done < "$_expect.found"

    # THE BOOTSTRAP. Rule 2 reads `.installed-external`, and that record was added
    # WITH this prune (2026-09-09). On every host installed before then it does not
    # exist, so rule 2 reads nothing and the external files of older releases survive
    # forever — which is the precise case the prune was written for. Seeding the
    # record from the manifest's `retired` list closes that, and it does not weaken
    # rule 2: these are paths this project shipped, named explicitly in the manifest,
    # never inferred from a basename or a directory scan.
    #
    # ONLY when the record is absent. A record that exists is the authority on what
    # THIS host was written, and overwriting it with a static list would claim
    # authorship of files this installer may never have placed here.
    if [ ! -f "$_record" ] && [ -s "$_seed" ]; then
        _seeded=0
        while IFS= read -r sf || [ -n "$sf" ]; do
            [ -n "$sf" ] || continue
            [ -f "$sf" ] && _seeded=$((_seeded + 1))
        done < "$_seed"
        cp "$_seed" "$_record" 2>/dev/null || :
        echo "  Prune: no install record here; seeded from the manifest's retired list ($_seeded of $(grep -c . "$_seed") present on disk)."
    fi

    # Rule 2 — outside it, only files a previous run of this installer wrote.
    if [ -f "$_record" ]; then
        while IFS= read -r pf || [ -n "$pf" ]; do
            [ -n "$pf" ] || continue
            if [ -f "$pf" ] && ! grep -Fxq "$pf" "$_ext_now"; then
                rm -f "$pf" && _pruned=$((_pruned + 1))
                echo "  Pruned $pf"
            fi
        done < "$_record"
    fi
    cp "$_ext_now" "$_record" 2>/dev/null || :

    # Directories the prune emptied. -delete on -empty never removes a non-empty
    # parent, and $_skill_dir itself always holds .installed-external.
    find "$_skill_dir" -mindepth 1 -type d -empty -delete 2>/dev/null || :

    rm -f "$_expect" "$_expect.found" "$_ext_now" "$_seed"
    if [ "$_pruned" -gt 0 ]; then
        echo "  Pruned $_pruned file(s) the manifest no longer lists."
    else
        echo "  Prune: nothing orphaned."
    fi
}

# Post-install completeness pass. The manifest is the authoritative shipped-file
# list, so "did the install include everything the project needs" is answerable
# by re-reading it against disk -- and it was never asked. This both REPORTS what
# is absent and CORRECTS what it can: a lost executable bit is restored in place
# rather than reported, because a non-executable hook fails exactly like a
# missing one and the fix needs no decision from anybody.
verify_scope() {
    vdir="$1"
    v_total=0
    v_missing=""
    v_fixed=0

    while IFS= read -r vline || [ -n "$vline" ]; do
        case "$vline" in
            ''|\#*) continue ;;
            # Not shipped, so not part of completeness. See the fetch loop above.
            "retired "*) continue ;;
        esac

        vflag=""
        vpath="$vline"
        case "$vline" in
            "keep "*) vflag="keep"; vpath="${vline#keep }" ;;
            "hook "*) vflag="hook"; vpath="${vline#hook }" ;;
            "exec "*) vflag="hook"; vpath="${vline#exec }" ;;
            "canary "*) vflag="canary"; vpath="${vline#canary }" ;;
            "style "*) vflag="style"; vpath="${vline#style }" ;;
        esac

        if [ "$vflag" = "canary" ]; then
            vdest="$agents_dir/$(basename "$vpath")"
        elif [ "$vflag" = "style" ]; then
            vdest="$styles_dir/$(basename "$vpath")"
        else
            vdest="$vdir/${vpath#workforce/}"
        fi
        v_total=$((v_total + 1))

        if [ ! -s "$vdest" ]; then
            v_missing="$v_missing $vpath"
            continue
        fi

        if [ "$vflag" = "hook" ] && [ ! -x "$vdest" ]; then
            chmod +x "$vdest" && v_fixed=$((v_fixed + 1))
        fi
    done < "$MANIFEST_TMP"

    if [ -n "$v_missing" ]; then
        echo
        echo "  INCOMPLETE INSTALL -- these files are missing or empty:"
        for vm in $v_missing; do echo "    $vm"; done
        VERIFY_FAILED="yes"
    else
        echo "  Verified: $v_total/$v_total files present."
    fi
    [ "$v_fixed" -gt 0 ] && echo "  Repaired the executable bit on $v_fixed file(s)."
    return 0
}

install_to_scope() {
    scope="$1"
    case "$scope" in
        user)
            skill_dir="$PERSONAL_SKILL_DIR"
            agents_dir="$CONFIG_ROOT/agents"
            styles_dir="$CONFIG_ROOT/output-styles"
            settings_file="$CONFIG_ROOT/settings.json"
            scope_label="personal ($CONFIG_ROOT/skills)"
            ;;
        project)
            skill_dir="$PROJECT_SKILL_DIR"
            agents_dir="$(pwd)/.claude/agents"
            styles_dir="$(pwd)/.claude/output-styles"
            settings_file=".claude/settings.local.json"
            scope_label="project ($(pwd)/.claude/skills)"
            ;;
    esac

    echo
    echo "Scope: $scope_label"
    echo "Installing to $skill_dir"

    while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in
            ''|\#*) continue ;;
            # `retired` names a path this project USED to install outside the skill
            # directory. It is not a shipped file and is never fetched; its only
            # reader is prune_scope, which seeds `.installed-external` from it.
            "retired "*) continue ;;
        esac

        flag=""
        path="$line"
        case "$line" in
            "keep "*) flag="keep"; path="${line#keep }" ;;
            "hook "*) flag="hook"; path="${line#hook }" ;;
            # `exec` is `hook`'s mechanical twin — chmod +x, nothing else. It is a
            # separate word because this project ships exactly ONE hook and several
            # plain scripts (references/enforcement.md § Hooks), and a manifest line
            # reading `hook workforce/bin/wf-census` would claim a registration in
            # the one place a reader checks what actually ships.
            "exec "*) flag="hook"; path="${line#exec }" ;;
            # `canary` files do NOT live in the skill directory: they are agent
            # definitions and must land in .claude/agents/ to be registered as
            # agent types at all. Installed here so they are ALREADY REGISTERED
            # by the first audit -- fact 3's delay means fixtures written during
            # a run cannot resolve in that run, which forced a restart to clear
            # every DEGRADED tier-ceiling mark.
            "canary "*) flag="canary"; path="${line#canary }" ;;
            # `style` files do NOT live in the skill directory either: an output
            # style is read from `<config-root>/output-styles/` or the project's
            # `.claude/output-styles/`, and nowhere else. It modifies the system
            # prompt, which is why the plain-speak rule lands here rather than in
            # a reference the model has to still be paying attention to.
            "style "*) flag="style"; path="${line#style }" ;;
        esac

        if [ "$flag" = "canary" ]; then
            dest="$agents_dir/$(basename "$path")"
        elif [ "$flag" = "style" ]; then
            dest="$styles_dir/$(basename "$path")"
        else
            dest="$skill_dir/${path#workforce/}"
        fi

        if [ "$flag" = "keep" ] && [ -f "$dest" ]; then
            echo "Keeping existing $(basename "$dest") (preserving your edits)..."
            continue
        fi

        mkdir -p "$(dirname "$dest")"
        # A failed fetch used to be silent: curl -f returns non-zero and the loop
        # carried on, so a partial install looked exactly like a complete one and
        # the first symptom was a procedure step dying on a missing script. Every
        # fetch is now checked, and the run is verified again at the end.
        if ! curl -fsSL "$REPO_URL/$path" -o "$dest"; then
            echo "  FETCH FAILED: $path"
            FETCH_FAILED="$FETCH_FAILED $path"
            rm -f "$dest"
            continue
        fi

        if [ "$flag" = "hook" ]; then
            chmod +x "$dest"
        fi
    done < "$MANIFEST_TMP"

    prune_scope "$skill_dir" "$agents_dir" "$styles_dir"

    verify_scope "$skill_dir"

    # Echo the version just installed to this scope, read from the copy that actually
    # landed (`<skill_dir>/references/version.md`), so the report reflects disk, not the
    # source we fetched from. Degrades to `version: unknown` rather than failing.
    installed_version="$(read_workforce_version "$skill_dir/references/version.md")"
    [ "$installed_version" = "unknown" ] && installed_version="version: unknown"
    echo "  Installed workforce $installed_version at $skill_dir ($scope)"

    # CANARY FIXTURES LAND IN ONE SCOPE'S agents/ DIR, AND NOTHING RECONCILED THE OTHER.
    #
    # Measured 2026-08-05: installing at both scopes over time left the four canaries in
    # ~/.claude/agents AND ./.claude/agents, byte-identical. wf-census reported 4 live
    # collisions, which is precondition 1(b) of the Atomic-or-Absent gate, and the first
    # `dev audit` halted on a correctly-installed tree. The census now classifies an
    # identical pair as a DUPLICATE rather than a collision — but a duplicate is still
    # residue under the user directive ("I don't want to leave any of the old system
    # still there ... it will be confusing"), and this is where it is produced.
    #
    # REPORTED, NEVER REMOVED. The other scope is not this install's to edit; deleting
    # there is exactly the "overwrite the user's preferences" move the permissions
    # directive refuses. Name it, name the remedy, and let the operator choose.
    if [ "$scope" = "user" ]; then other_agents="$(pwd)/.claude/agents"; else other_agents="$CONFIG_ROOT/agents"; fi
    if [ -d "$other_agents" ] && [ "$other_agents" != "$agents_dir" ]; then
        dup_n=0
        for f in "$agents_dir"/wf-*.md; do
            [ -e "$f" ] || continue
            if [ -e "$other_agents/$(basename "$f")" ]; then
                dup_n=$((dup_n + 1))
            fi
        done
        if [ "$dup_n" -gt 0 ]; then
            echo
            echo "  NOTE: $dup_n canary fixture(s) are also registered in $other_agents."
            echo "  Harmless — personal shadows project and the copies are identical, so"
            echo "  whichever resolves behaves the same. Remove the ones you do not want;"
            echo "  \`wf-census\` reports them as duplicates, not collisions."
        fi
    fi

    # Configure the delegation contract and the permissions the org needs.
    #
    # CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH is written EXPLICITLY even though 3 is the
    # default: the three-tier org (CEO -> Lead -> IC) is a *contract* with that number,
    # and `/workforce verify` reconciles against it. A host that lowered the value must
    # fail loudly rather than silently flattening the org.
    #
    # CLAUDE_CODE_MAX_SUBAGENTS_PER_SESSION is deliberately NOT written. That cap
    # cannot be disabled, and configuring it would imply a control we do not have.
    #
    # `Agent` in permissions.allow is not optional. Without it every single delegation
    # raises a prompt, and an org that prompts on every hop is unusable. At user scope
    # these land in ~/.claude/settings.json and therefore apply to every project on
    # this machine — which is the point of a personal install, and is announced below.
    echo "Configuring settings in $settings_file..."
    if [ "$scope" = "user" ]; then
        echo "  (user scope — these apply to every project on this machine)"
    fi
    if command -v python3 &>/dev/null; then
        # `if !` keeps set -e from killing the run here. The parse failure below is
        # the USER'S settings file, broken before this run wrote anything: the skill
        # files above installed fine, and a traceback at this point reads as a failed
        # install while naming no fix. Report it, touch nothing, and let the summary
        # say what remains.
        if ! SETTINGS_FILE="$settings_file" python3 -c "
import json, os, sys

p = os.environ['SETTINGS_FILE']
try:
    d = json.load(open(p)) if os.path.exists(p) else {}
except ValueError as e:
    print(f'  Could not parse {p} as JSON: {e}')
    print('  Leaving it untouched. Fix the syntax and re-run this installer, or add')
    print('  these settings yourself:')
    print('  { \"env\": { \"CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH\": \"3\" },')
    print('    \"permissions\": { \"allow\": [\"Agent\", \"SendMessage\", \"TaskCreate\", \"TaskUpdate\",')
    print('                               \"TaskList\", \"TaskGet\", \"WebSearch\", \"WebFetch\"] } }')
    sys.exit(3)
changed = False

env_vars = {'CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH': '3'}
for k, v in env_vars.items():
    if d.get('env', {}).get(k) != v:
        d.setdefault('env', {})[k] = v
        changed = True
        print(f'  Set {k}={v}')
    else:
        print(f'  {k} already set to {v}')

# Delegation + coordination tools the org depends on, plus research tools.
org_tools = [
    'Agent',
    'SendMessage',
    'TaskCreate',
    'TaskUpdate',
    'TaskList',
    'TaskGet',
    'WebSearch',
    'WebFetch',
]
allow = d.setdefault('permissions', {}).setdefault('allow', [])
for tool in org_tools:
    if tool not in allow:
        allow.append(tool)
        changed = True
        print(f'  Added {tool} to permissions.allow')
    else:
        print(f'  {tool} already in permissions.allow')

if changed:
    parent = os.path.dirname(p)
    if parent:
        os.makedirs(parent, exist_ok=True)
    json.dump(d, open(p, 'w'), indent=2)
    print(f'  Settings saved to {p}')
"; then
            SETTINGS_FAILED="$SETTINGS_FAILED $settings_file"
        fi
    else
        echo "  Warning: python3 not found. Add these to $settings_file manually:"
        echo '  { "env": { "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "3" },'
        echo '    "permissions": { "allow": ["Agent", "SendMessage", "TaskCreate", "TaskUpdate",'
        echo '                               "TaskList", "TaskGet", "WebSearch", "WebFetch"] } }'
    fi

    # WIRE WHAT WAS JUST INSTALLED. A shipped hook that nobody registers is dormant,
    # and until 2026-09-07 the only thing that registered one was a human typing
    # `/workforce hooks --execute` or `! wf-settings-apply --wire-hook <name>` once per
    # machine and once per project. On one workstation that is a chore. Across servers
    # it is a mechanism that DOES NOT PROPAGATE, and a mechanism that does not
    # propagate is dormant everywhere nobody typed it -- which is the exact state the
    # four inherited hooks were deleted for, reached through the gesture instead of
    # through the file. User directive, 2026-09-07: "I can't have manual commands being
    # run ... no user will want to do that."
    #
    # NOT A NEW DECISION SURFACE. The set is DEFAULT_HOOKS, which is precisely what
    # `/workforce hooks --execute` wires; OPT_IN_HOOKS stays out of it. Every write is
    # the same idempotent NOOP-if-present write, recorded in `.settings-owned.json`, so
    # `disband` reverses exactly these and nothing else. `--no-wire` opts out.
    #
    # NEVER FATAL. A wiring failure must not fail an install whose files all landed:
    # `verify` reports an unwired hook, and an install that aborts here leaves a tree
    # that is complete and looks broken.
    if [ "$WANTS_WIRE" = "no" ]; then
        echo "  Skipping hook wiring and output style (--no-wire)."
    elif ! command -v python3 &>/dev/null; then
        echo "  Warning: python3 not found; hooks are installed but NOT wired."
        echo "  Wire them later with: /workforce hooks --execute"
    else
        echo "Wiring hooks and selecting the output style..."
        if [ "$scope" = "user" ]; then
            python3 "$skill_dir/bin/wf-settings-apply" --scope user \
                --wire-defaults --execute 2>&1 | sed 's/^/  /' || \
                echo "  Warning: wiring reported a problem. Run \`/workforce verify\` to see what is unwired."
        else
            python3 "$skill_dir/bin/wf-settings-apply" --root "$(pwd)" \
                --wire-defaults --execute 2>&1 | sed 's/^/  /' || \
                echo "  Warning: wiring reported a problem. Run \`/workforce verify\` to see what is unwired."
        fi
    fi
}

for scope in $TARGETS; do
    install_to_scope "$scope"
done

echo
if [ -n "$FETCH_FAILED" ] || [ -n "$VERIFY_FAILED" ]; then
    echo "INSTALL INCOMPLETE."
    [ -n "$FETCH_FAILED" ] && { echo "  Downloads that failed:"; for ff in $FETCH_FAILED; do echo "    $ff"; done; }
    echo
    echo "  Re-run this installer to finish -- it is safe to run repeatedly and will"
    echo "  refetch whatever is absent. Files flagged \`keep\` are never overwritten."
    echo "  Finish this install before running any workforce command -- procedures invoke"
    echo "  the shipped scripts by path, and a missing one fails mid-run."
    exit 1
fi

if [ -n "$SETTINGS_FAILED" ]; then
    echo "SETTINGS NOT CONFIGURED."
    echo "  Every skill file installed and verified, but these settings files could not"
    echo "  be updated (details above):"
    for sf in $SETTINGS_FAILED; do echo "    $sf"; done
    echo
    echo "  Workforce runs without them, but the org's delegation contract is not set:"
    echo "  every delegation will raise a permission prompt until the settings are in."
    exit 1
fi

# Auto-mode grant — user scope, once, regardless of install scope. Runs HERE, from the
# installer's own shell, precisely because that shell is not gated by the classifier the
# grant is about: an agent writing ~/.claude/settings.json is refused as self-modification,
# a human running this installer is not. Written by the shipped wf-settings-apply so the
# entry text has ONE source (never a second copy pasted into this file). Reversible with
# `claude auto-mode reset`; skip with --no-automode.
if [ -z "$NO_AUTOMODE" ]; then
    wsa=""
    for cand in "$PERSONAL_SKILL_DIR/bin/wf-settings-apply" "$PROJECT_SKILL_DIR/bin/wf-settings-apply"; do
        [ -f "$cand" ] && { wsa="$cand"; break; }
    done
    echo
    # CLAUDE_CONFIG_DIR is exported into wf-settings-apply so its user_settings_path()
    # resolves to THIS install's config root, not a bare ~/.claude — under a --config-dir
    # install the auto-mode grant belongs in the same tree as the skill.
    echo "Auto-mode grant ($CONFIG_ROOT/settings.json, user scope):"
    echo "  Claude Code's auto-mode classifier can refuse workforce's edits to its own"
    echo "  .claude/ config (settings, agent handbooks, hooks) as \"self-modification\","
    echo "  above the permissions layer. This adds an autoMode.allow/environment entry so"
    echo "  those edits are trusted, letting an audit configure a project with no manual"
    echo "  step. Reversible: \`claude auto-mode reset\`. Skip: re-run with --no-automode."
    if [ -n "$wsa" ] && command -v python3 &>/dev/null; then
        if ! CLAUDE_CONFIG_DIR="$CONFIG_ROOT" python3 "$wsa" --execute --automode; then
            echo "  Could not write it now. Run it yourself later (your shell is not gated):"
            echo "    CLAUDE_CONFIG_DIR=\"$CONFIG_ROOT\" python3 \"$wsa\" --execute --automode"
        fi
    else
        echo "  Skipped: wf-settings-apply or python3 not found. After install, run:"
        echo "    CLAUDE_CONFIG_DIR=\"$CONFIG_ROOT\" python3 <skill-dir>/bin/wf-settings-apply --execute --automode"
    fi
    echo
fi

if [ "$MODE" = "update" ]; then
    echo "Update complete ($TARGETS)."
else
    echo "Installation complete ($TARGETS scope)."
fi
echo
echo "NOTE: the skill is not immediately invocable. It registers later in this session,"
echo "      or immediately after a restart -- restart Claude Code if you want it now."
echo "Newly written agent definitions are not IMMEDIATELY discoverable. They register"
echo "later in a session on their own, but the delay is undetermined — restarting is"
echo "the reliable way to reach new employees now."
echo
case " $TARGETS " in *" user "*)
    echo "This install serves every project on this machine. Each project gets its"
    echo "own separate company: employees in its .claude/agents/, and its config,"
    echo "org chart, and personnel records in its .claude/workforce/."
    echo
    echo "Cowork sees this install too, as long as it is in code mode."
    echo
    echo "For a repo worked on REMOTELY (a session that only clones the repo) or"
    echo "shared with collaborators, run this same installer there. On a machine"
    echo "with no network, point it at a local checkout:"
    echo "    WORKFORCE_REPO_URL=\"file:///path/to/claude-workforce\" ./install --user"
    echo
    ;;
esac
echo "Then, from inside a project:"
echo "    /workforce audit          Survey the project and build its org"
echo "    /org <describe a task>    Hand work to the right employee"
echo "    /workforce roster         Who works here, on which model"
echo
