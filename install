#!/bin/bash
#
# Claude Workforce Installer (Linux / macOS)
# Installs the workforce skill so it is available to your projects.
#
# Usage — PERSONAL install (default; one copy, every project on this machine):
#   bash -c "$(curl -fsSL https://raw.githubusercontent.com/odysseyalive/claude-workforce/main/install)"
#
# Usage — PROJECT install (vendored into this repo; travels with it and is
# visible to collaborators and to remote sessions that only clone the repo):
#   bash -c "$(curl -fsSL .../install)" -- --project
#   WORKFORCE_SCOPE=project bash -c "$(curl -fsSL .../install)"
#
# Windows PowerShell users: use install.ps1 instead:
#   irm https://raw.githubusercontent.com/odysseyalive/claude-workforce/main/install.ps1 | iex
#
# The list of shipped files lives in manifest.txt (shared with install.ps1).
#

set -e

REPO_URL="https://raw.githubusercontent.com/odysseyalive/claude-workforce/main"

# ── Scope selection ───────────────────────────────────────────────────────────
#
# PERSONAL is the default. The shipped skill contains no project-specific
# content — every piece of per-project state (org config, org chart, personnel
# records, employee handbooks) is written into the PROJECT by `/workforce audit`,
# never into the skill directory. So one installed copy serves every project,
# and one `/workforce update` updates them all.
#
# Cowork runs on this machine, so in CODE MODE it reads this same ~/.claude/
# setup — a personal install is fully visible there.
#
# The remaining trade-off is REMOTE sessions that only ever see a cloned repo
# (and collaborators who clone it). Those cannot read ~/.claude/. To use
# workforce on a repo that way, vendor the skill into it:
#     /workforce vendor            (from inside that project)
# or install with --project in the first place.

SCOPE="${WORKFORCE_SCOPE:-user}"
for arg in "$@"; do
    case "$arg" in
        --project|--local) SCOPE="project" ;;
        --user|--personal) SCOPE="user" ;;
        --help|-h)
            echo "Usage: install [--user|--project]"
            echo "  --user     install to ~/.claude/skills/workforce (default)"
            echo "  --project  install to ./.claude/skills/workforce"
            exit 0
            ;;
    esac
done

case "$SCOPE" in
    user)
        SKILL_ROOT="$HOME/.claude/skills"
        SETTINGS_FILE="$HOME/.claude/settings.json"
        SCOPE_LABEL="personal (~/.claude/skills)"
        ;;
    project)
        SKILL_ROOT=".claude/skills"
        SETTINGS_FILE=".claude/settings.local.json"
        SCOPE_LABEL="project ($(pwd)/.claude/skills)"
        ;;
    *)
        echo "Error: unknown WORKFORCE_SCOPE '$SCOPE' (expected 'user' or 'project')."
        exit 1
        ;;
esac

SKILL_DIR="$SKILL_ROOT/workforce"

echo "Claude Workforce Installer"
echo "=========================="
echo "Scope: $SCOPE_LABEL"
echo

# A PROJECT install lands inside a repo, so that repo needs a CLAUDE.md — the
# same precondition claude-enforcer enforces. A PERSONAL install is machine-wide
# and is not tied to any repo, so it has no such precondition: you install once
# here, then run `/workforce audit` inside whichever project you want an org for
# (and *that* project needs its CLAUDE.md at that point, not now).
if [ "$SCOPE" = "project" ] && [ ! -f "CLAUDE.md" ]; then
    BOOTSTRAP_PROMPT='Goal: bootstrap a preliminary CLAUDE.md for this brand-new project, then install the workforce skill.

First, create a durable task list with TaskCreate (so this work survives context compaction) covering the steps below, then work through them in order:

1. Ask me, using AskUserQuestion, what this project is meant to accomplish: its purpose and the problem it solves.
2. Based on my answer, ask focused follow-up questions (one batch at a time) about the language and stack, how to build / run / test it, the key directories, the conventions to follow, and any hard constraints or things to avoid. Keep the questions tight and ask only what you need to write a useful CLAUDE.md. Stop asking once you have enough.
3. Write a preliminary CLAUDE.md at the project root capturing the purpose, stack, how to build / run / test, layout, and conventions from my answers. Keep it concise and accurate. Do not invent details I did not give you.
   Keep it SHORT. CLAUDE.md is injected into every agent employee this tool creates, so its length is multiplied by your whole org. Aim well under 200 lines.
4. As the final step, install the workforce skill by running this in a Bash tool:
   bash -c "$(curl -fsSL https://raw.githubusercontent.com/odysseyalive/claude-workforce/main/install)" -- --project
5. After it installs, tell me to restart Claude Code and run /workforce audit.

Begin with step 1 now.'

    print_bootstrap_help() {
        echo "A --project install needs a CLAUDE.md at the repo root."
        echo
        echo "If this is an EXISTING project, the quickest path is:"
        echo
        echo "    claude /init"
        echo
        echo "If this is a BRAND-NEW project, start Claude Code with this goal to"
        echo "build a CLAUDE.md interactively, then re-run this installer:"
        echo
        echo "    claude \"<the prompt below>\""
        echo
        echo "----- bootstrap prompt -----"
        printf '%s\n' "$BOOTSTRAP_PROMPT"
        echo "----------------------------"
        echo
        echo "Or install personally instead — no CLAUDE.md needed now:"
        echo
        echo "    bash -c \"\$(curl -fsSL $REPO_URL/install)\""
    }

    if ! command -v claude >/dev/null 2>&1; then
        echo "Error: CLAUDE.md not found, and the 'claude' CLI is not on PATH."
        echo
        print_bootstrap_help
        exit 1
    fi

    if [ -n "$CLAUDECODE" ]; then
        echo "No CLAUDE.md found, and you are already in a Claude Code session."
        echo "Run this prompt right here to build one, then re-run the installer:"
        echo
        echo "----- bootstrap prompt -----"
        printf '%s\n' "$BOOTSTRAP_PROMPT"
        echo "----------------------------"
        exit 0
    fi

    if [ ! -t 0 ]; then
        echo "Error: CLAUDE.md not found (non-interactive shell, not bootstrapping)."
        echo
        print_bootstrap_help
        exit 1
    fi

    echo "No CLAUDE.md found in $(pwd). This looks like a brand-new project."
    printf 'Set one up now with Claude Code? [Y/n] '
    read -r reply
    case "$reply" in
        [Nn]*)
            echo
            echo "Skipped. To bootstrap later:"
            echo
            print_bootstrap_help
            exit 0
            ;;
    esac
    echo "Launching Claude Code to build your CLAUDE.md..."
    exec claude "$BOOTSTRAP_PROMPT"
fi

# Warn about the precedence trap rather than silently shadowing.
# Skill precedence is enterprise > personal > project, so a personal copy WINS
# over a project copy of the same name. Installing personally while a project
# copy exists means the project's version is silently overridden.
if [ "$SCOPE" = "user" ] && [ -d ".claude/skills/workforce" ]; then
    echo "Note: this project already has a vendored copy at .claude/skills/workforce."
    echo "      Skill precedence is personal > project, so the copy being installed"
    echo "      now will SHADOW it in this project. Run '/workforce verify' to see"
    echo "      which copy is active, or remove one of them."
    echo
fi

echo "Installing to $SKILL_DIR"

# Download the shared manifest, then every file it lists.
# Manifest format: optional flag ("keep" = fetch only if absent,
# "hook" = chmod +x after fetch) followed by the repo-relative path.
echo "Downloading workforce..."
MANIFEST_TMP="$(mktemp)"
trap 'rm -f "$MANIFEST_TMP"' EXIT
curl -fsSL "$REPO_URL/manifest.txt" -o "$MANIFEST_TMP"

while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
        ''|\#*) continue ;;
    esac

    flag=""
    path="$line"
    case "$line" in
        "keep "*) flag="keep"; path="${line#keep }" ;;
        "hook "*) flag="hook"; path="${line#hook }" ;;
    esac

    dest="$SKILL_DIR/${path#workforce/}"

    if [ "$flag" = "keep" ] && [ -f "$dest" ]; then
        echo "Keeping existing $(basename "$dest") (preserving your edits)..."
        continue
    fi

    mkdir -p "$(dirname "$dest")"
    curl -fsSL "$REPO_URL/$path" -o "$dest"

    if [ "$flag" = "hook" ]; then
        chmod +x "$dest"
    fi
done < "$MANIFEST_TMP"

# Configure the delegation contract and the permissions the org needs.
#
# CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH is written EXPLICITLY even though 3 is the
# default: the three-tier org (CEO -> Lead -> IC) is a *contract* with that number,
# and `/workforce verify` reconciles against it. A host that lowered the value must
# fail loudly rather than silently flattening the org.
#
# CLAUDE_CODE_MAX_SUBAGENTS_PER_SESSION is deliberately NOT written. That cap
# cannot be disabled, and configuring it would imply a control we do not have.
#
# `Agent` in permissions.allow is not optional. Without it every single delegation
# raises a prompt, and an org that prompts on every hop is unusable. At user scope
# these land in ~/.claude/settings.json and therefore apply to every project on
# this machine — which is the point of a personal install, and is announced below.
echo "Configuring settings in $SETTINGS_FILE..."
if [ "$SCOPE" = "user" ]; then
    echo "  (user scope — these apply to every project on this machine)"
fi
if command -v python3 &>/dev/null; then
    SETTINGS_FILE="$SETTINGS_FILE" python3 -c "
import json, os

p = os.environ['SETTINGS_FILE']
d = json.load(open(p)) if os.path.exists(p) else {}
changed = False

env_vars = {'CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH': '3'}
for k, v in env_vars.items():
    if d.get('env', {}).get(k) != v:
        d.setdefault('env', {})[k] = v
        changed = True
        print(f'  Set {k}={v}')
    else:
        print(f'  {k} already set to {v}')

# Delegation + coordination tools the org depends on, plus research tools.
org_tools = [
    'Agent',
    'SendMessage',
    'TaskCreate',
    'TaskUpdate',
    'TaskList',
    'TaskGet',
    'WebSearch',
    'WebFetch',
]
allow = d.setdefault('permissions', {}).setdefault('allow', [])
for tool in org_tools:
    if tool not in allow:
        allow.append(tool)
        changed = True
        print(f'  Added {tool} to permissions.allow')
    else:
        print(f'  {tool} already in permissions.allow')

if changed:
    parent = os.path.dirname(p)
    if parent:
        os.makedirs(parent, exist_ok=True)
    json.dump(d, open(p, 'w'), indent=2)
    print(f'  Settings saved to {p}')
"
else
    echo "  Warning: python3 not found. Add these to $SETTINGS_FILE manually:"
    echo '  { "env": { "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "3" },'
    echo '    "permissions": { "allow": ["Agent", "SendMessage", "TaskCreate", "TaskUpdate",'
    echo '                               "TaskList", "TaskGet", "WebSearch", "WebFetch"] } }'
fi

echo
echo "Installation complete ($SCOPE scope)."
echo
echo "IMPORTANT: restart Claude Code before running the audit."
echo "Claude Code discovers agent definitions at startup and does NOT reload them"
echo "mid-session. Employees the audit hires are unreachable until you restart."
echo
if [ "$SCOPE" = "user" ]; then
    echo "This install serves every project on this machine. Each project gets its"
    echo "own separate company: employees in its .claude/agents/, and its config,"
    echo "org chart, and personnel records in its .claude/workforce/."
    echo
    echo "Cowork sees this install too, as long as it is in code mode."
    echo
    echo "For a repo worked on REMOTELY (a session that only clones the repo) or"
    echo "shared with collaborators, run /workforce vendor from inside that repo"
    echo "to copy the skill into it."
    echo
fi
echo "Then, from inside a project:"
echo "    /workforce audit          Survey the project and build its org"
echo "    /org <describe a task>    Hand work to the right employee"
echo "    /workforce roster         Who works here, on which model"
echo "    /workforce budget         Delegation depth and spawn-cap accounting"
echo
