{
  "hooks": {
    "Stop": [
      { "hooks": [ { "type": "command", "command": "\"$HOME/.claude/skills/workforce/bin/wf-commitments\"" } ] },
      { "hooks": [ { "type": "command", "command": "\"$HOME/.claude/skills/workforce/bin/wf-turn-ledger\"" } ] },
      { "hooks": [ { "type": "command", "command": "\"$HOME/.claude/skills/workforce/bin/wf-widen\"" } ] }
    ],
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "\"$HOME/.claude/skills/workforce/bin/wf-commitments\"" } ] }
    ],
    "SubagentStop": [
      { "hooks": [ { "type": "command", "command": "\"$HOME/.claude/skills/workforce/bin/wf-turn-ledger\"" } ] },
      { "hooks": [ { "type": "command", "command": "\"$HOME/.claude/skills/workforce/bin/wf-widen\"" } ] }
    ],
    "PostToolUse": [
      { "matcher": "Edit|Write",
        "hooks": [ { "type": "command", "command": "\"$HOME/.claude/skills/workforce/bin/wf-protect-directives\"" } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "\"$HOME/.claude/skills/workforce/bin/wf-task-tag\"" } ] }
    ]
  }
}
