{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/cfg-a/skills/workforce/bin/wf-plain-guard\""
          },
          {
            "type": "command",
            "command": "\"/nonexistent-wf-fixture/.claude/skills/workforce/bin/wf-budget-guard\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"/nonexistent-wf-fixture/hooks/gone.sh\""
          },
          {
            "type": "command",
            "command": "jq -r .x"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/skills/workforce/bin/wf-widen\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/cfg-a/skills/workforce/bin/wf-protect-directives\""
          }
        ]
      }
    ]
  }
}
