{
  "census-badjson": {
    "exit": 2,
    "script": "wf-census",
    "want": [
      "unreadable"
    ]
  },
  "census-clean": {
    "exit": 0,
    "not": [
      "! "
    ],
    "script": "wf-census",
    "want": [
      "collisions  0 live"
    ]
  },
  "census-collision": {
    "exit": 2,
    "script": "wf-census",
    "want": [
      "collisions  1 live",
      "dup"
    ]
  },
  "census-namespace": {
    "exit": 0,
    "script": "wf-census",
    "want": [
      "namespace   1 in-skill",
      "collisions  0 live"
    ]
  },
  "conform-adopted": {
    "exit": 0,
    "not": [
      "\u2717 "
    ],
    "script": "wf-conform",
    "want": [
      "1 adopted (exempt)",
      "Agent(...)` allowlist"
    ]
  },
  "conform-governed-ok": {
    "exit": 0,
    "script": "wf-conform",
    "want": [
      "1 governed",
      "0 failed"
    ]
  },
  "conform-no-ceiling": {
    "exit": 1,
    "script": "wf-conform",
    "want": [
      "disallowedTools: Agent"
    ]
  },
  "context-empty": {
    "exit": 0,
    "script": "wf-context",
    "want": [
      "0 employees"
    ]
  },
  "context-preload": {
    "exit": 0,
    "script": "wf-context",
    "want": [
      "preload: opx",
      "unmeasured"
    ]
  },
  "hook-badstdin": {
    "exit": 0,
    "script": "wf-protect-directives",
    "stdin_raw": "not json",
    "want": [
      "NOT verified"
    ]
  },
  "hook-unprotected": {
    "exit": 0,
    "script": "wf-protect-directives",
    "stdin_file": ".claude/agents/e.md",
    "want": [
      "UNPROTECTED"
    ]
  }
}