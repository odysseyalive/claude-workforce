{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/skills/workforce/bin/wf-plain-guard\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"${TREE}/cfg-old/skills/workforce/bin/wf-protect-directives\""
          }
        ]
      }
    ]
  }
}
