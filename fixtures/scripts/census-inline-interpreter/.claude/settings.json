{
  "hooks": {
    "PreToolUse": [
      { "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "node -e \"require('./lib/x.js')\"" }] },
      { "matcher": "Write",
        "hooks": [{ "type": "command", "command": "bash -ec 'test -f references/a.md'" }] },
      { "matcher": "Edit",
        "hooks": [{ "type": "command", "command": "python3 -W ignore hooks/live.py" }] }
    ]
  }
}
