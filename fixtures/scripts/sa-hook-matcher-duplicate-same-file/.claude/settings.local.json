{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Artifact",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/skills/workforce/bin/wf-artifact-style"
          }
        ]
      },
      {
        "matcher": "^(?:Artifact|mcp__.+[Dd]ocs__batch)$",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/skills/workforce/bin/wf-artifact-style"
          }
        ]
      }
    ]
  }
}
