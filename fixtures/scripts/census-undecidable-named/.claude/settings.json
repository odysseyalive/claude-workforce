{
  "hooks": {
    "Stop": [
      { "hooks": [{ "type": "agent", "prompt": "Judge the turn.", "timeout": 60 }] }
    ],
    "PreToolUse": [
      { "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "bash -c 'exit 0'" }] },
      { "matcher": "Write",
        "hooks": [{ "type": "command", "command": "\"$WF_UNSET_HOOK_HOME/hooks/guard.sh\"" }] }
    ]
  }
}
