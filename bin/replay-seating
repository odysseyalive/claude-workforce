#!/usr/bin/env python3
"""replay-seating — which jurors each Stop in a transcript seats, before and after.

REPORT ONLY. It writes nothing: no tag, no flag, no ledger, no bytecode. The session's
issue ledger is READ, from the project the transcript's rows name, because an injected
turn's docket comes from it. The jury itself is not run: this is the seating decision,
`wf-widen`'s half, never the model's verdict.

  before  `wf-task-tag`, `wf-widen` and `wf-turn-ledger` as they stand at `--before <rev>`
          (default HEAD; `git show`, run from memory). A release number such as `1.85.2`
          names the commit that set `WORKFORCE-VERSION: 1.85.2` in `version.md`.
  after   the same three files in the working tree.
Both sides run one pipeline (`docket`), in the order the hooks apply it: the turn's own
words, the message a peer's pointer names, the ask an injected turn serves (`served_ask`),
a message delivered mid-turn merged in, and, on a side whose `wf-task-tag` has it, the open
work the turn carries (`carried_docket`). The seating is that side's `wf-widen.seating`: a
docket from the user's words always seats, a claim-only one 1 in `WF_AUDIT_SAMPLE`, and a
turn with none is blind-sampled 1 in `WF_BLIND_SAMPLE`.

Usage
    bin/replay-seating TRANSCRIPT.jsonl                 # every judged Stop, then totals
    bin/replay-seating TRANSCRIPT.jsonl --stops 1404,1581
    bin/replay-seating --summary T1.jsonl T2.jsonl ...  # totals only, over many
    bin/replay-seating --before 1.85.2 TRANSCRIPT.jsonl # before = that release, not HEAD

A Stop is named by the line number of its `stop_hook_summary` row. A continuation Stop (the
turn after a `Stop hook feedback` row) is not judged live, so it is listed as such.
What it cannot see, and says so: `background_tasks` (so a declared hold is not applied),
and the asks checklist hand-off. THE CARRIED ISSUES ARE A LOWER BOUND: the ledger is read as
it stands now, so the issues a Stop carries are those opened before its turn that are still
open today, and an issue closed since is not counted.
"""

import hashlib
import importlib.machinery
import importlib.util
import json
import os
import subprocess
import sys
import types

sys.dont_write_bytecode = True
ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
BIN = os.path.join(ROOT, "workforce", "bin")


def _load(name):
    path = os.path.join(BIN, name)
    loader = importlib.machinery.SourceFileLoader(name.replace("-", "_"), path)
    spec = importlib.util.spec_from_loader(loader.name, loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


def resolve_rev(rev):
    """The commit `rev` names, or None. A bare release number (`1.85.2`) is the commit that
    SET `WORKFORCE-VERSION: 1.85.2` in `version.md`, the oldest of the commits whose diff
    adds or removes that line; anything else is passed to git as it is.

    WHY: 'before' was HEAD, so once a change was committed, before and after were the same
    files and every replay of it read "added 0" (2026-11-09, the 1.86.2 checksum batch)."""
    if all(p.isdigit() for p in rev.split(".")) and rev.count(".") == 2:
        out = subprocess.run(
            ["git", "-C", ROOT, "log", "--reverse", "--format=%H",
             "-G", r"^WORKFORCE-VERSION: " + rev.replace(".", r"\.") + "$",
             "--", "workforce/references/version.md"],
            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL).stdout.decode().split()
        return out[0] if out else None
    out = subprocess.run(["git", "-C", ROOT, "rev-parse", "--verify", "--quiet",
                          rev + "^{commit}"], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    return out.stdout.decode().strip() or None


def _load_rev(name, rev):
    """`name` as it stands at commit `rev`, executed from memory: nothing is written."""
    src = subprocess.run(["git", "-C", ROOT, "show", f"{rev}:workforce/bin/{name}"],
                         check=True, stdout=subprocess.PIPE).stdout.decode("utf-8")
    mod = types.ModuleType(name.replace("-", "_") + "_before")
    mod.__file__ = os.path.join(BIN, name)
    exec(compile(src, f"{rev[:12]}:{name}", "exec"), mod.__dict__)
    return mod


W = _load("wf-widen")
TT, TL = W.TT, W.TL
NEW = (TT, W)
OLD = None


def load_before(rev):
    """Set the 'before' side to the three scripts at `rev`. Each module's siblings are
    replaced with the same revision's, so no half of 'before' runs today's code."""
    global OLD
    old_w = _load_rev("wf-widen", rev)
    old_w.TT = _load_rev("wf-task-tag", rev)
    old_w.TL = _load_rev("wf-turn-ledger", rev)
    OLD = (old_w.TT, old_w)
TURN_END = ('"stop_hook_summary"', '"turn_duration"')


def _rows(lines, lo, hi):
    for i in range(lo, hi):
        try:
            yield i, json.loads(lines[i])
        except ValueError:
            continue


def turn_start(lines, k):
    """The index of the first row of the turn the Stop at index `k` ends."""
    for i in range(k - 1, -1, -1):
        if any(m in lines[i] for m in TURN_END) and '"type":"system"' in lines[i]:
            return i + 1
    return 0


def turn_of(lines, k):
    """(opener text, opener typed?, reply, mid-turn texts) for the Stop at index `k`."""
    lo = turn_start(lines, k)
    opener, typed, reply, mid, rows = None, False, "", [], []
    for i, row in _rows(lines, lo, k):
        rows.append(row)
        if row.get("type") == "user":
            text = TT._row_text(row)
            if not text or text.lstrip().startswith("<system-reminder>"):
                continue
            if not row.get("isMeta"):
                opener, typed = text, True
            elif not typed and opener is None:
                opener = text
        elif row.get("type") == "attachment":
            a = row.get("attachment") or {}
            if a.get("type") == "queued_command" and isinstance(a.get("prompt"), str):
                mid.append(a["prompt"])
        elif row.get("type") == "assistant":
            c = (row.get("message") or {}).get("content")
            t = [b.get("text") for b in c or [] if isinstance(b, dict)
                 and b.get("type") == "text" and b.get("text")] if isinstance(c, list) else []
            if t:
                reply = t[-1]
    return opener, typed, reply, mid, rows


def ask_of(text, T=TT):
    peer = T.peer_request(text or "")
    return peer[0] if peer else (text or "")


def opened_at(lines, led):
    """Issue id -> index of the first user row, or delivered message, carrying its words."""
    want = [(i.get("id"), " ".join(i["prompt"].split())[:200]) for i in led.get("issues", [])
            if isinstance(i, dict) and isinstance(i.get("prompt"), str) and i["prompt"].strip()]
    at = {}
    for n, row in _rows(lines, 0, len(lines)):
        if not want:
            break
        a = row.get("attachment") if row.get("type") == "attachment" else None
        text = TT._row_text(row) if row.get("type") == "user" else \
            a.get("prompt") if isinstance(a, dict) and isinstance(a.get("prompt"), str) else None
        flat = " ".join((text or "").split())
        for iid, p in [w for w in want if flat and w[1] in flat]:
            at[iid] = n
            want.remove((iid, p))
    return at


def carried_before(led, opened, lo):
    """The ledger as a Stop's submit saw it, approximately: the issues opened before its turn."""
    return {"issues": [i for i in led.get("issues", []) if isinstance(i, dict)
                       and opened.get(i.get("id"), lo) < lo]}


def counts_at(path, lines, k):
    real = TL._read_lines
    TL._read_lines = lambda _p: lines[:k]
    try:
        return TL.turn_counts({"transcript_path": path})
    finally:
        TL._read_lines = real


def trips_of(reply, L=None):
    """The reply-claim trips, by one side's `wf-turn-ledger` (`L`, default the working tree)."""
    L = L or TL
    masked = L.mask_code(reply or "")
    trips = []
    if L.ABSENCE.search(masked):
        trips.append("absence")
    if L.UNIVERSAL.search(L._QUOTED.sub(lambda m: " " * len(m.group(0)), masked)):
        trips.append("universal")
    return trips


def _rate(name, default):
    try:
        return int(os.environ.get(name) or default)
    except ValueError:
        return default


def decide(V, applicable, gate, counts, reply, ask, tagged, incident):
    """Seats as (outcome, jurors). Shared shape for both sides."""
    if not applicable:
        blind = _rate("WF_BLIND_SAMPLE", 20)
        rate = max(1, blind // 4) if counts[5] else blind
        if blind > 0 and ask.strip() and reply and \
                hashlib.sha256(reply.encode("utf-8")).digest()[1] % rate == 0:
            return "blind", ["smell", "intuition"]
        return "none", []
    unopened = V.senses(counts, applicable)[0]
    unopened = [u for u in unopened if u in gate]
    if unopened:
        return "block", sorted(applicable)
    rate = _rate("WF_AUDIT_SAMPLE", 5)
    sampled = rate > 0 and hashlib.sha256(reply.encode("utf-8")).digest()[0] % rate == 0
    if incident or tagged:
        sampled = True
    return ("seated", sorted(applicable)) if sampled else ("none", [])


def docket(M, payload, led, past, lines, k, opener, mid, rows):
    """(hits, via, ask) for the Stop at index `k`, by one side's `(wf-task-tag, wf-widen)`."""
    T, V = M
    ask = ask_of(opener, T)
    hits, via = T.classify(ask), ""
    if not hits and T.peer_request(opener or ""):
        body = V.relayed_body(rows, ask)
        if body:
            hits = [dict(h, relayed=True) for h in T.classify(body)]
            via = "message read this turn"
    if not hits and opener and T.INJECTED.search(opener):
        served = T.served_ask(payload, led, opener, lines[:k])
        if served:
            hits = [dict(h, inherited=True) for h in T.classify(served["prompt"])]
            via = f"{served.get('issue') or '-'} via {served['via']}"
            ask = served["prompt"]
    for text in mid:
        if not T.INJECTED.search(text):
            hits += [h for h in T.classify(ask_of(text, T))
                     if h["kind"] not in {x["kind"] for x in hits}]
    if not hits and hasattr(T, "carried_docket"):
        car = T.carried_docket(past)
        if car:
            hits = car["hits"]
            via = (via + "; " if via else "") + "carried " + ",".join(
                i["issue"] for i in car["issues"])
    return hits, via, ask


def seat(M, docketed, counts, reply, opener=None):
    """(outcome, jurors) for one side, from its `docket` result. A side whose `wf-widen` has
    `claim_trips` reads the opener as testimony and seats its seat-only trips every time
    (`always_seated`); an older side trips as it did then."""
    hits, _via, ask = docketed
    V = M[1]
    trips = V.claim_trips(reply, opener) if hasattr(V, "claim_trips") else trips_of(reply, V.TL)
    applicable, gate, why, incident = V.seating(trips, hits)
    tagged = V.always_seated(why) if hasattr(V, "always_seated") else \
        any(t.startswith("TAG:") for t, _s, _r in why)
    return decide(M[1], applicable, gate, counts, reply, ask, tagged, incident)


def replay(path, want=None, quiet=False):
    with open(path, "rb") as fh:
        lines = fh.read().decode("utf-8", "replace").splitlines()
    sid = os.path.basename(path)[:-len(".jsonl")]
    cwd = next((r.get("cwd") for _i, r in _rows(lines, 0, min(len(lines), 200))
                if isinstance(r.get("cwd"), str)), None)
    payload = {"session_id": sid, "transcript_path": path, "cwd": cwd}
    led = TT.load_ledger(payload) if cwd else {"issues": []}
    opened = opened_at(lines, led)
    tot = {"stops": 0, "judged": 0, "before": 0, "after": 0, "injected": 0}
    for k, line in enumerate(lines):
        if '"stop_hook_summary"' not in line:
            continue
        tot["stops"] += 1
        n = k + 1
        opener, typed, reply, mid, rows = turn_of(lines, k)
        # A CONTINUATION has no opener of its own: the feedback row that restarted it was
        # written before the previous Stop's summary row.
        cont = not opener or opener.lstrip().startswith("Stop hook feedback")
        if opener and TT.INJECTED.search(opener) and not cont:
            tot["injected"] += 1
        if want and n not in want:
            continue
        if cont or not reply:
            if not quiet:
                print(f"{n:>6}  {'continuation' if cont else 'no reply'} — not judged")
            continue
        tot["judged"] += 1
        counts = counts_at(path, lines, k) or (0, [], 0, 0, 0, 0, None)
        past = carried_before(led, opened, turn_start(lines, k))
        bd = docket(OLD, payload, led, past, lines, k, opener, mid, rows)
        ad = docket(NEW, payload, led, past, lines, k, opener, mid, rows)
        (b, bj), (a, aj) = (seat(OLD, bd, counts, reply, opener),
                            seat(NEW, ad, counts, reply, opener))
        bk, ak, via = [h["kind"] for h in bd[0]], [h["kind"] for h in ad[0]], ad[1]
        tot["before"] += b != "none"
        tot["after"] += a != "none"
        if not quiet:
            head = " ".join((opener or "").split())[:60]
            print(f"{n:>6}  before {b:<6} {'/'.join(bj) or '-':<22} kinds {','.join(bk) or '-':<14}"
                  f" | after {a:<6} {'/'.join(aj) or '-':<22} kinds {','.join(ak) or '-'}"
                  f"{'  [' + via + ']' if via else ''}\n        opened by: {head}")
    return tot


def main(argv):
    summary = "--summary" in argv
    argv = [a for a in argv if a != "--summary"]
    before = "HEAD"
    if "--before" in argv:
        i = argv.index("--before")
        before = argv[i + 1] if i + 1 < len(argv) else ""
        del argv[i:i + 2]
    # `--root DIR`: relative transcript paths are read from DIR (the fixture harness).
    if "--root" in argv:
        i = argv.index("--root")
        base = argv[i + 1] if i + 1 < len(argv) else "."
        del argv[i:i + 2]
        argv = [a if os.path.isabs(a) or a.startswith("-") else os.path.join(base, a)
                for a in argv]
    # A REV IS NEVER AN OPTION: `git show -x:…` would read it as a flag (CWE-88).
    rev = resolve_rev(before) if before and not before.startswith("-") else None
    if not rev:
        print(f"replay-seating: --before {before!r} names no commit (a git rev, or a release "
              f"number that `WORKFORCE-VERSION:` in version.md was set to)", file=sys.stderr)
        return 2
    load_before(rev)
    if not hasattr(OLD[1], "seating"):
        print(f"replay-seating: {before} ({rev[:12]}) predates `wf-widen.seating`, the one "
              f"definition both sides are replayed through; pick a later revision",
              file=sys.stderr)
        return 2
    print(f"before = {before} ({rev[:12]})")
    want = None
    if "--stops" in argv:
        i = argv.index("--stops")
        want = {int(x) for x in argv[i + 1].split(",") if x.strip()}
        del argv[i:i + 2]
    if not argv:
        print(__doc__)
        return 2
    grand = {"stops": 0, "judged": 0, "before": 0, "after": 0, "injected": 0}
    for path in argv:
        tot = replay(path, want, quiet=summary)
        for key in grand:
            grand[key] += tot[key]
    s, j = grand["stops"], grand["judged"] or 1
    print(f"\n{len(argv)} transcript(s), {s} Stops, {grand['injected']} opened by injected "
          f"text, {grand['judged']} judged")
    print(f"seated before {grand['before']} ({100 * grand['before'] / j:.1f} per 100 judged)"
          f" · after {grand['after']} ({100 * grand['after'] / j:.1f} per 100 judged)"
          f" · added {grand['after'] - grand['before']} "
          f"({100 * (grand['after'] - grand['before']) / (s or 1):.1f} per 100 Stops)")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
