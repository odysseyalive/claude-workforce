# A traceback is ALWAYS a failure, whatever the exit code and whatever the golden says. Both
# defects this file exists for printed one: a golden recorded over a crash would make the
# crash the expected output, which is the single worst thing a regression corpus can do.
CRASH_RX = re.compile(r"^Traceback \(most recent call last\):|^\w*Error: |NameError", re.M)


def _bail(msg):
    sys.stderr.write("corpus: %s\n" % msg)
    raise SystemExit(2)


def snapshots():
    """Snapshot names, sorted. A directory without a `tree/` is not one."""
    if not os.path.isdir(CORPUS):
        return []
    return sorted(n for n in os.listdir(CORPUS)
                  if os.path.isdir(os.path.join(CORPUS, n, TREE)))


def normalise(text, tree, name, config=None, sandbox=None, wf_version=None):
    """Mask every field that changes between two runs of the same unchanged tree.

    A golden carrying a timestamp, a run id or the throwaway tree's path diffs against itself
    on the next run, and a corpus that always reports a difference reports nothing.

    **LONGEST PATH FIRST, and the order is the whole correctness of this function.** The
    throwaway install sits inside the throwaway HOME, and the copied tree sits beside it, so
    masking the home first rewrites the prefix of both and leaves their tails behind as noise
    that still diffs. Each entry below is a strict superpath of the ones after it.
    """
    real_home = os.path.expanduser("~")
    subs = []
    if config:
        subs += [(config, "<INSTALL>")]
    if tree:
        subs += [(tree, "<TREE>")]
    if sandbox:
        subs += [(sandbox, "<SANDBOX>")]
    subs += [(os.path.join(CORPUS, name), "<SNAP>"), (ROOT, "<REPO>"),
             (real_home, "<HOME>")]
    for src, dst in subs:
        if not src:
            continue
        # Both spellings: a script may print the path it was handed or the resolved one, and on
        # a machine where /home is a link or /tmp is a symlink those differ.
        for form in (os.path.realpath(src), src):
            text = text.replace(form, dst)
    # THE CHECKOUT'S OWN RELEASE NUMBER, masked to a placeholder. MEASURED on the 1.72.0
    # release: `wf-conform` prints `installed 1.71.1` in the golden and `installed 1.72.0`
    # after the bump, so `bin/check` failed the corpus on a real org with no behaviour change —
    # **and a version bump is the exact moment this suite runs.** Same class as the
    # `CLAUDE_EFFORT` leak: a value that belongs to the environment of the run rather than to
    # the tree under test. Read from `version.md` at run time, so a scratch worktree at any
    # version normalises to the same text.
    #
    # A VERSION A PROJECT STAMPED IS REAL DATA AND STAYS. `stamped 1.70.0` is what that
    # handbook was authored against; it does not move when this checkout bumps, and masking it
    # would stop the golden tracking it. Only the checkout's CURRENT number is replaced, so the
    # two are distinguished by value — which is what they are. The one collision is a project
    # whose stamp happens to equal the version being developed: that stamp is masked too,
    # costing a little precision in the one case where the two numbers are genuinely
    # indistinguishable, and never producing a false fire.
    #
    # THE BOUNDARIES ARE THE FIDDLY PART, and the first spelling got them wrong in a way the
    # worktree test caught immediately. `(?![\w.])` refuses a version followed by ANY period, so
    # `installed 1.72.0` in a summary line was masked and `the installed release is 1.72.0.` —
    # the same fact, ending a sentence — was not. The trailing lookahead therefore blocks a word
    # character, and a period only when a DIGIT follows it, which is what stops `1.7` rewriting
    # the front of `1.72.0` while a sentence-ending period passes. The lookbehind blocks a digit
    # or a dot rather than any word character, so a `v`-prefixed form is still masked and
    # `11.72.0` is still not.
    if wf_version:
        text = re.sub(r"(?<![\d.])" + re.escape(wf_version) + r"(?![\w])(?!\.\d)",
                      "<WF-VERSION>", text)
    # A run id, an archive stamp and a backup name are all this shape.
    text = re.sub(r"\d{8}T\d{6}Z", "<STAMP>", text)
    text = re.sub(r"\d{8}T\d{4}Z", "<STAMP>", text)
    text = re.sub(r"\b\d{4}-\d{2}-\d{2}\b", "<DATE>", text)
    text = re.sub(r"\b\d{2}:\d{2}:\d{2}\b", "<TIME>", text)
    # Elapsed seconds a report prints about itself. The measurement is the tree, not the clock.
    text = re.sub(r"\b\d+\.\d+s\b", "<ELAPSED>", text)
    return "\n".join(l.rstrip() for l in text.splitlines()) + "\n"


# ── the environment every case runs under, and nothing else ───────────────────────────────
#
# A GOLDEN THAT MOVES WITH THE SESSION IS NOT A GOLDEN, and this was measured the first time
# anyone ran the corpus from a second session. `wf-preflight` reports the env vars that could
# override an employee's frontmatter, so `CLAUDE_EFFORT=high` went into the golden and
# `CLAUDE_EFFORT=medium` came out of the next run: `corpus run` FAILED with no code change,
# which is a known false fire, and a known false fire is not shippable.
#
# THE FIX IS THE CLASS, NOT THE FIELD. Inheriting `os.environ` and deleting the one variable
# that bit would leave `CLAUDE_CODE_SUBAGENT_MODEL`, `ANTHROPIC_MODEL`, a `TZ` that shifts every
# printed date by a day, and a `LANG` that changes how a locale-aware sort orders rows — each a
# diff nobody changed any code to cause. So the env is BUILT rather than filtered: an allow-list
# of what a subprocess genuinely needs, with everything session-shaped pinned.
#
# PYTHONHASHSEED IS DELIBERATELY NOT PINNED. Pinning it would make set-iteration order stable
# and hide exactly the defect this corpus found on its first run — `wf-census` printed its rows
# in `os.walk` order, and two runs of one unchanged tree swapped two of them. A fixed seed turns
# that from a caught regression into a silent one.
ENV_KEEP = ("PATH", "TMPDIR", "SYSTEMROOT", "COMSPEC")
ENV_PIN = {"TZ": "UTC", "LANG": "C.UTF-8", "LC_ALL": "C.UTF-8", "LANGUAGE": "",
           "COLUMNS": "80", "TERM": "dumb", "NO_COLOR": "1"}


def scrubbed_env(home, config):
    """The complete environment a case runs under. Nothing is inherited that is not named here.

    `CLAUDE_CONFIG_DIR` and `HOME` point at the throwaway install; every other `CLAUDE_*` and
    `ANTHROPIC_*` variable is simply absent, which is a state a script must handle anyway — an
    env var it reads is one a fresh host may not have set.
    """
    env = {k: os.environ[k] for k in ENV_KEEP if k in os.environ}
    env.update(ENV_PIN)
    env["HOME"] = home
    env["CLAUDE_CONFIG_DIR"] = config
    return env


def run_case(case, tree, name, home, config, sandbox):
    """`(label, rc, normalised_output, crashed)` for one case against the throwaway tree."""
    label, script, args, want_rc, _cite = case
    argv = [sys.executable, os.path.join(BIN, script),
            *[a.replace("<TREE>", tree) for a in args]]
    env = scrubbed_env(home, config)
    try:
        r = subprocess.run(argv, capture_output=True, text=True, timeout=300, env=env)
        out, rc = r.stdout + r.stderr, r.returncode
    except subprocess.TimeoutExpired:
        return label, None, "TIMEOUT after 300s\n", True  # not normalised: no output to mask
    except OSError as exc:
        return label, None, "could not run: %s\n" % exc, True
    crashed = bool(CRASH_RX.search(out)) or rc not in want_rc
    return label, rc, normalise(out, tree, name, config, sandbox, _version()), crashed


def materialise_links(src, dest):
    """Replace a link that leaves `.claude/` but stays inside the project with its content.

    Returns `[(relpath, target)]` for each one replaced.

    MEASURED on the first corpus run ever taken. `university` registers two employees as
    symlinks into a SIBLING project — `.claude/agents/comms-drafter.md ->
    ../../pythom-space/.claude/agents/comms-drafter.md`. Copied as links, they dangle in the
    snapshot, and `wf-census`, `wf-context` and `wf-conform` all exited 2 with `unreadable …
    FileNotFoundError`. That is a snapshot artefact, not a finding: on the real tree the file
    is there and every one of them exits 0. A corpus that reproduces a DIFFERENT tree
    measures nothing, and worse, it would have taught this suite that three scripts crash.

    THE RULE IS NARROW ON PURPOSE, and the narrowness is a real test. A link is materialised
    only when its target resolves inside the project root and outside `.claude/`. A link that
    stays inside `.claude/` is left alone — its relative path resolves in the copy exactly as
    it did in the original. And a link that ESCAPES the project root is left alone too:
    `university` carries `.claude/workforce/negatives/ops-lead-escape-link -> /etc/hostname`,
    a negative fixture whose whole subject is a link that points out of the tree. Resolving
    that one would turn the fixture into an ordinary file and silence the assertion it
    exists for.
    """
    src_root, claude = os.path.realpath(src), os.path.realpath(os.path.join(src, ".claude"))
    lifted = []
    for d, _dirs, files in os.walk(dest):
        for n in files + _dirs:
            p = os.path.join(d, n)
            if not os.path.islink(p):
                continue
            # Resolve against the ORIGINAL location: a relative link copied into the snapshot
            # points at the snapshot's own layout, which is not what it named.
            rel = os.path.relpath(p, dest)
            orig = os.path.join(src, rel)
            tgt = os.path.realpath(os.path.join(os.path.dirname(orig), os.readlink(p)))
            inside_project = tgt == src_root or tgt.startswith(src_root + os.sep)
            inside_claude = tgt == claude or tgt.startswith(claude + os.sep)
            if not inside_project or inside_claude or not os.path.isfile(tgt):
                continue
            os.unlink(p)
            shutil.copy2(tgt, p)
            lifted.append((rel, os.path.relpath(tgt, src_root)))
    return lifted


def do_snapshot(paths):
    for p in paths:
        src = os.path.abspath(os.path.expanduser(p))
        if not os.path.isdir(os.path.join(src, ".claude")):
            _bail("%s holds no .claude/ — not a workforce project" % src)
        name = os.path.basename(src.rstrip(os.sep))
        dest = os.path.join(CORPUS, name, TREE)
        if os.path.exists(dest):
            shutil.rmtree(dest)
        os.makedirs(dest)
        # `.git` and `__pycache__` are excluded for the reason `bin/prove` excludes them: a
        # nested `.git` is not snapshot content, and a `.pyc` is never source.
        shutil.copytree(os.path.join(src, ".claude"), os.path.join(dest, ".claude"),
                        symlinks=True,
                        ignore=shutil.ignore_patterns(".git", "__pycache__", "*.pyc"))
        if os.path.isfile(os.path.join(src, "CLAUDE.md")):
            shutil.copy2(os.path.join(src, "CLAUDE.md"), os.path.join(dest, "CLAUDE.md"))
        lifted = materialise_links(src, dest)
        n = sum(len(f) for _d, _s, f in os.walk(dest))
        with open(os.path.join(CORPUS, name, PROV), "w", encoding="utf-8") as fh:
            fh.write("# corpus snapshot — %s\n\n"
                     "- source: `%s`\n- taken: %s\n- files: %d\n"
                     "- workforce: %s\n\n"
                     "LOCAL ONLY. `corpus/` is gitignored and `bin/check` asserts nothing "
                     "under it is tracked: this holds another project's own words, and this "
                     "repository is public.\n%s"
                     % (name, src, time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), n,
                        _version(),
                        ("\n## Links materialised\n\nEach left `.claude/` but stayed inside "
                         "the project, so a copied link would dangle (see "
                         "`materialise_links`).\n\n"
                         + "".join("- `%s` ← `%s`\n" % (r, t) for r, t in lifted))
                        if lifted else ""))
        print("snapshot %-24s %5d files from %s%s"
              % (name, n, src,
                 " · %d link(s) materialised" % len(lifted) if lifted else ""))
    print("\n%d snapshot(s) in corpus/ — `bin/corpus run` exercises them" % len(snapshots()))
    return 0


def _version():
    try:
        with open(os.path.join(ROOT, "workforce", "references", "version.md"),
                  encoding="utf-8") as fh:
            m = re.search(r"^WORKFORCE-VERSION:\s*(\S+)", fh.read(), re.M)
        return m.group(1) if m else "unknown"
    except OSError:
        return "unknown"


def do_list():
    names = snapshots()
    if not names:
        print("no snapshots. `bin/corpus snapshot <project-dir>` records one.")
        return 0
    for n in names:
        prov = os.path.join(CORPUS, n, PROV)
        head = ""
        if os.path.isfile(prov):
            with open(prov, encoding="utf-8") as fh:
                head = " · ".join(l.strip("- \n") for l in fh
                                  if l.startswith("- ")).replace("`", "")
        golden = os.path.join(CORPUS, n, GOLDEN)
        g = len(os.listdir(golden)) if os.path.isdir(golden) else 0
        print("  %-24s %2d golden(s)  %s" % (n, g, head))
    print("\n%d case(s), each citing where the audit makes the call:" % len(CASES))
    for label, script, cargs, rc, cite in CASES:
        print("  %-24s %-18s %-34s rc%s  %s"
              % (label, script, " ".join(a for a in cargs if a != "--root"),
                 "/".join(str(x) for x in rc), cite))
    return 0


def build_install():
    """A THROWAWAY HOME with a fresh install of THIS checkout: `(sandbox, home, config)`.

    THE OPERATOR'S HOME IS NOT AN INPUT, and leaving it as one made three cases diff against
    themselves. MEASURED while wiring this into `bin/check`, which runs with a temp `HOME`:
    `wf-census` counted the operator's own `~/.claude/agents/` and printed `image-validator: 2
    in-skill copies` that a temp-HOME run did not, and `wf-context` charged `3,853 B
    /home/francis/lab/CLAUDE.md` — a file in the directory ABOVE this repository, belonging to
    no project here. A golden that moves when the developer edits an unrelated file is not a
    golden. So every case runs under `HOME=<sandbox>/home`, whose only content is the install,
    and the throwaway copy lives inside it so the inherited-CLAUDE.md chain a spawn would pay
    for is the snapshot's own and nothing else.

    THE INSTALL SIDE HAS TO BE THIS CHECKOUT, and getting that wrong silenced the very case
    this corpus was built to catch. The first version pointed `CLAUDE_CONFIG_DIR` at the
    snapshot's own `.claude/`, reasoning that the operator's live install must not answer. It
    must not — but that assignment collapses personal and project scope onto one directory,
    so `install_dir` and `project_skill_dir` resolve to the SAME path and `--migrate` answered
    `no-copy · nothing to migrate` for all five kinds on a tree holding five copies. The
    golden recorded that, and a 1.70.0 checkout reproduced it exactly: a green case over a
    command that had done nothing.

    So the install is built the way `bin/dev-sandbox` builds one — `bin/sync --personal` into
    a `CLAUDE_CONFIG_DIR` under `$HOME`, per the 2026-09-09 directive that a dev-time test
    installs to a temporary place under the user's home and removes it afterwards. It comes
    from the checkout being tested, which is what makes a diff mean something: the scripts
    changed, or the corpus they ship changed, and both are the regression this looks for.
    """
    sandbox = os.path.join(os.path.expanduser("~"),
                           ".claude-workforce-corpus.%d" % os.getpid())
    if os.path.exists(sandbox):
        _bail("%s already exists; nothing was created or removed" % sandbox)
    home = os.path.join(sandbox, "home")
    config = os.path.join(home, ".claude")
    os.makedirs(os.path.join(config, "skills"))
    # THE INSTALL IS BUILT UNDER THE SAME SCRUBBED ENV as the cases run under. `bin/sync` reads
    # `CLAUDE_CONFIG_DIR` and writes the tree every case then resolves, so an install built under
    # session env is a golden that moves with the session one level further back.
    r = subprocess.run([sys.executable, os.path.join(ROOT, "bin", "sync"), "--personal"],
                       cwd=ROOT, env=scrubbed_env(home, config),
                       capture_output=True, text=True, timeout=600)
    if r.returncode != 0:
        shutil.rmtree(sandbox, ignore_errors=True)
        _bail("could not build the throwaway install (rc=%d): %s"
              % (r.returncode, (r.stdout + r.stderr).strip()[-400:]))
    return sandbox, home, config


def run_snapshot(name, todo, sandbox, home, config, accept, quiet, fails):
    """Run `todo` against a THROWAWAY copy of one snapshot. Returns (ran, accepted).

    The copy is removed in a `finally`, so a failing case, a traceback and a Ctrl-C all still
    clean up — the same unconditional-removal rule `bin/dev-sandbox` states, for the same
    reason: the thing being removed is 18 MB of somebody else's project.

    ONE COPY PER SNAPSHOT, and the cases run in DECLARED ORDER against it. Some display-mode
    calls still write a report of their own into `.claude/workforce/`, and an audit makes them
    in sequence on one tree, so this reproduces what the audit actually does. A copy per case
    would be more isolated and less faithful, and 27x the copying.
    """
    snap = os.path.join(CORPUS, name)
    # INSIDE THE THROWAWAY HOME, not inside `corpus/`. A spawn inherits every CLAUDE.md above
    # the project root (`wf-context`, platform.md fact 6), and a copy sitting in `corpus/`
    # inherits this repository's CLAUDE.md and the workspace one above it — two files with
    # nothing to do with the snapshot, both of which move.
    work = os.path.join(home, "work-%s" % name)
    if os.path.exists(work):
        _bail("%s already exists; nothing was created or removed" % work)
    gold_dir = os.path.join(snap, GOLDEN)
    os.makedirs(gold_dir, exist_ok=True)
    ran = accepted = 0
    try:
        shutil.copytree(os.path.join(snap, TREE), work, symlinks=True)
        for case in todo:
            ran += 1
            label, rc, out, crashed = run_case(case, work, name, home, config, sandbox)
            gold = os.path.join(gold_dir, label + ".out")
            have = None
            if os.path.isfile(gold):
                with open(gold, encoding="utf-8") as fh:
                    have = fh.read()
            if crashed:
                fails.append((name, label, "rc=%s%s" % (
                    rc, " · TRACEBACK" if CRASH_RX.search(out) else " · unexpected exit"),
                    out.strip().splitlines()[-6:]))
                continue
            if accept or have is None:
                with open(gold, "w", encoding="utf-8") as fh:
                    fh.write(out)
                accepted += 1
                if not quiet:
                    print("  %-9s %-24s %s" % ("RECORD" if have is None else "ACCEPT",
                                               label, name))
                continue
            if out != have:
                diff = list(difflib.unified_diff(
                    have.splitlines(), out.splitlines(),
                    fromfile="golden/" + label + ".out", tofile="this run",
                    lineterm="", n=1))
                fails.append((name, label, "%d differing line(s)"
                              % sum(1 for l in diff if l[:1] in "+-"), diff[:14]))
            elif not quiet:
                print("  ok        %-24s %s" % (label, name))
    finally:
        if os.path.isdir(work):
            shutil.rmtree(work)
    return ran, accepted


def do_run(only, cases, accept, quiet):
    if not snapshots():
        # NOT A FAILURE. A public clone and every other machine have no corpus, and a gate
        # that goes red on its own absence would be a gate nobody could keep green.
        print("corpus: SKIPPED — no snapshots in corpus/ "
              "(`bin/corpus snapshot <project-dir>` records one; it is never committed)")
        return 0
    names = [n for n in snapshots() if not only or n in only]
    if only and not names:
        _bail("no snapshot named %s" % ", ".join(sorted(only)))
    todo = [c for c in CASES if not cases or c[0] in cases]
    if cases and not todo:
        _bail("no case named %s — `bin/corpus list` names them"
              % ", ".join(sorted(cases)))
    fails, total, accepted = [], 0, 0
    sandbox, home, config = build_install()
    try:
        for name in names:
            ran, acc = run_snapshot(name, todo, sandbox, home, config, accept, quiet, fails)
            total, accepted = total + ran, accepted + acc
    finally:
        shutil.rmtree(sandbox, ignore_errors=True)
    for name, label, why, detail in fails:
        print("\nFAIL  %s / %s — %s" % (name, label, why))
        for l in detail:
            print("    " + l)
    verb = "recorded" if accept else "compared"
    print("\ncorpus: %d case(s) %s across %d snapshot(s) · %d new/accepted · %d FAILED"
          % (total, verb, len(names), accepted, len(fails)))
    if fails and not accept:
        print("A diff is a behaviour change on a REAL org. Read it, then either fix the "
              "code or re-record with `bin/corpus run --accept`.")
    return 1 if fails else 0


def main():
    ap = argparse.ArgumentParser(add_help=True, description=__doc__.splitlines()[0])
    sub = ap.add_subparsers(dest="cmd")
    s = sub.add_parser("snapshot", help="copy a project's .claude/ into corpus/")
    s.add_argument("project", nargs="+")
    sub.add_parser("list", help="what is snapshotted")
    r = sub.add_parser("run", help="run every case against a throwaway copy")
    r.add_argument("name", nargs="*", help="snapshot name(s); default every snapshot")
    r.add_argument("--case", action="append", default=[], metavar="LABEL",
                   help="only this case, repeatable (`bin/corpus list` names them)")
    r.add_argument("--accept", action="store_true", help="re-record the goldens")
    r.add_argument("--quiet", action="store_true", help="one line unless something fails")
    args = ap.parse_args()
    if args.cmd == "snapshot":
        return do_snapshot(args.project)
    if args.cmd == "list":
        return do_list()
    if args.cmd == "run":
        return do_run(set(args.name), set(args.case), args.accept, args.quiet)
    ap.print_help()
    return 2


if __name__ == "__main__":
    sys.exit(main())
