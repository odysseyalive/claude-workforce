#!/usr/bin/env python3
"""corpus — run this distribution's read-only scripts against a REAL customized org.

    bin/corpus snapshot <project-dir>...   copy each project's .claude/ (+ CLAUDE.md) in
    bin/corpus list                        what is snapshotted, and when
    bin/corpus run [name ...]              run every case, diff against the goldens
    bin/corpus run --accept                re-record the goldens instead of diffing
    bin/corpus run --quiet                 one line unless something fails (bin/check's form)

WHY THIS EXISTS — measured 2026-09-25, on the release the day before.

    Every pre-release gate in this repository runs against fixtures this project wrote
    itself. 1.71.0 shipped a catalog migration that passed 1,411 checks and 726 prove
    cases, and on the first real tree it was pointed at it left 505 false readers. The
    same release shipped `wf-catalog --house-rules`, whose `current` branch crashed with
    `NameError: name 'body' is not defined` on EVERY project that already had a region —
    unreachable from any fixture, because every fixture was a first-write tree. Both were
    found by hand, by copying one real project and running the command.

    A fixture states the case its author thought of. A real org states the case nobody
    did: 31 skills, 1,511 files, five evaluator copies at three spellings, agents
    registered under two layouts, and citations between all of it. That is the input this
    distribution actually runs on, and until now nothing here had ever seen one.

THE CORPUS IS LOCAL-ONLY AND NEVER COMMITTED. `corpus/` is gitignored, and `bin/check`
asserts that nothing under it is tracked — this repository is PUBLIC, and a snapshot holds
another project's handbooks, prompts and notes verbatim. A machine with no snapshots is not
a machine with a failing gate: `run` reports SKIPPED and exits 0, so a fresh clone and
every other developer stay green.

NOTHING TOUCHES THE REAL PROJECT. `snapshot` reads it once. `run` copies the snapshot to a
throwaway tree, runs everything against the COPY, and removes it in a `finally` — so a
traceback, a failing case and a Ctrl-C all still clean up. The real project is never an
argument to any case.

THE CASES ARE DERIVED, NOT INVENTED. Every row in `CASES` cites the line of
`references/procedures/audit.md` or `references/audit-setup.md` where the audit makes that
call in display mode, and `bin/check` re-reads each citation: a procedure that stops making
a call, or renames its script, fails this list rather than silently leaving it behind.
"""

import argparse
import difflib
import os
import re
import shutil
import subprocess
import sys
import time

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
CORPUS = os.path.join(ROOT, "corpus")
BIN = os.path.join(ROOT, "workforce", "bin")
TREE, GOLDEN, PROV = "tree", "golden", "SNAPSHOT.md"

# `<TREE>` is substituted with the throwaway copy's absolute path at run time. Every case is
# display-mode: no `--execute`, no `--apply`, no `--capture`, no `--stamp`. `rc` is the exit
# code a HEALTHY run gives — `wf-companion --objective` exits 1 on a placeholder objective by
# design, and `wf-catalog --grep` exits 1 on no match, so "nonzero" is not the failure signal.
# `cite` is a file:line where the audit's own procedure NAMES this script, and `bin/check` reads
# each one back: a procedure that stops naming a script, or renames it, fails there rather than
# leaving this list measuring one author's memory of the audit. Where the audit only ever calls a
# script in write mode — `wf-permissions --apply`, `wf-settings-apply --execute` — the citation is
# that line and the case still runs the DISPLAY form, because a display run is the only form it is
# safe to point at a snapshot. `wf-ledger` was dropped for the opposite reason: no audit procedure
# names it, so a case for it would have been this file inventing a step.
CASES = [
    ("census",              "wf-census",       ["--root", "<TREE>"], (0, 1),
