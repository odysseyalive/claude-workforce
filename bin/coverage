#!/usr/bin/env python3
"""
Enforcement coverage: which shipped claims have a mechanism, and which do not.

    python3 bin/coverage            # the map
    python3 bin/coverage --stamp    # write the per-file Enforcement headers

A doctrine audit of four files found 96 of 201 normative claims unenforced, and
noted the real problem underneath: *nothing marks which is which*. Every claim is
written in the same imperative bold, so a reader cannot tell an enforced rule from
an unenforced one without re-running the audit.

This is that labelling, generated rather than hand-written — a hand-maintained
label drifts from the assertion it describes, which is the exact defect being
labelled.

WHAT IT CANNOT DO. It reports whether a file is *guarded*, not whether a specific
sentence is. `bin/check` asserts on substrings, not on claim identifiers, so
"4 assertions guard this file" never means "these 4 claims are safe and the rest
are not". Coverage here is a floor and a trend, never a certificate.

Exit code is always 0 — a measurement, not a gate.
"""

import glob
import os
import re
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
os.chdir(ROOT)

# check() name → the file-variables its CONDITION reads. Restricted to the
# condition expression: an earlier form scanned the whole call and attributed
# assertions by their failure-message text, which credited files that were only
# mentioned in prose.
VAR_TO_FILE = {
    "lm": "workforce/references/legacy-markers.md",
    "ct": "workforce/references/conversion-taxonomy.md",
    "aud": "workforce/references/procedures/audit.md",
    "inv": "workforce/references/invariants.md",
    "cd_": "workforce/references/conversion-department.md",
    "disc": "workforce/references/discovery.md",
    "stg": "workforce/references/staging.md",
    "ds": "workforce/references/data-skills.md",
    "vfy": "workforce/references/procedures/verify.md",
    "_asu": "workforce/references/audit-setup.md",
    "_od": "workforce/references/org-design.md",
    "_stg": "workforce/references/staging.md",
    "_hire2": "workforce/references/procedures/hire.md",
    "_vfy2": "workforce/references/procedures/verify.md",
    "_org": "workforce/references/procedures/org.md",
    "_ocf": "workforce/references/org-chart-format.md",
    "_pfp2": "workforce/references/procedure-for-procedures.md",
    "pfp": "workforce/references/procedure-for-procedures.md",
    "enf": "workforce/references/enforcement.md",
    "plat": "workforce/references/platform.md",
    "_plat": "workforce/references/platform.md",
    "skill": "workforce/SKILL.md",
    "_hire": "workforce/references/procedures/hire.md",
    "pa_": "workforce/agents/provenance-analyst/AGENT.md",
    "cc_": "workforce/agents/content-classifier/AGENT.md",
    "da": "workforce/agents/doctrine-auditor/AGENT.md",
}

# Assertions whose condition iterates `declared` or a glob rather than naming a
# file variable. They guard EVERY shipped file, and VAR_TO_FILE structurally
# cannot see them — so a file reported at 0 below is covered by these.
GENERIC = [
    "manifest: every declared file exists",
    "manifest: no shipped file is undeclared",
    "constants: stated once, outside the declared exceptions",
    "references: every references/… link resolves, backticked or bare",
    "scopes: no project state written into the skill directory",
    "doctrine: no shipped file revokes a rule while keeping its guarded text",
    "immutable: every shipped user directive matches its stamp",
    "coverage: every Enforcement header matches the assertions that exist",
]

# A normative claim: a sentence carrying an imperative token. Deliberately the
# same crude definition the audits used, so the numbers are comparable.
NORM_RX = re.compile(r"\b(MUST NOT|MUST|NEVER|ALWAYS|may never|must never|never|always)\b")


def guarded():
    """file → sorted assertion names whose CONDITION reads that file.

    PARSED, not regexed. `bin/check` is valid Python, and a regex over check()
    calls found 9 of 299 because the calls take four different shapes. Guessing
    at a file's structure when the file can be parsed is how a measurement comes
    back confidently wrong — which is the defect this whole tool reports on.
    """
    import ast

    src = open("bin/check", encoding="utf-8").read()
    tree = ast.parse(src)
    out = {}
    for node in ast.walk(tree):
        if not (isinstance(node, ast.Call) and getattr(node.func, "id", "") == "check"):
            continue
        if not node.args:
            continue
        name = node.args[0]
        name = name.value if isinstance(name, ast.Constant) else "<computed>"
        cond = node.args[1] if len(node.args) > 1 else None
        if cond is None:
            continue
        names_read = {
            n.id for n in ast.walk(cond) if isinstance(n, ast.Name)
        }
        for var, path in VAR_TO_FILE.items():
            if var in names_read:
                out.setdefault(path, set()).add(name)
    return {k: sorted(v) for k, v in out.items()}


def claims(path):
    body = open(path, encoding="utf-8").read()
    body = re.sub(r"```.*?```", "", body, flags=re.S)
    units = re.split(r"(?<=[.!?])\s+|\n\|", body)
    return sum(1 for u in units if NORM_RX.search(u))


def main():
    g = guarded()
    shipped = [
        l.strip() for l in open("manifest.txt", encoding="utf-8")
        if l.strip() and not l.startswith("#") and l.strip().endswith(".md")
    ]
    rows = []
    for p in shipped:
        if not os.path.isfile(p):
            continue
        rows.append((p, claims(p), len(g.get(p, []))))
    rows.sort(key=lambda r: (-r[1], r[0]))

    if "--stamp" in sys.argv:
        n = 0
        for p, c, a in rows:
            # Zero-assertion files are stamped TOO. Skipping them let the worst-covered
            # files keep a hand-written "Enforcement: HIGH" label that _HDR_RX cannot
            # match and therefore never contradicts — a file earning exemption from the
            # coverage check by having no coverage.
            body = open(p, encoding="utf-8").read()
            line = (f"<!-- Enforcement: {a} assertion(s) in bin/check name this file; "
                    f"{c} normative claims total. {len(GENERIC)} generic assertions guard it "
                    f"too. Coverage is a floor, not a certificate — run bin/coverage. -->")
            body = re.sub(r"<!-- Enforcement: \d+ assertion.*?-->\n", "", body, flags=re.S)
            lines = body.split("\n")
            at = 1 if lines and lines[0].startswith("# ") else 0
            lines.insert(at + 1, line)
            open(p, "w", encoding="utf-8").write("\n".join(lines))
            n += 1
        print(f"stamped {n} files")
        return 0

    tot_c = sum(r[1] for r in rows)
    tot_a = sum(r[2] for r in rows)
    unguarded = [r for r in rows if r[2] == 0]
    print("# Enforcement coverage\n")
    print(f"{len(rows)} shipped markdown files · {tot_c} normative claims · "
          f"{tot_a} file-specific assertions · {len(unguarded)} files with no "
          f"file-specific assertion\n")
    print(f"**Plus {len(GENERIC)} generic assertions that guard EVERY shipped file** — "
          f"{', '.join(GENERIC)}. A file reported at zero below is covered by those; it "
          f"has no assertion naming *it*.\n")
    print("> Two independent audits found the earlier version of this line misleading: it "
          "printed \"files with no assertion at all\", which was false. The generic loops "
          "iterate `declared` and `glob`, so `VAR_TO_FILE` — which attributes only named "
          "variables — could never see them. A coverage tool that undercounts its own "
          "floor is the defect it exists to report.\n")
    print("| file | claims | assertions |")
    print("|---|---|---|")
    for p, c, a in rows:
        mark = "" if a else "  ← **none**"
        print(f"| `{p.replace('workforce/', '')}` | {c} | {a}{mark} |")
    print("\n## Assertions by file\n")
    for p in sorted(g):
        print(f"**`{p.replace('workforce/', '')}`**")
        for n in g[p]:
            print(f"- {n}")
        print()
    return 0


if __name__ == "__main__":
    sys.exit(main())
