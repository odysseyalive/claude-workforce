#!/usr/bin/env python3
"""
Conformance: run the read-only census against every fixture and assert its
expectations.

    python3 bin/conformance            # all fixtures
    python3 bin/conformance f9         # one, by prefix

WHY THIS EXISTS. `bin/check` asserts properties of shipped TEXT. `bin/baseline`
measures ONE tree. Neither can tell you the system generalizes — and on
2026-07-31 six fixtures found five structural findings that thirteen hours
against the single real target did not. One real project is a ceiling exactly
as re-reading is a ceiling.

A fixture with no entry in expectations.json FAILS. An unasserted fixture is a
directory, not a test — and a corpus that silently skips is the shape of every
other defect this project has recorded.

Exit code is 1 on any failure: this one IS a gate.
"""
import json
import os
import subprocess
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
FIX = os.path.join(ROOT, "fixtures")
EXP = os.path.join(FIX, "expectations.json")


def census(path):
    r = subprocess.run([sys.executable, os.path.join(ROOT, "bin", "baseline"), path, "--json"],
                       capture_output=True, text=True, timeout=300)
    if r.returncode != 0:
        return None, f"baseline exited {r.returncode}: {r.stderr.strip()[:200]}"
    try:
        return json.loads(r.stdout), None
    except Exception as e:
        return None, f"baseline emitted unparseable JSON: {e}"


def assertions(exp, c):
    """(label, ok, detail) per declared expectation. Absent key -> not asserted."""
    g = c.get("greenfield") or {}
    got = {
        "skills": c.get("skill_count", 0),
        "quarantined": len(c.get("quarantined") or []),
        "unknown_families_min": len(c.get("unknown_marker_families") or {}),
        "owners_min": len(c.get("foreign_origin_owners") or {}),
        "datasets_min": len(c.get("datasets") or []),
        "unpaired_min": len(c.get("unpaired_markers") or []),
        "agents_registered": len((c.get("agents") or {}).get("registered") or []),
        "greenfield_code_min": g.get("code_files", 0),
        "greenfield_commits_min": g.get("git_commits", 0),
        "greenfield_manifests_min": len(g.get("manifests") or []),
        # Asserted against a HAND count in the fixture's TRUTH.md. Every other
        # number here is the census checked against the census; this one is the
        # census checked against a person reading files. It exists because a
        # confidently wrong count propagated into five documents on 2026-07-31.
        "ledger_total": (c.get("predecessor_ledger") or {}).get("actual_total", 0),
        "ledger_index_claims": sum(((c.get("predecessor_ledger") or {}).get("index_claims") or {}).values()),
        # Reads `record_types` — the explicit bucket list — NOT "every int-valued
        # key that isn't actual_total". `isinstance(True, int)` is True in Python,
        # so that filter counted any bool the census later added as a bucket, and
        # the first two (`index_present`, `index_states_counts`) would have
        # silently inflated every fixture's bucket count by 2.
        "ledger_buckets": len((c.get("predecessor_ledger") or {}).get("record_types") or []),
        # Distinguishes "the index states no counts" from "the index counted zero".
        # `_states_counts` alone does NOT discriminate: on a census that never
        # emitted the key it reads absent -> False and passes against broken code.
        # `_index_present` is the half that fails there, so the pair asserts the
        # distinction exists rather than assuming it.
        "ledger_index_present": bool((c.get("predecessor_ledger") or {}).get("index_present")),
        "ledger_index_states_counts": bool((c.get("predecessor_ledger") or {}).get("index_states_counts")),
        # f14: a MENTIONED family is not a PRESENT one. `_exact` both ways —
        # a floor on unknown families would hide the phantom this pair exists to
        # catch, and silence on mentions would be the opposite error.
        "unknown_families_exact": len(c.get("unknown_marker_families") or {}),
        "family_mentions_only_exact": len(c.get("family_mentions_only") or {}),
        # f15: families found outside `.claude/skills/**`. `_exact` because the
        # failure this catches is a count of ZERO against spans that exist.
        "families_outside_skills_exact": len(c.get("families_outside_skills") or {}),
        # f11: dataset and hook censuses, hand-classified. `_exact` because a
        # floor would hide the over-count these exist to catch.
        "datasets_exact": len(c.get("datasets") or []),
        "datasets_owned_exact": len([d for d in (c.get("datasets") or [])
                                     if not d.get("credential_shaped") and not d.get("host_local_sentinel")]),
        "credential_exact": len(c.get("credential_shaped_files") or []),
        "host_local_exact": len(c.get("host_local_sentinels") or []),
        "policy_exact": len(c.get("policy_files") or []),
        "hook_entries_exact": c.get("hook_entries_total", 0),
        "hook_file_pointing_exact": c.get("hook_entries_file_pointing", 0),
        "hook_inline_exact": len(c.get("hooks_inline_no_file") or []),
        "hooks_on_disk_exact": len(c.get("hooks_on_disk") or []),
        "dead_wiring_exact": len(c.get("hooks_dead_wiring") or []),
        "orphaned_exact": len(c.get("hooks_orphaned") or []),
        # f12: the extraction gate's denominator, hand-counted. INV-DIRECTIVES
        # asserts extracted-against-censused, so an undercount here lets a sweep
        # delete a protected span the run never extracted.
        "user_immutable_exact": (c.get("marker_totals") or {}).get("origin_user_immutable", 0),
        "foreign_exact": (c.get("marker_totals") or {}).get("origin_foreign", 0),
    }
    out = []
    for k, want in exp.items():
        if k.startswith("_") or k == "note":
            continue
        if k not in got:
            out.append((k, False, f"unknown expectation key — add it to conformance's `got` map"))
            continue
        have = got[k]
        ok = have >= want if k.endswith("_min") else have == want  # _exact and bare keys are equality
        out.append((k, ok, f"want {'>=' if k.endswith('_min') else '='} {want}, got {have}"))
    return out


def main():
    if not os.path.isfile(EXP):
        print(f"no {EXP}"); return 1
    exps = json.load(open(EXP))
    only = sys.argv[1] if len(sys.argv) > 1 else ""
    dirs = sorted(d for d in os.listdir(FIX)
                  if os.path.isdir(os.path.join(FIX, d)) and d.startswith("f") and d.startswith(only))
    if not dirs:
        print(f"no fixtures matching {only!r}"); return 1

    npass = nfail = 0
    for d in dirs:
        exp = exps.get(d)
        if exp is None:
            print(f"✗ {d}\n    NO EXPECTATIONS — an unasserted fixture is a directory, not a test")
            nfail += 1
            continue
        c, err = census(os.path.join(FIX, d))
        if err:
            print(f"✗ {d}\n    {err}")
            nfail += 1
            continue
        rows = assertions(exp, c)
        bad = [r for r in rows if not r[1]]
        mark = "✓" if not bad else "✗"
        print(f"{mark} {d}  ({len(rows)} assertions)   {exp.get('note','')}")
        for k, ok, detail in rows:
            if not ok:
                print(f"    ✗ {k}: {detail}")
        npass += len(rows) - len(bad)
        nfail += len(bad)

    # Every fixture on disk must be declared, and every declaration must exist.
    undeclared = [d for d in dirs if d not in exps]
    phantom = [k for k in exps if not k.startswith("_") and not os.path.isdir(os.path.join(FIX, k))]
    if undeclared:
        print(f"\n✗ fixtures with no expectations: {undeclared}"); nfail += len(undeclared)
    if phantom:
        print(f"\n✗ expectations naming no fixture: {phantom}"); nfail += len(phantom)

    print(f"\n{len(dirs)} fixtures · {npass} assertions passed · {nfail} failed")
    return 1 if nfail else 0


if __name__ == "__main__":
    sys.exit(main())
