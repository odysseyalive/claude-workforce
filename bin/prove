def failing_checks(root):
    """Names of the checks bin/check reports failing, run against `root`'s own copy.

    A completed bin/check exits 0 (green) or 1 (has FAILS) and always prints its
    `N passed, M failed` summary. Any other outcome means the RUN broke, not that
    nothing failed: under WORKERS-way concurrency a starved subprocess can die with
    no ✗ lines, and reading that as green silently mislabels a firing check VACUOUS
    (the "did NOT fire — 0 other failures" flake). Retry a broken run, then fail
    loudly; never return a verdict from an incomplete run.
    """
    for _ in range(3):
        r = subprocess.run(["./bin/check"], cwd=str(root), capture_output=True, text=True)
        if r.returncode in (0, 1) and "passed," in r.stdout and "failed," in r.stdout:
            return {ln.strip()[2:].strip()
                    for ln in r.stdout.splitlines() if ln.strip().startswith("✗ ")}
    raise RuntimeError(
        f"bin/check did not complete under {root} after 3 attempts "
        f"(last exit {r.returncode}); stderr tail: {r.stderr.strip()[-400:]}")


def tree_digest(root):
    """Content hash of every tracked-ish file, so "untouched" is measured, not asserted."""
    h = hashlib.sha256()
    for p in sorted(root.rglob("*")):
        if not p.is_file() or any(part in IGNORED_DIRS for part in p.parts):
            continue
        h.update(str(p.relative_to(root)).encode())
        h.update(p.read_bytes())
    return h.hexdigest()


def run_shard(shard):
    """Break each case in this shard inside a PRIVATE copy of the tree.

    One copy per worker, not per case: the copy costs ~1 MB and a fraction of a
    second, while bin/check costs ~1.8 s, so re-copying per case would dominate.
    Restoring between cases within a shard keeps each case's baseline green — the
    same guarantee the old in-place loop got from its backup file.
    """
    out = []
    with tempfile.TemporaryDirectory(prefix="wf-prove-") as tmp:
        work = pathlib.Path(tmp) / "tree"
        shutil.copytree(ROOT, work, ignore=IGNORE)
        for name, relpath, mode, payload in shard:
            if STOP.is_set():
                break
            target = work / relpath
            # A CASE NAMING A FILE THAT NO LONGER SHIPS IS A STALE CASE, NOT A CRASH.
            # `target.read_bytes()` raised FileNotFoundError straight out of the worker
            # and took the whole run down, so one retired script made every OTHER case
            # unrunnable — the same defect the expectations parse fixed by failing the
            # row instead of the run. Measured 2026-09-09: the 1.30.2 strip deleted
            # eight hook scripts and left their cases here, and prove could not run at
            # all. Reported per case so the stale ones are named and removed.
            # TWO REASONS A TARGET IS MISSING, AND THEY WANT OPPOSITE ACTIONS.
            #
            # A `.claude/` path is a project's OWN org — the `operating-principles`
            # skill, an employee's handbook, a grounding file. **Every workforce project
            # carries those after its first audit.** This repository is the one that does
            # not, because it is the development kit: it builds the thing rather than
            # being staffed by it. So the case is correct, the coverage is real
            # everywhere the distribution is used, and it simply cannot run HERE.
            # Telling a reader to remove it would delete live coverage for every project
            # that does have an org — which is why this is N/A and never STALE-CASE.
            #
            # Any other missing path is a shipped file that no longer ships, and that
            # case IS residue: remove it with the rule it proved.
            if not target.is_file():
                if relpath.startswith(".claude/"):
                    out.append((name, "N/A", f"{relpath} is project org state, which this "
                                             "repo does not carry — the development kit is "
                                             "the one project with no org. Runs wherever "
                                             "workforce has been audited in. Do NOT remove."))
                else:
                    out.append((name, "STALE-CASE",
                                f"{relpath} does not ship — remove this case"))
                continue
            original = target.read_bytes()          # restore is byte-exact, not text-round-tripped
            try:
                text = original.decode()
                if mode in ("del", "delall"):
                    if payload not in text:
                        out.append((name, "SETUP-FAIL", f"literal absent from {relpath}"))
                        continue
                    # `del` removes the FIRST occurrence, which is what a hand-written
                    # case wants: it names one site deliberately. `delall` removes EVERY
                    # occurrence, which is what a DERIVED case needs — its assertion is
                    # `'lit' in <whole file>`, so leaving a second copy anywhere in the
                    # file leaves the assertion true and the case reports VACUOUS having
                    # broken nothing. MEASURED 2026-09-09: 39 of 54 vacuous verdicts were
                    # exactly this, including an assertion written the same afternoon.
                    target.write_text(text.replace(payload, "", 1) if mode == "del"
                                      else text.replace(payload, ""))
                else:
                    target.write_text(text + payload)

                fails = failing_checks(work)
                if name in fails:
                    out.append((name, "PROVEN", f"fired on mutated {relpath}"))
                elif fails:
                    # TWO VERDICTS, NOT ONE, AND THE DIFFERENCE IS WHOSE FAULT IT IS.
                    #
                    # `VACUOUS` is a finding about the ASSERTION: its target was broken
                    # cleanly, check ran, and the assertion still passed. It is testing
                    # nothing and it must be fixed or deleted.
                    #
                    # This is a finding about the CASE. The named check never got to run
                    # because the mutation wrecked the file — a deleted `def` line orphans
                    # its body, a deleted binding leaves a NameError — so check failed on
                    # unrelated assertions and this one reports nothing at all. The
                    # assertion may be perfectly good.
                    #
                    # `len(fails)` knew this the whole time and was spent on a word.
                    # MEASURED 2026-09-10: four cases in one session were labelled VACUOUS
                    # when the mutation was at fault, and each one cost a hand re-derivation
                    # of the same conclusion. Worse, a genuinely vacuous assertion hides
                    # among them — the label that should stop a release reads identically
                    # to the label that means "retarget your case".
                    out.append((name, "BAD-CASE",
                                f"the mutation broke {relpath} — check failed on "
                                f"{len(fails)} OTHER assertion(s) and this one never ran. "
                                f"Aim at a literal whose removal changes behaviour and "
                                f"leaves the file valid, never at a `def` or a binding. "
                                f"The assertion itself is unproven, not disproven"))
                else:
                    out.append((name, "VACUOUS",
                                f"broke {relpath} cleanly and this assertion STILL PASSED "
                                f"— it is testing nothing"))
            finally:
                target.write_bytes(original)
    return out


before = tree_digest(ROOT)
def derived_cases(existing):
    """Generate a case for every assertion whose condition is a literal-in-a-shipped-file.

    WHY THIS IS DERIVED AND NOT TYPED. Hand-written cases have to be added beside every
    new assertion, by a person who remembers to, and nothing failed when they did not.
    MEASURED 2026-09-09: `bin/check` carried 836 assertions against 386 distinct case
    names — **457 assertions had no case at all**, so more than half the suite was
    unproven and the number was not visible anywhere. Worse, the gap grows on its own:
    every assertion added since the last time somebody swept it is unproven by default.

    277 of those 457 are the same mechanical shape — `check(name, '<literal>' in VAR)`
    where VAR is `read("workforce/...")`. A case for that shape is fully determined by
    the assertion, so it is COMPUTED from `bin/check`'s syntax tree rather than copied.
    Coverage then follows the assertions automatically: write a new one of this shape
    and it is proven on the next run, with nothing to remember.

    THE LONGEST LITERAL IS CHOSEN, deliberately. A short one may appear many times or be
    a fragment of ordinary prose, and prove deletes only the FIRST occurrence — so a
    short literal can be removed from a place the assertion never reads and report a
    vacuous non-firing. The longest is the most specific thing the assertion names.

    WHAT THIS DOES NOT REACH, said plainly rather than left to be inferred: the other 180
    are structural — a file exists, a count matches, a parse succeeds, two files agree.
    Deleting text cannot express those, and they stay hand-written or unproven. This
    generator never claims them.
    """
    import ast as _ast
    try:
        _t = _ast.parse(pathlib.Path(ROOT, "bin/check").read_text())
    except (OSError, SyntaxError):
        return []

    binds = {}
    for n in _ast.walk(_t):
        if (isinstance(n, _ast.Assign) and len(n.targets) == 1
                and isinstance(n.targets[0], _ast.Name)
                and isinstance(n.value, _ast.Call)
                and isinstance(n.value.func, _ast.Name) and n.value.func.id == "read"
                and n.value.args and isinstance(n.value.args[0], _ast.Constant)):
            binds[n.targets[0].id] = n.value.args[0].value

    out, seen = [], set(existing)
    for n in _ast.walk(_t):
        if not (isinstance(n, _ast.Call) and isinstance(n.func, _ast.Name)
                and n.func.id == "check" and len(n.args) >= 2):
            continue
        if not (isinstance(n.args[0], _ast.Constant) and isinstance(n.args[0].value, str)):
            continue
        name = n.args[0].value
        if name in seen:
            continue
        # AN `A or B` ASSERTION CANNOT BE FALSIFIED BY ONE MUTATION, so no case is
        # emitted for one. Deleting A leaves B true and the check still passes — a case
        # that is VACUOUS by construction, which is worse than no case: it reports the
        # assertion as untested-and-weak when the truth is that this tool cannot express
        # its mutation. MEASURED 2026-09-09: three of the last fifteen vacuous verdicts
        # were exactly this, and reading them cost more than the coverage was worth.
        # They join the structural remainder the summary line already counts.
        _has_or = any(
            isinstance(_b, _ast.BoolOp) and isinstance(_b.op, _ast.Or)
            and sum(1 for _v in _ast.walk(_b)
                    if isinstance(_v, _ast.Compare) and len(_v.ops) == 1
                    and isinstance(_v.ops[0], (_ast.In, _ast.NotIn))) > 1
            for _b in _ast.walk(n.args[1]))
        if _has_or:
            continue
        best = None
        for c in _ast.walk(n.args[1]):
            # BOTH POLARITIES, and the second is not an afterthought. `'x' in FILE` is
            # broken by DELETING x; `'x' not in FILE` — an assertion that something is
            # absent — is broken by APPENDING it. An absence rule with no case is the
            # easier one to get wrong, because it passes on an empty file and on a file
            # that was never read: exactly the vacuous green the guard checks exist for.
            if not (isinstance(c, _ast.Compare) and len(c.ops) == 1
                    and isinstance(c.ops[0], (_ast.In, _ast.NotIn))
                    and isinstance(c.left, _ast.Constant) and isinstance(c.left.value, str)
                    and isinstance(c.comparators[0], _ast.Name)
                    and c.comparators[0].id in binds):
                continue
            path = binds[c.comparators[0].id]
            if not path.startswith("workforce/"):
                continue
            f = pathlib.Path(ROOT, path)
            if not f.is_file():
                continue
            lit = c.left.value
            if not lit:
                continue
            negated = isinstance(c.ops[0], _ast.NotIn)
            body = f.read_text()
            # A `del` case needs the literal PRESENT to remove; an `append` case needs it
            # ABSENT, or the append changes nothing and the run reports a vacuous pass.
            if (lit in body) is negated:
                continue
            mode = "append" if negated else "delall"
            if best is None or len(lit) > len(best[2]):
                best = (path, mode, lit)
        if best:
            seen.add(name)
            out.append((name, best[0], best[1], best[2]))
    return out


DERIVED = derived_cases({c[0] for c in CASES})
CASES = CASES + DERIVED

baseline = failing_checks(ROOT)
if baseline:
    print(f"REFUSING: bin/check is not green to begin with: {sorted(baseline)}")
    sys.exit(1)
print(f"baseline: 0 failures · {len(CASES)} cases "
      f"({len(CASES) - len(DERIVED)} written, {len(DERIVED)} derived) "
      f"across {WORKERS} workers\n")

# CASE FILTERING, and the reason it is worth ten lines. Every case is a full `bin/check`
# against a disposable copy. MEASURED 2026-09-10 on this host: `bin/check` is 9.1 s and
# there are 441 cases, so a full run is 441 x 9.1 / 4 workers = ~17 min floor, ~33 min
# real. A maintainer adding ONE assertion paid that to prove one case, which is the tax
# that gets a gate skipped rather than run.
#
# `bin/prove <substring>` runs the cases whose CHECK NAME contains the substring —
# the same interface `bin/script-conformance` already ships, so this is the house
# convention rather than a new one. Six catalog cases take ~14 s this way.
#
# THE FULL RUN REMAINS THE DEFAULT and the filtered run says so in its header, because a
# subset that reports like a full run is how a green line comes to mean less than it says.
# `--since <ref>` takes a VALUE, and that value is not a name filter. Without this the
# ref lands in SELECT, the name filter matches nothing, and a focused run reports
# "no case name matches HEAD" having selected three cases a line earlier. Caught by
# running it rather than by reading it.
_argv = sys.argv[1:]
_skip = {_i + 1 for _i, _a in enumerate(_argv) if _a == "--since"}
SELECT = [a for i, a in enumerate(_argv) if not a.startswith("-") and i not in _skip]
CASES_ALL = CASES

# `--since <ref>` — PROVE WHAT YOU JUST CHANGED, derived from the diff rather than from
# whoever is running it remembering which assertions their edit touched.
#
# The name filter above still requires that memory: you have to know the check's wording.
# After an edit, the question is not "which check did I mean" but "which cases point at a
# file I touched", and git already knows. Every case names its target file, so the
# selection is exact and needs no new bookkeeping.
#
# WHY IT MATTERS MORE THAN THE NAME FILTER. A full run is ~717 cases at 9.6 s of
# `bin/check` each across 4 workers — about half an hour, MEASURED 2026-09-10. A gate that
# costs half an hour is run a few times a day; one that costs seconds after each edit is
# run every time, which is the difference between catching a vacuous assertion when you
# wrote it and catching it at release.
#
# IT NARROWS AND NEVER WIDENS. `--since` combined with a name filter is the intersection,
# and a run that selected nothing says so and exits 2 rather than reporting green.
SINCE = None
for _i, _a in enumerate(sys.argv[1:]):
    if _a == "--since":
        SINCE = sys.argv[_i + 2] if _i + 2 < len(sys.argv) else "HEAD"
    elif _a.startswith("--since="):
        SINCE = _a.split("=", 1)[1] or "HEAD"
if SINCE:
    try:
        _changed = set(subprocess.run(
            ["git", "diff", "--name-only", SINCE], cwd=ROOT,
            capture_output=True, text=True, timeout=30).stdout.split())
        _changed |= set(subprocess.run(
            ["git", "diff", "--name-only", "--cached"], cwd=ROOT,
            capture_output=True, text=True, timeout=30).stdout.split())
    except Exception as _exc:                            # noqa: BLE001
        print(f"--since {SINCE}: could not read the diff ({_exc})")
        raise SystemExit(2)
    if not _changed:
        print(f"--since {SINCE}: nothing changed — no case to prove")
        raise SystemExit(0)
    CASES = [c for c in CASES if c[1] in _changed]
    print(f"--since {SINCE}: {len(_changed)} file(s) changed, "
          f"{len(CASES)} case(s) point at them")
if SELECT:
    CASES = [c for c in CASES if any(sel.lower() in c[0].lower() for sel in SELECT)]
    if not CASES:
        print("no case name matches %s — nothing to prove" % ", ".join(SELECT))
        raise SystemExit(2)

results = []
interrupted = ""
shards = [CASES[i::WORKERS] for i in range(WORKERS)]
pool = concurrent.futures.ThreadPoolExecutor(max_workers=WORKERS)
futures = [pool.submit(run_shard, s) for s in shards]
try:
    for f in concurrent.futures.as_completed(futures):
        f.result()
except KeyboardInterrupt as exc:
    # Cancelling a RUNNING future does not stop it, so the stop is cooperative: each
    # worker finishes the case in hand (~2 s), then breaks. That is what lets every
    # TemporaryDirectory unwind normally instead of being orphaned in /tmp.
    interrupted = str(exc)
    STOP.set()
    for f in futures:
        f.cancel()

# Collect AFTER the pool has drained, never inside the interrupt handler: a shard that
# finished a millisecond late would otherwise be dropped, and its cases would read as
# "never ran" when they in fact ran and passed.
pool.shutdown(wait=True)
for f in futures:
    if f.done() and not f.cancelled() and f.exception() is None:
        results.extend(f.result())

# Workers complete out of order, so restore the CASES order before printing. A report
# whose row order changes run to run cannot be diffed against the previous run.
_order = {name: i for i, (name, *_rest) in enumerate(CASES)}
results.sort(key=lambda r: _order.get(r[0], len(CASES)))

untouched = tree_digest(ROOT) == before
after = failing_checks(ROOT)
if interrupted:
    print(f"\nINTERRUPTED ({interrupted}) after {len(results)} of {len(CASES)} cases.\n")

print(f"{'STATUS':<10} CHECK")
print("-" * 78)
# N/A IS NOT A FAILURE AND IT IS NOT A PASS — it is a case this CHECKOUT cannot run.
# Counting it as unproven would leave this suite permanently short of green on the one
# repository it lives in, and the standing red would train a reader to ignore the
# number. Counting it as proven would be a lie about coverage. It leaves the ratio and
# is reported on its own line, with the reason.
bad = na = vac = badcase = 0
for name, status, detail in results:
    if status == "N/A":
        na += 1
    elif status != "PROVEN":
        bad += 1
        if status == "VACUOUS":
            vac += 1
        elif status == "BAD-CASE":
            badcase += 1
    print(f"{status:<10} {name}\n           {detail}")
print("-" * 78)
_runnable = len(results) - na
print(f"{_runnable - bad} of {_runnable} proven by breaking"
      + (f" · {na} n/a here (project org state — see above)" if na else ""))
# THE TWO UNPROVEN KINDS ARE COUNTED SEPARATELY, because they are read by different
# people for different reasons. `VACUOUS` is an assertion testing nothing and it should
# stop a release. `BAD-CASE` is a mutation that wrecked the file so the named check never
# ran — the assertion is unproven, not disproven, and the fix is to retarget the case.
# Summing them into one number hides the first behind the second.
if vac or badcase:
    print(f"   of the unproven: {vac} VACUOUS (assertion tests nothing — fix or delete it)"
          f" · {badcase} BAD-CASE (mutation wrecked the file — retarget at a literal)")

# THE ASSERTIONS WITH NO CASE ARE PRINTED, ALWAYS. Until 2026-09-09 this suite reported
# only on the cases it HAD, so a run could say "431 of 478 proven" while 457 of 836
# assertions had no case at all — a number that appeared nowhere and grew with every
# assertion anyone added. A coverage figure that counts only what it already covers is
# the vacuous green this tool exists to find, aimed at itself.
_covered = {c[0] for c in CASES}
_all_assertions = set()
try:
    import ast as _a
    _ct = _a.parse(pathlib.Path(ROOT, "bin/check").read_text())
    for _n in _a.walk(_ct):
        if (isinstance(_n, _a.Call) and isinstance(_n.func, _a.Name) and _n.func.id == "check"
                and _n.args and isinstance(_n.args[0], _a.Constant)
                and isinstance(_n.args[0].value, str)):
            _all_assertions.add(_n.args[0].value)
except (OSError, SyntaxError):
    pass
if _all_assertions and not SELECT and not SINCE:
    _nocase = len(_all_assertions - _covered)
    print(f"assertions with a case:  {len(_all_assertions) - _nocase} of "
          f"{len(_all_assertions)} · {_nocase} structural, provable only by hand")
elif SELECT or SINCE:
    # A FILTERED RUN NEVER PRINTS THE COVERAGE LINE, and this is not cosmetic. That line
    # divides the cases that RAN by every assertion in bin/check, so on a filtered run it
    # reported `2 of 850 · 848 structural, provable only by hand` — which reads as a
    # coverage collapse and is really just the subset it was asked for. A subset that
    # reports in the shape of a full run is how a green line comes to mean less than it
    # says, which is the defect this whole harness exists to prevent.
    print(f"FILTERED RUN — matched {', '.join(SELECT) or SINCE}. Coverage NOT reported: this run "
          f"proves the cases it selected and says nothing about the other "
          f"{len(CASES_ALL) - len(CASES)} case(s). Run bin/prove with no argument for that.")

print(f"working tree untouched: {'yes' if untouched else 'NO — run `git status`'}")
print(f"baseline still clean:   {'yes' if not after else 'NO — ' + str(sorted(after))}")

# An interrupted run exits 130, NOT 1. Collapsing them into one failing code makes a
# run somebody killed indistinguishable from a run that found a vacuous assertion —
# and the first is nothing while the second is the whole reason this tool exists.
if interrupted:
    sys.exit(130)
sys.exit(1 if bad or after or not untouched else 0)
