def failing_checks(root):
    """Names of the checks bin/check reports failing, run against `root`'s own copy.

    A completed bin/check exits 0 (green) or 1 (has FAILS) and always prints its
    `N passed, M failed` summary. Any other outcome means the RUN broke, not that
    nothing failed: under WORKERS-way concurrency a starved subprocess can die with
    no ✗ lines, and reading that as green silently mislabels a firing check VACUOUS
    (the "did NOT fire — 0 other failures" flake). Retry a broken run, then fail
    loudly; never return a verdict from an incomplete run.
    """
    for _ in range(3):
        r = subprocess.run(["./bin/check"], cwd=str(root), capture_output=True, text=True)
        if r.returncode in (0, 1) and "passed," in r.stdout and "failed," in r.stdout:
            return {ln.strip()[2:].strip()
                    for ln in r.stdout.splitlines() if ln.strip().startswith("✗ ")}
    raise RuntimeError(
        f"bin/check did not complete under {root} after 3 attempts "
        f"(last exit {r.returncode}); stderr tail: {r.stderr.strip()[-400:]}")


def tree_digest(root):
    """Content hash of every tracked-ish file, so "untouched" is measured, not asserted."""
    h = hashlib.sha256()
    for p in sorted(root.rglob("*")):
        if not p.is_file() or any(part in IGNORED_DIRS for part in p.parts):
            continue
        h.update(str(p.relative_to(root)).encode())
        h.update(p.read_bytes())
    return h.hexdigest()


def run_shard(shard):
    """Break each case in this shard inside a PRIVATE copy of the tree.

    One copy per worker, not per case: the copy costs ~1 MB and a fraction of a
    second, while bin/check costs ~1.8 s, so re-copying per case would dominate.
    Restoring between cases within a shard keeps each case's baseline green — the
    same guarantee the old in-place loop got from its backup file.
    """
    out = []
    with tempfile.TemporaryDirectory(prefix="wf-prove-") as tmp:
        work = pathlib.Path(tmp) / "tree"
        shutil.copytree(ROOT, work, ignore=IGNORE)
        for name, relpath, mode, payload in shard:
            if STOP.is_set():
                break
            target = work / relpath
            original = target.read_bytes()          # restore is byte-exact, not text-round-tripped
            try:
                text = original.decode()
                if mode == "del":
                    if payload not in text:
                        out.append((name, "SETUP-FAIL", f"literal absent from {relpath}"))
                        continue
                    target.write_text(text.replace(payload, "", 1))
                else:
                    target.write_text(text + payload)

                fails = failing_checks(work)
                if name in fails:
                    out.append((name, "PROVEN", f"fired on mutated {relpath}"))
                else:
                    out.append((name, "VACUOUS", f"did NOT fire — {len(fails)} other failures"))
            finally:
                target.write_bytes(original)
    return out


before = tree_digest(ROOT)
baseline = failing_checks(ROOT)
if baseline:
    print(f"REFUSING: bin/check is not green to begin with: {sorted(baseline)}")
    sys.exit(1)
print(f"baseline: 0 failures · {len(CASES)} cases across {WORKERS} workers\n")

results = []
interrupted = ""
shards = [CASES[i::WORKERS] for i in range(WORKERS)]
pool = concurrent.futures.ThreadPoolExecutor(max_workers=WORKERS)
futures = [pool.submit(run_shard, s) for s in shards]
try:
    for f in concurrent.futures.as_completed(futures):
        f.result()
except KeyboardInterrupt as exc:
    # Cancelling a RUNNING future does not stop it, so the stop is cooperative: each
    # worker finishes the case in hand (~2 s), then breaks. That is what lets every
    # TemporaryDirectory unwind normally instead of being orphaned in /tmp.
    interrupted = str(exc)
    STOP.set()
    for f in futures:
        f.cancel()

# Collect AFTER the pool has drained, never inside the interrupt handler: a shard that
# finished a millisecond late would otherwise be dropped, and its cases would read as
# "never ran" when they in fact ran and passed.
pool.shutdown(wait=True)
for f in futures:
    if f.done() and not f.cancelled() and f.exception() is None:
        results.extend(f.result())

# Workers complete out of order, so restore the CASES order before printing. A report
# whose row order changes run to run cannot be diffed against the previous run.
_order = {name: i for i, (name, *_rest) in enumerate(CASES)}
results.sort(key=lambda r: _order.get(r[0], len(CASES)))

untouched = tree_digest(ROOT) == before
after = failing_checks(ROOT)
if interrupted:
    print(f"\nINTERRUPTED ({interrupted}) after {len(results)} of {len(CASES)} cases.\n")

print(f"{'STATUS':<10} CHECK")
print("-" * 78)
bad = 0
for name, status, detail in results:
    if status != "PROVEN":
        bad += 1
    print(f"{status:<10} {name}\n           {detail}")
print("-" * 78)
print(f"{len(results) - bad} of {len(results)} proven by breaking")
print(f"working tree untouched: {'yes' if untouched else 'NO — run `git status`'}")
print(f"baseline still clean:   {'yes' if not after else 'NO — ' + str(sorted(after))}")

# An interrupted run exits 130, NOT 1. Collapsing them into one failing code makes a
# run somebody killed indistinguishable from a run that found a vacuous assertion —
# and the first is nothing while the second is the whole reason this tool exists.
if interrupted:
    sys.exit(130)
sys.exit(1 if bad or after or not untouched else 0)
