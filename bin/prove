# (check name, file, mode, payload)
#   "del"    -> remove the literal
#   "append" -> append the literal
CASES = [
    # Removing the write weighting spends the same attention on a read-only turn as on
    # one that rewrote the tree unclassified.
    # TARGET A LITERAL, NOT A LINE. Deleting the whole `rate = ...` line left another
    # `counts[5]` in the flag message, so the presence check still passed — vacuous. The
    # expression itself occurs once and removing it is the real regression: the sample
    # stops caring whether the turn changed anything.
    ("an unclassified ask can still be read by someone who did not answer it",
     WDN, "del", " if counts[5] else blind"),
    # Removing the blind sample restores the gap: an unclassified ask exits before the
    # sampler and is read by nobody but the turn that answered it.
    # THE THIRD CASE IS DROPPED, not padded. Deleting the BLIND_DOCKET binding leaves
    # `raise_flag(..., BLIND_DOCKET, ...)` referencing a name that is gone — the file
    # still parses, so bin/check runs, but it fails five OTHER assertions first and the
    # named one never reports. Fourth time this session that a mutation aimed at a
    # binding proved nothing; the two cases above target LITERALS whose removal changes
    # behaviour and leaves the file valid, which is the only shape that works here.
    # And deleting the empty-tag write takes the ask off disk, so the jury refuses.
    # MIS-ATTRIBUTED, AND THE BAD-CASE VERDICT IS WHAT SAID SO. This case deleted
    # `"senses": []` and was filed under the blind-sample check — it reported PROVEN
    # until the tagger assertions landed, then became a BAD-CASE: the literal is what
    # `the tagger reads the user's ask` asserts, so removing it fires THAT check and the
    # blind one never runs. Filed where it belongs, and the blind check gets its own
    # case below aimed at what it actually reads.
    # FILED TWICE WRONG BEFORE IT LANDED, and both times BAD-CASE said so rather than
    # VACUOUS. The literal is read by `wf-task-tag names the sense and never blocks the
    # ask` — not by the blind-sample check, and not by the question-vs-statement check.
    # A case pointed at the wrong assertion proves nothing about either.
    ("wf-task-tag names the sense and never blocks the ask",
     TTAG, "del", '"senses": []'),
    # The blind check reads for the ABSENCE of the delete call, so it is broken by
    # putting one back. Appended as a COMMENT: the substring is what the check reads,
    # and the file stays valid so the check can actually run.
    ("an unclassified ask can still be read by someone who did not answer it",
     TTAG, "append", "\n# os.remove(tag_path(payload))\n"),
    # Removing the judgment kind restores the gap: design asks carry no docket, so the
    # jury can never convene on the turns where a reading forms unchecked.
    ("the tagger reads the user's ask, and tells a question from a statement",
     TTAG, "del", '    ("judgment", re.compile(\n'),
    # ── the docket must come from the user's own words (2026-09-10) ──────────
    # Measured over 1,909 real prompts: 469 turns carried a docket built from injected
    # preamble the user never wrote. Deleting the guard restores that.
    ("the tagger reads the user's ask, and tells a question from a statement",
     TTAG, "del", "    if INJECTED.search(prompt or \"\"):\n        return []\n"),
    # And the `world` gate: a user STATING something is deprecated is not asking whether
    # it is. Deleting the two-line gate sends the turn to look up a supplied fact.
    ("the tagger reads the user's ask, and tells a question from a statement",
     TTAG, "del", '            if name == "world" and not ASKING.search(prompt or ""):\n                continue\n'),
    # Narrowing the record class is the regression: `changes/` and the git log stop
    # reading as testimony, and the guard goes back to blocking turns that consulted the
    # record. The whole alternative is deleted rather than a fragment of it — a fragment
    # left `\bgit\s+` matching more, not less, which is how the wf-catalog case failed.
    ("the ledger's detectors measure sources and set-reads, not shell verbs",
     TLDG, "del", r'    r"\bgit\s+(?:log|show|blame|diff)\b"' + "\n"),
    # ── the registry is RUN, not described (2026-09-10) ──────────────────────
    # bin/check asserted wf-live's SOURCE still said "BROKEN" and never executed it, so
    # the failing tier was a net nobody attached and three classes of defect sat
    # unreported until a human drew the option map by hand. This plants exactly the shape
    # it exists to catch: a live procedure telling a reader to Run a script that is gone.
    ("wf-live runs here, and nothing live tells a reader to run what is not there",
     VFY, "append", "\n\nRun `wf-handoff --wire --execute` before anything else.\n"),
    # A SECOND CASE deleting `def disagreements(` was VACUOUS and is not kept: it breaks
    # wf-live's syntax, so the subprocess dies, check fails for other reasons first, and
    # the NAMED assertion never runs. Third time this session that a mutation aimed at a
    # `def` line proved nothing — the target has to be the BEHAVIOUR, never the binding.
    # ── the display was not converted with the mechanism (2026-09-10) ─────────
    # Reported by the user reading a Stop line: the score went in 1.44.0 and the row of
    # counts stayed, so a converted mechanism was indistinguishable from an unconverted
    # one. Each break is one of the four things that made it read as a grade.
    ("wf-widen reports a decision in words, not a score",
     WDN, "del", "def describe(why, rows, unopened):"),
    ("wf-widen reports a decision in words, not a score",
     WDN, "del", "Returns (unopened, rows)"),
    # ONE PROVEN CASE, NOT TWO WITH A VACUOUS ONE. A case deleting
    # `def read_targets(name, inp):` orphans its body, so bin/check fails on syntax and
    # the NAMED check never runs — `did NOT fire — 2 other failures`. A case that cannot
    # reach its assertion proves nothing about it and pads the count while looking green.
    # The SET_CMD case below reaches the same check and fires, which is what makes it
    # non-vacuous; `read_targets`'s presence is asserted there too.
    # THE MUTATION MUST NARROW THE DETECTOR, NOT WIDEN IT. Two earlier targets failed for
    # opposite reasons and both are worth keeping written down. Deleting
    # `WRAPPERS = frozenset((` orphaned the body, so bin/check died on syntax and the NAMED
    # check never ran. Deleting `[A-Za-z]*[lcnro]` left `\bgrep\b[^|;\n]*?\s-`, which
    # matches ANY flagged grep — a BROADER regex, so `grep -c` still passed and the check
    # correctly did not fire. Removing the whole grep alternative is the real regression:
    # adjacent string literals concatenate, so the file still parses, and `grep -c` and
    # `grep -n` stop reading as set-reads exactly as they did before this was widened.
    ("the ledger's detectors measure sources and set-reads, not shell verbs",
     TLDG, "del", r'    r"|\bgrep\b[^|;\n]*?\s-[A-Za-z]*[lcnro]"' + "\n"),
    # ── wf-catalog: removal is per file, proven by byte identity (2026-09-10) ──
    # Each break below is one of the ways the FIRST design failed. An independent code
    # evaluation broke it before it shipped: append a prose project rule under an
    # existing heading and the copy introduced no new heading, classified as residue,
    # and `residue` then rmtree'd the skill — house rules, register, handbooks, and
    # hook scripts that had been excluded from the walk and so read by nothing. Every
    # gate protecting that verdict was a chance to fail open and three of them did.
    ("wf-catalog removes a file only when the install ships that exact file",
     CATL, "append", "\nshutil.rmtree  # reinstated whole-directory removal\n"),
    ("wf-catalog removes a file only when the install ships that exact file",
     CATL, "del", "def corpus_pairs(root, kind):"),
    ("wf-catalog removes a file only when the install ships that exact file",
