     HIR, "del", "Do not read an unmarked skill as a failed"),
    ("batch: a batch that did not run may never print UPHELD",
     CT, "del", "never evidence it was cheap"),
    ("succession: workforce supplies the last predecessor guarantee before deleting it",
     MAN, "del", "hook workforce/bin/wf-unique-persona"),
    ("canary: the fixtures ship with the install, so a first run can measure",
     STG2, "del", "THE INSTALLER SHIPS THEM"),
    ("install: both installers place canary files in the agents dir, not the skill",
     INS, "del", 'dest="$agents_dir/$(basename "$path")"'),
    ("hooks: no file asserts the distribution ships zero hooks or zero executables",
     INS, "append", "\n# NB: this project ships ZERO hooks\n"),
    ("install: a settings-merge failure is reported, never a mid-run death",
     INS, "del", "SETTINGS NOT CONFIGURED"),
    ("install: install.ps1 reports a settings-merge failure instead of dying",
     PS1, "del", "SETTINGS NOT CONFIGURED"),
    ("install: install.ps1 never exits the user's console",
     PS1, "append", "\n# a stray exit 1 in a comment is enough: the check bans the token\n# exit 1\n"),
]


def failing_checks():
    r = subprocess.run(["./bin/check"], cwd=ROOT, capture_output=True, text=True)
    return {ln.strip()[2:].strip()
            for ln in r.stdout.splitlines() if ln.strip().startswith("✗ ")}


baseline = failing_checks()
if baseline:
    print(f"REFUSING: bin/check is not green to begin with: {sorted(baseline)}")
    sys.exit(1)
print("baseline: 0 failures\n")

results = []
for name, relpath, mode, payload in CASES:
    target = ROOT / relpath
    backup = tempfile.NamedTemporaryFile(delete=False).name
    shutil.copy2(target, backup)
    try:
        text = target.read_text()
        if mode == "del":
            if payload not in text:
                results.append((name, "SETUP-FAIL", f"literal absent from {relpath}"))
                continue
            target.write_text(text.replace(payload, "", 1))
        else:
            target.write_text(text + payload)

        fails = failing_checks()
        if name in fails:
            results.append((name, "PROVEN", f"fired on mutated {relpath}"))
        else:
            results.append((name, "VACUOUS", f"did NOT fire — {len(fails)} other failures"))
    finally:
        shutil.copy2(backup, target)
        pathlib.Path(backup).unlink()

after = failing_checks()
print(f"{'STATUS':<10} CHECK")
print("-" * 78)
bad = 0
for name, status, detail in results:
    if status != "PROVEN":
        bad += 1
    print(f"{status:<10} {name}\n           {detail}")
print("-" * 78)
print(f"{len(results) - bad} of {len(results)} proven by breaking")
print(f"restored clean: {'yes' if not after else 'NO — ' + str(sorted(after))}")
sys.exit(1 if bad or after else 0)
