#!/usr/bin/env python3
"""Prove each new bin/check assertion by breaking its target and confirming it fires.

An assertion never observed failing might be testing nothing (CLAUDE.md).
Each case mutates one file, runs bin/check, asserts the NAMED check appears in the
failure list, then restores the file byte-for-byte.
"""
import pathlib, shutil, subprocess, sys, tempfile

ROOT = pathlib.Path("/home/francis/lab/claude-workforce")

CT  = "workforce/references/conversion-taxonomy.md"
PL  = "workforce/references/platform.md"
AUD = "workforce/references/procedures/audit.md"
STG = "workforce/references/staging.md"
DFR = "workforce/references/deferred.md"
ASU = "workforce/references/audit-setup.md"
ENF = "workforce/references/enforcement.md"
DSB = "workforce/references/procedures/disband.md"
ORG = "workforce/references/org-doctrine.md"   # victim for the append case
CFG = "workforce/references/org-config.template.md"
SCO = "workforce/references/scopes.md"
BUD = "workforce/references/procedures/budget.md"
HK  = "workforce/references/procedures/hooks.md"
INS = "install"
PS1 = "install.ps1"
CEN = "workforce/bin/wf-census"
SWP = "workforce/references/procedures/sweep.md"
SKL = "workforce/SKILL.md"
INV = "workforce/references/invariants.md"

# (check name, file, mode, payload)
#   "del"    -> remove the literal
#   "append" -> append the literal
CASES = [
    ("conversion-taxonomy forbids splitting a run across sessions",
     CT, "del", "a run is never split across sessions, and no gate may defer one"),
    ("conversion-taxonomy states the backup is what makes the batch safe",
     CT, "del", "reversible by construction"),
    ("no shipped file authorizes splitting a run across sessions",
     ORG, "append", "\nWhere the batch is large, split it across sessions.\n"),
    ("platform fact 8 is marked as a repeat blocking-check offender",
     PL, "del", "REPEAT OFFENDER"),
    ("audit has a Step 6a that re-attempts the canary in-run",
     AUD, "del", "## Step 6a — Canary re-attempt"),
    ("audit Step 6a restamps handbooks rather than queueing an amend",
     AUD, "del", "The restamp IS `/workforce amend`, executed here rather than asked for"),
    ("staging obliges a second canary attempt before DEGRADED",
     STG, "del", "obliges a SECOND attempt inside the same run"),
    ("deferred forbids a row discharged by re-running its own command",
     DFR, "del", "may never be discharged by re-running the command that wrote it"),
    ("deferred requires the precondition in the discharge cell",
     DFR, "del", "it names the command but not what must change first"),
    ("audit-setup removes the agent-teams flag under declared succession",
     ASU, "del", "REMOVE the key, and record it in `.settings-owned.json`"),
    ("audit-setup scopes the removal to declared succession only",
     ASU, "del", "report only, and name the likely source"),
    ("audit-setup scopes the env removal to the file that holds the key",
     ASU, "del", "personal-scope `env` key is never edited by a project-scope run"),
    ("the settings sidecar can express a removal, not only an addition",
     ENF, "del", '"env_removed"'),
    ("disband restores env_removed with its prior value",
     DSB, "del", "replay `env_removed` in the opposite direction"),
    ("org-config: a recommendation is a label, never a list position",
     CFG, "del", "never a position"),
    ("audit-setup: the model budget never reorders to surface a recommendation",
     ASU, "del", "a recommendation never changes it"),
    ("org-config: each lane recommendation names a model from the statics pool",
     CFG, "del", "**Recommended for code**"),
    ("org-config: the effort ladder is ordered most expensive first",
     CFG, "del", "`max`, `xhigh`, `high`, `medium`, `low`"),
    ("audit-setup: the effort budget orders its rungs most expensive first",
     ASU, "del", "The rungs are offered most expensive first"),
    ("scopes: no shipped file invokes a script by a bare project-scope path",
     ORG, "append", "\n.claude/skills/workforce/bin/wf-census --root x\n"),
    ("scopes: the canonical script resolver is stated, and personal resolves first",
     SCO, "del", 'WF="$HOME/.claude/skills/workforce"; [ -d "$WF" ] || WF="${CLAUDE_PROJECT_DIR}/.claude/skills/workforce"'),
    ("scopes: every file using $WF also defines it",
     BUD, "del", 'WF="$HOME/.claude/skills/workforce"; [ -d "$WF" ] || WF="${CLAUDE_PROJECT_DIR}/.claude/skills/workforce"'),
    ("hooks: the registration path resolves personal before project",
     HK, "del", "| 1 | `~/.claude/skills/workforce/bin/wf-protect-directives` |"),
    ("install: install verifies every manifest file landed",
     INS, "del", "INCOMPLETE INSTALL"),
    ("install: install.ps1 verifies every manifest file landed",
     PS1, "del", "INCOMPLETE INSTALL"),
    ("census: hook rows carry a resolved path and an existence verdict",
     CEN, "del", '"exists": exists'),
    ("census: undecidable-is-not-dead has a regression fixture asserting both ways",
     "fixtures/scripts/expectations.json", "del", "census-deadhook"),
    ("hooks: a step produces the dead-wiring count its report declares",
     HK, "del", "never reported as dead"),
    ("hooks: workforce never fabricates a missing hook script",
     HK, "del", "Never fabricate a replacement"),
    ("census: a hook names the skill directory it resolves into",
     CEN, "del", '"skill": owner'),
    ("sweep: refuses a target that still holds a live registration",
     SWP, "del", "no live registration still resolves inside a target"),
    ("sweep: the relocation input set is computed, not eyeballed",
     SWP, "del", "Do not use the `in_skill_dir` flag for this"),
    ("conversion: the hooks-do-not-move rule states the fate it is scoped to",
     CT, "del", '**"They do not move" is scoped to SPLIT, where the skill survives'),
    ("succession: is declared and reported, never asked",
     ASU, "del", "**Succession is never a question.**"),
    ("succession: the not-optional directive is captured verbatim",
     SKL, "del", "a succession wasn't optional when installing this"),
    ("budget: INV-BUDGET fails on a SURPLUS question, not only a missing one",
     ASU, "del", "fails in BOTH directions"),
    ("hooks: a dead hook under succession is workforce's to supply, not to report",
     HK, "del", "workforce owes that capability"),
]


def failing_checks():
    r = subprocess.run(["./bin/check"], cwd=ROOT, capture_output=True, text=True)
    return {ln.strip()[2:].strip()
            for ln in r.stdout.splitlines() if ln.strip().startswith("✗ ")}


baseline = failing_checks()
if baseline:
    print(f"REFUSING: bin/check is not green to begin with: {sorted(baseline)}")
    sys.exit(1)
print("baseline: 0 failures\n")

results = []
for name, relpath, mode, payload in CASES:
    target = ROOT / relpath
    backup = tempfile.NamedTemporaryFile(delete=False).name
    shutil.copy2(target, backup)
    try:
        text = target.read_text()
        if mode == "del":
            if payload not in text:
                results.append((name, "SETUP-FAIL", f"literal absent from {relpath}"))
                continue
            target.write_text(text.replace(payload, "", 1))
        else:
            target.write_text(text + payload)

        fails = failing_checks()
        if name in fails:
            results.append((name, "PROVEN", f"fired on mutated {relpath}"))
        else:
            results.append((name, "VACUOUS", f"did NOT fire — {len(fails)} other failures"))
    finally:
        shutil.copy2(backup, target)
        pathlib.Path(backup).unlink()

after = failing_checks()
print(f"{'STATUS':<10} CHECK")
print("-" * 78)
bad = 0
for name, status, detail in results:
    if status != "PROVEN":
        bad += 1
    print(f"{status:<10} {name}\n           {detail}")
print("-" * 78)
print(f"{len(results) - bad} of {len(results)} proven by breaking")
print(f"restored clean: {'yes' if not after else 'NO — ' + str(sorted(after))}")
sys.exit(1 if bad or after else 0)
