    # failure: an unread log, or a lens with no input.
    ("org log: org.md defines the mode and its telemetry path",
     ORGP, "del", "The receptionist's `log` mode"),
    ("org log: the emitter is derived — it records, it never assesses",
     ORGP, "del", "RECORDS. It never assesses"),
    ("org log: telemetry stays in the project, never a user-level collection dir",
     ORGP, "del", "personal-install shadowing"),
    ("org log: principal_verdict resolves to the same source as INV-EVALS",
     ORGP, "del", "row 30"),
    ("org log: the retention rule that makes work/ collapsible is stated",
     ORGP, "del", "reclaimable"),
    ("org log: the generated receptionist carries the mode",
     TPL2, "del", "org log"),

    ("context-wiring: INV-SEAM row names its text and token in invariants.md",
     INV, "del", "every declared deletable content slot"),
    # ── contract-stamp: six readers, one writer (2026-09-05) ──────────────────────
    # MEASURED on odyssey-alive the day after its audit amended all 19 handbooks:
    # ok 0 - mismatch 13 - unstamped 2. Each case below breaks a DIFFERENT way the
