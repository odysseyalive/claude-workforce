# ─────────────────────────────────────────────────────────────────────────────
# THE HANDBOOK VERIFICATION GAP — resolved, run, falsified
#
# Until 2026-08-04 the ENTIRE mechanical coverage of `## Verification` — the section
# `verification.md` opens by calling the highest-leverage one in any handbook — was
# `wf-conform`'s "is not empty", which the word "yes" satisfies. So a handbook could
# name a check that did not exist, or one that could not fail, and every instrument
# printed clean.
#
# It was not hypothetical: `content-writer` shipped three commands that exited 0 on a
# file of pure em-dashes. Every one resolved, every one ran, every one passed. Found
# by a cold reader, because nothing mechanical could see it.
# ─────────────────────────────────────────────────────────────────────────────
_ckr = read("workforce/bin/wf-checkrun")


def _safe_parse(_src):
    try:
        _a2.parse(_src)
        return True
    except SyntaxError:
        return False
_cfm = read("workforce/bin/wf-conform")

check(
    "wf-checkrun is shipped in the manifest",
    "exec workforce/bin/wf-checkrun" in read("manifest.txt"),
    "a script absent from the manifest is not installed on any host, so the "
    "procedure that names it resolves to nothing — the absent-producer shape",
)
# ── defects a cold read found in files this change did not introduce ─────────
check(
    "every --root script refuses an empty root",
    all("AN EMPTY --root IS A CALLER ERROR" in read(f"workforce/bin/{_s}")
        for _s in ("wf-census", "wf-checkrun", "wf-conform", "wf-context", "wf-claude-md")),
    "`${CLAUDE_PROJECT_DIR}` is UNSET outside a hook, so every shipped block expands "
    "to `--root \"\"`; abspath('') is the CWD, which passes an is-a-directory guard. "
    "Measured: wf-conform exited 0 reporting `0 governed · 0 failed` on a tree nobody "
