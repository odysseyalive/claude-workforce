# THE PROPERTY SURVIVES; THE CARRIER MOVED. These three keyed on CLAUDE.md, which the
# 2026-08-05 directive evacuates and DELETES — and this repository's own
# `/workforce dev audit` did exactly that on 2026-08-06, at which point all three
# failed BECAUSE THE EVACUATION SUCCEEDED. Their comment already said the right thing:
# "the assertion follows the carrier." Deleting them would drop a real property; the
# fix is to point each at the component that inherited it.
# THE FENCE IS A STRUCTURAL CLAIM AND NOTHING CHECKED IT. `doctrine-author`'s
# `## Guardrails` carries the project's Non-negotiables relocated verbatim out of the
# deleted CLAUDE.md, between an explicit start/end fence, and the fence exists so the
# span can be compared mechanically. MEASURED 2026-08-06 by a cold reader: three
# handbook-authored lines had already drifted inside it, and `grep "start of the
# user's" bin/check` returned zero hits. **CLAUDE.md no longer exists on disk**, so
# that span is the only copy outside git history — which makes the fence load-bearing
# rather than cosmetic.
_da = ".claude/agents/doctrine-author.md"
_fenced = _orig = None
if os.path.exists(_da):
    _hb = read(_da).splitlines()
    try:
        _i = next(n for n, l in enumerate(_hb) if l.startswith("**— start of the user's verbatim"))
        _j = next(n for n, l in enumerate(_hb) if l.startswith("**— end of the user's verbatim"))
        _fenced = [l for l in _hb[_i + 1:_j] if l.strip()]
    except StopIteration:
        _fenced = None
    # RESOLVE THE LAST REVISION THAT STILL HAD THE FILE, never `HEAD:` — the commit
    # that lands the evacuation DELETES CLAUDE.md, so `HEAD:CLAUDE.md` stops existing
    # the moment this work is committed and the assertion would fail on its own
    # landing. Found before committing, by asking what this check reads after it.
    _rev = subprocess.run(["git", "rev-list", "-n", "1", "HEAD", "--", "CLAUDE.md"],
                          capture_output=True, text=True).stdout.strip()
    _old = []
    for _ref in ([f"{_rev}:CLAUDE.md", f"{_rev}^:CLAUDE.md"] if _rev else []):
        _r = subprocess.run(["git", "show", _ref], capture_output=True, text=True)
        if _r.returncode == 0 and "## Non-negotiables" in _r.stdout:
            _old = _r.stdout.splitlines()
            break
    try:
        _a = next(n for n, l in enumerate(_old) if l.startswith("## Non-negotiables"))
        _b = next(n for n, l in enumerate(_old) if l.startswith("## Naming hazards"))
        _orig = [l for l in _old[_a + 1:_b] if l.strip()]
    except StopIteration:
        _orig = None
check(
    "doctrine-author's fenced span is the user's Non-negotiables, byte-for-byte",
    _fenced is not None and _orig is not None and _fenced == _orig,
    f"fenced {len(_fenced or [])} non-blank lines against {len(_orig or [])} in "
    "HEAD:CLAUDE.md § Non-negotiables. The fence exists so this comparison can be made; "
    "an unenforced fence drifts, and it already had. These are the user's own words and "
    "the file they came from has been deleted",
)

check(
    "the standing cold-reader request reaches an ALWAYS-ON carrier",
    "this line is the asking" in read("workforce/bin/wf-standing-request"),
    "ambient policy permits spawning *unless the user asks*, so the request only "
    "functions where it is injected. It now lives in a UserPromptSubmit hook, which "
    "re-injects it every turn — strictly better than a file read once at the head of "
    "a conversation",
)
check(
    "this repo has no CLAUDE.md — it was evacuated, not merely trimmed",
    not os.path.exists("CLAUDE.md"),
    "the 2026-08-05 directive is zero, not 'sparse': every line relocated to the "
    "component that owns it and the file deleted. This repo ships the generator, so a "
    "CLAUDE.md here means the one project guaranteed to exercise `wf-claude-md` is the "
    "one project not living by its result",
)
check(
    "the source-first rule reaches the employee that owns it",
    "Always edit source, then `bin/sync --personal`" in read(".claude/agents/runtime-lead.md"),
    "bin/sync deletes the runtime tree and rebuilds it, so a runtime-first edit is "
    "destroyed rather than merged. The rule now arrives with the spawn that needs it; "
    "a handbook does not decay as context grows, which is the argument for the move",
)

# ─────────────────────────────────────────────────────────────────────────────
# Report
# ─────────────────────────────────────────────────────────────────────────────
print(f"claude-workforce conformance — {len(declared)} shipped files\n")
if FAILS:
    print(f"FAIL ({len(FAILS)}):")
    for name, detail in FAILS:
        print(f"  ✗ {name}")
        if detail:
            print(f"      {detail}")
    print()
if WARNS:
    print(f"warnings ({len(WARNS)}):")
    for name, detail in WARNS:
        print(f"  · {name}" + (f" — {detail}" if detail else ""))
    print()
print(f"{PASSES} passed, {len(FAILS)} failed, {len(WARNS)} warnings")
sys.exit(1 if FAILS else 0)
