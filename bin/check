# THE CONSTITUTION GATE IS RETRACTED, AND THIS ASSERTION USED TO REQUIRE IT.
# It read "templates: a procedure actually writes the Constitution Gate" and passed
# on `"WORKFORCE-CONSTITUTION" in aud` — correct when the gate was policy, and after
# the 2026-08-05 evacuation directive it was enforcement holding a producer of the
# file the same run deletes. Found 2026-08-06 by RUNNING `/workforce dev audit` on
# this repository; four earlier commits closed four producers by grepping for the
# sentence `Write \`CLAUDE.md\` if absent`, and templates.md said it in a table cell
# (`no CLAUDE.md at all | create one`) while charter.md said it as "refresh".
_tpl = read("workforce/references/templates.md")
check(
    "templates: the Constitution Gate is retracted, not merely unused",
    "RETRACTED 2026-08-06" in _tpl
    and "WORKFORCE WRITES NOTHING INTO `CLAUDE.md`" in _tpl
    and "The belt was a copy of" in _tpl,
    "a retracted mechanism that still reads as current is one the next run "
    "reinstates; and the retraction has to name where the three rules went, or it "
    "is a deletion with a rationale rather than a transform with a verification",
)

# THE CLASS, KEYED ON THE ACT RATHER THAN ON ANY WORDING. Four producers were closed
# by three greps for three phrasings, and two more survived saying the same thing in
# other words. This scans every shipped file for an instruction to CREATE or WRITE
# that file, however phrased, and it is the check that would have caught all six.
# TWO DIRECTIONS, because the producer that survived four fixes ran the other way.
# Verb-then-file catches `Write \`CLAUDE.md\` if absent` and `Refresh CLAUDE.md's ...`;
# it MISSES `| no \`CLAUDE.md\` at all | create one, ... |`, where the filename sits in
# one table cell and the verb in the next. Measured 2026-08-06 against all six known
# producers: the one-directional form scored 5 of 6, and the miss was the exact row
# that had already outlived three greps. A class check validated only against the
# cases that motivated it inherits their blind spot.
_SACRED_SPAN_RX = re.compile(
    r"^<!--\s*origin:\s*user\b[^>]*immutable:\s*true[^>]*-->$.*?^<!--\s*/origin\s*-->$",
    re.S | re.M)
_CMD_VERBS = r"(?:creat|writ|append|refresh|regenerat|emit)\w*"
_CMD_WRITE_RX = re.compile(
    _CMD_VERBS + r"\s+(?:(?:a|an|the|one|it|them|this|that|new)\s+){0,3}"
    r"[^.\n]{0,40}`?CLAUDE\.md`?"
    r"|`?CLAUDE\.md`?[^.\n]{0,60}?" + _CMD_VERBS,
    re.I)
_claude_md_producers = []
for _p in sorted(glob.glob("workforce/**/*.md", recursive=True)) + [
        "install", "install.ps1", "README.md"]:
    try:
        _b = open(_p, encoding="utf-8").read()
    except OSError:
        continue
    # A SACRED BLOCK IS THE USER SPEAKING, NEVER A PROCEDURE STEP. The 2026-08-05
    # directive itself contains "claude.md, skills, hooks, scripts, from being
    # created" — quoting the act it authorises. Masking these is mandatory rather
    # than convenient: the block may never be edited to satisfy a checker, so a
    # match inside one is a finding nothing is permitted to close.
    _b = _SACRED_SPAN_RX.sub("", _b)
    for _m in _CMD_WRITE_RX.finditer(_b):
        _frag = " ".join(_m.group(0).split())
        _ctx = _b[max(0, _m.start() - 300):_m.start() + 300]
        # A RETRACTION QUOTES THE THING IT RETRACTS, and a negation is not a producer.
        # Past tense is the tell: "IT USED TO DEMAND A CLAUDE.md" is a history note
        # that exists precisely BECAUSE the behaviour was removed, and deleting it
        # would lose the record this project keeps deliberately.
        if any(k in _ctx for k in ("RETRACTED", "Amended 2026-08-0", "never", "Never",
                                   "NOTHING", "nothing", "not create", "no procedure",
                                   "creating nothing", "already evacuated", "legacy",
                                   "USED TO", "used to", "stops", "no longer",
                                   "EVACUATES AND DELETES", "supersed")):
            continue
        _claude_md_producers.append(f"{_p}: {_frag[:70]}")
check(
    "no shipped file instructs writing or creating CLAUDE.md",
    not _claude_md_producers,
    f"{_claude_md_producers[:4]} — the 2026-08-05 directive evacuates CLAUDE.md and "
    "DELETES it, so any instruction to create, write, append to, or refresh it makes "
    "one audit produce the artifact the same audit removes, and puts the file back on "
    "every run of an already-evacuated project. Six producers have now been found; "
    "the first four were closed by grepping for their exact sentences, which is why "
    "this check is keyed on the verb and the filename instead",
)

# The retracted "restart required" claim has returned FIVE times across nine
# files, caught every time by a human re-reading and never by a mechanism —
# `grep -n restart bin/check` returned nothing until now. platform.md fact 3
# measures the opposite: both agents and skills register later in the same
# session. Prose that PROHIBITS the claim is fine; prose that ASSERTS it is not.
_RESTART_ASSERT = re.compile(
    r"(?:not live-reloaded"
    r"|unreachable until (?:Claude Code )?restart"
    r"|[Rr]estart Claude Code to reach"
    r"|restart is required"
    r"|requires? a restart)",
)
_RESTART_OK = re.compile(r"(?:[Nn]ever write|is retracted|retracted|prohibit|would be false)")
_restart_hits = []
for _p in declared:
    if not _p.endswith(".md"):
        continue
    for _ln, _line in enumerate(read(_p).splitlines(), 1):
        if _RESTART_ASSERT.search(_line) and not _RESTART_OK.search(_line):
            _restart_hits.append(f"{_p}:{_ln}")
check(
    "platform: no shipped file asserts that a restart is required",
    not _restart_hits,
    f"retracted claim asserted at: {_restart_hits} — platform.md fact 3 measures "
    "delayed registration, not a restart requirement. It has returned five times; "
    "state the prohibition or the retraction on the same line, or reword.",
)

# The budget can only offer IDs that exist in the statics pool. The pool was
