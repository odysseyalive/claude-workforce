# ONE GRAMMAR, BYTE-FOR-BYTE. wf-conform and wf-checkrun both read `## Verification`;
# they diverged for an hour (one byte-exact, one tolerant) and disagreed about
# whether a decorated heading had a section at all.
_grammar = r'r"^" + re.escape(heading) + r"[ \t]*[^\n]*$(.*?)(?=^## |\Z)"'
