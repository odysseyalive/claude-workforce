#!/usr/bin/env python3
"""
Conformance check for claude-workforce.

This is the project's OWN verification — the runnable check its handbooks
demand of every employee. Run it before every commit:

    python3 bin/check          # or: bin/check

Exit 0 = conformant. Exit 1 = at least one FAIL.

Every check here exists because its failure mode is SILENT: the repo looks
fine and something is wrong. Most were discovered by hand during the build
and are recorded here so they cannot recur unnoticed.
"""

import json
import os
import re
import subprocess
import sys
import glob

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
os.chdir(ROOT)

# `bin/check --stamp` regenerates workforce/.immutable.sha and exits. Deliberately
# a separate invocation: a check that re-stamps what it is checking cannot detect
# drift. checksums.md's rule — flag, never repair — applies to this project's own
# blocks too, so the stamp is a human act.
if "--stamp" in sys.argv:
    import hashlib as _hl
    _rx = re.compile(
        r"^<!--\s*origin:\s*user\b[^>]*immutable:\s*true\s*-->$(.*?)^<!--\s*/origin\s*-->$",
        re.S | re.M)
    _rows = []
    for _f in sorted(glob.glob("workforce/**/*.md", recursive=True)):
        with open(_f, encoding="utf-8") as _fh:
            for _m in _rx.finditer(_fh.read()):
                _b = "\n".join(l.rstrip() for l in _m.group(1).strip().splitlines())
                _rows.append((_f, _hl.sha256(_b.encode()).hexdigest(), _b.splitlines()[0][:60]))
    with open("workforce/.immutable.sha", "w", encoding="utf-8") as _fh:
        _fh.write(
            "# sha256 of every shipped `origin: user | immutable: true` block.\n"
            "# Normalisation: strip markers, rstrip each line, strip leading/trailing blanks.\n"
            "# Regenerate with `bin/check --stamp` ONLY after an intended change.\n"
            + "".join(f"{h}  {p}  {t}\n" for p, h, t in _rows))
    print(f"stamped {len(_rows)} immutable blocks")
    sys.exit(0)

FAILS = []
WARNS = []
PASSES = 0


def check(name, ok, detail=""):
    global PASSES
    if ok:
        PASSES += 1
    else:
        FAILS.append((name, detail))


def warn(name, detail=""):
    WARNS.append((name, detail))


def read(p):
    """Read a file, or return "" if it is not there.

    A DIAGNOSTIC MUST NOT DIE ON THE INPUT IT EXISTS TO DIAGNOSE. Any missing
    declared file — a typo, a deleted path, a manifest flag prefix — used to raise
    FileNotFoundError from whichever later check read it first, killing the run
    before the report printed. The dedicated existence check would already have
    recorded the FAIL; the traceback threw it away and reported nothing else
    either. Missing files are reported by check 1 and read as empty everywhere.
    """
    if not os.path.isfile(p):
        return ""
    with open(p, encoding="utf-8", errors="replace") as f:
        return f.read()


# ─────────────────────────────────────────────────────────────────────────────
# CANCEL-BY-PROSE: the systemic defeat of every substring assertion in this file.
#
# A doctrine audit demonstrated it across five separate guarded rules: keep the
# guarded substring, wrap it in a sentence that revokes it, and the check passes.
#     "Historically the extraction gate precedes every deletion; it is now
#      advisory and the sweep proceeds regardless."
# The guard for this was written once, for one block, and never generalised —
# which is the written-and-unwired pattern applied to the pattern's own fix.
#
# These phrases have no legitimate use in shipped doctrine. Historical narration
# belongs in measurements/ and plan/, which are not shipped.
CANCEL_RX = re.compile(
    r"(?:Historically[^.]{0,120}(?:no longer|is now advisory)"
    r"|is no longer expected"
    r"|it is now advisory"
    r"|was the old rule"
    r"|the old rule said"
    r"|the sweep proceeds regardless"
    r"|need not sum"
    r"|whichever is convenient"
    r"|[Tt]hat is retracted"
    r"|is withdrawn"
    r"|An earlier draft said"
    r"|reserved for findings the audit cannot"
    r"|treat the labels above as approximate)",
    re.I,
)


def manifest_paths():
    """Shipped files.

    `exec ` and `hook ` are both in use and are stripped here so every downstream
    check sees a plain path. `keep ` remains unused and is caught below rather than
    silently parsed.
    """
    out = []
    for line in read("manifest.txt").splitlines():
        s = line.strip()
        if not s or s.startswith("#"):
            continue
        for flag in ("exec ", "hook "):
            if s.startswith(flag):
                s = s[len(flag):].strip()
                break
        out.append(s)
    return out


def _flagged(flag):
    return [
        l.strip()[len(flag) + 1:].strip()
        for l in read("manifest.txt").splitlines()
        if l.strip().startswith(flag + " ")
    ]


def manifest_exec_paths():
    """Paths carrying `exec` — invoked by a procedure, registered to nothing."""
    return _flagged("exec")


def manifest_hook_paths():
    """Paths carrying `hook` — registered to a harness event by `/workforce hooks`."""
    return _flagged("hook")


# ─────────────────────────────────────────────────────────────────────────────
# EVERY shipped-file read, in ONE block. Assertions below may appear in any
# order without a NameError — which happened three times on 2026-07-31, each
# time because a new assertion was written above the read it depended on.
# `read()` returns "" for a missing path, so this is cheap and total.
# ─────────────────────────────────────────────────────────────────────────────
readme = read("README.md")
skill = read("workforce/SKILL.md")
tpl = read("workforce/references/handbook-templates.md")
pfp = read("workforce/references/procedure-for-procedures.md")
plat_body = read("workforce/references/platform.md")
enf = read("workforce/references/enforcement.md")
plat = read("workforce/references/platform.md")
disc = read("workforce/references/discovery.md")
_org = read("workforce/references/procedures/org.md")
# THE BLOCK, not the file. Every assertion below used to match `_org`, which is the
# whole procedure — including the prose that EXPLAINS the block. So all nine of them
# passed against explanations while the byte-canonical block that actually ships into
# the user's /org went unchecked. Measured 2026-08-03: the first real run wrote a
# paraphrase into /org with no markers, and nothing objected, because nothing was
# looking at the artifact. An assertion that cannot fail is not an assertion.
# Anchor on the AUTO-GENERATED marker, not the bare name: line ~116 names both
# markers in prose on one line, so a naive split() returned the empty span between
# them and every assertion below passed against "". The extractor for a check has
# to be as exact as the check.
_m_blk = re.search(
    r"<!-- ORG-DISPATCH-CHECKPOINT START — auto-generated.*?-->\n(.*?)\n<!-- ORG-DISPATCH-CHECKPOINT END -->",
    _org, re.S,
)
_org_block = _m_blk.group(1) if _m_blk else ""
_org_sk = read("workforce/SKILL.md")
_ocf = read("workforce/references/org-chart-format.md")
_pfp2 = read("workforce/references/procedure-for-procedures.md")
_stg = read("workforce/references/staging.md")
_hire2 = read("workforce/references/procedures/hire.md")
_pt = read("workforce/references/personnel-templates.md")
_cf = read("bin/conformance")
_asu = read("workforce/references/audit-setup.md")
_ev = read("workforce/references/evaluators.md")
_bl = read("bin/baseline")
_vfy2 = read("workforce/references/procedures/verify.md")
_od = read("workforce/references/org-design.md")
_hb = read("workforce/references/procedures/handbook.md")
vfy = read("workforce/references/procedures/verify.md")
inv = read("workforce/references/invariants.md")
pfp = read("workforce/references/procedure-for-procedures.md")
da = read("workforce/agents/doctrine-auditor/AGENT.md")
_cov_src = read("bin/coverage")
_hire = read("workforce/references/procedures/hire.md")
_tpl_cfg = read("workforce/references/org-config.template.md")
_plat = read("workforce/references/platform.md")
abl = read("workforce/references/ablation.md")
_abl2 = read("workforce/references/procedures/ablate.md")
rev = read("workforce/references/procedures/review.md")
dbg = read("workforce/references/delegation-budget.md")
_bud = read("workforce/references/procedures/budget.md")
_amd = read("workforce/references/procedures/amend.md")
_ocfg = read("workforce/references/org-config.template.md")
dfr = read("workforce/references/deferred.md")
upd = read("workforce/references/procedures/update.md")

# ─────────────────────────────────────────────────────────────────────────────
# 1. Manifest is the single authoritative shipped-file list
# ─────────────────────────────────────────────────────────────────────────────
declared = manifest_paths()

# ─────────────────────────────────────────────────────────────────────────────
# VENDORED — copied verbatim from claude-enforcer, not authored here.
#
# These are the portable evaluator corpora. They follow the SOURCE project's
# conventions (single-line `origin:` annotations rather than paired blocks,
# its own heading structure, its own version anchors), and workforce's authoring
# rules must not be applied to them: every one of those checks would demand an
# edit, and editing a vendored file forks a corpus that has one origin.
#
# What still applies: manifest completeness, existence, and § Vendored catalogs'
# own assertions (anchor present, byte-identical to source where the source is
# reachable). What does not: origin pairing, duplicate headings, restated
# constants, the coverage header, and the length warning.
# ─────────────────────────────────────────────────────────────────────────────
VENDORED = {p_ for p_ in declared if p_.startswith("workforce/references/catalogs/")}

missing = [p for p in declared if not os.path.exists(p)]
check("manifest: every declared file exists", not missing, f"missing: {missing}")

_keep_flagged = [l.strip() for l in read("manifest.txt").splitlines() if l.strip().startswith("keep ")]
check(
    "manifest: no `keep` flag without its handling",
    not _keep_flagged,
    f"keep-flagged lines: {_keep_flagged} — no shipped file is user-editable "
    "(project state lives in the project, references/scopes.md). Re-adding the flag "
    "means re-adding its handling to bin/check and bin/sync in the same change",
)

on_disk = {
    p for p in glob.glob("workforce/**/*", recursive=True)
    if os.path.isfile(p) and not os.path.basename(p).startswith(".")
}
undeclared = sorted(on_disk - set(declared))
check(
    "manifest: no shipped file is undeclared",
    not undeclared,
    f"on disk but not in manifest (installers would never fetch these): {undeclared}",
)

# ─────────────────────────────────────────────────────────────────────────────
# 2. Constants are stated once (forward mobility)
#
# A platform change must be a small declared sweep, not a hunt. platform.md is
# the source of truth; the installers cannot read markdown at install time; the
# user-facing docs describe the product to a human; scopes.md documents the
# exception list.
# ─────────────────────────────────────────────────────────────────────────────
CONST_EXEMPT = {
    "workforce/references/platform.md",
    "workforce/references/scopes.md",
    # The sanctioned home for model IDs, per platform.md § Derived constants:
    # "the same applies to model IDs (which live in org-config.md, never in
    # prose)". org-config.md is the per-project instantiation; THIS is the
    # template it is instantiated from, so it is the one file that must carry
    # them. Omitting it here is what kept the shipped statics empty — the
    # payroll picker had nothing to propose and no way to acquire it, because
    # the check forbade the fix in the only legal place for it.
    "workforce/references/org-config.template.md",
    "install",
    "install.ps1",
    "README.md",
    "COMMANDS.md",
}
CONST_RX = re.compile(
    r"\bthree tiers\b|\bthree-tier\b|\b20 concurrent\b|\b200 subagents?\b"
    # Model IDs are constants too — platform.md § Derived constants says so
    # explicitly ("and to model IDs, which live in org-config.md, never in
    # prose"). The rule was written; the check never covered it, leaving the one
    # class of constant most likely to churn unguarded.
    r"|\bclaude-(?:opus|sonnet|haiku|fable)-[\w.\[\]-]*\d",
    re.I,
)
offenders = [
    p for p in declared
    if p.endswith(".md") and p not in CONST_EXEMPT and p not in VENDORED
    and CONST_RX.search(read(p))
]
check(
    "constants: stated once, outside the declared exceptions",
    not offenders,
    f"restated in: {offenders} — see platform.md § Derived constants",
)

# ─────────────────────────────────────────────────────────────────────────────
# 3. Cross-references resolve
#
# Backticks are NOT required. The original pattern demanded them, so nine bare
# `references/…md` mentions went unvalidated — SEVEN of them in SKILL.md, the
# file whose grounding paths matter most. A path is a path whether or not it is
# quoted.
# ─────────────────────────────────────────────────────────────────────────────
REF_RX = re.compile(r"(?<![\w/])references/[\w./-]+\.md")
broken = []
for p in glob.glob("workforce/**/*.md", recursive=True) + [
    "README.md", "COMMANDS.md", "CLAUDE.md",
]:
    for m in REF_RX.findall(read(p)):
        if not os.path.exists("workforce/" + m):
            broken.append((p, m))
check(
    "references: every references/… link resolves, backticked or bare",
    not broken,
    f"broken: {broken}",
)

# Section anchors. `REF_RX` above resolves the PATH half of a citation and never
# the `§ Section` half, so every heading in the project could be renamed with the
# check green. Four separate doctrine audits flagged this independently as the
# largest unguarded class of cross-reference; it found 16 broken anchors on first
# run, six of them citing a `§ Header` section in platform.md that did not exist.
#
# Generators strict, readers liberal: a citation resolves if ANY heading in the
# target starts with ANY word-prefix of the cited text. Prose reliably trails a
# citation ("§ Phase A against the staged file"), and demanding an exact match
# would report the prose as the defect.
CITE_RX = re.compile(
    r"`?([\w./-]+\.md)`?\s*§\s*"
    r"(`[^`\n]+`|(?:[^.,;()*|\n]|\.(?=\S))+(?:\n(?:[^.,;()*|\n#\-]|\.(?=\S))+)?)"
)
# Files this project WRITES INTO A PROJECT rather than ships. They cannot be
# resolved here and are not defects.
GENERATED_TARGETS = ("operating-principles/", "org/", "personnel-ledger/")


def _norm_heading(s):
    """Normalise, and strip a leading article.

    Without the article strip, the shortest prefix of "the three outcomes" is
    "the" — which matches ANY heading beginning with "the". Renaming a heading
    three files cited went undetected for exactly that reason, found by mutating
    this check rather than by reading it.
    """
    s = re.sub(r"\s+", " ", s.replace("`", "").lstrip("#")).strip().lower()
    s = re.sub(r"^(?:the|a|an)\s+", "", s)
    return re.sub(r"'s\b", "", s)


_by_name = {}
for _p in glob.glob("workforce/**/*.md", recursive=True):
    _by_name[os.path.basename(_p)] = _p
    _by_name[_p.replace("workforce/", "")] = _p

_anchor_broken = []
for _src in sorted(glob.glob("workforce/**/*.md", recursive=True)):
    # A vendored catalog's internal citations resolve in the SOURCE project's
    # tree, not ours — its changelog cites its own siblings by heading. Reading
    # them here reports a broken anchor that is correct where it lives.
    if _src in VENDORED:
        continue
    for _m in CITE_RX.finditer(read(_src)):
        _raw, _sec = _m.group(1), _norm_heading(_m.group(2))
        if not _sec or _raw.startswith(GENERATED_TARGETS):
            continue
        _tgt = _by_name.get(_raw) or _by_name.get(os.path.basename(_raw))
        if not _tgt:
            continue  # the PATH half is check 3's job, not this one
        _heads = [_norm_heading(h) for h in re.findall(r"^#{2,4}\s+(.+)$", read(_tgt), re.M)]
        _w = _sec.split()
        # Sentence punctuation is not part of the heading. A citation ending a
        # sentence — "resolve to one of the four outcomes in staging.md § The
        # three outcomes:" — carried the colon into the last word, so the full
        # prefix never matched and resolution fell all the way back to the bare
        # word "three". That resolved only because ONE heading began with it;
        # adding a second heading starting "Three" turned a citation that had
        # been green-by-accident into an ambiguity failure. Strip it, and the
        # citation matches the heading it always meant.
        if _w:
            _w[-1] = _w[-1].rstrip(":;,.!?")
        # Longest prefix first; the first length matching EXACTLY ONE heading
        # resolves. A prefix matching several has not resolved anything — the
        # bare word "phase" matched Phase A, B and C, so renaming or deleting
        # Phase B or C left every citation of them green.
        # A SHORTENED prefix must land on a heading BOUNDARY. The existing guard
        # rejected a prefix matching several headings; it accepted one matching
        # exactly one WRONG heading. Renaming the cited section left
        # "§ The three outcomes" resolving happily against an unrelated
        # "Three checks that fail on conformant handbooks" — the rename this check
        # exists to catch, reported green.
        #
        # Shortening is still REQUIRED, because citations legitimately run into
        # the sentence around them: "`platform.md` § Staleness already settles:".
        # A blanket two-word floor broke ten real citations to catch one bug.
        # The discriminator is what the HEADING does after the prefix — it must
        # end, or continue with punctuation: "Header — …", "Creative / …",
        # "Resolution". "three checks …" continues with a letter, so it is prose
        # that merely starts the same way, and is not the cited section.
        def _boundary(_h, _p):
            _rest = _h[len(_p):]
            return _rest == "" or (_rest[:1] == " " and not _rest[1:2].isalnum())

        _hit = False
        for _n in range(len(_w), 0, -1):
            _pre = " ".join(_w[:_n])
            _ms = [h for h in _heads if h.startswith(_pre)]
            # An EXACT heading — the prefix is the whole heading, or ends at its
            # separator — resolves even when it is also a prefix of siblings.
            # "Step 0.4" is a real heading AND a prefix of 0.4a/b/c; without this
            # the ambiguity rule rejects a citation that is perfectly well formed.
            if any(h == _pre or h[len(_pre):len(_pre) + 2] in (" —", " -", ": ")
                   for h in _ms):
                _hit = True
                break
            # A UNIQUE match still has to be the right one. At full citation
            # length uniqueness is enough; once the prefix has been shortened,
            # the heading must end there or continue with punctuation.
            if len(_ms) == 1 and (_n == len(_w) or _boundary(_ms[0], _pre)):
                _hit = True
                break
            if len(_ms) > 1:
                break
        if not _hit:
            _anchor_broken.append(f"{_src.replace('workforce/', '')} → {_raw} § {_sec[:48]}")
check(
    "references: every `file § Section` anchor resolves to a real heading",
    not _anchor_broken,
    f"broken anchors: {_anchor_broken} — renaming a heading silently dangles every "
    "citation of it; only the path half was ever validated",
)

img_broken = [
    src for _, src in re.findall(r"!\[([^\]]*)\]\(([^)]+)\)", readme)
    if not src.startswith("http") and not os.path.exists(src)
]
check("README: every image resolves", not img_broken, f"missing: {img_broken}")

# In-document anchors are not paths. Resolve them against the heading slugs
# instead — treating them as files was a false positive on this check's own terms.
slugs = {
    re.sub(r"[^a-z0-9]+", "-", h.lower()).strip("-")
    for h in re.findall(r"^#{2,3} (.+)$", readme, re.M)
}
bad_anchors = [a for a in re.findall(r"\]\(#([^)]+)\)", readme) if a not in slugs]
check("README: every in-document anchor resolves", not bad_anchors, f"broken: {bad_anchors}")

link_broken = [
    tgt.split("#")[0] for _, tgt in re.findall(r"\[([^\]]+)\]\(([^)]+)\)", readme)
    if not tgt.startswith(("http", "#")) and not os.path.exists(tgt.split("#")[0])
]
check("README: every relative link resolves", not link_broken, f"missing: {link_broken}")

# ─────────────────────────────────────────────────────────────────────────────
# 4. Project state never lives in the skill directory
#
# The invariant that lets ONE personal install serve many projects. Break it and
# a single config is shared across unrelated orgs.
# ─────────────────────────────────────────────────────────────────────────────
STATE_RX = re.compile(
    r"(?:\.claude/skills/workforce/|\$\{CLAUDE_SKILL_DIR\}/)"
    r"[\w./-]*(?:org-config\.md|org-chart|personnel/|work/|evals/|ablations/|roster\.md"
    r"|conversion-journal|operating-principles/)"
)
leaks = [p for p in declared if p.endswith(".md") and STATE_RX.search(read(p))]
check("scopes: no project state written into the skill directory", not leaks, f"leaks: {leaks}")

# ─────────────────────────────────────────────────────────────────────────────
# 5. SKILL.md structure and marker pairing
# ─────────────────────────────────────────────────────────────────────────────
check("SKILL.md: frontmatter present", skill.startswith("---\n"))
fm = skill.split("\n---\n")[0]
for key in ("name:", "description:", "when_to_use:", "allowed-tools:"):
    check(f"SKILL.md: frontmatter has {key}", key in fm)
check(
    "SKILL.md: ENFORCEMENT ANNOTATION blocks are paired",
    skill.count("<!-- ENFORCEMENT ANNOTATION") == skill.count("<!-- END ENFORCEMENT ANNOTATION -->"),
    f"{skill.count('<!-- ENFORCEMENT ANNOTATION')} open vs "
    f"{skill.count('<!-- END ENFORCEMENT ANNOTATION -->')} close",
)
# Count only STANDALONE markers — one on its own line. Prose that documents the
# marker syntax (`<!-- origin: user | immutable: true -->` inside backticks) is a
# mention, not a marker, and counting it produced 8 false failures on this
# check's first run.
OPEN_RX = re.compile(r"^<!--\s*origin:.*-->\s*$", re.M)
CLOSE_RX = re.compile(r"^<!--\s*/origin\s*-->\s*$", re.M)
for p in declared:
    if not p.endswith(".md") or p in VENDORED:
        continue
    body = read(p)
    o, c = len(OPEN_RX.findall(body)), len(CLOSE_RX.findall(body))
    check(f"origin blocks paired in {os.path.basename(p)}", o == c, f"{o} open vs {c} close")

# ─────────────────────────────────────────────────────────────────────────────
# 6. Shipped agents are leaf helpers
#
# They run as panel members. If one could delegate it would consume a tier from
# the org that hired it — measured as exactly the budget the chain of command needs.
# ─────────────────────────────────────────────────────────────────────────────
for p in glob.glob("workforce/agents/*/AGENT.md"):
    body = read(p)
    name = os.path.basename(os.path.dirname(p))
    check(f"agent {name}: carries disallowedTools: Agent", "disallowedTools: Agent" in body)
    check(f"agent {name}: frontmatter has name:", re.search(r"^name:\s*\S+", body.split("\n---\n")[0], re.M) is not None)

# ─────────────────────────────────────────────────────────────────────────────
# 7. Handbook templates carry the load-bearing frontmatter
# ─────────────────────────────────────────────────────────────────────────────
# Both were bare substrings satisfied by the PROSE BULLET stating the rule — the
# rule serving as its own enforcement. Deleting the actual YAML line from the IC
# template passed at 314/0. Anchor to a frontmatter line.
check(
    "templates: IC frontmatter carries disallowedTools: Agent (the measured tier ceiling)",
    re.search(r"^disallowedTools:\s*Agent\s*$", tpl, re.M),
    "must be a frontmatter LINE, not a prose mention (platform.md fact 2c)",
)
check(
    "templates: delegating-tier frontmatter carries background: false",
    re.search(r"^background:\s*false\s*$", tpl, re.M),
    "must be a frontmatter LINE, not a prose mention",
)
# `tools:` WAS prohibited outright here, on the sound ground that an explicit list is
# EXACT, not a filter (fact 4b): listing one tool costs every tool not listed, and
# under-enumerating silently strips capability.
#
# Amended 2026-08-03. The prohibition was right about the hazard and wrong about the
# scope. A DELEGATING tier must keep the full inherited grant — it needs `Agent`, and
# enumerating for it buys nothing. An IC must NOT, because `disallowedTools:` is
# discarded for a named teammate (fact 2d) and the allowlist is the only half of its
# ceiling that survives that spawn form.
#
# The exactness hazard is not dismissed, it is relocated: under-granting an IC breaks
# its own verification command, which fails LOUDLY on the next run. A missing ceiling
# fails silently and forever. This project prefers the loud failure.
_ic_at = tpl.find("\n## IC\n")
check(
    "templates: the IC block is locatable for tier-scoped checks",
    _ic_at != -1,
    "no '## IC' heading in handbook-templates.md — the two checks below would pass vacuously",
)
if _ic_at != -1:
    _tpl_deleg, _tpl_ic = tpl[:_ic_at], tpl[_ic_at:]
    check(
        "templates: delegating tiers offer no tools: field",
        not re.search(r"^tools:\s*\S", _tpl_deleg, re.M),
        "CEO/Lead keep the full default grant; an explicit list is exact, not a filter (fact 4b)",
    )
    check(
        "templates: the IC block DOES carry a tools: field",
        re.search(r"^tools:\s*\S", _tpl_ic, re.M),
        "an IC ceiling resting only on disallowedTools: does not exist for a named teammate (fact 2d)",
    )
# ORG-RECORD and ORG-CHAIN are marker families this project defines and never
# pair-checked, while asserting pairing as first-class for every other family.
for _fam in ("ORG-RECORD", "ORG-CHAIN"):
    _o = len(re.findall(rf"<!--\s*{_fam} START", tpl))
    _c = len(re.findall(rf"<!--\s*{_fam} END", tpl))
    check(
        f"templates: {_fam} markers pair in the shipped templates",
        _o == _c and _o > 0,
        f"{_o} openers / {_c} closers — an unpaired opener propagates to every handbook "
        "and runs a span to the next closer",
    )
check("templates: no memory: field offered", not re.search(r"^\s*memory:\s*\w", tpl, re.M))
check("templates: MCP granted at server level", "mcp__playwright-mcp__*" in tpl)

required = re.findall(r"\| `## (\w[\w ]*)` \|", pfp)
absent = [s for s in required if f"## {s}" not in tpl]
check("templates: every section the authoring spec requires is present", not absent, f"absent: {absent}")

# ─────────────────────────────────────────────────────────────────────────────
# 8. Every `fact N` citation resolves to a fact platform.md actually defines
#
# A citation to platform.md fact "3b" appeared in CLAUDE.md twice and in bin/sync
# once. No such fact has ever existed. It survived because nothing resolved fact
# numbers — the same blind spot that let `/workforce dev hooks` ship in seven
# files (see 8b), one class of reference later. A citation to a fact that does not
# exist reads as grounding and is its opposite: it sends a reader looking for
# evidence that was never written.
#
# Note the phrasing of the comment above: it names the bad number without writing
# it in citation form, because this file scans itself.
# ─────────────────────────────────────────────────────────────────────────────
defined_facts = set(re.findall(r"^### Fact ([0-9]+[a-z]?)\b", plat_body, re.M))
defined_facts |= set(re.findall(r"^\| ([0-9]+[a-z]?) \|", plat_body, re.M))

CITE_RX = re.compile(r"\bfacts?\s+([0-9]+[a-z]?(?:\s*(?:,|and|/)\s*[0-9]+[a-z]?)*)", re.I)
dangling = {}
for p_ in declared + ["README.md", "COMMANDS.md", "CLAUDE.md", "bin/check", "bin/sync"]:
    if not os.path.exists(p_):
        continue
    for group in CITE_RX.findall(read(p_)):
        for n in re.findall(r"[0-9]+[a-z]?", group):
            if n not in defined_facts:
                dangling.setdefault(f"fact {n}", set()).add(p_)
check(
    "facts: every `fact N` citation resolves to a fact platform.md defines",
    not dangling,
    "dangling: " + "; ".join(f"{k} (in {', '.join(sorted(v))})" for k, v in dangling.items())
    + f" — defined: {sorted(defined_facts)}",
)

# ─────────────────────────────────────────────────────────────────────────────
# 8a. No duplicated heading or restated paragraph inside one file
#
# Both shipped. staging.md carried the same "instruct every canary" paragraph
# twice; audit.md had an EMPTY `## Step 1b` heading directly above the real
# `## Step 1c` with identical title text. Neither is catchable by eye in a
# 300-line reference, and a duplicated instruction is how two versions of one
# rule start drifting apart.
#
# The template files are exempt by design: each holds several complete handbook
# templates, so `## Role` / `## Verification` recurring per template is correct.
# ─────────────────────────────────────────────────────────────────────────────
DUP_EXEMPT = {
    "workforce/references/handbook-templates.md",
    "workforce/references/personnel-templates.md",
    "workforce/references/templates.md",
    "workforce/references/org-config.template.md",
}
for p in declared:
    if not p.endswith(".md") or p in DUP_EXEMPT or p in VENDORED:
        continue
    n = os.path.basename(p)
    lines = [l.rstrip() for l in read(p).splitlines()]

    # A heading inside a fenced block is not a heading — it is a sample of one.
    # Found 2026-08-03: procedure-for-procedures.md § Directives shows the literal
    # `## Directives` section a handbook should carry, and the checker read that
    # sample as a second real heading and failed the file for duplicating itself.
    # The lazy repair is DUP_EXEMPT, which would blind the file to REAL duplicates
    # forever — the exact trade this check exists to refuse. Strip the fences.
    _fenced, _depth = set(), False
    for _i, _l in enumerate(lines):
        if _l.lstrip().startswith("```"):
            _depth = not _depth
            _fenced.add(_i)
            continue
        if _depth:
            _fenced.add(_i)

    heads = [l for i, l in enumerate(lines) if l.startswith("#") and i not in _fenced]
    dup_h = sorted({h for h in heads if heads.count(h) > 1})
    # Same title under different numbering — `## Step 1b — X` vs `## Step 1c — X`.
    titles = [re.sub(r"^#+\s*(?:Step\s+[\w.]+\s*[—-]\s*)?", "", h) for h in heads]
    dup_t = sorted({t for t in titles if titles.count(t) > 1 and t not in ("", "Both")})
    check(f"no duplicate heading in {n}", not (dup_h or dup_t), f"repeated: {dup_h or dup_t}")

    # Markers (`<!-- … -->`) repeat by design — six enforcement annotations open
    # with the same line. Their pairing is check 5's job, not this one's.
    prose = [
        l for l in lines
        if len(l) > 55 and not l.lstrip().startswith(("|", "#", "```", "<!--"))
    ]
    dup_p = sorted({l for l in prose if prose.count(l) > 1})
    check(f"no restated paragraph in {n}", not dup_p, f"repeated verbatim: {[l[:70] for l in dup_p]}")

# ─────────────────────────────────────────────────────────────────────────────
# 8b. Every /workforce command referenced anywhere actually exists
#
# `/workforce dev hooks --execute` was documented in SEVEN files, including one the
# installer printed for the user to run, and the command never existed. It shipped
# through nine commits because nothing checked command references — only
# `references/…` links were validated.
# ─────────────────────────────────────────────────────────────────────────────
# `dev` is a prefix, not a command; the referring regex strips it when resolving
# `/workforce dev <cmd>`. `audit` is the default command, documented in prose
# rather than in the description's Commands list. `hooks` is deliberately absent —
# it is the phantom this check exists to catch.
KNOWN_COMMANDS = set(
    re.findall(r"[\w-]+", re.search(r"Commands: ([^\"]+)", skill).group(1))
) | {"dev", "audit"}
referenced = {}
for p_ in declared + ["README.md", "COMMANDS.md", "CLAUDE.md", "install", "install.ps1", "manifest.txt"]:
    if not os.path.exists(p_):
        continue
    for m in re.findall(r"/workforce\s+(?:dev\s+)?([a-z][a-z-]*)", read(p_)):
        referenced.setdefault(m, set()).add(p_)
phantom = {c: sorted(v) for c, v in referenced.items() if c not in KNOWN_COMMANDS}
# NOTE: `/workforce <employee> <args>` is a real second form (procedures/intent-router.md
# § Naming an employee directly) and this check cannot distinguish it from a typo'd
# command, because employee names are per-project and unknowable here. That is the
# correct trade: a phantom command in shipped docs is a defect, an employee example is
# a convenience. Docs write `<employee>`; do NOT relax this check to allow a literal one.
check(
    "commands: every referenced /workforce command exists in the command surface",
    not phantom,
    "phantom commands: " + "; ".join(f"{c} (in {', '.join(v)})" for c, v in phantom.items()),
)

# ─────────────────────────────────────────────────────────────────────────────
# 8c. This project ships no HOOKS. Scripts are a different question.
#
# This assertion read "no executables in the distribution" until 2026-08-03, and
# its own justifying comment was entirely about the four inherited HOOK files —
# removed once measurement showed they had never fired, could not be wired, and
# duplicated verify. Every one of those findings is about a file registered to a
# harness event. None is an argument against a script a procedure invokes and
# reads an exit code from.
#
# The over-reach was not cosmetic. It forbade the distribution from carrying the
# class of tool the maintainers rely on most, so `audit` Step 1b hand-derived a
# census bin/baseline computes and `verify` re-specified in prose what bin/check
# asserts — in the project whose second directive is to automate everywhere
# feasible. See enforcement.md § Hooks for the line as it now falls.
#
# What survives from the original finding is the part that was always right: a
# DORMANT file gives a fresh install no enforcement, so shipping one moves the gap
# somewhere harder to see. Hence the third check below — a shipped script that no
# procedure invokes is exactly the failure the hooks were deleted for.
# ─────────────────────────────────────────────────────────────────────────────
_execs = manifest_exec_paths()
_hooks = manifest_hook_paths()
_stray = [
    p_ for p_ in declared
    if (p_.endswith((".sh", ".ps1")) or os.access(p_, os.X_OK))
    and p_ not in _execs and p_ not in _hooks
]
check(
    "shipped files: every executable declares itself `exec` or `hook`",
    not _stray,
    f"executable but unflagged: {_stray} — the flag is what decides which obligation "
    "applies: an `exec` must be invoked by a procedure, a `hook` must have a wiring "
    "command and a wired/orphaned report. An unflagged executable has neither",
)
# A shipped file must not instruct a host to open a path the host does not have.
# enforcement.md states the rule; nothing enforced it, and a retracted instruction
# survived eight lines below its own retraction for a full commit. The cold reader
# named this as one of three structural gaps; this is the one with live instances.
_HOST_SENDS = re.compile(r"(?:^|[^`\w])(?:Read|read|Search|search|Open|open|consult|Consult)"
                         r"[^.\n]{0,40}`?bin/(?:check|baseline|coverage|conformance)`?", re.M)
_sends = {}
for p_ in declared:
    if not p_.endswith(".md") or p_ in VENDORED:
        continue
    for m in _HOST_SENDS.finditer(read(p_)):
        # A QUOTED instruction is a retraction reporting what the text used to say.
        # Banning it outright would forbid recording that the instruction was
        # withdrawn, which is how a retraction quietly reverts — the same trap the
        # project-skill-name check fell into earlier the same day.
        if '"' in m.group(0):
            continue
        _sends.setdefault(p_, []).append(m.group(0).strip()[:60])
check(
    "shipped files: none instructs a host to open a path that does not ship",
    not _sends,
    f"instructions pointing a host at maintainer-only tooling: {_sends} — "
    "enforcement.md states this rule and nothing enforced it, so a retracted "
    "instruction survived eight lines below its own retraction",
)
# Fact 2d, measured by a USER's verify run on 2026-08-03. The top row of the
# prevents/detects table said PREVENTS flat for five days; it was true only for the
# spawn form the measurement used. A named-teammate spawn of the same fixture
# arrives with Agent, so every IC's tier ceiling depends on HOW IT IS INVOKED.
check(
    "enforcement: the delegation PREVENTS row carries the spawn form it was measured on",
    "PREVENTS for a plain subagent spawn" in enf
    and "NAMED TEAMMATE" in enf
    and "a PREVENTS row carries the conditions it was measured under" in enf,
    "a guarantee stated without its conditions is an overclaim that has not been "
    "caught yet — and this one was caught by the project's own canary, from a FAIL "
    "that looked like a host problem",
)
check(
    "platform: fact 2d is MEASURED, and its inferred half is labelled as inferred",
    "### Fact 2d" in plat
    and "named teammate" in plat.lower()
    and "INFERRED and not proven" in plat,
    "the tool-grant A/B is clean evidence; the depth effect is one discrepancy read "
    "coherently, and conflating the two is how a measurement becomes a belief",
)
check(
    "hooks: the stated count matches what the manifest actually ships",
    ("ships exactly one hook" in enf) == (len(manifest_hook_paths()) == 1)
    and "ships zero hooks" not in enf,
    f"manifest ships {len(manifest_hook_paths())} hook(s); enforcement.md said the "
    "count 'stays zero' for a full commit after one landed. A stated fact about the "
    "distribution that the distribution contradicts, in the file whose job is "
    "refusing claims the runtime will not back",
)
check(
    "shipped hooks: each has a wiring command and a report of whether it is wired",
    not _hooks or (
        "workforce/references/procedures/hooks.md" in declared
        and ".settings-owned.json" in read("workforce/references/procedures/hooks.md")
        and "Hook wiring" in read("workforce/references/procedures/verify.md")
    ),
    f"declared hooks: {_hooks} — the four inherited hooks were deleted because they "
    "shipped dormant and the command documented to wire them did not exist. Shipping "
    "one again without `/workforce hooks` and a verify row repeats that exactly",
)
check(
    "shipped scripts: confined to workforce/bin/ and registered to no event",
    all(p_.startswith("workforce/bin/") for p_ in _execs)
    and not any(
        ev in read(p_)
        for p_ in _execs
        for ev in ("PreToolUse", "PostToolUse", "SubagentStart", "SessionStart", "UserPromptSubmit")
    ),
    f"declared scripts: {_execs} — one naming a harness event is a hook wearing a "
    "script's flag, and enforcement.md § Hooks says this project ships none",
)
# A PROCEDURE, not merely a mention. enforcement.md naming a script is
# documentation; procedures/*.md naming it is the thing that runs it. The first
# draft of this check accepted any .md and passed while nothing invoked either
# script — the assertion testing that a file is wired, itself unwired.
_procedure_text = "\n".join(
    read(q) for q in declared if q.startswith("workforce/references/procedures/")
)
_uninvoked = [p_ for p_ in _execs if os.path.basename(p_) not in _procedure_text]
check(
    "shipped scripts: every one is invoked by a procedure",
    not _uninvoked,
    f"shipped but named by no procedure: {_uninvoked} — the hooks were deleted "
    "precisely because they shipped dormant and the command to wire them did not "
    "exist; a script nothing calls repeats that with a different file extension",
)

# ─────────────────────────────────────────────────────────────────────────────
# 9. Honesty rules — never claim enforcement the runtime will not deliver
# ─────────────────────────────────────────────────────────────────────────────
# The SANCTIONED honesty clause contains the word "enforced" by design —
# "enforced by prose plus permissions.deny. Prose is advisory…" — so a naive
# scan flags the very sentence written to prevent overclaiming. It did, on this
# check's first run. Strip the canonical clause, then scan what remains.
SANCTIONED = "Chain of command is enforced by prose plus permissions.deny"
OVERCLAIM = re.compile(
    r"chain of command is (?:enforced|guaranteed|prevented|sandboxed)"
    r"|(?:enforces|guarantees|prevents) (?:the )?chain of command",
    re.I,
)
overclaims = []
for p in declared + ["README.md", "COMMANDS.md"]:
    if not p.endswith(".md"):
        continue
    body = read(p).replace(SANCTIONED, "")
    if OVERCLAIM.search(body):
        overclaims.append(p)
check(
    "honesty: chain of command never described as enforced",
    not overclaims,
    f"overclaimed in: {overclaims} — it is detection, not prevention (enforcement.md)",
)

check("honesty: enforcement.md states the cannot-enforce cases", "CANNOT. Detection only." in enf)

check("platform: MEASURED-ON stamp present", "MEASURED-ON:" in plat)
check("platform: TIER-LIMIT constant present", "TIER-LIMIT:" in plat)
check("platform: MEASURED and DOCUMENTED are separated", "## DOCUMENTED" in plat and "## MEASURED" in plat)

# Every MEASURED fact must cite evidence a clone can actually open. platform.md
# promises "MEASURED facts carry their evidence path" — and cited `.claude/`,
# which is gitignored, so no reader could check one.
ev_broken = sorted({
    m for m in re.findall(r"`(measurements/[\w./-]+\.md)`", plat)
    if not os.path.exists(m)
})
check("platform: every cited evidence file exists", not ev_broken, f"missing: {ev_broken}")
check(
    "platform: evidence is not cited from gitignored project state",
    ".claude/workforce/canary" not in plat,
    "cites .claude/workforce/ — gitignored, so a clone cannot verify the measurement",
)

# ─────────────────────────────────────────────────────────────────────────────
# 9b. Data skills, legacy markers, and the no-residue rule
#
# Every check here guards a decision ratified 2026-07-30 whose failure mode is
# silent: the doctrine reads correctly while the mechanism contradicts it. That
# combination has already shipped twice in this project — a backup ordered after
# the first write, and a model-ID exemption the check forbade — so each of these
# pins a rule to the text that implements it.
# ─────────────────────────────────────────────────────────────────────────────
ds   = read("workforce/references/data-skills.md")
lm   = read("workforce/references/legacy-markers.md")
ct   = read("workforce/references/conversion-taxonomy.md")
cd_  = read("workforce/references/conversion-department.md")
pa_  = read("workforce/agents/provenance-analyst/AGENT.md")
cc_  = read("workforce/agents/content-classifier/AGENT.md")
stg  = read("workforce/references/staging.md")
aud  = read("workforce/references/procedures/audit.md")
REQUIRED_DS_SECTIONS = [
    "## Schema", "## Invariants", "## Degradation",
    "## Owner", "## Git policy", "## Seed", "## Maintainers",
]
missing_ds = [s for s in REQUIRED_DS_SECTIONS if s not in ds]
check(
    "data-skills: the template specifies all seven required sections",
    not missing_ds,
    f"missing from data-skills.md: {missing_ds} — a generated skill is verified against this list",
)

# The universal invariant is the one line every generated data skill inherits.
# If it drifts here, it drifts into every dataset an org ever owns.
check(
    "data-skills: the universal invariant is stated",
    "may never authorize a write" in ds,
    "data-skills.md must state: degraded state may cause more work, never authorize a write",
)

# ─────────────────────────────────────────────────────────────────────────────
# Mechanical-before-agentic, landed 2026-07-31.
#
# Every rung of the dispatch CHECKPOINT chose WHICH AGENT; none asked whether one
# was needed. The ladder ran "which employee" → "hire one", so the cheapest correct
# answer — run the thing that already does this — was not on it. An org that spawns
# a reasoning agent to run a command it owns is both more expensive and LESS
# verifiable, because the exit code outranks the agent's report.
#
# The precedence is worth nothing without the total-coverage rule: a partial match
# dispatched as if complete returns a wrong answer cheaply, which is strictly worse
# than the agent hop it saved.
# ─────────────────────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────────────────────
# The four defects the first real audit left behind, landed 2026-08-03.
#
# Every one was invisible to the run that produced it, because in each case the
# artifact EXISTED and read sensibly — a populated Mechanicals table of the wrong
# shape, a printed canary promise with no queue row, a stated spawn-ledger rule
# nothing executed, and a hand-derived count five minutes before the census ran.
# ─────────────────────────────────────────────────────────────────────────────
# ─────────────────────────────────────────────────────────────────────────────
# Vendored evaluator catalogs, landed 2026-08-03.
#
# Workforce described forcible propagation and shipped nothing to propagate.
# Measured: the portable source carries ~126 pattern rows; one real project had
# ~57 hand-grown and never reconciled, another ~49. Workforce shipped ZERO, so a
# fresh install on a machine without the predecessor was strictly thinner than the
# system it supersedes — the one outcome the standing directive forbids.
# ─────────────────────────────────────────────────────────────────────────────
_vend_text = [p_ for p_ in VENDORED if "/text/" in p_]
_vend_code = [p_ for p_ in VENDORED if "/code/" in p_]
# Every shipped script has a RE-RUNNABLE test, not a prose anecdote. The four were
# released on negative tests run by hand in a scratch directory and written up in
# plan/. bin/baseline's own docstring: "A census that can be re-run is the only kind
# that can be compared." Proven by regressing wf-conform's ORG-RECORD discriminator
# and wf-census's symlink dedupe and watching the harness fail.
_fix_spec = "fixtures/scripts/expectations.json"
_fix_cases = json.loads(read(_fix_spec)) if os.path.exists(_fix_spec) else {}
_covered = {c["script"] for c in _fix_cases.values()}
check(
    "scripts: every shipped script has re-runnable fixtures",
    os.path.exists("bin/script-conformance")
    and all(os.path.basename(p_) in _covered for p_ in manifest_exec_paths() + manifest_hook_paths()),
    f"fixtures cover {sorted(_covered)}; shipped are "
    f"{sorted(os.path.basename(p_) for p_ in manifest_exec_paths() + manifest_hook_paths())} — "
    "a script released on tests nobody can re-run is released on an anecdote",
)
# CLASS B mechanism (plan/defect-classes-2026-08-03.md): anything that writes must
# be a no-op the second time. bin/coverage --stamp appended a header on EVERY run
# for hours — nobody ran it twice because nothing did.
check(
    "writers: every tool that writes has an idempotence check",
    os.path.exists("bin/idempotence")
    and all(w in read("bin/idempotence") for w in ("coverage", "sync"))
    and "never the live tree" in read("bin/idempotence"),
    "bin/coverage --stamp duplicated its header on every run and 67 files carried "
    "duplicates before anyone ran it twice; a conformance tool that mutates the "
    "thing it checks has the defect it is looking for",
)
check(
    "scripts: the harness refuses to report success on an empty run",
    "refusing to report success" in read("bin/script-conformance"),
    "'nothing to check' and 'all checks passed' must not produce the same output; "
    "that is the failure mode the harness exists to make impossible",
)
check(
    "context: composition is measured by layer, and the unmeasured layer says so",
    "wf-context" in _bud
    and "IDENTITY" in _bud and "ROUTING" in _bud
    and "REFERENCE" in _bud and "WORKING" in _bud
    and "rather than 0" in _bud
    and "The ratio between layers is the finding" in _bud,
    "budget reported two aggregates and neither answered what is in the window when "
    "an employee starts work. The work order is composed per dispatch and is not on "
    "disk, so reporting 0 would read as 'no task' — it reports unmeasured",
)
check(
    "context: the identity share is reported, because it is the lever",
    "identity share per employee" in _bud and "81–91%" in _bud,
    "measured on a real project: CLAUDE.md was 81-91% of everything an employee "
    "received before any work order existed, and the same script reports 13% against "
    "a project with a small one. Bytes are a number; a share is a decision",
)
check(
    "catalogs: the portable corpora ship, for text AND code",
    len(_vend_text) >= 2 and len(_vend_code) >= 5,
    f"vendored text={len(_vend_text)} code={len(_vend_code)} — describing a "
    "propagation mechanism while shipping nothing to propagate makes a fresh "
    "install thinner than the predecessor it replaces",
)
check(
    "catalogs: every vendored file keeps its own version anchor on line 1",
    all(
        read(p_).splitlines()[0].startswith("<!--")
        and ("ref-version:" in read(p_).splitlines()[0])
        for p_ in VENDORED if p_.endswith(("text-tells.md", "version.md"))
    ),
    "the anchor is what forcible propagation compares against; a vendored file "
    "without one cannot be reconciled and silently becomes a dead copy",
)
check(
    "catalogs: vendored files carry no workforce enforcement header",
    not any("in bin/check name this file" in read(p_) for p_ in VENDORED),
    "stamping one would claim bin/check coverage over text this project did not "
    "write, and would fork the file from the source it must match byte-for-byte",
)
check(
    "catalogs: the vendored-vs-authored distinction is stated where it is enforced",
    "VENDORED, NOT AUTHORED" in read("manifest.txt")
    and "an ORIGIN, not a second grower" in _ev,
    "the two-canonical-texts rule bars two copies that both CHANGE; a read-only "
    "seed with an anchor is not that, and the difference has to be written down or "
    "the next reader deletes the catalogs citing the rule",
)
check(
    "catalogs: the append target is the catalog file, and one condition only stops it",
    "The append target is the CATALOG FILE, never the skill" in _ev
    and "still does not stop the append" in _ev
    and "A foreign version anchor is NOT a blocker" in _ev
    and "name the file and the spans" in _ev,
    "measured on two real projects: SKILL.md carried 11 and 2 immutable spans and "
    "the catalog file carried ZERO in both, while an audit reported the catalog "
    "read-only for spans it read in the skill. A foreign anchor never blocks either "
    "— workforce writes its own anchor and its own region",
)
check(
    "catalogs: reconciliation precedes the sweep that removes the source",
    "Succession removes the source" in _ev
    and "precondition of the sweep" in _ev
    and "while it is still on disk" in _ev
    and "v0" in _ev,
    "propagation compares against the predecessor's shipped catalog; succession "
    "removes the predecessor, so after the sweep there is nothing to compare "
    "against. Same shape as a backup taken after the first write. Measured: two "
    "projects seeded from one predecessor, one reconciled to v2 with 24 mechanisms, "
    "the other never reconciled and carrying no anchor at all",
)
check(
    "records: a predecessor's knowledge base converts its ownership, not its record types",
    "converted, never re-typed" in ds
    and "untouched, byte-for-byte, at their existing paths" in ds
    and "Two ledgers in one project is the correct end state" in ds,
