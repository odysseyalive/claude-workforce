# ─────────────────────────────────────────────────────────────────────────────
# A fixture that is not IN the repo is not a fixture
# ─────────────────────────────────────────────────────────────────────────────
# `bin/conformance` exits 1 and is the only instrument showing this system
# generalizes past one real target — and on 2026-08-01 it passed clean here while
# failing 41 of 60 assertions on a fresh clone. The root `.gitignore` carried a
# bare `.claude/`, which matches at EVERY depth and so swallowed the fixture trees
# themselves; twelve fixtures were committed as a CLAUDE.md and a TRUTH.md
# describing content that had never been pushed. Anchoring the pattern fixed those,
# and then two files stayed hidden for a second reason: f11 SHIPS `.gitignore`
# files as test data (the census reads them to classify git disposition), and git
# honored them, suppressing the very files the fixture asserts on.
#
# So the rule cannot be about any one pattern. It is: every file under fixtures/
# is tracked, whatever the reason it might not be. `git add -f` is the fix when a
# fixture's own test data is the cause — never a new ignore rule, which would
# change what the fixture measures.
_fx = os.path.join(ROOT, "fixtures")
if os.path.isdir(_fx):
    try:
        _r = subprocess.run(["git", "ls-files", "fixtures/"], cwd=ROOT,
                            capture_output=True, text=True, timeout=30)
        if _r.returncode != 0:
            raise RuntimeError(_r.stderr.strip()[:120] or "git ls-files failed")
        _tracked = set(_r.stdout.split())
        _ondisk = set()
        for _d, _s, _f in os.walk(_fx):
            if ".git" in _d.split(os.sep):
                continue
            for _n in _f:
                _ondisk.add(os.path.relpath(os.path.join(_d, _n), ROOT))
        _untracked = sorted(_ondisk - _tracked)
        check(
            "fixtures: every fixture file is tracked in git",
            not _untracked,
            "untracked, so absent from any clone and silently unasserted there: "
            + ", ".join(_untracked[:5]) + (" …" if len(_untracked) > 5 else ""),
        )
    except Exception as _e:  # no git, no assertion — never a false pass
        warn("fixtures: tracked-ness not asserted", f"git unavailable ({_e})")

# ─────────────────────────────────────────────────────────────────────────────
# Directive survival, landed 2026-08-03.
#
# T2 extraction always worked: every immutable span is written verbatim and
# byte-exact to .claude/workforce/directives/<skill>.md, read back, compared,
# and a count short by one blocks the skill. What was missing was the LAST HOP.
#
# An employee is a fresh isolated context whose only inputs are its handbook,
# its skills: preload, and CLAUDE.md. The directives directory is in none of
# the three, so the user's words were preserved as an ARCHIVE and the employee
# governed by them never saw them. handbook.md is right that COPYING the block
# creates two canonical texts — so the fix is a POINTER plus a sha, never a copy.
#
# Measured: "directive" appeared ZERO times in handbook-templates.md and
# personnel-templates.md, in the project whose first directive is that the
# user's wording is sacred. Deleting SKILL.md's entire byte-exact extraction
# gate left bin/check completely unchanged at the time this was found.
# ─────────────────────────────────────────────────────────────────────────────

check(
    "directives: the fixed section table carries a Directives row",
    "`## Directives`" in pfp and "Pointer only" in pfp,
    "the section order is asserted and lint-blocking, so a Directives section an "
    "author added by hand would have FAILED the lint — the slot has to exist here "
    "before a template may carry one",
)
check(
    "directives: the handbook section is a pointer, never a copy",
    "## Directives" in tpl
    and "POINTER ONLY" in tpl
    and "never paste the block" in tpl,
    "copying an immutable block into a handbook creates two canonical texts that "
    "diverge on the first amendment (procedures/handbook.md); the pointer is what "
    "keeps one canonical text reachable instead of merely archived",
)
check(
    "directives: both handbook templates bind a sha the employee can check",
    tpl.count("directives-sha") >= 3 and "DIRECTIVE-DRIFT" in tpl,
    "without the sha a directive file edited after registration leaves every "
    "handbook pointing confidently at text that changed; the employee's own first "
    "step is what detects it",
)
check(
    "directives: an employee with none says so, rather than omitting the section",
    "(none bound)" in tpl and "(none bound)" in pfp,
    "a zero is a measurement and a missing line is silence (invariants.md); an "
    "absent section cannot be told from an author who forgot",
)
check(
    "directives: the EMP record captures the originating ask verbatim",
    "## Originating Ask" in _pt
    and "origin: user | immutable: true" in _pt
    and "Never tidied, never paraphrased, never summarized" in _pt,
    "/org clause 10(b) hands hire the VERBATIM ask, hire hands handbook a role "
    "brief, and the user's wording was dropped at that seam — preserved in transit "
    "and stored nowhere. charter and principles were the only commands that ever "
    "wrote a user's words to disk",
)
check(
    "directives: an absent ask is recorded as absent, never reconstructed",
    "no verbatim ask on record" in _pt and "never filled with a reconstruction" in _pt.lower(),
    "a paraphrase inside an immutable block is worse than an honest absence: it "
    "looks like the user's words, is not, and no later reader can tell",
)

# ─────────────────────────────────────────────────────────────────────────────
# Settings review, landed 2026-08-03 — audit-setup.md § Permissions.
#
# update and vendor write permission keys; verify reports on two of them. audit
# — the command everyone runs first and the only one most users ever run —
# touched permissions not at all. A fresh install could finish, report a healthy
# org, and be unable to dispatch or run its own checks, with every artifact on
# disk correct.
#
# The whole section rests on facts 14-17, which are DOCUMENTED and uncanaried,
# so it REPORTS and never blocks. delegation-budget.md already had to retract
# one blocking check built on an unmeasured fact; this is the same trade, made
# correctly the first time.
# ─────────────────────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────────────────────
# The four questions are the only human-facing surface, landed 2026-08-03.
#
# No question wording was specified ANYWHERE, so each was composed from procedure
# prose written for agents in a fresh context — dense on purpose — and the register
# came with it. The first real run rendered "Archive the tree before anything is
# written?" with an option reading "Costs the sweep: conversions downgrade to
# register-the-employee-and-leave-the-skill". Accurate, and unanswerable by the
# person being asked at question 2 of 4.
#
# Specifying the words is the fix. A rule about tone would not have been, which is
# why this checks the SPECIFIED TEXT rather than asserting that a rule exists.
# ─────────────────────────────────────────────────────────────────────────────
# ONE list, matching audit-setup.md § How every question is worded. The two were
# different lengths until 2026-08-03: this tuple omitted IC, Lead, tier, probe,
# handbook, employee and conversion, while question 3's own option labels used
# three of them. "This is a list, and it is checked" was false in both directions.
_Q_BANNED = (
    "archive the", "the tree", "sweep", "disposition", "conversion", "convert",
    "degrade", "orchestrator", "canary", "invariant", "preflight", "census",
    " ic ", " lead", "tier", "probe", "handbook", "employee",
)
# Every block quoted under "Use this wording" is user-facing copy.
# DOTALL with a bounded gap: the lead-in sentence may wrap across lines, which is
# how the first version of this regex saw one block where there were two — an
# assertion under-counting the thing it exists to count.
_q_blocks = re.findall(r"\*\*Use this wording[^\n]*(?:\n[^\n>]*)*?\n\n((?:>.*\n)+)", _asu)
_q_leaks = {
    w: b.strip()[:60]
    for b in _q_blocks for w in _Q_BANNED
    if w in b.lower()
}
check(
    "questions: the four are specified verbatim, not composed from agent-facing prose",
    len(_q_blocks) >= 4
    and "How every question is worded" in _asu
    and "Back up your project first?" in _asu,
    f"found {len(_q_blocks)} of 4 specified question block(s) — the budget is four "
    "questions and half of them had no specified wording, with this threshold set to "
    "the number that made it pass. The human-facing surface "
    "must not be paraphrased out of procedure prose; that is what produced "
    "'Archive the tree before anything is written?'",
)
check(
    "questions: consent states that most skills SURVIVE, not that they are removed",
    "most of them stay" in _asu
    and "trimmed down to just that" in _asu
    and "it is how anything reaches that data" in _asu
    and "left alone" in _asu
    and "Simplify the words; never the facts" in _asu,
    "the first plain-language draft said 'it becomes an agent and the old skill is "
    "removed' — readable and wrong about the common case. A skill holding a command "
    "is reduced to it, one fronting data is never deleted, one that builds agents is "
    "untouched. A consent question that overstates deletion asks the user to "
    "authorize something broader than what happens",
)
check(
    "questions: no internal vocabulary reaches the user-facing wording",
    not _q_leaks,
    f"banned terms in specified question copy: {_q_leaks} — a reader at question 2 "
    "has typed one command and read nothing; say what happens to THEIR project",
)
check(
    "collisions: LIVE blocks and NAMESPACE advises, and the split is stated",
    "LIVE blocks" in _asu and "NAMESPACE" in _asu
    and "resolving locations only" in _asu
    and "ADVISORY" in _asu,
    "an in-skill AGENT.md is loaded by path, so its `name:` is documentation and "
    "cannot collide (platform.md fact 5). The first real target reported five "
    "collisions and had zero: three symlink aliases and two per-skill templates. "
    "Blocking on those halts a correctly-configured project",
)
check(
    "permissions: audit reviews the settings file, and resolves it rather than assuming it",
    "## Permissions" in _asu
    and "Resolve the file, do not choose it" in _asu
    and "Never write managed settings" in _asu,
    "the four scopes have a precedence order (scopes.md); a run that writes to a "
    "guessed path can silently be overridden by one that outranks it",
)
# Scoped to where INSTRUCTIONS live. legacy-markers.md carries the retraction and
# enforcement.md carries the json.loads evidence; banning the string outright would
# forbid recording that the family was retracted, which is how a retraction quietly
# reverts. A specification is what must not exist.
_marker_specs = [
    p_ for p_ in declared
    if (p_.startswith("workforce/references/procedures/") or p_ == "workforce/SKILL.md"
        or p_ == "workforce/references/audit-setup.md")
    and any(m in read(p_) for m in
            ("WORKFORCE-DENY START", "WORKFORCE-PERMS START", "WORKFORCE-HOOKS START"))
]
check(
    "settings: ownership is a sidecar, never comment markers inside JSON",
    not _marker_specs
    and ".settings-owned.json" in _asu
    and "RETRACTED" in read("workforce/references/legacy-markers.md"),
    "the settings file is JSON and JSON has no comments — `json.loads` rejects a "
    "`<!-- ... -->` marker outright. This was specified in four files alongside the "
    "correct 'parse, mutate, validate, write', and survived because nothing had run "
    "the step. Found by the 2026-08-03 --review mock audit",
)
check(
    "permissions: a scoped grant is never widened into a blanket one",
    "Never widen a scoped grant" in _asu and "never bare `Bash`" in _asu,
    "the first real target carried 282 narrowly-scoped Bash rules and no blanket "
    "grant; adding bare `Bash` removes nothing, so `0 removed` prints truthfully "
    "while the user's whole posture is superseded by a wider rule",
)
check(
    "permissions: absence is judged against the union of scopes, not the write target",
    "UNION OF ALL FOUR SCOPES" in _asu,
    "rules concatenate across scopes (fact 17), so a grant in user settings is "
    "already in force; 'add what is absent' without naming the reference set gives "
    "two readings and opposite writes",
)
check(
    "permissions: additions only — nothing the user wrote is removed or edited",
    "Add only what is absent" in _asu
    and "It is never resolved by" in _asu
    and "0 removed" in _asu,
    "an exclusion the user wrote is evidence of intent, never an obstacle to route "
    "around; and a guarantee nobody prints is a guarantee nobody can check",
)
check(
    "permissions: findings are reported last, and are never a fifth question",
    "final section of the run report" in _asu
    and "Not a question" in _asu
    and "this is not a fifth" in _asu,
    "the question budget is a ceiling of four (§ The question budget); permission "
    "findings are reported, not asked",
)
check(
    "permissions: every count prints, including the zeroes",
    "always all five, including the zeroes" in _asu,
    "0 added is a measurement that the org's needs were already met; silence is not",
)
check(
    "permissions: a conflict reports and does not fail the run",
    "A conflict does not fail the run" in _asu
    and "bars an unverified fact from becoming a blocking check" in _asu,
    "facts 14-17 are DOCUMENTED and uncanaried; blocking on one would repeat the "
    "substitution delegation-budget.md had to retract",
)
check(
    "permissions: the non-existent per-agent field is stated plainly, not substituted",
    "There is no `permissions:` frontmatter field" in _asu
    and "not literally available" in _asu,
    "the directive asked for per-agent permission rules; quietly shipping something "
    "adjacent and calling it done is the failure this project fails runs over",
)
check(
    "platform: the researched permission facts are DOCUMENTED, never promoted silently",
    all(f"| {n} |" in _plat for n in (14, 15, 16, 17))
    and "earns a canary before it earns a gate" in _plat,
    "four claims load-bearing for a procedure that writes into a user's settings "
    "file; three documented claims in this file have already lost to measurement",
)

# ─────────────────────────────────────────────────────────────────────────────
# Every shipped agent has a caller, landed 2026-08-03.
#
# staging.md § The shipped panel definitions resolved this ONCE, for the three
# Conversion Department members, and left the rest standing: four of seven
# definitions had no procedure naming them BY PATH. The worst was
# handbook-cold-reader — a 70-line persona for the off-the-street release gate,
# while staging.md Phase B said "Spawn a generic agent" four lines below its own
# warning that a caller reading only part of a definition gets an agent that
# drifts with nothing reporting it.
#
# A definition that ships and is never loaded is this project's signature defect
# (written, unwired) inside the artifacts meant to catch it. Path, not name: a
# procedure naming an agent it never tells the caller to READ is the same bug.
# ─────────────────────────────────────────────────────────────────────────────
_agent_paths = [p_ for p_ in declared if p_.startswith("workforce/agents/")]
_callers = "\n".join(read(p_) for p_ in declared if p_.endswith(".md") and not p_.startswith("workforce/agents/"))
_uncalled = [p_ for p_ in _agent_paths if p_ not in _callers]
check(
    "agents: every shipped definition is loaded by path from a procedure",
    not _uncalled,
    f"shipped but convened by nothing: {_uncalled} — a definition nothing reads is "
    "either dead weight on every install or a panel running without the persona it "
    "was designed around; wire it or ablate it, and say which",
)

# ─────────────────────────────────────────────────────────────────────────────
# Warnings — worth knowing, not worth failing
# ─────────────────────────────────────────────────────────────────────────────
for p in declared:
    if p.endswith(".md") and p not in VENDORED:
        n = len(read(p).splitlines())
        if n > 260:
            warn(f"{os.path.basename(p)} is {n} lines", "long reference; candidate for a split or ablation")

if not os.path.exists("CLAUDE.md"):
    warn("no CLAUDE.md at the repo root", "a fresh session here has no orientation")
else:
    # CLAUDE.md is the index and the ONLY store that goes stale silently — the
    # others are append-only. It spent two days and nineteen commits telling every
    # fresh session that "every writing step remains unexecuted", by then false in
    # four of five particulars.
    #
    # REPORTED, NOT BLOCKED, and no threshold is invented: the numbers are printed
    # and the judgment is the reader's. A count that fires at one commit is noise;
    # a count nobody prints is how this went stale in the first place.
    _m_open = re.search(r"^## Open, as of (\d{4}-\d{2}-\d{2})", read("CLAUDE.md"), re.M)
    if not _m_open:
        warn("CLAUDE.md states no 'Open, as of <date>'",
             "the index has no date, so its staleness cannot be measured")
    else:
        _since = subprocess.run(
            ["git", "log", "--oneline", f"--since={_m_open.group(1)}", "--", "workforce/", "bin/"],
            capture_output=True, text=True).stdout.strip()
        _n = len(_since.splitlines()) if _since else 0
        if _n:
            warn(f"CLAUDE.md open list is dated {_m_open.group(1)} — {_n} commit(s) to "
                 f"workforce/ or bin/ since",
                 "update the open list in the change that closes an item, or a later "
                 "session is oriented by a snapshot of a day that has passed")

# ─────────────────────────────────────────────────────────────────────────────
# Teammate-safe tier ceilings — platform.md facts 2d and 18
# ─────────────────────────────────────────────────────────────────────────────
# A NAMED-TEAMMATE spawn silently discards `disallowedTools:` and honors `tools:`
# (fact 2d), and drops `skills:`/`mcpServers:` entirely (fact 18, documented). So a
# tier ceiling written only as a denylist does not exist in that spawn form, and
# until 2026-08-03 the IC template shipped exactly that: `disallowedTools: Agent`
# and no `tools:` line at all. Every generated IC was uncapped as a teammate.
#
# The shipped panel agents were never exposed — they carry explicit allowlists —
# which is precisely why re-reading never found it: the examples on disk were right
# and the template that generates employees was not.

check("IC template carries a tools: allowlist",
      "tools: <exact tools this IC needs" in tpl,
      "handbook-templates.md IC frontmatter needs `tools:` beside `disallowedTools: Agent`")

check("IC template tools: line forbids Agent",
      "MUST NOT include Agent" in tpl,
      "the allowlist is the half that survives a teammate spawn; it must exclude Agent")

check("SKILL.md rule 3 blocks on the tools: allowlist too",
      "allowlist omitting `Agent` (fact 2d)" in skill,
      "rule 3 must STOP when an IC has no Agent-free `tools:` line")

check("SKILL.md rule 6 permits tools: as a companion",
      "is NOT a mechanism conflict" in skill,
      "rule 6 forbade the only ceiling that survives a teammate spawn until 2026-08-03")

_panel = sorted(glob.glob("workforce/agents/*/AGENT.md"))
_bad_panel = []
for _p in _panel:
    _m = re.search(r"^tools:\s*(.+)$", read(_p), re.M)
    if not _m or "Agent" in [_t.strip() for _t in _m.group(1).split(",")]:
        _bad_panel.append(_p)
check("every shipped panel agent has an Agent-free tools: allowlist",
      bool(_panel) and not _bad_panel,
      f"{len(_panel)} panel agents; offending: {_bad_panel}")

# ─────────────────────────────────────────────────────────────────────────────
# Writing `tools:` severs MCP — the cost of the ceiling, paid once
# ─────────────────────────────────────────────────────────────────────────────
# The teammate fix above gave the IC template a `tools:` line. An explicit list is a
# HARD CEILING for MCP (fact 13: ToolSearch searched a server its grant never named
# and the schema was withheld), so that change silently cut every generated IC off
# from every configured server. Measured the same day on apps-odyssey-alive: two
# employees whose bodies route through nanobanana-mcp / playwright-mcp passed all 138
# text checks and could not reach either.
#
# A rule lands with its enforcement. The doctrine is here; the detection is
# wf-conform's body-vs-grant diff, asserted below.

check("templates document that an explicit tools: severs MCP",
      "SEVERS every MCP server" in tpl,
      "the IC template gained `tools:` without stating what it subtracts")

check("templates name the server-level grant form",
      "mcp__<server>" in tpl,
      "an IC needing MCP must name the server; `ToolSearch` is not a hedge (fact 13)")

_wfc = read("workforce/bin/wf-conform")
check("wf-conform diffs handbook body against its tools: grant",
      "every MCP server its body uses is named in tools:" in _wfc,
      "the only check here that compares text to capability rather than to more text")

check("wf-conform excludes servers named only to forbid them",
      "PROHIBITION_RX" in _wfc,
      "`- NEVER use mcp__x__*` is a guardrail, not a dependency — it read as one until fixed")

check("verify checks for the agent-teams flag on its install surface",
      "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS" in _vfy2,
      "verify is the canonical DETECTION surface; the flag was reported only by audit, "
      "at the end of a run, which is not where anyone looks for it")

check("audit-setup does not attribute the agent-teams flag to the user",
      "not touched — but do NOT report it as the user's choice" in _asu,
      "an installer commonly sets it; claude-enforcer's install does so unconditionally")

# ─────────────────────────────────────────────────────────────────────────────
# The agent-teams flag is never written, and never present here
# ─────────────────────────────────────────────────────────────────────────────
check("audit-setup forbids writing env settings keys",
      "never `env`" in _asu,
      "the write surface is permissions.* only; env changes the whole host session")

check("audit-setup names the agent-teams flag as never-written",
      "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS" in _asu,
      "the one env key that would look helpful must be named and refused explicitly")

_env_writers = [_p for _p in manifest_paths() if _p.endswith(".md") and '"env"' in read(_p)]
check("no shipped procedure writes an env settings key",
      not _env_writers,
      f"env write instruction in: {_env_writers}")

_repo_settings = [_p for _p in (".claude/settings.json", ".claude/settings.local.json")
                  if os.path.exists(_p)]
_flagged_settings = [_p for _p in _repo_settings
                     if "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS" in read(_p)]
check("agent-teams flag absent from this repo's settings",
      not _flagged_settings,
      f"enabled in {_flagged_settings} — named teammates would lose disallowedTools: and skills:")

# ─────────────────────────────────────────────────────────────────────────────
# Report
# ─────────────────────────────────────────────────────────────────────────────
print(f"claude-workforce conformance — {len(declared)} shipped files\n")
if FAILS:
    print(f"FAIL ({len(FAILS)}):")
    for name, detail in FAILS:
        print(f"  ✗ {name}")
        if detail:
            print(f"      {detail}")
    print()
if WARNS:
    print(f"warnings ({len(WARNS)}):")
    for name, detail in WARNS:
        print(f"  · {name}" + (f" — {detail}" if detail else ""))
    print()
print(f"{PASSES} passed, {len(FAILS)} failed, {len(WARNS)} warnings")
sys.exit(1 if FAILS else 0)
