# The install surface is ONE command per platform (README) and FOUR scope-forced
# invocations (update.md), and those are deliberately different strings — so they
# cannot be compared for identity the way they were when both files carried the
# same four. What still has to hold is that update.md runs the SAME INSTALLER the
# README publishes, from the same URL: a drift there updates to something the
# install instructions never described.
#
# Matched over raw text, NOT inside a delimiter: the README publishes these in
# fenced code blocks and update.md carries them in backticked table cells. An
# earlier form keyed on backticks, found zero in the README, and failed — loudly,
# because the conditions below require non-empty sets. That guard is kept:
# comparing two empty sets is the vacuous pass this project's own lint exists to
# catch.
_ENTRY_RX = re.compile(
    r"bash -c \"\$\(curl -fsSL (\S+)\)\"$"
    r"|^irm (\S+install\.ps1) \| iex",
    re.M,
)
_FORCED_RX = re.compile(
    r"bash -c \"\$\(curl -fsSL (\S+)\)\" -- --(?:user|project)"
    r"|\$env:WORKFORCE_SCOPE='(?:user|project)'; irm (\S+install\.ps1) \| iex"
)


def _urls(matches):
    return {u for pair in matches for u in pair if u}


# `|` inside a markdown table cell must be written `\|`; unescape before matching,
# or every PowerShell cell reads as a command that is not there.
_readme_entry = _urls(_ENTRY_RX.findall(readme.replace("\\|", "|")))
_upd_forced = _FORCED_RX.findall(upd.replace("\\|", "|"))
_upd_urls = _urls(_upd_forced)
check(
    "install: the README publishes exactly one bare entry point per platform",
    len(_readme_entry) == 2,
    f"found {sorted(_readme_entry)} — the whole point of the census-first "
    "installer is that a person types ONE line per platform; a second bare "
    "variant is the four-command surface growing back",
)
check(
    "update: it runs the installer the README publishes, from the same URL",
    _upd_urls and _upd_urls == _readme_entry,
    f"README entry points: {sorted(_readme_entry)}; update.md: {sorted(_upd_urls)} "
    "— update fetches the published installer, so a URL that drifts updates to "
    "something the install instructions never described",
)
check(
    "update: all four scope-forced invocations are present, one per scope×platform",
    len(_upd_forced) == 4,
    f"found {len(_upd_forced)} — the matrix is personal/project × bash/PowerShell. "
    "update.md forces the scope precisely BECAUSE the bare command updates every "
    "copy it finds, which would falsify step 2's report of the path replaced; a "
    "missing cell is a platform that falls back to the bare command and over-updates",
)
check(
    "update: the census precedes every write, and names both locations",
    "Census both install locations before deciding anything" in upd
    and "~/.claude/skills/workforce" in upd
    and "${CLAUDE_PROJECT_DIR}/.claude/skills/workforce" in upd,
    "resolving scope from a flag alone updates a path the user did not expect, "
    "which is indistinguishable from no update at all",
)
check(
    "update: it does not reimplement the installer's fetch loop",
    "does not carry its own copy of the download loop" in upd,
    "'re-fetch every manifest file' is an instruction to reimplement the "
    "installer; the manifest exists so both installers share ONE fetch loop",
)
check(
    "update: it names the follow-up instead of performing it",
    "Run `/workforce verify` to check the org against this release" in upd,
    "dropping the sweep without handing off leaves the user with no next step; "
    "the report has to name verify, not just decline to be it",
)

# ── Procedure steps are numbered once ────────────────────────────────────────
# review.md carried two step 6s for as long as it had six steps. Nothing read the
# numbers, so nothing noticed — and a reader following "step 6" reaches whichever
# one they scroll to first.
_dupe_steps = []
for _p in declared:
    if "/procedures/" not in _p:
        continue
    _nums = [int(n) for n in re.findall(r"^\*\*(\d+)\.\s", read(_p), re.M)]
    if len(_nums) != len(set(_nums)):
        _dupe_steps.append((os.path.basename(_p), sorted(_nums)))
check(
    "procedures: bold step numbers are unique within a file",
    not _dupe_steps,
    f"{_dupe_steps} — a repeated step number makes 'step N' ambiguous to the "
    "reader following it",
)

# ─────────────────────────────────────────────────────────────────────────────
# 10. README copy-button discipline — one command per fenced block
# ─────────────────────────────────────────────────────────────────────────────
multi = [
    b.strip()[:50]
    for lang, b in re.findall(r"```(\w*)\n(.*?)```", read("README.md"), re.S)
    if lang in ("", "bash", "powershell")
    and len([x for x in b.strip().split("\n") if x.strip()]) > 1
]
check("README: one copyable command per fenced block", not multi, f"stacked: {multi}")

# ─────────────────────────────────────────────────────────────────────────────
# The marker table and the census must name the same families
# ─────────────────────────────────────────────────────────────────────────────
# `legacy-markers.md` says of itself that the table "grows from" families the
# generic detector finds. It said that on 2026-07-31, named three, and the table
# did not grow — doctrine written, nothing making it true, which is this project's
# dominant failure mode. The two lists drifting apart is silent in both directions:
# a family in the table but not the census is never detected, and a family in the
# census but not the table is re-reported as unclassified every run forever.
_lm = read("workforce/references/legacy-markers.md")
_bl = read("bin/baseline")
