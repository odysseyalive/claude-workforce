# ─────────────────────────────────────────────────────────────────────────────
# A RETRACTION ACTUALLY REMOVED THE TEXT IT RETRACTS
# ─────────────────────────────────────────────────────────────────────────────
# CLAUDE.md carried this as an open structural gap: "nothing verifies that a
# retraction actually removed the text it retracts (that is how verify.md carried an
# instruction eight lines below its own retraction)."
#
# "restart required" is the worked example. It is a MEASURED falsehood, retracted in
# platform.md, and CLAUDE.md records that it "has crept back into this file, audit.md,
# bin/sync, and both installers once already." Six files now declare it retracted --
# and nothing ever checked that the claim itself was gone.
#
# The declaration is the handle: a line saying `never write "X"` / `do not write "X"`
# / `"X" ... is retracted` names the exact string that must not appear as a live
# claim. Any OTHER line carrying X must also carry a retraction token, or it is the
# retracted claim still being asserted.
_shipped_md = [p for p in manifest_paths() if p.endswith('.md')]

# The declaration must be BLANKET, not conditional. "Never write `derived` FOR an
# enumeration that was not run" forbids a term in one context; the term is legitimate
# everywhere else. A trailing for/when/unless/if/in clause marks that, and a
# single-word phrase is almost always a term rather than a claim — "restart required"
# is a claim, "derived" is a word. Both filters were added after the first run flagged
# four legitimate uses of `derived`; this is the mention-vs-use distinction the MCP,
# IC-spawn, and marker checks each needed too.
RETRACTION_DECL = re.compile(
    r'(?:never write|do not write|no longer write)\s+[`"]([^`"]{4,60}\s[^`"]{2,})[`"]'
    r'(?!\s*(?:for|when|unless|if|in|on|about)\b)', re.I)
RETRACTION_TOKEN = re.compile(
    r'retract|never write|do not write|no longer write|superseded|falsehood'
    r'|is not required|would be false|is false|not the only', re.I)
# A WINDOW, NOT A LINE. Every reference here is hard-wrapped at ~100 columns, so the
# qualifier that makes a mention legitimate routinely sits on the PREVIOUS line — the
# first run flagged platform.md:211 for carrying the phrase while the word
# "retraction" sat on 210. Reading one line at a time reproduces, inside this check,
# the exact hazard `CLAUDE.md` § Assertions match contiguous fragments describes.
RETRACT_WINDOW = 2

_retracted, _live = set(), []
for _p in _shipped_md + ["CLAUDE.md"]:
    for _m in RETRACTION_DECL.finditer(read(_p) or ""):
        _retracted.add(_m.group(1).strip())

for _phrase in sorted(_retracted):
    for _p in _shipped_md + ["CLAUDE.md"]:
        _lines = (read(_p) or "").splitlines()
        for _i, _line in enumerate(_lines, start=1):
            if _phrase.lower() not in _line.lower():
                continue
            _ctx = "\n".join(_lines[max(0, _i - 1 - RETRACT_WINDOW): _i + RETRACT_WINDOW])
            if not RETRACTION_TOKEN.search(_ctx):
                _live.append(f"{_p}:{_i} asserts {_phrase!r}")

check("retractions: no retracted claim is still asserted anywhere",
      not _live,
      f"{_live[:4]} — a line carrying a retracted phrase without a retraction token is the claim "
      "living on. This is how a file carried an instruction eight lines below its own retraction.")

check("retractions: at least one retraction is declared and therefore checked",
      bool(_retracted),
      "no `never write \"X\"` declaration found — the check would pass vacuously, which is the "
      "failure mode it exists to catch")

# ─────────────────────────────────────────────────────────────────────────────
# ONE CANONICAL BLOCK PER MARKER FAMILY
# ─────────────────────────────────────────────────────────────────────────────
# CLAUDE.md carried this as an open structural gap: "nothing checks that a marker
# family has exactly one canonical block beyond the dispatch block specifically (that
# is how org.md shipped two)."
#
# Measured 2026-08-03: ORG-CHAIN had a populated template in BOTH
# handbook-templates.md and procedures/org.md, and THEY DISAGREED — one said
# escalation returns "to your caller", the other "to your manager". An author
# following the template wrote one; `org embed` overwrote it with the other, because
# the marker says "safe to replace" so the generator always wins.
#
# CANONICAL_HOME is hand-maintained for the same reason PRODUCERS is: a second
# populated block forces someone to decide which file owns the text, rather than
# leaving two to drift. Blocks under BODY_MIN bytes are marker pairs quoted in prose,
# not definitions — the mention-vs-use distinction this project has now needed three
# times.
CANONICAL_HOME = {
    "ORG-CHAIN": {"workforce/references/procedures/org.md"},
    "ORG-DISPATCH-CHECKPOINT": {"workforce/references/procedures/org.md"},
    # Two tier VARIANTS (CEO and IC) plus one filled ILLUSTRATION in the format spec.
    # Different fill of one shape, not competing definitions.
    "ORG-RECORD": {"workforce/references/handbook-templates.md",
                   "workforce/references/org-chart-format.md"},
    "NAME": {"workforce/references/legacy-markers.md"},
}
BODY_MIN = 200

_fam_files = {}
for _p in _shipped_md:
    _b = read(_p) or ""
    for _m in re.finditer(r"<!--\s*([A-Z][A-Z0-9-]+)\s+START\b(.*?)<!--\s*\1\s+END\s*-->", _b, re.S):
        if len(_m.group(2)) >= BODY_MIN:
            _fam_files.setdefault(_m.group(1), set()).add(_p)

_stray = {f: sorted(fs - CANONICAL_HOME.get(f, set()))
          for f, fs in _fam_files.items() if fs - CANONICAL_HOME.get(f, set())}
check("markers: every family's canonical block lives where CANONICAL_HOME says",
      not _stray,
      f"populated blocks outside the declared home: {_stray} — two populated blocks of one family "
      "drift, and the generated one always wins because the marker says 'safe to replace'")

# ─────────────────────────────────────────────────────────────────────────────
# EVERY ARTIFACT READ HAS A NAMED PRODUCER
# ─────────────────────────────────────────────────────────────────────────────
# The dominant defect shape of 2026-08-03, found four times in one day and never by
# re-reading: a CONSUMER NAMED, A PRODUCER ASSUMED.
#
#   .directives.sha      `verify` and `hooks` each named `/workforce checksums` as the
#                        REMEDY for its absence. No procedure created it. Every fresh
#                        install shipped with directive protection reporting
#                        UNPROTECTED forever.
#   platform-local.md    audit's own canary table has a `PASS (on record)` row that
#                        READS it. Nothing wrote it. A canary could pass on every run
#                        forever and never be recorded.
#   the `.orig` file     journal row 101 cited it, the sweep's gate checked the
#                        journal rather than the disk, and the file never existed.
#
# Re-reading cannot find these: an absent producer leaves NO TRACE in the file that
# consumes it. The only mechanical form is to enumerate what is read and require a
# producer to be named for each.
#
# PRODUCERS is deliberately hand-maintained. A new artifact must be added here, which
# is the moment its author is asked "and what writes it?" — the same reason `Class
# fix:` is a field rather than a habit.
PRODUCERS = {
    ".claude/workforce/org-chart.md": "workforce/references/procedures/org.md",
    ".claude/workforce/org-config.md": "workforce/references/audit-setup.md",
    ".claude/workforce/deferred.md": "workforce/references/deferred.md",
    ".claude/workforce/dispositions.md": "workforce/references/procedures/audit.md",
    ".claude/workforce/.conversion-journal.md": "workforce/references/procedures/hire.md",
    ".claude/workforce/.directives.sha": "workforce/references/procedures/checksums.md",
    ".claude/workforce/.settings-owned.json": "workforce/references/audit-setup.md",
    ".claude/workforce/platform-local.md": "workforce/references/procedures/audit.md",
    ".claude/workforce/personnel/index.md": "workforce/references/procedures/audit.md",
    ".claude/workforce/.current-run": "workforce/references/procedures/audit.md",
    ".claude/workforce/census.json": "workforce/references/procedures/audit.md",
    ".claude/workforce/.agents-symlink-manifest.txt": "workforce/references/procedures/audit.md",
    ".claude/workforce/.spawn-count": "workforce/references/delegation-budget.md",
    ".claude/workforce/pass-baseline.md": "workforce/references/procedures/audit.md",
}

_artifacts = set()
for _p in _shipped_md:
    for _a in re.findall(r"\.claude/workforce/[A-Za-z0-9._/-]+", read(_p) or ""):
        _a = _a.rstrip(".,)`'\"")
        # directories and run-scoped paths have no single producer
        if _a.endswith("/") or "/work/" in _a or "/staging/" in _a or "/evals/" in _a:
            continue
        if _a.count("/") >= 2 and not _a.split("/")[-1].count("."):
            continue
        _artifacts.add(_a)

_unmapped = sorted(_artifacts - set(PRODUCERS))
check("artifacts: every artifact a shipped file reads has a named producer",
      not _unmapped,
      f"no producer mapped for {_unmapped} — an absent producer leaves no trace in the file "
      "that consumes it, which is how .directives.sha and platform-local.md each shipped with "
      "a reader and no writer. Add it to PRODUCERS with the file that creates it.")

_stale = sorted(a for a, prod in PRODUCERS.items()
                if a in _artifacts and os.path.basename(a) not in (read(prod) or ""))
check("artifacts: every named producer actually mentions its artifact",
      not _stale,
      f"mapped producer does not name the artifact: {_stale} — the map has gone stale, which "
      "makes it a second place to be wrong rather than a check")

# ─────────────────────────────────────────────────────────────────────────────
# The CLAUDE.md machinery has to travel to the NEXT project
# ─────────────────────────────────────────────────────────────────────────────
# Asked on 2026-08-03, one hour after the machinery landed: "are they transmutable
# to any other project going forward?" All three answers were no.
#   - a project with source and no CLAUDE.md got exit 2 — the script refused the
#     single case the directive most clearly covers, "built mechanically"
#   - wf-context, the measurement the whole case rests on, was wired only into
#     `budget`, so no audit ever printed it
#   - claude-md.md said "reported again by verify" and verify.md said nothing
# The third is doctrine written the same hour as its own contradiction.

_cmd = read("workforce/bin/wf-claude-md")
# SUPERSEDED 2026-08-05, and inverted rather than deleted. This asserted
# "ABSENT IS THE SPARSEST CASE" — that a project with no CLAUDE.md should have one
# CREATED, which was correct under the 2026-08-03 directive ("very sparce or next to
# nothing"). The new directive evacuates the file and DELETES it, so creating one
# would have a single audit writing the file it then removes, and re-creating it on
# every later run of an already-evacuated project.
#
# The check is kept pointing the other way because the old behaviour is exactly what
# a future edit would drift back into: the comment justifying it is persuasive and
# the directive superseding it lives in a different file.
# A LEDGER CITATION MUST RESOLVE TO THE LINE IT NAMES. `IMMUTABLE_RX` substituted the
# newlines its match spanned, so numbering survived a sacred block; `REGION_RX.sub("")`
# deleted the generated region outright and collapsed every line after it. MEASURED
# 2026-08-06 on this repository: CLAUDE.md held 168 lines, the ledger enumerated 149,
# and all 78 citations it printed were short by the region's height. The whole job of
# this ledger is to send a reader to a specific line before that file is deleted.
# THE COMMENT PROMISED HOOKS AND THE FILTER EXCLUDED THEM. `relocated_lines` says
# "Scripts and hooks count: a rule enforced by a hook has arrived at its destination
# even though the destination is not prose" — then selected by extension, and all 13
# shipped scripts/hooks in this distribution are extensionless. MEASURED 2026-08-06:
# four lines relocated verbatim into `wf-standing-request` stayed UNPLACED, so
# CLAUDE.md could never be deleted for a rule that HAD reached the only always-on
# component. The 2026-08-05 directive names scripts and hooks as destinations.
# THE LEDGER PROVES ARRIVAL, NEVER COHERENCE. Eighteen lines relocated verbatim into
# `runtime-lead` during this project's own audit took the ledger 32 -> 50 with every
# gate green, and produced three duplications and two contradictions inside one
# handbook. Retention is satisfied by a copy; the receiving component still has to be
# reconciled, and nothing said so until 2026-08-06.
_clmd = read("workforce/references/claude-md.md")
# THE COVERAGE HEADERS HAD A PRODUCER AND NO VERIFIER. `bin/coverage --stamp` writes a
# per-file `N assertion(s) in bin/check name this file` line into 71 shipped files; no
# procedure ran it, `bin/check` never checked it, and the script was not even
# executable (mode 644). MEASURED 2026-08-06 by a cold-read probe whose own new
# assertion made a header stale the instant it landed: 20 of 71 headers were wrong.
# A generated label that drifts from what it describes is the exact defect the label
# was introduced to fix, one level up.
check(
    "bin/coverage is executable, so the headers it writes can be regenerated",
    os.access("bin/coverage", os.X_OK),
    "it shipped mode 644 — the one script in bin/ that could not be run — which is why "
    "71 generated headers drifted with nothing noticing",
)

check("claude-md.md requires the receiving component to be reconciled, not just copied into",
      "Reconcile the receiving component" in _clmd
      and "A relocated rule its host forbids has not arrived" in _clmd
      and "the user's words REPLACE the paraphrase" in _clmd.replace("**", ""),
      "a verbatim copy passes the ledger while leaving two canonical texts, or a rule "
      "its host's Scope forbids — both invisible to a proof that only asks whether the "
      "line exists somewhere",
)

check("wf-claude-md counts extensionless scripts and hooks as evacuation destinations",
      'if not fh.readline(2048).startswith(b"#!")' in _cmd,
      "a shebang is what makes a file a script whatever it is called; an extension "
      "list silently excluded every destination the directive names and the "
      "function's own comment promises",
)

check("wf-claude-md's evacuation citations resolve to real CLAUDE.md lines",
      'REGION_RX.sub(_blank, body)' in _cmd
      and '_blank = lambda m: "\\n" * m.group(0).count("\\n")' in _cmd,
      "the region must be newline-padded like the immutable blocks, not deleted — a "
      "relocation ledger that sends a reader to the wrong line is worse than one that "
      "refuses, because the reader relocates the wrong text and the gate still passes")

check("wf-claude-md treats an absent CLAUDE.md as the goal state, creating nothing",
      # The FULL banner, not the bare phrase. `--evacuate` also says "ABSENT IS THE
      # GOAL STATE" about a tree that has already been emptied, so asserting the
      # phrase alone matched a different branch and the check stayed green with the
      # creating code restored — VACUOUS on its first bin/prove run.
      "ABSENT IS THE GOAL STATE, AND NOTHING IS CREATED." in _cmd
      and "Nothing created." in _cmd
      and "ABSENT IS THE SPARSEST CASE" not in _cmd,
      "creating a CLAUDE.md makes one audit write the file it then evacuates and "
      "deletes, and puts the file back on every run of a project that had already "
      "been evacuated (SKILL.md § Directives, 2026-08-05)")

check("audit's survey measures the per-spawn cost with wf-context",
      "wf-context" in aud,
      "the 89% figure is what makes the cost legible; it was reachable only from `budget`")

check("verify reports the CLAUDE.md split",
      "wf-claude-md" in vfy,
      "claude-md.md claims verify reports it — this is the half that makes that true")

check("verify names DUPLICATED as a finding",
      "DUPLICATED above zero is a finding" in vfy,
      "a duplicated line is paid on every spawn while the handbook copy is paid once")

