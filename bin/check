# ─────────────────────────────────────────────────────────────────────────────
# The retracted "ships zero hooks / no executables" claim, everywhere it can hide
# ─────────────────────────────────────────────────────────────────────────────
# The count check above holds enforcement.md to the manifest. It held NOTHING
# else: on 2026-08-04 a dev audit found the retracted claim still asserted, live,
# in five more files — two shipped (delegation-budget.md, audit.md § hook census)
# and three unshipped but read by every maintainer or user (CLAUDE.md § Layout,
# both installer comments). Same class as the "restart required" lint: prose that
# QUOTES the old claim as history is fine; prose that ASSERTS it is not. History
# gets a one-line window either side, because these files hard-wrap at ~100
# columns and the retraction token can land on the neighbouring line.
_ZERO_ASSERT = re.compile(r"ships (?:\*\*)?(?:zero|ZERO|no) (?:hooks|executables)")
_ZERO_OK = re.compile(r"(?:said|retract|correction|generalized|used to)")
_zero_hits = []
for _p in sorted(set([p_ for p_ in declared if p_.endswith(".md")]
                     + ["CLAUDE.md", "README.md", "COMMANDS.md", "install", "install.ps1"])):
    _zlines = read(_p).splitlines()
    for _zi, _zline in enumerate(_zlines):
        if _ZERO_ASSERT.search(_zline):
            _zctx = "\n".join(_zlines[max(0, _zi - 1):_zi + 2])
            if not _ZERO_OK.search(_zctx):
                _zero_hits.append(f"{_p}:{_zi + 1}")
check(
    "hooks: no file asserts the distribution ships zero hooks or zero executables",
    not _zero_hits,
    f"retracted claim asserted at: {_zero_hits} — the manifest flags "
    f"{len(manifest_hook_paths())} hook(s); quote the history with a retraction "
    "token within one line, or state the current count",
)

