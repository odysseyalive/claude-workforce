# ─────────────────────────────────────────────────────────────────────────────
# A claim that `verify` enforces something is a claim about ANOTHER file.
#
# data-skills.md carried two of them — "a data skill that lacks any of these is a
# `verify` finding" and "`verify` enforces it" — while procedures/verify.md
# mentioned data skills ZERO times. Correct doctrine, nothing making it true:
# the shape this project records five times over.
#
# The instance is fixed by verify.md § Data-skill conformance. This is the class:
# every file that says `verify` finds X must name an X that verify.md covers.
# Nouns are a closed vocabulary so the check fails LOUDLY on an unclassifiable
# claim rather than passing over a sentence it could not parse.
# ─────────────────────────────────────────────────────────────────────────────

check(
    "verify: data-skill conformance is carried, not just claimed elsewhere",
    "## Data-skill conformance" in vfy
    and "§ Required sections" in vfy
    and "reachable from a handbook" in vfy,
    "data-skills.md says `verify` enforces the section list and the no-orphan rule; "
    "verify.md must carry both, by reference and never by restating the sections",
)

# The section list is a constant with a single home. verify.md citing it is right;
# verify.md LISTING it would be the restatement bug, one file further along.
check(
    "verify: the required-section list is referenced, never restated",
    sum(1 for s in REQUIRED_DS_SECTIONS if s in vfy) <= 1,
    "verify.md restates data-skills.md's section list — cite § Required sections instead",
)

# Closed vocabulary: the artifact kinds verify.md is allowed to be said to find.
VERIFY_SUBJECTS = {
    "data skill": "## Data-skill conformance",
    "playbook": "Records Owner",
    "handbook": "## Handbook conformance",
    "constant": "## Constants",
    "tier count": "## Constants",
    "persona": "Personas unique",
    "name": "Names unique",
}
_verify_claim = re.compile(r"`verify`\s+(?:finding|enforces)|is a `verify` finding", re.I)

# SCAN BY PARAGRAPH, NOT BY LINE. Every reference here is hard-wrapped at ~100
# columns, so a claim and its subject routinely land on different lines — "A
# restated constant is a\n`verify` finding". A line-scan reported both of this
# repo's correctly-wired claims as unclassifiable on its first run. The paragraph
# is the smallest unit that reliably holds a whole sentence.
#
# A paragraph carrying two claims is checked against the union of its nouns,
# which is loose. Preferring that to a sentence splitter is deliberate: the
# failure mode of loose is a claim that passes, and of a bad splitter is a
# correct claim that fails, which is how a diagnostic gets switched off.
_unwired, _unclassifiable = [], []
for _p in declared:
    if not _p.endswith(".md") or _p.endswith("procedures/verify.md"):
        continue
    _line_no = 1
    for _para in re.split(r"\n\s*\n", read(_p)):
        if _verify_claim.search(_para):
            _subs = [s for s in VERIFY_SUBJECTS if s in _para.lower()]
            if not _subs:
                _unclassifiable.append(f"{_p}:{_line_no}")
            for _s in _subs:
                if VERIFY_SUBJECTS[_s] not in vfy:
                    _unwired.append(f"{_p}:{_line_no} claims verify finds '{_s}'")
        _line_no += _para.count("\n") + 2

check(
    "verify: every claim that `verify` finds X resolves to a check in verify.md",
    not _unwired,
    f"unwired: {_unwired}",
)
check(
    "verify: every `verify` finding claim names a known artifact kind",
    not _unclassifiable,
    f"unclassifiable: {_unclassifiable} — add the noun to the sentence, or a row to "
    "VERIFY_SUBJECTS once verify.md actually covers that kind",
)

# Constants stated once, applied to the marker table. Two files listing the same
# regexes is how a sweep starts matching different things in different steps.
check("legacy-markers: the marker table exists", "ENFORCEMENT ANNOTATION" in lm and "ROUTE-EMBED" in lm)

# The table is the single artifact both bin/baseline and the sweep match against,
# and it was guarded by two incidental substrings. An audit relaxed the
# foreign-origin regex to drop its `(?!user\b)` guard — making the PROTECTED class
# match as foreign origin — reclassified the ledger row, and deleted the sidecar
# row, all at 290/0.
# Middle column is not always a bare backticked regex — two rows describe a path
# or a directory shape in prose ("`.directives.sha` at a skill root"). Parse the
# CELLS, not an assumed shape; a parser that silently matched 7 of 9 rows would
# have left the two prose rows unguarded, which is the class this check exists for.
_marker_rows = [
    tuple(c.strip() for c in _l.strip().strip("|").split("|"))
    for _l in lm.splitlines()
    if _l.startswith("| ") and _l.count("|") == 4 and "---" not in _l
    and not _l.startswith("| Marker |")
]
check(
    "legacy-markers: the table carries every marker family",
    len(_marker_rows) >= 9,
    f"only {len(_marker_rows)} parseable marker rows — the table is the single "
    "source the sweep matches against",
)
check(
    "legacy-markers: the user-immutable row stays classed protected",
    any("immutable" in _rx and "protected" in _c.lower() for _n, _rx, _c in _marker_rows),
    "flipping that row's class tells the sweep that user directives are deletable machinery",
)
check(
    "legacy-markers: the foreign-origin regex still excludes user and workforce",
    any("(?!user" in _rx and "(?!workforce" in _rx for _n, _rx, _c in _marker_rows),
    "without both negative lookaheads the protected class matches as foreign origin",
)
check(
    "legacy-markers: the sidecar row keeps its skill-root qualifier",
    any(".directives.sha" in _rx and "skill root" in _rx for _n, _rx, _c in _marker_rows),
    "without it the table classifies THIS project's own sidecar as predecessor "
    "scaffolding, and the sweep deletes the file `checksums` reads",
)

