#!/usr/bin/env python3
"""
Conformance check for claude-workforce.

This is the project's OWN verification — the runnable check its handbooks
demand of every employee. Run it before every commit:

    python3 bin/check          # or: bin/check

Exit 0 = conformant. Exit 1 = at least one FAIL.

Every check here exists because its failure mode is SILENT: the repo looks
fine and something is wrong. Most were discovered by hand during the build
and are recorded here so they cannot recur unnoticed.
"""

import os
import re
import sys
import glob

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
os.chdir(ROOT)

FAILS = []
WARNS = []
PASSES = 0


def check(name, ok, detail=""):
    global PASSES
    if ok:
        PASSES += 1
    else:
        FAILS.append((name, detail))


def warn(name, detail=""):
    WARNS.append((name, detail))


def read(p):
    """Read a file, or return "" if it is not there.

    A DIAGNOSTIC MUST NOT DIE ON THE INPUT IT EXISTS TO DIAGNOSE. Any missing
    declared file — a typo, a deleted path, a manifest flag prefix — used to raise
    FileNotFoundError from whichever later check read it first, killing the run
    before the report printed. The dedicated existence check would already have
    recorded the FAIL; the traceback threw it away and reported nothing else
    either. Missing files are reported by check 1 and read as empty everywhere.
    """
    if not os.path.isfile(p):
        return ""
    with open(p, encoding="utf-8", errors="replace") as f:
        return f.read()


def manifest_paths():
    """Shipped files.

    The `keep ` / `hook ` flag prefixes are gone: they existed only for the four
    hook files removed in b5ddbba, and no line used them afterward. A reappearing
    prefix is caught by the check below rather than silently parsed.
    """
    out = []
    for line in read("manifest.txt").splitlines():
        s = line.strip()
        if not s or s.startswith("#"):
            continue
        out.append(s)
    return out


# ─────────────────────────────────────────────────────────────────────────────
# 1. Manifest is the single authoritative shipped-file list
# ─────────────────────────────────────────────────────────────────────────────
declared = manifest_paths()
missing = [p for p in declared if not os.path.exists(p)]
check("manifest: every declared file exists", not missing, f"missing: {missing}")

flagged = [p for p in declared if p.split(" ")[0] in ("keep", "hook")]
check(
    "manifest: no flag prefixes",
    not flagged,
    f"flag-prefixed lines: {flagged} — `keep `/`hook ` handling was removed with the "
    "hooks; re-adding a flag means re-adding its handling to bin/check and bin/sync",
)

on_disk = {
    p for p in glob.glob("workforce/**/*", recursive=True)
    if os.path.isfile(p) and not os.path.basename(p).startswith(".")
}
undeclared = sorted(on_disk - set(declared))
check(
    "manifest: no shipped file is undeclared",
    not undeclared,
    f"on disk but not in manifest (installers would never fetch these): {undeclared}",
)

# ─────────────────────────────────────────────────────────────────────────────
# 2. Constants are stated once (forward mobility)
#
# A platform change must be a small declared sweep, not a hunt. platform.md is
# the source of truth; the installers cannot read markdown at install time; the
# user-facing docs describe the product to a human; scopes.md documents the
# exception list.
# ─────────────────────────────────────────────────────────────────────────────
CONST_EXEMPT = {
    "workforce/references/platform.md",
    "workforce/references/scopes.md",
    # The sanctioned home for model IDs, per platform.md § Derived constants:
    # "the same applies to model IDs (which live in org-config.md, never in
    # prose)". org-config.md is the per-project instantiation; THIS is the
    # template it is instantiated from, so it is the one file that must carry
    # them. Omitting it here is what kept the shipped statics empty — the
    # payroll picker had nothing to propose and no way to acquire it, because
    # the check forbade the fix in the only legal place for it.
    "workforce/references/org-config.template.md",
    "install",
    "install.ps1",
    "README.md",
    "COMMANDS.md",
}
CONST_RX = re.compile(
    r"\bthree tiers\b|\bthree-tier\b|\b20 concurrent\b|\b200 subagents?\b"
    # Model IDs are constants too — platform.md § Derived constants says so
    # explicitly ("and to model IDs, which live in org-config.md, never in
    # prose"). The rule was written; the check never covered it, leaving the one
    # class of constant most likely to churn unguarded.
    r"|\bclaude-(?:opus|sonnet|haiku|fable)-[\w.\[\]-]*\d",
    re.I,
)
offenders = [
    p for p in declared
    if p.endswith(".md") and p not in CONST_EXEMPT and CONST_RX.search(read(p))
]
check(
    "constants: stated once, outside the declared exceptions",
    not offenders,
    f"restated in: {offenders} — see platform.md § Derived constants",
)

# ─────────────────────────────────────────────────────────────────────────────
# 3. Cross-references resolve
#
# Backticks are NOT required. The original pattern demanded them, so nine bare
# `references/…md` mentions went unvalidated — SEVEN of them in SKILL.md, the
# file whose grounding paths matter most. A path is a path whether or not it is
# quoted.
# ─────────────────────────────────────────────────────────────────────────────
REF_RX = re.compile(r"(?<![\w/])references/[\w./-]+\.md")
broken = []
for p in glob.glob("workforce/**/*.md", recursive=True) + [
    "README.md", "COMMANDS.md", "CLAUDE.md",
]:
    for m in REF_RX.findall(read(p)):
        if not os.path.exists("workforce/" + m):
            broken.append((p, m))
check(
    "references: every references/… link resolves, backticked or bare",
    not broken,
    f"broken: {broken}",
)

readme = read("README.md")
img_broken = [
    src for _, src in re.findall(r"!\[([^\]]*)\]\(([^)]+)\)", readme)
    if not src.startswith("http") and not os.path.exists(src)
]
check("README: every image resolves", not img_broken, f"missing: {img_broken}")

# In-document anchors are not paths. Resolve them against the heading slugs
# instead — treating them as files was a false positive on this check's own terms.
slugs = {
    re.sub(r"[^a-z0-9]+", "-", h.lower()).strip("-")
    for h in re.findall(r"^#{2,3} (.+)$", readme, re.M)
}
bad_anchors = [a for a in re.findall(r"\]\(#([^)]+)\)", readme) if a not in slugs]
check("README: every in-document anchor resolves", not bad_anchors, f"broken: {bad_anchors}")

link_broken = [
    tgt.split("#")[0] for _, tgt in re.findall(r"\[([^\]]+)\]\(([^)]+)\)", readme)
    if not tgt.startswith(("http", "#")) and not os.path.exists(tgt.split("#")[0])
]
check("README: every relative link resolves", not link_broken, f"missing: {link_broken}")

# ─────────────────────────────────────────────────────────────────────────────
# 4. Project state never lives in the skill directory
#
# The invariant that lets ONE personal install serve many projects. Break it and
# a single config is shared across unrelated orgs.
# ─────────────────────────────────────────────────────────────────────────────
STATE_RX = re.compile(
    r"\.claude/skills/workforce/[\w./-]*(?:org-config\.md|org-chart|personnel/|work/|evals/|ablations/)"
)
leaks = [p for p in declared if p.endswith(".md") and STATE_RX.search(read(p))]
check("scopes: no project state written into the skill directory", not leaks, f"leaks: {leaks}")

# ─────────────────────────────────────────────────────────────────────────────
# 5. SKILL.md structure and marker pairing
# ─────────────────────────────────────────────────────────────────────────────
skill = read("workforce/SKILL.md")
check("SKILL.md: frontmatter present", skill.startswith("---\n"))
fm = skill.split("\n---\n")[0]
for key in ("name:", "description:", "when_to_use:", "allowed-tools:"):
    check(f"SKILL.md: frontmatter has {key}", key in fm)
check(
    "SKILL.md: ENFORCEMENT ANNOTATION blocks are paired",
    skill.count("<!-- ENFORCEMENT ANNOTATION") == skill.count("<!-- END ENFORCEMENT ANNOTATION -->"),
    f"{skill.count('<!-- ENFORCEMENT ANNOTATION')} open vs "
    f"{skill.count('<!-- END ENFORCEMENT ANNOTATION -->')} close",
)
# Count only STANDALONE markers — one on its own line. Prose that documents the
# marker syntax (`<!-- origin: user | immutable: true -->` inside backticks) is a
# mention, not a marker, and counting it produced 8 false failures on this
# check's first run.
OPEN_RX = re.compile(r"^<!--\s*origin:.*-->\s*$", re.M)
CLOSE_RX = re.compile(r"^<!--\s*/origin\s*-->\s*$", re.M)
for p in declared:
    if not p.endswith(".md"):
        continue
    body = read(p)
    o, c = len(OPEN_RX.findall(body)), len(CLOSE_RX.findall(body))
    check(f"origin blocks paired in {os.path.basename(p)}", o == c, f"{o} open vs {c} close")

# ─────────────────────────────────────────────────────────────────────────────
# 6. Shipped agents are leaf helpers
#
# They run as panel members. If one could delegate it would consume a tier from
# the org that hired it — measured as exactly the budget the chain of command needs.
# ─────────────────────────────────────────────────────────────────────────────
for p in glob.glob("workforce/agents/*/AGENT.md"):
    body = read(p)
    name = os.path.basename(os.path.dirname(p))
    check(f"agent {name}: carries disallowedTools: Agent", "disallowedTools: Agent" in body)
    check(f"agent {name}: frontmatter has name:", re.search(r"^name:\s*\S+", body.split("\n---\n")[0], re.M) is not None)

# ─────────────────────────────────────────────────────────────────────────────
# 7. Handbook templates carry the load-bearing frontmatter
# ─────────────────────────────────────────────────────────────────────────────
tpl = read("workforce/references/handbook-templates.md")
check("templates: IC carries disallowedTools: Agent (the measured tier ceiling)", "disallowedTools: Agent" in tpl)
check("templates: delegating tiers carry background: false", "background: false" in tpl)
check("templates: no memory: field offered", not re.search(r"^\s*memory:\s*\w", tpl, re.M))
check("templates: MCP granted at server level", "mcp__playwright-mcp__*" in tpl)

pfp = read("workforce/references/procedure-for-procedures.md")
required = re.findall(r"\| `## (\w[\w ]*)` \|", pfp)
absent = [s for s in required if f"## {s}" not in tpl]
check("templates: every section the authoring spec requires is present", not absent, f"absent: {absent}")

# ─────────────────────────────────────────────────────────────────────────────
# 8. Every `fact N` citation resolves to a fact platform.md actually defines
#
# A citation to platform.md fact "3b" appeared in CLAUDE.md twice and in bin/sync
# once. No such fact has ever existed. It survived because nothing resolved fact
# numbers — the same blind spot that let `/workforce dev hooks` ship in seven
# files (see 8b), one class of reference later. A citation to a fact that does not
# exist reads as grounding and is its opposite: it sends a reader looking for
# evidence that was never written.
#
# Note the phrasing of the comment above: it names the bad number without writing
# it in citation form, because this file scans itself.
# ─────────────────────────────────────────────────────────────────────────────
plat_body = read("workforce/references/platform.md")
defined_facts = set(re.findall(r"^### Fact ([0-9]+[a-z]?)\b", plat_body, re.M))
defined_facts |= set(re.findall(r"^\| ([0-9]+[a-z]?) \|", plat_body, re.M))

CITE_RX = re.compile(r"\bfacts?\s+([0-9]+[a-z]?(?:\s*(?:,|and|/)\s*[0-9]+[a-z]?)*)", re.I)
dangling = {}
for p_ in declared + ["README.md", "COMMANDS.md", "CLAUDE.md", "bin/check", "bin/sync"]:
    if not os.path.exists(p_):
        continue
    for group in CITE_RX.findall(read(p_)):
        for n in re.findall(r"[0-9]+[a-z]?", group):
            if n not in defined_facts:
                dangling.setdefault(f"fact {n}", set()).add(p_)
check(
    "facts: every `fact N` citation resolves to a fact platform.md defines",
    not dangling,
    "dangling: " + "; ".join(f"{k} (in {', '.join(sorted(v))})" for k, v in dangling.items())
    + f" — defined: {sorted(defined_facts)}",
)

# ─────────────────────────────────────────────────────────────────────────────
# 8a. No duplicated heading or restated paragraph inside one file
#
# Both shipped. staging.md carried the same "instruct every canary" paragraph
# twice; audit.md had an EMPTY `## Step 1b` heading directly above the real
# `## Step 1c` with identical title text. Neither is catchable by eye in a
# 300-line reference, and a duplicated instruction is how two versions of one
# rule start drifting apart.
#
# The template files are exempt by design: each holds several complete handbook
# templates, so `## Role` / `## Verification` recurring per template is correct.
# ─────────────────────────────────────────────────────────────────────────────
DUP_EXEMPT = {
    "workforce/references/handbook-templates.md",
    "workforce/references/personnel-templates.md",
    "workforce/references/templates.md",
    "workforce/references/org-config.template.md",
}
for p in declared:
    if not p.endswith(".md") or p in DUP_EXEMPT:
        continue
    n = os.path.basename(p)
    lines = [l.rstrip() for l in read(p).splitlines()]

    heads = [l for l in lines if l.startswith("#")]
    dup_h = sorted({h for h in heads if heads.count(h) > 1})
    # Same title under different numbering — `## Step 1b — X` vs `## Step 1c — X`.
    titles = [re.sub(r"^#+\s*(?:Step\s+[\w.]+\s*[—-]\s*)?", "", h) for h in heads]
    dup_t = sorted({t for t in titles if titles.count(t) > 1 and t not in ("", "Both")})
    check(f"no duplicate heading in {n}", not (dup_h or dup_t), f"repeated: {dup_h or dup_t}")

    # Markers (`<!-- … -->`) repeat by design — six enforcement annotations open
    # with the same line. Their pairing is check 5's job, not this one's.
    prose = [
        l for l in lines
        if len(l) > 55 and not l.lstrip().startswith(("|", "#", "```", "<!--"))
    ]
    dup_p = sorted({l for l in prose if prose.count(l) > 1})
    check(f"no restated paragraph in {n}", not dup_p, f"repeated verbatim: {[l[:70] for l in dup_p]}")

# ─────────────────────────────────────────────────────────────────────────────
# 8b. Every /workforce command referenced anywhere actually exists
#
# `/workforce dev hooks --execute` was documented in SEVEN files, including one the
# installer printed for the user to run, and the command never existed. It shipped
# through nine commits because nothing checked command references — only
# `references/…` links were validated.
# ─────────────────────────────────────────────────────────────────────────────
# `dev` is a prefix, not a command; the referring regex strips it when resolving
# `/workforce dev <cmd>`. `audit` is the default command, documented in prose
# rather than in the description's Commands list. `hooks` is deliberately absent —
# it is the phantom this check exists to catch.
KNOWN_COMMANDS = set(
    re.findall(r"[\w-]+", re.search(r"Commands: ([^\"]+)", skill).group(1))
) | {"dev", "audit"}
referenced = {}
for p_ in declared + ["README.md", "COMMANDS.md", "CLAUDE.md", "install", "install.ps1", "manifest.txt"]:
    if not os.path.exists(p_):
        continue
    for m in re.findall(r"/workforce\s+(?:dev\s+)?([a-z][a-z-]*)", read(p_)):
        referenced.setdefault(m, set()).add(p_)
phantom = {c: sorted(v) for c, v in referenced.items() if c not in KNOWN_COMMANDS}
check(
    "commands: every referenced /workforce command exists in the command surface",
    not phantom,
    "phantom commands: " + "; ".join(f"{c} (in {', '.join(v)})" for c, v in phantom.items()),
)

# ─────────────────────────────────────────────────────────────────────────────
# 8c. This project ships no executables
#
# The four inherited hook files were removed once measurement showed they had never
# fired, could not be wired, and duplicated verify. Re-adding one is a decision that
# should be deliberate, so it fails here rather than passing quietly.
# ─────────────────────────────────────────────────────────────────────────────
executables = [p_ for p_ in declared if p_.endswith((".sh", ".ps1", ".py")) or os.access(p_, os.X_OK)]
check(
    "shipped files: no executables in the distribution",
    not executables,
    f"executable or script files in the manifest: {executables} — see enforcement.md § Hooks",
)

# ─────────────────────────────────────────────────────────────────────────────
# 9. Honesty rules — never claim enforcement the runtime will not deliver
# ─────────────────────────────────────────────────────────────────────────────
# The SANCTIONED honesty clause contains the word "enforced" by design —
# "enforced by prose plus permissions.deny. Prose is advisory…" — so a naive
# scan flags the very sentence written to prevent overclaiming. It did, on this
# check's first run. Strip the canonical clause, then scan what remains.
SANCTIONED = "Chain of command is enforced by prose plus permissions.deny"
OVERCLAIM = re.compile(
    r"chain of command is (?:enforced|guaranteed|prevented|sandboxed)"
    r"|(?:enforces|guarantees|prevents) (?:the )?chain of command",
    re.I,
)
overclaims = []
for p in declared + ["README.md", "COMMANDS.md"]:
    if not p.endswith(".md"):
        continue
    body = read(p).replace(SANCTIONED, "")
    if OVERCLAIM.search(body):
        overclaims.append(p)
check(
    "honesty: chain of command never described as enforced",
    not overclaims,
    f"overclaimed in: {overclaims} — it is detection, not prevention (enforcement.md)",
)

enf = read("workforce/references/enforcement.md")
check("honesty: enforcement.md states the cannot-enforce cases", "CANNOT. Detection only." in enf)

plat = read("workforce/references/platform.md")
check("platform: MEASURED-ON stamp present", "MEASURED-ON:" in plat)
check("platform: TIER-LIMIT constant present", "TIER-LIMIT:" in plat)
check("platform: MEASURED and DOCUMENTED are separated", "## DOCUMENTED" in plat and "## MEASURED" in plat)

# Every MEASURED fact must cite evidence a clone can actually open. platform.md
# promises "MEASURED facts carry their evidence path" — and cited `.claude/`,
# which is gitignored, so no reader could check one.
ev_broken = sorted({
    m for m in re.findall(r"`(measurements/[\w./-]+\.md)`", plat)
    if not os.path.exists(m)
})
check("platform: every cited evidence file exists", not ev_broken, f"missing: {ev_broken}")
check(
    "platform: evidence is not cited from gitignored project state",
    ".claude/workforce/canary" not in plat,
    "cites .claude/workforce/ — gitignored, so a clone cannot verify the measurement",
)

# ─────────────────────────────────────────────────────────────────────────────
# 10. README copy-button discipline — one command per fenced block
# ─────────────────────────────────────────────────────────────────────────────
multi = [
    b.strip()[:50]
    for lang, b in re.findall(r"```(\w*)\n(.*?)```", read("README.md"), re.S)
    if lang in ("", "bash", "powershell")
    and len([x for x in b.strip().split("\n") if x.strip()]) > 1
]
check("README: one copyable command per fenced block", not multi, f"stacked: {multi}")

# ─────────────────────────────────────────────────────────────────────────────
# Warnings — worth knowing, not worth failing
# ─────────────────────────────────────────────────────────────────────────────
for p in declared:
    if p.endswith(".md"):
        n = len(read(p).splitlines())
        if n > 260:
            warn(f"{os.path.basename(p)} is {n} lines", "long reference; candidate for a split or ablation")

if not os.path.exists("CLAUDE.md"):
    warn("no CLAUDE.md at the repo root", "a fresh session here has no orientation")

# ─────────────────────────────────────────────────────────────────────────────
# Report
# ─────────────────────────────────────────────────────────────────────────────
print(f"claude-workforce conformance — {len(declared)} shipped files\n")
if FAILS:
    print(f"FAIL ({len(FAILS)}):")
    for name, detail in FAILS:
        print(f"  ✗ {name}")
        if detail:
            print(f"      {detail}")
    print()
if WARNS:
    print(f"warnings ({len(WARNS)}):")
    for name, detail in WARNS:
        print(f"  · {name}" + (f" — {detail}" if detail else ""))
    print()
print(f"{PASSES} passed, {len(FAILS)} failed, {len(WARNS)} warnings")
sys.exit(1 if FAILS else 0)
