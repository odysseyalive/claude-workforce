# ─────────────────────────────────────────────────────────────────────────────
# THE THIRD COPY — a personal install shadows the runtime bin/sync builds
# ─────────────────────────────────────────────────────────────────────────────
# CLAUDE.md § The dual tree names two copies: source and `.claude/skills/workforce`.
# There is a third. A personal install at `~/.claude/skills/workforce` SHADOWS the
# project runtime, because skills resolve personal > project (`verify.md` § Install
# and scope), and `bin/sync` writes only DEST_ROOT — it has never touched it.
#
# So after `bin/sync` the maintainer has a synced runtime that is not what loads,
# and a loaded copy frozen at whenever `install` last ran. Measured 2026-08-03: the
# personal `wf-conform` was missing a check added minutes earlier, was used to
# verify a remediation, and returned `0 failed` from a script that could not fail.
# The verification was re-run against source and held — but it was luck that the
# count looked wrong enough to check.
#
# Detection only, and deliberately: `bin/sync` rebuilds DEST_ROOT by deleting it,
# and pointing that at a directory outside the repo is not a change this check
# should make on anyone's behalf.
_personal = os.path.expanduser("~/.claude/skills/workforce")
if os.path.isdir(_personal):
    # EVERY shipped file, never a hand-picked list. The sampled form (SKILL.md plus
    # three bin/ scripts) passed on 2026-08-04 while eleven reference files carrying a
    # whole doctrine change sat stale in the shadowing copy — the check was green and
    # the copy a session loads was a day behind. A sample cannot answer "is this copy
    # current"; only the whole manifest can.
    _drift, _missing, _compared = [], [], 0
    # `canary` files install to `.claude/agents/`, never into the skill tree, so
    # they are legitimately absent from the personal SKILL copy and comparing
    # them there reports 4 permanent phantom absences.
    _canary_set = set(manifest_canary_paths())
    for _src in sorted(declared):
        if _src in _canary_set:
            continue
        # manifest paths are repo-relative and ALREADY begin with "workforce/".
        # Joining "workforce" onto them again produced workforce/workforce/... ,
        # every os.path.exists missed, and the loop compared ZERO files while
        # reporting a pass — a vacuous green found 2026-08-04.
        if not _src.startswith("workforce/") or not os.path.exists(_src):
            continue
        _rel = _src[len("workforce/"):]
        _b = os.path.join(_personal, _rel)
        _compared += 1
        if not os.path.exists(_b):
            _missing.append(_rel)
        elif read(_src) != read(_b):
            _drift.append(_rel)

    # The anti-vacuity guard. A comparison that compared nothing is not a pass.
    check("the personal-install drift check actually compared files",
          _compared > 0,
          f"compared {_compared} files — the check reported a pass without reading anything, "
          "which is how eleven stale reference files sat behind a green run")

    _n = len(_drift) + len(_missing)
    _shown = ", ".join((_drift + _missing)[:6]) + (" …" if _n > 6 else "")
    check("personal install matches source (it shadows the runtime)",
          not _drift and not _missing,
          f"{len(_drift)} drifted, {len(_missing)} absent of {len(declared)} shipped files "
          f"({_shown}) — `~/.claude/skills/workforce` resolves BEFORE "
          "`.claude/skills/workforce`, so this is the copy a session loads. FIX: "
          "`bin/sync --personal`. Do NOT plain `./install` — it fetches the PUBLISHED "
          "tree and will overwrite local changes with older code while reporting a "
          "successful refresh; `WORKFORCE_REPO_URL=\"file://$PWD\" ./install --user` is "
          "the form that uses this checkout. Deleting the personal install also clears "
          "the drift, but removes /workforce from every OTHER project on this machine.")

