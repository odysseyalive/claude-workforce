# ─────────────────────────────────────────────────────────────────────────────
# THE SECOND FLOOR UNDER A REDUCTION: `A == B` CANNOT SEE A MARKER
#
# MEASURED 2026-08-04 on a real 32-skill reduction: TEN cuts broke marker integrity
# while passing the manifest check, and one removed an `origin: user | immutable: true`
# block outright — the user's own words, whose retention is the FIRST directive here.
# DEF-2026-08-04-heading-drop-eats-markers.
#
# The cause is structural. A cut is a SECTION-shaped span; a marker block is a
# DIFFERENT span. Where the two boundaries cross, the cut takes an opener and leaves
# its closer, or swallows a sacred block whole. Neither is invocable, so neither is
# visible to a surface manifest — the check was not weak, it was aimed elsewhere.
#
# `wf-remainder` reuses bin/check's OWN marker regexes rather than re-deriving them.
# Two readers of one marker that disagree about what a marker IS is this project's
# recorded failure (wf-conform vs wf-checkrun on `## Verification (mechanical)`), so
# the grammar is asserted identical in both files below.
# ─────────────────────────────────────────────────────────────────────────────
_rem = read("workforce/bin/wf-remainder")
check(
    "remainder: the cut refuses on a lost immutable block",
    # NOT `"immutable block(s)"` — that phrase is split across an f-string
    # concatenation in the source and matches nothing. The project's own hard-wrap
    # hazard, reproduced inside the check written to close a marker defect.
    "lost_sacred" in _rem and "lost  <!-- origin: user | immutable: true -->" in _rem,
    "a sacred block sitting between a dropped heading and the next one is removed by "
    "a section-shaped cut and is invisible to the surface manifest. Directive one "
    "makes this the gravest loss a reduction can cause, and it passed silently",
)
check(
    "remainder: the cut refuses on an unpaired marker",
    "unpaired" in _rem and "origin-open" in _rem and "enforcement-open" in _rem,
    "a cut crossing a marker boundary takes the opener and leaves the closer; the "
    "sweep then reads a malformed region. Ten of 32 real reductions did exactly this",
)
# ── PASS-MARKER-GRAMMAR ──────────────────────────────────────────────────────
# Every reader of the sacred-marker grammar must ACCEPT the same blocks. This
# replaces a textual pin that compared wf-remainder's regex SOURCE against a
# literal copy of bin/check's, which is why the divergence below survived it:
# the pin covered 2 of 8 readers, and compared spelling rather than behaviour.
# A faithful copy of the wrong pattern satisfied it exactly.
#
# MEASURED 2026-08-05, across 2,923 files in this repo and odyssey-alive: five
# readers accepted `immutable: true` in any field position and three required it
# to be the last field before `-->`. 160 sacred blocks vs 157. The three that
# could not see the other 3 were `bin/check --stamp` (which decides what gets a
# checksum), `bin/check` § immutable blocks, and `wf-remainder`'s T7b refusal
# (which decides whether a reduction that ate a user directive is caught). One of
# the misses was `fixtures/scripts/census-sacred-orders` — a registered fixture
# whose whole purpose is asserting field order does not matter.
#
# SCOPE: field order and internal spacing only. The readers still split on
# INDENTATION and that is deliberate, not an oversight — an indented marker sits
# inside a fenced template where it is a mention rather than a marker, and line
# 501 records 8 false failures from counting mentions. Resolving that split needs
# a ruling, not a widening; it is reported in plan/marker-grammar-2026-08-05.md.
import ast as _ast


def _marker_patterns(_path):
    """(lineno, pattern) for each re.compile naming origin + immutable.

    A pattern whose variable name carries MENTION is a deliberate INVERSE reader —
    it exists to find the indented examples the counters must skip, so it rejects
    every legal block on purpose. Excluded by name, because excluding it by line
    number would silently stop covering whatever moved into that position.
    """
    try:
        _tree = _ast.parse(read(_path))
    except SyntaxError:
        return
    _named = {}
    for _a in _ast.walk(_tree):
        if isinstance(_a, _ast.Assign) and isinstance(_a.value, _ast.Call):
            for _t in _a.targets:
                if isinstance(_t, _ast.Name):
                    _named[_a.value.lineno] = _t.id
    for _n in _ast.walk(_tree):
        if not (isinstance(_n, _ast.Call) and isinstance(_n.func, _ast.Attribute)
                and _n.func.attr == "compile" and _n.args):
            continue
        _parts = []

        def _collect(_a):
            if isinstance(_a, _ast.Constant) and isinstance(_a.value, str):
                _parts.append(_a.value)
            elif isinstance(_a, _ast.BinOp) and isinstance(_a.op, _ast.Add):
                _collect(_a.left)
                _collect(_a.right)

        _collect(_n.args[0])
        _pat = "".join(_parts)
        if _parts and "origin:" in _pat and "immutable" in _pat:
            if "MENTION" in _named.get(_n.lineno, "").upper():
                continue
            yield _n.lineno, _pat


def _sacred_block(_marker):
    return "prose before\n" + _marker + "\n> a directive\n<!-- /origin -->\nafter\n"


# Legal spellings every reader MUST accept. Ordering variants are the measured
# defect; the fixture above ratifies them.
_GRAMMAR_LEGAL = [
    _sacred_block("<!-- origin: user | immutable: true -->"),
    _sacred_block("<!-- origin: user | added: 2026-02-03 | immutable: true -->"),
    _sacred_block("<!-- origin: user | immutable: true | added: 2026-02-14 -->"),
    _sacred_block("<!--origin:user|immutable:true-->"),
]
# Spellings every reader MUST reject. A reader that accepts these would checksum,
# guard, or refuse to cut a block that is not sacred.
_GRAMMAR_ILLEGAL = [
    _sacred_block("<!-- origin: workforce | immutable: true -->"),
    _sacred_block("<!-- origin: user -->"),
    _sacred_block("<!-- origin: user | immutable: false -->"),
]

_grammar_readers, _grammar_bad = 0, []
for _path in ["bin/check", "bin/baseline"] + sorted(glob.glob("workforce/bin/wf-*")):
    for _lineno, _pat in _marker_patterns(_path):
        try:
            _rx = re.compile(_pat, re.S | re.M)
        except re.error as _e:
            _grammar_bad.append(f"{_path}:{_lineno} uncompilable: {_e}")
            continue
        _grammar_readers += 1
        _missed = [s for s in _GRAMMAR_LEGAL if not _rx.search(s)]
        _wrong = [s for s in _GRAMMAR_ILLEGAL if _rx.search(s)]
        if _missed:
            _grammar_bad.append(
                f"{_path}:{_lineno} REJECTS {len(_missed)} legal spelling(s), first: "
                + _missed[0].splitlines()[1])
        if _wrong:
            _grammar_bad.append(
                f"{_path}:{_lineno} ACCEPTS {len(_wrong)} illegal spelling(s), first: "
                + _wrong[0].splitlines()[1])

# ── The indentation ruling (2026-08-05) ──────────────────────────────────────
# In markdown an indented line is a code block, so an INDENTED sacred marker is
# documentation ABOUT the format and never a span opener. `bin/baseline` established
# this and measured it — 68 naive against 37 anchored, 46% inflation — and the four
# other readers never got the ruling. Measured on odyssey-alive: `wf-census` reported
# 118 sacred blocks and TWO were a template example carrying a literal `YYYY-MM-DD`.
#
# THE EXCEPTION IS REAL AND IS NAMED HERE so it cannot be mistaken for drift.
# `wf-claude-md`'s pattern is a MASK, not a counter: it marks spans the duplication
# pass must not touch. Over-masking costs a surviving duplicate; under-masking
# deletes a line inside a user directive. Counters and guards must be strict for the
# same reason masks must not be, and the asymmetry runs the opposite way.
_INDENTED = ("    <!-- origin: user | immutable: true -->\n> a directive\n"
             "    <!-- /origin -->\n")
_MASKS = {"wf-claude-md"}
_indent_bad, _indent_seen = [], 0
for _path in ["bin/check"] + sorted(glob.glob("workforce/bin/wf-*")):
    for _lineno, _pat in _marker_patterns(_path):
        if "^" not in _pat:
            continue                       # unanchored family detector, not a reader
        _indent_seen += 1
        _strict_expected = os.path.basename(_path) not in _MASKS
        try:
            _matched = bool(re.compile(_pat, re.S | re.M).search(_INDENTED))
        except re.error:
            continue
        if _strict_expected and _matched:
            _indent_bad.append(f"{_path}:{_lineno} counts an INDENTED marker")
        if not _strict_expected and not _matched:
            _indent_bad.append(
                f"{_path}:{_lineno} is a mask and stopped covering indented spans")
# THE FLOORS ARE PAIRED TO THE READER POPULATION, AND THIS SLIPPED TWICE IN ONE DAY.
# 2026-08-06, twice: wf-conform gained a sacred-marker reader (T2 coverage for a
# removal target) and bin/check gained one (the sacred-span mask on the CLAUDE.md
# producer check). Each time the floors kept their old values, so deleting a pattern
# left the set one ABOVE the floor and BOTH grammar guards passed while measuring
# nothing — green in bin/check throughout, VACUOUS only under bin/prove.
#
# RULE, and it is the pairing rather than the number: ADDING A LINE-ANCHORED SACRED
# MARKER READER ANYWHERE UNDER workforce/bin/ OR IN bin/check RAISES BOTH FLOORS IN
# THE SAME CHANGE, and `bin/prove` is what confirms it — bin/check cannot see this
# failure by construction, because a floor that has stopped binding still passes.
# Second occurrence, noted rather than mechanised (SKILL.md § anti-bloat counterweight);
# a THIRD promotes it to an explicit reader inventory compared by equality, not by >=.
check(
    "grammar: counters and guards reject an indented marker; the mask does not",
    not _indent_bad and _indent_seen >= 9,
    (f"{_indent_bad}. " if _indent_bad else
     f"only {_indent_seen} line-anchored readers examined, expected 9 — a reader "
     "vanished or its file stopped parsing, and this check reports clean on an empty "
     "set. That is the direction it fails silently in. ")
    + "An indented marker sits in a code block and is an example. A "
    "counter that includes it inflates; a guard that includes it fires on a date "
    "format string and trains its reader to ignore it. A MASK that excludes it can "
    "delete a line inside a user directive, which is why wf-claude-md is exempt by "
    "name rather than by accident",
)

check(
    "grammar: every sacred-marker reader accepts the same blocks",
    not _grammar_bad and _grammar_readers >= 10,
    (f"{_grammar_readers} readers tested; divergent: {_grammar_bad}. "
     if _grammar_bad else
     f"only {_grammar_readers} marker readers found (expected 10) — the extractor "
     "stopped seeing "
     "them, so this check would pass on any grammar. ")
    + "A reader that cannot see a sacred block will not checksum it, will not guard "
    "it, and will not refuse a cut that eats it — while the readers that can see it "
    "report the org healthy. Fix the pattern; do not narrow the corpus",
)
check(
    "remainder: every refusal reason is printed, not just the first",
    "refused = False" in _rem and "if refused:" in _rem,
    "a cut that eats a sacred block usually also unbalances a marker. Returning on "
    "the first reason turns one re-cut into a guessing loop, and the operator cannot "
    "tell whether the second reason was absent or merely unreported",
)
check(
    "remainder: the docstring states that A == B cannot see a marker",
    "CANNOT SEE A MARKER" in _rem,
    "the file already said what the manifest does not prove and omitted this one, "
    "which is how ten reductions were accepted on a check that never covered them",
)
# ── PASS-DEAD-SCRIPT ─────────────────────────────────────────────────────────
# `manifest()` compares `script:` tokens string to string and never stats one, so a
# SKILL.md naming a deleted script yields the same token on BOTH sides of the T7b
# diff and the blocking reduction gate passes clean. The detector reuses SCRIPT_RX
# rather than adding a second extractor — the extraction is the part that was tuned,
# and a fresh regex would re-earn the false positives that one already paid for.
#
# BOTH FILTERS ARE ASSERTED, because either one alone makes the detector useless in
# a different direction. Measured against odyssey-alive's 48 skills, 2026-08-05:
# without the bare-filename filter, 184 tokens instead of 79 and every added one a
# mention. Without the MISROUTED/UNRESOLVED split, the one true finding
# (`agenda` naming a path that lives under `invest`) is indistinguishable from
# `invest` naming `src/stealth.ts`, which is a real file in the playwright-mcp
# SERVER — collapsing them licenses rewriting a correct sentence.
check(
    "remainder: dead-script detection keeps both of its tuned filters",
    "--dead-scripts" in _rem
    and 'if "/" not in tok or tok in seen:' in _rem
    and "MISROUTED" in _rem and "UNRESOLVED" in _rem
    and "dead scripts   {len(rows)} unresolved" in _rem,
    "a script token that resolves to nothing passes the reduction gate on both sides "
    "because A == B compares spelling. The filters are the detector: without the "
    "path-shape filter it reports every backticked filename in prose, and without the "
    "two verdicts it cannot tell a wrong path from a correct reference to another "
    "repository. A detector that reports everything is read by nobody",
)

# ── The pass catalog's admission rule ────────────────────────────────────────
# references/passes.md: "No pass enters this catalog without a `defect` citation that
# resolves to a recorded defect." That sentence is the only thing standing between a
# catalog and a pile of speculative guidance, and a sentence enforces nothing — this
# is the enforcement, landed in the same change as the rule (invariants.md § a rule
# lands with its enforcement).
#
# Two directions, because each fails silently on its own: a row whose citation does
# not resolve is doctrine wearing a reference, and a row with no detector anywhere is
# the "consumer named, producer assumed" shape this project has recorded six times.
_passes = read("workforce/references/passes.md")
_pass_rows, _pass_bad = [], []
for _line in _passes.splitlines():
    if not _line.startswith("| `PASS-"):
        continue
    _cells = [c.strip() for c in _line.strip().strip("|").split("|")]
    if len(_cells) < 7:
        _pass_bad.append(f"{_cells[0]}: row has {len(_cells)} cells, expected 7")
        continue
    _tok, _cite = _cells[0].strip("`"), _cells[-1].strip("`")
    _pass_rows.append(_tok)
    if not os.path.exists(_cite):
        _pass_bad.append(f"{_tok}: defect citation does not resolve: {_cite}")
    _detectors = read("bin/check") + "".join(
        read(_p) for _p in sorted(glob.glob("workforce/bin/wf-*")))
    if _tok not in _detectors:
        _pass_bad.append(f"{_tok}: no detector names this token")

# ── The ratchet is keyed on findings, never on a count ───────────────────────
# Two integers cannot distinguish "fixed one, introduced one" from "nothing changed",
# and that is the only question a ratchet answers. Measured: a real project carries
# `lint-baseline.txt` reading `errors=31 / warnings=60 / captured=<ts>`, which is
# compatible with both histories and with "thirty-one fixed and thirty-one added".
#
# INHERITED is the clause that lets the catalog grow. A pass added after a baseline
# was captured flags artifacts that were already there; without that verdict every
# new pass reads as a decline, and the cheapest way to keep the number green becomes
# never adding one. The discriminator is the `captured-passes` token set — never a
# timestamp, which cannot say which detectors had run.
_rat = read("workforce/bin/wf-ratchet")
check(
    "ratchet: keyed on findings, with INHERITED distinguished from REGRESSION",
    # The DISCRIMINATION, not the vocabulary. Asserting the word INHERITED matches
    # the docstring and every print string, so deleting the logic left the check
    # green — proven VACUOUS on its first bin/prove run, which is the whole reason
    # that step is mandatory. This fragment IS the verdict.
    "k[0] not in known_then" in _rat
    and "captured-passes" in _rat
    and "INHERITED" in _rat and "REGRESSION" in _rat
    and "IMPROVED" in _rat and "CARRIED" in _rat
    and "NO BASELINE" in _rat
    and "keys_now" in _rat and "keys_then" in _rat,
    "a ratchet on totals cannot tell an introduced finding from a fixed one, so it "
    "reports monotonic improvement while the tree churns; and one with no INHERITED "
    "verdict punishes every catalog addition, which makes not adding a pass the "
    "cheapest way to stay green. NO BASELINE must not print as zero regressions — "
    "'nothing got worse' and 'nothing was compared' are different results",
)

# ── A detector ships with its fix (user directive, 2026-08-05) ───────────────
# The catalog shipped six AUTO preconditions written and NONE implemented. Detection
# was wired into audit, every finding was handed back, and the closing report named
# "no pass has ever auto-applied" as a status rather than a defect. That is this
# project's dominant failure one level up: there, doctrine with no enforcement; here,
# enforcement with no remedy. Both feel complete and neither is.
#
# TWO ASSERTIONS, because either alone leaves the directive half-true. The mechanism
# must EXIST — a catalog with no applier can only ever hand work back. And REPORT must
# be a MEASURED verdict: declining to auto-apply is often correct, but "it might be
# wrong" is not a reason, and a REPORT row with no precision figure is an unfinished
# pass wearing a cautious one.
_apply = read("workforce/bin/wf-apply")
check(
    "passes: the auto-apply mechanism exists and display is its default",
    _apply
    and '"--execute" in argv' in _apply
    # The reversal WRITE, not the word. `hooks_removed` also names the declared
    # reversal path, so asserting the string matched a label while the mechanism
    # was gone — VACUOUS on its first bin/prove run, the third time in this change
    # that a check tested vocabulary instead of behaviour.
    and 'sc.setdefault("hooks_removed", []).extend(removed)' in _apply
    and "OWNERSHIP IS NOT A" in _apply
    and "REFUSED" in _apply
    and "wf-apply" in read("workforce/references/procedures/audit.md"),
    "a detector that only reports is a flag, and a flag is not a fix — every project "
    "running audit re-derives the same findings and fixes them by hand or not at all. "
    "The mechanism is built ALWAYS; each pass then declares its verdict against it. "
    "Display must be the default and --execute the consent, the reversal must be named "
    "before the edit, and a refusal must be reportable — otherwise 'apply' means "
    "'overwrite whatever it found'",
)

# Every REPORT row owes a measured precision figure. The catalog table's verdict
# column is the population; wf-apply's PASSES list is where the number lives.
_report_toks = [m.group(1) for m in
                re.finditer(r"^\|\s*`(PASS-[A-Z-]+)`\s*\|[^|]*\|[^|]*\|\s*REPORT\s*\|", _passes, re.M)]
_unmeasured = [t for t in _report_toks
               if not re.search(re.escape(t) + r'"[^}]*?"precision"', _apply, re.S)]
# ── CLAUDE.md evacuation (user directive, 2026-08-05) ────────────────────────
# "our audit would convert the current CLAUDE.md of the project into the appropriate
# agents/skills/scripts/hooks elements, and afterward delete CLAUDE.md entirely."
#
# The DESTINATION of a line is judgment and is decided during the audit. WHETHER it
# arrived is mechanical, and it is the remainder test (T7b) applied to CLAUDE.md: a
# transform with a verification, never a deletion with a rationale. The gate must
# REFUSE while any line is unplaced — a deletion that loses direction is the failure
# directive one calls the gravest available, and a warning here would be a flag.
_wcm = read("workforce/bin/wf-claude-md")
check(
    "claude-md: evacuation proves relocation per line before the file may be deleted",
    "def evacuate(" in _wcm
    and "UNPLACED" in _wcm
    and "EVAC_DESTINATIONS" in _wcm
    # The four component kinds the directive names, plus the org process for
    # stragglers. Missing one marks a correctly relocated line UNPLACED and stalls an
    # evacuation that had actually succeeded.
    and '(".claude", "skills")' in _wcm
    and '(".claude", "workforce")' in _wcm
    and "return 1 if n_u else 0" in _wcm
    and "PASS-CLAUDE-MD-EVACUATED" in _apply,
    "CLAUDE.md is injected once at the head of a conversation, so a rule in it competes "
    "with everything newer as context grows. The directive is that it is emptied into "
    "components and deleted — but a file whose direction reached no handbook, skill, "
    "script, hook or the org process has not been evacuated, it has been LOST. The "
    "ledger is what tells those apart, and the gate refuses rather than warns",
)

check(
    "passes: a REPORT verdict cites a measured precision, never a default",
    not _unmeasured,
    f"REPORT rows with no measured precision: {_unmeasured}. Declining to auto-apply "
    "is legitimate and often correct — but only with a number and the tree it came "
    "from, so someone can re-run it and disagree. 'It might be wrong' is not a reason; "
    "'1 true of 2, and the false one names a file in another repository' is. Without "
    "the figure, REPORT is the default the directive forbids",
)

check(
    "passes: every catalog row cites a defect that resolves and has a detector",
    _pass_rows and not _pass_bad,
    (f"{_pass_bad}. " if _pass_bad else
     "the catalog table parsed to zero rows — the row shape changed and this check "
     "now passes on any content, which is the one failure a catalog cannot absorb. ")
    + "A pass with no recorded defect behind it is speculative guidance, and Core "
    "Principle 9c prices that at every spawn forever; a pass with no detector is "
    "doctrine that reads as enforcement",
)

# ─────────────────────────────────────────────────────────────────────────────
# "A RETIRED OWNER NEVER RUNS AGAIN" IS A MEASUREMENT, NOT A CONSEQUENCE OF DECLARING
#
# Rule 7 stands down under succession on that premise. MEASURED 2026-08-04: the
# predecessor `~/lab/claude-enforcer` is live — newest commit dated 2026-08-03 — and
# `/skill-builder update` overwrites local edits by design. Declaring succession
# removes nothing; the generator stays invocable until the SWEEP unlinks it, and the
# sweep is deliberately a separate command because removing `skill-builder` is a
# four-part transaction. So a window exists in which rule 7 is stood down and the owner
# it names can still run — f2-two-generators' failure reached from the other direction.
# The window may stay open; it may NOT go unreported.
# ─────────────────────────────────────────────────────────────────────────────
# ─────────────────────────────────────────────────────────────────────────────
# A FILE-PATH GRANT IS `Edit(path)`, NEVER `Write(path)`
#
# MEASURED 2026-08-04 from the harness's own warning, on a tree this project had just
# granted: `Write(path)` "is not matched by file permission checks — only Edit(path)
# rules are." Edit covers every file-editing tool, Write included. So a `Write(...)`
# entry is accepted into settings, sits in permissions.allow looking like a grant, and
# grants nothing — the signature defect this project refuses everywhere else, emitted
# by the one step whose stated job is making sure the permissions "work right".
#
# Both forms were written for the same path, so the capability was never missing. That
# is exactly why nothing else caught it, and why the assertion is on the DOCTRINE: no
# shipped file may teach the dead form.
# ─────────────────────────────────────────────────────────────────────────────
_asu2 = read("workforce/references/audit-setup.md")
_perm = read("workforce/bin/wf-permissions")
_vfy3 = read("workforce/references/procedures/verify.md")
check(
    "permissions: a path grant is Edit(path), and Write(path) is named as inert",
    "never `Write(path)`" in _asu2 and "Edit(path)` covers" in _asu2,
    "a grant that reads as present and matches nothing is the failure the user's own "
    "permissions directive is written against — an install that looks runnable and "
    "is not. The harness warns about it on every session start",
)
# THE DOCTRINE IS NOT THE FIX. A sentence in a reference file is advisory, is not read
# on the run that matters, and cannot repair what is already on disk — rules
# concatenate, so a correct grant never retracts a dead one. These four assert the
# MECHANISM exists, runs unasked, and repairs only what workforce owns.
check(
    "permissions: the repair is a shipped script, not a sentence",
    "wf-permissions" in read("manifest.txt") and "def apply_repairs" in _perm,
    "nothing shipped wrote permissions before this — the JSON was hand-composed every "
    "run, which is how the dead form got in. Doctrine cannot repair an existing file",
)
check(
    "permissions: audit RUNS the repair in-run, unasked",
    "wf-permissions\" --root \"<project>\" --apply" in _asu2,
    "a repair the user must remember to invoke is a flag, not a fix; the warning "
    "recurs on every session start until something removes the line",
)
check(
    "permissions: only workforce-owned entries are repaired",
    # Keyed on the GUARD, not on the word "user-authored" — that string appears three
    # times in the file, so a payload deleting it would hit the wrong copy and the
    # case would report on a mutation that changed nothing.
    'elif not f["owned"]:' in _perm and "user-authored" in _perm,
    "the user's own directive: an exclusion they wrote is evidence of intent, never an "
    "obstacle to route around. Repairing an unowned rule overwrites a preference",
)
check(
    "permissions: a load-bearing grant is converted, never dropped",
    '"remove" if target in edits else "convert"' in _perm,
    "removing `Write(p)` where no `Edit(p)` exists revokes a real capability. The "
    "repair is a removal ONLY when the working rule is already beside it",
)
# A WRITE REFUSED ABOVE THE PERMISSIONS LAYER. The self-modification classifier sits
# above permissions.allow and can refuse wf-permissions --apply even when a broad
# Edit(path) already covers the settings file. Step 0.8 had no defined response, which
# invited the two things the field report proves are wrong: adding a permission rule
# (cannot reach a block above that layer) and routing around it (defeats the intent).
# This is mechanical: the section, the retract-the-permission-rule fact, and the
# never-route-around rule are all present or the check fails. The prove case deletes
