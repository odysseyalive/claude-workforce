# ── The written-and-unwired pattern ──────────────────────────────────────────
# Five recorded defects of one shape: doctrine correct, nothing making it true.
# A procedural claim cannot be caught statically, so its ONLY enforcement is a
# counted line in the run report — and these assertions guard that mechanism.

check(
    "invariants: normative claims are classified into three enforceable kinds",
    all(k in inv for k in ("Structural", "Procedural", "Advisory")),
    "a claim filed under the wrong kind is how a rule ends up written and unwired",
)
check(
    "invariants: an invariant that cannot print its evidence is not enforced",
    "not enforced — it is intended" in inv,
    "invariants.md must state the rule that makes the printed line mandatory",
)
check(
    "invariants: zero counts are printed, never omitted",
    "including when the count is zero" in inv,
    "a missing row is indistinguishable from a gate that never ran",
)
# The set is closed on purpose: an open list grows by accretion and nobody
# notices a row that was never added.
inv_rows = re.findall(r"^\|\s*(\d+)\s*\|[^|]*\|\s*`(INV-[A-Z]+)`\s*\|\s*(\S+)\s*\|", inv, re.M)
# The count was written here as a literal `10`, which made it a restated constant
# in the file that polices restated constants: adding row 11 failed this check
# against a number no reader of invariants.md could see. Read the DECLARATION and
# compare it to the table — that is the actual invariant. "Closed" was never about
# a specific number; it is the rule that no row arrives without its report line.
_INV_WORDS = {"eight": 8, "nine": 9, "ten": 10, "eleven": 11, "twelve": 12, "thirteen": 13}
_inv_decl = re.search(r"^(\w+), and the list is closed", inv, re.M)
_inv_declared = _INV_WORDS.get(_inv_decl.group(1).lower()) if _inv_decl else None
check(
    "invariants: the enumerated set matches the count it declares",
    _inv_declared is not None and len(inv_rows) == _inv_declared,
    f"invariants.md declares {_inv_decl.group(1) if _inv_decl else '<no declaration found>'} "
    f"and the table holds {len(inv_rows)} parseable rows — adding one means adding a row, "
    "wiring its token, AND updating the declaration, in the same change",
)

# READ THE ROWS, do not merely count them. A doctrine audit replaced all ten line
# texts with the word "garbage" and the check passed, because it asserted the row
# COUNT and never the row CONTENT. Each token must resolve into the procedure
# that owes the count — which is what makes the pairing real rather than declared.
_unwired = []
for _n, _tok, _owner in inv_rows:
    _owner_path = "workforce/" + _owner if _owner.startswith("references/") else _owner
    _body = read(_owner_path)
    if not _body:
        _unwired.append(f"row {_n}: owner {_owner} unreadable")
    elif _tok not in _body:
        _unwired.append(f"row {_n}: {_tok} absent from {_owner}")
check(
    "invariants: every row's token is wired into the procedure that owes it",
    not _unwired,
    f"{_unwired} — a row nothing prints is an intention with a table entry",
)

# The instruction must REQUIRE the block, not merely mention it. An audit passed
# this assertion with prose reading "Historically some runs printed a Run
# Invariants block; that is no longer expected."
check(
    "invariants: the run report is instructed to print the block, imperatively",
    "Print the Run Invariants block first" in aud,
    "a substring test for the block's name is satisfied by prose that cancels it",
)

# Compute-and-gate BEFORE the sweep; print at close. Collapsing the two makes the
# NOT UPHELD gate unfireable — it was specified to print at Step 7 while the only
# deletion happens at Step 6b, so the gate fired strictly after the thing it was
# meant to stop. Same shape as a backup ordered after the first write.
check(
    "invariants: computed and gated before the sweep, not only printed at close",
    "Compute the ten Run Invariants FIRST" in aud and "aborts the sweep" in aud,
    "a gate evaluated after the destructive step is not a gate",
)
check(
    "invariants: NOT UPHELD blocks the sweep",
    "NOT UPHELD" in inv and "blocks the sweep" in inv,
    "without this the run's only distinction between measured-zero and "
    "could-not-compute disappears silently",
)

# The classification table's ENFORCEMENT COLUMN is its operative content — the
# three labels alone were held, so an audit rewrote the structural enforcer to
# "a careful reader" and the check passed.
for _kind, _mech in (("Structural", "`bin/check` assertion"),
                     ("Procedural", "counted line in the run report"),
                     ("Advisory", "nothing")):
    _row = next((l for l in inv.splitlines()
                 if l.startswith("|") and f"**{_kind}**" in l), "")
    check(
        f"invariants: the {_kind.lower()} row names its actual enforcement mechanism",
        _mech in _row,
        f"the {_kind} row's enforcer column must name {_mech!r}; only the label was guarded",
    )
check(
    "authoring: a rule lands with its enforcement in the same change",
    "same change" in pfp and "intention" in pfp,
    "procedure-for-procedures.md must carry the rule that closes the "
    "written-and-unwired pattern",
)
check(
    "authoring: a new assertion is proven by breaking it",
    "Prove the enforcement by breaking it" in pfp,
    "an assertion never observed failing might be testing nothing",
)
# The author of a rule cannot see this class of defect — writing correct doctrine
# feels like completing the work. The second reader is the only mechanism that
# does not depend on the author noticing.
check(
    "doctrine-auditor: exists and asks what makes a claim true",
    "What makes this true?" in da,
    "the adversarial second reader is the only check independent of the author",
)
check(
    "doctrine-auditor: proximity is not accepted as enforcement",
    "NEVER accept proximity as enforcement" in da,
    "a prose check sat three lines above the row it governed and failed anyway",
)

# Cancel-by-prose, applied to every shipped file at once rather than one rule.
_cancelled = sorted(
    p for p in declared if p.endswith(".md") and CANCEL_RX.search(read(p))
)
check(
    "doctrine: no shipped file revokes a rule while keeping its guarded text",
    not _cancelled,
    f"cancelling prose in: {_cancelled} — a substring assertion is satisfied by a "
    "sentence that withdraws the rule it guards; put history in measurements/",
)

# Ordering assertions must be POSITION-AWARE. The one ordering guard this project
# had was a pair of substring tests, and an audit relocated the entire compute-
# and-gate block to sit AFTER the deletions — reproducing the exact defect the
# assertion existed to prevent, with the assertion green.
def _pos(hay, needle):
    i = hay.find(needle)
    return i if i >= 0 else 10 ** 9


_sweep = _pos(aud, "## Step 6b — The sweep")
_gate = _pos(aud, "Compute the ten Run Invariants FIRST")
_close = _pos(aud, "## Step 7 — Close")
check(
    "ordering: the invariant gate is positioned before the sweep it guards",
    _gate < _sweep + len("## Step 6b — The sweep") + 4000 and _gate > _sweep,
    "the gate must sit inside Step 6b, ahead of the removal table — a substring "
    "test cannot see that the block was moved",
)
check(
    "ordering: the sweep is sequenced before close",
    _sweep < _close,
    "Step 6b must precede Step 7; an audit moved the sweep after close and every "
    "substring assertion still passed",
)

# The labelling pass. A doctrine audit found 96 of 201 claims unenforced and named
# the deeper problem: nothing marked which was which, so every claim read as
# equally binding. The per-file header carries the ratio at the point of use —
# and is GENERATED (`bin/coverage --stamp`), because a hand-maintained label
# drifts from the assertion it describes, which is the defect being labelled.
_HDR_RX = re.compile(
    r"<!-- Enforcement: (\d+) assertion\(s\) in bin/check name this file; (\d+) normative"
)
_hdr_stale = []
try:
    import ast as _ast

    _tree = _ast.parse(read("bin/check"))
    _VARMAP = {
        "lm": "workforce/references/legacy-markers.md",
        "ct": "workforce/references/conversion-taxonomy.md",
        "aud": "workforce/references/procedures/audit.md",
        "inv": "workforce/references/invariants.md",
        "cd_": "workforce/references/conversion-department.md",
        "disc": "workforce/references/discovery.md",
        "stg": "workforce/references/staging.md",
        "ds": "workforce/references/data-skills.md",
        "vfy": "workforce/references/procedures/verify.md",
        "_asu": "workforce/references/audit-setup.md",
        "_od": "workforce/references/org-design.md",
        "_stg": "workforce/references/staging.md",
        "_hire2": "workforce/references/procedures/hire.md",
        "_bl": "bin/baseline",
        "_pt": "workforce/references/personnel-templates.md",
        "_ev": "workforce/references/evaluators.md",
        "_vfy2": "workforce/references/procedures/verify.md",
        "_org": "workforce/references/procedures/org.md",
        "_ocf": "workforce/references/org-chart-format.md",
        "_pfp2": "workforce/references/procedure-for-procedures.md",
        "pfp": "workforce/references/procedure-for-procedures.md",
        "enf": "workforce/references/enforcement.md",
        "plat": "workforce/references/platform.md",
        "_plat": "workforce/references/platform.md",
        "skill": "workforce/SKILL.md",
        "_hire": "workforce/references/procedures/hire.md",
        "pa_": "workforce/agents/provenance-analyst/AGENT.md",
        "cc_": "workforce/agents/content-classifier/AGENT.md",
        "da": "workforce/agents/doctrine-auditor/AGENT.md",
    }
    _live = {}
    for _n in _ast.walk(_tree):
        if isinstance(_n, _ast.Call) and getattr(_n.func, "id", "") == "check" and len(_n.args) > 1:
            _nm = _n.args[0].value if isinstance(_n.args[0], _ast.Constant) else "<computed>"
            _reads = {x.id for x in _ast.walk(_n.args[1]) if isinstance(x, _ast.Name)}
            for _v, _p in _VARMAP.items():
                if _v in _reads:
                    _live.setdefault(_p, set()).add(_nm)
    for _p in declared:
        if not _p.endswith(".md"):
            continue
        _m = _HDR_RX.search(read(_p))
        if not _m:
            continue
        if int(_m.group(1)) != len(_live.get(_p, ())):
            _hdr_stale.append(f"{_p}: header says {_m.group(1)}, actual {len(_live.get(_p, ()))}")
except Exception as _e:  # a diagnostic must not die on the input it diagnoses
    _hdr_stale.append(f"could not parse bin/check: {_e}")

# ─────────────────────────────────────────────────────────────────────────────
# HARD-WRAP LINT — over this file's own assertions.
#
# Every reference here is hard-wrapped at ~100 columns, so a phrase an author
# reads as contiguous is stored with a newline in the middle. Three assertions
# were broken by this on 2026-07-31 alone, which is the project's own promotion
# threshold: a rare problem gets a principles entry, a third occurrence gets a
# mechanism.
#
# The `in` form fails loudly and wastes time. **The `not in` form PASSES
# VACUOUSLY** — assert that a retracted phrase is absent, wrap-break the literal,
# and the assertion reports success about a condition it never tested. That is
# the one this exists for, and it is exactly the shape of a draft written today.
#
# The var->file map is DERIVED from `x = read("...")` assignments rather than
# maintained. A hand-kept list here would be one more thing to forget, and this
# file already carries two copies of one such map for reasons it had to assert
# its way out of.
# ─────────────────────────────────────────────────────────────────────────────
_wrap_bugs = []
try:
    import ast as _a2

    _t2 = _a2.parse(read("bin/check"))
    _readmap = {}
    for _n in _a2.walk(_t2):
        if (isinstance(_n, _a2.Assign) and len(_n.targets) == 1
                and isinstance(_n.targets[0], _a2.Name)
                and isinstance(_n.value, _a2.Call)
                and getattr(_n.value.func, "id", "") == "read"
                and _n.value.args and isinstance(_n.value.args[0], _a2.Constant)):
            _readmap[_n.targets[0].id] = _n.value.args[0].value

    def _ws(s):
        return " ".join(s.split())

    for _n in _a2.walk(_t2):
        if not (isinstance(_n, _a2.Call) and getattr(_n.func, "id", "") == "check"):
            continue
        if len(_n.args) < 2:
            continue
        for _c in _a2.walk(_n.args[1]):
            if not (isinstance(_c, _a2.Compare) and len(_c.ops) == 1
                    and isinstance(_c.ops[0], (_a2.In, _a2.NotIn))
                    and isinstance(_c.left, _a2.Constant)
                    and isinstance(_c.left.value, str)
                    and isinstance(_c.comparators[0], _a2.Name)):
                continue
            _lit, _var = _c.left.value, _c.comparators[0].id
            # Single tokens cannot straddle a wrap; only file-backed vars qualify.
            if _var not in _readmap or len(_lit.split()) < 2:
                continue
            _body = read(_readmap[_var])
            if not _body or _lit in _body:
                continue
            if _ws(_lit) in _ws(_body):
                _neg = isinstance(_c.ops[0], _a2.NotIn)
                _wrap_bugs.append(
                    f"line {_c.lineno}: {'`not in` PASSES VACUOUSLY' if _neg else 'never matches'}"
                    f" — {_lit[:44]!r} is present in {_readmap[_var]} only across a line wrap"
                )
except Exception as _e:  # a diagnostic must not die on the input it diagnoses
    _wrap_bugs.append(f"could not lint bin/check: {_e}")

check(
    "assertions: no substring literal is broken by a hard wrap in its target",
    not _wrap_bugs,
    f"{_wrap_bugs} — the phrase IS in the file, wrapped. Match a contiguous "
    "fragment instead. A `not in` broken this way reports success about a "
    "condition it never tested",
)

check(
    "coverage: every Enforcement header matches the assertions that exist",
    not _hdr_stale,
    f"{_hdr_stale} — regenerate with `bin/coverage --stamp`. A label that drifts "
    "from its mechanism is the defect the labelling pass exists to remove",
)

# `_VARMAP` above and `VAR_TO_FILE` in bin/coverage are the SAME constant, restated
# in two files — the thing this project fails a run over everywhere else. They stay
# separate because a diagnostic must not import the tool it diagnoses, so the
# duplication is deliberate and the drift is what needs catching. Adding `vfy` to
# one copy and not the other produced exactly that: coverage stamped a header that
# check then called stale, and neither tool was wrong about its own map.
_cov_map = re.search(r"VAR_TO_FILE\s*=\s*\{(.*?)\n\}", _cov_src, re.S)
_cov_pairs = set(re.findall(r'"([^"]+)":\s*"([^"]+)"', _cov_map.group(1))) if _cov_map else set()
check(
    "coverage: bin/check and bin/coverage agree on the variable→file map",
    _cov_pairs == set(_VARMAP.items()),
    f"only in check: {sorted(set(_VARMAP.items()) - _cov_pairs)}; "
    f"only in coverage: {sorted(_cov_pairs - set(_VARMAP.items()))}",
)

# The T-order is this project's most safety-critical constant and is restated in
# TWO shipped files. An audit inverted each independently — putting retirement
# before registration, so capability is reachable by ZERO paths at the crash
# window the whole design exists to prevent — and both passed. CONST_RX covers
# tier counts and model IDs; it never reached the ordering.
_T_SEQ = ["T1", "T2", "T3", "T4", "T5", "T6", "T7", "T8"]


def _t_positions(hay):
    return [hay.find(f"{t} ") for t in _T_SEQ]


_hire_block = ""
_m = re.search(r"```\n(T1 .*?T8[^\n]*)\n```", _hire, re.S)
if _m:
    _hire_block = _m.group(1)
_hire_pos = _t_positions(_hire_block)
check(
    "T-order: hire.md sequences T1 through T8 monotonically",
    _hire_block and all(0 <= a < b for a, b in zip(_hire_pos, _hire_pos[1:])),
    "the T-order block is missing or out of order — retirement before registration "
    "leaves capability reachable by ZERO paths",
)

# Both files must agree. Two restatements with nothing comparing them is the
# constants-stated-once rule failing on the constant that matters most.
_gate = ""
_m = re.search(r"2\. ORDER IS THE INVARIANT[^\n]*", skill)
if _m:
    _gate = _m.group(0)
_gate_pos = _t_positions(_gate)
check(
    "T-order: SKILL.md's gate states the same sequence as hire.md",
    _gate and all(0 <= a < b for a, b in zip(_gate_pos, _gate_pos[1:])),
    "SKILL.md's Atomic-or-Absent gate restates the T-order; an audit scrambled it "
    "independently of hire.md and nothing noticed",
)

# Two rules whose violation is silent, out-of-plan data loss.
check(
    "T-order: T5 refuses a symlink",
    "T5 refuses a symlink" in _hire and "T5 SYMLINK REFUSAL" in skill,
    "writing through a symlink destroys a file the plan never named",
)
check(
    "T-order: the sweep mark has a defined representation",
    "The mark IS the COMMITTED T7 journal row" in _hire,
    "five files used the mark while nothing defined it; the sweep's input set was "
    "specified nowhere",
)

# The Constitution Gate shipped fully templated and no procedure wrote it —
# the same orphan defect the department had.
check(
    "templates: a procedure actually writes the Constitution Gate",
    "WORKFORCE-CONSTITUTION" in aud,
    "templates.md specifies the gate in full; charter refreshes it and disband "
    "removes it, both presupposing something created it",
)

# The retracted "restart required" claim has returned FIVE times across nine
# files, caught every time by a human re-reading and never by a mechanism —
# `grep -n restart bin/check` returned nothing until now. platform.md fact 3
# measures the opposite: both agents and skills register later in the same
# session. Prose that PROHIBITS the claim is fine; prose that ASSERTS it is not.
_RESTART_ASSERT = re.compile(
    r"(?:not live-reloaded"
    r"|unreachable until (?:Claude Code )?restart"
    r"|[Rr]estart Claude Code to reach"
    r"|restart is required"
    r"|requires? a restart)",
)
_RESTART_OK = re.compile(r"(?:[Nn]ever write|is retracted|retracted|prohibit|would be false)")
_restart_hits = []
for _p in declared:
    if not _p.endswith(".md"):
        continue
    for _ln, _line in enumerate(read(_p).splitlines(), 1):
        if _RESTART_ASSERT.search(_line) and not _RESTART_OK.search(_line):
            _restart_hits.append(f"{_p}:{_ln}")
check(
    "platform: no shipped file asserts that a restart is required",
    not _restart_hits,
    f"retracted claim asserted at: {_restart_hits} — platform.md fact 3 measures "
    "delayed registration, not a restart requirement. It has returned five times; "
    "state the prohibition or the retraction on the same line, or reword.",
)

# The budget can only offer IDs that exist in the statics pool. The pool was
# emptied once (CLAUDE.md, closed 2026-07-29) with nothing noticing, and a tier
# default shipped naming an ID outside its own pool.
_pool = set(re.findall(r"`(claude-[\w.-]+)`", _tpl_cfg.split("## Model statics")[-1][:900]))
_tier_ids = set(re.findall(r"\|\s*(?:CEO|Lead|IC|creative)[^|]*\|\s*`(claude-[\w.-]+)`", _tpl_cfg))
check(
    "org-config: the statics pool is non-empty",
    len(_pool) >= 3,
    f"only {len(_pool)} model statics — the budget questions have nothing to propose, "
    "which is the seam closed 2026-07-29 reopening",
)
check(
    "org-config: every tier default is drawn from the statics pool",
    _tier_ids <= _pool,
    f"tier defaults outside the pool: {sorted(_tier_ids - _pool)} — a user cannot "
    "re-select their own default from the four options offered",
)

# Two shipped agents sharing a name resolve silently by filesystem order. The
# file that exists to prevent this had zero assertions.
_agent_names = {}
for _p in glob.glob("workforce/agents/*/AGENT.md"):
    _m = re.search(r"^name:\s*(\S+)", read(_p), re.M)
    if _m:
        _agent_names.setdefault(_m.group(1), []).append(_p)
_dupe_names = {k: v for k, v in _agent_names.items() if len(v) > 1}
check(
    "personas: no two shipped agents declare the same name",
    not _dupe_names,
    f"collision: {_dupe_names} — resolves by filesystem read order, with nothing reported",
)
_bad_names = sorted(n for n in _agent_names if not re.fullmatch(r"[a-z0-9-]+", n))
check(
    "personas: every shipped agent name is lowercase-and-hyphens, no colons",
    not _bad_names,
    f"malformed: {_bad_names} — a colon is reserved for plugin scoping and the file "
    "is not loaded; the old guard accepted any non-whitespace",
)

# ── This project holds itself to what it asks of others ──────────────────────
# A fixture is retained by an OPEN fact. Once its fact is MEASURED the evidence
# lives in measurements/, which is what makes the fixture disposable — and a
# registered agent doing nothing is the residue this project refuses to leave in
# someone else's roster. Found by running our own census against ourselves.
# We ship `checksums` to stamp exactly this class of block in a USER's project
# and ran nothing on our own. An audit replaced the ORCHESTRATOR user directive
# in conversion-taxonomy.md with an inversion of its meaning — markers left
# paired — and the check passed at 290/0.
import hashlib

_IMM_RX = re.compile(
    r"^<!--\s*origin:\s*user\b[^>]*immutable:\s*true\s*-->$(.*?)^<!--\s*/origin\s*-->$",
    re.S | re.M,
)
_stamped = {}
for _line in read("workforce/.immutable.sha").splitlines():
    if _line.startswith("#") or not _line.strip():
        continue
    _h, _rest = _line.split("  ", 1)
    _stamped.setdefault(_rest.split("  ")[0], []).append(_h)

_live = {}
for _p in sorted(glob.glob("workforce/**/*.md", recursive=True)):
    for _m in _IMM_RX.finditer(read(_p)):
        _body = "\n".join(l.rstrip() for l in _m.group(1).strip().splitlines())
        _live.setdefault(_p, []).append(hashlib.sha256(_body.encode()).hexdigest())

_drift = []
for _p in sorted(set(_live) | set(_stamped)):
    if _live.get(_p, []) != _stamped.get(_p, []):
        _drift.append(f"{_p}: {len(_live.get(_p, []))} live vs {len(_stamped.get(_p, []))} stamped")
check(
    "immutable: every shipped user directive matches its stamp",
    not _drift,
    f"MISMATCH: {_drift} — a sacred block was reworded, added, or removed. Flag, "
    "never repair: regenerate with bin/check --stamp only after the change is intended",
)

check(
    "fixtures: a fixture is swept once its fact is measured",
    "swept" in stg and "MEASURED is residue" in stg,
    "staging.md must state the fixture lifecycle, or closed probes accumulate",
)
_live_fixtures = {
    os.path.basename(p)[:-3] for p in glob.glob(".claude/agents/wf-*.md")
}
# Each fixture DECLARES the fact it measures; the check resolves that fact's
# status. Two earlier forms both passed vacuously: one regex whose non-greedy
# span stopped at the first '#', then a per-section scan that matched a fixture
# named in a DIFFERENT fact's prose. Inferring the link from proximity is exactly
# what wf-doctrine-auditor forbids, and it failed here for that reason.
_fact_status = {
    m.group(1): m.group(0).split("\n", 1)[0]
    for m in re.finditer(r"^### Fact (\w+) —.*$", _plat, re.M)
}
_closed = set()
for _p in glob.glob(".claude/agents/wf-*.md"):
    _m = re.search(r"measures-fact:\s*(\w+)", read(_p))
    if not _m:
        continue
    if "MEASURED" in _fact_status.get(_m.group(1), ""):
        _closed.add(os.path.basename(_p)[:-3])
_undeclared = sorted(
    os.path.basename(p)[:-3] for p in glob.glob(".claude/agents/wf-*.md")
    if "measures-fact:" not in read(p)
)
check(
    "fixtures: every live fixture declares the fact it measures",
    not _undeclared,
    f"no `measures-fact:` line: {_undeclared} — without it nothing can tell when "
    "the fixture has outlived its purpose",
)
check(
    "fixtures: no fixture survives its own measurement",
    not _closed,
    f"registered but its fact is MEASURED: {sorted(_closed)} — the evidence is in "
    "measurements/; the fixture is residue",
)
# The git rung is the one most likely to get quietly promoted, because it feels
# authoritative. Assert the MEASUREMENT is cited rather than a phrasing — the
# numbers are the reason it may not decide, and they survive rewording.
check(
    "conversion-department: the git rung cites the measurement that caps it",
    "33–44" in cd_ or "33-44" in cd_,
    "the 33-44-files vs 11 measurement is why commit breadth may corroborate but never decide; "
    "without it the rung reads as authoritative and gets promoted",
)
check(
    "provenance-analyst: the git rung is capped at corroboration",
    "never decide" in pa_.lower() or "corroborates only" in pa_.lower(),
    "a rule built on commit breadth misclassifies a batched authoring session",
)
# Anthropic's multi-agent findings: a single call with a rubric beat multiple
# judges. The panel is the obvious "improvement" and it measured worse upstream.
check(
    "conversion-department: records that a voting panel was rejected on evidence",
    "Do not add a voting panel" in cd_,
    "the pipeline-not-panel choice must carry its source, or it reads as a preference",
)
# Every shipped agent needs the four-part contract; missing any one is the
# documented cause of subagent drift.
for _a in glob.glob("workforce/agents/*/AGENT.md"):
    _b = read(_a)
    _missing = [s for s in ("## Guardrails", "## Reporting") if s not in _b]
    _has_objective = "## Objective" in _b or "## Role" in _b
    _has_scope = "## Scope" in _b or "## Effort budget" in _b
    check(
        f"agent contract: {os.path.basename(os.path.dirname(_a))} states objective, boundaries, output",
        not _missing and _has_objective and _has_scope,
        f"missing: {_missing or ''} objective={_has_objective} boundaries={_has_scope}",
    )

# The extraction gate. This guards the only content in a managed tree that no
# regeneration can reconstruct: the user's own immutable spans, which routinely
# sit inside files a foreign generator owns.
check(
    "no-residue: the immutable-extraction gate precedes deletion",
    "before the first file is removed" in ct or "precedes every deletion" in ct,
    "conversion-taxonomy.md § What succession removes must state the gate blocks deletion",
)

# Discovery tiers cap what may be acted on. A HEURISTIC finding that recommends a
# deletion is indistinguishable in a report from a certain one.
for tier in ("MECHANICAL", "HEURISTIC", "JUDGMENT"):
    check(f"discovery: {tier} tier defined", tier in disc)
check(
    "discovery: the directive-touch hard floor is stated",
    "FLAG-ONLY" in disc and "immutable: true" in disc,
    "discovery.md must downgrade any finding whose edit span intersects an immutable block",
)
# The census must generalise past the shapes it was written from. A matcher keyed
# to one project's conventions reports a clean sweep over everything it had no
# name for — and every convention in this project was learned from ONE project.
check(
    "discovery: the census generalises past the conventions it was learned from",
    "never the population" in disc and "classify by exclusion, never by recognition" in disc.lower(),
    "discovery.md must state that its named shapes are examples, and that "
    "classification is by exclusion so unknowns surface as findings",
)
check(
    "discovery: an unrecognised shape is a finding, not a silent skip",
    "has not proven the project is simple" in disc,
    "a census reporting zero unknowns on an unfamiliar project has only proven it "
    "looked for what it already knew",
)
check(
    "discovery: quarantine is counted, not silent",
    "quarantined" in disc and "audited" in disc,
    "discovery.md must require reporting N audited · M quarantined",
)

# ─────────────────────────────────────────────────────────────────────────────
# 10. README copy-button discipline — one command per fenced block
# ─────────────────────────────────────────────────────────────────────────────
multi = [
    b.strip()[:50]
    for lang, b in re.findall(r"```(\w*)\n(.*?)```", read("README.md"), re.S)
    if lang in ("", "bash", "powershell")
    and len([x for x in b.strip().split("\n") if x.strip()]) > 1
]
check("README: one copyable command per fenced block", not multi, f"stacked: {multi}")

# ─────────────────────────────────────────────────────────────────────────────
# Warnings — worth knowing, not worth failing
# ─────────────────────────────────────────────────────────────────────────────
for p in declared:
    if p.endswith(".md"):
        n = len(read(p).splitlines())
        if n > 260:
            warn(f"{os.path.basename(p)} is {n} lines", "long reference; candidate for a split or ablation")

if not os.path.exists("CLAUDE.md"):
    warn("no CLAUDE.md at the repo root", "a fresh session here has no orientation")

# ─────────────────────────────────────────────────────────────────────────────
# Report
# ─────────────────────────────────────────────────────────────────────────────
print(f"claude-workforce conformance — {len(declared)} shipped files\n")
if FAILS:
    print(f"FAIL ({len(FAILS)}):")
    for name, detail in FAILS:
        print(f"  ✗ {name}")
        if detail:
            print(f"      {detail}")
    print()
if WARNS:
    print(f"warnings ({len(WARNS)}):")
    for name, detail in WARNS:
        print(f"  · {name}" + (f" — {detail}" if detail else ""))
    print()
print(f"{PASSES} passed, {len(FAILS)} failed, {len(WARNS)} warnings")
sys.exit(1 if FAILS else 0)
