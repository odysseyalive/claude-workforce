# ─────────────────────────────────────────────────────────────────────────────
# Every shipped agent has a caller, landed 2026-08-03.
#
# staging.md § The shipped panel definitions resolved this ONCE, for the three
# Conversion Department members, and left the rest standing: four of seven
# definitions had no procedure naming them BY PATH. The worst was
# handbook-cold-reader — a 70-line persona for the off-the-street release gate,
# while staging.md Phase B said "Spawn a generic agent" four lines below its own
# warning that a caller reading only part of a definition gets an agent that
# drifts with nothing reporting it.
#
# A definition that ships and is never loaded is this project's signature defect
# (written, unwired) inside the artifacts meant to catch it. Path, not name: a
# procedure naming an agent it never tells the caller to READ is the same bug.
# ─────────────────────────────────────────────────────────────────────────────
_agent_paths = [p_ for p_ in declared if p_.startswith("workforce/agents/")]
_callers = "\n".join(read(p_) for p_ in declared if p_.endswith(".md") and not p_.startswith("workforce/agents/"))
_uncalled = [p_ for p_ in _agent_paths if p_ not in _callers]
check(
    "agents: every shipped definition is loaded by path from a procedure",
    not _uncalled,
    f"shipped but convened by nothing: {_uncalled} — a definition nothing reads is "
    "either dead weight on every install or a panel running without the persona it "
    "was designed around; wire it or ablate it, and say which",
)

# ─────────────────────────────────────────────────────────────────────────────
# Warnings — worth knowing, not worth failing
# ─────────────────────────────────────────────────────────────────────────────
for p in declared:
    if p.endswith(".md") and p not in VENDORED:
        n = len(read(p).splitlines())
        if n > 260:
            warn(f"{os.path.basename(p)} is {n} lines", "long reference; candidate for a split or ablation")

# NO "no CLAUDE.md" WARNING: absence is the finished state, not a gap (2026-08-06).
# The old warning said a fresh session "has no orientation" without CLAUDE.md. That
# premise died with the evacuation: orientation lives in operating-principles/SKILL.md,
# injected into every non-fork spawn. And the direction is backwards — the blocking
# check "this repo has no CLAUDE.md — it was evacuated, not merely trimmed" (below)
# already asserts absence and FAILS on re-accumulation, so a warning firing on the
# enforced success state was noise pointing opposite a MUST. Deleted, not inverted:
# an inverted warn() would only weakly duplicate that check.

# THE RECORD MOVED, SO THE CHECK MOVED WITH IT (2026-08-05), AND ITS GUARD MOVED TOO
# (2026-08-06). CLAUDE.md was injected into every non-fork subagent with no opt-out,
# so its 70,690 bytes were paid on every spawn in the repo that spawns most — against
# a user directive saying a CLAUDE.md should be "very sparce or next to nothing". The
# development record now lives in DEVELOPMENT.md, injected nowhere, and CLAUDE.md was
# deleted. This block used to hang off `if os.path.exists("CLAUDE.md"): ... else:`, so
# the deletion made it unreachable — written-then-unwired, inside the file that exists
# to catch written-then-unwired. It escaped notice only because DEVELOPMENT.md was
# current, i.e. it would have stayed silent right up to the moment it was meant to
# speak. It now keys on the record directly and fires regardless of CLAUDE.md.
#
# The staleness question follows the record, not the filename. That record is still the
# ONLY store that goes stale silently — the others are append-only. It spent two days
# and nineteen commits telling every fresh session that "every writing step remains
# unexecuted", by then false in four of five particulars.
#
# REPORTED, NOT BLOCKED, and no threshold is invented: the numbers are printed and the
# judgment is the reader's. A count that fires at one commit is noise; a count nobody
# prints is how this went stale in the first place.
if os.path.exists("DEVELOPMENT.md"):
    _rec = "DEVELOPMENT.md"
    _m_open = re.search(r"^## Open, as of (\d{4}-\d{2}-\d{2})", read(_rec), re.M)
    if not _m_open:
        warn(f"{_rec} states no 'Open, as of <date>'",
             "the record has no date, so its staleness cannot be measured")
    else:
        _since = subprocess.run(
            ["git", "log", "--oneline", f"--since={_m_open.group(1)}", "--", "workforce/", "bin/"],
            capture_output=True, text=True).stdout.strip()
        _n = len(_since.splitlines()) if _since else 0
        if _n:
            warn(f"{_rec} open list is dated {_m_open.group(1)} — {_n} commit(s) to "
                 f"workforce/ or bin/ since",
                 "update the open list in the change that closes an item, or a later "
                 "session is oriented by a snapshot of a day that has passed")

# ─────────────────────────────────────────────────────────────────────────────
# Teammate-safe tier ceilings — platform.md facts 2d and 18
# ─────────────────────────────────────────────────────────────────────────────
# A NAMED-TEAMMATE spawn silently discards `disallowedTools:` and honors `tools:`
# (fact 2d), and drops `skills:`/`mcpServers:` entirely (fact 18, documented). So a
# tier ceiling written only as a denylist does not exist in that spawn form, and
# until 2026-08-03 the IC template shipped exactly that: `disallowedTools: Agent`
# and no `tools:` line at all. Every generated IC was uncapped as a teammate.
#
# The shipped panel agents were never exposed — they carry explicit allowlists —
# which is precisely why re-reading never found it: the examples on disk were right
# and the template that generates employees was not.

check("IC template carries a tools: allowlist",
      "tools: <exact tools this IC needs" in tpl,
      "handbook-templates.md IC frontmatter needs `tools:` beside `disallowedTools: Agent`")

check("IC template tools: line forbids Agent",
      "MUST NOT include Agent" in tpl,
      "the allowlist is the half that survives a teammate spawn; it must exclude Agent")

check("SKILL.md rule 3 blocks on the tools: allowlist too",
      "allowlist omitting `Agent` (fact 2d)" in skill,
      "rule 3 must STOP when an IC has no Agent-free `tools:` line")

check("SKILL.md rule 6 permits tools: as a companion",
      "is NOT a mechanism conflict" in skill,
      "rule 6 forbade the only ceiling that survives a teammate spawn until 2026-08-03")

_panel = sorted(glob.glob("workforce/agents/*/AGENT.md"))
_bad_panel = []
for _p in _panel:
    _m = re.search(r"^tools:\s*(.+)$", read(_p), re.M)
    if not _m or "Agent" in [_t.strip() for _t in _m.group(1).split(",")]:
        _bad_panel.append(_p)
check("every shipped panel agent has an Agent-free tools: allowlist",
      bool(_panel) and not _bad_panel,
      f"{len(_panel)} panel agents; offending: {_bad_panel}")

# ─────────────────────────────────────────────────────────────────────────────
