# THE EXECUTING PATH IS NOT SHIPPED, AND THAT IS A DECISION.
# Six rounds of cold reads each found a fresh way to make `--run` execute a command
# a human wrote as an illustration — the last ran `rm -rf` out of a <details> block
# marked "DO NOT RUN" and reported the handbook RUNS *and* DISCRIMINATES at exit 0.
# Deciding instruction-vs-illustration is markdown block parsing; a hand-rolled
# scanner keeps losing to it and there is no stdlib CommonMark parser.
# NO SHIPPED SCRIPT NAMES A FLAG IT DOES NOT HAVE. Two removed-flag strings survived
# in wf-checkrun's own OUTPUT after the executing path was deleted — one telling the
# operator "--run would execute every match", in the tool whose release claim is that
# it executes nothing. Fixed at the instance twice; this is the class.
_flag_lies = []
for _s in ("wf-checkrun", "wf-conform", "wf-census", "wf-context", "wf-remainder",
           "wf-claude-md"):
    _src = read(f"workforce/bin/{_s}")
    # argparse-based scripts only: `wf-remainder` parses argv by hand, so its real
    # flags are not in add_argument() and every one of them would read as a lie.
    if not _src or "add_argument(" not in _src:
        continue
    _have = set(re.findall(r'add_argument\("(--[a-z-]+)"', _src))
    # EVERY string constant, via the AST — not a double-quote regex. The identical
    # string in SINGLE quotes passed, and wf-conform alone holds ~291 constants, so
    # that was a live gap rather than a theoretical one.
    try:
        _tree = _a2.parse(_src)
        # The MODULE DOCSTRING is documentation, not operator output, and it is where
        # a removed capability is legitimately explained. Excluding it is the whole
        # difference between "records that --run was removed" and "tells the operator
        # to pass --run".
        _doc = _a2.get_docstring(_tree, clean=False)
        for _n in _a2.walk(_tree):
            if not (isinstance(_n, _a2.Constant) and isinstance(_n.value, str)):
                continue
            if _doc is not None and _n.value == _doc:
                # The NARRATIVE half only. A `Usage` synopsis inside the module
                # docstring is operator-facing, so exempting the whole docstring let
                # a real lie hide there — proven: `[--execute]` added to the synopsis
                # passed, while the identical string in a print() failed.
                _tail = _doc.split("Usage", 1)[1] if "Usage" in _doc else ""
                for _f in re.findall(r"(--[a-z][a-z-]{1,})", _tail):
                    if _f not in _have:
                        _flag_lies.append(f"{_s}: {_f} in the Usage synopsis")
                continue
            for _f in re.findall(r"(--[a-z][a-z-]{1,})", _n.value):
                if _f not in _have:
                    _flag_lies.append(f"{_s}: {_f} in {_n.value[:44]!r}")
    except SyntaxError:
        _flag_lies.append(f"{_s}: could not parse")
check(
    "no shipped script names a flag it does not have, in its own output",
    not _flag_lies,
    f"{_flag_lies} — a printed flag the parser rejects is a lie to the operator, and "
    "after a capability is removed its name survives in the strings that described it",
)
check(
    "wf-checkrun ships no executing path",
    # THE WHOLE FILE, and every execution primitive — not `split('"""')[2]`, which
    # covered only the ~100 lines between two docstrings. Proven vacuous by a cold
    # read: `"--run" in _ckr` was True (three sites) while this assertion PASSED, so
    # only the `subprocess` clause ever had reach, and that clause would not have
    # caught os.system, os.popen, runpy or eval.
    # AST, not text: a COMMENT recording the history mentions `shell=True`, and a
    # text test cannot tell a record of a removed capability from the capability.
    # A DIAGNOSTIC MUST NOT DIE ON THE INPUT IT DIAGNOSES — this file's own rule.
    # Unguarded, a syntactically broken wf-checkrun made `ast.parse` raise and took
    # the WHOLE of bin/check down: bin/prove reported the case VACUOUS with "0 other
    # failures", because there were no failures — there was no output at all.
    # An unparseable script is a failure of this check, not an absence of one.
    (lambda: (lambda t: t is not None and not [
        1 for _n in _a2.walk(t)
        if (isinstance(_n, (_a2.Import, _a2.ImportFrom))
            and any(getattr(_al, "name", "").split(".")[0] in ("subprocess", "runpy", "pty")
                    for _al in _n.names))
        or (isinstance(_n, _a2.Call)
            and _a2.unparse(_n.func) in ("os.system", "os.popen", "eval", "exec",
                                         "subprocess.run", "subprocess.Popen"))
        or (isinstance(_n, _a2.Call) and _a2.unparse(_n.func).endswith("add_argument")
            and any(isinstance(_a, _a2.Constant)
                    and _a.value in ("--run", "--prove", "--timeout") for _a in _n.args))
    ])((lambda: None if _ckr is None else _a2.parse(_ckr))()
       if _ckr else None))()
    if _ckr and _safe_parse(_ckr) else False,
    "`--run`/`--prove` extract commands from prose and execute them; six cold reads "
    "found six escapes, each a one-token variation on a shape already fixtured. The "
    "executing half is withheld until commands live somewhere unambiguously parseable",
)
check(
    "wf-checkrun states WHY the executing path is absent",
    "does not execute anything" in _ckr and "structured sidecar" in _ckr,
    "a capability withheld without its reason reads as an oversight, and the next "
    "author re-adds it",
)
# DOCTRINE AND ITS READER MUST AGREE ABOUT THE SAME MARKERS, and nothing paired them.
# `verification.md` line 93 enumerates the accepted list markers in prose; `wf-checkrun`
# encodes them in CHECK_RX. The assertion below constrains the READER only, so the
# sentence could be edited to name a marker the regex rejects — or the regex tightened
# past the sentence — and every check would stay green while an employee followed
# doctrine into a declaration its own runner cannot see. Found 2026-08-06 by the
# cold-read probe of `doctrine-lead`, which located this assertion, PASSED on it, and
# then said plainly that it does not assert what the doctrine claims.
_ckr = read("workforce/bin/wf-checkrun")
_vfy_l93 = next((l for l in read("workforce/references/verification.md").splitlines()
                 if "TOP-LEVEL list items" in l), "")
_vfy_markers = set(re.findall(r"`([-*+]|\d+[.)])`", _vfy_l93))
_rx_markers = {"-", "*", "+", "1.", "1)"} if r"^(?:[-*+]|\d+[.)])" in _ckr else set()
check(
    "verification.md's marker list matches the regex wf-checkrun actually applies",
    _vfy_markers == _rx_markers and _vfy_markers,
    f"doctrine names {sorted(_vfy_markers)}; CHECK_RX accepts {sorted(_rx_markers)}. "
    "A reader constrained without its doctrine being constrained lets the two drift "
    "silently, which is this project's dominant failure mode pointed at itself",
)

check(
    "wf-checkrun requires a declaration to be a TOP-LEVEL list item",
    'CHECK_RX = re.compile(r"^(?:[-*+]|\\d+[.)])' in _ckr,
    "an optional list marker matched a prose paragraph beginning `Check:` and an "
