# A bare `.claude/skills/workforce/bin/…` path assumes a PROJECT install. Personal
# is the ordinary case, so every scripted step of a procedure written that way dies
# on `no such file or directory`. Found 2026-08-03 by a real audit run; 11 sites
# carried it, and procedures/hooks.md had already been fixed AT THE INSTANCE the
# same week, which is why nothing generalised. scopes.md § Resolving the shipped
# scripts owns the resolver; hooks.md keeps a table because a hook registration
# needs a literal absolute path resolved at write time, not a shell variable.
_RESOLVER = 'WF="$HOME/.claude/skills/workforce"; [ -d "$WF" ] || WF="${CLAUDE_PROJECT_DIR}/.claude/skills/workforce"'
_BARE_PATH = re.compile(r"(?<![\w/`~}])\.claude/skills/workforce/bin/")
_bare = []
for _p in declared:
    if not _p.endswith(".md"):
        continue
    for _ln, _line in enumerate(read(_p).splitlines(), 1):
        if _BARE_PATH.search(_line) and "Never write a bare" not in _line:
            _bare.append(f"{_p}:{_ln}")
check(
    "scopes: no shipped file invokes a script by a bare project-scope path",
    not _bare,
    f"bare `.claude/skills/workforce/bin/` at: {_bare} — that path exists only on a "
    "project install. Use the resolver in scopes.md § Resolving the shipped scripts",
)
check(
    "scopes: the canonical script resolver is stated, and personal resolves first",
    _RESOLVER in read("workforce/references/scopes.md"),
    "scopes.md no longer carries the canonical resolver verbatim — every command "
    "block copies it, so the copies have nothing to be compared against",
)
_res_users = [
    _p for _p in declared
    if _p.endswith(".md") and re.search(r'"\$WF/bin/wf-', read(_p))
    and _RESOLVER not in read(_p)
]
check(
    "scopes: every file using $WF also defines it",
    not _res_users,
    f"uses `$WF/bin/…` without the resolver: {_res_users} — each command block runs "
    "in a fresh shell, so a block that inherits $WF from an earlier one is broken",
)
_hooks_md = read("workforce/references/procedures/hooks.md")
# find(), not index() — a missing row must FAIL this check, not raise out of the
# whole run. bin/prove breaks assertions by deleting their literal, so an
# index()-based check would take every other assertion down with it.
_hk_personal = _hooks_md.find("| 1 | `~/.claude/skills/workforce/bin/wf-protect-directives` |")
_hk_project = _hooks_md.find("| 2 | `${CLAUDE_PROJECT_DIR}/.claude/skills/workforce/bin/wf-protect-directives` |")
check(
    "hooks: the registration path resolves personal before project",
    _hk_personal != -1 and _hk_project != -1 and _hk_personal < _hk_project,
    "hooks.md orders the registration lookup project-first while citing scopes.md, "
    "which defines skills as enterprise > personal > project — project-first can "
    "return a copy that is shadowed by the one actually running",
)

