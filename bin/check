# ── The deferred-work queue: seven writers, and now a reader ─────────────────
# Six files said "queue a `review`" and one "queues one task", and NO QUEUE
# EXISTED — no location, no shape, no drain, nothing that would notice a queued
# item never happening. Seven writers, zero readers. This block is the pairing.
_QUEUE_RX = re.compile(r"queues? (?:a|one) [`*]")
_queue_writers = sorted(
    p for p in declared
    if p.endswith(".md")
    and p != "workforce/references/deferred.md"
    and _QUEUE_RX.search(read(p))
)
_unrouted = [p for p in _queue_writers if "references/deferred.md" not in read(p)]
check(
    "deferred: every file that queues work names the queue it queues into",
    not _unrouted,
    f"{_unrouted} — an instruction to queue, with nothing defining the queue, is "
    "the written-and-unwired pattern with seven authors instead of one",
)
check(
    "deferred: the queue is project state, never inside the skill",
    "never inside the skill" in dfr and "scopes.md" in dfr,
    "one installed skill serves many projects; a shared backlog merges them",
)
check(
    "deferred: a row names a runnable command, not a category",
    "never a category" in dfr,
    "'re-check this later' names nothing a reader can execute",
)
# The two halves. Either alone reproduces the failure: surfacing without
# draining is a backlog nobody clears; draining without surfacing is invisible
# to whoever runs a different command.
check(
    "deferred: the backlog rides the provenance header, so every command shows it",
    "deferred    <n> open" in vfy and "deferred" in dfr,
    "a backlog reported only by the command that created a row is invisible to a "
    "user who runs a different one — which is the failure being fixed",
)
check(
    "deferred: a command drains its own rows and never another command's",
    "NEVER discharges a row belonging to another command" in dfr,
    "a read-only command that quietly ran three reviews is unrequested work; "
    "SKILL.md § Display vs. Execute exists to prevent exactly that",
)
check(
    "deferred: the queue is never a route around a gate",
    "a route around a gate" in dfr and "a route around a gate" in read(
        "workforce/references/procedures/model-map.md"),
    "a queued model-map still requires --execute; the queue decides THAT work "
    "happens, never HOW",
)
# The honest limit. Overclaiming here would be the exact failure enforcement.md
# opens with — a document promising a guarantee the runtime will not keep.
check(
    "deferred: the guarantee stops where it actually stops, and says so",
    "cannot run a command the user never runs" in dfr and "not guaranteed" in dfr,
    "the mechanism cannot invoke commands; claiming otherwise is the overclaim "
    "this project fails a run over",
)
check(
    "deferred: an aged row cannot be closed by recording it",
    "never closed by recording it" in dfr and "acknowledged" in dfr,
    "a flag is not a fix (SKILL.md § Directives); without this an AGED row "
    "becomes a permanent line item that reads as handled",
)
# The Run Invariants block restated its own row count in audit.md, and said
# "Ten" while the table held eleven. Nothing compared them, because the check
# read invariants.md's declaration against invariants.md's table only.
#
# Widened 2026-08-03. The narrow form matched "Ten rows" only, so audit.md's
# "Compute the ten Run Invariants FIRST" sailed past it for the whole life of
# the check — and TWO further assertions then hardcoded that exact string as
# their match literal, pinning the wrong count in place from inside bin/check.
# By then three files carried three different counts (ten / eleven / twelve).
# So the scan is now class-wide: no shipped file pairs a number-word with this
# population, and invariants.md's declaration line is the single exemption.
_INV_COUNT_RX = re.compile(
    r"\b(?:eight|nine|ten|eleven|twelve|thirteen|fourteen|fifteen|sixteen|seventeen|eighteen)\s+"
    r"(?:rows?|Run[- ]Invariants?)\b",
    re.I,
)
_inv_restated = {}
for _p in declared:
    if not _p.endswith(".md"):
        continue
    for _m in _INV_COUNT_RX.finditer(read(_p)):
        # invariants.md owns the count; its declaration is the one legal statement.
        if _p.endswith("invariants.md") and _inv_decl and _m.start() >= _inv_decl.start():
            if _m.start() == _inv_decl.start():
                continue
        _inv_restated.setdefault(_p, []).append(_m.group(0))
check(
    "invariants: no shipped file restates the Run Invariant count",
    not _inv_restated,
    f"the count is owned by invariants.md's declaration and restated at: {_inv_restated} — "
    "audit.md said 'ten Run Invariants' and invariants.md's own exemplar said 'eleven rows' "
    "while the declaration said twelve; a run computing ten skips the gate on rows 11-12 "
    "immediately before the only step that deletes",
)

# ── Instruction volume: the second budget ────────────────────────────────────
# The length ceiling had THREE readers — verify § Handbook conformance, review
# step 8, and org-config.md § Caps — and no value anywhere. A rule with three
# consumers and no number is this project's signature defect, arriving in the
# file that holds its budgets.
_CEILING_RX = re.compile(r"\*\*(\d+) lines\*\*, and this is the only place the number is written")
_ceil = _CEILING_RX.search(dbg)
check(
    "volume: the handbook length ceiling has exactly one value, and it is stated",
    _ceil is not None,
    "delegation-budget.md must carry the number; three consumers check against it "
    "and a blank org-config.md cell resolves to it",
)
# Stated once means stated once. The consumers may NAME the ceiling; none may
# carry a second copy of the number.
_ceil_n = _ceil.group(1) if _ceil else None
_restated = [
    p for p in declared
    if p.endswith(".md")
    and p != "workforce/references/delegation-budget.md"
    and _ceil_n and re.search(rf"\b{_ceil_n}[- ]line", read(p))
]
check(
    "volume: the ceiling value is not restated by its consumers",
    # `_ceil_n is not None` is NOT redundant with the check above. Without it the
    # census has nothing to search for, `_restated` is empty, and this reports a
    # clean result about a scan it never ran — a vacuous pass, found by breaking
    # the declaration and watching only ONE of the two assertions fire.
    _ceil_n is not None and not _restated,
    f"restated in: {_restated} — consumers name the ceiling, they do not copy it"
    if _ceil_n else "the ceiling declaration is unreadable, so the restatement "
    "census could not run; it reports nothing rather than reporting clean",
)
check(
    "volume: a blank org-config cap resolves to the default, not to no cap",
    "means this default, not" in dbg and "Handbook length ceiling" in _ocfg,
    "a blank cell read as 'no ceiling' silently disables a check three files run",
)
check(
    "volume: the ceiling is labelled a chosen budget, and cannot refuse work",
    "chosen budget, not a measurement" in dbg and "never a refusal" in dbg,
    "platform.md § DOCUMENTED bars an unmeasured number from blocking anyone; the "
    "delegation caps were demoted for exactly this and the rule generalises",
)
check(
