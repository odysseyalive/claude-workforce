# ── Provisional verification is scoped by the ROLE, not the mode ─────────────
# "Provisional applies to charter-first only" keyed the escape to the MODE FORK,
# which asks whether skills exist. Whether a CHECK exists is a different question,
# asked per kind of work — and a project can be brownfield by that fork while
# having no build, test, or lint at all.
#
# The mock audit measured what that produced on apps-odyssey-alive, and it was not
# an empty chart: content and design hired (their evaluator catalogs ship with the
# project, so a catalog grep is a real tier-3 check), engineering dropped, on a
# project whose stated next action is to build. Plausible, confident, and missing
# the department the project exists for.
# The retracted phrase must SURVIVE, marked as retracted — this project writes down
# what it reversed rather than deleting it (platform.md § the contradiction is
# written down). A first draft asserted the phrase was ABSENT and failed against the
# retraction sentence quoting it, which would have taught the fix to erase its own
# history. So: it may appear once, and only inside the retraction.
_pv_hits = _od.count("charter-first only")
# Contiguous fragment only. The full retraction sentence wraps between "applies to"
# and "charter-first only", so matching it whole silently never fires — the third
# time this hard-wrap has broken an assertion in this file.
_pv_retracted = 'An earlier form read *"provisional applies to' in _od
check(
    "org-design: provisional is scoped by the role's check, not by the project mode",
    "The scope is the ROLE, not the project mode" in _od
    and "does the check for THIS role's work exist yet" in _od
    and _pv_hits == 1 and _pv_retracted,
    f"the mode-scoped rule must appear exactly once and only as a retraction "
    f"(found {_pv_hits}, retracted={_pv_retracted}). Keying the escape to the mode "
    "fork drops every role that would build the tooling the rule demands — unevenly, "
    "which is worse than dropping all of them",
)
check(
    "org-design: an available check is never downgraded to a promise",
    "Provisional is **refused**" in _od,
    "without this, provisional widens from an admission into a way to skip naming a "
    "check that already exists",
)
check(
    "org-design: the named check is quoted from evidence, never invented",
    "never invented" in _od and "a fabricated command is the" in _od,
    "principle 5 forbids inventing a procedure step; a fabricated command is the same "
    "invention with a worse failure, because it will be typed",
)
check(
    "org-design: the real/provisional split is printed, so a lopsided org is visible",
    "Report the split, always" in _od and "3 provisional" in _od
    and "Print both counts" in aud,
    "a run staffed entirely on promises must not look like one staffed on checks; the "
    "count is what made the lopsided shape visible in the first place",
)

# ── `--review` writes nothing, including in the gates that write ─────────────
# Found by PREPARING to run the first mock audit, before a step executed. A prior
# pass fixed the two steps that contradicted "--review writes nothing" — both in
# audit.md — while the writing gates live in audit-setup.md. Step 0.6 registers
# agent fixtures in the user's .claude/agents/, so a run advertised as zero-write
# would have written into the tree it was previewing.
#
# The same shape audit.md already records about Step 0.7: a sweep scoped to one
# file, over a procedure sequenced across two.
_WRITING_GATES = ["## Step 0.2 — Backup", "## Step 0.6 — Write the canary fixtures"]
_silent_gates = []
for _g in _WRITING_GATES:
    _i = _asu.find(_g)
    _nxt = _asu.find("\n## ", _i + 1) if _i >= 0 else -1
    _body = _asu[_i:_nxt if _nxt > 0 else len(_asu)] if _i >= 0 else ""
    if not _body or "--review" not in _body:
        _silent_gates.append(_g)
check(
    "audit-setup: every writing gate declares its `--review` behavior",
    not _silent_gates and "Every writing gate declares its `--review` behavior" in _asu,
    f"silent under --review: {_silent_gates} — a mode whose whole promise is that it "
    "writes nothing cannot have gates that write and never mention it",
)

# ── Coverage derivation, landed 2026-07-31 ───────────────────────────────────
# The first design proved a coverage claim by PLANTING a defect and requiring the
# command to catch it — carrying "released by making it fail" over from maintainers,
# where it is right. The carry-over was wrong: a planted defect proves ONE POINT
# inside a claim about a WHOLE SCOPE, so the evidence never matched the shape of the
# claim. It was expensive, destructive, and weak at once.
#
# The fix is not a better audit of the cell. It is deriving the cell, so there is no
# authored claim left to be wrong — over-claim becomes unreachable rather than
# detected. Commands enumerate themselves for free and non-destructively, and that
# also dissolves the source-drift blind spot the stamp was invented to tolerate.
check(
    "org-chart-format: Covers is derived from the command, never authored",
    "DERIVED, never authored" in _ocf and "Nothing authors the cell" in _ocf,
    "an authored coverage claim can over-claim, and an over-claim is the one error "
    "that produces a false PASS at dispatch — deriving it removes the cell that "
    "could have been wrong",
)
check(
    "org: only a derived scope may satisfy total coverage",
    "ONLY IF its `Scope` cell reads `derived`" in _org
    and "`derived <date>`" in _ocf and "step only" in _ocf,
    "a `declared` row rests on prose somebody wrote; letting it answer an ask alone "
    "reinstates exactly the authored claim derivation exists to remove",
)
check(
    "org: a declared row costs a hop, never a capability",
    "COSTS A HOP, NEVER A CAPABILITY" in _org and "as a STEP" in _org,
    "strictness that discards a working command is not safety — a step-only row is "
    "still named in the work order, and the refusal is reported rather than silent",
)
check(
    "org: enumeration executes nothing, and is re-run rather than cached",
    "It must execute nothing" in _org and "Re-derive on EVERY index" in _org
    and "not a discovery mode" in _ocf,
    "a discovery mode that runs or writes would make `index` destructive; a cached "
    "scope is a claim about a tree that has moved, which is the drift the stamp "
    "design tolerated instead of closing",
)
# Written first as a chain of `or`/`and` without parentheses, which Python reads as
# (A or B or (C and D) or E) — true the moment any one term matched, so it asserted
# essentially nothing. Caught by breaking it, which is the entire reason for the rule.
# Substrings are contiguous ones: the prose is hard-wrapped, so "boundary of
# responsibility" spans a newline and never matches.
check(
    "org-chart-format: what derivation cannot establish is a boundary, not a gap",
    "vacuous test file" in _ocf and "not a gap to be closed later" in _ocf,
    "enumeration says what a command WILL RUN, never whether it asserts anything — "
    "that is the project's business, and a mechanism written against it would be the "
    "overclaim enforcement.md refuses",
)
check(
    "org: two rows claiming the same work stop the door and are fixed at index",
    "TABLE DEFECT" in _org and "Do NOT pick the first" in _org
    and "never by deleting a row" in _ocf,
    "a dispatch-time tiebreak between two total-coverage claims is a guess dressed as "
    "a rule; the defect is that index wrote two answers to one question",
)
check(
    "procedure-for-procedures: the mechanical preference reaches the PROCEDURE half",
    "Prefer the mechanical form of a step" in _pfp2 and "compounds" in _pfp2,
    "`## Verification` enforces tier 1 already; nothing enforced it for procedure "
    "steps, which is where the cost is paid on every work order forever",
)
# Rule 3b landed with an assertion that the RULE EXISTS and nothing making handbooks
# follow it — the written-and-unwired shape, committed while fixing it. No static
# check can separate a step that should be a command from one correctly left prose,
# so per rule 8b the class is PROCEDURAL and the enforcement is a counted line.
check(
    "procedure-for-procedures: rule 3b names its own enforcement class and prints a count",
    "PROCEDURAL, per rule 8b" in _pfp2 and "UNSTATED" in _pfp2
    and "Mechanical preference" in read("workforce/references/procedures/handbook.md"),
    "a preference with no counted line is an intention; handbook.md must print "
    "steps · naming a command · stating why not · UNSTATED, on every authoring",
)

# ─────────────────────────────────────────────────────────────────────────────
# Maintainer authoring, landed 2026-07-31. `## Maintainers` was a required section
# with nothing on the greenfield path that could fill it: authoring was descriptive
# only, so an org could ship a validated schema, a stated degradation contract, and
# no validator. Every invariant was then a sentence an employee was trusted to keep.
#
# The negative test is the load-bearing half. A validator that has only ever exited
# 0 is indistinguishable from `exit 0`, which is why these assertions were each
# broken before being trusted.
# ─────────────────────────────────────────────────────────────────────────────
DS_CLASSES = ["`mechanical`", "`contextual`", "`advisory`"]
check(
