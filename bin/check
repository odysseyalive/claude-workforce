# NO READ-ONLY PROCEDURE MAY SHOW AN EXECUTING INVOCATION.
#
# `verify.md` shipped a block carrying `--run --prove` under a command SKILL.md
# classifies read-only — a host following it would execute shell drawn from every
# handbook in the org. The FIRST fix checked only the first block of that one file
# and left the executing form one block lower: a guard written to permit the thing
# it was meant to stop. This is the class.
#
# The read-only list is READ FROM SKILL.md, never restated here (Core Principle 9a).
# Multi-word entries (`org index`, `org status`) are skipped deliberately: their
# procedure file also serves `org embed`, which IS a --execute command, so the file
# legitimately carries executing invocations and the command-to-file mapping is not
# 1:1 there.
_EXECUTING = ("--execute", "--run", "--prove", "--apply", "--remove", "--stamp")
_ro_m = re.search(r"read-only commands run immediately:(.*?)\.\n", skill, re.S)
_readonly = [c for c in re.findall(r"`([a-z][a-z ]*)`", _ro_m.group(1))] if _ro_m else []
_ro_single = [c for c in _readonly if " " not in c]
_ro_violations = []
for _c in _ro_single:
    _f = f"workforce/references/procedures/{_c}.md"
    _body = read(_f)
    if not _body:
        continue
    for _m in re.finditer(r"```bash\n(.*?)```", _body, re.S):
        for _ln in _m.group(1).splitlines():
            if any(_flag in _ln for _flag in _EXECUTING):
                _ro_violations.append(f"{_c}.md: {_ln.strip()[:90]}")
check(
    "the read-only list was actually parsed out of SKILL.md",
    len(_ro_single) >= 5,
    f"parsed {_ro_single} — if the § Display vs. Execute sentence is reworded this "
    "silently checks nothing, which is the vacuous-pass shape",
)
check(
    "no read-only procedure shows an executing invocation",
    not _ro_violations,
    f"{_ro_violations} — SKILL.md classifies these commands read-only, run "
    "immediately, no --execute required. A bash block carrying an executing flag "
    "tells a host to run it; a caveat underneath does not gate a command block",
)
check(
    "verify.md no longer calls the real-or-decoration question uncheckable",
    "whether a `## Verification` check is *real* or decoration" not in vfy
    and "wf-checkrun" in vfy,
    "that sentence declared the territory deliberately uncovered; leaving it "
    "beside a gate that now checks it is a file disagreeing with itself",
)
check(
    "the IC template ships the declared runnable form",
    "- Check: `<exact command>`" in tpl and "- Negative:" in tpl,
    "the cheapest place to answer this is the template — verification.md's own "
    "lesson, learned when two generated handbooks were amended and the template "
    "was left to reproduce the defect on every later hire",
)

# ─────────────────────────────────────────────────────────────────────────────
# EVERY bin/prove PAYLOAD MUST BE UNIQUE IN ITS TARGET
#
# `bin/prove` deletes the FIRST occurrence of a literal and asserts the named check
# fires. If that literal appears twice, the deletion hits the wrong copy and the
# check stays satisfied — the case reports PROVEN or VACUOUS while testing nothing.
#
# This happened FOUR times in one session: `NOTHING RAN` once in a comment and twice
# in prints, `"ambiguous-markup"` and `"negative-unresolved"` each also in the glyph
# map. `bin/prove` caught every one, but only after a full run. This catches them at
# `bin/check` time, which is the difference between a minute and a quarter of an hour.
# ─────────────────────────────────────────────────────────────────────────────
_prove_src = read("bin/prove")
_dupe_payloads = []
try:
    _pt = _a2.parse(_prove_src)
    _pconst = {}
    for _n in _a2.walk(_pt):
        if isinstance(_n, _a2.Assign) and getattr(_n.targets[0], "id", "") and \
                isinstance(_n.value, _a2.Constant) and isinstance(_n.value.value, str):
            _pconst[_n.targets[0].id] = _n.value.value
        if isinstance(_n, _a2.Assign) and getattr(_n.targets[0], "id", "") == "CASES":
            for _case in getattr(_n.value, "elts", []):
                _el = getattr(_case, "elts", [])
                if len(_el) != 4:
                    continue
                _name = _el[0].value if isinstance(_el[0], _a2.Constant) else None
                _fvar = getattr(_el[1], "id", None)
                _mode = _el[2].value if isinstance(_el[2], _a2.Constant) else None
                _pay = _el[3].value if isinstance(_el[3], _a2.Constant) else None
                if _mode != "del" or not (_name and _fvar and _pay):
                    continue
                _target = _pconst.get(_fvar)
                if not _target:
                    continue
                _body = read(_target)
                if _body and _body.count(_pay) > 1:
                    _dupe_payloads.append(f"{_name!r} -> {_pay[:40]!r} x{_body.count(_pay)}")
except Exception as _e:  # a diagnostic must not die on the input it diagnoses
    _dupe_payloads.append(f"could not parse bin/prove: {_e}")

check(
    "prove: every `del` payload occurs exactly once in its target",
    not _dupe_payloads,
    f"{_dupe_payloads} — bin/prove deletes the FIRST occurrence, so a payload that "
    "appears twice hits the wrong copy and the assertion stays satisfied. The case "
    "then reports on a mutation that changed nothing. Four instances in one session",
)

# ─────────────────────────────────────────────────────────────────────────────
# bin/prove BREAKS A COPY, NEVER THE WORKING TREE
#
# bin/prove used to break real tracked files and restore them in a `finally`. A full
# run is 181 s sequentially — longer than the 120 s default Bash timeout — so it was
# habitually backgrounded, and a backgrounded process is killed by SIGTERM at session
# teardown, which does NOT run `finally`. MEASURED 2026-08-04, both directions: SIGINT
# restored the file, SIGTERM left it MUTATED with the temp backup orphaned and nothing
# recording which file it had been. The next session sees an unexplained red baseline,
# and a `git commit -a` inside that 181-second window commits the sabotage.
#
# Fixed at the cause: each worker breaks files inside a private disposable copy. That
# makes the run parallel (so it fits a foreground call and never needs backgrounding)
# AND makes the corruption unreachable by any signal, because the tree is not written.
# These two assertions are the halves that must not drift back — one that the copy is
# taken, one that cases are applied to the copy rather than to ROOT.
# ─────────────────────────────────────────────────────────────────────────────
check(
    "prove: each worker breaks a private copy of the tree",
    "shutil.copytree(ROOT, work" in _prove_src,
    "without the copy, bin/prove is back to mutating tracked files in place — a "
    "181-second window in which the working tree carries a deliberately-sabotaged "
    "file, and any kill that is not SIGINT leaves it there unattributed",
)
check(
    "prove: cases are applied to the copy, not to ROOT",
    "target = work / relpath" in _prove_src,
    "taking a copy and then writing to ROOT anyway is the same defect with more "
    "code in front of it — the assertion has to name where the write LANDS",
)

# The handler survives the redesign for the smaller job it still has: unwinding the
# TemporaryDirectory contexts so a kill does not orphan ~1 MB copies in /tmp. The
# literal asserted is the REGISTRATION, not the handler — a handler defined and never
# installed is the same silence with more code in front of it.
check(
    "prove: a SIGTERM teardown unwinds the worker temp directories",
    "signal.SIGTERM, signal.SIGHUP" in _prove_src,
    "TemporaryDirectory cleans up on normal unwind and on SIGINT, but not on a "
    "default-disposition SIGTERM — which is what a session teardown sends",
)

