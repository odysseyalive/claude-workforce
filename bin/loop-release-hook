    "az": ({"deploy", "up", "publish", "upload", "upload-batch", "sync"}, 4,
           {"--subscription", "-o", "--output", "--query"}),
    "gsutil": ({"rsync"}, 1, {"-o", "-h", "-u"}),
    "rclone": ({"sync", "copy", "move", "copyto", "moveto", "bisync"}, 1, {"--config"}),
