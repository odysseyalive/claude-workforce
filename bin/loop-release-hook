class Unreadable(Exception):
    """A command the guard cannot read as a shell would; denied."""


def stem(path):
    base = os.path.basename(path.rstrip("/"))
    return base.rsplit(".", 1)[0].lower() if "." in base[1:] else base.lower()


def scripted(path):
    """True when a script's or task's name says it releases: its first word is publish, deploy
    or release (`deploy.sh`, `publish:site`, `release-prod`), and no later word says it only
    checks (`deploy_check.py`, `release:notes`, `deploy.spec`)."""
    words = [w for w in re.split(r"[-_.:]+", stem(path)) if w]
    return bool(words) and words[0] in WORDS + ("publishing", "deploying", "releasing") and \
        not NOT_A_RELEASE.intersection(words[1:])


class Word(str):
    """A shell word after quote removal. `bare`: its unquoted characters (quoted ones become
    "_"), for brace expansion and a leading `$`; `vars`: the parameters it expands (outside
    single quotes); `literal`: no expansion or substitution at all."""
    def __new__(cls, text, bare="", vars=(), literal=True):
        w = str.__new__(cls, text)
        w.bare, w.vars, w.literal = bare, tuple(vars), literal
        return w


class Op(str):
    """An operator or redirect; a heredoc's `<<` carries its `body`."""
    body = None


PLACEHOLDER = re.compile(r"\x00(\d+)\x00")
SUBSTS = {}  # placeholder number -> (kind, body), for every substitution read in this process
REDIR_OPS = ("<<<", "<<-", "<<", "<>", "<&", ">&", ">>", ">|", "&>>", "&>", "<", ">")
CTRL_OPS = (";;", "&&", "||", "|&", ";", "|", "&", "(", ")")
ANSI_C = {"a": "\a", "b": "\b", "e": "\x1b", "E": "\x1b", "f": "\f", "n": "\n", "r": "\r",
          "t": "\t", "v": "\v", "\\": "\\", "'": "'", '"': '"', "?": "?"}


HEREDOC_OP = re.compile(r"<<(-?)[ \t]*((?:[^\s;&|<>()'\"]|'[^']*'|\"[^\"]*\")+)")


def closing(text, i):
    """Index just past the `)` that closes the `(` at text[i-1], reading the way the shell
    does: quotes, nested substitutions, `${...}`, comments, and heredoc bodies (skipped, so an
    apostrophe or a parenthesis in a commit message is data); raises Unreadable when there is
    no closing parenthesis."""
    depth, j, pending = 1, i, []
    while j < len(text):
        c = text[j]
        if c == "\\":
            j += 2
        elif c == "'":
            k = text.find("'", j + 1)
            if k < 0:
                raise Unreadable("an unterminated quote")
            j = k + 1
        elif c == '"':
            j = dquote_end(text, j + 1)
        elif c == "`":
            k = text.find("`", j + 1)
            if k < 0:
                raise Unreadable("an unterminated backtick")
            j = k + 1
        elif text.startswith("${", j):
            j = param_end(text, j + 2)[0]
        elif c == "#" and (j == i or text[j - 1] in " \t\n;&|("):
            k = text.find("\n", j)
            j = len(text) if k < 0 else k
        elif text.startswith("<<", j) and not text.startswith("<<<", j) and HEREDOC_OP.match(text, j):
            m = HEREDOC_OP.match(text, j)
            pending.append((re.sub(r"['\"]", "", m.group(2)), m.group(1) == "-"))
            j = m.end()
        elif c == "\n" and pending:
            j = skip_bodies(text, j + 1, pending)
            pending = []
        elif c == "(":
            depth, j = depth + 1, j + 1
        elif c == ")":
            depth, j = depth - 1, j + 1
            if depth == 0:
                return j
        else:
            j += 1
    raise Unreadable("an unterminated substitution")


def skip_bodies(text, j, pending):
    """The index past the heredoc bodies that start at text[j]."""
    for delim, strip_tabs in pending:
        while j < len(text):
            k = text.find("\n", j)
            line = text[j:len(text) if k < 0 else k]
            j = len(text) if k < 0 else k + 1
            if (line.lstrip("\t") if strip_tabs else line) == delim:
                break
    return j


def dquote_end(text, j):
    """The index past a double-quoted string's closing quote, its body starting at text[j]."""
    while j < len(text):
        c = text[j]
        if c == "\\":
            j += 2
        elif c == '"':
            return j + 1
        elif text.startswith("$(", j):
            j = closing(text, j + 2)
        elif text.startswith("${", j):
            j = param_end(text, j + 2, in_dq=True)[0]
        elif c == "`":
            k = text.find("`", j + 1)
            if k < 0:
                raise Unreadable("an unterminated backtick")
            j = k + 1
        else:
            j += 1
    raise Unreadable("an unterminated quote")


def param_end(text, j, in_dq=False):
    """(index past the `}` closing a `${` whose body starts at text[j], [the bodies of every
    $(...), `...` and $((...)) substitution inside it]). The operand is read the way bash reads
    it: quotes (a single quote is literal inside double quotes), nested `${...}`, substitutions.
    Unreadable only when it does not end."""
    start = j
    while j < len(text):
        c = text[j]
        if c == "\\":
            j += 2
        elif c == "'" and not in_dq:
            k = text.find("'", j + 1)
            if k < 0:
                raise Unreadable("an unterminated quote in ${...}")
            j = k + 1
        elif c == '"':
            j = dquote_end(text, j + 1)
        elif text.startswith("$(", j):
            j = closing(text, j + 2)
        elif text.startswith("${", j):
            j = param_end(text, j + 2, in_dq)[0]
        elif c == "`":
            k = text.find("`", j + 1)
            if k < 0:
                raise Unreadable("an unterminated backtick")
            j = k + 1
        elif c == "}":
            return j + 1, inner_substs(text[start:j], in_dq)
        else:
            j += 1
    raise Unreadable("an unterminated ${...}")


def inner_substs(text, in_dq=True):
    """The command bodies of every $(...), `...` and $((...))/${...}-nested substitution in a
    piece of text that the shell expands (an operand, an arithmetic expression, an unquoted
    heredoc body)."""
    out, j = [], 0
    while j < len(text):
        c = text[j]
        if c == "\\":
            j += 2
        elif c == "'" and not in_dq:
            k = text.find("'", j + 1)
            j = len(text) if k < 0 else k + 1
        elif text.startswith("$((", j):
            k = closing(text, j + 2)
            out += inner_substs(text[j + 3:k - 2])
            j = k
        elif text.startswith("$(", j):
            k = closing(text, j + 2)
            out.append(text[j + 2:k - 1])
            j = k
        elif text.startswith("${", j):
            k, bodies = param_end(text, j + 2, in_dq)
            out += bodies
            j = k
        elif c == "`":
            k = text.find("`", j + 1)
            if k < 0:
                raise Unreadable("an unterminated backtick")
            out.append(text[j + 1:k])
            j = k + 1
        else:
            j += 1
    return out


def ansi_c(text, j):
    """(decoded text, index past the closing quote) of a $'...' body starting at text[j]."""
    out = []
    while j < len(text):
        c = text[j]
        if c == "'":
            return "".join(out), j + 1
        if c == "\\" and j + 1 < len(text):
            d = text[j + 1]
            if d in ANSI_C:
                out.append(ANSI_C[d])
                j += 2
            elif d == "x":
                m = re.match(r"[0-9a-fA-F]{1,2}", text[j + 2:])
                out.append(chr(int(m.group(0), 16)) if m else "\\x")
                j += 2 + (len(m.group(0)) if m else 0)
            elif d in "uU":
                m = re.match(r"[0-9a-fA-F]{1,%d}" % (4 if d == "u" else 8), text[j + 2:])
                out.append(chr(int(m.group(0), 16)) if m else "\\" + d)
                j += 2 + (len(m.group(0)) if m else 0)
            elif d in "01234567":
                m = re.match(r"[0-7]{1,3}", text[j + 1:])
                out.append(chr(int(m.group(0), 8)))
                j += 1 + len(m.group(0))
            elif d == "c" and j + 2 < len(text):
                out.append(chr(ord(text[j + 2]) & 0x1f))
                j += 3
            else:
                out.append("\\" + d)
                j += 2
            continue
        out.append(c)
        j += 1
    raise Unreadable("an unterminated $'...' quote")


def arithmetic(text, j):
    """True when the `$((` at text[j] is arithmetic: its matching parens close as `))`."""
    try:
        k = closing(text, j + 2)
    except Unreadable:
        return False
    return text[k - 2:k] == "))"


def lex(text, substs):
    """The tokens of a command line as bash reads it: Words and Ops. Comments start only where
    `#` begins a word outside quotes and end at the newline; a backslash-newline is removed;
    an unquoted newline is a separator (`\\n`); $'...' is decoded; $(...), `...`, <(...) and
    >(...) become a placeholder (their bodies go to `substs`, as (kind, body)); a heredoc's
    body is read from the lines after its line, ending at its delimiter (quotes removed)."""
    toks, i, n = [], 0, len(text)
    cur, bare, vars_, literal = None, [], [], True
    pending = []

    def add(chars, quoted, lit=True):
        nonlocal cur, literal
        cur = (cur or "") + chars
        bare.append("_" * len(chars) if quoted else chars)
        literal = literal and lit and "\x00" not in chars  # an outer substitution's placeholder

    def flush():
        nonlocal cur, bare, vars_, literal
        if cur is not None:
            toks.append(Word(cur, "".join(bare), vars_, literal))
        cur, bare, vars_, literal = None, [], [], True

    def subst(kind, body):
        substs.append((kind, body))
        key = len(SUBSTS)  # unique across nested reads: a payload carries its outer placeholders
        SUBSTS[key] = (kind, body)
        add("\x00%d\x00" % key, True, False)

    def arith(j, quoted):
        """$((expr)): a number; every substitution inside it is a command."""
        k = closing(text, j + 2)
        substs.extend(("cmd", body) for body in inner_substs(text[j + 3:k - 2]))
        add(text[j:k], quoted, False)
        return k

    def var(j, quoted):
        if text.startswith("${", j):  # a parameter expansion, read to its matching brace
            end, bodies = param_end(text, j + 2, in_dq=quoted)
            substs.extend(("cmd", body) for body in bodies)
            vars_.append(re.match(r"[#!]?([A-Za-z_][A-Za-z0-9_]*|[0-9#?@*$!-]?)",
                                  text[j + 2:]).group(1))
            add(text[j:end], quoted, False)
            return end
        m = re.match(r"\$([A-Za-z_][A-Za-z0-9_]*|[0-9#?@*$!-])", text[j:])
        if not m:
            add("$", quoted)
            return j + 1
        vars_.append(m.group(1).strip("{}").split(":")[0].split("[")[0])
        add(m.group(0), quoted, False)
        return j + len(m.group(0))

    while i < n:
        c = text[i]
        if c == "\\" and text.startswith("\n", i + 1):
            i += 2
        elif c == "\\":
            add(text[i + 1:i + 2], True)
            i += 2
        elif c == "'":
            k = text.find("'", i + 1)
            if k < 0:
                raise Unreadable("an unterminated quote")
            add(text[i + 1:k], True)
            i = k + 1
        elif text.startswith("$'", i):
            s, i = ansi_c(text, i + 2)
            add(s, True)
        elif c == '"':
            j = i + 1
            if cur is None:
                cur = ""
            while True:
                if j >= n:
                    raise Unreadable("an unterminated quote")
                d = text[j]
                if d == '"':
                    j += 1
                    break
                if d == "\\" and j + 1 < n and text[j + 1] in '$`"\\\n':
                    if text[j + 1] != "\n":
                        add(text[j + 1], True)
                    j += 2
                elif text.startswith("$((", j) and arithmetic(text, j):
                    j = arith(j, True)
                elif text.startswith("$(", j):
                    k = closing(text, j + 2)
                    subst("cmd", text[j + 2:k - 1])
                    j = k
                elif d == "`":
                    k = text.find("`", j + 1)
                    if k < 0:
                        raise Unreadable("an unterminated backtick")
                    subst("cmd", text[j + 1:k])
                    j = k + 1
                elif d == "$":
                    j = var(j, True)
                else:
                    add(d, True)
                    j += 1
            i = j
        elif text.startswith("$((", i) and arithmetic(text, i):
            i = arith(i, False)
        elif text.startswith("$(", i):
            k = closing(text, i + 2)
            subst("cmd", text[i + 2:k - 1])
            i = k
        elif c == "(" and (cur is not None or (
                toks and isinstance(toks[-1], Word) and toks[-1] not in KEYWORDS and
                toks[-1] not in WRAPPERS and toks[-1] not in ("time", "!", "then", "do", "else",
                                                             "elif", "if", "while", "until"))):
            # mid-word, or a word of its own after the command word: a zsh glob group or
            # qualifier, `(N)`, `(publish|x)(N)`; bash would reject it
            k = closing(text, i + 1)
            body = text[i + 1:k - 1]
            if cur is not None and not body.strip() and re.fullmatch(r"[\w.:-]+", cur):
                flush()  # `name() {`: a function definition, not a glob
                toks += [Op("("), Op(")")]
                i = k
                continue
            array = cur is not None and re.fullmatch(r"[A-Za-z_]\w*\+?=", cur)  # `ids=(a b c)`: an array, not a glob
            if not array and re.search(r"(?:^|[^A-Za-z])e[^A-Za-z0-9\s]|(?:^|[^\w])\+\w", body):
                raise Unreadable("a zsh glob qualifier that runs code (e or +)")
            substs.extend(("cmd", b) for b in inner_substs(body, in_dq=False))
            add(text[i:k], False)
            i = k
        elif c == "`":
            k = text.find("`", i + 1)
            if k < 0:
                raise Unreadable("an unterminated backtick")
            subst("cmd", text[i + 1:k])
            i = k + 1
        elif c in "<>" and text.startswith("(", i + 1) and cur is None:
            k = closing(text, i + 2)
            subst("in" if c == "<" else "out", text[i + 2:k - 1])
            i = k
        elif c == "$":
            i = var(i, False)
        elif c == "#" and cur is None:
            k = text.find("\n", i)
            i = n if k < 0 else k
        elif c == "\n":
            flush()
            toks.append(Op("\n"))
            i += 1
            for op, strip_tabs in pending:  # heredoc bodies follow the line that opened them
                at = next(k for k, t in enumerate(toks) if t is op)
                delim = toks[at + 1] if at + 1 < len(toks) and isinstance(toks[at + 1], Word) else ""
                lines = []
                while i < n:
                    k = text.find("\n", i)
                    line = text[i:n if k < 0 else k]
                    i = n if k < 0 else k + 1
                    if (line.lstrip("\t") if strip_tabs else line) == delim:
                        break
                    lines.append(line)
                op.body = "\n".join(lines)
                if isinstance(delim, Word) and delim.bare == str(delim):  # unquoted: it expands
                    substs.extend(("cmd", body) for body in inner_substs(op.body))
            pending = []
        elif c in " \t":
            flush()
            i += 1
        else:
            redir = next((o for o in REDIR_OPS if text.startswith(o, i)), None)
            if redir:
                if cur is not None and re.fullmatch(r"\d+|\{\w+\}", cur):
                    cur, bare, vars_, literal = None, [], [], True  # `2>`: the fd is the op's
                flush()
                op = Op(redir)
                toks.append(op)
                if redir in ("<<", "<<-"):
                    pending.append((op, redir == "<<-"))
                i += len(redir)
                continue
            ctrl = next((o for o in CTRL_OPS if text.startswith(o, i)), None)
            if ctrl:
                flush()
                toks.append(Op(ctrl))
                i += len(ctrl)
                continue
            add(c, False)
            i += 1
    flush()
    return toks


class Seg:
    """One simple command: its assignments, argv, redirects [(op, target)], and the command
    piped into it."""
    def __init__(self):
        self.assigns, self.argv, self.redirs, self.pipe_from = [], [], [], None


SEPARATORS = {";", "&", "&&", "||", "\n", "(", ")", ";;"}


def segments(toks):
    out, cur, prev_pipe = [], Seg(), False
    i = 0
    while i < len(toks):
        t = toks[i]
        if isinstance(t, Op) and (t in SEPARATORS or t in ("|", "|&")):
            if cur.argv or cur.assigns or cur.redirs:
                out.append(cur)
            nxt = Seg()
            if t in ("|", "|&") and out and out[-1] is cur:
                nxt.pipe_from = cur
            cur = nxt
        elif isinstance(t, Op):  # a redirect: its target is the next word
            target = toks[i + 1] if i + 1 < len(toks) and isinstance(toks[i + 1], Word) else Word("")
            cur.redirs.append((t, target))
            i += 1
        elif not cur.argv and ASSIGNMENT.match(t):
            cur.assigns.append(t)
        elif not cur.argv and t in KEYWORDS:
            pass
        else:
            cur.argv.append(t)
        i += 1
    if cur.argv or cur.assigns or cur.redirs:
        out.append(cur)
    return [s for s in out if not (s.argv and s.argv[0] in DATA_KEYWORDS)]


def positionals(argv, value_opts=frozenset(), past_dashdash=False):
    """The arguments that are not options or option values; `--` ends them, or with
    `past_dashdash` ends the options, so what follows is positional (`npm -- publish`)."""
    out, skip = [], False
    for at, tok in enumerate(argv):
        if skip:
            skip = False
        elif tok == "--":
            return out + list(argv[at + 1:]) if past_dashdash else out
        elif tok.startswith("-") and len(tok) > 1:
            skip = tok in value_opts
        else:
            out.append(tok)
    return out


def a_path(tok, cwd):
    return bool(cwd) and os.path.lexists(os.path.join(cwd, tok))


def classify(command, cwd=None, depth=0):
    """Why `command` is a release, or None. It is read as bash reads it (`lex`); every
    substitution's body is read as a command; a word bash would expand into a command the
    guard cannot see (a brace list as the command word, $IFS splitting) is unreadable."""
    if depth > 6:
        raise Unreadable("nested too deeply to read")
    substs = []
    toks = lex(command, substs)
    segs = segments(toks)
    if any("IFS" in t.vars for t in toks if isinstance(t, Word)):
        raise Unreadable("a word expands $IFS")
    # IFS set for the shell itself (an assignment alone), not for one command (`IFS= read`).
    ifs_set = any(a.startswith("IFS=") for s in segs if not s.argv for a in s.assigns)
    if depth == 0:
        KNOWN.clear()
    learn(segs)
    for seg in segs:
        if not seg.argv:
            continue
        if ifs_set and seg.argv[0].bare.startswith("$"):
            raise Unreadable("IFS is set and the command word is a variable")
        only = re.fullmatch(r"\$(\{[^}]*\}|[A-Za-z_]\w*|[@*#?$!0-9-])", seg.argv[0])
        if only and not seg.argv[0].literal:
            words = resolve(only.group(1).strip("{}"))
            if words is None:  # assigned elsewhere (a function's "$@", `$(which ...)`): a limit
                seg.argv = []
                continue
            why = classify(" ".join(shlex_quote(w) for w in words + list(seg.argv[1:])),
                           cwd, depth + 1)
            if why:
                return why
            seg.argv = []
            continue
        m = PLACEHOLDER.fullmatch(seg.argv[0])
        if m:  # `$(cmd) args`: read when cmd's output is literal (`$(echo npm) publish`)
            out = producer(SUBSTS[int(m.group(1))][1])
            if out[0] == "literal":
                why = classify(" ".join([out[1]] + [shlex_quote(w) for w in seg.argv[1:]]),
                               cwd, depth + 1)
                if why:
                    return why
            seg.argv = []  # otherwise code from a substitution: a documented limit
            continue
        if re.search(r"\{[^{}]*,[^{}]*\}", seg.argv[0].bare):
            raise Unreadable("its command word is a brace expansion")
    for kind, body in substs:
        why = classify(body, cwd, depth + 1)
        if why:
            return why
    for seg in segs:
        for a in seg.assigns:  # code the shell runs later
            if a.startswith("PROMPT_COMMAND="):
                why = nested(a.split("=", 1)[1], cwd, depth, "PROMPT_COMMAND")
                if why:
                    return why
        why = classify_argv(list(seg.argv), cwd, depth, stdin_of(seg, substs), substs)
        if why:
            return why
    return None


KNOWN = {}  # name -> [words]: literal assignments seen on this command line


def learn(segs):
    """Record the literal assignments a command line makes: `x=...`, `a=(...)`, `set -- ...`,
    `read a b <<< 'literal'`, so a command word that only expands one of them can be read."""
    for seg in segs:
        for a in seg.assigns if not seg.argv else []:
            name, _, val = a.partition("=")
            if a.literal or re.fullmatch(r"\(.*\)", val, re.S):
                KNOWN[name] = val[1:-1].split() if val.startswith("(") and val.endswith(")") \
                    else [val]
        if seg.argv and seg.argv[0] == "set" and seg.argv[1:2] == ["--"] and \
                all(w.literal for w in seg.argv):
            KNOWN["@"] = KNOWN["*"] = [str(w) for w in seg.argv[2:]]
            for k, w in enumerate(seg.argv[2:], 1):
                KNOWN[str(k)] = [str(w)]
        if seg.argv and seg.argv[0] == "read":
            names = [w for w in seg.argv[1:] if not w.startswith("-")]
            here = next((t for op, t in seg.redirs if op == "<<<"), None)
            if names and here is not None and here.literal:
                parts = str(here).split()
                for k, nm in enumerate(names):
                    KNOWN[nm] = [" ".join(parts[k:])] if k == len(names) - 1 else parts[k:k + 1]


def resolve(name):
    """[words] a parameter expands to from KNOWN, or None when it was not assigned literally."""
    base = re.sub(r"\[[@*]\]$", "", name)
    return KNOWN.get(base) if base in KNOWN else None


def shlex_quote(word):
    return "'" + str(word).replace("'", "'\\''") + "'"


def literal_output(seg, substs):
    """What a command writes to stdout when the guard can tell without running it: `echo` or
    `printf` of literal words, `cat` of a heredoc or here-string; else None."""
    if not seg.argv or not all(w.literal for w in seg.argv):
        return None
    prog, args = os.path.basename(seg.argv[0]), list(seg.argv[1:])
    if prog == "echo":
        escapes = False
        while args and re.fullmatch(r"-[neE]+", args[0]):
            escapes = escapes or "e" in args[0]
            args = args[1:]
        text = " ".join(args)
        return text.encode().decode("unicode_escape", "replace") if escapes else text
    if prog == "printf" and args:
        fmt = args[0].encode().decode("unicode_escape", "replace")
        try:
            return fmt % tuple(args[1:]) if "%" in fmt and args[1:] else fmt
        except (TypeError, ValueError):
            return fmt + " " + " ".join(args[1:])
    if prog == "cat" and not args:
        source = stdin_of(seg, substs)
        return source[1] if source and source[0] == "literal" else None
    return None


def stdin_of(seg, substs):
    """Where a command's stdin comes from: ("literal", text), ("opaque", what), or None."""
    for op, target in seg.redirs:
        if op in ("<<", "<<-"):
            return ("literal", op.body or "")
        if op == "<<<":
            return ("literal", str(target)) if target.literal else \
                ("opaque", "a here-string that expands")
        if op == "<":
            m = PLACEHOLDER.fullmatch(target)
            if m and SUBSTS[int(m.group(1))][0] == "in":
                return producer(SUBSTS[int(m.group(1))][1])
            return ("opaque", "the file %s" % target)
    if seg.pipe_from is not None:
        text = literal_output(seg.pipe_from, substs)
        return ("literal", text) if text is not None else ("opaque", "the output of %s" % (
            seg.pipe_from.argv[0] if seg.pipe_from.argv else "a pipe"))
    return None


def producer(body, substs=None):
    """The stdin a process substitution `<(body)` gives: literal when body is one echo,
    printf or cat of a literal."""
    inner = []
    segs = segments(lex(body, inner))
    text = literal_output(segs[0], inner) if len(segs) == 1 else None
    return ("literal", text) if text is not None else \
        ("opaque", "the output of <(%s)" % body.strip())


def code_from(source, cwd, depth, what):
    """A shell is handed code: read it when it is literal. Code that is not (`sed ... | bash`,
    `source <(sed ...)`, `bash < file`) is a documented limit, like an interpreter's code: it
    runs, and the sandbox having no credentials is the floor."""
    if source is None or source[0] != "literal":
        return None
    why = classify(source[1], cwd, depth + 1)
    return "%s runs %s" % (what, why) if why else None


def nested(text, cwd, depth, what):
    """Code given as a string (to eval, trap, `bash -c`, alias, ...): read it, unless it is
    only a substitution's output (`eval "$(sed ...)"`), a documented limit."""
    if PLACEHOLDER.fullmatch(str(text).strip()):
        return None
    why = classify(str(text), cwd, depth + 1)
    return "%s runs %s" % (what, why) if why else None


def unwrap(argv, value_opts):
    """argv after a wrapper's own options."""
    rest, skip = argv[1:], False
    while rest:
        tok = rest[0]
        if skip:
            skip = False
        elif tok == "--":
            rest = rest[1:]
            break
        elif tok.startswith("-") or ASSIGNMENT.match(tok):
            skip = tok in value_opts
        else:
            break
        rest = rest[1:]
    return rest


def classify_argv(argv, cwd, depth, stdin=None, substs=()):
    while argv and ASSIGNMENT.match(argv[0]):
        argv = argv[1:]
    if not argv:
        return None
    if "$(" in argv[0] or "`" in argv[0]:
        raise Unreadable("its command word is computed by a substitution")
    prog = TOOL_ALIASES.get(re.sub(r"(?<=.)@[^/]*$", "", argv[0]),
                            os.path.basename(re.sub(r"(?<=.)@[^/]*$", "", argv[0])))
    if any(a in SAFE_FLAGS or a.split("=", 1)[0] in SAFE_FLAGS for a in argv[1:]):
        return None  # a dry run, a check, or help
    if prog == "alias":  # `alias p='npm publish'`: the alias is read where it is defined
        for a in argv[1:]:
            why = nested(a.split("=", 1)[1], cwd, depth, "alias") if "=" in a else None
            if why:
                return why
        return None
    if prog == "eval":
        if any(PLACEHOLDER.fullmatch(a) for a in argv[1:]):
            return None  # `eval "$(sed ...)"`: code from a substitution, a documented limit
        return nested(" ".join(argv[1:]), cwd, depth, "eval")
    if prog == "trap" and len(argv) > 1 and not argv[1].startswith("-"):
        return nested(argv[1], cwd, depth, "trap")  # the trap's action is code the shell runs
    if argv[0] in (".", "source"):
        src = argv[1] if len(argv) > 1 else ""
        m = PLACEHOLDER.fullmatch(src)
        if m and SUBSTS[int(m.group(1))][0] == "in":
            return code_from(producer(SUBSTS[int(m.group(1))][1], substs), cwd, depth, argv[0])
        if src in ("/dev/stdin", "/proc/self/fd/0", "-"):
            return code_from(stdin or ("opaque", "stdin"), cwd, depth, argv[0])
        return "sources %s" % src if scripted(src) else None
    if prog == "env" and any(a in ("-S", "--split-string") or a.startswith("-S") for a in argv[1:2]):
        payload = argv[2] if argv[1] in ("-S", "--split-string") and len(argv) > 2 else argv[1][2:]
        return nested(payload + " " + " ".join(argv[3:]), cwd, depth, "env -S")
    if prog in WRAPPERS:
        rest = unwrap(argv, WRAPPERS[prog])
        if prog == "xargs" and rest and releaser(rest[0]) and \
                os.path.basename(rest[0]) not in SHELLS:
            repl = next((a[2:] or (argv[k + 1] if k + 1 < len(argv) else "") for k, a in
                         enumerate(argv) if a.startswith("-I")), None) or \
                ("{}" if any(a.startswith(("-i", "--replace")) for a in argv) else None)
            first = positionals(rest[1:])[:1]
            if not first or (repl and repl in first[0]):
                return "xargs gives %s arguments the guard cannot see" % rest[0]
        if prog == "timeout" and rest and re.match(r"^[\d.]+[smhd]?$", rest[0]):
            rest = rest[1:]
        if prog == "watch":
            return nested(" ".join(rest), cwd, depth, "watch")
        if prog == "flock":
            if "-c" in argv or "--command" in argv:
                at = argv.index("-c") if "-c" in argv else argv.index("--command")
                return nested(argv[at + 1], cwd, depth, "flock") if at + 1 < len(argv) else None
            rest = rest[1:]  # the lock file
        if prog == "taskset" and not any(a in ("-c", "--cpu-list") for a in argv[1:]):
            rest = rest[1:]  # the CPU mask
        if prog == "chrt" and rest and re.fullmatch(r"\d+", rest[0]):
            rest = rest[1:]  # the priority
        return classify_argv(rest, cwd, depth, stdin, substs)
    if prog == "find":
        for i, tok in enumerate(argv):
            if tok in ("-exec", "-execdir", "-ok", "-okdir"):
                end = next((j for j in range(i + 1, len(argv)) if argv[j] in (";", "+", "\\;")), len(argv))
                why = classify_argv(argv[i + 1:end], cwd, depth)
                if why:
                    return why
        return None
    if prog == "parallel":
        cmd = [t for t in argv[1:] if not t.startswith("-")]
        if cmd[:1] == [":::"]:  # no command: each argument is one (`parallel ::: 'npm publish'`)
            for a in cmd[1:]:
                why = nested(a, cwd, depth, "parallel")
                if why:
                    return why
            return None
        cmd = cmd[:cmd.index(":::")] if ":::" in cmd else cmd
        return nested(" ".join(cmd), cwd, depth, "parallel") if cmd else None
    if prog == "script":
        for i, tok in enumerate(argv[1:], 1):
            if (tok == "--command" or re.fullmatch(r"-[a-zA-Z]*c[a-zA-Z]*", tok)) and i + 1 < len(argv):
                return nested(argv[i + 1], cwd, depth, "script")
        return None
    for n in (3, 2, 1):
        if tuple(argv[:n]) in RUNNERS:
            rest = argv[n:]
            while rest and rest[0].startswith("-"):
                rest = rest[1:]
            return classify_argv(rest, cwd, depth, stdin, substs)
    if prog in SHELLS:
        for i, tok in enumerate(argv[1:], 1):
            if re.match(r"^-[a-z]*c[a-z]*$", tok):
                rest = argv[i + 1:]
                rest = rest[1:] if rest[:1] == ["--"] else rest
                return nested(rest[0], cwd, depth, prog) if rest else None
        if any(re.match(r"^-[a-z]*n[a-z]*$", t) for t in argv[1:]):
            return None  # `bash -n`: a syntax check
        script = next((t for t in argv[1:] if not t.startswith("-")), None)
        m = PLACEHOLDER.fullmatch(script or "")
        if m and SUBSTS[int(m.group(1))][0] == "in":  # `bash <(...)`
            return code_from(producer(SUBSTS[int(m.group(1))][1], substs), cwd, depth, prog)
        if script is None or "-s" in argv[1:]:  # the shell reads its code from stdin
            return code_from(stdin, cwd, depth, prog)
        return "runs %s" % script if scripted(script) else None
    if INTERPRETERS.match(prog):
        return interpreter(prog, argv[1:], cwd, depth)
    if "/" in argv[0] and scripted(argv[0]):
        return "runs %s" % argv[0]
    if prog in SAFE:
        return None
    hit = [f for f in argv[1:] if f in FLAGS or f.split("=", 1)[0] in FLAGS
           or "type=registry" in f or "push=true" in f]
    if hit:
        return "%s with %s" % (prog, hit[0])
    if prog in PMS:
        return pm(argv, cwd, depth)
    if prog in TASK_RUNNERS:
        return task_runner(prog, argv, cwd)
    if prog in SUBCOMMANDS:
        return subcommand(prog, argv)
    pos = positionals(argv[1:])
    if pos and pos[0] in WORDS + ("push", "upload") and not a_path(pos[0], cwd):
        return "%s %s" % (prog, pos[0])  # an unknown tool told to release
    return carried(argv, cwd, depth)


def carried(argv, cwd, depth):
    """A release an unknown program would run for us: a release-capable tool among its
    arguments with that tool's release verb (`ltrace npm publish`, `op run -- npm publish`),
    or one in an argument that is itself a command line: one given to an option (`nodemon
    --exec 'npm publish'`, `su -c '...'`), or any argument of a known command runner
    (`concurrently 'npm publish'`, `hyperfine '...'`). Elsewhere a quoted command is data: a
    work-order function's check string, a commit message."""
    runner = os.path.basename(argv[0]) in CODE_RUNNERS
    for k, a in enumerate(argv[1:], 1):
        if releaser(a) and not os.path.basename(a) in SHELLS:
            why = classify_argv(argv[k:], cwd, depth + 1)
            if why:
                return "%s runs %s" % (os.path.basename(argv[0]), why)
        elif (runner or argv[k - 1].startswith("-")) and \
                re.match(r"\s*([A-Za-z_]\w*=\S*\s+)*(%s)\s" % "|".join(
                re.escape(t) for t in sorted(RELEASE_TOOLS)), a):  # an argument that IS a command
            try:
                why = classify(a, cwd, depth + 1)
            except Unreadable:
                why = None  # an argument that is not shell code
            if why:
                return "%s runs %s" % (os.path.basename(argv[0]), why)
    return None


RELEASE_TOOLS = set()  # filled below: every tool the guard knows can release
# Programs whose plain arguments are command lines they run.
CODE_RUNNERS = {"concurrently", "hyperfine", "npm-run-all", "run-p", "run-s", "watchexec",
                "nodemon", "entr", "parallel", "tmux", "screen", "xterm", "kitty", "alacritty",
                "foot", "wezterm", "ghostty", "gnome-terminal", "konsole", "dtach", "abduco",
                "faketime", "firejail", "proot", "chroot", "systemd-run", "runuser", "su",
                "pkexec", "machinectl"}


def releaser(cmd):
    """True for a tool the guard knows can release, by its command word alone."""
    prog = os.path.basename(cmd)
    return prog in PMS or prog in SUBCOMMANDS or prog in TASK_RUNNERS or \
        prog in {r[0] for r in RUNNERS} or prog in SHELLS or bool(INTERPRETERS.match(prog))


def interpreter(prog, rest, cwd, depth):
    if rest[:1] == ["-m"] and len(rest) > 1:
        return None if rest[1] == "py_compile" else classify_argv(rest[1:], cwd, depth)
    if rest[:1] and rest[0] in ("-c", "-e", "--eval", "-p", "--print", "--check", "-n"):
        return None  # code given inline (a documented limit), or a syntax check
    if prog == "deno" and rest[:1] and rest[0] != "run":
        return subcommand("deno", ["deno"] + rest)
    script = next((t for t in rest if not t.startswith("-")), None)
    if script == "run":  # `deno run x.ts`, `bun run x`
        script = next((t for t in rest[rest.index("run") + 1:] if not t.startswith("-")), None)
    if script and scripted(script):
        return "runs %s" % script
    if prog.startswith("bun") and script and not re.search(r"[./]", script):
        return pm(["bun"] + rest, cwd, depth)  # `bun test`, `bun run x`: a package manager
    return None


def opaque_verb(word):
    """True when a word in a release-capable tool's verb position could expand into a verb the
    guard cannot see: a substitution, a brace list, a glob, or a variable mixed with text. A
    word that is only one variable is resolved by `verb_words` instead."""
    if VAR_ONLY.fullmatch(str(word)):
        return False
    return not getattr(word, "literal", True) or \
        bool(re.search(r"[*?\[(|#~^]|\{[^{}]*,", getattr(word, "bare", str(word))))


VAR_ONLY = re.compile(r"\$(\{[^}]*\}|[A-Za-z_]\w*|[@*#?$!0-9-])")


def verb_words(argv):
    """argv with a verb-position word that is only a literally-assigned variable replaced by
    its value (`v=publish; npm $v`); an unassigned one (a function's "$@") stays: a limit."""
    out = []
    for w in argv:
        m = VAR_ONLY.fullmatch(str(w))
        words = resolve(m.group(1).strip("{}")) if m else None
        out += [Word(x) for x in words] if words is not None else [w]
    return out


def subcommand(prog, argv):
    argv = verb_words(argv)
    verbs, depth_n, value_opts = SUBCOMMANDS[prog]
    if verbs is None:
        return "%s releases" % prog
    first = positionals(argv[1:], value_opts)[:1]
    if first and opaque_verb(first[0]):
        raise Unreadable("%s's subcommand %r expands" % (prog, str(first[0])))
    if prog == "git":
        for i, tok in enumerate(argv[1:-1], 1):
            if tok == "-c" and argv[i + 1].lower().startswith("protocol."):
                return "git -c %s overrides the replay's transport block" % argv[i + 1]
            m = re.match(r"(?i)alias\.[^=]+=\s*!(.*)", argv[i + 1], re.S) if tok == "-c" else None
            if m:  # a shell alias: `git -c alias.p='!npm publish' p`
                why = nested(m.group(1), None, 0, "a git alias")
                if why:
                    return why
    pos = positionals(argv[1:], value_opts)
    found = [t for t in pos[:depth_n] if t in verbs]
    if prog == "cargo" and pos[:1] == ["workspaces"] and pos[1:2] and pos[1] in ("publish", "release"):
        found = [pos[1]]
    if prog == "aws" and not found and pos[:2] == ["s3", "cp"] and pos[-1].startswith("s3://"):
        found = ["s3 cp"]
    if prog == "gsutil" and not found and pos[:1] == ["cp"] and pos[-1].startswith("gs://"):
        found = ["cp"]
    if prog == "goreleaser" and pos[:1] not in (["check"], ["build"], ["init"], ["healthcheck"]):
        found = ["release"]
    return "%s %s" % (prog, found[0]) if found else None


def task_runner(prog, argv, cwd):
    """make, just, task, rake, mage, turbo, nx, gradle: a target or task named for a release."""
    pos = positionals(argv[1:], TASK_RUNNERS[prog])
    targets = [t for t in argv[1:] if t.startswith(("--target=", "-t="))]
    targets = [t.split("=", 1)[1] for t in targets] + pos
    if prog in ("turbo", "nx") and pos[:1] in (["run"], ["run-many"]):
        targets = pos[1:] + targets
    if prog == "nx" and pos[:1] and pos[0] in ("release", "deploy", "publish"):
        return "nx %s" % pos[0]
    if prog in ("gradle", "gradlew"):
        hit = [t for t in targets if t.split(":")[-1].lower().startswith("publish")]
    else:
        hit = [t for t in targets if scripted(t.split(":")[-1]) or scripted(t)]
    return "%s %s" % (prog, hit[0]) if hit else None


def pm(argv, cwd=None, depth=0):
    """npm, pnpm, yarn, bun: their publish subcommands (and npm's abbreviations of them), a `run`
    of a release script, a script run by name (yarn/pnpm/bun) named so, and what their own
    runners (`exec`, `dlx`, `x`, `workspaces foreach`) run."""
    argv = verb_words(argv)
    pos = positionals(argv[1:], PM_VALUE_OPTS, past_dashdash=True)
    if not pos:
        return None
    if opaque_verb(pos[0]):
        raise Unreadable("%s's command %r expands" % (argv[0], str(pos[0])))
    for p in pos[:3]:  # an unknown option's value may come first: `npm --foo bar publish`
        if PM_RELEASE.match(p):
            return "%s %s" % (argv[0], p)
        if p in PM_BUILTINS or p in ("run", "run-script", "exec", "dlx", "x", "workspace",
                                     "workspaces", "npm"):
            break
    sub = next((p for p in pos[:3] if p in PM_BUILTINS or p in (
        "run", "run-script", "exec", "dlx", "x", "workspace", "workspaces", "npm")), pos[0])
    after = argv[argv.index(sub) + 1:] if sub in argv else []
    if sub in ("run", "run-script"):
        script = positionals(after)
        return "%s run %s" % (argv[0], script[0]) if script and scripted(script[0]) else None
    if sub in ("exec", "dlx", "x"):
        rest = after
        while rest and rest[0].startswith("-"):
            rest = rest[1:]
        return classify_argv(rest, cwd, depth + 1)
    if sub == "workspace" and len(positionals(after)) > 1:
        return pm([argv[0]] + after[after.index(positionals(after)[0]) + 1:], cwd, depth)
    if sub == "workspaces" and "foreach" in after:
        rest = after[after.index("foreach") + 1:]
        while rest and rest[0].startswith("-"):
            rest = rest[1:]
        return pm([argv[0]] + rest, cwd, depth)
    if sub == "npm" and len(pos) > 1 and PM_RELEASE.match(pos[1]):
        return "%s npm %s" % (argv[0], pos[1])
    if sub in PM_BUILTINS:
        return None
    if scripted(sub):  # `yarn deploy`, `pnpm publish:site`, `pnpm release`
        return "%s %s" % (argv[0], sub)
    if argv[0] != "npm":  # pnpm/yarn/bun run a package bin by name: `pnpm changeset publish`
        return classify_argv(argv[argv.index(sub):], cwd, depth + 1)
    return None


_WRAPPER = re.compile(r"^(?:[A-Za-z_][A-Za-z0-9_]*=(?:'[^']*'|\"[^\"]*\"|\S*)\s+|timeout\s+"
                      r"(?:-k\s+\S+\s+)?\S+\s+|nice\s+|env\s+)+")


def glob_hit(cmd, patterns):
    """The first glob deny pattern (`git push`, `curl`, `git -C * push*`) matching a subcommand
    of `cmd`, or None: an EMULATION of Claude Code's Bash rule matcher. The command is split at
    ; && || | newlines and $( ` ( ); each part is tried as written and without leading
    VAR=value / timeout / nice / env; a pattern with `*` must match the whole part, one without
    matches it or a prefix ending at a space. Used for Monitor, which Claude Code's Bash rules
    may not cover, and by `bin/loop deny-check`."""
    import fnmatch
    for part in re.split(r"&&|\|\||;|\||\n|\$\(|`|\(|\)", cmd):
        part = part.strip()
        for form in dict.fromkeys((part, _WRAPPER.sub("", part))):
            for pat in patterns:
                if ("*" in pat and fnmatch.fnmatchcase(form, pat.replace("[", "[[]").replace("?", "[?]"))) \
                        or form == pat or form.startswith(pat + " "):
                    return pat
    return None


RELEASE_TOOLS.update(PMS, SUBCOMMANDS, TASK_RUNNERS, {r[0] for r in RUNNERS}, TOOL_ALIASES)


def selftest(command):
    """Markers `bin/loop deny-check --live` uses to prove the guard fails closed."""
    if "LOOP_GUARD_SELFTEST_CRASH" in command:
        os._exit(70)  # a crash with no output: `|| exit 2` must still block
    if "LOOP_GUARD_SELFTEST_HANG" in command:
        signal.pause()  # past DEADLINE: the alarm must still deny


def deny(why):
    print(json.dumps({"hookSpecificOutput": {
        "hookEventName": "PreToolUse", "permissionDecision": "deny",
        "permissionDecisionReason": "Denied by the replay's release guard: %s. A replay never "
                                    "publishes, deploys or releases." % why}}), flush=True)
    os._exit(0)


def main():
    signal.signal(signal.SIGALRM, lambda *_: deny("it did not decide within %ds" % DEADLINE))
    signal.alarm(DEADLINE)
    try:
        payload = json.load(sys.stdin)
        if payload.get("tool_name") not in ("Bash", "Monitor"):
            return 0
        command = str((payload.get("tool_input") or {}).get("command") or "")
        selftest(command)
        why = classify(command, payload.get("cwd"))
        if not why and payload.get("tool_name") == "Monitor" and len(sys.argv) > 1:
            with open(sys.argv[1], encoding="utf-8") as fh:  # the Bash deny globs, for Monitor
                hit = glob_hit(command, [p[:-2] if p.endswith(":*") else p for p in json.load(fh)])
            why = "Monitor runs %r, denied for Bash" % hit if hit else None
    except Unreadable as e:
        why = "it cannot read this command: %s" % e
    except Exception as e:  # FAIL CLOSED: what cannot be read is not run
        why = "it could not read this command (%s)" % e.__class__.__name__
    if why:
        deny(why)
    return 0


if __name__ == "__main__":
    sys.exit(main())
