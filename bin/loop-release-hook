#!/usr/bin/env python3
"""The review loop's release guard: a PreToolUse hook on Bash and Monitor in every replay.

It denies a command that would PUBLISH, DEPLOY, RELEASE, PUSH or UPLOAD something, decided from
the command's tokens, never from a substring: `pnpm test -- deploy.spec.ts`, `cargo test publish`
and `grep -rn publish .` run; `pnpm -r publish`, `npm run release`, `scripts/deploy.sh` and
`docker buildx build --push .` do not. It replaced the `*publish*` / `*deploy*` glob rules
(2026-10-15), which denied paths that only contained the word and still missed real releases.

WHAT IT IS NOT. The replay's sandbox holds no credentials; that is the floor. This is a second
layer, and a wrong deny distorts what the loop measures more than a narrow leak does, so it reads
commands the way a shell does and denies only a release it can see. Code an interpreter runs
(`python -c`, `node -e`, `... | bash`, `bash < file`) is not read: a documented limit.

Input: the hook's JSON on stdin. Output: a PreToolUse `deny` decision on stdout, or nothing.
FAILS CLOSED: a command it cannot parse, any error of its own, or running past its own
`DEADLINE` is denied; bin/loop runs it as `python3 -I ... || exit 2`, so a crash or a missing
file blocks the call too.

`classify(command, cwd)` returns the reason a command is denied, or None. `bin/loop deny-check`
runs this file, as the replay does, over fixtures/loop/deny-commands.txt.
"""
import json
import os
import re
import shlex
import signal
import sys

DEADLINE = 10  # seconds; Claude Code's own hook timeout lets the call through, so decide first
WORDS = ("publish", "deploy", "release")
NOT_A_RELEASE = {"check", "checks", "test", "tests", "spec", "lint", "notes", "dry", "dryrun",
                 "preview", "plan", "validate", "verify", "config", "utils", "util", "helpers",
                 "lib", "docs", "status", "list", "diff", "local", "template"}
SAFE_FLAGS = {"--dry-run", "--dryrun", "--help", "--version", "--check", "--syntax-check",
              "--list-tasks", "--list-hosts", "--plan", "--noop", "--what-if"}
FLAGS = {"--prod", "--production", "--push"}
OPERATORS = {";", "&&", "||", "|", "&", "(", ")", "|&", ";;", "{", "}"}
REDIRECTS = re.compile(r"^\d*(>|>>|<|<<<|>&|<&|&>|&>>|>\|)$")
ASSIGNMENT = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*=")
KEYWORDS = {"if", "then", "else", "elif", "fi", "do", "done", "while", "until", "!", "time",
            "builtin", "command", "exec", "{", "}", "coproc"}
DATA_KEYWORDS = {"for", "select", "case", "function", "esac", "in"}
# Wrappers that run the rest of their arguments as a command, and their options with a value.
WRAPPERS = {
    "env": {"-u", "--unset", "-C", "--chdir"}, "nice": {"-n", "--adjustment"},
    "nohup": set(), "stdbuf": {"-i", "-o", "-e"}, "ionice": {"-c", "-n", "-p", "--class"},
    "timeout": {"-s", "--signal", "-k", "--kill-after"}, "caffeinate": set(), "doas": {"-u"},
    "sudo": {"-u", "-g", "-C", "-D", "-h", "-p", "-U"}, "chrt": set(), "taskset": set(),
    "setsid": set(), "unbuffer": set(), "flock": {"-w", "-E"}, "watch": {"-n", "--interval", "-d"},
    "xargs": {"-I", "-i", "-n", "-P", "-L", "-l", "-d", "-E", "-s", "-a", "--max-args",
              "--max-procs", "--delimiter", "--arg-file", "--replace"},
}
RUNNERS = {("uv", "tool", "run"), ("npx",), ("bunx",), ("pnpx",), ("uvx",), ("pnpm", "dlx"), ("pnpm", "exec"),
           ("yarn", "dlx"), ("yarn", "exec"), ("npm", "exec"), ("npm", "x"), ("bun", "x"),
           ("uv", "run"), ("poetry", "run"), ("pipx", "run"), ("pdm", "run"), ("hatch", "run"),
           ("rye", "run"), ("mise", "exec"), ("bundle", "exec"), ("corepack",)}
SHELLS = {"bash", "sh", "zsh", "dash", "ksh", "fish"}
INTERPRETERS = re.compile(r"^(python[\d.]*|pypy[\d.]*|node|nodejs|ruby|perl|php|tsx|ts-node|"
                          r"bun|deno|Rscript|lua|osascript)$")
PMS = {"npm", "pnpm", "yarn", "bun"}
PM_RELEASE = re.compile(r"^(pub(l(i(sh?)?)?)?|unpub\w*|dist-tag|deprecate|owner)$")
PM_VALUE_OPTS = {"--filter", "-F", "--dir", "-C", "-w", "--workspace", "--prefix", "--cwd",
                 "--registry", "--tag", "--otp", "--access", "--reporter", "--loglevel",
                 "--userconfig", "--cache", "-c", "--config", "--scope", "--workspace-root"}
PM_BUILTINS = {"install", "i", "add", "remove", "rm", "uninstall", "update", "up", "upgrade",
               "test", "t", "tst", "build", "ci", "ls", "list", "outdated", "audit", "why",
               "init", "create", "link", "unlink", "pack", "view", "info", "show", "config",
               "start", "stop", "restart", "version", "help", "store", "prune", "dedupe",
               "rebuild", "fund", "doctor", "cache", "env", "root", "bin", "explain", "query",
               "search", "whoami", "login", "logout", "import", "patch", "patch-commit",
               "licenses", "setup", "fetch", "recursive", "dev", "lint", "format", "typecheck",
               "check", "tsc", "vitest", "jest", "node", "outdated", "approve-builds"}
# Tools whose subcommand decides: tool -> (release verbs, how many leading positionals to look
# at, options of theirs that take a value). None verbs: the tool only releases.
SUBCOMMANDS = {
    "gcloud": ({"deploy"}, 4, {"--project", "--region", "--account", "--configuration"}),
    "aws": ({"deploy", "sync", "put-object", "publish", "update-function-code",
