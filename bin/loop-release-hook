    "git": ({"push", "send-email", "request-pull"}, 1, {"-C", "-c", "--git-dir", "--work-tree"}),
    "gh": ({"release", "pr", "repo", "workflow", "api", "gist", "secret"}, 1, {"-R", "--repo"}),
