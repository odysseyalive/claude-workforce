    "terraform": ({"apply", "destroy", "import"}, 1, set()), "tofu": ({"apply", "destroy"}, 1, set()),
    "pulumi": ({"up", "destroy", "update"}, 1, {"-C", "--cwd", "-s", "--stack"}),
    "cdk": ({"deploy", "destroy"}, 1, {"--profile", "-a", "--app"}),
    "sls": ({"deploy", "remove"}, 1, set()), "serverless": ({"deploy", "remove"}, 1, set()),
    "sst": ({"deploy", "remove"}, 1, set()), "sam": ({"deploy", "publish", "sync"}, 1, set()),
    "kamal": ({"deploy", "redeploy", "rollback", "setup"}, 1, set()),
    "cap": ({"deploy"}, 3, set()), "supabase": ({"deploy", "push"}, 3, set()),
    "render": ({"deploy"}, 2, set()), "amplify": ({"publish", "push"}, 1, set()),
    "firebase": ({"deploy"}, 1, {"--project", "-P"}), "netlify": ({"deploy"}, 1, set()),
    "wrangler": ({"deploy", "publish"}, 2, set()), "railway": ({"up", "deploy"}, 1, set()),
    "fly": ({"deploy"}, 1, set()), "flyctl": ({"deploy"}, 1, set()),
    "twine": ({"upload", "register"}, 1, set()), "hatch": ({"publish"}, 1, set()),
    "flit": ({"publish"}, 1, set()), "poetry": ({"publish"}, 1, set()),
    "uv": ({"publish"}, 1, {"--directory", "--project"}),
    "cargo": ({"publish", "yank", "owner", "release"}, 1, {"-p", "--package", "-Z", "--manifest-path"}),
    "lerna": ({"publish", "version"}, 1, set()), "changeset": ({"publish"}, 1, set()),
    "changesets": ({"publish"}, 1, set()), "deno": ({"publish"}, 1, set()),
    "vsce": ({"publish"}, 1, set()), "ovsx": ({"publish"}, 1, set()), "jsr": ({"publish"}, 1, set()),
    "dart": ({"publish"}, 2, set()), "flutter": ({"publish"}, 2, set()),
    "mix": ({"hex.publish"}, 1, set()), "gem": ({"push", "yank", "owner"}, 1, set()),
    "dotnet": ({"push"}, 2, set()), "nuget": ({"push"}, 1, set()),
