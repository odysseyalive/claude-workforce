#!/usr/bin/env python3
"""
Mirror the source distribution into the runtime copy, exactly as the installers do.

    python3 bin/sync            # or: bin/sync   -> the project runtime
    bin/sync --personal        # ALSO refresh ~/.claude/skills/workforce
    bin/sync --force           # discard runtime-first edits instead of refusing

claude-workforce has a THREE-copy tree, and the third is the one that resolves:

    workforce/                     the SOURCE distribution — what ships
    .claude/skills/workforce/      the RUNTIME copy — what a session here loads
    ~/.claude/skills/workforce/    the PERSONAL install — SHADOWS the runtime

Edit source, then run this. Never edit the runtime copy: it is
overwritten every sync, and source-first is a directive inherited from
claude-enforcer, where reverse-order edits repeatedly landed in the runtime and
were lost.

WHY `--personal` EXISTS, and why it is a flag rather than the default. Skills resolve
personal before project, so the personal install shadows everything this script builds
and goes stale the moment source changes. `bin/check` fails on that drift and names two
remedies — and MEASURED 2026-08-04, in maintainer mode BOTH are wrong:

  "re-run the installer"        `install` fetches from raw.githubusercontent.com/main.
                                With unpushed local changes it overwrites the personal
                                install with the PUBLISHED version — it looks like a
                                successful refresh and installs stale code.
  "delete the personal install" the project runtime only exists inside this repo, so
                                deleting it removes `/workforce` from every OTHER
                                project on the machine.

The gap was blocking, not cosmetic: `bin/prove` refuses on a red baseline, and this
drift IS a red baseline — so the project's proof-by-breaking discipline had no working
tool behind it again, for the second recorded time, from a different cause.

It stays a FLAG because CLAUDE.md is right that aiming a delete-then-rebuild outside
the repo is not a default worth having. A deliberate gesture is exactly what the
doctrine asked for; what was missing was any gesture at all.

This reads manifest.txt, so it fails the same way an installer would if the
manifest and the tree disagree — which is the point. `bin/check` asserts that
agreement separately.
"""

import os
import shutil
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
os.chdir(ROOT)

DEST_ROOT = ".claude/skills/workforce"
# $CLAUDE_CONFIG_DIR relocates the whole ~/.claude tree (scopes.md § Installing into a
# specific CLAUDE_CONFIG_DIR); --personal must refresh the copy the running session
# actually resolves. Unset, this is exactly ~/.claude/skills/workforce.
_CONFIG_ROOT = os.environ.get("CLAUDE_CONFIG_DIR") or os.path.expanduser("~/.claude")
PERSONAL_ROOT = os.path.join(_CONFIG_ROOT, "skills", "workforce")
PREFIX = "workforce/"

argv = sys.argv[1:]
personal = "--personal" in argv
for a in argv:
    if a not in ("--personal", "--force"):
        sys.exit(f"unknown argument {a!r}\nusage: bin/sync [--personal] [--force]")

if not os.path.isfile("manifest.txt"):
    sys.exit("no manifest.txt — run from the repo root")

# REFUSE to delete-then-rebuild a path that is not a workforce install. This script
# removes its target outright, and `--personal` is the one mode that aims that outside
# the repo — so the target is identified before it is destroyed, never after.
if personal and os.path.exists(PERSONAL_ROOT) and not os.path.isfile(
        os.path.join(PERSONAL_ROOT, "SKILL.md")):
    sys.exit(f"REFUSING — {PERSONAL_ROOT} exists but has no SKILL.md, so it is not a "
             f"workforce install. Nothing was removed.")

targets = [DEST_ROOT] + ([PERSONAL_ROOT] if personal else [])


def manifest_entries():
    """Every shipped source path, with its executable flag. Parsed BEFORE anything is
    removed, because the runtime-first scan below has to read the copies this script
    is about to delete."""
    out, bad = [], []
    for line in open("manifest.txt", encoding="utf-8"):
        s = line.strip()
        if not s or s.startswith("#"):
            continue
        executable = False
        for flag in ("exec ", "hook "):
            if s.startswith(flag):
                s = s[len(flag):].strip()
                executable = True
                break
        if s.startswith("canary "):
            s = s[len("canary "):].strip()
            if not os.path.isfile(s):
                bad.append(f"{s} (declared canary, not on disk)")
            continue
        if not s.startswith(PREFIX):
            bad.append(f"{s} (path does not start with {PREFIX!r})")
            continue
        if not os.path.isfile(s):
            bad.append(f"{s} (declared, not on disk)")
            continue
        out.append((s, executable))
    return out, bad


ENTRIES, missing = manifest_entries()

# ── REFUSE to destroy a runtime-first edit ───────────────────────────────────
# This script is delete-then-rebuild, so every byte in a target that is not in source
# is gone the moment it runs. The docstring says "never edit the runtime copy" — and a
# directive is not a mechanism. MEASURED 2026-08-10: a session edited
# `references/procedures/intent-router.md` in the personal install, source was never
# updated, and a later sync deploying an unrelated fix would have deleted it. It
# survived only because a human diffed the file by hand first, having no reason to
# beyond suspicion.
#
# `bin/check` reported that file as "drifted" and could not say which side was newer,
# so its output read IDENTICALLY whether a sync was about to deploy a fix or destroy
# one. Detection that cannot tell those apart is not detection.
#
# MTIME IS THE SIGNAL AND IT IS SOUND HERE, because `shutil.copy2` below preserves it:
# immediately after a sync a target file and its source share a timestamp exactly. A
# target NEWER than its source therefore means the target was written after the last
# sync — which is the definition of a runtime-first edit. Equal mtimes with differing
# content cannot be ordered and are reported as UNDATED rather than guessed at.
def runtime_first_edits():
    out = []
    for src, _x in ENTRIES:
        rel = src[len(PREFIX):]
        for target in targets:
            dest = os.path.join(target, rel)
            if not os.path.isfile(dest):
                continue
            try:
                with open(dest, "rb") as fh:
                    dest_bytes = fh.read()
                with open(src, "rb") as fh:
                    src_bytes = fh.read()
                if dest_bytes == src_bytes:
                    continue
                dest_mtime = os.stat(dest).st_mtime
                src_mtime = os.stat(src).st_mtime
            except OSError:
                continue
            if dest_mtime > src_mtime:
                out.append((dest, src, "NEWER than source"))
            elif dest_mtime == src_mtime:
                out.append((dest, src, "same mtime, different content — UNDATED"))
    return out


_ahead = runtime_first_edits()
if _ahead and "--force" not in argv:
    print("REFUSING — a runtime copy holds edits that are not in source.")
    print("This script deletes each target and rebuilds it from the manifest, so these")
    print("would be destroyed, not merged:\n")
    for dest, src, why in _ahead:
        print(f"  ✗ {dest}\n      {why}\n      source: {src}")
    print("\nPromote each one into source first — `cp <runtime> <source>` — then re-run.")
    print("That preserves the work and makes source the record, which is what")
    print("source-first means. `--force` discards them, and is never the fix for a file")
    print("you have not read.")
    sys.exit(2)
if _ahead:
    print(f"--force: DISCARDING {len(_ahead)} runtime-first edit(s):")
    for dest, _src, why in _ahead:
        print(f"  ! {dest}  ({why})")
    print()

for t in targets:
    if os.path.isdir(t):
        shutil.rmtree(t)

copied = 0

# The manifest flags — `exec`, `hook`, `canary` — and the on-disk checks are handled
# once, in `manifest_entries()` above, because the runtime-first scan needs the parsed
# list before anything is deleted. manifest.txt says re-adding a flag means re-adding
# its handling to bin/check AND bin/sync in the same change; that handling now has one
# home in this file rather than being inlined in the copy loop.
for s, executable in ENTRIES:
    for target in targets:
        dest = os.path.join(target, s[len(PREFIX):])
        os.makedirs(os.path.dirname(dest), exist_ok=True)
        # copy2 preserves mtime, which is what makes the runtime-first scan above
        # sound: a fresh copy and its source share a timestamp exactly.
        shutil.copy2(s, dest)
        if executable:
            os.chmod(dest, os.stat(dest).st_mode | 0o111)
    copied += 1

for t in targets:
    print(f"synced {copied} files to {t}")

if missing:
    print("\nmanifest problems:")
    for m in missing:
        print(f"  ✗ {m}")
    sys.exit(1)

print("\nA freshly synced skill is not immediately discoverable in the session that wrote")
print("it. It registers later in this session, or immediately after a restart — restart")
print("Claude Code if you want it now (references/platform.md fact 3).")
