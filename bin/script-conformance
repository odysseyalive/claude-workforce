#!/usr/bin/env python3
"""script-conformance — run the four SHIPPED scripts against fixtures.

`bin/conformance` does this for `bin/baseline` against 17 fixtures. The shipped
scripts — wf-census, wf-conform, wf-context, wf-protect-directives — had negative
tests that were run BY HAND in a scratch directory and written up in prose. That is
an anecdote, not a test, and `bin/baseline`'s own docstring says why:

    "A census that can be re-run is the only kind that can be compared."

Each fixture is a tree under `fixtures/scripts/<case>/` plus a row in
`expectations.json` naming the script, the required exit code, substrings that MUST
appear (`want`), and substrings that must NOT (`not`, `must_not` or `reject` — three
spellings of one assertion, all read). A stdin-driven script (the hook) takes
`stdin_file` (a path inside the fixture, wrapped as a PostToolUse payload) or
`stdin_raw`. A script that reads the process environment takes `env`: a map of
variable name to value, where `null` UNSETS the variable in the child.

**Exit code and output are both checked.** A script that exits correctly while
reporting the wrong thing is the failure this project keeps finding — a report that
reads clean about something it never examined.

Usage
    bin/script-conformance            # run all
    bin/script-conformance census     # run cases whose name contains "census"
    bin/script-conformance --touching workforce/bin/wf-census
                                      # the cases a change to that file can reach
"""

import json
import os
import shutil
import subprocess
import sys
import tempfile

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
FIX = os.path.join(ROOT, "fixtures", "scripts")
BIN = os.path.join(ROOT, "workforce", "bin")


# THREE SPELLINGS OF ONE ASSERTION, AND TWO OF THEM WERE READ BY NOTHING. The loop
# below took `spec["not"]` and only that, so the 6 rows written as `must_not` and the
# 3 written as `reject` carried 9 negative assertions that never ran — three of them
# in rows this harness was already reporting FAIL, where a half-evaluated row looks
# exactly like a fully evaluated one. All three spellings are now honoured, and the
# allow-lists below are the part that keeps this fixed: a row or an `after` block
# carrying any key nothing here reads FAILS THAT ROW by name. A fourth spelling can
# be invented, but it can no longer be ignored. Measured 2026-09-13.
NEGATIVE_KEYS = ("not", "must_not", "reject")
ROW_KEYS = {"script", "exit", "args", "env", "want", "after", "chmod", "concurrent",
            "subst", "hardlink", "git",
            "stdin_file", "stdin_raw", "_why", *NEGATIVE_KEYS}
AFTER_KEYS = {"want", "once", "absent", *NEGATIVE_KEYS}
GIT_KEYS = {"init", "hooks_from", "commit", "config"}


def _unknown_keys(spec, allowed, where):
    """Keys nothing in this file reads — reported per row, never silently dropped."""
    if not isinstance(spec, dict):
        return [f"{where}: expected a map, got {type(spec).__name__}"]
    return [f"{where}: unrecognized key {k!r} — no assertion reads it"
            for k in sorted(spec) if k not in allowed]


def _sub_version(arg):
    """Replace `${VERSION}` with the release version.md declares, or leave it alone."""
    if "${VERSION}" not in str(arg):
        return arg
    import re as _re
    try:
        _t = open("workforce/references/version.md", encoding="utf-8").read()
    except OSError:
        return arg
    _m = _re.search(r"^WORKFORCE-VERSION:\s*(\S+)", _t, _re.M)
    return arg.replace("${VERSION}", _m.group(1)) if _m else arg


def _sub_tree(arg, tree):
    """Replace `${TREE}` with the copied fixture tree's absolute path.

    THE TREE IS COPIED TO A TEMP DIRECTORY, so a case that needs a variable to POINT AT
    the tree cannot spell that path in advance. `HOME=${TREE}` is the one that matters:
    a defect class in this project is a project whose root IS `$HOME`, where
    `config_root()` and `<root>/.claude` are the same directory under two names, and no
    fixture could reach that state while every env value had to be a literal.
    """
    return str(arg).replace("${TREE}", tree)


# A COMPLETE FAKE INSTALL IS DERIVED, NEVER FROZEN. wf-settings-apply removes a retired
# hook row only when the install it points into holds every CURRENT_HOOK_SCRIPTS file.
# The fixtures held that set as stub files, so the release that added wf-code-origin
# (1.63.0) made every fake install incomplete at once, and 25 heal cases went red with no
# fixture edited. A bin dir that carries this marker is filled here, in the COPY, with a
# stub for every hook the script under test ships today. A deliberately partial install
# carries no marker and is copied exactly as authored.
COMPLETE_INSTALL_MARKER = ".complete-install"
_STUB = "#!/bin/sh\nexit 0\n"
_hook_scripts = []


def current_hook_scripts():
    """CURRENT_HOOK_SCRIPTS, read from wf-settings-apply itself, once per run."""
    if not _hook_scripts:
        import importlib.machinery
        import importlib.util
        sys.dont_write_bytecode = True   # a .pyc in workforce/bin/ is an undeclared shipped file
        path = os.path.join(BIN, "wf-settings-apply")
        loader = importlib.machinery.SourceFileLoader("_wf_settings_apply", path)
        mod = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
        loader.exec_module(mod)
        _hook_scripts.extend(sorted(mod.CURRENT_HOOK_SCRIPTS))
        if not _hook_scripts:
            raise RuntimeError(f"{path} names no CURRENT_HOOK_SCRIPTS")
    return _hook_scripts


def fill_complete_installs(tree):
    """Give every marked bin dir under `tree` a stub for each current hook script, then
    drop the marker. Returns problems; a marker anywhere but `skills/workforce/bin` is one."""
    problems = []
    for d, dirs, files in os.walk(tree):
        dirs.sort()
        rel = os.path.relpath(d, tree)
        if COMPLETE_INSTALL_MARKER not in files:
            # The other half of the class: an unmarked install that happens to hold every
            # current hook today is the next release's incomplete one.
            if (d.endswith(os.path.join("skills", "workforce", "bin"))
                    and set(current_hook_scripts()) <= set(files)):
                problems.append(f"{rel}: holds every current hook as frozen stubs; replace "
                                f"them with {COMPLETE_INSTALL_MARKER}")
            continue
        if not d.endswith(os.path.join("skills", "workforce", "bin")):
            problems.append(f"{rel}: {COMPLETE_INSTALL_MARKER} outside a skills/workforce/bin dir")
            continue
        os.remove(os.path.join(d, COMPLETE_INSTALL_MARKER))
        for s in current_hook_scripts():
            if s in files:
                problems.append(f"{rel}/{s}: a marked install must not freeze a current hook stub")
                continue
            with open(os.path.join(d, s), "w", encoding="utf-8") as fh:
                fh.write(_STUB)
            os.chmod(os.path.join(d, s), 0o755)
    return problems


# NO CASE RUNS FOREVER. Every invocation here was unbounded, so one fixture tree that
# made a script loop took the whole suite with it and nothing printed — the state hardest
# to diagnose, because a hung run and a slow one look identical. MEASURED 2026-10-08
# while adding `orgsync-symlink-loop`: `.claude/agents/d/up -> ..` beside `d/self -> .`
# made `glob('**/*.md', recursive=True)` run past 25 seconds without finishing. Generous
# next to the slowest real case (under a second), and an expiry FAILS that case by name.
CASE_TIMEOUT = 120


def _git_fixture(tree, g, env):
    """Build the case's git repository inside the COPY. Returns a problem string, or "".

    FOUR STEPS, IN THIS ORDER, and the order is the assertion:
      `init`        — `git init` the copy.
      `hooks_from`  — a directory in the fixture whose files are MOVED into the repo's own
                      hooks directory, resolved with `git rev-parse --git-path hooks`. The
                      fixture cannot spell `.git/hooks` any more than the script under test
                      may, so neither does.
      `commit`      — one commit of everything, which is the only way a case can see the
                      tracked-vs-untracked half of a report. `--no-verify`: the fixture's
                      own `pre-commit` is the retired guard the heal exists to remove, and
                      a fixture that executed it would be testing the 1.31.0 script.
      `config`      — set LAST, after the commit, for that same reason.

    IDENTITY AND CONFIG ARE PINNED, never inherited. `-c user.*` on the commit and
    GIT_CONFIG_GLOBAL/SYSTEM at /dev/null, so a maintainer whose own `~/.gitconfig` sets
    `core.hooksPath` or a commit template cannot change what a case measures — the same
    argument the empty HOME above makes for the harness.
    """
    bad = sorted(k for k in g if k not in GIT_KEYS)
    if bad:
        return f"git: unrecognized key(s) {bad} — no step here reads them"
    if not shutil.which("git"):
        return "git: not on PATH, so this case cannot build the repository it asserts on"
    genv = dict(env, GIT_CONFIG_GLOBAL=os.devnull, GIT_CONFIG_SYSTEM=os.devnull,
                GIT_CONFIG_NOSYSTEM="1", GIT_TERMINAL_PROMPT="0")

    def run(*args):
        return subprocess.run(["git", "-C", tree, *args], capture_output=True, text=True,
                              env=genv, timeout=CASE_TIMEOUT)

    def fail(what, p):
        return f"git {what} failed ({p.returncode}): {(p.stderr or p.stdout).strip()[:160]}"

    if g.get("init"):
        p = run("-c", "init.defaultBranch=main", "init", "-q")
        if p.returncode:
            return fail("init", p)
    if g.get("hooks_from"):
        p = run("rev-parse", "--git-path", "hooks")
        if p.returncode:
            return fail("rev-parse --git-path hooks", p)
        hooks = p.stdout.strip()
        hooks = hooks if os.path.isabs(hooks) else os.path.join(tree, hooks)
        os.makedirs(hooks, exist_ok=True)
        src = os.path.join(tree, g["hooks_from"])
        if not os.path.isdir(src):
            return f"git hooks_from: {g['hooks_from']} is not a directory in this fixture"
        for n in sorted(os.listdir(src)):
            dst = os.path.join(hooks, n)
            shutil.move(os.path.join(src, n), dst)
            os.chmod(dst, 0o755)
        os.rmdir(src)
    if g.get("commit"):
        p = run("add", "-A")
        if p.returncode:
            return fail("add -A", p)
        p = run("-c", "user.email=fixture@local", "-c", "user.name=Fixture",
                "commit", "-q", "--no-verify", "-m", "fixture")
        if p.returncode:
            return fail("commit", p)
    for k, v in (g.get("config") or {}).items():
        p = run("config", "--local", k, _sub_tree(v, tree))
        if p.returncode:
            return fail(f"config {k}", p)
    return ""


def run_case(name, spec):
    src = os.path.join(FIX, name)
    script = os.path.join(BIN, spec["script"])
    if not os.path.isdir(src):
        return False, f"fixture tree missing: {src}"
    if not os.path.isfile(script):
        return False, f"script missing: {script}"

    # EVERY case runs against a COPY. A script that writes would otherwise consume
    # its own fixture: `remainder-apply-good` passed on the first run and failed on
    # the second, because the section it removes was already gone. Until a shipped
    # script wrote to the tree, nothing here could tell a passing case from a
    # self-consuming one — and a fixture that only works once is not a regression
    # test, it is a single observation. Found 2026-08-04, by running it twice.
    tmp = tempfile.mkdtemp(prefix=f"wfsc-{name}-")
    tree = os.path.join(tmp, name)
    # LINKS ARE COPIED AS LINKS. A case about writing through a symlink is meaningless on
    # a copy that dereferenced it, which the default does; no fixture held a link before
    # the settings-heal cases (2026-09-14), so no earlier case changes meaning.
    shutil.copytree(src, tree, symlinks=True)
    try:
        problems = fill_complete_installs(tree)
        if problems:
            return False, "; ".join(problems)
        try:
            return _run_in(tree, script, spec)
        except subprocess.TimeoutExpired:
            return False, (f"did not finish in {CASE_TIMEOUT}s — a case that hangs is a "
                           f"case nobody can read the result of")
    finally:
        # A case may make a directory read-only (`chmod`); give every directory its write
        # bit back first, or the cleanup leaves the tree behind in /tmp.
        for _d, _ds, _fs in os.walk(tmp):
            for _x in _ds:
                try:
                    os.chmod(os.path.join(_d, _x), 0o755)
                except OSError:
                    pass
        shutil.rmtree(tmp, ignore_errors=True)


def _run_in(tree, script, spec):
    env = dict(os.environ, CLAUDE_PROJECT_DIR=tree)

    # HOME IS PART OF THE FIXTURE TOO, and it leaks further than any other variable.
    # wf-census counts every hook wired for a project, user-scope registrations in
    # ~/.claude/settings.json included, which is correct behaviour for a census and
    # fatal for a fixture: `census-deadhook` asserted "3 wired" and passed for months
    # only because the maintainer's own settings happened to hold no hooks. The moment
    # six were wired there on 2026-09-07 it read 9 and went red, having tested nothing
    # about the tree it was given. A fixture must not be able to see the machine it
    # runs on. Each case gets an empty HOME; a row that genuinely needs a populated one
    # sets it explicitly through `env`, which still wins because it is applied below.
    _home = tempfile.mkdtemp(prefix="wf-conformance-home-")
    env["HOME"] = _home
    env.pop("XDG_CONFIG_HOME", None)
    # CLAUDE_CONFIG_DIR relocates the whole personal tree, so an empty HOME hides nothing
    # while it is inherited: `sa-hook-display` passed or failed by which account ran it.
    env.pop("CLAUDE_CONFIG_DIR", None)

    # THE CHILD ENV IS PART OF THE FIXTURE when the script reads it. wf-preflight's
    # runtime-override receipt reads CLAUDE_CODE_SUBAGENT_MODEL and CLAUDE_EFFORT out
    # of the live environment, so inheriting the maintainer's shell would make those
    # cases pass or fail according to who ran them — the "0 runtime overrides" half in
    # particular is destroyed by one leftover export, silently, and would then be
    # indistinguishable from a receipt that never fired.
    #
    # A string value SETS the variable; `null` UNSETS it. Unset must be expressible:
    # the clean half of a pair is the half that cannot be written any other way.
    # Added 2026-08-27 with the runtime-override receipt.
    for _k, _v in (spec.get("env") or {}).items():
        if _v is None:
            env.pop(_k, None)
        else:
            env[_k] = _sub_tree(_v, tree)

    # `subst` writes the copy's own path into the named files wherever they say `${TREE}`,
    # so a case can hold a real ABSOLUTE path — the shape a personal install's row takes,
    # and one a fixture could only fake before. `hardlink` makes `new` a second name for
    # `existing` (git stores neither). Both added 2026-09-14 for the settings heal.
    for _rel in spec.get("subst") or []:
        _fp = os.path.join(tree, _rel)
        with open(_fp, encoding="utf-8") as _fh:
            _body = _fh.read()
        with open(_fp, "w", encoding="utf-8") as _fh:
            _fh.write(_body.replace("${TREE}", tree))
    for _new, _old in (spec.get("hardlink") or {}).items():
        os.link(os.path.join(tree, _old), os.path.join(tree, _new))

    # `chmod` sets modes on paths inside the copy (git stores no read-only bit), so a case
    # can make a file the script must NOT be able to write. Octal strings, e.g. "0444".
    for _rel, _mode in (spec.get("chmod") or {}).items():
        os.chmod(os.path.join(tree, _rel), int(_mode, 8))

    # `git` BUILDS A REAL REPOSITORY INSIDE THE COPY, because a checked-in fixture cannot
    # carry one: git records a nested `.git` as mode 160000 and its contents do not survive
    # a clone, so the tree would arrive empty on every checkout but the author's
    # (`fixtures/init-git.sh` records the same finding for f6, and `bin/idempotence` builds
    # its repo the same way). Added 2026-10-10 for the stranded git-hook heal, whose entire
    # subject is `core.hooksPath` and a directory git resolves.
    if spec.get("git"):
        _gp = _git_fixture(tree, spec["git"], env)
        if _gp:
            return False, _gp

    # `concurrent: N` starts N copies at once against the same tree and asserts on the
    # FIRST one's output; `after` then sees what all N left behind. It exists for a
    # writer every session start runs, where two sessions opening at once is ordinary.
    if spec.get("concurrent"):
        _cargs = [sys.executable, script] + (
            [] if "stdin_file" in spec or "stdin_raw" in spec
            else ["--root", tree] + [_sub_tree(_sub_version(a), tree) for a in spec.get("args", [])])
        _procs = [subprocess.Popen(_cargs, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                   stderr=subprocess.STDOUT, text=True, env=env, cwd=tree)
                  for _ in range(int(spec["concurrent"]))]
        _outs = [pr.communicate(spec.get("stdin_raw") or "") for pr in _procs]
        p = subprocess.CompletedProcess(_cargs, _procs[0].returncode, _outs[0][0], "")
    elif "stdin_file" in spec or "stdin_raw" in spec:
        payload = spec.get("stdin_raw")
        if payload is None:
            payload = json.dumps({"tool_input": {"file_path": os.path.join(tree, spec["stdin_file"])}})
        p = subprocess.run([sys.executable, script], input=payload, text=True,
                           capture_output=True, env=env, cwd=tree, timeout=CASE_TIMEOUT)
    else:
        # `${VERSION}` RESOLVES TO THE INSTALLED RELEASE, so a case about "the current
        # version" is not a literal that goes stale on the next bump. MEASURED
        # 2026-09-09: `changes-current` pinned `--from 1.31.0` and asserted "nothing
        # between those versions" — true only while 1.31.0 WAS current. Seven bumps in
        # one afternoon broke it, and the fix-the-number repair would break again on the
        # eighth. Constants are stated once (SKILL.md Principle 9a); this is that rule
        # reaching the fixture args.
        _args = [_sub_tree(_sub_version(a), tree) for a in spec.get("args", [])]
        p = subprocess.run([sys.executable, script, "--root", tree] + _args,
                           text=True, capture_output=True, env=env, timeout=CASE_TIMEOUT)

    shutil.rmtree(_home, ignore_errors=True)

    out = p.stdout + p.stderr
    problems = _unknown_keys(spec, ROW_KEYS, "row")
    # A ROW MISSING A REQUIRED KEY FAILS THAT ROW; it never takes the run down. A bare
    # spec["exit"] raised KeyError out of the loop, so one malformed row made every other
    # case unrunnable -- the same defect bin/check fixed for its expectations parse.
    if "exit" not in spec:
        problems.append("row has no 'exit' key")
    elif p.returncode != spec["exit"]:
        problems.append(f"exit {p.returncode}, expected {spec['exit']}")
    for s in spec.get("want", []):
        if s not in out:
            problems.append(f"missing {s!r}")
    for _key in NEGATIVE_KEYS:
        for s in spec.get(_key, []):
            if s in out:
                problems.append(f"present but forbidden: {s!r}")

    # WHAT IT WROTE, not only what it said. The docstring above argues that "a script
    # that exits correctly while reporting the wrong thing is the failure this project
    # keeps finding" — and a script that WRITES the wrong thing while reporting fine is
    # that same failure one step further, invisible to every check above.
    #
    # Added 2026-08-10 for `wf-ratchet --capture`, whose entire output is a one-line
    # summary: on a real project it silently rewrote a 634-character annotation to 114
    # and exited 0. No `want`/`not` on stdout could have caught it, because the value it
    # destroyed never appears there.
    #
    # `after` maps a path INSIDE the fixture tree to `want`/`not` substring lists, so a
    # writing script is asserted on its artifact the same way a talking one is on its
    # stdout. An unreadable path is a FAILURE, never a skip — a missing file and a file
    # whose contents are wrong must not report the same.
    for rel, expect in spec.get("after", {}).items():
        problems += _unknown_keys(expect, AFTER_KEYS, f"after {rel}")
        if not isinstance(expect, dict):
            continue
        # `absent: true` — the file must NOT exist, the only way to see residue removed.
        if expect.get("absent"):
            if os.path.lexists(os.path.join(tree, rel)):
                problems.append(f"after {rel}: present, expected absent")
            continue
        # newline="": the bytes as written, so a case can see CRLF survive.
        try:
            body = open(os.path.join(tree, rel), encoding="utf-8", newline="").read()
        except OSError as exc:
            problems.append(f"after {rel}: unreadable ({exc.strerror})")
            continue
        for s in expect.get("want", []):
            if s not in body:
                problems.append(f"after {rel}: missing {s!r}")
        # `once`: present EXACTLY one time — the only way to see a duplicated record.
        for s in expect.get("once", []):
            if body.count(s) != 1:
                problems.append(f"after {rel}: {s!r} appears {body.count(s)} times, expected 1")
        for _key in NEGATIVE_KEYS:
            for s in expect.get(_key, []):
                if s in body:
                    problems.append(f"after {rel}: present but forbidden: {s!r}")
    return (not problems), "; ".join(problems) or "ok"


def touching(relpath, cases):
    """The cases a change to `relpath` can alter, or None when no case executes it.

    `bin/prove` runs `bin/check` once per mutation, and this suite is the slowest thing in
    it, so a prove child asks for the cases its one mutated file can reach instead of all
    of them. The full suite still runs in every plain `bin/check`, and in prove's own
    baseline before the first case, so nothing a narrowed child skips goes unrun.

      bin/script-conformance, fixtures/scripts/expectations.json   every case
      fixtures/scripts/<case>/...                                   that case
      workforce/bin/<script>                                        every case whose script
          is <script> or loads it: a script whose source holds another's name as a
          quoted string (how every loader here spells the path), followed until nothing
          new is added, because wf-settings-apply runs wf-census's code
    """
    rel = relpath.replace(os.sep, "/")
    if rel in ("bin/script-conformance", "fixtures/scripts/expectations.json"):
        return sorted(cases)
    if rel.startswith("fixtures/scripts/"):
        case = rel.split("/")[2]
        return [case] if case in cases else None
    if not rel.startswith("workforce/bin/"):
        return None
    import re
    reach = {rel.split("/")[2]}
    srcs = {}
    for n in os.listdir(BIN):
        try:
            with open(os.path.join(BIN, n), encoding="utf-8") as fh:
                srcs[n] = fh.read()
        except (OSError, UnicodeDecodeError):
            continue
    grew = True
    while grew:
        grew = False
        for n, body in srcs.items():
            if n not in reach and any(re.search(r"""(["'])%s\1""" % re.escape(r), body)
                                      for r in reach):
                reach.add(n)
                grew = True
    return sorted(c for c in cases if isinstance(cases[c], dict)
                  and cases[c].get("script") in reach) or None


def main():
    argv = sys.argv[1:]
    spec_path = os.path.join(FIX, "expectations.json")
    if not os.path.isfile(spec_path):
        print(f"no expectations at {spec_path}", file=sys.stderr)
        return 2
    cases = json.load(open(spec_path))
    if argv[:1] == ["--touching"]:
        if len(argv) != 2:
            print("usage: bin/script-conformance --touching <repo-relative path>", file=sys.stderr)
            return 2
        names = touching(argv[1], cases) or []
        filt = f"--touching {argv[1]}"
    else:
        filt = argv[0] if argv else ""
        names = sorted(n for n in cases if filt in n)

    # A run that matched no case must not exit 0 — "nothing to check" and "all
    # checks passed" are the same output otherwise, which is the failure mode
    # this whole harness exists to make impossible.
    if not names:
        print(f"no fixture matched {filt!r} — refusing to report success", file=sys.stderr)
        return 2

    fails = []
    for n in names:
        ok, detail = run_case(n, cases[n])
        print(f"  {'ok  ' if ok else 'FAIL'}  {n:<26} {'' if ok else detail}")
        if not ok:
            fails.append(n)

    print(f"\n{len(names) - len(fails)} passed, {len(fails)} failed, "
          f"{len(names)} of {len(cases)} cases run")
    return 1 if fails else 0


if __name__ == "__main__":
    sys.exit(main())
