#!/usr/bin/env python3
"""
Baseline capture for a conversion target.

    python3 bin/baseline <project-dir> [--json]

Prints a reproducible census of a project's .claude/ tree. Run it BEFORE the
first `/workforce audit` and again AFTER, and diff the two: every number in
plan/conversion-plan.md's before/after table comes from here, so the comparison
is mechanical rather than hand-counted.

Why a script and not a checklist: the first hand count of this project's
awareness-ledger reported 20 records because it trusted a stale index, and a
hand `find | head -100` undercounted the same directory a second time. A census
that can be re-run is the only kind that can be compared.

Exit code is always 0 — this is a measurement, not a gate.
"""

import json
import os
import re
import subprocess
import sys
from collections import Counter

# ─────────────────────────────────────────────────────────────────────────────
# Markers that identify predecessor-system output. Detection is BY MARKER, never
# by skill name: a renamed, forked, or partial install of the same generator must
# still be found. Names appear only in the report, as examples of what matched.
# ─────────────────────────────────────────────────────────────────────────────
MARKERS = {
    "origin_user_immutable": re.compile(r"<!--\s*origin:\s*user\b[^>]*immutable:\s*true"),
    "origin_foreign": re.compile(r"<!--\s*origin:\s*(?!user\b)(?!workforce\b)([\w.-]+)"),
    "enforcement_annotation": re.compile(r"<!--\s*ENFORCEMENT ANNOTATION"),
    "route_embed": re.compile(r"<!--\s*ROUTE-EMBED START"),
    "code_eval_embed": re.compile(r"<!--\s*CODE-EVAL-EMBED START"),
    "model_lane_gate": re.compile(r"<!--\s*MODEL-LANE-GATE START"),
    "lane_agent_embed": re.compile(r"<!--\s*LANE-AGENT-EMBED START"),
}

# Paired markers: a sweep removes opener-to-closer, so pairing must be VERIFIED
# rather than assumed. Measured on a real project: one skill carried 3 openers
# and 4 closers, so the orphan closer would have survived the sweep as residue.
# Both halves are written as FULL comment forms, so line-anchoring below applies
# to each identically. Writing a closer as bare text (`END ENFORCEMENT ANNOTATION`)
# silently produced 0 closers once anchoring was added, turning every paired file
# into a false orphan-opener — the anchor was right and the pattern was wrong.
PAIRS = {
    "enforcement_annotation": (r"<!--\s*ENFORCEMENT ANNOTATION", r"<!--\s*END ENFORCEMENT ANNOTATION"),
    "route_embed": (r"<!--\s*ROUTE-EMBED START", r"<!--\s*ROUTE-EMBED END"),
    "code_eval_embed": (r"<!--\s*CODE-EVAL-EMBED START", r"<!--\s*CODE-EVAL-EMBED END"),
    "model_lane_gate": (r"<!--\s*MODEL-LANE-GATE START", r"<!--\s*MODEL-LANE-GATE END"),
    "lane_agent_embed": (r"<!--\s*LANE-AGENT-EMBED START", r"<!--\s*LANE-AGENT-EMBED END"),
    "origin_span": (r"<!--\s*origin:", r"<!--\s*/origin\s*-->"),
}

# Directory names that hold persistent state rather than instructions. The list
# is deliberately broad: on the survey target, state was found under five
# different conventions, and a census keyed to `data/` alone missed three of them.
STATE_DIRS = {"data", "ledger", "scans", "corpora", "clients", "records", "state", "cache"}
STATE_EXT = {".json", ".jsonl", ".csv", ".tsv", ".db", ".sqlite", ".sqlite3", ".yaml", ".yml", ".org"}

# Files whose names mark them as machine-maintained working state even though
# they are markdown and sit beside instructions.
STATE_NAME_RX = re.compile(
    r"(index|state|cache|history|ledger|registry|-log|seen|manifest)\.md$", re.I
)

# Two distinct categories, deliberately not merged. A credential must never be
# archived or committed; a host-local sentinel is merely disposable. Conflating
# them would either over-warn on `task-cache.json` or under-warn on a real token.
# A generator's integrity sidecar, detected by SHAPE not by filename. Keying on
# `.directives.sha` — one predecessor's name — made fixture f7's `.quarry.sha`
# invisible, the same name-fitting failure as the ownership detector. A dotfile at
# a skill root whose body is hex digests is a sidecar whoever wrote it.
SIDECAR_NAME_RX = re.compile(r"^\.[\w.-]*\.(sha|sha256|lock|hash)$|^\.[\w-]*(sha|hash|lock)[\w.-]*$", re.I)
SIDECAR_BODY_RX = re.compile(r"\b[0-9a-f]{32,64}\b")

CRED_RX = re.compile(r"(token|secret|credential|auth|-key|\.env)", re.I)
HOST_LOCAL_RX = re.compile(r"^\.(.*(cache|acked|nudge|-ts|mode|active|pending|reviewed|advised))", re.I)


def defence(body):
    """Blank out fenced code blocks, preserving line numbering.

    Line-anchoring excludes an inline `<!-- ... -->` mention because it is not at
    the start of a line. It does NOT exclude the same marker inside a ``` fence,
    where it IS at line start — so a file documenting the marker format inflated
    every count. Fixture f12: 1 real user span in a SKILL.md, censused as 2.
    """
    out, fenced = [], False
    for line in body.split("\n"):
        if line.lstrip().startswith("```"):
            fenced = not fenced
            out.append("")
            continue
        out.append("" if fenced else line)
    return "\n".join(out)


def ANCHORED(rx):
    """A marker is a span opener only when it STARTS a line.

    One definition, used by the totals and by the pairing check. They disagreed
    until 2026-07-31: pairing anchored, totals did not, so the same file counted
    one population two ways and the extraction gate blocked on the inflated one.
    """
    # A leading LINE-COMMENT PREFIX still counts as line start. Markers live in
    # shell and PowerShell files as `# <!-- origin: ... -->`, which is the only way
    # to carry one there — and requiring the comment to begin the line missed every
    # such span. apps-odyssey-alive keeps user directives in exactly that shape
    # inside `hooks/*.sh`. An inline mention is still excluded: it is not at line
    # start with or without a prefix.
    return re.compile(r"^[ \t]*(?:[#;]|//|--)?[ \t]*" + rx.pattern, re.M)


def sh(args, cwd):
    try:
        r = subprocess.run(args, cwd=cwd, capture_output=True, text=True, timeout=60)
        return r.returncode, r.stdout, r.stderr
    except Exception as e:  # a census must not die on the thing it measures
        return 1, "", str(e)


def git_status(root, relpath):
    """Return one of: tracked, ignored, untracked, unknown."""
    code, _, _ = sh(["git", "ls-files", "--error-unmatch", relpath], root)
    if code == 0:
        return "tracked"
    code, _, _ = sh(["git", "check-ignore", "-q", relpath], root)
    if code == 0:
        return "ignored"
    return "untracked"


def read(p):
    try:
        with open(p, encoding="utf-8", errors="replace") as f:
            return f.read()
    except Exception:
        return ""


# Any `<!-- NAME START -->` / `<!-- NAME END -->` pair is a marker family. The
# named families above are examples learned from one project; this finds the ones
# no table lists. A census keyed only to known names reports a clean sweep over
# every generator it has not met.
GENERIC_PAIR_RX = re.compile(r"<!--\s*([A-Z][A-Z0-9-]{3,})\s+START\b")


def discover_marker_families(skills_dir):
    """Marker families present in the tree but absent from the known table."""
    known = {k.upper().replace("_", "-") for k in PAIRS}
    found = Counter()
    for dirpath, _d, filenames in os.walk(skills_dir):
        for fn in filenames:
            if not fn.endswith(".md"):
                continue
            try:
                body = open(os.path.join(dirpath, fn), encoding="utf-8", errors="replace").read()
            except Exception:
                continue
            for name in GENERIC_PAIR_RX.findall(body):
                if name.replace("-", "").lower() not in {
                    k.replace("_", "").replace("-", "").lower() for k in known
                }:
                    found[name] += 1
    return dict(found)


def census(root):
    root = os.path.abspath(root)
    claude = os.path.join(root, ".claude")
    skills_dir = os.path.join(claude, "skills")
    out = {"project": root, "exists": os.path.isdir(claude)}

    # ── GREENFIELD SIGNAL ────────────────────────────────────────────────────
    # org-design.md calls a project with no skills "the ordinary case, not a
    # degraded one" and the PRIMARY path — and this census measured only the
    # skills tree, so it returned all zeros for it. Fixture f6 (16 files, 4
    # commits, two package manifests, a settings file) produced output identical
    # to an empty directory. A measurement with no signal on the primary path is
    # not a conservative measurement; it is an absent one.
    # An interrupted prior run is precondition 4 of every transaction, and the
    # census never looked. Fixture f9 carries a WRITE-INTENT row and reported clean.
    jrl = os.path.join(claude, "workforce", ".conversion-journal.md")
    jbody = read(jrl)
    out["journal"] = {
        "path": os.path.relpath(jrl, root) if jbody else None,
        "rows": jbody.count("\n| 0") if jbody else 0,
        "write_intent": jbody.count("WRITE-INTENT") if jbody else 0,
    }

    out["greenfield"] = gf = {}
    gf["claude_md_bytes"] = len(read(os.path.join(root, "CLAUDE.md")).encode())
    manifests = ["package.json", "pyproject.toml", "Cargo.toml", "go.mod", "mix.exs",
                 "Gemfile", "pom.xml", "build.gradle", "composer.json", "Makefile", "CMakeLists.txt"]
    gf["manifests"] = sorted(
        os.path.relpath(os.path.join(d, f), root)
        for d, _s, fs in os.walk(root) if ".git" not in d and "node_modules" not in d
        for f in fs if f in manifests
    )
    code_ext = {".py", ".ts", ".tsx", ".js", ".jsx", ".rs", ".go", ".ex", ".rb", ".java", ".c", ".cpp"}
    n_code = n_test = 0
    top = {}
    for d, subs, fs in os.walk(root):
        if ".git" in d or "node_modules" in d:
            continue
        for f in fs:
            if os.path.splitext(f)[1] in code_ext:
                n_code += 1
                rel = os.path.relpath(os.path.join(d, f), root)
                top[rel.split(os.sep)[0]] = top.get(rel.split(os.sep)[0], 0) + 1
                if "test" in f.lower() or "spec" in f.lower() or "/test" in rel.replace(os.sep, "/"):
                    n_test += 1
    gf["code_files"] = n_code
    gf["test_files"] = n_test
    gf["top_dirs"] = dict(sorted(top.items(), key=lambda kv: -kv[1])[:8])
    code, so, _ = sh(["git", "rev-list", "--count", "HEAD"], root)
    gf["git_commits"] = int(so.strip()) if code == 0 and so.strip().isdigit() else 0
    code, so, _ = sh(["git", "log", "--format=", "--name-only", "-n", "200"], root)
    churn = {}
    if code == 0:
        for line in so.splitlines():
            if line.strip():
                churn[line.split("/")[0]] = churn.get(line.split("/")[0], 0) + 1
    gf["churn_top"] = dict(sorted(churn.items(), key=lambda kv: -kv[1])[:5])

    if not out["exists"]:
        return out

    # ── Skills ───────────────────────────────────────────────────────────────
    skills = {}
    marker_totals = Counter()
    mention_totals = Counter()
    foreign_owners = Counter()
    no_marker = []
    quarantined = []
    unpaired = []
    file_scope_owners = []

    names = sorted(os.listdir(skills_dir)) if os.path.isdir(skills_dir) else []
    for name in names:
        sdir = os.path.join(skills_dir, name)
        if not os.path.isdir(sdir):
            continue
        smd = os.path.join(sdir, "SKILL.md")
        body = read(smd)
        rec = {
            "has_skill_md": os.path.isfile(smd),
            "lines": body.count("\n") + 1 if body else 0,
            "bytes": len(body.encode("utf-8")),
            "subdirs": sorted(
                d for d in os.listdir(sdir) if os.path.isdir(os.path.join(sdir, d))
            ),
            "markers": {},
        }

        # Frontmatter parses? A skill that cannot be read is QUARANTINED: excluded
        # from downstream work, but counted in every total so the accounting never
        # silently shrinks.
        if rec["has_skill_md"]:
            if not body.startswith("---\n") or "\n---\n" not in body:
                rec["quarantined"] = "frontmatter missing or unterminated"
                quarantined.append(name)
        else:
            rec["quarantined"] = "no SKILL.md"
            quarantined.append(name)

        # ANCHOR THE TOTALS TOO. The pairing block below has line-anchored since it
        # was written, and documents why: a marker quoted inside a sentence is
        # documentation about the format, not a span opener. The TOTALS did not
        # anchor, so one file computed the same population two ways.
        #
        # Measured on the first sweep ever run: `origin_user_immutable` counted 68
        # naive against 37 anchored — 31 mentions, 46% inflation — and the
        # extraction gate blocked a completable sweep because the census it was
        # asserting against was counting prose. The mentions are REPORTED rather
        # than dropped; a number that shrank without explanation is its own defect.
        # SCAN THE WHOLE SKILL, NOT JUST SKILL.md. The extraction gate asserts
        # extracted spans against CENSUSED spans, and this counted one file per
        # skill — so protected `origin: user | immutable: true` spans living in
        # references/ or hooks/ were invisible to the denominator. The gate would
        # pass at "2 of 2" while two real spans went unextracted and were then
        # swept. That is data loss of the protected class, reported as success.
        # Fixture f12: 4 real user spans in one skill, 1 of them in SKILL.md.
        marker_files = []
        for _md, _ms, _mf in os.walk(sdir):
            for _f in _mf:
                if os.path.splitext(_f)[1].lower() in (".md", ".sh", ".ps1", ".py", ".txt"):
                    _fp = os.path.relpath(os.path.join(_md, _f), root)
                    marker_files.append((_fp, read(os.path.join(_md, _f))))
        marker_body = [b for _f, b in marker_files]
        scan = defence("\n".join(marker_body))
        raw = "\n".join(marker_body)
        for key, rx in MARKERS.items():
            n = len(ANCHORED(rx).findall(scan))
            mentions = len(rx.findall(raw)) - n
            if n:
                rec["markers"][key] = n
                marker_totals[key] += n
            if mentions:
                rec.setdefault("marker_mentions", {})[key] = mentions
                mention_totals[key] += mentions

        # PAIRING. A marker sweep deletes opener-to-closer, so an unpaired marker
        # either survives as residue (orphan closer) or swallows everything up to
        # the NEXT closer (orphan opener). Counting openers alone cannot see it.
        #
        # ONLY LINE-ANCHORED MARKERS COUNT. A marker quoted inside a sentence —
        # documentation describing the format — is not a span opener. Counting it
        # produced a false "unpaired" on this project's own SKILL.md, which under
        # the exclusion rule would have silently skipped a legitimate file. A
        # false positive on an exclusion gate is expensive: it looks like caution
        # and behaves like a dropped file.
        # ONE anchoring rule and ONE body for both computations. They diverged
        # twice: first because pairing anchored and the totals did not, then
        # because the totals gained fence-stripping, a comment-prefix anchor and a
        # whole-skill scan while pairing kept the old local lambda. An assertion
        # caught the second within the hour.
        class _P:  # ANCHORED takes a compiled pattern; PAIRS holds strings
            def __init__(self, pat): self.pattern = pat
        # PAIRING IS PER FILE. Joining a skill's files into one body to count
        # totals is fine — a total is a sum. Pairing is NOT: an opener in SKILL.md
        # would silently pair with a closer in references/, and the whole point of
        # this check is that a span runs opener-to-closer WITHIN a file. Introduced
        # and caught in the same change as the whole-skill scan.
        for key, (o_rx, c_rx) in PAIRS.items():
            o = c = 0
            for _fp, _fb in marker_files:
                _fs = defence(_fb)
                o += len(ANCHORED(_P(o_rx)).findall(_fs))
                c += len(ANCHORED(_P(c_rx)).findall(_fs))
            per_file = [
                (fp, len(ANCHORED(_P(o_rx)).findall(defence(fb))),
                     len(ANCHORED(_P(c_rx)).findall(defence(fb))))
                for fp, fb in marker_files
            ]
            # A FILE-SCOPE OWNERSHIP HEADER IS NOT AN ORPHAN OPENER. A file that
            # opens with `<!-- origin: <owner> ... -->` in its first lines and
            # never closes is declaring the WHOLE FILE machine-owned — a different,
            # legitimate marker form. Measured on the real target: 13 files across
            # two skills, every one well-formed, which this check would have
            # excluded from the sweep as hazards. Thirteen files of scaffolding
            # that then never gets removed is the residue problem, arrived at
            # through the safety check.
            def _file_scope(fp, body, a, b):
                if not (a == 1 and b == 0 and key == "origin_span"):
                    return False
                head = "\n".join(defence(body).split("\n")[:6])
                return bool(ANCHORED(_P(o_rx)).search(head))
            _bodies = dict(marker_files)
            file_scope = [fp for fp, a, b in per_file if _file_scope(fp, _bodies[fp], a, b)]
            for fp in file_scope:
                file_scope_owners.append({"skill": name, "file": fp})
            imbalanced = [(fp, a, b) for fp, a, b in per_file
                          if a != b and fp not in file_scope]
            if imbalanced:
                o = sum(a for _f, a, _b in imbalanced)
                c = sum(b for _f, _a, b in imbalanced)
                unpaired.append({
                    "skill": name, "marker": key, "openers": o, "closers": c,
                    "files": [fp for fp, _a, _b in imbalanced],
                    "risk": "orphan closer survives the sweep as residue" if c > o
                            else "orphan opener — the sweep may swallow to the next closer",
                })
        for owner in MARKERS["origin_foreign"].findall(body):
            foreign_owners[owner] += 1

        if "origin:" not in body and rec["has_skill_md"]:
            no_marker.append(name)

        # /route named in prose, outside the generated embed
        rec["names_route"] = bool(re.search(r"/route\b", body))

        # sidecars and dotfiles at the skill root
        rec["root_dotfiles"] = sorted(
            f for f in os.listdir(sdir)
            if f.startswith(".") and os.path.isfile(os.path.join(sdir, f))
        )
        skills[name] = rec

    # ── State / data inventory ───────────────────────────────────────────────
    # Walk the whole skills tree; classify anything that is persistent state
    # rather than instruction, and record its git disposition. The git status is
    # the load-bearing column: it is the ONLY place a project declares whether a
    # dataset is disposable, and it lives in files no SKILL.md mentions.
    # ENUMERATE, then classify by EXCLUSION. An earlier version matched files it
    # recognised as state, which means a dataset with an unusual name in an
    # unusual place was invisible — and the number it produced was the one
    # guarding against data loss. Now every file is accounted for: instruction,
    # code, or state. Whatever matches none of those is UNCLASSIFIED, and an
    # unclassified file is a finding rather than a silent omission.
    datasets = []
    unclassified = []
    # POLICY FILES ARE NOT CONFINED TO THE SKILLS TREE. data-skills.md's whole
    # point about them is that they "routinely live in files no SKILL.md mentions,
    # and in more than one of them" — and this scan only walked skills/, so a
    # `.claude/.gitignore` or a project-root one counted zero. § Git policy then
    # has to name the ignore rule's file BY PATH, and there was nothing to name.
    policy_files = []
    for _pd, _ps, _pf in os.walk(root):
        if ".git" in _pd.split(os.sep) or "node_modules" in _pd.split(os.sep):
            continue
        if os.path.relpath(_pd, root).split(os.sep)[0] in ("fixtures",):
            continue
        for _f in _pf:
            if _f in (".gitignore", ".gitattributes"):
                policy_files.append(os.path.relpath(os.path.join(_pd, _f), root))
    sidecar_files = []
    accounted = 0
    for dirpath, dirnames, filenames in os.walk(skills_dir):
        rel_from_skills = os.path.relpath(dirpath, skills_dir)
        parts = rel_from_skills.split(os.sep)
        skill = parts[0] if parts and parts[0] != "." else None
        in_state_dir = any(p in STATE_DIRS for p in parts)
        in_code_dir = any(p in ("scripts", "hooks") for p in parts)
        in_ref_dir = "references" in parts
        for fn in filenames:
            full = os.path.join(dirpath, fn)
            rel = os.path.relpath(full, root)
            ext = os.path.splitext(fn)[1].lower()
            accounted += 1

            # 1. POLICY — the only place a project declares whether a dataset is
            #    disposable. Load-bearing, tracked, and never moved. Counted
            #    separately because losing one silently commits private data.
            if fn in (".gitignore", ".gitattributes"):
                continue  # already collected project-wide above
            # 2. Instruction — the skill's own prose. Never state. Includes
            #    root-level `reference.md`: this project's own survey target puts
            #    reference prose at the skill root, not under references/.
            if fn in ("SKILL.md", "AGENT.md", "README.md") or (
                ext == ".md" and not STATE_NAME_RX.search(fn)
                and (in_ref_dir or skill is not None)
            ):
                continue
            # 3. Code — executable machinery. Survives conversion, never moved.
            if in_code_dir or ext in (".sh", ".py", ".js", ".ts", ".ps1", ".mjs"):
                continue
            # 4. Predecessor sidecars — integrity stamps the generator wrote.
            #    Scaffolding, and orphaned the moment its generator is removed.
            if fn.endswith(".sha"):
                sidecar_files.append(rel)
                continue
            # 3. State — everything the org must not lose.
            is_state = (
                in_state_dir
                or ext in STATE_EXT
                or STATE_NAME_RX.search(fn)
                or (fn.startswith(".") and CRED_RX.search(fn))
                or (fn.startswith(".") and HOST_LOCAL_RX.search(fn))
            )
            if not is_state:
                # 4. Residual. Reported by name — never dropped.
                unclassified.append({"path": rel, "bytes": os.path.getsize(full)
                                     if os.path.exists(full) else -1})
                continue
            try:
                size = os.path.getsize(full)
            except OSError:
                size = -1
            datasets.append({
                "skill": skill,
                "path": rel,
                "bytes": size,
                "git": git_status(root, rel),
                "credential_shaped": bool(CRED_RX.search(fn)),
                "host_local_sentinel": bool(fn.startswith(".") and HOST_LOCAL_RX.search(fn)),
                "location": "state-dir" if in_state_dir else "skill-root-or-references",
            })

    # ── Hooks: registered vs on disk, both directions ────────────────────────
    # Dead wiring (registered, file absent) silently drops whatever the hook
    # enforced. Orphans (on disk, unregistered) are dead weight. Neither is
    # visible from a skill directory alone, so both are censused here.
    #
    # FOUR numbers, not one. An earlier version reported only unique script
    # paths and labelled it "registered", which is a different quantity: on a
    # real project, 61 entries resolved to 40 unique scripts because 20 scripts
    # were wired to more than one event/matcher. A before/after comparison on
    # the unique count would pass while 21 registrations were lost.
    settings_paths = [
        os.path.join(claude, "settings.json"),
        os.path.join(claude, "settings.local.json"),
    ]
    hook_entries = []          # every `command` string, however shaped
    for sp in settings_paths:
        try:
            with open(sp, encoding="utf-8") as f:
                blob = json.load(f)
        except Exception:
            blob = None
        if blob is not None:
            def _walk(o):
                if isinstance(o, dict):
                    for k, v in o.items():
                        if k == "command" and isinstance(v, str):
                            hook_entries.append(v)
                        else:
                            _walk(v)
                elif isinstance(o, list):
                    for v in o:
                        _walk(v)
            _walk(blob)
        else:
            # Unparseable settings is a FINDING, not a zero. Fall back to regex
            # so the census degrades loudly rather than reporting no hooks.
            txt = read(sp)
            hook_entries += re.findall(r'"command"\s*:\s*"((?:[^"\\]|\\.)*)"', txt)

    registered = set()
    inline_hooks = []
    for cmd in hook_entries:
        m = re.search(r"(skills/[\w./-]+\.(?:sh|py|js|ts))", cmd)
        if m:
            registered.add(m.group(1))
        else:
            inline_hooks.append(cmd[:80])
    on_disk_hooks = set()
    for dirpath, _, filenames in os.walk(skills_dir):
        if os.path.basename(dirpath) != "hooks":
            continue
        for fn in filenames:
            rel = os.path.relpath(os.path.join(dirpath, fn), claude)
            on_disk_hooks.add(rel.replace(os.sep, "/"))
    dead_wiring = sorted(r for r in registered if r not in on_disk_hooks)
    orphan_hooks = sorted(on_disk_hooks - registered)

    # ── Agent definitions, both shapes, both locations ───────────────────────
    # Identity comes only from `name:`, and .claude/agents/ is scanned
    # recursively, so a collision anywhere in the union is a collision.
    agents = {"registered": [], "in_skills": []}
    agents_dir = os.path.join(claude, "agents")
    for dirpath, _, filenames in os.walk(agents_dir):
        for fn in filenames:
            if fn.endswith(".md"):
                agents["registered"].append(
                    os.path.relpath(os.path.join(dirpath, fn), root)
                )
    for dirpath, _, filenames in os.walk(skills_dir):
        for fn in filenames:
            if fn == "AGENT.md" or (
                os.path.basename(dirpath) == "agents" and fn.endswith(".md")
            ):
                agents["in_skills"].append(
                    os.path.relpath(os.path.join(dirpath, fn), root)
                )
    agents["registered"].sort()
    agents["in_skills"].sort()

    # ── Predecessor ledger — BY SHAPE, never by skill name ──────────────────
    # This read `skills/awareness-ledger/ledger/` — one predecessor's literal skill
    # name — inside the system whose stated rule is "detection is by marker, never
    # by name", and legacy-markers.md classes this artifact `data — migrate`. A
    # generator calling its store anything else was invisible, and the miss is DATA
    # LOSS rather than a bad count.
    #
    # The shape: a directory holding >= 2 subdirectories of dated .md records, with
    # an index beside them. Record-type names are discovered, never enumerated.
    ledger = {}
    REC_RX = re.compile(r"^[A-Z]{2,4}-\d{4}-\d{2}-\d{2}-|^\d{4}-\d{2}-\d{2}")
    candidates = []
    for dirpath, subs, files in os.walk(skills_dir):
        if os.path.basename(dirpath).startswith("."):
            continue
        buckets = {}
        for sub in subs:
            sd = os.path.join(dirpath, sub)
            # RECURSE INTO THE BUCKET. Records get filed into year or quarter
            # subdirectories, and os.listdir stopped at the top level — fixture
            # f10's hand count is 8 and a non-recursive walk reported 7, missing
            # `decisions/2025/`. An undercount here is a record the migration
            # never moves.
            mds = []
            for bd, _bs, bf in os.walk(sd):
                mds.extend(f for f in bf if f.endswith(".md"))
            # COUNT RECORDS, NOT MARKDOWN FILES. The predecessor's buckets each
            # carry a README.md, and counting every .md reported 24 records against
            # an index correctly claiming 20 — a drift this project then cited as a
            # live defect for a whole session. The index was right; the census was
            # counting its own noise.
            recs = [f for f in mds if REC_RX.match(f)]
            if recs:
                buckets[sub] = len(recs)
        if len(buckets) >= 2:
            for sub in subs:  # zero-record buckets are reported, never dropped
                buckets.setdefault(sub, 0) if os.path.isdir(os.path.join(dirpath, sub)) else None
            candidates.append((dirpath, buckets))
    if candidates:
        led_root, buckets = max(candidates, key=lambda c: sum(c[1].values()))
        ledger.update(buckets)
        ledger["root"] = os.path.relpath(led_root, root)
        ledger["record_types"] = sorted(buckets)
        idx = ""
        for cand in ("index.md", "INDEX.md", "README.md"):
            idx = idx or read(os.path.join(led_root, cand))
        claimed = re.findall(r"\|\s*([A-Za-z]{3,})\s*\|\s*(\d+)\s*\|", idx)
        ledger["index_claims"] = {
            k.lower(): int(v) for k, v in claimed if k.lower() in buckets
        }
        ledger["actual_total"] = sum(buckets.values())

    # ── Where ignore rules for skill state actually live ─────────────────────
    ignore_sources = Counter()
    for ds in datasets:
        if ds["git"] != "ignored":
            continue
        code, sout, _ = sh(["git", "check-ignore", "-v", ds["path"]], root)
        if code == 0 and sout.strip():
            ignore_sources[sout.split(":")[0]] += 1

    out.update({
        "skill_count": len(skills),
        "skills": skills,
        "quarantined": quarantined,
        "unpaired_markers": unpaired,
        "file_scope_owners": file_scope_owners,
        "unknown_marker_families": discover_marker_families(skills_dir),
        "skills_with_no_origin_marker": no_marker,
        "marker_totals": dict(marker_totals),
        "foreign_origin_owners": dict(foreign_owners),
        "skills_naming_route_in_prose": sorted(
            n for n, r in skills.items() if r.get("names_route")
        ),
        # By SHAPE, not by one predecessor's filename. `.directives.sha` was the
        # only name matched, so fixture f7's `.quarry.sha` — same artifact, same
        # role, different generator — counted zero.
        "integrity_sidecars": sorted(
            f"{n}/{f}" for n, r in skills.items() for f in r.get("root_dotfiles", [])
            if SIDECAR_NAME_RX.match(f)
        ),
        "datasets": sorted(datasets, key=lambda d: d["path"]),
        "dataset_bytes_total": sum(max(0, d["bytes"]) for d in datasets),
        "files_accounted": accounted,
        "policy_files": sorted(policy_files),
        "predecessor_sidecar_files": sorted(sidecar_files),
        "unclassified_files": sorted(unclassified, key=lambda d: d["path"]),
        "credential_shaped_files": [d["path"] for d in datasets if d["credential_shaped"]],
        "host_local_sentinels": [d["path"] for d in datasets if d.get("host_local_sentinel")],
        "hook_entries_total": len(hook_entries),
        "hook_entries_file_pointing": len(hook_entries) - len(inline_hooks),
        "hooks_inline_no_file": inline_hooks,
        "hooks_registered": sorted(registered),
        "hooks_on_disk": sorted(on_disk_hooks),
        "hooks_dead_wiring": dead_wiring,
        "hooks_orphaned": orphan_hooks,
        "agents": agents,
        "predecessor_ledger": ledger,
        "ignore_rule_sources": dict(ignore_sources),
    })
    return out


def human(n):
    for unit in ("B", "KB", "MB"):
        if n < 1024 or unit == "MB":
            return f"{n:.0f}{unit}" if unit == "B" else f"{n/1:.0f}{unit}"
        n /= 1024
    return f"{n}B"


def _greenfield(c, p):
    """The evidence ladder org-design.md ranks. Printed even with no .claude/."""
    g = c.get("greenfield") or {}
    if not (g.get("code_files") or g.get("manifests") or g.get("git_commits")):
        return
    p("## Project shape — the greenfield evidence ladder")
    p("")
    p("A project with no skills is the ordinary case, not a degraded one.")
    p("")
    p("| evidence | value |")
    p("|---|---|")
    p(f"| build manifests | {', '.join(g['manifests']) or '**none**'} |")
    p(f"| code files | {g['code_files']} |")
    _t = g['test_files']
    p(f"| test files | {_t} — {'supports a tighter handbook' if _t else '**none: roster must be correspondingly small**'} |")
    p(f"| top directories | {', '.join(f'{k} ({v})' for k, v in g['top_dirs'].items()) or '—'} |")
    _gc = g['git_commits']
    p(f"| git history | {_gc} commits{'' if _gc else ' — **no VCS**'} |")
    p(f"| churn (last 200) | {', '.join(f'{k} ({v})' for k, v in g['churn_top'].items()) or '—'} |")
    p(f"| CLAUDE.md | {g['claude_md_bytes']} bytes, injected per subagent |")
    p("")


def report(c):
    if not c.get("exists"):
        print(f"# Baseline — {c['project']}")
        print("")
        print("**No `.claude/` directory.** Skill-tree metrics are not applicable; the project")
        print("evidence below is what an audit would design the org from.")
        print("")
        _greenfield(c, print)
        return
    p = print
    p(f"# Baseline — {c['project']}")
    p("")
    _greenfield(c, p)
    p("## Counts")
    p("")
    p(f"| metric | value |")
    p(f"|---|---|")
    p(f"| skills | {c['skill_count']} |")
    p(f"| quarantined (unparseable) | {len(c['quarantined'])} |")
    p(f"| **UNPAIRED markers (sweep hazard)** | **{len(c['unpaired_markers'])}** |")
    p(f"| **UNKNOWN marker families (not in the table)** | **{len(c['unknown_marker_families'])}** |")
    p(f"| skills with no `origin:` marker | {len(c['skills_with_no_origin_marker'])} |")
    for k, v in sorted(c["marker_totals"].items()):
        p(f"| marker `{k}` | {v} |")
    p(f"| integrity sidecars (any generator) | {len(c['integrity_sidecars'])} |")
    _j = c.get("journal") or {}
    if _j.get("write_intent"):
        p(f"| **INTERRUPTED TRANSACTION (journal WRITE-INTENT rows)** | **{_j['write_intent']}** |")
    elif _j.get("path"):
        p(f"| conversion journal | {_j['rows']} rows, 0 at WRITE-INTENT |")
    p(f"| skills naming `/route` in prose | {len(c['skills_naming_route_in_prose'])} |")
    p(f"| datasets (persistent state files) | {len(c['datasets'])} |")
    p(f"| dataset bytes | {c['dataset_bytes_total']} |")
    p(f"| files accounted for (instruction+code+state+residual) | {c['files_accounted']} |")
    p(f"| policy files (ignore rules — never move) | {len(c['policy_files'])} |")
    p(f"| predecessor sidecars | {len(c['predecessor_sidecar_files'])} |")
    p(f"| **UNCLASSIFIED (must be 0 or explained)** | **{len(c['unclassified_files'])}** |")
    p(f"| credential-shaped files | {len(c['credential_shaped_files'])} |")
    p(f"| host-local sentinels / caches | {len(c['host_local_sentinels'])} |")
    p(f"| hook registrations (entries) | {c['hook_entries_total']} |")
    p(f"| …of those, file-pointing | {c['hook_entries_file_pointing']} |")
    p(f"| …inline commands, no file | {len(c['hooks_inline_no_file'])} |")
    p(f"| unique hook scripts referenced | {len(c['hooks_registered'])} |")
    p(f"| hooks on disk | {len(c['hooks_on_disk'])} |")
    p(f"| hooks DEAD WIRING (registered, file absent) | {len(c['hooks_dead_wiring'])} |")
    p(f"| hooks orphaned (on disk, unregistered) | {len(c['hooks_orphaned'])} |")
    p(f"| agents registered in `.claude/agents/` | {len(c['agents']['registered'])} |")
    p(f"| agent definitions inside skills | {len(c['agents']['in_skills'])} |")
    if c["predecessor_ledger"]:
        pl = c["predecessor_ledger"]
        p(f"| predecessor ledger records (actual) | {pl.get('actual_total')} |")
        p(f"| predecessor ledger records (index claims) | {sum(pl.get('index_claims', {}).values())} |")
    p("")
    if c["foreign_origin_owners"]:
        p("## Foreign `origin:` owners (detection is by marker, never by name)")
        p("")
        for k, v in sorted(c["foreign_origin_owners"].items(), key=lambda x: -x[1]):
            p(f"- `{k}` — {v} region(s)")
        p("")
    p("## Datasets by git disposition")
    p("")
    by = Counter(d["git"] for d in c["datasets"])
    for k, v in sorted(by.items()):
        p(f"- {k}: {v}")
    p("")
    if c["ignore_rule_sources"]:
        p("Ignore rules for that state are spread across:")
        p("")
        for k, v in sorted(c["ignore_rule_sources"].items()):
            p(f"- `{k}` — {v} dataset(s)")
        p("")
    if c.get("unknown_marker_families"):
        p("## Unknown marker families — the table is incomplete")
        p("")
        for k, v in sorted(c["unknown_marker_families"].items(), key=lambda x: -x[1]):
            p(f"- `{k}` — {v} occurrence(s). Not in `legacy-markers.md`; classify before any sweep.")
        p("")
    if c["unpaired_markers"]:
        p("## Unpaired markers — a sweep hazard")
        p("")
        for u in c["unpaired_markers"]:
            p(f"- `{u['skill']}` {u['marker']}: {u['openers']} openers / {u['closers']} closers — {u['risk']}")
        p("")
    if c["hooks_dead_wiring"]:
        p("## Dead wiring (registered, file absent)")
        p("")
        for h in c["hooks_dead_wiring"]:
            p(f"- `{h}`")
        p("")
    if c["credential_shaped_files"]:
        p("## Credential-shaped files inside the skill tree")
        p("")
        for f in c["credential_shaped_files"]:
            p(f"- `{f}`")
        p("")


def main():
    args = [a for a in sys.argv[1:] if not a.startswith("--")]
    target = args[0] if args else os.path.expanduser("~/lab/odyssey-alive")
    c = census(target)
    if "--json" in sys.argv:
        print(json.dumps(c, indent=2, sort_keys=True))
    else:
        report(c)
    return 0


if __name__ == "__main__":
    sys.exit(main())
